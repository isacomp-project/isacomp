isa_state pc[63:0];
var instr[31:0];
isa_state rf[63:0][4:0];
mem umem[13:0];
isa_state lock_flag[0:0];

var ra[4:0];
var rb[4:0];
var Ra[63:0];
var Rb[63:0];
var disp[63:0];
var addr[63:0];
var ldl_l_data[31:0];

instr = umem[pc];
assume instr[31:26] == 42;
ra = instr[25:21];
Ra = rf[ra];
rb = instr[20:16];
Rb = rf[rb];
disp = {{48{instr[15]}}, instr[15:0]};
addr = Rb + disp;

ldl_l_data = umem[addr];
rf[ra] when (ra != 31) = {{32{ldl_l_data[31]}}, ldl_l_data};
lock_flag = 1;
pc = pc + 4;