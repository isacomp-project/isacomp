isa_state pc[63:0];
var instr[31:0];
isa_state rf[63:0][4:0];
mem umem[13:0];

var ra[4:0];
var Ra[63:0];

instr = umem[pc];
assume instr[31:26] == 24;
assume instr[15:0] == 57344;
ra = instr[25:21];
Ra = rf[ra];

rf[ra] when (ra != 31) = IntrFlag;
IntrFlag = 0;
pc = pc + 4;