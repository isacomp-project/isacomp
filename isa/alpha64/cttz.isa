// SPDX-License-Identifier: BSD-3-Clause
isa_state pc[63:0];
var instr[31:0];
isa_state rf[63:0][4:0];
mem umem[13:0];

var rb[4:0];
var rc[4:0];
var Rb[63:0];
var Rc[63:0];

instr = umem[pc];
assume instr[31:26] == 28;
assume instr[11:5] == 51;
rb = instr[20:16];
Rb = rf[rb];
rc = instr[4:0];
Rc = rf[rc];

// Count trailing zeros using hierarchical approach
// Check 32-bit halves first
var lower32_zero[0:0];
var v32[31:0];
var c32[5:0];
lower32_zero = (Rb[31:0] == 32'b0);
v32 = lower32_zero ? Rb[63:32] : Rb[31:0];
c32 = lower32_zero ? 6'd32 : 6'd0;

// Check 16-bit halves
var lower16_zero[0:0];
var v16[15:0];
var c16[5:0];
lower16_zero = (v32[15:0] == 16'b0);
v16 = lower16_zero ? v32[31:16] : v32[15:0];
c16 = lower16_zero ? c32 + 6'd16 : c32;

// Check 8-bit halves
var lower8_zero[0:0];
var v8[7:0];
var c8[5:0];
lower8_zero = (v16[7:0] == 8'b0);
v8 = lower8_zero ? v16[15:8] : v16[7:0];
c8 = lower8_zero ? c16 + 6'd8 : c16;

// Check 4-bit halves
var lower4_zero[0:0];
var v4[3:0];
var c4[5:0];
lower4_zero = (v8[3:0] == 4'b0);
v4 = lower4_zero ? v8[7:4] : v8[3:0];
c4 = lower4_zero ? c8 + 6'd4 : c8;

// Check 2-bit halves
var lower2_zero[0:0];
var v2[1:0];
var c2[5:0];
lower2_zero = (v4[1:0] == 2'b0);
v2 = lower2_zero ? v4[3:2] : v4[1:0];
c2 = lower2_zero ? c4 + 6'd2 : c4;

// Check final bits
var bit0_zero[0:0];
var c1[5:0];
bit0_zero = (v2[0] == 1'b0);
c1 = bit0_zero ? c2 + 6'd1 : c2;

// Final count - add 1 if both bits are zero
var both_zero[0:0];
var count[63:0];
both_zero = (v2 == 2'b0);
count = both_zero ? {58'b0, c1} + 64'd1 : {58'b0, c1};

rf[rc] when (rc != 31) = count;
pc = pc + 4;
