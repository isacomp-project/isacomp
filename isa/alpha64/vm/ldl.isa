// SPDX-License-Identifier: BSD-3-Clause
// LDL with Virtual Memory Support
// Uses ITB/DTB aspects for address translation

isa_state pc[63:0];
var instr[31:0];
isa_state rf[63:0][4:0];
mem umem[13:0];

// PAL/MMU state
isa_state pal_mode[0:0];
isa_state pal_base[63:0];
isa_state exc_addr[63:0];
isa_state ps[63:0];
isa_state va[63:0];
isa_state mm_stat[63:0];

// ITB arrays (8 entries)
isa_state itb_pte[63:0][2:0];
isa_state itb_tag[63:0][2:0];
isa_state itb_valid[0:0][2:0];
isa_state itb_asn[63:0];
isa_state itb_asn_entry[7:0][2:0];

// DTB arrays (8 entries)
isa_state dtb_pte[63:0][2:0];
isa_state dtb_tag[63:0][2:0];
isa_state dtb_valid[0:0][2:0];
isa_state dtb_asn[63:0];
isa_state dtb_asn_entry[7:0][2:0];
isa_state ipl[5:0];
ext isa_state isr[63:0];
isa_state hier[63:0];
isa_state lock_flag[0:0];


var ra[4:0];
var rb[4:0];
var Ra[63:0];
var Rb[63:0];
var disp[63:0];
var addr[63:0];
var ldl_data[31:0];

// ITB translation for instruction fetch
aspect aspects/itb.isa gates pc, pal_mode, pal_base, itb_pte, itb_tag, itb_valid, itb_asn, itb_asn_entry, ps;

// Interrupt check
aspect aspects/interrupt.isa gates pal_mode, pal_base, ipl, isr, hier;

instr = umem[pc_pa];
assume instr[31:26] == 40;
ra = instr[25:21];
Ra = rf[ra];
rb = instr[20:16];
Rb = rf[rb];
disp = {{48{instr[15]}}, instr[15:0]};
addr = Rb + disp;

// DTB translation for data load
aspect aspects/dtb_load.isa gates addr, pal_mode, pal_base, dtb_pte, dtb_tag, dtb_valid, dtb_asn, dtb_asn_entry, ps;

ldl_data = umem[addr_pa];
var no_tlb_miss[0:0];
no_tlb_miss = (take_interrupt == 0) ? ((itb_fault == 0) ? ((dtb_load_fault == 0) ? 1'b1 : 1'b0) : 1'b0) : 1'b0;
var orig_cond[0:0];
orig_cond = (ra != 31);
var load_ok[0:0];
load_ok = no_tlb_miss ? orig_cond : 1'b0;
rf[ra] when (load_ok) = {{32{ldl_data[31]}}, ldl_data};
var pc_normal[0:0];
pc_normal = no_tlb_miss;
var load_any_fault[0:0];
load_any_fault = itb_fault | dtb_load_fault;
exc_addr when (take_interrupt || load_any_fault) = pc;
pal_mode when (take_interrupt) = 1;
lock_flag when (take_interrupt) = 0;
pc when (take_interrupt) = interrupt_entry;
va when (itb_fault) = pc;
va when (dtb_load_fault) = addr;
mm_stat when (dtb_load_fault) = dtb_load_mm_stat;
pal_mode when (take_interrupt == 0 && load_any_fault) = 1;
pc when (take_interrupt == 0 && itb_miss) = itb_miss_entry;
pc when (take_interrupt == 0 && itb_acv) = itb_acv_entry;
pc when (take_interrupt == 0 && dtb_load_fault) = dtb_miss_entry;
pc when (take_interrupt == 0 && pc_normal) = pc + 4;