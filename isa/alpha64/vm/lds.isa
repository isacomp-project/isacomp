// SPDX-License-Identifier: BSD-3-Clause
// LDS with Virtual Memory Support (Load S_floating, IEEE single-precision)
// Opcode: 0x22 (34)
// Format: LDS Fa, disp(Rb)

isa_state pc[63:0];
var instr[31:0];
isa_state rf[63:0][4:0];
isa_state frf[63:0][4:0];      // FP register file
mem umem[13:0];

// PAL/MMU state
isa_state pal_mode[0:0];
isa_state pal_base[63:0];
isa_state exc_addr[63:0];
isa_state ps[63:0];
isa_state va[63:0];
isa_state mm_stat[63:0];

// ITB arrays (8 entries)
isa_state itb_pte[63:0][2:0];
isa_state itb_tag[63:0][2:0];
isa_state itb_valid[0:0][2:0];
isa_state itb_asn[63:0];
isa_state itb_asn_entry[7:0][2:0];

// DTB arrays (8 entries)
isa_state dtb_pte[63:0][2:0];
isa_state dtb_tag[63:0][2:0];
isa_state dtb_valid[0:0][2:0];
isa_state dtb_asn[63:0];
isa_state dtb_asn_entry[7:0][2:0];
isa_state ipl[5:0];
ext isa_state isr[63:0];
isa_state hier[63:0];
isa_state lock_flag[0:0];

// ITB translation for instruction fetch
aspect aspects/itb.isa gates pc, pal_mode, pal_base, itb_pte, itb_tag, itb_valid, itb_asn, itb_asn_entry, ps;

// Interrupt check
aspect aspects/interrupt.isa gates pal_mode, pal_base, ipl, isr, hier;

var fa[4:0];
var rb[4:0];
var Rb[63:0];
var disp[63:0];
var addr[63:0];
var lds_data[31:0];

instr = umem[pc_pa];
assume instr[31:26] == 34;    // Opcode 0x22 = LDS
fa = instr[25:21];
rb = instr[20:16];
Rb = rf[rb];
disp = {{48{instr[15]}}, instr[15:0]};
addr = Rb + disp;

// ============================================================================
// DTB Translation for Load (inline)
// ============================================================================
var addr_pa[63:0];
var dtb_miss[0:0];

var addr_vpn[29:0];
var addr_offset[12:0];
addr_vpn = addr[42:13];
addr_offset = addr[12:0];

var dtag_match0[0:0]; var dtag_match1[0:0]; var dtag_match2[0:0]; var dtag_match3[0:0];
var dtag_match4[0:0]; var dtag_match5[0:0]; var dtag_match6[0:0]; var dtag_match7[0:0];
dtag_match0 = (dtb_tag[0][29:0] == addr_vpn);
dtag_match1 = (dtb_tag[1][29:0] == addr_vpn);
dtag_match2 = (dtb_tag[2][29:0] == addr_vpn);
dtag_match3 = (dtb_tag[3][29:0] == addr_vpn);
dtag_match4 = (dtb_tag[4][29:0] == addr_vpn);
dtag_match5 = (dtb_tag[5][29:0] == addr_vpn);
dtag_match6 = (dtb_tag[6][29:0] == addr_vpn);
dtag_match7 = (dtb_tag[7][29:0] == addr_vpn);

var dasn0[0:0]; var dasn1[0:0]; var dasn2[0:0]; var dasn3[0:0];
var dasn4[0:0]; var dasn5[0:0]; var dasn6[0:0]; var dasn7[0:0];
dasn0 = dtb_pte[0][4] | (dtb_asn_entry[0] == dtb_asn[7:0]);
dasn1 = dtb_pte[1][4] | (dtb_asn_entry[1] == dtb_asn[7:0]);
dasn2 = dtb_pte[2][4] | (dtb_asn_entry[2] == dtb_asn[7:0]);
dasn3 = dtb_pte[3][4] | (dtb_asn_entry[3] == dtb_asn[7:0]);
dasn4 = dtb_pte[4][4] | (dtb_asn_entry[4] == dtb_asn[7:0]);
dasn5 = dtb_pte[5][4] | (dtb_asn_entry[5] == dtb_asn[7:0]);
dasn6 = dtb_pte[6][4] | (dtb_asn_entry[6] == dtb_asn[7:0]);
dasn7 = dtb_pte[7][4] | (dtb_asn_entry[7] == dtb_asn[7:0]);

var dhit0[0:0]; var dhit1[0:0]; var dhit2[0:0]; var dhit3[0:0];
var dhit4[0:0]; var dhit5[0:0]; var dhit6[0:0]; var dhit7[0:0];
dhit0 = dtb_valid[0] & dtag_match0 & dasn0;
dhit1 = dtb_valid[1] & dtag_match1 & dasn1;
dhit2 = dtb_valid[2] & dtag_match2 & dasn2;
dhit3 = dtb_valid[3] & dtag_match3 & dasn3;
dhit4 = dtb_valid[4] & dtag_match4 & dasn4;
dhit5 = dtb_valid[5] & dtag_match5 & dasn5;
dhit6 = dtb_valid[6] & dtag_match6 & dasn6;
dhit7 = dtb_valid[7] & dtag_match7 & dasn7;

var dhit01[0:0]; var dhit23[0:0]; var dhit45[0:0]; var dhit67[0:0];
var dhit0123[0:0]; var dhit4567[0:0]; var dtb_hit[0:0];
dhit01 = dhit0 ? 1'b1 : dhit1;
dhit23 = dhit2 ? 1'b1 : dhit3;
dhit45 = dhit4 ? 1'b1 : dhit5;
dhit67 = dhit6 ? 1'b1 : dhit7;
dhit0123 = dhit01 ? 1'b1 : dhit23;
dhit4567 = dhit45 ? 1'b1 : dhit67;
dtb_hit = dhit0123 ? 1'b1 : dhit4567;

var dtb_pte_s7[63:0]; var dtb_pte_s6[63:0]; var dtb_pte_s5[63:0]; var dtb_pte_s4[63:0];
var dtb_pte_s3[63:0]; var dtb_pte_s2[63:0]; var dtb_pte_s1[63:0]; var dtb_pte_sel[63:0];
dtb_pte_s7 = dhit7 ? dtb_pte[7] : 64'b0;
dtb_pte_s6 = dhit6 ? dtb_pte[6] : dtb_pte_s7;
dtb_pte_s5 = dhit5 ? dtb_pte[5] : dtb_pte_s6;
dtb_pte_s4 = dhit4 ? dtb_pte[4] : dtb_pte_s5;
dtb_pte_s3 = dhit3 ? dtb_pte[3] : dtb_pte_s4;
dtb_pte_s2 = dhit2 ? dtb_pte[2] : dtb_pte_s3;
dtb_pte_s1 = dhit1 ? dtb_pte[1] : dtb_pte_s2;
dtb_pte_sel = dhit0 ? dtb_pte[0] : dtb_pte_s1;

var dtb_pfn[31:0];
dtb_pfn = dtb_pte_sel[63:32];

// DTB permission checking for reads
var dtb_for[0:0]; var dtb_load_kre[0:0]; var dtb_load_ure[0:0];
dtb_for = dtb_pte_sel[1];
dtb_load_kre = dtb_pte_sel[8];
dtb_load_ure = dtb_pte_sel[9];
var dtb_is_user[0:0];
dtb_is_user = ps[3];
var dtb_load_perm_ok[0:0];
dtb_load_perm_ok = dtb_for ? 1'b0 : (dtb_is_user ? dtb_load_ure : dtb_load_kre);
// KSEG Detection for data address (kernel segment bypass)
var dtb_is_kseg[0:0];
dtb_is_kseg = (addr[47:42] == 6'b111111);
var dtb_kseg_pa[63:0];
dtb_kseg_pa = {{22{1'b0}}, addr[41:0]};
var dtb_kseg_user_fault[0:0];
dtb_kseg_user_fault = dtb_is_kseg & dtb_is_user;

var dtb_load_acv[0:0];
dtb_load_acv = not_pal_mode ? (dtb_kseg_user_fault ? 1'b1 : (dtb_is_kseg ? 1'b0 : (dtb_hit ? (~dtb_load_perm_ok) : 1'b0))) : 1'b0;

var addr_xlated[63:0];
addr_xlated = {dtb_pfn, addr_offset};

var dtb_no_hit[0:0];
dtb_no_hit = (dtb_hit == 0);
dtb_miss = not_pal_mode ? (dtb_is_kseg ? 1'b0 : dtb_no_hit) : 1'b0;
addr_pa = not_pal_mode ? (dtb_is_kseg ? dtb_kseg_pa : (dtb_hit ? addr_xlated : addr)) : addr;

var dtb_miss_entry[63:0];
dtb_miss_entry = pal_base + 64'h0200;

var no_itb_fault_ld[0:0];
no_itb_fault_ld = (take_interrupt == 0 && itb_fault == 0);
var dtb_load_fault[0:0];
dtb_load_fault = (dtb_miss | dtb_load_acv) ? no_itb_fault_ld : 1'b0;
// MM_STAT encoding: bit 0 = WR (0=read), bit 1 = ACV (1=acv, 0=miss)
var dtb_load_mm_stat[63:0];
dtb_load_mm_stat = dtb_load_acv ? 64'd2 : 64'd0;

// Load 32-bit value from memory
lds_data = umem[addr_pa][31:0];

// Write to FP register with sign extension
var no_tlb_miss[0:0];
no_tlb_miss = (take_interrupt == 0) ? ((itb_fault == 0) ? ((dtb_load_fault == 0) ? 1'b1 : 1'b0) : 1'b0) : 1'b0;
var orig_cond[0:0];
orig_cond = (fa != 31);
var load_ok[0:0];
load_ok = no_tlb_miss ? orig_cond : 1'b0;
frf[fa] when (load_ok) = {{32{1'b1}}, lds_data};

var pc_normal[0:0];
pc_normal = no_tlb_miss;
exc_addr when (take_interrupt || itb_fault || dtb_load_fault) = pc;
pal_mode when (take_interrupt) = 1;
lock_flag when (take_interrupt) = 0;
pc when (take_interrupt) = interrupt_entry;
va when (itb_fault) = pc;
va when (dtb_load_fault) = addr;
mm_stat when (dtb_load_fault) = dtb_load_mm_stat;
pal_mode when (take_interrupt == 0 && (itb_fault | dtb_load_fault)) = 1;
pc when (take_interrupt == 0 && itb_miss) = itb_miss_entry;
pc when (take_interrupt == 0 && itb_acv) = itb_acv_entry;
pc when (take_interrupt == 0 && dtb_load_fault) = dtb_miss_entry;
pc when (take_interrupt == 0 && pc_normal) = pc + 4;
