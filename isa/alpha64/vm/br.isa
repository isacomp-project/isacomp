// SPDX-License-Identifier: BSD-3-Clause
// BR with Virtual Memory Support
// Uses ITB/DTB aspects for address translation

isa_state pc[63:0];
var instr[31:0];
isa_state rf[63:0][4:0];
mem umem[13:0];

// PAL/MMU state
isa_state pal_mode[0:0];
isa_state pal_base[63:0];
isa_state exc_addr[63:0];
isa_state ps[63:0];
isa_state va[63:0];
isa_state mm_stat[63:0];

// ITB arrays (8 entries)
isa_state itb_pte[63:0][2:0];
isa_state itb_tag[63:0][2:0];
isa_state itb_valid[0:0][2:0];
isa_state itb_asn[63:0];
isa_state itb_asn_entry[7:0][2:0];
isa_state ipl[5:0];
ext isa_state isr[63:0];
isa_state hier[63:0];
isa_state lock_flag[0:0];


var ra[4:0];

// ITB translation for instruction fetch
aspect aspects/itb.isa gates pc, pal_mode, pal_base, itb_pte, itb_tag, itb_valid, itb_asn, itb_asn_entry, ps;

// Interrupt check
aspect aspects/interrupt.isa gates pal_mode, pal_base, ipl, isr, hier;

instr = umem[pc_pa];
assume instr[31:26] == 48;
ra = instr[25:21];

var branch_offset[63:0];
branch_offset = {{43{instr[20]}}, instr[20:0], 2'b00};
rf[ra] when (ra != 31 && take_interrupt == 0 && itb_fault == 0) = pc + 4;
exc_addr when (take_interrupt || itb_fault) = pc;
pal_mode when (take_interrupt) = 1;
lock_flag when (take_interrupt) = 0;
pc when (take_interrupt) = interrupt_entry;
va when (itb_fault) = pc;
pal_mode when (take_interrupt == 0 && itb_fault) = 1;
pc when (take_interrupt == 0 && itb_miss) = itb_miss_entry;
pc when (take_interrupt == 0 && itb_acv) = itb_acv_entry;
pc when (take_interrupt == 0 && itb_fault == 0) = pc + 4 + branch_offset;
