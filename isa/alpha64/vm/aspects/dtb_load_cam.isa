// SPDX-License-Identifier: BSD-3-Clause
// Alpha64 DTB (Data TLB) Translation Aspect for Load Operations - CAM Version
//
// Uses CAM (Content-Addressable Memory) syntax for TLB lookup.
// Replaces ~90 lines of manual unrolling with ~50 lines.
//
// Requires: addr variable must be defined before including this aspect
//
// Provides:
//   addr_pa    - Physical address for data access
//   dtb_miss   - Set if DTB miss occurs (triggers PAL exception)
//
// Requires gates: addr, pal_mode, pal_base

// Physical address output
var addr_pa[63:0];
var dtb_miss[0:0];

// Extract virtual page number and offset from address
var addr_vpn[29:0];
var addr_offset[12:0];
addr_vpn = addr[42:13];
addr_offset = addr[12:0];

// ============================================================================
// DTB CAM Lookup (8 entries, fully associative)
// ============================================================================
// Step 1: Get VPN matches using CAM lookup
var vpn_matches[7:0];
vpn_matches = dtb_tag@[addr_vpn];

// Step 2: Filter by Valid bit and ASN matching
// Entry matches if: VPN match AND Valid AND (ASM set OR ASN matches)
var v_0[0:0]; var v_1[0:0]; var v_2[0:0]; var v_3[0:0];
var v_4[0:0]; var v_5[0:0]; var v_6[0:0]; var v_7[0:0];

v_0 = dtb_valid[0] & (dtb_pte[0][4] | (dtb_asn_entry[0] == dtb_asn[7:0]));
v_1 = dtb_valid[1] & (dtb_pte[1][4] | (dtb_asn_entry[1] == dtb_asn[7:0]));
v_2 = dtb_valid[2] & (dtb_pte[2][4] | (dtb_asn_entry[2] == dtb_asn[7:0]));
v_3 = dtb_valid[3] & (dtb_pte[3][4] | (dtb_asn_entry[3] == dtb_asn[7:0]));
v_4 = dtb_valid[4] & (dtb_pte[4][4] | (dtb_asn_entry[4] == dtb_asn[7:0]));
v_5 = dtb_valid[5] & (dtb_pte[5][4] | (dtb_asn_entry[5] == dtb_asn[7:0]));
v_6 = dtb_valid[6] & (dtb_pte[6][4] | (dtb_asn_entry[6] == dtb_asn[7:0]));
v_7 = dtb_valid[7] & (dtb_pte[7][4] | (dtb_asn_entry[7] == dtb_asn[7:0]));

var valid_mask[7:0];
valid_mask = {v_7, v_6, v_5, v_4, v_3, v_2, v_1, v_0};

// Final match: VPN match AND Valid AND ASN match
var dtb_match[7:0];
dtb_match = vpn_matches & valid_mask;

// Get hit status and index using ctz
var dtb_hit[0:0];
var dtb_hit_idx[3:0];
dtb_hit = |dtb_match;
dtb_hit_idx = ctz(dtb_match);

// ============================================================================
// Read Matched Entry
// ============================================================================
// Extract 3-bit index (ctz returns 4 bits to encode "no match" as 8)
var dtb_idx3[2:0];
dtb_idx3 = dtb_hit_idx[2:0];

var dtb_pte_sel[63:0];
dtb_pte_sel = dtb_pte[dtb_idx3];

// Extract PFN from selected PTE
var dtb_pfn[31:0];
dtb_pfn = dtb_pte_sel[63:32];

// Permission checking for loads (read access)
var dtb_for[0:0];
var dtb_load_kre[0:0];
var dtb_load_ure[0:0];
dtb_for = dtb_pte_sel[1];
dtb_load_kre = dtb_pte_sel[8];
dtb_load_ure = dtb_pte_sel[9];
var dtb_is_user[0:0];
dtb_is_user = ps[3];
var dtb_load_perm_ok[0:0];
dtb_load_perm_ok = dtb_for ? 1'b0 : (dtb_is_user ? dtb_load_ure : dtb_load_kre);
var dtb_load_acv[0:0];
dtb_load_acv = not_pal_mode ? (dtb_hit ? (~dtb_load_perm_ok) : 1'b0) : 1'b0;

// Compute translated address
var addr_xlated[63:0];
addr_xlated = {dtb_pfn, addr_offset};

// ============================================================================
// Translation Control
// ============================================================================
// Note: not_pal_mode may already be defined by itb.isa aspect
var dtb_no_hit[0:0];
dtb_no_hit = (dtb_hit == 0);
dtb_miss = not_pal_mode ? dtb_no_hit : 1'b0;

// Physical address: PAL=addr, TLB hit=translated, else=addr (will raise DTB miss)
addr_pa = not_pal_mode ? (dtb_hit ? addr_xlated : addr) : addr;

// DTB miss exception entry point (different from ITB)
var dtb_miss_entry[63:0];
dtb_miss_entry = pal_base + 64'h200;

// DTB load fault: miss or ACV, but only if no ITB fault (ITB has priority)
var no_itb_fault[0:0];
no_itb_fault = (itb_fault == 0);
var dtb_load_fault[0:0];
dtb_load_fault = (dtb_miss | dtb_load_acv) ? no_itb_fault : 1'b0;

// MM_STAT encoding: bit 0 = WR (0=read), bit 1 = ACV (1=acv, 0=miss)
var dtb_load_mm_stat[63:0];
dtb_load_mm_stat = dtb_load_acv ? 64'd2 : 64'd0;
