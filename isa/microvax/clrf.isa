// CLRF - Clear F_floating
// Opcode: 0xD4
// Format: [opcode:8][dst:4][unused:20]
// dst = 0.0 (F_floating)

isa_state pc[31:0];
var instr[31:0];
isa_state rf[31:0][3:0];
isa_state flag_N[0:0];
isa_state flag_Z[0:0];
isa_state flag_V[0:0];
isa_state flag_C[0:0];
mem umem[12:0];

var dst_reg[3:0];

instr = umem[pc];
assume instr[31:24] == 0xD4;
pc = pc + 4;

dst_reg = instr[23:20];

// Clear to zero (positive zero in FP)
rf[dst_reg] = 0;

// Update condition codes - result is zero
flag_N = 0;
flag_Z = 1;
flag_V = 0;
flag_C = 0;
