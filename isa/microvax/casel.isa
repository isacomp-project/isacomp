// SPDX-License-Identifier: BSD-3-Clause

isa_state pc[31:0];
var instr[31:0];
isa_state rf[31:0][3:0];
mem umem[12:0];

var selector_reg[3:0];
var base_reg[3:0];
var limit_reg[3:0];
var selector[31:0];
var base[31:0];
var limit[31:0];
var offset[31:0];
var target[31:0];

instr = umem[pc];
assume instr[31:24] == 0xFC;
pc = pc + 4;

selector_reg = instr[23:20];
base_reg = instr[19:16];
limit_reg = instr[15:12];

selector = rf[selector_reg];
base = rf[base_reg];
limit = rf[limit_reg];

offset = umem[pc + (selector << 2)];
target = pc + offset;

pc = (selector <= limit) ? target : pc + 4;
