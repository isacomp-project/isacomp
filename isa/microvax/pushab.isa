// SPDX-License-Identifier: BSD-3-Clause
// PUSHAB - Push Address of Byte
// Opcode: 0xDF
// Format: [opcode:8][base:4][unused:4][offset:16]
// Compute address (base + offset) and push onto stack

isa_state pc[31:0];
var instr[31:0];
isa_state rf[31:0][3:0];
mem umem[12:0];

var base_reg[3:0];
var offset[15:0];
var base[31:0];
var sext_offset[31:0];
var addr[31:0];
var sp[31:0];

instr = umem[pc];
assume instr[31:24] == 0xDF;

base_reg = instr[23:20];
offset = instr[15:0];

base = rf[base_reg];
sext_offset = {{16{offset[15]}}, offset};
addr = base + sext_offset;

sp = rf[14] - 4;
umem[sp] = addr;
rf[14] = sp;
pc = pc + 4;
