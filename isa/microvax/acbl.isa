// SPDX-License-Identifier: BSD-3-Clause
// ACBL - Add Compare and Branch Longword
// Opcode: 0xF1
// Format: [opcode:8][limit:4][index:4][add:8][offset:8]
// Add add to index, branch if index <= limit (signed longword comparison)

isa_state pc[31:0];
var instr[31:0];
isa_state rf[31:0][3:0];
mem umem[12:0];

var limit_reg[3:0];
var index_reg[3:0];
var add_val[7:0];
var offset[7:0];
var limit[31:0];
var index[31:0];
var new_index[31:0];
var sext_add[31:0];
var sext_offset[31:0];

instr = umem[pc];
assume instr[31:24] == 0xF1;

limit_reg = instr[23:20];
index_reg = instr[19:16];
add_val = instr[15:8];
offset = instr[7:0];

limit = rf[limit_reg];
index = rf[index_reg];

sext_add = {{24{add_val[7]}}, add_val};
new_index = index + sext_add;
sext_offset = {{24{offset[7]}}, offset};

rf[index_reg] = new_index;
pc = (new_index <=s limit) ? (pc + sext_offset) : (pc + 4);
