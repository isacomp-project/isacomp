// CASEW - Case Word
// Opcode: 0xAF
// Format: [opcode:8][sel:4][base:4][limit:8][unused:8]
// Jump table indexed by (selector - base), limited by limit

isa_state pc[31:0];
var instr[31:0];
isa_state rf[31:0][3:0];
mem umem[12:0];

var sel_reg[3:0];
var base_reg[3:0];
var limit[7:0];
var selector[15:0];
var base[15:0];
var index[15:0];
var offset[31:0];

instr = umem[pc];
assume instr[31:24] == 0xAF;

sel_reg = instr[23:20];
base_reg = instr[19:16];
limit = instr[15:8];

selector = rf[sel_reg][15:0];
base = rf[base_reg][15:0];
index = selector - base;

offset = umem[pc + 4 + index];

pc = (index <= limit) ? (pc + 4 + offset) : (pc + 8 + limit);
