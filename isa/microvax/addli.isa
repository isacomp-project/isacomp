isa_state pc[31:0];
var instr[31:0];
isa_state rf[31:0][3:0];
isa_state flag_N[0:0];
isa_state flag_Z[0:0];
isa_state flag_V[0:0];
isa_state flag_C[0:0];
mem umem[12:0];

var dst_reg[3:0];
var imm[19:0];
var sign_ext_imm[31:0];
var dst_val[31:0];
var res[31:0];
var res_ext[32:0];

instr = umem[pc];
assume instr[31:24] == 0xC4;
pc = pc + 4;

dst_reg = instr[23:20];
imm = instr[19:0];

sign_ext_imm = {{12{imm[19]}}, imm};
dst_val = rf[dst_reg];

res_ext = {1'b0, dst_val} + {1'b0, sign_ext_imm};
res = res_ext[31:0];

rf[dst_reg] = res;

// Update condition codes
flag_N = res[31];
flag_Z = (res == 0);
flag_V = (~dst_val[31] & ~sign_ext_imm[31] & res[31]) | (dst_val[31] & sign_ext_imm[31] & ~res[31]);
flag_C = res_ext[32];
