// SPDX-License-Identifier: BSD-3-Clause

isa_state pc[31:0];
var instr[31:0];
isa_state rf[31:0][3:0];
mem umem[12:0];

var displacement[23:0];
var sign_ext_disp[31:0];
var target[31:0];
var sp_val[31:0];
var new_sp[31:0];
var return_addr[31:0];

instr = umem[pc];
assume instr[31:24] == 0x20;

displacement = instr[23:0];
return_addr = pc + 4;

sign_ext_disp = {{8{displacement[23]}}, displacement};

sp_val = rf[4'hE];

new_sp = sp_val - 4;

umem[new_sp] = return_addr;

rf[4'hE] = new_sp;

target = pc + sign_ext_disp;
pc = target;
