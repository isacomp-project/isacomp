// SPDX-License-Identifier: BSD-3-Clause

isa_state pc[31:0];
var instr[31:0];
isa_state rf[31:0][3:0];
isa_state flag_N[0:0];
isa_state flag_Z[0:0];
isa_state flag_V[0:0];
isa_state flag_C[0:0];
mem umem[12:0];

var src_reg[3:0];
var dst_reg[3:0];
var src_val[15:0];
var dst_val[31:0];
var dst_word[15:0];
var res[15:0];

instr = umem[pc];
assume instr[31:24] == 0xA2;
pc = pc + 4;

src_reg = instr[23:20];
dst_reg = instr[19:16];

src_val = rf[src_reg][15:0];
dst_val = rf[dst_reg];
dst_word = dst_val[15:0];

res = dst_word - src_val;

rf[dst_reg] = {dst_val[31:16], res};

// Update condition codes (word)
flag_N = res[15];
flag_Z = (res == 0);
flag_V = (dst_word[15] & ~src_val[15] & ~res[15]) | (~dst_word[15] & src_val[15] & res[15]);
flag_C = (src_val > dst_word);
