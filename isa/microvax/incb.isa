isa_state pc[31:0];
var instr[31:0];
isa_state rf[31:0][3:0];
isa_state flag_N[0:0];
isa_state flag_Z[0:0];
isa_state flag_V[0:0];
isa_state flag_C[0:0];
mem umem[12:0];

var dst_reg[3:0];
var dst_val[31:0];
var dst_byte[7:0];
var res[7:0];

instr = umem[pc];
assume instr[31:24] == 0x96;
pc = pc + 4;

dst_reg = instr[23:20];
dst_val = rf[dst_reg];
dst_byte = dst_val[7:0];

res = dst_byte + 1;

rf[dst_reg] = {dst_val[31:8], res};

// Update condition codes (byte)
flag_N = res[7];
flag_Z = (res == 0);
flag_V = (~dst_byte[7] & res[7]);
flag_C = 0;
