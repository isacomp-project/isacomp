// SPDX-License-Identifier: BSD-3-Clause

isa_state pc[31:0];
var instr[31:0];
isa_state rf[31:0][3:0];
mem umem[12:0];

var src_reg[3:0];
var dst_reg[3:0];
var src_val[31:0];
var inv_val[31:0];
var result[31:0];

instr = umem[pc];
assume instr[31:24] == 0xEC;
pc = pc + 4;

src_reg = instr[23:20];
dst_reg = instr[19:16];

src_val = rf[src_reg];
inv_val = ~src_val;

result = (inv_val != 0) ? 
    ((inv_val & 1) ? 0 :
     (inv_val & 2) ? 1 :
     (inv_val & 4) ? 2 :
     (inv_val & 8) ? 3 :
     (inv_val & 16) ? 4 :
     (inv_val & 32) ? 5 :
     (inv_val & 64) ? 6 :
     (inv_val & 128) ? 7 : 32) : 32;

rf[dst_reg] = result;
