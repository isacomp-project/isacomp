// SPDX-License-Identifier: BSD-3-Clause
// BGTRU - Branch if Greater Than Unsigned
// Opcode: 0x1B
// Format: [opcode:8][rs1:4][rs2:4][offset:16]
// Branch if rs1 > rs2 (unsigned comparison)

isa_state pc[31:0];
var instr[31:0];
isa_state rf[31:0][3:0];
mem umem[12:0];

var rs1[3:0];
var rs2[3:0];
var val1[31:0];
var val2[31:0];
var offset[15:0];
var sext_offset[31:0];

instr = umem[pc];
assume instr[31:24] == 0x1B;

rs1 = instr[23:20];
rs2 = instr[19:16];
offset = instr[15:0];

val1 = rf[rs1];
val2 = rf[rs2];

sext_offset = {{16{offset[15]}}, offset};

pc = (val1 > val2) ? (pc + sext_offset) : (pc + 4);
