isa_state pc[31:0];
var instr[31:0];
isa_state rf[31:0][3:0];
isa_state flag_N[0:0];
isa_state flag_Z[0:0];
isa_state flag_V[0:0];
isa_state flag_C[0:0];
mem umem[12:0];

var src1_reg[3:0];
var src2_reg[3:0];
var displacement[15:0];
var sign_ext_disp[31:0];
var src1_val[31:0];
var src2_val[31:0];
var cond[0:0];
var target[31:0];

instr = umem[pc];
assume instr[31:24] == 0x14;

src1_reg = instr[23:20];
src2_reg = instr[19:16];
displacement = instr[15:0];

src1_val = rf[src1_reg];
src2_val = rf[src2_reg];

sign_ext_disp = {{16{displacement[15]}}, displacement};

cond = src1_val <s src2_val;
target = pc + sign_ext_disp;

pc = cond ? target : pc + 4;
