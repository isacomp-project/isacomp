// BVS - Branch if Overflow Set
// Opcode: 0x1D
// Format: [opcode:8][unused:8][offset:16]
// Branch if overflow flag (psl[1]) is set

isa_state pc[31:0];
var instr[31:0];
isa_state psl[31:0];
mem umem[12:0];

var offset[15:0];
var sext_offset[31:0];

instr = umem[pc];
assume instr[31:24] == 0x1D;

offset = instr[15:0];

sext_offset = {{16{offset[15]}}, offset};

pc = (psl[1] == 1) ? (pc + sext_offset) : (pc + 4);
