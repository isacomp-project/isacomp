isa_state pc[31:0];
var instr[31:0];
isa_state rf[31:0][3:0];
isa_state flag_N[0:0];
isa_state flag_Z[0:0];
isa_state flag_V[0:0];
isa_state flag_C[0:0];
mem umem[12:0];

var src_reg[3:0];
var dst_reg[3:0];
var src_val[31:0];
var res[31:0];

instr = umem[pc];
assume instr[31:24] == 0xCE;
pc = pc + 4;

src_reg = instr[23:20];
dst_reg = instr[19:16];

src_val = rf[src_reg];
res = 32'h0 - src_val;

rf[dst_reg] = res;

// Update condition codes (V=1 when negating -2147483648)
flag_N = res[31];
flag_Z = (res == 0);
flag_V = (src_val == 32'h80000000);
flag_C = (src_val != 0);
