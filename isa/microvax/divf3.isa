// SPDX-License-Identifier: BSD-3-Clause
// DIVF3 - Divide F_floating 3-operand
// Opcode: 0x47
// Format: [opcode:8][src1:4][src2:4][dst:4][unused:12]
// dst = src2 / src1 (F_floating, VAX operand order)

isa_state pc[31:0];
var instr[31:0];
isa_state rf[31:0][3:0];
isa_state flag_N[0:0];
isa_state flag_Z[0:0];
isa_state flag_V[0:0];
isa_state flag_C[0:0];
mem umem[12:0];

var src1_reg[3:0];
var src2_reg[3:0];
var dst_reg[3:0];
var src1_val[31:0];
var src2_val[31:0];
var res[31:0];
var rm[2:0];

instr = umem[pc];
assume instr[31:24] == 0x47;
pc = pc + 4;

src1_reg = instr[23:20];
src2_reg = instr[19:16];
dst_reg = instr[15:12];

src1_val = rf[src1_reg];
src2_val = rf[src2_reg];

// Round to nearest (VAX default), dst = src2 / src1
rm = 3'b000;
res = fp_div(src2_val, src1_val, rm);

rf[dst_reg] = res;

// Update condition codes based on FP result
flag_N = res[31];
flag_Z = (res[30:0] == 0);
flag_V = 0;
flag_C = 0;
