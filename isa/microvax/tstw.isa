isa_state pc[31:0];
var instr[31:0];
isa_state rf[31:0][3:0];
isa_state flag_N[0:0];
isa_state flag_Z[0:0];
isa_state flag_V[0:0];
isa_state flag_C[0:0];
mem umem[12:0];

var src_reg[3:0];
var src_val[15:0];

instr = umem[pc];
assume instr[31:24] == 0xB3;
pc = pc + 4;

src_reg = instr[23:20];
src_val = rf[src_reg][15:0];

// Test: set flags based on word value, don't modify anything
flag_N = src_val[15];
flag_Z = (src_val == 0);
flag_V = 0;
flag_C = 0;
