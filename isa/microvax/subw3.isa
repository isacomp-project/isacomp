isa_state pc[31:0];
var instr[31:0];
isa_state rf[31:0][3:0];
isa_state flag_N[0:0];
isa_state flag_Z[0:0];
isa_state flag_V[0:0];
isa_state flag_C[0:0];
mem umem[12:0];

var src1_reg[3:0];
var src2_reg[3:0];
var dst_reg[3:0];
var src1_val[15:0];
var src2_val[15:0];
var res[15:0];

instr = umem[pc];
assume instr[31:24] == 0xA3;
pc = pc + 4;

src1_reg = instr[23:20];
src2_reg = instr[19:16];
dst_reg = instr[15:12];

src1_val = rf[src1_reg][15:0];
src2_val = rf[src2_reg][15:0];

// VAX: dst = src2 - src1
res = src2_val - src1_val;

rf[dst_reg] = {{16{1'b0}}, res};

// Update condition codes (word)
flag_N = res[15];
flag_Z = (res == 0);
flag_V = (src2_val[15] & ~src1_val[15] & ~res[15]) | (~src2_val[15] & src1_val[15] & res[15]);
flag_C = (src1_val > src2_val);
