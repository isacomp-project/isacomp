// SPDX-License-Identifier: BSD-3-Clause
// MOVPSL - Move Processor Status Longword
// Opcode: 0xDC
// Format: [opcode:8][dst:4][unused:20]
// Copy PSL to destination register

isa_state pc[31:0];
var instr[31:0];
isa_state rf[31:0][3:0];
isa_state psl[31:0];
mem umem[12:0];

var dst_reg[3:0];

instr = umem[pc];
assume instr[31:24] == 0xDC;

dst_reg = instr[23:20];

rf[dst_reg] = psl;
pc = pc + 4;
