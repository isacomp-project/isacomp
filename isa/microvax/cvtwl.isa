isa_state pc[31:0];
var instr[31:0];
isa_state rf[31:0][3:0];
mem umem[12:0];

var src_reg[3:0];
var dst_reg[3:0];
var src_val[31:0];
var word_val[15:0];
var res[31:0];

instr = umem[pc];
assume instr[31:24] == 0xF8;
pc = pc + 4;

src_reg = instr[23:20];
dst_reg = instr[19:16];

src_val = rf[src_reg];
word_val = src_val[15:0];
res = {{16{word_val[15]}}, word_val};

rf[dst_reg] = res;
