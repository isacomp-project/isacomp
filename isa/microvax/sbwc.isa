// SPDX-License-Identifier: BSD-3-Clause
// SBWC - Subtract With Carry (Borrow)
// Opcode: 0xDA
// Format: [opcode:8][src:4][dst:4][unused:16]
// dst = dst - src - carry

isa_state pc[31:0];
var instr[31:0];
isa_state rf[31:0][3:0];
isa_state flag_N[0:0];
isa_state flag_Z[0:0];
isa_state flag_V[0:0];
isa_state flag_C[0:0];
mem umem[12:0];

var src_reg[3:0];
var dst_reg[3:0];
var src[31:0];
var dst[31:0];
var carry[0:0];
var result[31:0];
var sub_with_carry[31:0];

instr = umem[pc];
assume instr[31:24] == 0xDA;

src_reg = instr[23:20];
dst_reg = instr[19:16];

src = rf[src_reg];
dst = rf[dst_reg];
carry = flag_C;

sub_with_carry = src + {31'b0, carry};
result = dst - sub_with_carry;
rf[dst_reg] = result;
pc = pc + 4;

// Update condition codes
flag_N = result[31];
flag_Z = (result == 0);
flag_V = (dst[31] & ~sub_with_carry[31] & ~result[31]) | (~dst[31] & sub_with_carry[31] & result[31]);
flag_C = (sub_with_carry > dst);
