isa_state pc[31:0];
var instr[31:0];
isa_state rf[31:0][3:0];
mem umem[12:0];

var sp_val[31:0];
var new_sp[31:0];
var return_addr[31:0];

instr = umem[pc];
assume instr[31:24] == 0x04;

sp_val = rf[4'hE];
return_addr = umem[sp_val];
new_sp = sp_val + 4;

rf[4'hE] = new_sp;
pc = return_addr;
