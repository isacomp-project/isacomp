isa_state pc[31:0];
var instr[31:0];
isa_state rf[31:0][3:0];
isa_state flag_N[0:0];
isa_state flag_Z[0:0];
isa_state flag_V[0:0];
isa_state flag_C[0:0];
mem umem[12:0];

var dst_reg[3:0];
var dst_val[31:0];
var res[31:0];

instr = umem[pc];
assume instr[31:24] == 0xD6;
pc = pc + 4;

dst_reg = instr[23:20];
dst_val = rf[dst_reg];

res = dst_val + 32'h1;

rf[dst_reg] = res;

// Update condition codes (V when incrementing max positive)
flag_N = res[31];
flag_Z = (res == 0);
flag_V = (~dst_val[31] & res[31]);
flag_C = 0;
