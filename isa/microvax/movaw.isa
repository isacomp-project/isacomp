// SPDX-License-Identifier: BSD-3-Clause
// MOVAW - Move Address of Word
// Opcode: 0x3E
// Format: [opcode:8][base:4][dst:4][offset:16]
// Compute address (base + offset*2) and store in dst

isa_state pc[31:0];
var instr[31:0];
isa_state rf[31:0][3:0];
mem umem[12:0];

var base_reg[3:0];
var dst_reg[3:0];
var offset[15:0];
var base[31:0];
var sext_offset[31:0];
var addr[31:0];

instr = umem[pc];
assume instr[31:24] == 0x3E;

base_reg = instr[23:20];
dst_reg = instr[19:16];
offset = instr[15:0];

base = rf[base_reg];
sext_offset = {{16{offset[15]}}, offset};
addr = base + sext_offset;

rf[dst_reg] = addr;
pc = pc + 4;
