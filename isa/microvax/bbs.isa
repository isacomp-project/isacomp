// SPDX-License-Identifier: BSD-3-Clause

isa_state pc[31:0];
var instr[31:0];
isa_state rf[31:0][3:0];
mem umem[12:0];

var pos_reg[3:0];
var base_reg[3:0];
var displacement[11:0];
var sign_ext_disp[31:0];
var pos_val[31:0];
var base_val[31:0];
var bit_pos[4:0];
var bit_val[0:0];
var cond[0:0];
var target[31:0];

instr = umem[pc];
assume instr[31:24] == 0xE1;

pos_reg = instr[23:20];
base_reg = instr[19:16];
displacement = instr[11:0];

pos_val = rf[pos_reg];
base_val = rf[base_reg];
bit_pos = pos_val[4:0];

bit_val = (base_val >> bit_pos) & 1;

sign_ext_disp = {{20{displacement[11]}}, displacement};
target = pc + sign_ext_disp;

cond = bit_val == 1;

pc = cond ? target : pc + 4;
