// CMPF - Compare F_floating
// Opcode: 0x51
// Format: [opcode:8][src1:4][src2:4][unused:16]
// Compare src1 to src2 and set condition codes

isa_state pc[31:0];
var instr[31:0];
isa_state rf[31:0][3:0];
isa_state flag_N[0:0];
isa_state flag_Z[0:0];
isa_state flag_V[0:0];
isa_state flag_C[0:0];
mem umem[12:0];

var src1_reg[3:0];
var src2_reg[3:0];
var src1_val[31:0];
var src2_val[31:0];
var res[31:0];
var rm[2:0];

instr = umem[pc];
assume instr[31:24] == 0x51;
pc = pc + 4;

src1_reg = instr[23:20];
src2_reg = instr[19:16];

src1_val = rf[src1_reg];
src2_val = rf[src2_reg];

// Compute src1 - src2 for comparison
rm = 3'b000;
res = fp_sub(src1_val, src2_val, rm);

// Update condition codes based on comparison result
flag_N = res[31];
flag_Z = (res[30:0] == 0);
flag_V = 0;
flag_C = 0;
