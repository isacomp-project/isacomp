isa_state pc[31:0];
var instr[31:0];
isa_state rf[31:0][3:0];
isa_state flag_N[0:0];
isa_state flag_Z[0:0];
isa_state flag_V[0:0];
isa_state flag_C[0:0];
mem umem[12:0];

var dst_reg[3:0];
var imm[19:0];
var sign_ext_imm[31:0];

instr = umem[pc];
assume instr[31:24] == 0xD1;
pc = pc + 4;

dst_reg = instr[23:20];
imm = instr[19:0];

sign_ext_imm = {{12{imm[19]}}, imm};

rf[dst_reg] = sign_ext_imm;

// Update condition codes (move: N, Z set based on moved value, V=0)
flag_N = sign_ext_imm[31];
flag_Z = (sign_ext_imm == 0);
flag_V = 0;
