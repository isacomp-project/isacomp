isa_state pc[31:0];
var instr[31:0];
isa_state rf[31:0][3:0];
mem umem[12:0];

var src_reg[3:0];
var src_val[31:0];
var sp_val[31:0];
var new_sp[31:0];

instr = umem[pc];
assume instr[31:24] == 0xDD;
pc = pc + 4;

src_reg = instr[23:20];
src_val = rf[src_reg];

sp_val = rf[4'hE];
new_sp = sp_val - 4;

umem[new_sp] = src_val;
rf[4'hE] = new_sp;
