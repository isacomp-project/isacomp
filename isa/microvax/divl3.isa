// SPDX-License-Identifier: BSD-3-Clause

isa_state pc[31:0];
var instr[31:0];
isa_state rf[31:0][3:0];
isa_state flag_N[0:0];
isa_state flag_Z[0:0];
isa_state flag_V[0:0];
isa_state flag_C[0:0];
mem umem[12:0];

var src1_reg[3:0];
var src2_reg[3:0];
var dst_reg[3:0];
var src1_val[31:0];
var src2_val[31:0];
var res[31:0];

instr = umem[pc];
assume instr[31:24] == 0x87;
pc = pc + 4;

src1_reg = instr[23:20];
src2_reg = instr[19:16];
dst_reg = instr[15:12];

src1_val = rf[src1_reg];
src2_val = rf[src2_reg];

// VAX divide: dst = src2 / src1 (divr, quo form)
res = src2_val /s src1_val;

rf[dst_reg] = res;

// Update condition codes (V=1 if division overflow, C=0)
flag_N = res[31];
flag_Z = (res == 0);
flag_V = 0;
flag_C = 0;
