// SPDX-License-Identifier: BSD-3-Clause
// REI - Return from Exception or Interrupt
// Opcode: 0x02
// Format: [opcode:8][unused:24]
// Pop PC and PSL from stack

isa_state pc[31:0];
var instr[31:0];
isa_state rf[31:0][3:0];
isa_state psl[31:0];
mem umem[12:0];

var sp[31:0];
var new_pc[31:0];
var new_psl[31:0];

instr = umem[pc];
assume instr[31:24] == 0x02;

sp = rf[14];
new_pc = umem[sp];
new_psl = umem[sp + 4];

rf[14] = sp + 8;
psl = new_psl;
pc = new_pc;
