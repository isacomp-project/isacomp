// SPDX-License-Identifier: BSD-3-Clause

isa_state pc[31:0];
var instr[31:0];
isa_state rf[31:0][3:0];
mem umem[12:0];

var src1_reg[3:0];
var src2_reg[3:0];
var dst_reg[3:0];
var dst_hi_reg[3:0];
var src1_val[31:0];
var src2_val[31:0];
var res[63:0];

instr = umem[pc];
assume instr[31:24] == 0x7C;
pc = pc + 4;

src1_reg = instr[23:20];
src2_reg = instr[19:16];
dst_reg = instr[15:12];
dst_hi_reg = instr[11:8];

src1_val = rf[src1_reg];
src2_val = rf[src2_reg];

res = src1_val * src2_val;

rf[dst_reg] = res[31:0];
rf[dst_hi_reg] = res[63:32];
