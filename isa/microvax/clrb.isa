isa_state pc[31:0];
var instr[31:0];
isa_state rf[31:0][3:0];
isa_state flag_N[0:0];
isa_state flag_Z[0:0];
isa_state flag_V[0:0];
isa_state flag_C[0:0];
mem umem[12:0];

var dst_reg[3:0];
var dst_val[31:0];

instr = umem[pc];
assume instr[31:24] == 0x94;
pc = pc + 4;

dst_reg = instr[23:20];
dst_val = rf[dst_reg];

rf[dst_reg] = {dst_val[31:8], 8'h0};

// Update condition codes (clear sets Z=1, N=V=C=0)
flag_N = 0;
flag_Z = 1;
flag_V = 0;
flag_C = 0;
