// SPDX-License-Identifier: BSD-3-Clause
// ADWC - Add With Carry
// Opcode: 0xD9
// Format: [opcode:8][src:4][dst:4][unused:16]
// dst = dst + src + carry

isa_state pc[31:0];
var instr[31:0];
isa_state rf[31:0][3:0];
isa_state flag_N[0:0];
isa_state flag_Z[0:0];
isa_state flag_V[0:0];
isa_state flag_C[0:0];
mem umem[12:0];

var src_reg[3:0];
var dst_reg[3:0];
var src[31:0];
var dst[31:0];
var carry[0:0];
var result[31:0];
var result_ext[32:0];

instr = umem[pc];
assume instr[31:24] == 0xD9;

src_reg = instr[23:20];
dst_reg = instr[19:16];

src = rf[src_reg];
dst = rf[dst_reg];
carry = flag_C;

result_ext = {1'b0, dst} + {1'b0, src} + {32'b0, carry};
result = result_ext[31:0];
rf[dst_reg] = result;
pc = pc + 4;

// Update condition codes
flag_N = result[31];
flag_Z = (result == 0);
flag_V = (~dst[31] & ~src[31] & result[31]) | (dst[31] & src[31] & ~result[31]);
flag_C = result_ext[32];
