isa_state pc[31:0];
var instr[31:0];
isa_state rf[31:0][3:0];
mem umem[12:0];

var base_reg[3:0];
var dst_reg[3:0];
var offset[15:0];
var sign_ext_offset[31:0];
var base_val[31:0];
var addr[31:0];
var data[31:0];

instr = umem[pc];
assume instr[31:24] == 0xE0;
pc = pc + 4;

base_reg = instr[23:20];
dst_reg = instr[19:16];
offset = instr[15:0];

sign_ext_offset = {{16{offset[15]}}, offset};
base_val = rf[base_reg];

addr = base_val + sign_ext_offset;
data = umem[addr];

rf[dst_reg] = data;
