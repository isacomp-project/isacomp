isa_state pc[31:0];
var instr[31:0];
isa_state rf[31:0][3:0];
isa_state flag_N[0:0];
isa_state flag_Z[0:0];
isa_state flag_V[0:0];
isa_state flag_C[0:0];
mem umem[12:0];

var src1_reg[3:0];
var src2_reg[3:0];
var dst_reg[3:0];
var src1_val[7:0];
var src2_val[7:0];
var res[7:0];
var res_ext[8:0];

instr = umem[pc];
assume instr[31:24] == 0x81;
pc = pc + 4;

src1_reg = instr[23:20];
src2_reg = instr[19:16];
dst_reg = instr[15:12];

src1_val = rf[src1_reg][7:0];
src2_val = rf[src2_reg][7:0];

res_ext = {1'b0, src1_val} + {1'b0, src2_val};
res = res_ext[7:0];

rf[dst_reg] = {{24{1'b0}}, res};

// Update condition codes (byte)
flag_N = res[7];
flag_Z = (res == 0);
flag_V = (~src1_val[7] & ~src2_val[7] & res[7]) | (src1_val[7] & src2_val[7] & ~res[7]);
flag_C = res_ext[8];
