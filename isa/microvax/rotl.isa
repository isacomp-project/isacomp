// SPDX-License-Identifier: BSD-3-Clause

isa_state pc[31:0];
var instr[31:0];
isa_state rf[31:0][3:0];
isa_state flag_N[0:0];
isa_state flag_Z[0:0];
isa_state flag_V[0:0];
isa_state flag_C[0:0];
mem umem[12:0];

var cnt_reg[3:0];
var src_reg[3:0];
var dst_reg[3:0];
var cnt_val[31:0];
var src_val[31:0];
var shift_amt[4:0];
var left_part[31:0];
var right_part[31:0];
var res[31:0];

instr = umem[pc];
assume instr[31:24] == 0x9C;
pc = pc + 4;

cnt_reg = instr[23:20];
src_reg = instr[19:16];
dst_reg = instr[15:12];

cnt_val = rf[cnt_reg];
src_val = rf[src_reg];

shift_amt = cnt_val[4:0];
left_part = src_val << shift_amt;
right_part = src_val >> (32 - shift_amt);
res = left_part | right_part;

rf[dst_reg] = res;

// Update condition codes (rotate: N, Z set, V=0, C=0)
flag_N = res[31];
flag_Z = (res == 0);
flag_V = 0;
flag_C = 0;
