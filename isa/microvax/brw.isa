isa_state pc[31:0];
var instr[31:0];
isa_state rf[31:0][3:0];
isa_state flag_N[0:0];
isa_state flag_Z[0:0];
isa_state flag_V[0:0];
isa_state flag_C[0:0];
mem umem[12:0];

var displacement[23:0];
var sign_ext_disp[31:0];
var target[31:0];

instr = umem[pc];
assume instr[31:24] == 0x31;

displacement = instr[23:0];

sign_ext_disp = {{8{displacement[23]}}, displacement};
target = pc + sign_ext_disp;

pc = target;
