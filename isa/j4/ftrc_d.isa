// SPDX-License-Identifier: BSD-3-Clause
// FTRC DRm,FPUL - Convert double-precision float to 32-bit integer (truncate)
// FPUL = (int)DRm (when FPSCR.PR=1)
// Encoding: 1111mmm000111101 (0xFm3D) with m even
isa_state pc[31:0];
var instr[15:0];
isa_state fpr[31:0][3:0];
isa_state fpul[31:0];
mem umem[23:0];

var drm[2:0];
var frm_idx[3:0];
var DRm_hi[31:0];
var DRm_lo[31:0];
var DRm[63:0];
var rm[1:0];

isa_state delay_slot[0:0];
isa_state branch_target[31:0];
aspect delay_slot.isa gates pc, delay_slot;

instr = umem[pc];
assume instr[15:12] == 0xF;
assume instr[7:0] == 0x3D;
assume instr[8] == 1'b0;

drm = instr[11:9];
frm_idx = {drm, 1'b0};

DRm_hi = fpr[frm_idx];
DRm_lo = fpr[frm_idx + 1];
DRm = {DRm_hi, DRm_lo};

// FTRC always truncates toward zero (RTZ = 01)
rm = 2'b01;

fpul = fp_cvt_w_d(DRm, rm);

pc = pc + 2;
