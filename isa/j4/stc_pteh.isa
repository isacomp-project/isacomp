// SPDX-License-Identifier: BSD-3-Clause
// STC PTEH,Rn - Store PTEH to register
// Encoding: 0000nnnn00000101 (0x0n05)
isa_state pc[31:0];
var instr[15:0];
isa_state rf[31:0][3:0];
isa_state rf_bank[31:0][2:0];
isa_state sr[31:0];
isa_state pteh[31:0];
mem umem[23:0];

var rn[3:0];
var stc_pteh_rn_lo[2:0];
var stc_pteh_rb[0:0];
var stc_pteh_rn_bk[0:0];

isa_state delay_slot[0:0];
isa_state branch_target[31:0];
aspect delay_slot.isa gates pc, delay_slot;

instr = umem[pc];
assume instr[15:12] == 0x0;
assume instr[7:0] == 0x05;
rn = instr[11:8];

stc_pteh_rn_lo = rn[2:0];
stc_pteh_rb = sr[29];  // RB bit (bit 29 in SR)
stc_pteh_rn_bk = (rn[3] == 1'b0) & stc_pteh_rb;

rf[rn] when (stc_pteh_rn_bk == 0) = pteh;
rf_bank[stc_pteh_rn_lo] when (stc_pteh_rn_bk) = pteh;
pc = pc + 2;
