// BT - Branch if True (no delay slot)
isa_state pc[31:0];
var instr[15:0];
isa_state t[0:0];
mem umem[23:0];

var disp[7:0];
var sign_ext_disp[31:0];
var branch_offset[31:0];
var branch_dest[31:0];

isa_state delay_slot[0:0];
isa_state branch_target[31:0];
aspect delay_slot.isa gates pc, delay_slot;

instr = umem[pc];
assume instr[15:8] == 0x89;
disp = instr[7:0];

sign_ext_disp = {{23{disp[7]}}, disp, 1'b0};
branch_offset = sign_ext_disp + 4;
branch_dest = pc + branch_offset;

// BT does NOT have a delay slot - immediate branch if T=1
pc = t ? branch_dest : (pc + 2);
