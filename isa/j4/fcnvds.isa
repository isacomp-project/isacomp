// FCNVDS DRm,FPUL - Convert double to single precision
// FPUL = (float)DRm
// Encoding: 1111mmm010111101 (0xFmBD) with m even
isa_state pc[31:0];
var instr[15:0];
isa_state fpr[31:0][3:0];
isa_state fpul[31:0];
isa_state fpscr[31:0];
mem umem[23:0];

var drm[2:0];
var frm_idx[3:0];
var DRm_hi[31:0];
var DRm_lo[31:0];
var DRm[63:0];
var rm[1:0];

isa_state delay_slot[0:0];
isa_state branch_target[31:0];
aspect delay_slot.isa gates pc, delay_slot;

instr = umem[pc];
assume instr[15:12] == 0xF;
assume instr[7:0] == 0xBD;
assume instr[8] == 1'b0;

drm = instr[11:9];
frm_idx = {drm, 1'b0};

DRm_hi = fpr[frm_idx];
DRm_lo = fpr[frm_idx + 1];
DRm = {DRm_hi, DRm_lo};

rm = fpscr[1:0];

// Convert double to single
fpul = fp_cvt_s_d(DRm, rm);

pc = pc + 2;
