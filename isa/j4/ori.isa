isa_state pc[31:0];
var instr[15:0];
isa_state rf[31:0][3:0];
isa_state rf_bank[31:0][2:0];
isa_state sr[31:0];
mem umem[23:0];

var imm[7:0];
var R0[31:0];
var res[31:0];

var ori_rb[0:0];

isa_state delay_slot[0:0];
isa_state branch_target[31:0];
aspect delay_slot.isa gates pc, delay_slot;

instr = umem[pc];
assume instr[15:8] == 0xCB;
imm = instr[7:0];

ori_rb = sr[29];  // RB bit (bit 29 in SR)
R0 = ori_rb ? rf_bank[0] : rf[0];

res = R0 | {24'b0, imm};

rf[0] when (ori_rb == 0) = res;
rf_bank[0] when (ori_rb) = res;
pc = pc + 2;
