isa_state pc[31:0];
var instr[15:0];
isa_state rf[31:0][3:0];
isa_state rf_bank[31:0][2:0];  // Banked R0-R7 for RB=1
isa_state sr[31:0];
mem umem[23:0];
isa_state gbr[31:0];

var disp[7:0];
var movb_gbr_store_addr[31:0];
var R0[31:0];
var byte_data[7:0];

// Register banking variables (unique to movb_gbr_store instruction)
var movb_gbr_store_r0_lo[2:0];
var movb_gbr_store_rb[0:0];

// Branch delay slot state
isa_state delay_slot[0:0];
isa_state branch_target[31:0];

// Include delay slot aspect - handles PC override if we're in a delay slot
aspect delay_slot.isa gates pc, delay_slot;

instr = umem[pc];
assume instr[15:8] == 0xC0;
disp = instr[7:0];

// Register banking setup for R0
movb_gbr_store_r0_lo = 3'b000;
movb_gbr_store_rb = sr[29];  // RB bit (bit 29 in SR)

// MOV.B R0,@(disp,GBR): movb_gbr_store_addr = GBR + disp
movb_gbr_store_addr = gbr + {24'b0, disp};

R0 = movb_gbr_store_rb ? rf_bank[movb_gbr_store_r0_lo] : rf[0];
byte_data = R0[7:0];
umem[movb_gbr_store_addr] = byte_data;
pc = pc + 2;
