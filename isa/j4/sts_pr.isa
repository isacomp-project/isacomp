// SPDX-License-Identifier: BSD-3-Clause
// STS PR,Rn - Store PR to register
isa_state pc[31:0];
var instr[15:0];
isa_state rf[31:0][3:0];
isa_state rf_bank[31:0][2:0];
isa_state sr[31:0];
isa_state pr[31:0];
mem umem[23:0];

var rn[3:0];
var sts_pr_rn_lo[2:0];

var sts_pr_rb[0:0];
var sts_pr_rn_bk[0:0];

isa_state delay_slot[0:0];
isa_state branch_target[31:0];
aspect delay_slot.isa gates pc, delay_slot;

instr = umem[pc];
assume instr[15:12] == 0x0;
assume instr[7:0] == 0x2A;
rn = instr[11:8];
sts_pr_rn_lo = rn[2:0];

sts_pr_rb = sr[29];  // RB bit (bit 29 in SR)
sts_pr_rn_bk = (rn[3] == 1'b0) & sts_pr_rb;

rf[rn] when (sts_pr_rn_bk == 0) = pr;
rf_bank[sts_pr_rn_lo] when (sts_pr_rn_bk) = pr;
pc = pc + 2;
