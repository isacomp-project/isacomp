CAPI=2:

name: isacomp:j4_complete:1.0.0
description: ISAComp generated j4_complete processor

filesets:
  rtl:
    files:
      - j4_complete.v
    file_type: systemVerilogSource

  tb:
    files:
      - j4_complete_tb.sv
    file_type: systemVerilogSource
    depend:
      - ::elf-loader

parameters:
  elf_load:
    datatype: file
    description: ELF file to load for testing
    paramtype: plusarg
  pass_addr:
    datatype: str
    description: PC address that indicates test pass
    paramtype: plusarg
  fail_addr:
    datatype: str
    description: PC address that indicates test fail
    paramtype: plusarg

targets:
  default:
    filesets: [rtl]
    toplevel: j4_complete

  sim:
    default_tool: icarus
    filesets: [rtl, tb]
    toplevel: j4_complete_tb
    parameters: [elf_load, pass_addr, fail_addr]
    tools:
      icarus:
        iverilog_options:
          - -g2012  # Enable SystemVerilog support
      modelsim:
        vlog_options:
          - -sv
      verilator:
        mode: cc
        verilator_options:
          - --trace
          - -Wall

