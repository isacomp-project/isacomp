// SPDX-License-Identifier: BSD-3-Clause
isa_state pc[31:0];
var instr[15:0];
isa_state rf[31:0][3:0];
isa_state rf_bank[31:0][2:0];
isa_state sr[31:0];
isa_state t[0:0];
mem umem[23:0];

var rn[3:0];
var rm[3:0];
var negc_rn_lo[2:0];
var negc_rm_lo[2:0];
var Rm[31:0];
var res[32:0];

var negc_rb[0:0];
var negc_rn_bk[0:0];
var negc_rm_bk[0:0];

isa_state delay_slot[0:0];
isa_state branch_target[31:0];
aspect delay_slot.isa gates pc, delay_slot;

instr = umem[pc];
assume instr[15:12] == 0x6;
assume instr[3:0] == 0xA;
rn = instr[11:8];
rm = instr[7:4];
negc_rn_lo = rn[2:0];
negc_rm_lo = rm[2:0];

negc_rb = sr[29];  // RB bit (bit 29 in SR)
negc_rn_bk = (rn[3] == 1'b0) & negc_rb;
negc_rm_bk = (rm[3] == 1'b0) & negc_rb;

Rm = negc_rm_bk ? rf_bank[negc_rm_lo] : rf[rm];

res = {1'b0, 32'b0} - {1'b0, Rm} - {32'b0, t};

rf[rn] when (negc_rn_bk == 0) = res[31:0];
rf_bank[negc_rn_lo] when (negc_rn_bk) = res[31:0];
t = res[32];  // Borrow
pc = pc + 2;
