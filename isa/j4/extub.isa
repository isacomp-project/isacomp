// SPDX-License-Identifier: BSD-3-Clause
// EXTU.B Rm,Rn - Extend unsigned from byte
isa_state pc[31:0];
var instr[15:0];
isa_state rf[31:0][3:0];
isa_state rf_bank[31:0][2:0];
isa_state sr[31:0];
mem umem[23:0];

var rn[3:0];
var rm[3:0];
var eub_rn_lo[2:0];
var eub_rm_lo[2:0];
var Rm[31:0];
var res[31:0];

var eub_rb[0:0];
var eub_rn_bk[0:0];
var eub_rm_bk[0:0];

isa_state delay_slot[0:0];
isa_state branch_target[31:0];
aspect delay_slot.isa gates pc, delay_slot;

instr = umem[pc];
assume instr[15:12] == 0x6;
assume instr[3:0] == 0xC;
rn = instr[11:8];
rm = instr[7:4];
eub_rn_lo = rn[2:0];
eub_rm_lo = rm[2:0];

eub_rb = sr[29];  // RB bit (bit 29 in SR)
eub_rn_bk = (rn[3] == 1'b0) & eub_rb;
eub_rm_bk = (rm[3] == 1'b0) & eub_rb;

Rm = eub_rm_bk ? rf_bank[eub_rm_lo] : rf[rm];

res = {24'b0, Rm[7:0]};

rf[rn] when (eub_rn_bk == 0) = res;
rf_bank[eub_rn_lo] when (eub_rn_bk) = res;
pc = pc + 2;
