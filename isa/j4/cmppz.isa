// SPDX-License-Identifier: BSD-3-Clause
isa_state pc[31:0];
var instr[15:0];
isa_state rf[31:0][3:0];
isa_state rf_bank[31:0][2:0];
isa_state sr[31:0];
isa_state t[0:0];
mem umem[23:0];

var rn[3:0];
var cmppz_rn_lo[2:0];
var Rn[31:0];

var cmppz_rb[0:0];
var cmppz_rn_bk[0:0];

isa_state delay_slot[0:0];
isa_state branch_target[31:0];
aspect delay_slot.isa gates pc, delay_slot;

instr = umem[pc];
assume instr[15:12] == 0x4;
assume instr[7:0] == 0x11;
rn = instr[11:8];
cmppz_rn_lo = rn[2:0];

cmppz_rb = sr[29];  // RB bit (bit 29 in SR)
cmppz_rn_bk = (rn[3] == 1'b0) & cmppz_rb;

Rn = cmppz_rn_bk ? rf_bank[cmppz_rn_lo] : rf[rn];

// Rn >= 0 (signed) - just check sign bit
t = (Rn[31] == 0);
pc = pc + 2;
