// SPDX-License-Identifier: BSD-3-Clause
// LDC Rm,TTB - Load TTB from register
// Encoding: 0100mmmm00100101 (0x4m25)
// Sets Translation Table Base for page table walks
isa_state pc[31:0];
var instr[15:0];
isa_state rf[31:0][3:0];
isa_state rf_bank[31:0][2:0];
isa_state sr[31:0];
isa_state ttb[31:0];
mem umem[23:0];

var rm[3:0];
var Rm[31:0];
var ldc_ttb_rm_lo[2:0];
var ldc_ttb_rb[0:0];
var ldc_ttb_rm_bk[0:0];

isa_state delay_slot[0:0];
isa_state branch_target[31:0];
aspect delay_slot.isa gates pc, delay_slot;

instr = umem[pc];
assume instr[15:12] == 0x4;
assume instr[7:0] == 0x25;
rm = instr[11:8];

ldc_ttb_rm_lo = rm[2:0];
ldc_ttb_rb = sr[29];  // RB bit (bit 29 in SR)
ldc_ttb_rm_bk = (rm[3] == 1'b0) & ldc_ttb_rb;

Rm = ldc_ttb_rm_bk ? rf_bank[ldc_ttb_rm_lo] : rf[rm];

ttb = Rm;
pc = pc + 2;
