// SPDX-License-Identifier: BSD-3-Clause
// STS FPSCR,Rn - Store FPSCR to register
isa_state pc[31:0];
var instr[15:0];
isa_state rf[31:0][3:0];
isa_state rf_bank[31:0][2:0];
isa_state sr[31:0];
mem umem[23:0];

isa_state fpscr[31:0];

var rn[3:0];
var sts_fpscr_rn_lo[2:0];

var sts_fpscr_rb[0:0];
var sts_fpscr_rn_bk[0:0];

isa_state delay_slot[0:0];
isa_state branch_target[31:0];
aspect delay_slot.isa gates pc, delay_slot;

instr = umem[pc];
assume instr[15:12] == 0x0;
assume instr[7:0] == 0x6A;
rn = instr[11:8];
sts_fpscr_rn_lo = rn[2:0];

sts_fpscr_rb = sr[29];  // RB bit (bit 29 in SR)
sts_fpscr_rn_bk = (rn[3] == 1'b0) & sts_fpscr_rb;

rf[rn] when (sts_fpscr_rn_bk == 0) = fpscr;
rf_bank[sts_fpscr_rn_lo] when (sts_fpscr_rn_bk) = fpscr;
pc = pc + 2;
