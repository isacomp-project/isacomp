// SPDX-License-Identifier: BSD-3-Clause
isa_state pc[31:0];
var instr[15:0];
isa_state rf[31:0][3:0];
isa_state rf_bank[31:0][2:0];
isa_state sr[31:0];
mem umem[23:0];
isa_state gbr[31:0];

var rn[3:0];
var Rn[31:0];
var lds_gbr_rb[0:0];
var lds_gbr_rn_lo[2:0];
var lds_gbr_rn_bk[0:0];

// Branch delay slot state
isa_state delay_slot[0:0];
isa_state branch_target[31:0];

// Include delay slot aspect - handles PC override if we're in a delay slot
aspect delay_slot.isa gates pc, delay_slot;

// Include interrupt aspect - checks for pending external interrupts
aspect interrupt.isa gates pc, sr, ssr, spc, intevt;

// MMU translation aspect for instruction fetch (PC -> pc_pa)
// Added AFTER delay_slot for higher precedence - exceptions override branches
#ifdef MMU
aspect mmu_translate_instr_cam.isa gates pc, tea, spc, delay_slot, ssr, sr, expevt;
#endif
aspect exception.isa gates pc, sr, vbr, ssr, spc, expevt, tea, pteh;

#ifdef MMU
instr = umem[pc_pa];
#else
instr = umem[pc];
#endif
assume instr[15:12] == 0x4;
assume instr[7:0] == 0x1E;
rn = instr[11:8];

lds_gbr_rn_lo = rn[2:0];
lds_gbr_rb = sr[29];  // RB bit (bit 29 in SR)
lds_gbr_rn_bk = (rn[3] == 1'b0) & lds_gbr_rb;

Rn = lds_gbr_rn_bk ? rf_bank[lds_gbr_rn_lo] : rf[rn];

// LDS Rm, GBR: copy Rm to GBR (Rm is in bits 11:8, we use rn for consistency)
gbr when (~int_should_take & ~itlb_exc_actually_taken) = Rn;
pc = pc + 2;
