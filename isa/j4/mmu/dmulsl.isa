// SPDX-License-Identifier: BSD-3-Clause
isa_state pc[31:0];
var instr[15:0];
isa_state rf[31:0][3:0];
isa_state rf_bank[31:0][2:0];
isa_state sr[31:0];
mem umem[23:0];
isa_state mach[31:0];
isa_state macl[31:0];

var rn[3:0];
var rm[3:0];
var Rn[31:0];
var Rm[31:0];
var Rn_ext[63:0];
var Rm_ext[63:0];
var res[63:0];
var dmulsl_rb[0:0];
var dmulsl_rn_lo[2:0];
var dmulsl_rm_lo[2:0];
var dmulsl_rn_bk[0:0];
var dmulsl_rm_bk[0:0];

// Branch delay slot state
isa_state delay_slot[0:0];
isa_state branch_target[31:0];

// Include delay slot aspect - handles PC override if we're in a delay slot
aspect delay_slot.isa gates pc, delay_slot;

// Include interrupt aspect - checks for pending external interrupts
aspect interrupt.isa gates pc, sr, ssr, spc, intevt;

// MMU translation aspect for instruction fetch (PC -> pc_pa)
// Added AFTER delay_slot for higher precedence - exceptions override branches
#ifdef MMU
aspect mmu_translate_instr_cam.isa gates pc, tea, spc, delay_slot, ssr, sr, expevt;
#endif
aspect exception.isa gates pc, sr, vbr, ssr, spc, expevt, tea, pteh;

#ifdef MMU
instr = umem[pc_pa];
#else
instr = umem[pc];
#endif
assume instr[15:12] == 0x3;
assume instr[3:0] == 0xD;
rn = instr[11:8];
rm = instr[7:4];

dmulsl_rn_lo = rn[2:0];
dmulsl_rm_lo = rm[2:0];
dmulsl_rb = sr[29];  // RB bit (bit 29 in SR)
dmulsl_rn_bk = (rn[3] == 1'b0) & dmulsl_rb;
dmulsl_rm_bk = (rm[3] == 1'b0) & dmulsl_rb;

Rn = dmulsl_rn_bk ? rf_bank[dmulsl_rn_lo] : rf[rn];
Rm = dmulsl_rm_bk ? rf_bank[dmulsl_rm_lo] : rf[rm];

// Sign extend to 64-bit
Rn_ext = {{32{Rn[31]}}, Rn};
Rm_ext = {{32{Rm[31]}}, Rm};

// Signed 64-bit multiply
res = Rn_ext * Rm_ext;

// Store result in MACH:MACL
mach when (~int_should_take & ~itlb_exc_actually_taken) = res[63:32];
macl when (~int_should_take & ~itlb_exc_actually_taken) = res[31:0];
pc = pc + 2;
