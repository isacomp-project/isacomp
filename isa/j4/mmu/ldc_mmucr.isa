// SPDX-License-Identifier: BSD-3-Clause
// LDC Rm,MMUCR - Load MMUCR from register
// Encoding: 0100mmmm00110101 (0x4m35)
// Controls MMU enable, TLB invalidate, and replacement policy
isa_state pc[31:0];
var instr[15:0];
isa_state rf[31:0][3:0];
isa_state rf_bank[31:0][2:0];
isa_state sr[31:0];
isa_state mmucr[31:0];
mem umem[23:0];

// TLB arrays for invalidation
isa_state utlb_v[0:0][5:0];
isa_state itlb_v[0:0][1:0];

var rm[3:0];
var Rm[31:0];
var ldc_mmucr_rm_lo[2:0];
var ldc_mmucr_rb[0:0];
var ldc_mmucr_rm_bk[0:0];
var ti_bit[0:0];

isa_state delay_slot[0:0];
isa_state branch_target[31:0];
aspect delay_slot.isa gates pc, delay_slot;

// Include interrupt aspect - checks for pending external interrupts
aspect interrupt.isa gates pc, sr, ssr, spc, intevt;

// MMU translation aspect for instruction fetch (PC -> pc_pa)
// Added AFTER delay_slot for higher precedence - exceptions override branches
#ifdef MMU
aspect mmu_translate_instr_cam.isa gates pc, tea, spc, delay_slot, ssr, sr, expevt;
#endif
aspect exception.isa gates pc, sr, vbr, ssr, spc, expevt, tea, pteh;

#ifdef MMU
instr = umem[pc_pa];
#else
instr = umem[pc];
#endif
assume instr[15:12] == 0x4;
assume instr[7:0] == 0x35;
rm = instr[11:8];

ldc_mmucr_rm_lo = rm[2:0];
ldc_mmucr_rb = sr[29];  // RB bit (bit 29 in SR)
ldc_mmucr_rm_bk = (rm[3] == 1'b0) & ldc_mmucr_rb;

Rm = ldc_mmucr_rm_bk ? rf_bank[ldc_mmucr_rm_lo] : rf[rm];

// Check TI (TLB Invalidate) bit - if set, invalidate all TLB entries
ti_bit = Rm[2];

// Invalidate all UTLB entries if TI=1
utlb_v[0] when (~int_should_take & ~itlb_exc_actually_taken & (ti_bit)) = 1'b0;
utlb_v[1] when (~int_should_take & ~itlb_exc_actually_taken & (ti_bit)) = 1'b0;
utlb_v[2] when (~int_should_take & ~itlb_exc_actually_taken & (ti_bit)) = 1'b0;
utlb_v[3] when (~int_should_take & ~itlb_exc_actually_taken & (ti_bit)) = 1'b0;
utlb_v[4] when (~int_should_take & ~itlb_exc_actually_taken & (ti_bit)) = 1'b0;
utlb_v[5] when (~int_should_take & ~itlb_exc_actually_taken & (ti_bit)) = 1'b0;
utlb_v[6] when (~int_should_take & ~itlb_exc_actually_taken & (ti_bit)) = 1'b0;
utlb_v[7] when (~int_should_take & ~itlb_exc_actually_taken & (ti_bit)) = 1'b0;
utlb_v[8] when (~int_should_take & ~itlb_exc_actually_taken & (ti_bit)) = 1'b0;
utlb_v[9] when (~int_should_take & ~itlb_exc_actually_taken & (ti_bit)) = 1'b0;
utlb_v[10] when (~int_should_take & ~itlb_exc_actually_taken & (ti_bit)) = 1'b0;
utlb_v[11] when (~int_should_take & ~itlb_exc_actually_taken & (ti_bit)) = 1'b0;
utlb_v[12] when (~int_should_take & ~itlb_exc_actually_taken & (ti_bit)) = 1'b0;
utlb_v[13] when (~int_should_take & ~itlb_exc_actually_taken & (ti_bit)) = 1'b0;
utlb_v[14] when (~int_should_take & ~itlb_exc_actually_taken & (ti_bit)) = 1'b0;
utlb_v[15] when (~int_should_take & ~itlb_exc_actually_taken & (ti_bit)) = 1'b0;

// Invalidate all ITLB entries if TI=1
itlb_v[0] when (~int_should_take & ~itlb_exc_actually_taken & (ti_bit)) = 1'b0;
itlb_v[1] when (~int_should_take & ~itlb_exc_actually_taken & (ti_bit)) = 1'b0;
itlb_v[2] when (~int_should_take & ~itlb_exc_actually_taken & (ti_bit)) = 1'b0;
itlb_v[3] when (~int_should_take & ~itlb_exc_actually_taken & (ti_bit)) = 1'b0;

// Write MMUCR (TI bit auto-clears after invalidation)
mmucr when (~int_should_take & ~itlb_exc_actually_taken) = {Rm[31:3], 1'b0, Rm[1:0]};  // Clear TI bit

// Also write to umem at P4-mapped byte address so kernel can read back via P4 loads
// and LDTLB can read URC from umem
// (ISA compiler converts to word index via addr[31:2] automatically)
var ldc_mmucr_p4_addr[31:0];
ldc_mmucr_p4_addr = 32'h03FF0010;  // MMUCR: P4 0xFF000010 -> byte 0x03FF0010
umem[ldc_mmucr_p4_addr] when (~int_should_take & ~itlb_exc_actually_taken) = {Rm[31:3], 1'b0, Rm[1:0]};

pc = pc + 2;
