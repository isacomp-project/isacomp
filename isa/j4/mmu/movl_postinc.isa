// SPDX-License-Identifier: BSD-3-Clause
isa_state pc[31:0];
var instr[15:0];
isa_state rf[31:0][3:0];
isa_state rf_bank[31:0][2:0];
mem umem[23:0];
isa_state t[0:0];

isa_state sr[31:0];
isa_state vbr[31:0];
isa_state ssr[31:0];
isa_state spc[31:0];

var rn[3:0];
var rm[3:0];
var Rm[31:0];
var data32[31:0];

// Virtual address for data translation
var mmu_va[31:0];

var load_addr[31:0];
var load_size[1:0];
var movl_pi_no_error[0:0];

var movl_pi_rn_lo[2:0];
var movl_pi_rm_lo[2:0];
var movl_pi_rb[0:0];
var movl_pi_rn_bk[0:0];
var movl_pi_rm_bk[0:0];

isa_state delay_slot[0:0];
isa_state branch_target[31:0];
aspect delay_slot.isa gates pc, delay_slot;

// Include interrupt aspect - checks for pending external interrupts
aspect interrupt.isa gates pc, sr, ssr, spc, intevt;

// MMU translation aspect for instruction fetch (PC -> pc_pa)
// Added AFTER delay_slot for higher precedence - exceptions override branches
#ifdef MMU
aspect mmu_translate_instr_cam.isa gates pc, tea, spc, delay_slot, ssr, sr, expevt;
#endif
aspect addr_error_load.isa gates pc, sr, vbr, rf, umem, ssr, spc;
aspect exception.isa gates pc, sr, vbr, ssr, spc, expevt, tea, pteh;

#ifdef MMU
instr = umem[pc_pa];
#else
instr = umem[pc];
#endif
assume instr[15:12] == 0x6;
assume instr[3:0] == 0x6;
rn = instr[11:8];
rm = instr[7:4];

movl_pi_rn_lo = rn[2:0];
movl_pi_rm_lo = rm[2:0];
movl_pi_rb = sr[29];  // RB bit (bit 29 in SR)
movl_pi_rn_bk = (rn[3] == 1'b0) & movl_pi_rb;
movl_pi_rm_bk = (rm[3] == 1'b0) & movl_pi_rb;

Rm = movl_pi_rm_bk ? rf_bank[movl_pi_rm_lo] : rf[rm];

load_addr = Rm;
load_size = 2'b11;

movl_pi_no_error = (Rm[1:0] == 2'b00);

// Set virtual address for data translation
mmu_va = Rm;


// Load from physical address (with or without translation)
#ifdef MMU
// Data MMU translation
var is_write[0:0];
is_write = 1'b0;
#ifdef MMU
#include "mmu_translate_data_inline.isa"
#endif

data32 = umem[addr_pa];
#else
#ifdef MMU
data32 = umem[addr_pa];
#else
data32 = umem[Rm];
#endif
#endif

// Load data to Rn
rf[rn] when (movl_pi_no_error & ((movl_pi_rn_bk == 0) & data_tlb_no_exception) & ~int_should_take & ~itlb_exc_actually_taken) = data32;
rf_bank[movl_pi_rn_lo] when (movl_pi_no_error & movl_pi_rn_bk & ~int_should_take & ~itlb_exc_actually_taken & data_tlb_no_exception) = data32;

// Post-increment Rm by 4
rf[rm] when (movl_pi_no_error & ((movl_pi_rm_bk == 0) & data_tlb_no_exception) & (rn != rm) & ~int_should_take & ~itlb_exc_actually_taken) = Rm + 4;
rf_bank[movl_pi_rm_lo] when (movl_pi_no_error & movl_pi_rm_bk & (rn != rm & data_tlb_no_exception) & ~int_should_take & ~itlb_exc_actually_taken) = Rm + 4;

// Advance PC unconditionally - exception/interrupt aspects override if needed
pc = pc + 2;
