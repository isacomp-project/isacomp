// SPDX-License-Identifier: BSD-3-Clause
// FMOV.S FRm,@Rn - Store single-precision to memory
// [Rn] = FRm
isa_state pc[31:0];
var instr[15:0];
isa_state rf[31:0][3:0];
isa_state rf_bank[31:0][2:0];
isa_state sr[31:0];
mem umem[23:0];

isa_state fr[31:0][3:0];
isa_state fpscr[31:0];

var frm[3:0];
var rn[3:0];
var fmov_store_rn_lo[2:0];
var Rn[31:0];
var FRm[31:0];
var store_addr[31:0];

var fmov_store_rb[0:0];
var fmov_store_rn_bk[0:0];

isa_state delay_slot[0:0];
isa_state branch_target[31:0];
isa_state vbr[31:0];
isa_state ssr[31:0];
isa_state spc[31:0];
isa_state t[0:0];
aspect delay_slot.isa gates pc, delay_slot;

// Include interrupt aspect - checks for pending external interrupts
aspect interrupt.isa gates pc, sr, ssr, spc, intevt;

// MMU translation aspect for instruction fetch (PC -> pc_pa)
// Added AFTER delay_slot for higher precedence - exceptions override branches
#ifdef MMU
aspect mmu_translate_instr_cam.isa gates pc, tea, spc, delay_slot, ssr, sr, expevt;
#endif
aspect addr_error_store.isa gates pc, sr, vbr, rf, umem, ssr, spc;
aspect exception.isa gates pc, sr, vbr, ssr, spc, expevt, tea, pteh;

#ifdef MMU
instr = umem[pc_pa];
#else
instr = umem[pc];
#endif
assume instr[15:12] == 0xF;
assume instr[3:0] == 0xA;
rn = instr[11:8];
frm = instr[7:4];
fmov_store_rn_lo = rn[2:0];

fmov_store_rb = sr[29];  // RB bit (bit 29 in SR)
fmov_store_rn_bk = (rn[3] == 1'b0) & fmov_store_rb;

Rn = fmov_store_rn_bk ? rf_bank[fmov_store_rn_lo] : rf[rn];
FRm = fr[frm];

// Create alias to enable proper signal generation for memory address mux
store_addr = Rn;

var mmu_va[31:0];
mmu_va = Rn;

// Data MMU translation
var is_write[0:0];
is_write = 1'b1;
#ifdef MMU
#include "mmu_translate_data_inline.isa"
#endif

#ifdef MMU
umem[addr_pa] when (~int_should_take & ~itlb_exc_actually_taken & data_tlb_no_exception) = FRm;
#else
umem[Rn] when (~int_should_take & ~itlb_exc_actually_taken) = FRm;
#endif
pc = pc + 2;
