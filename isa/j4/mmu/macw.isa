// SPDX-License-Identifier: BSD-3-Clause
isa_state pc[31:0];
var instr[15:0];
isa_state rf[31:0][3:0];
isa_state rf_bank[31:0][2:0];
mem umem[23:0];
isa_state mach[31:0];
isa_state macl[31:0];
isa_state t[0:0];

// System registers (needed for exception handling)
isa_state sr[31:0];
isa_state vbr[31:0];
isa_state ssr[31:0];
isa_state spc[31:0];

var rn[3:0];
var rm[3:0];
var Rn[31:0];
var Rm[31:0];
var macw_rb[0:0];
var macw_rn_lo[2:0];
var macw_rm_lo[2:0];
var macw_rn_bk[0:0];
var macw_rm_bk[0:0];
var addr_n[31:0];
var addr_m[31:0];
var word_n[31:0];
var word_m[31:0];
var data_n[15:0];
var data_m[15:0];
var data_n_ext[31:0];
var data_m_ext[31:0];
var product[31:0];
var result[31:0];

// Address error checking - MAC.W loads two 16-bit values
var load_addr[31:0];
var load_size[1:0];
var macw_addr_n_ok[0:0];
var macw_addr_m_ok[0:0];
var macw_no_error[0:0];

// Branch delay slot state
isa_state delay_slot[0:0];
isa_state branch_target[31:0];

// Include delay slot aspect - handles PC override if we're in a delay slot
aspect delay_slot.isa gates pc, delay_slot;

// Include interrupt aspect - checks for pending external interrupts
aspect interrupt.isa gates pc, sr, ssr, spc, intevt;

// MMU translation aspect for instruction fetch (PC -> pc_pa)
// Added AFTER delay_slot for higher precedence - exceptions override branches
#ifdef MMU
aspect mmu_translate_instr_cam.isa gates pc, tea, spc, delay_slot, ssr, sr, expevt;
#endif

// Include address error detection for loads (must be before exception.isa to set exc_taken)
aspect addr_error_load.isa gates pc, sr, vbr, rf, umem, ssr, spc;

// Include exception handling aspect
aspect exception.isa gates pc, sr, vbr, ssr, spc, expevt, tea, pteh;

#ifdef MMU
instr = umem[pc_pa];
#else
instr = umem[pc];
#endif
assume instr[15:12] == 0x4;
assume instr[3:0] == 0xF;
rn = instr[11:8];
rm = instr[7:4];

macw_rn_lo = rn[2:0];
macw_rm_lo = rm[2:0];
macw_rb = sr[29];  // RB bit (bit 29 in SR)
macw_rn_bk = (rn[3] == 1'b0) & macw_rb;
macw_rm_bk = (rm[3] == 1'b0) & macw_rb;

Rn = macw_rn_bk ? rf_bank[macw_rn_lo] : rf[rn];
Rm = macw_rm_bk ? rf_bank[macw_rm_lo] : rf[rm];

// Load words from addresses pointed by Rn and Rm
addr_n = Rn;
addr_m = Rm;

// Check both addresses for 2-byte alignment
macw_addr_n_ok = (addr_n[0] == 1'b0);
macw_addr_m_ok = (addr_m[0] == 1'b0);
macw_no_error = macw_addr_n_ok & macw_addr_m_ok;

// Set up aspect variables (use first bad address for exception info)
load_addr = macw_addr_n_ok ? addr_m : addr_n;
load_size = 2'b10;  // Word access (16-bit)

var mmu_va[31:0];
mmu_va = addr_n;

// Data MMU translation for first operand (addr_n)
var is_write[0:0];
is_write = 1'b0;
#ifdef MMU
#include "mmu_translate_data_inline.isa"
#endif

// Data MMU translation for second operand (addr_m)
var mmu_va_m[31:0];
mmu_va_m = addr_m;
var is_write_m[0:0];
is_write_m = 1'b0;
#ifdef MMU
#include "mmu_translate_data_inline2.isa"
#endif

#ifdef MMU
word_n = umem[addr_pa];
#else
word_n = umem[addr_n];
#endif
#ifdef MMU
word_m = umem[addr_pa_m];
#else
word_m = umem[addr_m];
#endif

// Extract halfwords - big endian: addr[1]=0 means high halfword, addr[1]=1 means low halfword
// For word-aligned addresses (typical case), use high halfword
data_n = word_n[31:16];
data_m = word_m[31:16];

// Sign extend 16-bit to 32-bit for signed multiply
data_n_ext = {{16{data_n[15]}}, data_n};
data_m_ext = {{16{data_m[15]}}, data_m};

// Multiply (signed 16x16 -> 32)
product = data_n_ext * data_m_ext;

// Accumulate with MACL (32-bit accumulate for MAC.W)
result = macl + product;

// Combined TLB guard: both translations must succeed
var macw_tlb_ok[0:0];
macw_tlb_ok = data_tlb_no_exception & data_m_tlb_no_exception;

// Only update state if no address error and no exception/interrupt taken
macl when (macw_no_error & ~int_should_take & ~itlb_exc_actually_taken & macw_tlb_ok) = result;

// Post-increment both registers by 2 (only if no error and no exception/interrupt)
rf[rn] when (macw_no_error & ((macw_rn_bk == 0) & macw_tlb_ok) & ~int_should_take & ~itlb_exc_actually_taken) = Rn + 2;
rf_bank[macw_rn_lo] when (macw_no_error & macw_rn_bk & ~int_should_take & ~itlb_exc_actually_taken & macw_tlb_ok) = Rn + 2;
rf[rm] when (macw_no_error & ((macw_rm_bk == 0) & macw_tlb_ok) & ~int_should_take & ~itlb_exc_actually_taken) = Rm + 2;
rf_bank[macw_rm_lo] when (macw_no_error & macw_rm_bk & ~int_should_take & ~itlb_exc_actually_taken & macw_tlb_ok) = Rm + 2;

// Advance PC unconditionally - exception/interrupt aspects override if needed
pc = pc + 2;
