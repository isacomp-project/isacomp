// SPDX-License-Identifier: BSD-3-Clause
// STC.L SR,@-Rn - Store SR to stack (pre-decrement)
// Rn = Rn - 4; (Rn) = SR
// Encoding: 0100nnnn00000011 (0x4n03)
// Privileged instruction
isa_state pc[31:0];
var instr[15:0];
isa_state rf[31:0][3:0];
isa_state rf_bank[31:0][2:0];
isa_state sr[31:0];
isa_state t[0:0];
mem umem[23:0];

var rn[3:0];
var Rn[31:0];
var new_rn[31:0];
var sr_with_t[31:0];
var stcl_sr_rn_lo[2:0];
var stcl_sr_rb[0:0];
var stcl_sr_rn_bk[0:0];

isa_state delay_slot[0:0];
isa_state branch_target[31:0];
isa_state vbr[31:0];
isa_state ssr[31:0];
isa_state spc[31:0];
aspect delay_slot.isa gates pc, delay_slot;

// Include interrupt aspect - checks for pending external interrupts
aspect interrupt.isa gates pc, sr, ssr, spc, intevt;

// MMU translation aspect for instruction fetch (PC -> pc_pa)
// Added AFTER delay_slot for higher precedence - exceptions override branches
#ifdef MMU
aspect mmu_translate_instr_cam.isa gates pc, tea, spc, delay_slot, ssr, sr, expevt;
#endif
aspect addr_error_store.isa gates pc, sr, vbr, rf, umem, ssr, spc;
aspect exception.isa gates pc, sr, vbr, ssr, spc, expevt, tea, pteh;

#ifdef MMU
instr = umem[pc_pa];
#else
instr = umem[pc];
#endif
assume instr[15:12] == 0x4;
assume instr[7:0] == 0x03;
rn = instr[11:8];

stcl_sr_rn_lo = rn[2:0];
stcl_sr_rb = sr[29];  // RB bit (bit 29 in SR)
stcl_sr_rn_bk = (rn[3] == 1'b0) & stcl_sr_rb;

Rn = stcl_sr_rn_bk ? rf_bank[stcl_sr_rn_lo] : rf[rn];
new_rn = Rn - 4;

// Combine SR with T flag
sr_with_t = {sr[31:1], t};

// Store SR to memory at new address
var store_addr[31:0];
var store_size[1:0];
store_addr = new_rn;
store_size = 2'b11;
var mmu_va[31:0];
mmu_va = new_rn;

// Data MMU translation
var is_write[0:0];
is_write = 1'b1;
#ifdef MMU
#include "mmu_translate_data_inline.isa"
#endif

#ifdef MMU
umem[addr_pa] when (~int_should_take & ~itlb_exc_actually_taken & data_tlb_no_exception) = sr_with_t;
#else
umem[new_rn] when (~int_should_take & ~itlb_exc_actually_taken) = sr_with_t;
#endif

// Update register with decremented value
rf[rn] when (((stcl_sr_rn_bk == 0) & data_tlb_no_exception) & ~int_should_take & ~itlb_exc_actually_taken) = new_rn;
rf_bank[stcl_sr_rn_lo] when (stcl_sr_rn_bk & ~int_should_take & ~itlb_exc_actually_taken & data_tlb_no_exception) = new_rn;

pc = pc + 2;
