// SPDX-License-Identifier: BSD-3-Clause
// TRAPA #imm - Trap Always (Software Trap)
// SH-4 TRAPA generates a general exception with:
//   EXPEVT = 0x160 (fixed for TRAPA)
//   TRA = imm << 2 (trap register, software reads this to identify trap number)
//   Handler = VBR + 0x100 (general exception handler)
//
// The trap number (imm) is available to the handler via the TRA register.

isa_state pc[31:0];
var instr[15:0];
isa_state rf[31:0][3:0];
mem umem[23:0];
isa_state t[0:0];

// System registers (declared in exception.isa but needed here too for merger)
isa_state sr[31:0];
isa_state vbr[31:0];
isa_state ssr[31:0];
isa_state spc[31:0];

// TRA - TRAPA Exception Register (set to imm << 2)
isa_state tra[31:0];

var trapa_imm[7:0];
var trapa_tra_value[31:0];

// Branch delay slot state
isa_state delay_slot[0:0];
isa_state branch_target[31:0];

// Include delay slot aspect - handles PC override if we're in a delay slot
aspect delay_slot.isa gates pc, delay_slot;

// MMU translation aspect for instruction fetch (PC -> pc_pa)
// Added AFTER delay_slot for higher precedence - exceptions override branches
#ifdef MMU
aspect mmu_translate_instr_cam.isa gates pc, tea, spc, delay_slot, ssr, sr, expevt;
#endif

// Include exception aspect - handles stack push, SR update, PC redirect
aspect exception.isa gates pc, sr, vbr, ssr, spc, expevt, tea, pteh;

#ifdef MMU
instr = umem[pc_pa];
#else
instr = umem[pc];
#endif
assume instr[15:8] == 0xC3;
trapa_imm = instr[7:0];

// Check if exceptions are blocked (SR bit 28 = BL)
var trapa_bl[0:0];
trapa_bl = sr[28];

// TRAPA always triggers an exception
// SH-4: EXPEVT = 0x160 for TRAPA (fixed, regardless of imm)
// exc_vector = 0x0B gives exc_code = 0x0B << 5 = 0x160
// Only trigger if exceptions not blocked
exc_taken = ~trapa_bl;
exc_vector = 8'h0B;  // 0x0B << 5 = 0x160 = TRAPA exception code

// SH-4 spec: TRAPA saves PC+2 (next instruction) to SPC, not PC of TRAPA itself
// Override exc_saved_pc from exception.isa which defaults to current PC
exc_saved_pc = pc + 2;

// Set TRA = imm << 2 (software reads this to identify trap number)
trapa_tra_value = {22'b0, trapa_imm, 2'b00};
tra when (~trapa_bl) = trapa_tra_value;
// Also write TRA to umem at P4-mapped address so kernel can read via P4 load
// TRA is at P4 address 0xFF000020 -> umem byte address 0x03FF0020
// (There is no STC TRA instruction - TRA is only accessible via P4 memory load)
var trapa_tra_umem_addr[31:0];
trapa_tra_umem_addr = 32'h03FF0020;
umem[trapa_tra_umem_addr] when (~trapa_bl) = trapa_tra_value;

// Note: When exception is taken, exception.isa handles PC update
// The saved PC will be the TRAPA instruction + 2 (next instruction)
// When exceptions are blocked (BL=1), we still need to advance PC
// (SH-4 spec says behavior is undefined, but for simulation continuity we skip)
pc when (trapa_bl) = pc + 2;
