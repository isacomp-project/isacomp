// SPDX-License-Identifier: BSD-3-Clause
isa_state pc[31:0];
var instr[15:0];
isa_state rf[31:0][3:0];
isa_state rf_bank[31:0][2:0];  // Banked R0-R7 for RB=1
isa_state sr[31:0];
mem umem[23:0];
isa_state pr[31:0];

// Branch delay slot state
isa_state delay_slot[0:0];
isa_state branch_target[31:0];

var rn[3:0];
var Rn[31:0];
var branch_dest[31:0];
var return_addr[31:0];

// Register banking variables
var bsrf_rn_lo[2:0];
var bsrf_rb[0:0];
var bsrf_rn_bk[0:0];

// Include delay slot aspect - handles PC override if we're in a delay slot
aspect delay_slot.isa gates pc, delay_slot;

// Include interrupt aspect - checks for pending external interrupts
aspect interrupt.isa gates pc, sr, ssr, spc, intevt;

// MMU translation aspect for instruction fetch (PC -> pc_pa)
// Added AFTER delay_slot for higher precedence - exceptions override branches
#ifdef MMU
aspect mmu_translate_instr_cam.isa gates pc, tea, spc, delay_slot, ssr, sr, expevt;
#endif
aspect exception.isa gates pc, sr, vbr, ssr, spc, expevt, tea, pteh;

#ifdef MMU
instr = umem[pc_pa];
#else
instr = umem[pc];
#endif
assume instr[15:12] == 0x0;
assume instr[7:0] == 0x03;
rn = instr[11:8];

// Register banking logic
bsrf_rn_lo = rn[2:0];
bsrf_rb = sr[29];  // RB bit (bit 29 in SR)
bsrf_rn_bk = (rn[3] == 1'b0) & bsrf_rb;

// BSRF Rn: branch to PC + Rn + 4, save return address to PR
Rn = bsrf_rn_bk ? rf_bank[bsrf_rn_lo] : rf[rn];
branch_dest = pc + Rn + 4;
// Return address is PC+4 (after delay slot)
return_addr = pc + 4;

pr when (~int_should_take & ~itlb_exc_actually_taken) = return_addr;

// BSRF always branches - set up delay slot for next instruction
delay_slot when ((in_delay_slot == 0) & ~int_should_take & ~itlb_exc_actually_taken) = 1;
branch_target when ((in_delay_slot == 0) & ~int_should_take & ~itlb_exc_actually_taken) = branch_dest;

// Advance to delay slot instruction
pc = pc + 2;
