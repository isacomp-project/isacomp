// SPDX-License-Identifier: BSD-3-Clause
// SH-4 MMU Data Translation (Inline Version - No Gated Writes)
// This file is #include'd (not aspect'd) by memory instructions.
// It performs UTLB lookup and computes addr_pa, but does NOT write
// to any gated states (pc, sr, ssr, spc, tea, expevt).
//
// Instead, it sets exc_taken and exc_vector variables that are picked up
// by exception.isa for proper exception entry (SR/SSR/SPC/EXPEVT/TEA/PC).
//
// Requires:
//   - mmu_va[31:0] variable defined before #include (virtual address)
//   - is_write[0:0] variable defined before #include (1=write, 0=read)
//   - exc_taken[0:0] var available (from exception.isa or addr_error)
//   - exc_vector[7:0] var available
// Outputs:
//   - addr_pa[31:0] (physical address)
//   - data_tlb_no_exception[0:0] (1 if no TLB exception, for guarding instruction effects)
//   - Overrides exc_taken/exc_vector if TLB exception occurs

// Include MMU control registers and TLB arrays
#include "mmu_regs_cam.isa"

// Physical address output
var addr_pa[31:0];

// Exception signaling (internal flags)
var data_tlb_miss[0:0];
var data_tlb_prot_viol[0:0];
var data_tlb_initial_write[0:0];
var data_tlb_any_exception[0:0];
var data_tlb_no_exception[0:0];

// Address region detection
var data_addr_region[2:0];
var data_is_p0_u0[0:0];       // 0x00000000-0x7FFFFFFF (translated)
var data_is_p1[0:0];          // 0x80000000-0x9FFFFFFF (untranslated, cached)
var data_is_p2[0:0];          // 0xA0000000-0xBFFFFFFF (untranslated, uncached)
var data_is_p3[0:0];          // 0xC0000000-0xDFFFFFFF (translated)
var data_is_p4[0:0];          // 0xE0000000-0xFFFFFFFF (control, untranslated)
var data_needs_translation[0:0];

// MMU control
var data_mmu_enabled[0:0];
var data_current_asid[7:0];

// TLB lookup variables
var data_lookup_vpn[21:0];    // VPN to search for (mmu_va[31:10])

// ============================================================================
// Address Region Classification
// ============================================================================
data_addr_region = mmu_va[31:29];
data_is_p0_u0 = (mmu_va[31] == 1'b0);
data_is_p1 = (data_addr_region == 3'b100);
data_is_p2 = (data_addr_region == 3'b101);
data_is_p3 = (data_addr_region == 3'b110);
data_is_p4 = (data_addr_region == 3'b111);
data_needs_translation = data_is_p0_u0 | data_is_p3;

// Read MMU control state
data_mmu_enabled = mmucr[0];
// Read ASID from umem (P4-mapped PTEH) since kernel writes PTEH via
// P4 stores (__raw_writel to 0xFF000000), not via LDC instructions
var data_pteh_umem_addr[31:0];
var data_pteh_umem_val[31:0];
data_pteh_umem_addr = 32'h03FF0000;   // PTEH: P4 0xFF000000
data_pteh_umem_val = umem[data_pteh_umem_addr];
data_current_asid = data_pteh_umem_val[7:0];

// Decompose address - use 4KB page VPN (bits 31:12), clear bits 11:10
// This matches what kernel writes to PTEH (VA & 0xFFFFF000)
data_lookup_vpn = {mmu_va[31:12], 2'b00};

// ============================================================================
// UTLB CAM Lookup (64 entries, fully associative)
// ============================================================================
var data_vpn_matches[63:0];
data_vpn_matches = utlb_vpn@[data_lookup_vpn];

// Filter by Valid, ASID/Shared
var dv_0[0:0]; var dv_1[0:0]; var dv_2[0:0]; var dv_3[0:0];
var dv_4[0:0]; var dv_5[0:0]; var dv_6[0:0]; var dv_7[0:0];
var dv_8[0:0]; var dv_9[0:0]; var dv_10[0:0]; var dv_11[0:0];
var dv_12[0:0]; var dv_13[0:0]; var dv_14[0:0]; var dv_15[0:0];
var dv_16[0:0]; var dv_17[0:0]; var dv_18[0:0]; var dv_19[0:0];
var dv_20[0:0]; var dv_21[0:0]; var dv_22[0:0]; var dv_23[0:0];
var dv_24[0:0]; var dv_25[0:0]; var dv_26[0:0]; var dv_27[0:0];
var dv_28[0:0]; var dv_29[0:0]; var dv_30[0:0]; var dv_31[0:0];
var dv_32[0:0]; var dv_33[0:0]; var dv_34[0:0]; var dv_35[0:0];
var dv_36[0:0]; var dv_37[0:0]; var dv_38[0:0]; var dv_39[0:0];
var dv_40[0:0]; var dv_41[0:0]; var dv_42[0:0]; var dv_43[0:0];
var dv_44[0:0]; var dv_45[0:0]; var dv_46[0:0]; var dv_47[0:0];
var dv_48[0:0]; var dv_49[0:0]; var dv_50[0:0]; var dv_51[0:0];
var dv_52[0:0]; var dv_53[0:0]; var dv_54[0:0]; var dv_55[0:0];
var dv_56[0:0]; var dv_57[0:0]; var dv_58[0:0]; var dv_59[0:0];
var dv_60[0:0]; var dv_61[0:0]; var dv_62[0:0]; var dv_63[0:0];

dv_0 = utlb_v[0] & ((utlb_asid[0] == data_current_asid) | utlb_sh[0]);
dv_1 = utlb_v[1] & ((utlb_asid[1] == data_current_asid) | utlb_sh[1]);
dv_2 = utlb_v[2] & ((utlb_asid[2] == data_current_asid) | utlb_sh[2]);
dv_3 = utlb_v[3] & ((utlb_asid[3] == data_current_asid) | utlb_sh[3]);
dv_4 = utlb_v[4] & ((utlb_asid[4] == data_current_asid) | utlb_sh[4]);
dv_5 = utlb_v[5] & ((utlb_asid[5] == data_current_asid) | utlb_sh[5]);
dv_6 = utlb_v[6] & ((utlb_asid[6] == data_current_asid) | utlb_sh[6]);
dv_7 = utlb_v[7] & ((utlb_asid[7] == data_current_asid) | utlb_sh[7]);
dv_8 = utlb_v[8] & ((utlb_asid[8] == data_current_asid) | utlb_sh[8]);
dv_9 = utlb_v[9] & ((utlb_asid[9] == data_current_asid) | utlb_sh[9]);
dv_10 = utlb_v[10] & ((utlb_asid[10] == data_current_asid) | utlb_sh[10]);
dv_11 = utlb_v[11] & ((utlb_asid[11] == data_current_asid) | utlb_sh[11]);
dv_12 = utlb_v[12] & ((utlb_asid[12] == data_current_asid) | utlb_sh[12]);
dv_13 = utlb_v[13] & ((utlb_asid[13] == data_current_asid) | utlb_sh[13]);
dv_14 = utlb_v[14] & ((utlb_asid[14] == data_current_asid) | utlb_sh[14]);
dv_15 = utlb_v[15] & ((utlb_asid[15] == data_current_asid) | utlb_sh[15]);
dv_16 = utlb_v[16] & ((utlb_asid[16] == data_current_asid) | utlb_sh[16]);
dv_17 = utlb_v[17] & ((utlb_asid[17] == data_current_asid) | utlb_sh[17]);
dv_18 = utlb_v[18] & ((utlb_asid[18] == data_current_asid) | utlb_sh[18]);
dv_19 = utlb_v[19] & ((utlb_asid[19] == data_current_asid) | utlb_sh[19]);
dv_20 = utlb_v[20] & ((utlb_asid[20] == data_current_asid) | utlb_sh[20]);
dv_21 = utlb_v[21] & ((utlb_asid[21] == data_current_asid) | utlb_sh[21]);
dv_22 = utlb_v[22] & ((utlb_asid[22] == data_current_asid) | utlb_sh[22]);
dv_23 = utlb_v[23] & ((utlb_asid[23] == data_current_asid) | utlb_sh[23]);
dv_24 = utlb_v[24] & ((utlb_asid[24] == data_current_asid) | utlb_sh[24]);
dv_25 = utlb_v[25] & ((utlb_asid[25] == data_current_asid) | utlb_sh[25]);
dv_26 = utlb_v[26] & ((utlb_asid[26] == data_current_asid) | utlb_sh[26]);
dv_27 = utlb_v[27] & ((utlb_asid[27] == data_current_asid) | utlb_sh[27]);
dv_28 = utlb_v[28] & ((utlb_asid[28] == data_current_asid) | utlb_sh[28]);
dv_29 = utlb_v[29] & ((utlb_asid[29] == data_current_asid) | utlb_sh[29]);
dv_30 = utlb_v[30] & ((utlb_asid[30] == data_current_asid) | utlb_sh[30]);
dv_31 = utlb_v[31] & ((utlb_asid[31] == data_current_asid) | utlb_sh[31]);
dv_32 = utlb_v[32] & ((utlb_asid[32] == data_current_asid) | utlb_sh[32]);
dv_33 = utlb_v[33] & ((utlb_asid[33] == data_current_asid) | utlb_sh[33]);
dv_34 = utlb_v[34] & ((utlb_asid[34] == data_current_asid) | utlb_sh[34]);
dv_35 = utlb_v[35] & ((utlb_asid[35] == data_current_asid) | utlb_sh[35]);
dv_36 = utlb_v[36] & ((utlb_asid[36] == data_current_asid) | utlb_sh[36]);
dv_37 = utlb_v[37] & ((utlb_asid[37] == data_current_asid) | utlb_sh[37]);
dv_38 = utlb_v[38] & ((utlb_asid[38] == data_current_asid) | utlb_sh[38]);
dv_39 = utlb_v[39] & ((utlb_asid[39] == data_current_asid) | utlb_sh[39]);
dv_40 = utlb_v[40] & ((utlb_asid[40] == data_current_asid) | utlb_sh[40]);
dv_41 = utlb_v[41] & ((utlb_asid[41] == data_current_asid) | utlb_sh[41]);
dv_42 = utlb_v[42] & ((utlb_asid[42] == data_current_asid) | utlb_sh[42]);
dv_43 = utlb_v[43] & ((utlb_asid[43] == data_current_asid) | utlb_sh[43]);
dv_44 = utlb_v[44] & ((utlb_asid[44] == data_current_asid) | utlb_sh[44]);
dv_45 = utlb_v[45] & ((utlb_asid[45] == data_current_asid) | utlb_sh[45]);
dv_46 = utlb_v[46] & ((utlb_asid[46] == data_current_asid) | utlb_sh[46]);
dv_47 = utlb_v[47] & ((utlb_asid[47] == data_current_asid) | utlb_sh[47]);
dv_48 = utlb_v[48] & ((utlb_asid[48] == data_current_asid) | utlb_sh[48]);
dv_49 = utlb_v[49] & ((utlb_asid[49] == data_current_asid) | utlb_sh[49]);
dv_50 = utlb_v[50] & ((utlb_asid[50] == data_current_asid) | utlb_sh[50]);
dv_51 = utlb_v[51] & ((utlb_asid[51] == data_current_asid) | utlb_sh[51]);
dv_52 = utlb_v[52] & ((utlb_asid[52] == data_current_asid) | utlb_sh[52]);
dv_53 = utlb_v[53] & ((utlb_asid[53] == data_current_asid) | utlb_sh[53]);
dv_54 = utlb_v[54] & ((utlb_asid[54] == data_current_asid) | utlb_sh[54]);
dv_55 = utlb_v[55] & ((utlb_asid[55] == data_current_asid) | utlb_sh[55]);
dv_56 = utlb_v[56] & ((utlb_asid[56] == data_current_asid) | utlb_sh[56]);
dv_57 = utlb_v[57] & ((utlb_asid[57] == data_current_asid) | utlb_sh[57]);
dv_58 = utlb_v[58] & ((utlb_asid[58] == data_current_asid) | utlb_sh[58]);
dv_59 = utlb_v[59] & ((utlb_asid[59] == data_current_asid) | utlb_sh[59]);
dv_60 = utlb_v[60] & ((utlb_asid[60] == data_current_asid) | utlb_sh[60]);
dv_61 = utlb_v[61] & ((utlb_asid[61] == data_current_asid) | utlb_sh[61]);
dv_62 = utlb_v[62] & ((utlb_asid[62] == data_current_asid) | utlb_sh[62]);
dv_63 = utlb_v[63] & ((utlb_asid[63] == data_current_asid) | utlb_sh[63]);

var data_valid_asid_mask[63:0];
data_valid_asid_mask = {dv_63, dv_62, dv_61, dv_60, dv_59, dv_58, dv_57, dv_56,
                        dv_55, dv_54, dv_53, dv_52, dv_51, dv_50, dv_49, dv_48,
                        dv_47, dv_46, dv_45, dv_44, dv_43, dv_42, dv_41, dv_40,
                        dv_39, dv_38, dv_37, dv_36, dv_35, dv_34, dv_33, dv_32,
                        dv_31, dv_30, dv_29, dv_28, dv_27, dv_26, dv_25, dv_24,
                        dv_23, dv_22, dv_21, dv_20, dv_19, dv_18, dv_17, dv_16,
                        dv_15, dv_14, dv_13, dv_12, dv_11, dv_10, dv_9, dv_8,
                        dv_7, dv_6, dv_5, dv_4, dv_3, dv_2, dv_1, dv_0};

var data_utlb_match[63:0];
data_utlb_match = data_vpn_matches & data_valid_asid_mask;

var data_utlb_hit[0:0];
var data_utlb_hit_idx[6:0];
data_utlb_hit = |data_utlb_match;
data_utlb_hit_idx = ctz(data_utlb_match);

// ============================================================================
// Read Matched Entry
// ============================================================================
var data_utlb_idx6[5:0];
data_utlb_idx6 = data_utlb_hit_idx[5:0];

var data_matched_ppn[18:0];
var data_matched_pr[1:0];
var data_matched_d[0:0];

data_matched_ppn = utlb_ppn[data_utlb_idx6];
data_matched_pr = utlb_pr[data_utlb_idx6];
data_matched_d = utlb_d[data_utlb_idx6];

// ============================================================================
// Permission Checking
// ============================================================================
var data_is_privileged[0:0];
data_is_privileged = sr[30];

var data_read_perm_ok[0:0];
var data_write_perm_ok[0:0];
data_read_perm_ok = data_is_privileged | data_matched_pr[1];
data_write_perm_ok = data_matched_pr[0] & (data_is_privileged | data_matched_pr[1]);

// TLB exception flags
data_tlb_miss = data_mmu_enabled & data_needs_translation & ~data_utlb_hit;
data_tlb_prot_viol = data_mmu_enabled & data_needs_translation & data_utlb_hit & ((is_write & ~data_write_perm_ok) | (~is_write & ~data_read_perm_ok));
data_tlb_initial_write = data_mmu_enabled & data_needs_translation & is_write & data_utlb_hit & ~data_matched_d & data_write_perm_ok;
data_tlb_any_exception = data_tlb_miss | data_tlb_prot_viol | data_tlb_initial_write;
data_tlb_no_exception = ~data_tlb_any_exception;

// ============================================================================
// Physical Address Computation
// ============================================================================
var data_translated_addr[31:0];
data_translated_addr = {3'b000, data_matched_ppn[18:2], mmu_va[11:0]};

var data_p1_addr[31:0];
var data_p2_addr[31:0];
var data_p4_addr[31:0];
data_p1_addr = {3'b000, mmu_va[28:0]};
data_p2_addr = {3'b000, mmu_va[28:0]};
// Use VA[23:16] (peripheral block) and VA[7:0] (register offset) to avoid
// aliasing between different P4 sub-ranges (e.g., MMU 0xFF00xxxx vs INTC 0xFEE0xxxx)
data_p4_addr = {16'h03FF, mmu_va[23:16], mmu_va[7:0]};

addr_pa = data_is_p1 ? data_p1_addr :
          data_is_p2 ? data_p2_addr :
          data_is_p4 ? data_p4_addr :
          (data_mmu_enabled & data_needs_translation & data_utlb_hit) ? data_translated_addr :
          {3'b000, mmu_va[28:0]};

// ============================================================================
// Route TLB exceptions through exception.isa mechanism
// ============================================================================
// Override exc_taken/exc_vector (set by addr_error or defaulting to 0).
// TLB exceptions have priority over address errors since the TLB lookup
// must succeed before alignment can be meaningfully checked.
//
// SH4 EXPEVT codes (exc_code = exc_vector << 5):
//   0x02 -> 0x040: TLB miss (read)
//   0x03 -> 0x060: TLB miss (write) -- not standard SH4, we use 0x040 for both
//   0x04 -> 0x080: Initial page write
//   0x05 -> 0x0A0: TLB protection violation (read)
//   0x06 -> 0x0C0: TLB protection violation (write)
//
// All TLB exceptions route to VBR+0x400.
// exc_vector values: use 0x82-0x86 range to signal "TLB exception" to exception.isa
//   0x82 -> TLB miss (EXPEVT=0x040 for read, 0x060 for write)
//   0x83 -> Initial page write (EXPEVT=0x080)
//   0x84 -> TLB protection violation (EXPEVT=0x0A0 for read, 0x0C0 for write)

var data_tlb_bl[0:0];
data_tlb_bl = sr[28];

// Set exc_tea_addr for exception.isa to write to TEA register
var exc_tea_addr[31:0];
exc_tea_addr = mmu_va;

// Signal TLB exceptions to exception.isa via separate variables.
// exception.isa merges data_tlb_exc_taken/data_tlb_exc_vector with
// exc_taken/exc_vector (from addr_error or instruction body).
// This avoids circular dependencies from overriding exc_taken/exc_vector.
data_tlb_exc_taken = data_tlb_any_exception & ~data_tlb_bl;
data_tlb_exc_vector = data_tlb_miss ? 8'h82 :
                      data_tlb_initial_write ? 8'h83 :
                      data_tlb_prot_viol ? 8'h84 :
                      8'h00;
