// SPDX-License-Identifier: BSD-3-Clause
isa_state pc[31:0];
var instr[15:0];
isa_state rf[31:0][3:0];
isa_state rf_bank[31:0][2:0];  // Banked R0-R7 for RB=1
mem umem[23:0];
isa_state t[0:0];

// System registers (needed for exception handling)
isa_state sr[31:0];
isa_state vbr[31:0];
isa_state ssr[31:0];
isa_state spc[31:0];

var rn[3:0];
var rm[3:0];
var Rn[31:0];
var Rm[31:0];
var r0[31:0];
var store_addr[31:0];
var store_size[1:0];
var movl_indexed_store_no_error[0:0];

// Register banking variables (unique to movl_indexed_store)
var movl_indexed_store_rn_lo[2:0];
var movl_indexed_store_rm_lo[2:0];
var movl_indexed_store_r0_lo[2:0];
var movl_indexed_store_rb[0:0];
var movl_indexed_store_rn_bk[0:0];
var movl_indexed_store_rm_bk[0:0];
var movl_indexed_store_r0_bk[0:0];

// Branch delay slot state
isa_state delay_slot[0:0];
isa_state branch_target[31:0];

// Include delay slot aspect - handles PC override if we're in a delay slot
aspect delay_slot.isa gates pc, delay_slot;

// Include interrupt aspect - checks for pending external interrupts
aspect interrupt.isa gates pc, sr, ssr, spc, intevt;

// MMU translation aspect for instruction fetch (PC -> pc_pa)
// Added AFTER delay_slot for higher precedence - exceptions override branches
#ifdef MMU
aspect mmu_translate_instr_cam.isa gates pc, tea, spc, delay_slot, ssr, sr, expevt;
#endif

// Include address error detection for stores (must be before exception.isa to set exc_taken)
aspect addr_error_store.isa gates pc, sr, vbr, rf, umem, ssr, spc;

// Include exception handling aspect
aspect exception.isa gates pc, sr, vbr, ssr, spc, expevt, tea, pteh;

#ifdef MMU
instr = umem[pc_pa];
#else
instr = umem[pc];
#endif
assume instr[15:12] == 0x0;
assume instr[3:0] == 0x6;
rn = instr[11:8];
rm = instr[7:4];

// Register banking setup
movl_indexed_store_rn_lo = rn[2:0];
movl_indexed_store_rm_lo = rm[2:0];
movl_indexed_store_r0_lo = 3'b000;
movl_indexed_store_rb = sr[29];  // RB bit (bit 29 in SR)
movl_indexed_store_rn_bk = (rn[3] == 1'b0) & movl_indexed_store_rb;
movl_indexed_store_rm_bk = (rm[3] == 1'b0) & movl_indexed_store_rb;
movl_indexed_store_r0_bk = movl_indexed_store_rb;  // R0[3] is 0

Rn = movl_indexed_store_rn_bk ? rf_bank[movl_indexed_store_rn_lo] : rf[rn];
Rm = movl_indexed_store_rm_bk ? rf_bank[movl_indexed_store_rm_lo] : rf[rm];
r0 = movl_indexed_store_r0_bk ? rf_bank[movl_indexed_store_r0_lo] : rf[0];
// MOV.L Rm, @(R0, Rn): store Rm to address (R0 + Rn)
store_addr = Rn + r0;

// Set up address error checking
store_size = 2'b11;  // Long access (32-bit)

// Compute the no-error condition (bits 1:0 must be 00)
movl_indexed_store_no_error = (store_addr[1:0] == 2'b00);

// Only store if no address error
var mmu_va[31:0];
mmu_va = store_addr;

// Data MMU translation
var is_write[0:0];
is_write = 1'b1;
#ifdef MMU
#include "mmu_translate_data_inline.isa"
#endif

#ifdef MMU
umem[addr_pa] when (~int_should_take & ~itlb_exc_actually_taken & (movl_indexed_store_no_error & data_tlb_no_exception)) = Rm;
#else
umem[store_addr] when (~int_should_take & ~itlb_exc_actually_taken & (movl_indexed_store_no_error)) = Rm;
#endif

// Advance PC unconditionally - if an address error exception is taken,
// exception.isa has higher precedence and overrides this.
// Must be unconditional so interrupt.isa sees the advanced PC for SPC,
// preventing re-execution of completed stores after RTE.
pc = pc + 2;
