// SPDX-License-Identifier: BSD-3-Clause
isa_state pc[31:0];
var instr[15:0];
isa_state rf[31:0][3:0];
isa_state rf_bank[31:0][2:0];  // Banked R0-R7 for RB=1
isa_state sr[31:0];
mem umem[23:0];
isa_state t[0:0];

var rn[3:0];
var tasb_rn_lo[2:0];
var Rn[31:0];
var tasb_addr[31:0];
var data8[7:0];

// Register banking flags (unique to tasb instruction)
var tasb_rb[0:0];
var tasb_rn_bk[0:0];

// Branch delay slot state
isa_state delay_slot[0:0];
isa_state branch_target[31:0];
isa_state vbr[31:0];
isa_state ssr[31:0];
isa_state spc[31:0];

// Include delay slot aspect - handles PC override if we're in a delay slot
aspect delay_slot.isa gates pc, delay_slot;

// Include interrupt aspect - checks for pending external interrupts
aspect interrupt.isa gates pc, sr, ssr, spc, intevt;
aspect exception.isa gates pc, sr, vbr, ssr, spc, expevt, tea, pteh;

// MMU translation aspect for instruction fetch (PC -> pc_pa)
// Added AFTER delay_slot for higher precedence - exceptions override branches
#ifdef MMU
aspect mmu_translate_instr_cam.isa gates pc, tea, spc, delay_slot, ssr, sr, expevt;
#endif

#ifdef MMU
instr = umem[pc_pa];
#else
instr = umem[pc];
#endif
assume instr[15:12] == 0x4;
assume instr[7:0] == 0x1B;
rn = instr[11:8];
tasb_rn_lo = rn[2:0];

// Banking: R0-R7 use rf_bank when SR.RB=1
tasb_rb = sr[29];  // RB bit (bit 29 in SR)
tasb_rn_bk = (rn[3] == 1'b0) & tasb_rb;

Rn = tasb_rn_bk ? rf_bank[tasb_rn_lo] : rf[rn];
tasb_addr = Rn;

var mmu_va[31:0];
mmu_va = tasb_addr;

// Data MMU translation
var is_write[0:0];
is_write = 1'b1;
#ifdef MMU
#include "mmu_translate_data_inline.isa"
#endif

#ifdef MMU
data8 = umem[addr_pa];
#else
data8 = umem[tasb_addr];
#endif

// Test and set - if byte at tasb_addr is 0, set bit 7
t when (~int_should_take & ~itlb_exc_actually_taken & data_tlb_no_exception) = (data8 == 8'b0) ? 1'b1 : 1'b0;
#ifdef MMU
umem[addr_pa] when (~int_should_take & ~itlb_exc_actually_taken & data_tlb_no_exception) = data8 | 8'h80;
#else
umem[tasb_addr] when (~int_should_take & ~itlb_exc_actually_taken) = data8 | 8'h80;
#endif
pc = pc + 2;
