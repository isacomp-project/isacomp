// SPDX-License-Identifier: BSD-3-Clause
isa_state pc[31:0];
var instr[15:0];
isa_state rf[31:0][3:0];
isa_state rf_bank[31:0][2:0];  // Banked R0-R7 for RB=1
isa_state sr[31:0];
mem umem[23:0];
isa_state gbr[31:0];

var imm[7:0];
var orb_gbr_r0_lo[2:0];
var orb_gbr_addr[31:0];
var R0[31:0];
var data8[7:0];
var result[7:0];

// Register banking (unique to orb_gbr instruction)
var orb_gbr_rb[0:0];

// Branch delay slot state
isa_state delay_slot[0:0];
isa_state branch_target[31:0];
isa_state vbr[31:0];
isa_state ssr[31:0];
isa_state spc[31:0];
isa_state t[0:0];

// Include delay slot aspect - handles PC override if we're in a delay slot
aspect delay_slot.isa gates pc, delay_slot;

// Include interrupt aspect - checks for pending external interrupts
aspect interrupt.isa gates pc, sr, ssr, spc, intevt;
aspect exception.isa gates pc, sr, vbr, ssr, spc, expevt, tea, pteh;

// MMU translation aspect for instruction fetch (PC -> pc_pa)
// Added AFTER delay_slot for higher precedence - exceptions override branches
#ifdef MMU
aspect mmu_translate_instr_cam.isa gates pc, tea, spc, delay_slot, ssr, sr, expevt;
#endif

#ifdef MMU
instr = umem[pc_pa];
#else
instr = umem[pc];
#endif
assume instr[15:8] == 0xCF;
imm = instr[7:0];

// Banking: R0 uses rf_bank when SR.RB=1
orb_gbr_r0_lo = 3'b000;
orb_gbr_rb = sr[29];  // RB bit (bit 29 in SR)

// OR.B #imm,@(R0,GBR): orb_gbr_addr = GBR + R0
R0 = orb_gbr_rb ? rf_bank[orb_gbr_r0_lo] : rf[0];
orb_gbr_addr = gbr + R0;

// Read-modify-write
var mmu_va[31:0];
mmu_va = orb_gbr_addr;

// Data MMU translation
var is_write[0:0];
is_write = 1'b1;
#ifdef MMU
#include "mmu_translate_data_inline.isa"
#endif

#ifdef MMU
data8 = umem[addr_pa];
#else
data8 = umem[orb_gbr_addr];
#endif
result = data8 | imm;
#ifdef MMU
umem[addr_pa] when (~int_should_take & ~itlb_exc_actually_taken & data_tlb_no_exception) = result;
#else
umem[orb_gbr_addr] when (~int_should_take & ~itlb_exc_actually_taken) = result;
#endif

pc = pc + 2;
