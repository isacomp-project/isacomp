// SPDX-License-Identifier: BSD-3-Clause
isa_state pc[31:0];
var instr[15:0];
isa_state rf[31:0][3:0];
isa_state rf_bank[31:0][2:0];  // Banked R0-R7 for RB=1
mem umem[23:0];
isa_state t[0:0];

// System registers (needed for exception handling)
isa_state sr[31:0];
isa_state vbr[31:0];
isa_state ssr[31:0];
isa_state spc[31:0];

var rm[3:0];
var disp[3:0];
var disp_ext[31:0];
var Rm[31:0];
var movw_disp_load_addr[31:0];
var data16[15:0];
var sign_ext_data[31:0];

// Address error checking variables
var load_addr[31:0];
var load_size[1:0];
var movw_disp_load_no_error[0:0];

// Register banking variables (unique to movw_disp_load)
var movw_disp_load_r0_lo[2:0];
var movw_disp_load_rm_lo[2:0];
var movw_disp_load_rb[0:0];
var movw_disp_load_r0_bk[0:0];
var movw_disp_load_rm_bk[0:0];

// Branch delay slot state
isa_state delay_slot[0:0];
isa_state branch_target[31:0];

// Include delay slot aspect - handles PC override if we're in a delay slot
aspect delay_slot.isa gates pc, delay_slot;

// Include interrupt aspect - checks for pending external interrupts
aspect interrupt.isa gates pc, sr, ssr, spc, intevt;

// MMU translation aspect for instruction fetch (PC -> pc_pa)
// Added AFTER delay_slot for higher precedence - exceptions override branches
#ifdef MMU
aspect mmu_translate_instr_cam.isa gates pc, tea, spc, delay_slot, ssr, sr, expevt;
#endif

// Include address error detection for loads (must be before exception.isa to set exc_taken)
aspect addr_error_load.isa gates pc, sr, vbr, rf, umem, ssr, spc;

// Include exception handling aspect
aspect exception.isa gates pc, sr, vbr, ssr, spc, expevt, tea, pteh;

#ifdef MMU
instr = umem[pc_pa];
#else
instr = umem[pc];
#endif
assume instr[15:8] == 0x85;
rm = instr[7:4];
disp = instr[3:0];

// Register banking setup
movw_disp_load_r0_lo = 3'b000;
movw_disp_load_rm_lo = rm[2:0];
movw_disp_load_rb = sr[29];  // RB bit (bit 29 in SR)
movw_disp_load_r0_bk = movw_disp_load_rb;  // R0[3] is 0
movw_disp_load_rm_bk = (rm[3] == 1'b0) & movw_disp_load_rb;

Rm = movw_disp_load_rm_bk ? rf_bank[movw_disp_load_rm_lo] : rf[rm];

// MOV.W @(disp,Rm),R0: movw_disp_load_addr = Rm + disp*2
disp_ext = {28'b0, disp};
movw_disp_load_addr = Rm + {disp_ext[30:0], 1'b0};

// Set up address error checking
load_addr = movw_disp_load_addr;
load_size = 2'b10;  // Word access (16-bit)

// Compute the no-error condition
movw_disp_load_no_error = (movw_disp_load_addr[0] == 1'b0);

var mmu_va[31:0];
mmu_va = movw_disp_load_addr;

// Data MMU translation
var is_write[0:0];
is_write = 1'b0;
#ifdef MMU
#include "mmu_translate_data_inline.isa"
#endif

#ifdef MMU
data16 = umem[addr_pa];
#else
data16 = umem[movw_disp_load_addr];
#endif
sign_ext_data = {{16{data16[15]}}, data16};

// Only update register if no address error (combined with banking)
rf[0] when (~int_should_take & ~itlb_exc_actually_taken & (movw_disp_load_no_error & ((movw_disp_load_r0_bk == 0) & data_tlb_no_exception))) = sign_ext_data;
rf_bank[movw_disp_load_r0_lo] when (~int_should_take & ~itlb_exc_actually_taken & (movw_disp_load_no_error & movw_disp_load_r0_bk & data_tlb_no_exception)) = sign_ext_data;

pc = pc + 2;
