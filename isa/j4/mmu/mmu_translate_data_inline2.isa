// SH-4 MMU Data Translation - SECOND ACCESS (for MAC.L/MAC.W dual-operand instructions)
// This file is #include'd (not aspect'd) by memory instructions.
// It performs UTLB lookup and computes addr_pa_m, but does NOT write
// to any gated states (pc, sr, ssr, spc, tea, expevt).
//
// Instead, it sets exc_taken and exc_vector variables that are picked up
// by exception.isa for proper exception entry (SR/SSR/SPC/EXPEVT/TEA/PC).
//
// Requires:
//   - mmu_va_m[31:0] variable defined before #include (virtual address)
//   - is_write_m[0:0] variable defined before #include (1=write, 0=read)
//   - mmu_regs_cam.isa already included by first translation
// Outputs:
//   - addr_pa_m[31:0] (physical address)
//   - data_m_tlb_no_exception[0:0] (1 if no TLB exception, for guarding instruction effects)
//   - data_m_tlb_exc_taken / data_m_tlb_exc_vector for exception.isa

// Include MMU control registers and TLB arrays
// mmu_regs_cam.isa already included by first translation

// Physical address output
var addr_pa_m[31:0];

// Exception signaling (internal flags)
var data_m_tlb_miss[0:0];
var data_m_tlb_prot_viol[0:0];
var data_m_tlb_initial_write[0:0];
var data_m_tlb_any_exception[0:0];
var data_m_tlb_no_exception[0:0];

// Address region detection
var data_m_addr_region[2:0];
var data_m_is_p0_u0[0:0];       // 0x00000000-0x7FFFFFFF (translated)
var data_m_is_p1[0:0];          // 0x80000000-0x9FFFFFFF (untranslated, cached)
var data_m_is_p2[0:0];          // 0xA0000000-0xBFFFFFFF (untranslated, uncached)
var data_m_is_p3[0:0];          // 0xC0000000-0xDFFFFFFF (translated)
var data_m_is_p4[0:0];          // 0xE0000000-0xFFFFFFFF (control, untranslated)
var data_m_needs_translation[0:0];

// MMU control
var data_m_mmu_enabled[0:0];
var data_m_current_asid[7:0];

// TLB lookup variables
var data_m_lookup_vpn[21:0];    // VPN to search for (mmu_va_m[31:10])

// ============================================================================
// Address Region Classification
// ============================================================================
data_m_addr_region = mmu_va_m[31:29];
data_m_is_p0_u0 = (mmu_va_m[31] == 1'b0);
data_m_is_p1 = (data_m_addr_region == 3'b100);
data_m_is_p2 = (data_m_addr_region == 3'b101);
data_m_is_p3 = (data_m_addr_region == 3'b110);
data_m_is_p4 = (data_m_addr_region == 3'b111);
data_m_needs_translation = data_m_is_p0_u0 | data_m_is_p3;

// Read MMU control state
data_m_mmu_enabled = mmucr[0];
// Read ASID from umem (P4-mapped PTEH) since kernel writes PTEH via
// P4 stores (__raw_writel to 0xFF000000), not via LDC instructions
var data_m_pteh_umem_addr[31:0];
var data_m_pteh_umem_val[31:0];
data_m_pteh_umem_addr = 32'h03FF0000;   // PTEH: P4 0xFF000000
data_m_pteh_umem_val = umem[data_m_pteh_umem_addr];
data_m_current_asid = data_m_pteh_umem_val[7:0];

// Decompose address - use 4KB page VPN (bits 31:12), clear bits 11:10
// This matches what kernel writes to PTEH (VA & 0xFFFFF000)
data_m_lookup_vpn = {mmu_va_m[31:12], 2'b00};

// ============================================================================
// UTLB CAM Lookup (64 entries, fully associative)
// ============================================================================
var data_m_vpn_matches[63:0];
data_m_vpn_matches = utlb_vpn@[data_m_lookup_vpn];

// Filter by Valid, ASID/Shared
var dvm_0[0:0]; var dvm_1[0:0]; var dvm_2[0:0]; var dvm_3[0:0];
var dvm_4[0:0]; var dvm_5[0:0]; var dvm_6[0:0]; var dvm_7[0:0];
var dvm_8[0:0]; var dvm_9[0:0]; var dvm_10[0:0]; var dvm_11[0:0];
var dvm_12[0:0]; var dvm_13[0:0]; var dvm_14[0:0]; var dvm_15[0:0];
var dvm_16[0:0]; var dvm_17[0:0]; var dvm_18[0:0]; var dvm_19[0:0];
var dvm_20[0:0]; var dvm_21[0:0]; var dvm_22[0:0]; var dvm_23[0:0];
var dvm_24[0:0]; var dvm_25[0:0]; var dvm_26[0:0]; var dvm_27[0:0];
var dvm_28[0:0]; var dvm_29[0:0]; var dvm_30[0:0]; var dvm_31[0:0];
var dvm_32[0:0]; var dvm_33[0:0]; var dvm_34[0:0]; var dvm_35[0:0];
var dvm_36[0:0]; var dvm_37[0:0]; var dvm_38[0:0]; var dvm_39[0:0];
var dvm_40[0:0]; var dvm_41[0:0]; var dvm_42[0:0]; var dvm_43[0:0];
var dvm_44[0:0]; var dvm_45[0:0]; var dvm_46[0:0]; var dvm_47[0:0];
var dvm_48[0:0]; var dvm_49[0:0]; var dvm_50[0:0]; var dvm_51[0:0];
var dvm_52[0:0]; var dvm_53[0:0]; var dvm_54[0:0]; var dvm_55[0:0];
var dvm_56[0:0]; var dvm_57[0:0]; var dvm_58[0:0]; var dvm_59[0:0];
var dvm_60[0:0]; var dvm_61[0:0]; var dvm_62[0:0]; var dvm_63[0:0];

dvm_0 = utlb_v[0] & ((utlb_asid[0] == data_m_current_asid) | utlb_sh[0]);
dvm_1 = utlb_v[1] & ((utlb_asid[1] == data_m_current_asid) | utlb_sh[1]);
dvm_2 = utlb_v[2] & ((utlb_asid[2] == data_m_current_asid) | utlb_sh[2]);
dvm_3 = utlb_v[3] & ((utlb_asid[3] == data_m_current_asid) | utlb_sh[3]);
dvm_4 = utlb_v[4] & ((utlb_asid[4] == data_m_current_asid) | utlb_sh[4]);
dvm_5 = utlb_v[5] & ((utlb_asid[5] == data_m_current_asid) | utlb_sh[5]);
dvm_6 = utlb_v[6] & ((utlb_asid[6] == data_m_current_asid) | utlb_sh[6]);
dvm_7 = utlb_v[7] & ((utlb_asid[7] == data_m_current_asid) | utlb_sh[7]);
dvm_8 = utlb_v[8] & ((utlb_asid[8] == data_m_current_asid) | utlb_sh[8]);
dvm_9 = utlb_v[9] & ((utlb_asid[9] == data_m_current_asid) | utlb_sh[9]);
dvm_10 = utlb_v[10] & ((utlb_asid[10] == data_m_current_asid) | utlb_sh[10]);
dvm_11 = utlb_v[11] & ((utlb_asid[11] == data_m_current_asid) | utlb_sh[11]);
dvm_12 = utlb_v[12] & ((utlb_asid[12] == data_m_current_asid) | utlb_sh[12]);
dvm_13 = utlb_v[13] & ((utlb_asid[13] == data_m_current_asid) | utlb_sh[13]);
dvm_14 = utlb_v[14] & ((utlb_asid[14] == data_m_current_asid) | utlb_sh[14]);
dvm_15 = utlb_v[15] & ((utlb_asid[15] == data_m_current_asid) | utlb_sh[15]);
dvm_16 = utlb_v[16] & ((utlb_asid[16] == data_m_current_asid) | utlb_sh[16]);
dvm_17 = utlb_v[17] & ((utlb_asid[17] == data_m_current_asid) | utlb_sh[17]);
dvm_18 = utlb_v[18] & ((utlb_asid[18] == data_m_current_asid) | utlb_sh[18]);
dvm_19 = utlb_v[19] & ((utlb_asid[19] == data_m_current_asid) | utlb_sh[19]);
dvm_20 = utlb_v[20] & ((utlb_asid[20] == data_m_current_asid) | utlb_sh[20]);
dvm_21 = utlb_v[21] & ((utlb_asid[21] == data_m_current_asid) | utlb_sh[21]);
dvm_22 = utlb_v[22] & ((utlb_asid[22] == data_m_current_asid) | utlb_sh[22]);
dvm_23 = utlb_v[23] & ((utlb_asid[23] == data_m_current_asid) | utlb_sh[23]);
dvm_24 = utlb_v[24] & ((utlb_asid[24] == data_m_current_asid) | utlb_sh[24]);
dvm_25 = utlb_v[25] & ((utlb_asid[25] == data_m_current_asid) | utlb_sh[25]);
dvm_26 = utlb_v[26] & ((utlb_asid[26] == data_m_current_asid) | utlb_sh[26]);
dvm_27 = utlb_v[27] & ((utlb_asid[27] == data_m_current_asid) | utlb_sh[27]);
dvm_28 = utlb_v[28] & ((utlb_asid[28] == data_m_current_asid) | utlb_sh[28]);
dvm_29 = utlb_v[29] & ((utlb_asid[29] == data_m_current_asid) | utlb_sh[29]);
dvm_30 = utlb_v[30] & ((utlb_asid[30] == data_m_current_asid) | utlb_sh[30]);
dvm_31 = utlb_v[31] & ((utlb_asid[31] == data_m_current_asid) | utlb_sh[31]);
dvm_32 = utlb_v[32] & ((utlb_asid[32] == data_m_current_asid) | utlb_sh[32]);
dvm_33 = utlb_v[33] & ((utlb_asid[33] == data_m_current_asid) | utlb_sh[33]);
dvm_34 = utlb_v[34] & ((utlb_asid[34] == data_m_current_asid) | utlb_sh[34]);
dvm_35 = utlb_v[35] & ((utlb_asid[35] == data_m_current_asid) | utlb_sh[35]);
dvm_36 = utlb_v[36] & ((utlb_asid[36] == data_m_current_asid) | utlb_sh[36]);
dvm_37 = utlb_v[37] & ((utlb_asid[37] == data_m_current_asid) | utlb_sh[37]);
dvm_38 = utlb_v[38] & ((utlb_asid[38] == data_m_current_asid) | utlb_sh[38]);
dvm_39 = utlb_v[39] & ((utlb_asid[39] == data_m_current_asid) | utlb_sh[39]);
dvm_40 = utlb_v[40] & ((utlb_asid[40] == data_m_current_asid) | utlb_sh[40]);
dvm_41 = utlb_v[41] & ((utlb_asid[41] == data_m_current_asid) | utlb_sh[41]);
dvm_42 = utlb_v[42] & ((utlb_asid[42] == data_m_current_asid) | utlb_sh[42]);
dvm_43 = utlb_v[43] & ((utlb_asid[43] == data_m_current_asid) | utlb_sh[43]);
dvm_44 = utlb_v[44] & ((utlb_asid[44] == data_m_current_asid) | utlb_sh[44]);
dvm_45 = utlb_v[45] & ((utlb_asid[45] == data_m_current_asid) | utlb_sh[45]);
dvm_46 = utlb_v[46] & ((utlb_asid[46] == data_m_current_asid) | utlb_sh[46]);
dvm_47 = utlb_v[47] & ((utlb_asid[47] == data_m_current_asid) | utlb_sh[47]);
dvm_48 = utlb_v[48] & ((utlb_asid[48] == data_m_current_asid) | utlb_sh[48]);
dvm_49 = utlb_v[49] & ((utlb_asid[49] == data_m_current_asid) | utlb_sh[49]);
dvm_50 = utlb_v[50] & ((utlb_asid[50] == data_m_current_asid) | utlb_sh[50]);
dvm_51 = utlb_v[51] & ((utlb_asid[51] == data_m_current_asid) | utlb_sh[51]);
dvm_52 = utlb_v[52] & ((utlb_asid[52] == data_m_current_asid) | utlb_sh[52]);
dvm_53 = utlb_v[53] & ((utlb_asid[53] == data_m_current_asid) | utlb_sh[53]);
dvm_54 = utlb_v[54] & ((utlb_asid[54] == data_m_current_asid) | utlb_sh[54]);
dvm_55 = utlb_v[55] & ((utlb_asid[55] == data_m_current_asid) | utlb_sh[55]);
dvm_56 = utlb_v[56] & ((utlb_asid[56] == data_m_current_asid) | utlb_sh[56]);
dvm_57 = utlb_v[57] & ((utlb_asid[57] == data_m_current_asid) | utlb_sh[57]);
dvm_58 = utlb_v[58] & ((utlb_asid[58] == data_m_current_asid) | utlb_sh[58]);
dvm_59 = utlb_v[59] & ((utlb_asid[59] == data_m_current_asid) | utlb_sh[59]);
dvm_60 = utlb_v[60] & ((utlb_asid[60] == data_m_current_asid) | utlb_sh[60]);
dvm_61 = utlb_v[61] & ((utlb_asid[61] == data_m_current_asid) | utlb_sh[61]);
dvm_62 = utlb_v[62] & ((utlb_asid[62] == data_m_current_asid) | utlb_sh[62]);
dvm_63 = utlb_v[63] & ((utlb_asid[63] == data_m_current_asid) | utlb_sh[63]);

var data_m_valid_asid_mask[63:0];
data_m_valid_asid_mask = {dvm_63, dvm_62, dvm_61, dvm_60, dvm_59, dvm_58, dvm_57, dvm_56,
                        dvm_55, dvm_54, dvm_53, dvm_52, dvm_51, dvm_50, dvm_49, dvm_48,
                        dvm_47, dvm_46, dvm_45, dvm_44, dvm_43, dvm_42, dvm_41, dvm_40,
                        dvm_39, dvm_38, dvm_37, dvm_36, dvm_35, dvm_34, dvm_33, dvm_32,
                        dvm_31, dvm_30, dvm_29, dvm_28, dvm_27, dvm_26, dvm_25, dvm_24,
                        dvm_23, dvm_22, dvm_21, dvm_20, dvm_19, dvm_18, dvm_17, dvm_16,
                        dvm_15, dvm_14, dvm_13, dvm_12, dvm_11, dvm_10, dvm_9, dvm_8,
                        dvm_7, dvm_6, dvm_5, dvm_4, dvm_3, dvm_2, dvm_1, dvm_0};

var data_m_utlb_match[63:0];
data_m_utlb_match = data_m_vpn_matches & data_m_valid_asid_mask;

var data_m_utlb_hit[0:0];
var data_m_utlb_hit_idx[6:0];
data_m_utlb_hit = |data_m_utlb_match;
data_m_utlb_hit_idx = ctz(data_m_utlb_match);

// ============================================================================
// Read Matched Entry
// ============================================================================
var data_m_utlb_idx6[5:0];
data_m_utlb_idx6 = data_m_utlb_hit_idx[5:0];

var data_m_matched_ppn[18:0];
var data_m_matched_pr[1:0];
var data_m_matched_d[0:0];

data_m_matched_ppn = utlb_ppn[data_m_utlb_idx6];
data_m_matched_pr = utlb_pr[data_m_utlb_idx6];
data_m_matched_d = utlb_d[data_m_utlb_idx6];

// ============================================================================
// Permission Checking
// ============================================================================
var data_m_is_privileged[0:0];
data_m_is_privileged = sr[30];

var data_m_read_perm_ok[0:0];
var data_m_write_perm_ok[0:0];
data_m_read_perm_ok = data_m_is_privileged | data_m_matched_pr[1];
data_m_write_perm_ok = data_m_matched_pr[0] & (data_m_is_privileged | data_m_matched_pr[1]);

// TLB exception flags
data_m_tlb_miss = data_m_mmu_enabled & data_m_needs_translation & ~data_m_utlb_hit;
data_m_tlb_prot_viol = data_m_mmu_enabled & data_m_needs_translation & data_m_utlb_hit & ((is_write_m & ~data_m_write_perm_ok) | (~is_write_m & ~data_m_read_perm_ok));
data_m_tlb_initial_write = data_m_mmu_enabled & data_m_needs_translation & is_write_m & data_m_utlb_hit & ~data_m_matched_d & data_m_write_perm_ok;
data_m_tlb_any_exception = data_m_tlb_miss | data_m_tlb_prot_viol | data_m_tlb_initial_write;
data_m_tlb_no_exception = ~data_m_tlb_any_exception;

// ============================================================================
// Physical Address Computation
// ============================================================================
var data_m_translated_addr[31:0];
data_m_translated_addr = {3'b000, data_m_matched_ppn[18:2], mmu_va_m[11:0]};

var data_m_p1_addr[31:0];
var data_m_p2_addr[31:0];
var data_m_p4_addr[31:0];
data_m_p1_addr = {3'b000, mmu_va_m[28:0]};
data_m_p2_addr = {3'b000, mmu_va_m[28:0]};
// Use VA[23:16] (peripheral block) and VA[7:0] (register offset) to avoid
// aliasing between different P4 sub-ranges (e.g., MMU 0xFF00xxxx vs INTC 0xFEE0xxxx)
data_m_p4_addr = {16'h03FF, mmu_va_m[23:16], mmu_va_m[7:0]};

addr_pa_m = data_m_is_p1 ? data_m_p1_addr :
          data_m_is_p2 ? data_m_p2_addr :
          data_m_is_p4 ? data_m_p4_addr :
          (data_m_mmu_enabled & data_m_needs_translation & data_m_utlb_hit) ? data_m_translated_addr :
          {3'b000, mmu_va_m[28:0]};

// ============================================================================
// Route TLB exceptions through exception.isa mechanism
// ============================================================================
// Override exc_taken/exc_vector (set by addr_error or defaulting to 0).
// TLB exceptions have priority over address errors since the TLB lookup
// must succeed before alignment can be meaningfully checked.
//
// SH4 EXPEVT codes (exc_code = exc_vector << 5):
//   0x02 -> 0x040: TLB miss (read)
//   0x03 -> 0x060: TLB miss (write) -- not standard SH4, we use 0x040 for both
//   0x04 -> 0x080: Initial page write
//   0x05 -> 0x0A0: TLB protection violation (read)
//   0x06 -> 0x0C0: TLB protection violation (write)
//
// All TLB exceptions route to VBR+0x400.
// exc_vector values: use 0x82-0x86 range to signal "TLB exception" to exception.isa
//   0x82 -> TLB miss (EXPEVT=0x040 for read, 0x060 for write)
//   0x83 -> Initial page write (EXPEVT=0x080)
//   0x84 -> TLB protection violation (EXPEVT=0x0A0 for read, 0x0C0 for write)

var data_m_tlb_bl[0:0];
data_m_tlb_bl = sr[28];

// Set exc_tea_addr_m for exception.isa to write to TEA register
var exc_tea_addr_m[31:0];
exc_tea_addr_m = mmu_va_m;

// Signal TLB exceptions to exception.isa via separate variables.
// exception.isa merges data_m_tlb_exc_taken/data_m_tlb_exc_vector with
// exc_taken/exc_vector (from addr_error or instruction body).
// This avoids circular dependencies from overriding exc_taken/exc_vector.
data_m_tlb_exc_taken = data_m_tlb_any_exception & ~data_m_tlb_bl;
data_m_tlb_exc_vector = data_m_tlb_miss ? 8'h82 :
                      data_m_tlb_initial_write ? 8'h83 :
                      data_m_tlb_prot_viol ? 8'h84 :
                      8'h00;
