// SPDX-License-Identifier: BSD-3-Clause
isa_state pc[31:0];
var instr[15:0];
isa_state rf[31:0][3:0];
isa_state rf_bank[31:0][2:0];
mem umem[23:0];
isa_state mach[31:0];
isa_state macl[31:0];
isa_state t[0:0];

// System registers (needed for exception handling)
isa_state sr[31:0];
isa_state vbr[31:0];
isa_state ssr[31:0];
isa_state spc[31:0];

var rn[3:0];
var rm[3:0];
var Rn[31:0];
var Rm[31:0];
var macl_rb[0:0];
var macl_rn_lo[2:0];
var macl_rm_lo[2:0];
var macl_rn_bk[0:0];
var macl_rm_bk[0:0];
var addr_n[31:0];
var addr_m[31:0];
var data_n[31:0];
var data_m[31:0];
var data_n_ext[63:0];
var data_m_ext[63:0];
var product[63:0];
var mac[63:0];
var result[63:0];

// Address error checking - MAC.L loads two 32-bit values
var load_addr[31:0];
var load_size[1:0];
var macl_addr_n_ok[0:0];
var macl_addr_m_ok[0:0];
var macl_no_error[0:0];

// Branch delay slot state
isa_state delay_slot[0:0];
isa_state branch_target[31:0];

// Include delay slot aspect - handles PC override if we're in a delay slot
aspect delay_slot.isa gates pc, delay_slot;

// Include interrupt aspect - checks for pending external interrupts
aspect interrupt.isa gates pc, sr, ssr, spc, intevt;

// MMU translation aspect for instruction fetch (PC -> pc_pa)
// Added AFTER delay_slot for higher precedence - exceptions override branches
#ifdef MMU
aspect mmu_translate_instr_cam.isa gates pc, tea, spc, delay_slot, ssr, sr, expevt;
#endif

// Include address error detection for loads (must be before exception.isa to set exc_taken)
aspect addr_error_load.isa gates pc, sr, vbr, rf, umem, ssr, spc;

// Include exception handling aspect
aspect exception.isa gates pc, sr, vbr, ssr, spc, expevt, tea, pteh;

#ifdef MMU
instr = umem[pc_pa];
#else
instr = umem[pc];
#endif
assume instr[15:12] == 0x0;
assume instr[3:0] == 0xF;
rn = instr[11:8];
rm = instr[7:4];

macl_rn_lo = rn[2:0];
macl_rm_lo = rm[2:0];
macl_rb = sr[29];  // RB bit (bit 29 in SR)
macl_rn_bk = (rn[3] == 1'b0) & macl_rb;
macl_rm_bk = (rm[3] == 1'b0) & macl_rb;

Rn = macl_rn_bk ? rf_bank[macl_rn_lo] : rf[rn];
Rm = macl_rm_bk ? rf_bank[macl_rm_lo] : rf[rm];

// Load from addresses pointed by Rn and Rm
addr_n = Rn;
addr_m = Rm;

// Check both addresses for 4-byte alignment
macl_addr_n_ok = (addr_n[1:0] == 2'b00);
macl_addr_m_ok = (addr_m[1:0] == 2'b00);
macl_no_error = macl_addr_n_ok & macl_addr_m_ok;

// Set up aspect variables (use first bad address for exception info)
load_addr = macl_addr_n_ok ? addr_m : addr_n;
load_size = 2'b11;  // Long access (32-bit)

var mmu_va[31:0];
mmu_va = addr_n;

// Data MMU translation for first operand (addr_n)
var is_write[0:0];
is_write = 1'b0;
#ifdef MMU
#include "mmu_translate_data_inline.isa"
#endif

// Data MMU translation for second operand (addr_m)
var mmu_va_m[31:0];
mmu_va_m = addr_m;
var is_write_m[0:0];
is_write_m = 1'b0;
#ifdef MMU
#include "mmu_translate_data_inline2.isa"
#endif

#ifdef MMU
data_n = umem[addr_pa];
#else
data_n = umem[addr_n];
#endif
#ifdef MMU
data_m = umem[addr_pa_m];
#else
data_m = umem[addr_m];
#endif

// Sign extend to 64-bit for signed multiply
data_n_ext = {{32{data_n[31]}}, data_n};
data_m_ext = {{32{data_m[31]}}, data_m};

// Multiply
product = data_n_ext * data_m_ext;

// Accumulate with current MAC value
mac = {mach, macl};
result = mac + product;

// Combined TLB guard: both translations must succeed
var macl_tlb_ok[0:0];
macl_tlb_ok = data_tlb_no_exception & data_m_tlb_no_exception;

// Only update state if no address error and no exception/interrupt taken
mach when (macl_no_error & ~int_should_take & ~itlb_exc_actually_taken & macl_tlb_ok) = result[63:32];
macl when (macl_no_error & ~int_should_take & ~itlb_exc_actually_taken & macl_tlb_ok) = result[31:0];

// Post-increment both registers by 4 (only if no error and no exception/interrupt)
rf[rn] when (macl_no_error & ((macl_rn_bk == 0) & macl_tlb_ok) & ~int_should_take & ~itlb_exc_actually_taken) = Rn + 4;
rf_bank[macl_rn_lo] when (macl_no_error & macl_rn_bk & ~int_should_take & ~itlb_exc_actually_taken & macl_tlb_ok) = Rn + 4;
rf[rm] when (macl_no_error & ((macl_rm_bk == 0) & macl_tlb_ok) & ~int_should_take & ~itlb_exc_actually_taken) = Rm + 4;
rf_bank[macl_rm_lo] when (macl_no_error & macl_rm_bk & ~int_should_take & ~itlb_exc_actually_taken & macl_tlb_ok) = Rm + 4;

// Advance PC unconditionally - exception/interrupt aspects override if needed
pc = pc + 2;
