// SPDX-License-Identifier: BSD-3-Clause
// FCNVDS DRm,FPUL - Convert double to single precision
// FPUL = (float)DRm
// Encoding: 1111mmm010111101 (0xFmBD) with m even
isa_state pc[31:0];
var instr[15:0];
isa_state fpr[31:0][3:0];
isa_state fpul[31:0];
isa_state fpscr[31:0];
mem umem[23:0];

var drm[2:0];
var frm_idx[3:0];
var DRm_hi[31:0];
var DRm_lo[31:0];
var DRm[63:0];
var rm[1:0];

isa_state delay_slot[0:0];
isa_state branch_target[31:0];
aspect delay_slot.isa gates pc, delay_slot;

// Include interrupt aspect - checks for pending external interrupts
aspect interrupt.isa gates pc, sr, ssr, spc, intevt;

// MMU translation aspect for instruction fetch (PC -> pc_pa)
// Added AFTER delay_slot for higher precedence - exceptions override branches
#ifdef MMU
aspect mmu_translate_instr_cam.isa gates pc, tea, spc, delay_slot, ssr, sr, expevt;
#endif
aspect exception.isa gates pc, sr, vbr, ssr, spc, expevt, tea, pteh;

#ifdef MMU
instr = umem[pc_pa];
#else
instr = umem[pc];
#endif
assume instr[15:12] == 0xF;
assume instr[7:0] == 0xBD;
assume instr[8] == 1'b0;

drm = instr[11:9];
frm_idx = {drm, 1'b0};

DRm_hi = fpr[frm_idx];
DRm_lo = fpr[frm_idx + 1];
DRm = {DRm_hi, DRm_lo};

rm = fpscr[1:0];

// Convert double to single
fpul when (~int_should_take & ~itlb_exc_actually_taken) = fp_cvt_s_d(DRm, rm);

pc = pc + 2;
