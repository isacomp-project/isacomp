// SPDX-License-Identifier: BSD-3-Clause
isa_state pc[31:0];
var instr[15:0];
isa_state rf[31:0][3:0];
isa_state rf_bank[31:0][2:0];
mem umem[23:0];

isa_state sr[31:0];

var rn[3:0];
var rm[3:0];
var Rm[31:0];
var data8[7:0];
var sign_ext_data[31:0];

var movb_rn_lo[2:0];
var movb_rm_lo[2:0];
var movb_rb[0:0];
var movb_rn_bk[0:0];
var movb_rm_bk[0:0];

isa_state delay_slot[0:0];
isa_state branch_target[31:0];
isa_state vbr[31:0];
isa_state ssr[31:0];
isa_state spc[31:0];
isa_state t[0:0];
aspect delay_slot.isa gates pc, delay_slot;

// Include interrupt aspect - checks for pending external interrupts
aspect interrupt.isa gates pc, sr, ssr, spc, intevt;
aspect exception.isa gates pc, sr, vbr, ssr, spc, expevt, tea, pteh;

// MMU translation aspect for instruction fetch (PC -> pc_pa)
// Added AFTER delay_slot for higher precedence - exceptions override branches
#ifdef MMU
aspect mmu_translate_instr_cam.isa gates pc, tea, spc, delay_slot, ssr, sr, expevt;
#endif

#ifdef MMU
instr = umem[pc_pa];
#else
instr = umem[pc];
#endif
assume instr[15:12] == 0x6;
assume instr[3:0] == 0x0;
rn = instr[11:8];
rm = instr[7:4];

movb_rn_lo = rn[2:0];
movb_rm_lo = rm[2:0];
movb_rb = sr[29];  // RB bit (bit 29 in SR)
movb_rn_bk = (rn[3] == 1'b0) & movb_rb;
movb_rm_bk = (rm[3] == 1'b0) & movb_rb;

Rm = movb_rm_bk ? rf_bank[movb_rm_lo] : rf[rm];

var mmu_va[31:0];
mmu_va = Rm;

// Data MMU translation
var is_write[0:0];
is_write = 1'b0;
#ifdef MMU
#include "mmu_translate_data_inline.isa"
#endif

#ifdef MMU
data8 = umem[addr_pa];
#else
data8 = umem[Rm];
#endif
sign_ext_data = {{24{data8[7]}}, data8};

rf[rn] when (~int_should_take & ~itlb_exc_actually_taken & ((movb_rn_bk == 0) & data_tlb_no_exception)) = sign_ext_data;
rf_bank[movb_rn_lo] when (~int_should_take & ~itlb_exc_actually_taken & (movb_rn_bk & data_tlb_no_exception)) = sign_ext_data;

pc = pc + 2;
