// SPDX-License-Identifier: BSD-3-Clause
isa_state pc[31:0];
var instr[15:0];
isa_state rf[31:0][3:0];
isa_state rf_bank[31:0][2:0];
mem umem[23:0];
isa_state t[0:0];

isa_state sr[31:0];
isa_state vbr[31:0];
isa_state ssr[31:0];
isa_state spc[31:0];

var rn[3:0];
var rm[3:0];
var Rn[31:0];
var Rm[31:0];

var store_addr[31:0];
var store_size[1:0];
var movw_st_no_error[0:0];
var halfword_data[15:0];

var movw_st_rn_lo[2:0];
var movw_st_rm_lo[2:0];
var movw_st_rb[0:0];
var movw_st_rn_bk[0:0];
var movw_st_rm_bk[0:0];

isa_state delay_slot[0:0];
isa_state branch_target[31:0];
aspect delay_slot.isa gates pc, delay_slot;

// Include interrupt aspect - checks for pending external interrupts
aspect interrupt.isa gates pc, sr, ssr, spc, intevt;

// MMU translation aspect for instruction fetch (PC -> pc_pa)
// Added AFTER delay_slot for higher precedence - exceptions override branches
#ifdef MMU
aspect mmu_translate_instr_cam.isa gates pc, tea, spc, delay_slot, ssr, sr, expevt;
#endif
aspect addr_error_store.isa gates pc, sr, vbr, rf, umem, ssr, spc;
aspect exception.isa gates pc, sr, vbr, ssr, spc, expevt, tea, pteh;

#ifdef MMU
instr = umem[pc_pa];
#else
instr = umem[pc];
#endif
assume instr[15:12] == 0x2;
assume instr[3:0] == 0x1;
rn = instr[11:8];
rm = instr[7:4];

movw_st_rn_lo = rn[2:0];
movw_st_rm_lo = rm[2:0];
movw_st_rb = sr[29];  // RB bit (bit 29 in SR)
movw_st_rn_bk = (rn[3] == 1'b0) & movw_st_rb;
movw_st_rm_bk = (rm[3] == 1'b0) & movw_st_rb;

Rn = movw_st_rn_bk ? rf_bank[movw_st_rn_lo] : rf[rn];
Rm = movw_st_rm_bk ? rf_bank[movw_st_rm_lo] : rf[rm];

store_addr = Rn;
store_size = 2'b10;

movw_st_no_error = (Rn[0] == 1'b0);

// MOV.W Rm, @Rn: store low 16 bits of Rm to address in Rn
halfword_data = Rm[15:0];
var mmu_va[31:0];
mmu_va = Rn;

// Data MMU translation
var is_write[0:0];
is_write = 1'b1;
#ifdef MMU
#include "mmu_translate_data_inline.isa"
#endif

#ifdef MMU
umem[addr_pa] when (~int_should_take & ~itlb_exc_actually_taken & (movw_st_no_error & data_tlb_no_exception)) = halfword_data;
#else
umem[Rn] when (~int_should_take & ~itlb_exc_actually_taken & (movw_st_no_error)) = halfword_data;
#endif
// Advance PC unconditionally - if an address error exception is taken,
// exception.isa has higher precedence and overrides this.
// Must be unconditional so interrupt.isa sees the advanced PC for SPC,
// preventing re-execution of completed stores after RTE.
pc = pc + 2;
