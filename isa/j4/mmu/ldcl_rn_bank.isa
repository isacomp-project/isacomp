// SPDX-License-Identifier: BSD-3-Clause
// LDC.L @Rm+,Rn_BANK - Load banked register from memory with post-increment (privileged)
// Encoding: 0100mmmm1nnn0111 (0x4m87..0x4mF7 for nnn=0..7)
// Loads to Rn_BANK from memory at @Rm, then increments Rm by 4
isa_state pc[31:0];
var instr[15:0];
isa_state rf[31:0][3:0];
isa_state rf_bank[31:0][2:0];
isa_state sr[31:0];
mem umem[23:0];

var rm[3:0];
var rn_bank[2:0];
var ldcl_bank_rm_lo[2:0];
var Rm[31:0];
var mem_data[31:0];
var new_rm[31:0];

var ldcl_bank_rb[0:0];
var ldcl_bank_rm_bk[0:0];

isa_state delay_slot[0:0];
isa_state branch_target[31:0];
isa_state vbr[31:0];
isa_state ssr[31:0];
isa_state spc[31:0];
isa_state t[0:0];
aspect delay_slot.isa gates pc, delay_slot;

// Include interrupt aspect - checks for pending external interrupts
aspect interrupt.isa gates pc, sr, ssr, spc, intevt;

// MMU translation aspect for instruction fetch (PC -> pc_pa)
#ifdef MMU
aspect mmu_translate_instr_cam.isa gates pc, tea, spc, delay_slot, ssr, sr, expevt;
#endif
aspect addr_error_load.isa gates pc, sr, vbr, rf, umem, ssr, spc;
aspect exception.isa gates pc, sr, vbr, ssr, spc, expevt, tea, pteh;

#ifdef MMU
instr = umem[pc_pa];
#else
instr = umem[pc];
#endif
assume instr[15:12] == 0x4;
assume instr[7] == 1'b1;
assume instr[3:0] == 0x7;
rm = instr[11:8];
rn_bank = instr[6:4];
ldcl_bank_rm_lo = rm[2:0];

// SR[29] is RB (register bank), SR[28] is BL (block exceptions)
ldcl_bank_rb = sr[29];  // RB bit (bit 29 in SR)
ldcl_bank_rm_bk = (rm[3] == 1'b0) & ldcl_bank_rb;

// Read address register (with banking consideration)
Rm = ldcl_bank_rm_bk ? rf_bank[ldcl_bank_rm_lo] : rf[rm];

// Load from memory
var load_addr[31:0];
var load_size[1:0];
load_addr = Rm;
load_size = 2'b11;
var mmu_va[31:0];
mmu_va = Rm;

// Data MMU translation
var is_write[0:0];
is_write = 1'b0;
#ifdef MMU
#include "mmu_translate_data_inline.isa"
#endif

#ifdef MMU
mem_data = umem[addr_pa];
#else
mem_data = umem[Rm];
#endif

// Store to the specified banked register (R0_BANK..R7_BANK)
// CRITICAL: Rn_BANK refers to the OPPOSITE bank from current SR.RB
// When RB=0: Rn_BANK accesses bank1 (rf_bank[])
// When RB=1: Rn_BANK accesses bank0 (rf[])
rf_bank[rn_bank] when (((ldcl_bank_rb == 0) & data_tlb_no_exception) & ~int_should_take & ~itlb_exc_actually_taken) = mem_data;
rf[{1'b0, rn_bank}] when ((ldcl_bank_rb == 1 & data_tlb_no_exception) & ~int_should_take & ~itlb_exc_actually_taken) = mem_data;

// Post-increment Rm by 4
new_rm = Rm + 4;
rf[rm] when (((ldcl_bank_rm_bk == 0) & data_tlb_no_exception) & ~int_should_take & ~itlb_exc_actually_taken) = new_rm;
rf_bank[ldcl_bank_rm_lo] when (ldcl_bank_rm_bk & ~int_should_take & ~itlb_exc_actually_taken & data_tlb_no_exception) = new_rm;

pc = pc + 2;
