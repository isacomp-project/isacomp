// SPDX-License-Identifier: BSD-3-Clause
// LDC.L @Rn+,DBR - Load DBR from stack (post-increment)
// DBR = (Rn); Rn = Rn + 4
// Encoding: 0100nnnn11110110 (0x4nF6)
isa_state pc[31:0];
var instr[15:0];
isa_state rf[31:0][3:0];
isa_state rf_bank[31:0][2:0];
isa_state sr[31:0];
isa_state dbr[31:0];
mem umem[23:0];

var rn[3:0];
var Rn[31:0];
var new_rn[31:0];
var data[31:0];
var ldcl_dbr_rn_lo[2:0];
var ldcl_dbr_rb[0:0];
var ldcl_dbr_rn_bk[0:0];

isa_state delay_slot[0:0];
isa_state branch_target[31:0];
isa_state vbr[31:0];
isa_state ssr[31:0];
isa_state spc[31:0];
isa_state t[0:0];
aspect delay_slot.isa gates pc, delay_slot;

// Include interrupt aspect - checks for pending external interrupts
aspect interrupt.isa gates pc, sr, ssr, spc, intevt;

// MMU translation aspect for instruction fetch (PC -> pc_pa)
// Added AFTER delay_slot for higher precedence - exceptions override branches
#ifdef MMU
aspect mmu_translate_instr_cam.isa gates pc, tea, spc, delay_slot, ssr, sr, expevt;
#endif
aspect addr_error_load.isa gates pc, sr, vbr, rf, umem, ssr, spc;
aspect exception.isa gates pc, sr, vbr, ssr, spc, expevt, tea, pteh;

#ifdef MMU
instr = umem[pc_pa];
#else
instr = umem[pc];
#endif
assume instr[15:12] == 0x4;
assume instr[7:0] == 0xF6;
rn = instr[11:8];

ldcl_dbr_rn_lo = rn[2:0];
ldcl_dbr_rb = sr[29];  // RB bit (bit 29 in SR)
ldcl_dbr_rn_bk = (rn[3] == 1'b0) & ldcl_dbr_rb;

Rn = ldcl_dbr_rn_bk ? rf_bank[ldcl_dbr_rn_lo] : rf[rn];

var load_addr[31:0];
var load_size[1:0];
load_addr = Rn;
load_size = 2'b11;
var mmu_va[31:0];
mmu_va = Rn;

// Data MMU translation
var is_write[0:0];
is_write = 1'b0;
#ifdef MMU
#include "mmu_translate_data_inline.isa"
#endif

#ifdef MMU
data = umem[addr_pa];
#else
data = umem[Rn];
#endif
dbr when (~int_should_take & ~itlb_exc_actually_taken & data_tlb_no_exception) = data;

new_rn = Rn + 4;
rf[rn] when (((ldcl_dbr_rn_bk == 0) & data_tlb_no_exception) & ~int_should_take & ~itlb_exc_actually_taken) = new_rn;
rf_bank[ldcl_dbr_rn_lo] when (ldcl_dbr_rn_bk & ~int_should_take & ~itlb_exc_actually_taken & data_tlb_no_exception) = new_rn;

pc = pc + 2;
