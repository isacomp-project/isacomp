// SPDX-License-Identifier: BSD-3-Clause
isa_state pc[31:0];
var instr[15:0];
isa_state rf[31:0][3:0];
isa_state rf_bank[31:0][2:0];  // Banked R0-R7 for RB=1
isa_state sr[31:0];
mem umem[23:0];

var rn[3:0];
var rm[3:0];
var Rn[31:0];
var Rm[31:0];
var movb_predec_addr[31:0];
var byte_data[7:0];

// Register banking variables (unique to movb_predec instruction)
var movb_predec_rn_lo[2:0];
var movb_predec_rm_lo[2:0];
var movb_predec_rb[0:0];
var movb_predec_rn_bk[0:0];
var movb_predec_rm_bk[0:0];

// Branch delay slot state
isa_state delay_slot[0:0];
isa_state branch_target[31:0];
isa_state vbr[31:0];
isa_state ssr[31:0];
isa_state spc[31:0];
isa_state t[0:0];

// Include delay slot aspect - handles PC override if we're in a delay slot
aspect delay_slot.isa gates pc, delay_slot;

// Include interrupt aspect - checks for pending external interrupts
aspect interrupt.isa gates pc, sr, ssr, spc, intevt;
aspect exception.isa gates pc, sr, vbr, ssr, spc, expevt, tea, pteh;

// MMU translation aspect for instruction fetch (PC -> pc_pa)
// Added AFTER delay_slot for higher precedence - exceptions override branches
#ifdef MMU
aspect mmu_translate_instr_cam.isa gates pc, tea, spc, delay_slot, ssr, sr, expevt;
#endif

#ifdef MMU
instr = umem[pc_pa];
#else
instr = umem[pc];
#endif
assume instr[15:12] == 0x2;
assume instr[3:0] == 0x4;
rn = instr[11:8];
rm = instr[7:4];

// Register banking setup
movb_predec_rn_lo = rn[2:0];
movb_predec_rm_lo = rm[2:0];
movb_predec_rb = sr[29];  // RB bit (bit 29 in SR)
movb_predec_rn_bk = (rn[3] == 1'b0) & movb_predec_rb;
movb_predec_rm_bk = (rm[3] == 1'b0) & movb_predec_rb;

Rn = movb_predec_rn_bk ? rf_bank[movb_predec_rn_lo] : rf[rn];
Rm = movb_predec_rm_bk ? rf_bank[movb_predec_rm_lo] : rf[rm];

// MOV.B Rm, @-Rn: decrement Rn by 1, store Rm to @Rn
movb_predec_addr = Rn - 1;

rf[rn] when (((movb_predec_rn_bk == 0) & data_tlb_no_exception) & ~int_should_take & ~itlb_exc_actually_taken) = movb_predec_addr;
rf_bank[movb_predec_rn_lo] when (movb_predec_rn_bk & ~int_should_take & ~itlb_exc_actually_taken & data_tlb_no_exception) = movb_predec_addr;
byte_data = Rm[7:0];
var mmu_va[31:0];
mmu_va = movb_predec_addr;

// Data MMU translation
var is_write[0:0];
is_write = 1'b1;
#ifdef MMU
#include "mmu_translate_data_inline.isa"
#endif

#ifdef MMU
umem[addr_pa] when (~int_should_take & ~itlb_exc_actually_taken & data_tlb_no_exception) = byte_data;
#else
umem[movb_predec_addr] when (~int_should_take & ~itlb_exc_actually_taken) = byte_data;
#endif
pc = pc + 2;
