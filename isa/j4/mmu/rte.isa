// SPDX-License-Identifier: BSD-3-Clause
// RTE - Return from Exception (with delay slot)
// SH-4 version: restores SR from SSR and PC from SPC
isa_state pc[31:0];
var instr[15:0];
isa_state rf[31:0][3:0];
isa_state sr[31:0];
isa_state t[0:0];
isa_state ssr[31:0];  // Saved Status Register (SH-4)
isa_state spc[31:0];  // Saved Program Counter (SH-4)
mem umem[23:0];

isa_state delay_slot[0:0];
isa_state branch_target[31:0];

var saved_sr[31:0];
var saved_pc[31:0];

aspect delay_slot.isa gates pc, delay_slot;

// NOTE: RTE intentionally does NOT include interrupt.isa.
// RTE only executes with BL=1 (returning from exception), so interrupts are
// always blocked. Adding the interrupt aspect creates gated write mux conflicts
// for SR/SSR/SPC that interfere with RTE's register restoration.

// MMU translation aspect for instruction fetch (PC -> pc_pa)
// Added AFTER delay_slot for higher precedence - exceptions override branches
#ifdef MMU
aspect mmu_translate_instr_cam.isa gates pc, tea, spc, delay_slot, ssr, sr, expevt;
#endif
aspect exception.isa gates pc, sr, vbr, ssr, spc, expevt, tea, pteh;

#ifdef MMU
instr = umem[pc_pa];
#else
instr = umem[pc];
#endif
assume instr[15:0] == 0x002B;

// Read saved PC and SR from SSR/SPC (SH-4 method)
saved_sr = ssr;
saved_pc = spc;

// Restore SR (T bit in bit 0)
sr when ((in_delay_slot == 0) & ~int_should_take & ~itlb_exc_actually_taken) = {saved_sr[31:1], 1'b0};
t when ((in_delay_slot == 0) & ~int_should_take & ~itlb_exc_actually_taken) = saved_sr[0];

// Set up delay slot with return address
delay_slot when ((in_delay_slot == 0) & ~int_should_take & ~itlb_exc_actually_taken) = 1;
branch_target when ((in_delay_slot == 0) & ~int_should_take & ~itlb_exc_actually_taken) = saved_pc;

pc = pc + 2;
