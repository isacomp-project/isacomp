// SPDX-License-Identifier: BSD-3-Clause
isa_state pc[31:0];
var instr[15:0];
isa_state rf[31:0][3:0];
isa_state rf_bank[31:0][2:0];  // Banked R0-R7 for RB=1
mem umem[23:0];
isa_state gbr[31:0];
isa_state t[0:0];

// System registers (needed for exception handling)
isa_state sr[31:0];
isa_state vbr[31:0];
isa_state ssr[31:0];
isa_state spc[31:0];

var disp[7:0];
var disp_ext[31:0];
var movw_gbr_store_addr[31:0];
var R0[31:0];

// Address error checking variables
var store_addr[31:0];
var store_size[1:0];
var movw_gbr_store_no_error[0:0];
var halfword_data[15:0];

// Register banking variables (unique to movw_gbr_store)
var movw_gbr_store_r0_lo[2:0];
var movw_gbr_store_rb[0:0];
var movw_gbr_store_r0_bk[0:0];

// Branch delay slot state
isa_state delay_slot[0:0];
isa_state branch_target[31:0];

// Include delay slot aspect - handles PC override if we're in a delay slot
aspect delay_slot.isa gates pc, delay_slot;

// Include interrupt aspect - checks for pending external interrupts
aspect interrupt.isa gates pc, sr, ssr, spc, intevt;

// MMU translation aspect for instruction fetch (PC -> pc_pa)
// Added AFTER delay_slot for higher precedence - exceptions override branches
#ifdef MMU
aspect mmu_translate_instr_cam.isa gates pc, tea, spc, delay_slot, ssr, sr, expevt;
#endif

// Include address error detection for stores (must be before exception.isa to set exc_taken)
aspect addr_error_store.isa gates pc, sr, vbr, rf, umem, ssr, spc;

// Include exception handling aspect
aspect exception.isa gates pc, sr, vbr, ssr, spc, expevt, tea, pteh;

#ifdef MMU
instr = umem[pc_pa];
#else
instr = umem[pc];
#endif
assume instr[15:8] == 0xC1;
disp = instr[7:0];

// Register banking setup
movw_gbr_store_r0_lo = 3'b000;
movw_gbr_store_rb = sr[29];  // RB bit (bit 29 in SR)
movw_gbr_store_r0_bk = movw_gbr_store_rb;  // R0[3] is 0

// MOV.W R0,@(disp,GBR): movw_gbr_store_addr = GBR + disp*2
disp_ext = {24'b0, disp};
movw_gbr_store_addr = gbr + {disp_ext[30:0], 1'b0};

// Set up address error checking
store_addr = movw_gbr_store_addr;
store_size = 2'b10;  // Word access (16-bit)

// Compute the no-error condition
movw_gbr_store_no_error = (movw_gbr_store_addr[0] == 1'b0);

R0 = movw_gbr_store_r0_bk ? rf_bank[movw_gbr_store_r0_lo] : rf[0];

// Only store if no address error
halfword_data = R0[15:0];
var mmu_va[31:0];
mmu_va = movw_gbr_store_addr;

// Data MMU translation
var is_write[0:0];
is_write = 1'b1;
#ifdef MMU
#include "mmu_translate_data_inline.isa"
#endif

#ifdef MMU
umem[addr_pa] when (~int_should_take & ~itlb_exc_actually_taken & (movw_gbr_store_no_error & data_tlb_no_exception)) = halfword_data;
#else
umem[movw_gbr_store_addr] when (~int_should_take & ~itlb_exc_actually_taken & (movw_gbr_store_no_error)) = halfword_data;
#endif

// Advance PC unconditionally - if an address error exception is taken,
// exception.isa has higher precedence and overrides this.
// Must be unconditional so interrupt.isa sees the advanced PC for SPC,
// preventing re-execution of completed stores after RTE.
pc = pc + 2;
