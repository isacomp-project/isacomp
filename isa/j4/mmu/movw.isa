// SPDX-License-Identifier: BSD-3-Clause
isa_state pc[31:0];
var instr[15:0];
isa_state rf[31:0][3:0];
isa_state rf_bank[31:0][2:0];
mem umem[23:0];
isa_state t[0:0];

isa_state sr[31:0];
isa_state vbr[31:0];
isa_state ssr[31:0];
isa_state spc[31:0];

var rn[3:0];
var rm[3:0];
var Rm[31:0];
var data16[15:0];
var sign_ext_data[31:0];

var load_addr[31:0];
var load_size[1:0];
var movw_no_error[0:0];

var movw_rn_lo[2:0];
var movw_rm_lo[2:0];
var movw_rb[0:0];
var movw_rn_bk[0:0];
var movw_rm_bk[0:0];

isa_state delay_slot[0:0];
isa_state branch_target[31:0];
aspect delay_slot.isa gates pc, delay_slot;

// Include interrupt aspect - checks for pending external interrupts
aspect interrupt.isa gates pc, sr, ssr, spc, intevt;

// MMU translation aspect for instruction fetch (PC -> pc_pa)
#ifdef MMU
aspect mmu_translate_instr_cam.isa gates pc, tea, spc, delay_slot, ssr, sr, expevt;
#endif
aspect addr_error_load.isa gates pc, sr, vbr, rf, umem, ssr, spc;
aspect exception.isa gates pc, sr, vbr, ssr, spc, expevt, tea, pteh;

#ifdef MMU
instr = umem[pc_pa];
#else
instr = umem[pc];
#endif
assume instr[15:12] == 0x6;
assume instr[3:0] == 0x1;
rn = instr[11:8];
rm = instr[7:4];

movw_rn_lo = rn[2:0];
movw_rm_lo = rm[2:0];
movw_rb = sr[29];  // RB bit (bit 29 in SR)
movw_rn_bk = (rn[3] == 1'b0) & movw_rb;
movw_rm_bk = (rm[3] == 1'b0) & movw_rb;

Rm = movw_rm_bk ? rf_bank[movw_rm_lo] : rf[rm];

load_addr = Rm;
load_size = 2'b10;  // Word access (16-bit)

movw_no_error = (Rm[0] == 1'b0);

// Virtual address for data translation
var mmu_va[31:0];
mmu_va = Rm;

// Data MMU translation (read access)
var is_write[0:0];
is_write = 1'b0;
#ifdef MMU
#include "mmu_translate_data_inline.isa"
#endif

#ifdef MMU
data16 = umem[addr_pa];
#else
data16 = umem[Rm];
#endif
sign_ext_data = {{16{data16[15]}}, data16};

// Only update register if no errors (alignment + TLB)
#ifdef MMU
rf[rn] when (~int_should_take & ~itlb_exc_actually_taken & (movw_no_error & data_tlb_no_exception & (movw_rn_bk == 0))) = sign_ext_data;
rf_bank[movw_rn_lo] when (~int_should_take & ~itlb_exc_actually_taken & (movw_no_error & data_tlb_no_exception & movw_rn_bk)) = sign_ext_data;
#else
rf[rn] when (~int_should_take & ~itlb_exc_actually_taken & (movw_no_error & (movw_rn_bk == 0))) = sign_ext_data;
rf_bank[movw_rn_lo] when (~int_should_take & ~itlb_exc_actually_taken & (movw_no_error & movw_rn_bk)) = sign_ext_data;
#endif

pc = pc + 2;
