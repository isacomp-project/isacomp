// SPDX-License-Identifier: BSD-3-Clause
// RTE - Return from Exception (with delay slot)
// SH-4 version: restores SR from SSR and PC from SPC
isa_state pc[31:0];
var instr[15:0];
isa_state rf[31:0][3:0];
isa_state sr[31:0];
isa_state t[0:0];
isa_state ssr[31:0];  // Saved Status Register (SH-4)
isa_state spc[31:0];  // Saved Program Counter (SH-4)
mem umem[23:0];

isa_state delay_slot[0:0];
isa_state branch_target[31:0];

var saved_sr[31:0];
var saved_pc[31:0];

aspect delay_slot.isa gates pc, delay_slot;

instr = umem[pc];
assume instr[15:0] == 0x002B;

// Read saved PC and SR from SSR/SPC (SH-4 method)
saved_sr = ssr;
saved_pc = spc;

// Restore SR (T bit in bit 0)
sr when (in_delay_slot == 0) = {saved_sr[31:1], 1'b0};
t when (in_delay_slot == 0) = saved_sr[0];

// Set up delay slot with return address
delay_slot when (in_delay_slot == 0) = 1;
branch_target when (in_delay_slot == 0) = saved_pc;

pc = pc + 2;
