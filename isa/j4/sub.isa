// SPDX-License-Identifier: BSD-3-Clause
isa_state pc[31:0];
var instr[15:0];
isa_state rf[31:0][3:0];
isa_state rf_bank[31:0][2:0];
isa_state sr[31:0];
mem umem[23:0];

var rn[3:0];
var rm[3:0];
var sub_rn_lo[2:0];
var sub_rm_lo[2:0];
var Rn[31:0];
var Rm[31:0];
var res[31:0];

var sub_rb[0:0];
var sub_rn_bk[0:0];
var sub_rm_bk[0:0];

isa_state delay_slot[0:0];
isa_state branch_target[31:0];
aspect delay_slot.isa gates pc, delay_slot;

instr = umem[pc];
assume instr[15:12] == 0x3;
assume instr[3:0] == 0x8;
rn = instr[11:8];
rm = instr[7:4];
sub_rn_lo = rn[2:0];
sub_rm_lo = rm[2:0];

sub_rb = sr[29];  // RB bit (bit 29 in SR)
sub_rn_bk = (rn[3] == 1'b0) & sub_rb;
sub_rm_bk = (rm[3] == 1'b0) & sub_rb;

Rn = sub_rn_bk ? rf_bank[sub_rn_lo] : rf[rn];
Rm = sub_rm_bk ? rf_bank[sub_rm_lo] : rf[rm];

res = Rn - Rm;

rf[rn] when (sub_rn_bk == 0) = res;
rf_bank[sub_rn_lo] when (sub_rn_bk) = res;
pc = pc + 2;
