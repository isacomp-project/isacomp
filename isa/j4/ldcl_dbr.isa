// SPDX-License-Identifier: BSD-3-Clause
// LDC.L @Rn+,DBR - Load DBR from stack (post-increment)
// DBR = (Rn); Rn = Rn + 4
// Encoding: 0100nnnn11110110 (0x4nF6)
isa_state pc[31:0];
var instr[15:0];
isa_state rf[31:0][3:0];
isa_state rf_bank[31:0][2:0];
isa_state sr[31:0];
isa_state dbr[31:0];
mem umem[23:0];

var rn[3:0];
var Rn[31:0];
var new_rn[31:0];
var data[31:0];
var ldcl_dbr_rn_lo[2:0];
var ldcl_dbr_rb[0:0];
var ldcl_dbr_rn_bk[0:0];

isa_state delay_slot[0:0];
isa_state branch_target[31:0];
aspect delay_slot.isa gates pc, delay_slot;

instr = umem[pc];
assume instr[15:12] == 0x4;
assume instr[7:0] == 0xF6;
rn = instr[11:8];

ldcl_dbr_rn_lo = rn[2:0];
ldcl_dbr_rb = sr[29];  // RB bit (bit 29 in SR)
ldcl_dbr_rn_bk = (rn[3] == 1'b0) & ldcl_dbr_rb;

Rn = ldcl_dbr_rn_bk ? rf_bank[ldcl_dbr_rn_lo] : rf[rn];

data = umem[Rn];
dbr = data;

new_rn = Rn + 4;
rf[rn] when (ldcl_dbr_rn_bk == 0) = new_rn;
rf_bank[ldcl_dbr_rn_lo] when (ldcl_dbr_rn_bk) = new_rn;

pc = pc + 2;
