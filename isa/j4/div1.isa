// SPDX-License-Identifier: BSD-3-Clause
isa_state pc[31:0];
var instr[15:0];
isa_state rf[31:0][3:0];
isa_state rf_bank[31:0][2:0];
isa_state sr[31:0];
mem umem[23:0];
isa_state t[0:0];

var rn[3:0];
var rm[3:0];
var Rn[31:0];
var Rm[31:0];
var shifted[31:0];
var div1_rb[0:0];
var div1_rn_lo[2:0];
var div1_rm_lo[2:0];
var div1_rn_bk[0:0];
var div1_rm_bk[0:0];

// Branch delay slot state
isa_state delay_slot[0:0];
isa_state branch_target[31:0];

// Include delay slot aspect - handles PC override if we're in a delay slot
aspect delay_slot.isa gates pc, delay_slot;

instr = umem[pc];
assume instr[15:12] == 0x3;
assume instr[3:0] == 0x4;
rn = instr[11:8];
rm = instr[7:4];

div1_rn_lo = rn[2:0];
div1_rm_lo = rm[2:0];
div1_rb = sr[29];  // RB bit (bit 29 in SR)
div1_rn_bk = (rn[3] == 1'b0) & div1_rb;
div1_rm_bk = (rm[3] == 1'b0) & div1_rb;

Rn = div1_rn_bk ? rf_bank[div1_rn_lo] : rf[rn];
Rm = div1_rm_bk ? rf_bank[div1_rm_lo] : rf[rm];

// DIV1 - one step of unsigned division algorithm
// 1. Shift Rn left and bring in T (quotient bit from previous step)
shifted = {Rn[30:0], t};

// 2. Compare with divisor and update
// If shifted >= Rm, subtract Rm and set T=1 (quotient bit)
// Else keep shifted and set T=0
rf[rn] = div1_rn_bk ? rf[rn] : ((shifted >= Rm) ? (shifted - Rm) : shifted);
rf_bank[div1_rn_lo] = div1_rn_bk ? ((shifted >= Rm) ? (shifted - Rm) : shifted) : rf_bank[div1_rn_lo];
t = (shifted >= Rm) ? 1'b1 : 1'b0;

pc = pc + 2;
