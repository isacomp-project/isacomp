isa_state pc[31:0];
var instr[15:0];
isa_state rf[31:0][3:0];
isa_state rf_bank[31:0][2:0];  // Banked R0-R7 for RB=1
isa_state sr[31:0];
mem umem[23:0];
isa_state gbr[31:0];

var imm[7:0];
var andb_gbr_addr[31:0];
var R0[31:0];
var data8[7:0];
var result[7:0];

// Register banking variables
var andb_gbr_r0_lo[2:0];
var andb_gbr_rb[0:0];
var andb_gbr_r0_bk[0:0];

// Branch delay slot state
isa_state delay_slot[0:0];
isa_state branch_target[31:0];

// Include delay slot aspect - handles PC override if we're in a delay slot
aspect delay_slot.isa gates pc, delay_slot;

instr = umem[pc];
assume instr[15:8] == 0xCD;
imm = instr[7:0];

// Register banking logic
andb_gbr_r0_lo = 3'b000;
andb_gbr_rb = sr[29];  // RB bit (bit 29 in SR)
andb_gbr_r0_bk = andb_gbr_rb;  // R0 is always in bank when RB=1

// AND.B #imm,@(R0,GBR): andb_gbr_addr = GBR + R0
R0 = andb_gbr_r0_bk ? rf_bank[andb_gbr_r0_lo] : rf[0];
andb_gbr_addr = gbr + R0;

// Read-modify-write
data8 = umem[andb_gbr_addr];
result = data8 & imm;
umem[andb_gbr_addr] = result;

pc = pc + 2;
