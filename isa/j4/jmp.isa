// JMP - Jump (with delay slot)
isa_state pc[31:0];
var instr[15:0];
isa_state rf[31:0][3:0];
isa_state rf_bank[31:0][2:0];
isa_state sr[31:0];
mem umem[23:0];

isa_state delay_slot[0:0];
isa_state branch_target[31:0];

var rm[3:0];
var jmp_rm_lo[2:0];
var Rm[31:0];

var jmp_rb[0:0];
var jmp_rm_bk[0:0];

aspect delay_slot.isa gates pc, delay_slot;

instr = umem[pc];
assume instr[15:12] == 0x4;
assume instr[7:0] == 0x2B;
rm = instr[11:8];
jmp_rm_lo = rm[2:0];

jmp_rb = sr[29];  // RB bit (bit 29 in SR)
jmp_rm_bk = (rm[3] == 1'b0) & jmp_rb;

Rm = jmp_rm_bk ? rf_bank[jmp_rm_lo] : rf[rm];

// Set up delay slot with jump target
delay_slot when (in_delay_slot == 0) = 1;
branch_target when (in_delay_slot == 0) = Rm;

pc = pc + 2;
