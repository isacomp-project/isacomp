// SPDX-License-Identifier: BSD-3-Clause
isa_state pc[31:0];
var instr[15:0];
isa_state rf[31:0][3:0];
isa_state rf_bank[31:0][2:0];  // Banked R0-R7 for RB=1
mem umem[23:0];
isa_state t[0:0];

// System registers (needed for exception handling)
isa_state sr[31:0];
isa_state vbr[31:0];
isa_state ssr[31:0];
isa_state spc[31:0];

var rn[3:0];
var rm[3:0];
var movl_disp_load_disp[3:0];
var movl_disp_load_disp_ext[31:0];
var movl_disp_load_Rm[31:0];
var movl_disp_load_addr[31:0];
var movl_disp_load_data[31:0];

// Address error checking variables
var load_addr[31:0];
var load_size[1:0];
var movl_disp_load_no_error[0:0];

// Register banking variables (unique to movl_disp_load instruction)
var movl_disp_load_rn_lo[2:0];
var movl_disp_load_rm_lo[2:0];
var movl_disp_load_rb[0:0];
var movl_disp_load_rn_bk[0:0];
var movl_disp_load_rm_bk[0:0];

// Branch delay slot state
isa_state delay_slot[0:0];
isa_state branch_target[31:0];

// Include delay slot aspect - handles PC override if we're in a delay slot
aspect delay_slot.isa gates pc, delay_slot;

// Include exception handling aspect
aspect exception.isa gates pc, sr, vbr, rf, umem, ssr, spc;

// Include address error detection for loads
aspect addr_error_load.isa gates pc, sr, vbr, rf, umem, ssr, spc;

instr = umem[pc];
assume instr[15:12] == 0x5;
rn = instr[11:8];
rm = instr[7:4];
movl_disp_load_disp = instr[3:0];

// Register banking setup
movl_disp_load_rn_lo = rn[2:0];
movl_disp_load_rm_lo = rm[2:0];
movl_disp_load_rb = sr[29];  // RB bit (bit 29 in SR)
movl_disp_load_rn_bk = (rn[3] == 1'b0) & movl_disp_load_rb;
movl_disp_load_rm_bk = (rm[3] == 1'b0) & movl_disp_load_rb;

movl_disp_load_Rm = movl_disp_load_rm_bk ? rf_bank[movl_disp_load_rm_lo] : rf[rm];

// MOV.L @(disp,Rm),Rn: addr = Rm + disp*4
movl_disp_load_disp_ext = {28'b0, movl_disp_load_disp};
movl_disp_load_addr = movl_disp_load_Rm + {movl_disp_load_disp_ext[29:0], 2'b0};

// Set up address error checking
load_addr = movl_disp_load_addr;
load_size = 2'b11;  // Long access (32-bit)

// Compute the no-error condition (bits 1:0 must be 00)
movl_disp_load_no_error = (movl_disp_load_addr[1:0] == 2'b00);

movl_disp_load_data = umem[movl_disp_load_addr];

// Only update register if no address error, combined with banking
rf[rn] when (movl_disp_load_no_error & (movl_disp_load_rn_bk == 0)) = movl_disp_load_data;
rf_bank[movl_disp_load_rn_lo] when (movl_disp_load_no_error & movl_disp_load_rn_bk) = movl_disp_load_data;

// Only advance PC if no address error
pc when (movl_disp_load_no_error) = pc + 2;
