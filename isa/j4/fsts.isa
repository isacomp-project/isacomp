// SPDX-License-Identifier: BSD-3-Clause
// FSTS FPUL,FRn - Store FPUL to FRn
// FRn = FPUL
isa_state pc[31:0];
var instr[15:0];
mem umem[23:0];

isa_state fr[31:0][3:0];
isa_state fpscr[31:0];
isa_state fpul[31:0];

var frn[3:0];

isa_state delay_slot[0:0];
isa_state branch_target[31:0];
aspect delay_slot.isa gates pc, delay_slot;

instr = umem[pc];
assume instr[15:8] == 0xF0;
assume instr[3:0] == 0x0D;
frn = instr[7:4];

fr[frn] = fpul;
pc = pc + 2;
