// SPDX-License-Identifier: BSD-3-Clause
// BSR - Branch to Subroutine (with delay slot)
isa_state pc[31:0];
var instr[15:0];
isa_state rf[31:0][3:0];
isa_state pr[31:0];  // Procedure register (return address)
mem umem[23:0];

isa_state delay_slot[0:0];
isa_state branch_target[31:0];

var disp[11:0];
var sign_ext_disp[31:0];
var branch_offset[31:0];
var branch_dest[31:0];

aspect delay_slot.isa gates pc, delay_slot;

instr = umem[pc];
assume instr[15:12] == 0xB;
disp = instr[11:0];

sign_ext_disp = {{19{disp[11]}}, disp, 1'b0};
branch_offset = sign_ext_disp + 4;
branch_dest = pc + branch_offset;

// Save return address to PR (PC + 4, after the delay slot)
pr when (in_delay_slot == 0) = pc + 4;

// Set up delay slot for next instruction
delay_slot when (in_delay_slot == 0) = 1;
branch_target when (in_delay_slot == 0) = branch_dest;

pc = pc + 2;
