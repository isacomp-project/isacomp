// LDC Rm,SR - Load SR from register (privileged)
isa_state pc[31:0];
var instr[15:0];
isa_state rf[31:0][3:0];
isa_state rf_bank[31:0][2:0];
isa_state sr[31:0];
isa_state t[0:0];
mem umem[23:0];

var rm[3:0];
var ldc_sr_rm_lo[2:0];
var Rm[31:0];

var ldc_sr_rb[0:0];
var ldc_sr_rm_bk[0:0];

isa_state delay_slot[0:0];
isa_state branch_target[31:0];
aspect delay_slot.isa gates pc, delay_slot;

instr = umem[pc];
assume instr[15:12] == 0x4;
assume instr[7:0] == 0x0E;
rm = instr[11:8];
ldc_sr_rm_lo = rm[2:0];

ldc_sr_rb = sr[29];  // RB bit (bit 29 in SR)
ldc_sr_rm_bk = (rm[3] == 1'b0) & ldc_sr_rb;

Rm = ldc_sr_rm_bk ? rf_bank[ldc_sr_rm_lo] : rf[rm];

// Load SR from Rm (T bit is in bit 0)
sr = {Rm[31:1], 1'b0};  // SR without T
t = Rm[0];              // T from bit 0
pc = pc + 2;
