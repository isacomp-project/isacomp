// SPDX-License-Identifier: BSD-3-Clause
isa_state pc[31:0];
var instr[15:0];
isa_state rf[31:0][3:0];
isa_state rf_bank[31:0][2:0];
isa_state sr[31:0];
isa_state t[0:0];
mem umem[23:0];

var rn[3:0];
var rm[3:0];
var subv_rn_lo[2:0];
var subv_rm_lo[2:0];
var Rn[31:0];
var Rm[31:0];
var res[31:0];
var overflow[0:0];

var subv_rb[0:0];
var subv_rn_bk[0:0];
var subv_rm_bk[0:0];

isa_state delay_slot[0:0];
isa_state branch_target[31:0];
aspect delay_slot.isa gates pc, delay_slot;

instr = umem[pc];
assume instr[15:12] == 0x3;
assume instr[3:0] == 0xB;
rn = instr[11:8];
rm = instr[7:4];
subv_rn_lo = rn[2:0];
subv_rm_lo = rm[2:0];

subv_rb = sr[29];  // RB bit (bit 29 in SR)
subv_rn_bk = (rn[3] == 1'b0) & subv_rb;
subv_rm_bk = (rm[3] == 1'b0) & subv_rb;

Rn = subv_rn_bk ? rf_bank[subv_rn_lo] : rf[rn];
Rm = subv_rm_bk ? rf_bank[subv_rm_lo] : rf[rm];

res = Rn - Rm;
// Overflow: different sign inputs and result sign differs from Rn
overflow = (Rn[31] != Rm[31]) & (Rn[31] != res[31]);

rf[rn] when (subv_rn_bk == 0) = res;
rf_bank[subv_rn_lo] when (subv_rn_bk) = res;
t = overflow;
pc = pc + 2;
