// SPDX-License-Identifier: BSD-3-Clause
// STC.L SPC,@-Rn - Store SPC to stack (pre-decrement)
// Rn = Rn - 4; (Rn) = SPC
// Encoding: 0100nnnn01000011 (0x4n43)
isa_state pc[31:0];
var instr[15:0];
isa_state rf[31:0][3:0];
isa_state rf_bank[31:0][2:0];
isa_state sr[31:0];
isa_state spc[31:0];
mem umem[23:0];

var rn[3:0];
var Rn[31:0];
var new_rn[31:0];
var stcl_spc_rn_lo[2:0];
var stcl_spc_rb[0:0];
var stcl_spc_rn_bk[0:0];

isa_state delay_slot[0:0];
isa_state branch_target[31:0];
aspect delay_slot.isa gates pc, delay_slot;

instr = umem[pc];
assume instr[15:12] == 0x4;
assume instr[7:0] == 0x43;
rn = instr[11:8];

stcl_spc_rn_lo = rn[2:0];
stcl_spc_rb = sr[29];  // RB bit (bit 29 in SR)
stcl_spc_rn_bk = (rn[3] == 1'b0) & stcl_spc_rb;

Rn = stcl_spc_rn_bk ? rf_bank[stcl_spc_rn_lo] : rf[rn];
new_rn = Rn - 4;

umem[new_rn] = spc;

rf[rn] when (stcl_spc_rn_bk == 0) = new_rn;
rf_bank[stcl_spc_rn_lo] when (stcl_spc_rn_bk) = new_rn;

pc = pc + 2;
