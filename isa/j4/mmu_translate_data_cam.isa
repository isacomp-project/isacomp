// SPDX-License-Identifier: BSD-3-Clause
// SH-4 MMU Data Translation Aspect (CAM Version)
// Uses CAM (Content-Addressable Memory) syntax for TLB lookup.
//
// Replaces ~130 lines of manual unrolling with ~60 lines using CAM.
// Now correctly searches ALL 64 UTLB entries (original only checked 16).
//
// Requires: addr variable must be defined before including this aspect
// Outputs:  addr_pa (physical address), tlb_data_miss (exception flag)

// Include MMU control registers and TLB arrays
#include "mmu_regs_cam.isa"

// Physical address output
var addr_pa[31:0];

// Exception signaling
var tlb_data_miss[0:0];
var tlb_data_prot_viol[0:0];
var tlb_data_initial_write[0:0];

// Address region detection
var addr_region[2:0];
var is_p0_u0[0:0];          // 0x00000000-0x7FFFFFFF (translated)
var is_p1[0:0];             // 0x80000000-0x9FFFFFFF (untranslated, cached)
var is_p2[0:0];             // 0xA0000000-0xBFFFFFFF (untranslated, uncached)
var is_p3[0:0];             // 0xC0000000-0xDFFFFFFF (translated)
var is_p4[0:0];             // 0xE0000000-0xFFFFFFFF (control, untranslated)
var needs_translation[0:0];

// MMU control
var mmu_enabled[0:0];
var current_asid[7:0];

// TLB lookup variables
var lookup_vpn[21:0];       // VPN to search for (addr[31:10])
var lookup_offset[9:0];     // Page offset (addr[9:0] for 1KB minimum)

// ============================================================================
// Address Region Classification
// ============================================================================
addr_region = addr[31:29];
is_p0_u0 = (addr[31] == 1'b0);
is_p1 = (addr_region == 3'b100);
is_p2 = (addr_region == 3'b101);
is_p3 = (addr_region == 3'b110);
is_p4 = (addr_region == 3'b111);
needs_translation = is_p0_u0 | is_p3;

// Read MMU control state
mmu_enabled = mmucr[0];
current_asid = pteh[7:0];

// Decompose address
lookup_vpn = addr[31:10];
lookup_offset = addr[9:0];

// ============================================================================
// UTLB CAM Lookup (64 entries, fully associative)
// ============================================================================
// Step 1: Get VPN matches using CAM lookup
var vpn_matches[63:0];
vpn_matches = utlb_vpn@[lookup_vpn];

// Step 2: Filter by Valid, ASID/Shared
// Entry matches if: V=1 AND VPN_match AND (ASID_match OR SH=1)
// This requires per-entry filtering (future: CAM filter expressions)
var v_0[0:0]; var v_1[0:0]; var v_2[0:0]; var v_3[0:0];
var v_4[0:0]; var v_5[0:0]; var v_6[0:0]; var v_7[0:0];
var v_8[0:0]; var v_9[0:0]; var v_10[0:0]; var v_11[0:0];
var v_12[0:0]; var v_13[0:0]; var v_14[0:0]; var v_15[0:0];
var v_16[0:0]; var v_17[0:0]; var v_18[0:0]; var v_19[0:0];
var v_20[0:0]; var v_21[0:0]; var v_22[0:0]; var v_23[0:0];
var v_24[0:0]; var v_25[0:0]; var v_26[0:0]; var v_27[0:0];
var v_28[0:0]; var v_29[0:0]; var v_30[0:0]; var v_31[0:0];
var v_32[0:0]; var v_33[0:0]; var v_34[0:0]; var v_35[0:0];
var v_36[0:0]; var v_37[0:0]; var v_38[0:0]; var v_39[0:0];
var v_40[0:0]; var v_41[0:0]; var v_42[0:0]; var v_43[0:0];
var v_44[0:0]; var v_45[0:0]; var v_46[0:0]; var v_47[0:0];
var v_48[0:0]; var v_49[0:0]; var v_50[0:0]; var v_51[0:0];
var v_52[0:0]; var v_53[0:0]; var v_54[0:0]; var v_55[0:0];
var v_56[0:0]; var v_57[0:0]; var v_58[0:0]; var v_59[0:0];
var v_60[0:0]; var v_61[0:0]; var v_62[0:0]; var v_63[0:0];

// Valid AND (ASID match OR Shared)
v_0 = utlb_v[0] & ((utlb_asid[0] == current_asid) | utlb_sh[0]);
v_1 = utlb_v[1] & ((utlb_asid[1] == current_asid) | utlb_sh[1]);
v_2 = utlb_v[2] & ((utlb_asid[2] == current_asid) | utlb_sh[2]);
v_3 = utlb_v[3] & ((utlb_asid[3] == current_asid) | utlb_sh[3]);
v_4 = utlb_v[4] & ((utlb_asid[4] == current_asid) | utlb_sh[4]);
v_5 = utlb_v[5] & ((utlb_asid[5] == current_asid) | utlb_sh[5]);
v_6 = utlb_v[6] & ((utlb_asid[6] == current_asid) | utlb_sh[6]);
v_7 = utlb_v[7] & ((utlb_asid[7] == current_asid) | utlb_sh[7]);
v_8 = utlb_v[8] & ((utlb_asid[8] == current_asid) | utlb_sh[8]);
v_9 = utlb_v[9] & ((utlb_asid[9] == current_asid) | utlb_sh[9]);
v_10 = utlb_v[10] & ((utlb_asid[10] == current_asid) | utlb_sh[10]);
v_11 = utlb_v[11] & ((utlb_asid[11] == current_asid) | utlb_sh[11]);
v_12 = utlb_v[12] & ((utlb_asid[12] == current_asid) | utlb_sh[12]);
v_13 = utlb_v[13] & ((utlb_asid[13] == current_asid) | utlb_sh[13]);
v_14 = utlb_v[14] & ((utlb_asid[14] == current_asid) | utlb_sh[14]);
v_15 = utlb_v[15] & ((utlb_asid[15] == current_asid) | utlb_sh[15]);
v_16 = utlb_v[16] & ((utlb_asid[16] == current_asid) | utlb_sh[16]);
v_17 = utlb_v[17] & ((utlb_asid[17] == current_asid) | utlb_sh[17]);
v_18 = utlb_v[18] & ((utlb_asid[18] == current_asid) | utlb_sh[18]);
v_19 = utlb_v[19] & ((utlb_asid[19] == current_asid) | utlb_sh[19]);
v_20 = utlb_v[20] & ((utlb_asid[20] == current_asid) | utlb_sh[20]);
v_21 = utlb_v[21] & ((utlb_asid[21] == current_asid) | utlb_sh[21]);
v_22 = utlb_v[22] & ((utlb_asid[22] == current_asid) | utlb_sh[22]);
v_23 = utlb_v[23] & ((utlb_asid[23] == current_asid) | utlb_sh[23]);
v_24 = utlb_v[24] & ((utlb_asid[24] == current_asid) | utlb_sh[24]);
v_25 = utlb_v[25] & ((utlb_asid[25] == current_asid) | utlb_sh[25]);
v_26 = utlb_v[26] & ((utlb_asid[26] == current_asid) | utlb_sh[26]);
v_27 = utlb_v[27] & ((utlb_asid[27] == current_asid) | utlb_sh[27]);
v_28 = utlb_v[28] & ((utlb_asid[28] == current_asid) | utlb_sh[28]);
v_29 = utlb_v[29] & ((utlb_asid[29] == current_asid) | utlb_sh[29]);
v_30 = utlb_v[30] & ((utlb_asid[30] == current_asid) | utlb_sh[30]);
v_31 = utlb_v[31] & ((utlb_asid[31] == current_asid) | utlb_sh[31]);
v_32 = utlb_v[32] & ((utlb_asid[32] == current_asid) | utlb_sh[32]);
v_33 = utlb_v[33] & ((utlb_asid[33] == current_asid) | utlb_sh[33]);
v_34 = utlb_v[34] & ((utlb_asid[34] == current_asid) | utlb_sh[34]);
v_35 = utlb_v[35] & ((utlb_asid[35] == current_asid) | utlb_sh[35]);
v_36 = utlb_v[36] & ((utlb_asid[36] == current_asid) | utlb_sh[36]);
v_37 = utlb_v[37] & ((utlb_asid[37] == current_asid) | utlb_sh[37]);
v_38 = utlb_v[38] & ((utlb_asid[38] == current_asid) | utlb_sh[38]);
v_39 = utlb_v[39] & ((utlb_asid[39] == current_asid) | utlb_sh[39]);
v_40 = utlb_v[40] & ((utlb_asid[40] == current_asid) | utlb_sh[40]);
v_41 = utlb_v[41] & ((utlb_asid[41] == current_asid) | utlb_sh[41]);
v_42 = utlb_v[42] & ((utlb_asid[42] == current_asid) | utlb_sh[42]);
v_43 = utlb_v[43] & ((utlb_asid[43] == current_asid) | utlb_sh[43]);
v_44 = utlb_v[44] & ((utlb_asid[44] == current_asid) | utlb_sh[44]);
v_45 = utlb_v[45] & ((utlb_asid[45] == current_asid) | utlb_sh[45]);
v_46 = utlb_v[46] & ((utlb_asid[46] == current_asid) | utlb_sh[46]);
v_47 = utlb_v[47] & ((utlb_asid[47] == current_asid) | utlb_sh[47]);
v_48 = utlb_v[48] & ((utlb_asid[48] == current_asid) | utlb_sh[48]);
v_49 = utlb_v[49] & ((utlb_asid[49] == current_asid) | utlb_sh[49]);
v_50 = utlb_v[50] & ((utlb_asid[50] == current_asid) | utlb_sh[50]);
v_51 = utlb_v[51] & ((utlb_asid[51] == current_asid) | utlb_sh[51]);
v_52 = utlb_v[52] & ((utlb_asid[52] == current_asid) | utlb_sh[52]);
v_53 = utlb_v[53] & ((utlb_asid[53] == current_asid) | utlb_sh[53]);
v_54 = utlb_v[54] & ((utlb_asid[54] == current_asid) | utlb_sh[54]);
v_55 = utlb_v[55] & ((utlb_asid[55] == current_asid) | utlb_sh[55]);
v_56 = utlb_v[56] & ((utlb_asid[56] == current_asid) | utlb_sh[56]);
v_57 = utlb_v[57] & ((utlb_asid[57] == current_asid) | utlb_sh[57]);
v_58 = utlb_v[58] & ((utlb_asid[58] == current_asid) | utlb_sh[58]);
v_59 = utlb_v[59] & ((utlb_asid[59] == current_asid) | utlb_sh[59]);
v_60 = utlb_v[60] & ((utlb_asid[60] == current_asid) | utlb_sh[60]);
v_61 = utlb_v[61] & ((utlb_asid[61] == current_asid) | utlb_sh[61]);
v_62 = utlb_v[62] & ((utlb_asid[62] == current_asid) | utlb_sh[62]);
v_63 = utlb_v[63] & ((utlb_asid[63] == current_asid) | utlb_sh[63]);

var valid_asid_mask[63:0];
valid_asid_mask = {v_63, v_62, v_61, v_60, v_59, v_58, v_57, v_56,
                   v_55, v_54, v_53, v_52, v_51, v_50, v_49, v_48,
                   v_47, v_46, v_45, v_44, v_43, v_42, v_41, v_40,
                   v_39, v_38, v_37, v_36, v_35, v_34, v_33, v_32,
                   v_31, v_30, v_29, v_28, v_27, v_26, v_25, v_24,
                   v_23, v_22, v_21, v_20, v_19, v_18, v_17, v_16,
                   v_15, v_14, v_13, v_12, v_11, v_10, v_9, v_8,
                   v_7, v_6, v_5, v_4, v_3, v_2, v_1, v_0};

// Final match: VPN match AND Valid AND (ASID match OR Shared)
var utlb_match[63:0];
utlb_match = vpn_matches & valid_asid_mask;

// Get hit status and index using ctz
var utlb_hit[0:0];
var utlb_hit_idx[6:0];
utlb_hit = |utlb_match;
utlb_hit_idx = ctz(utlb_match);

// ============================================================================
// Read Matched Entry
// ============================================================================
// Extract 6-bit index (ctz returns 7 bits to encode "no match" as 64)
var utlb_idx6[5:0];
utlb_idx6 = utlb_hit_idx[5:0];

var matched_ppn[18:0];
var matched_sz[2:0];
var matched_pr[1:0];
var matched_d[0:0];
var matched_sh[0:0];

matched_ppn = utlb_ppn[utlb_idx6];
matched_sz = utlb_sz[utlb_idx6];
matched_pr = utlb_pr[utlb_idx6];
matched_d = utlb_d[utlb_idx6];
matched_sh = utlb_sh[utlb_idx6];

// ============================================================================
// Permission Checking
// ============================================================================
var is_privileged[0:0];
var is_write[0:0];
is_privileged = sr[30];

// PR[1:0]: 00=kernel R only, 01=kernel R/W, 10=user R/kernel R/W, 11=user R/W
var read_perm_ok[0:0];
var write_perm_ok[0:0];
read_perm_ok = is_privileged | matched_pr[1];
write_perm_ok = matched_pr[0] & (is_privileged | matched_pr[1]);

// Initial page write exception (first write to clean page)
tlb_data_initial_write = is_write & utlb_hit & ~matched_d & write_perm_ok;

// Protection violation
tlb_data_prot_viol = utlb_hit & ((is_write & ~write_perm_ok) | (~is_write & ~read_perm_ok));

// TLB miss (no matching entry)
tlb_data_miss = mmu_enabled & needs_translation & ~utlb_hit;

// ============================================================================
// Physical Address Computation
// ============================================================================
var translated_addr[31:0];
// For 4KB pages: PA = {3'b000, PPN[28:12], VA[11:0]}
// TLB stores PPN[28:10] in matched_ppn[18:0], so PPN[28:12] = matched_ppn[18:2]
translated_addr = {3'b000, matched_ppn[18:2], addr[11:0]};

var p1_addr[31:0];
var p2_addr[31:0];
p1_addr = {3'b000, addr[28:0]};
p2_addr = {3'b000, addr[28:0]};

addr_pa = is_p1 ? p1_addr :
          is_p2 ? p2_addr :
          is_p4 ? addr :
          (mmu_enabled & needs_translation & utlb_hit) ? translated_addr :
          addr;

// ============================================================================
// Exception Handling
// ============================================================================
tea when (tlb_data_miss) = addr;

var tlb_exception[0:0];
var tlb_exc_vector[31:0];

tlb_exception = tlb_data_miss | tlb_data_prot_viol | tlb_data_initial_write;
tlb_exc_vector = tlb_data_miss ? (vbr + 32'h400) :
                 (tlb_data_prot_viol | tlb_data_initial_write) ? (vbr + 32'h100) :
                 vbr;

ssr when (tlb_exception) = {sr[31:1], t};
spc when (tlb_exception) = pc;
sr when (tlb_exception) = {sr[31], 3'b111, sr[27:0]};
pc when (tlb_exception) = tlb_exc_vector;
