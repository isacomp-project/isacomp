// SPDX-License-Identifier: BSD-3-Clause
isa_state pc[31:0];
var instr[15:0];
isa_state rf[31:0][3:0];
isa_state rf_bank[31:0][2:0];
isa_state sr[31:0];
isa_state t[0:0];
mem umem[23:0];

var rn[3:0];
var movt_rn_lo[2:0];

var movt_rb[0:0];
var movt_rn_bk[0:0];

isa_state delay_slot[0:0];
isa_state branch_target[31:0];
aspect delay_slot.isa gates pc, delay_slot;

instr = umem[pc];
assume instr[15:12] == 0x0;
assume instr[7:0] == 0x29;
rn = instr[11:8];
movt_rn_lo = rn[2:0];

movt_rb = sr[29];  // RB bit (bit 29 in SR)
movt_rn_bk = (rn[3] == 1'b0) & movt_rb;

rf[rn] when (movt_rn_bk == 0) = {31'b0, t};
rf_bank[movt_rn_lo] when (movt_rn_bk) = {31'b0, t};
pc = pc + 2;
