// SPDX-License-Identifier: BSD-3-Clause
// FLOAT FPUL,FRn - Convert Integer to Float
// FRn = (float)FPUL
// Encoding: 1111nnnn00101101
isa_state pc[31:0];
var instr[15:0];
mem umem[23:0];

isa_state fr[31:0][3:0];
isa_state fpscr[31:0];
isa_state fpul[31:0];

var frn[3:0];
var rm[2:0];
var cvt_result[31:0];

isa_state delay_slot[0:0];
isa_state branch_target[31:0];
aspect delay_slot.isa gates pc, delay_slot;

instr = umem[pc];
assume instr[15:8] == 0xF0;
assume instr[7:0] == 0x2D;
frn = instr[7:4];

// FPSCR[1:0] is rounding mode (00=RNE, 01=RTZ)
rm = {1'b0, fpscr[1:0]};

// Convert signed 32-bit integer to IEEE 754 single using fp intrinsic
cvt_result = fp_cvt_s_w(fpul, rm);

fr[frn] = cvt_result;
pc = pc + 2;
