// SPDX-License-Identifier: BSD-3-Clause
// FMOV FRm,FRn - Floating-Point Move
// FRn = FRm
isa_state pc[31:0];
var instr[15:0];
mem umem[23:0];

isa_state fr[31:0][3:0];
isa_state fpscr[31:0];
isa_state fpul[31:0];

var frn[3:0];
var frm[3:0];
var FRm[31:0];

isa_state delay_slot[0:0];
isa_state branch_target[31:0];
aspect delay_slot.isa gates pc, delay_slot;

instr = umem[pc];
assume instr[15:12] == 0xF;
assume instr[3:0] == 0xC;
frn = instr[11:8];
frm = instr[7:4];

FRm = fr[frm];

fr[frn] = FRm;
pc = pc + 2;
