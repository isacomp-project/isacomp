// LDS Rm,FPUL - Load FPUL from register
isa_state pc[31:0];
var instr[15:0];
isa_state rf[31:0][3:0];
isa_state rf_bank[31:0][2:0];
isa_state sr[31:0];
mem umem[23:0];

isa_state fpul[31:0];

var rm[3:0];
var lds_fpul_rm_lo[2:0];
var Rm[31:0];

var lds_fpul_rb[0:0];
var lds_fpul_rm_bk[0:0];

isa_state delay_slot[0:0];
isa_state branch_target[31:0];
aspect delay_slot.isa gates pc, delay_slot;

instr = umem[pc];
assume instr[15:12] == 0x4;
assume instr[7:0] == 0x5A;
rm = instr[11:8];
lds_fpul_rm_lo = rm[2:0];

lds_fpul_rb = sr[29];  // RB bit (bit 29 in SR)
lds_fpul_rm_bk = (rm[3] == 1'b0) & lds_fpul_rb;

Rm = lds_fpul_rm_bk ? rf_bank[lds_fpul_rm_lo] : rf[rm];

fpul = Rm;
pc = pc + 2;
