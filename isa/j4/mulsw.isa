// SPDX-License-Identifier: BSD-3-Clause
isa_state pc[31:0];
var instr[15:0];
isa_state rf[31:0][3:0];
isa_state rf_bank[31:0][2:0];  // Banked R0-R7 for RB=1
isa_state sr[31:0];
mem umem[23:0];
isa_state macl[31:0];

var rn[3:0];
var rm[3:0];
var mulsw_rn_lo[2:0];
var mulsw_rm_lo[2:0];
var Rn[31:0];
var Rm[31:0];

// Register banking flags (unique to mulsw instruction)
var mulsw_rb[0:0];
var mulsw_rn_bk[0:0];
var mulsw_rm_bk[0:0];

// Branch delay slot state
isa_state delay_slot[0:0];
isa_state branch_target[31:0];

// Include delay slot aspect - handles PC override if we're in a delay slot
aspect delay_slot.isa gates pc, delay_slot;

instr = umem[pc];
assume instr[15:12] == 0x2;
assume instr[3:0] == 0xF;
rn = instr[11:8];
rm = instr[7:4];
mulsw_rn_lo = rn[2:0];
mulsw_rm_lo = rm[2:0];

// Banking: R0-R7 use rf_bank when SR.RB=1
mulsw_rb = sr[29];  // RB bit (bit 29 in SR)
mulsw_rn_bk = (rn[3] == 1'b0) & mulsw_rb;
mulsw_rm_bk = (rm[3] == 1'b0) & mulsw_rb;

Rn = mulsw_rn_bk ? rf_bank[mulsw_rn_lo] : rf[rn];
Rm = mulsw_rm_bk ? rf_bank[mulsw_rm_lo] : rf[rm];

// MULS.W stores 32-bit signed result in MACL
// Sign-extend 16-bit operands to 32-bit before multiply
macl = {{16{Rn[15]}}, Rn[15:0]} * {{16{Rm[15]}}, Rm[15:0]};
pc = pc + 2;
