// SPDX-License-Identifier: BSD-3-Clause
// STC SPC, Rn - Store Control Register SPC to Rn
// SH-4 specific: Saved Program Counter
// Encoding: 0000nnnn01000010
isa_state pc[31:0];
var instr[15:0];
isa_state rf[31:0][3:0];
isa_state rf_bank[31:0][2:0];
isa_state sr[31:0];
isa_state spc[31:0];  // Saved Program Counter (SH-4 specific)
mem umem[23:0];

var rn[3:0];
var stc_spc_rn_lo[2:0];
var stc_spc_rb[0:0];
var stc_spc_rn_bk[0:0];

isa_state delay_slot[0:0];
isa_state branch_target[31:0];
aspect delay_slot.isa gates pc, delay_slot;

instr = umem[pc];
assume instr[15:12] == 0x0;
assume instr[7:0] == 0x42;
rn = instr[11:8];

stc_spc_rn_lo = rn[2:0];
stc_spc_rb = sr[29];  // RB bit (bit 29 in SR)
stc_spc_rn_bk = (rn[3] == 1'b0) & stc_spc_rb;

// Store SPC to Rn (privileged, SH-4 specific)
rf[rn] when (stc_spc_rn_bk == 0) = spc;
rf_bank[stc_spc_rn_lo] when (stc_spc_rn_bk) = spc;
pc = pc + 2;
