// SPDX-License-Identifier: BSD-3-Clause
// FLOAT FPUL,DRn - Convert 32-bit integer to double-precision float
// DRn = (double)FPUL (when FPSCR.PR=1)
// Encoding: 1111nnn000101101 (0xFn2D) with n even
isa_state pc[31:0];
var instr[15:0];
isa_state fpr[31:0][3:0];
isa_state fpul[31:0];
isa_state fpscr[31:0];
mem umem[23:0];

var drn[2:0];
var frn_idx[3:0];
var result[63:0];
var rm[1:0];

isa_state delay_slot[0:0];
isa_state branch_target[31:0];
aspect delay_slot.isa gates pc, delay_slot;

instr = umem[pc];
assume instr[15:12] == 0xF;
assume instr[7:0] == 0x2D;
assume instr[8] == 1'b0;

drn = instr[11:9];
frn_idx = {drn, 1'b0};

rm = fpscr[1:0];

// Convert signed 32-bit integer to double
result = fp_cvt_d_w(fpul, rm);

fpr[frn_idx] = result[63:32];
fpr[frn_idx + 1] = result[31:0];

pc = pc + 2;
