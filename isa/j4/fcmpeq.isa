// SPDX-License-Identifier: BSD-3-Clause
// FCMP/EQ FRm,FRn - Floating-Point Compare Equal
// T = (FRn == FRm)
// Encoding: 1111nnnnmmmm0100
isa_state pc[31:0];
var instr[15:0];
mem umem[23:0];
isa_state t[0:0];

isa_state fr[31:0][3:0];
isa_state fpscr[31:0];
isa_state fpul[31:0];

var frn[3:0];
var frm[3:0];
var FRn[31:0];
var FRm[31:0];
var cmp_result[0:0];

isa_state delay_slot[0:0];
isa_state branch_target[31:0];
aspect delay_slot.isa gates pc, delay_slot;

instr = umem[pc];
assume instr[15:12] == 0xF;
assume instr[3:0] == 0x4;
frn = instr[11:8];
frm = instr[7:4];

FRn = fr[frn];
FRm = fr[frm];

// IEEE 754 compare for equality using fp intrinsic
cmp_result = fp_eq(FRn, FRm);
t = cmp_result;

pc = pc + 2;
