// SPDX-License-Identifier: BSD-3-Clause
// FABS FRn - Floating-Point Absolute Value
// FRn = |FRn| (clear sign bit)
isa_state pc[31:0];
var instr[15:0];
mem umem[23:0];

isa_state fr[31:0][3:0];
isa_state fpscr[31:0];
isa_state fpul[31:0];

var frn[3:0];
var FRn[31:0];
var res[31:0];

isa_state delay_slot[0:0];
isa_state branch_target[31:0];
aspect delay_slot.isa gates pc, delay_slot;

instr = umem[pc];
assume instr[15:8] == 0xF0;
assume instr[7:0] == 0x5D;
frn = instr[7:4];

FRn = fr[frn];

// Absolute value by clearing sign bit (bit 31)
res = {1'b0, FRn[30:0]};

fr[frn] = res;
pc = pc + 2;
