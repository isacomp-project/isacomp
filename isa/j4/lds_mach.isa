// SPDX-License-Identifier: BSD-3-Clause
isa_state pc[31:0];
var instr[15:0];
isa_state rf[31:0][3:0];
isa_state rf_bank[31:0][2:0];
isa_state sr[31:0];
mem umem[23:0];
isa_state mach[31:0];

var rn[3:0];
var Rn[31:0];
var lds_mach_rb[0:0];
var lds_mach_rn_lo[2:0];
var lds_mach_rn_bk[0:0];

// Branch delay slot state
isa_state delay_slot[0:0];
isa_state branch_target[31:0];

// Include delay slot aspect - handles PC override if we're in a delay slot
aspect delay_slot.isa gates pc, delay_slot;

instr = umem[pc];
assume instr[15:12] == 0x4;
assume instr[7:0] == 0x0A;
rn = instr[11:8];

lds_mach_rn_lo = rn[2:0];
lds_mach_rb = sr[29];  // RB bit (bit 29 in SR)
lds_mach_rn_bk = (rn[3] == 1'b0) & lds_mach_rb;

Rn = lds_mach_rn_bk ? rf_bank[lds_mach_rn_lo] : rf[rn];

// LDS Rm, MACH: copy Rm to MACH
mach = Rn;
pc = pc + 2;
