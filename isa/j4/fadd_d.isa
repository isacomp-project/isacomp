// SPDX-License-Identifier: BSD-3-Clause
// FADD DRm,DRn - Double-precision floating-point add
// DRn = DRn + DRm (when FPSCR.PR=1)
// Encoding: 1111nnn0mmm00000 (0xFnm0) with n,m even
// Double registers: DR0=FR0:FR1, DR2=FR2:FR3, etc.
isa_state pc[31:0];
var instr[15:0];
isa_state fpr[31:0][3:0];
isa_state fpscr[31:0];
mem umem[23:0];

var drn[2:0];
var drm[2:0];
var frn_idx[3:0];
var frm_idx[3:0];
var DRn_hi[31:0];
var DRn_lo[31:0];
var DRm_hi[31:0];
var DRm_lo[31:0];
var DRn[63:0];
var DRm[63:0];
var result[63:0];
var rm[1:0];

isa_state delay_slot[0:0];
isa_state branch_target[31:0];
aspect delay_slot.isa gates pc, delay_slot;

instr = umem[pc];
assume instr[15:12] == 0xF;
assume instr[3:0] == 0x0;
assume instr[8] == 1'b0;
assume instr[4] == 1'b0;

// Extract register indices (bits [11:9] and [7:5] give DR number / 2)
drn = instr[11:9];
drm = instr[7:5];
frn_idx = {drn, 1'b0};  // DR0->FR0, DR2->FR2, etc.
frm_idx = {drm, 1'b0};

// Load double-precision values (big-endian: high word first)
DRn_hi = fpr[frn_idx];
DRn_lo = fpr[frn_idx + 1];
DRm_hi = fpr[frm_idx];
DRm_lo = fpr[frm_idx + 1];

DRn = {DRn_hi, DRn_lo};
DRm = {DRm_hi, DRm_lo};

// Get rounding mode from FPSCR
rm = fpscr[1:0];

// Perform double-precision add
result = fp_add_d(DRn, DRm, rm);

// Store result back
fpr[frn_idx] = result[63:32];
fpr[frn_idx + 1] = result[31:0];

pc = pc + 2;
