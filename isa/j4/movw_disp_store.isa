// SPDX-License-Identifier: BSD-3-Clause
isa_state pc[31:0];
var instr[15:0];
isa_state rf[31:0][3:0];
isa_state rf_bank[31:0][2:0];  // Banked R0-R7 for RB=1
mem umem[23:0];
isa_state t[0:0];

// System registers (needed for exception handling)
isa_state sr[31:0];
isa_state vbr[31:0];
isa_state ssr[31:0];
isa_state spc[31:0];

var rm[3:0];
var disp[3:0];
var disp_ext[31:0];
var Rm[31:0];
var R0[31:0];
var movw_disp_store_addr[31:0];

// Address error checking variables
var store_addr[31:0];
var store_size[1:0];
var movw_disp_store_no_error[0:0];
var halfword_data[15:0];

// Register banking variables (unique to movw_disp_store)
var movw_disp_store_r0_lo[2:0];
var movw_disp_store_rm_lo[2:0];
var movw_disp_store_rb[0:0];
var movw_disp_store_r0_bk[0:0];
var movw_disp_store_rm_bk[0:0];

// Branch delay slot state
isa_state delay_slot[0:0];
isa_state branch_target[31:0];

// Include delay slot aspect - handles PC override if we're in a delay slot
aspect delay_slot.isa gates pc, delay_slot;

// Include exception handling aspect
aspect exception.isa gates pc, sr, vbr, rf, umem, ssr, spc;

// Include address error detection for stores
aspect addr_error_store.isa gates pc, sr, vbr, rf, umem, ssr, spc;

instr = umem[pc];
assume instr[15:8] == 0x81;
rm = instr[7:4];
disp = instr[3:0];

// Register banking setup
movw_disp_store_r0_lo = 3'b000;
movw_disp_store_rm_lo = rm[2:0];
movw_disp_store_rb = sr[29];  // RB bit (bit 29 in SR)
movw_disp_store_r0_bk = movw_disp_store_rb;  // R0[3] is 0
movw_disp_store_rm_bk = (rm[3] == 1'b0) & movw_disp_store_rb;

Rm = movw_disp_store_rm_bk ? rf_bank[movw_disp_store_rm_lo] : rf[rm];
R0 = movw_disp_store_r0_bk ? rf_bank[movw_disp_store_r0_lo] : rf[0];

// MOV.W R0,@(disp,Rn): movw_disp_store_addr = Rn + disp*2
disp_ext = {28'b0, disp};
movw_disp_store_addr = Rm + {disp_ext[30:0], 1'b0};

// Set up address error checking
store_addr = movw_disp_store_addr;
store_size = 2'b10;  // Word access (16-bit)

// Compute the no-error condition
movw_disp_store_no_error = (movw_disp_store_addr[0] == 1'b0);

// Only store if no address error
halfword_data = R0[15:0];
umem[movw_disp_store_addr] when (movw_disp_store_no_error) = halfword_data;

// Only advance PC if no address error
pc when (movw_disp_store_no_error) = pc + 2;
