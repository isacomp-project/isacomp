// SPDX-License-Identifier: BSD-3-Clause
isa_state pc[31:0];
var instr[15:0];
isa_state rf[31:0][3:0];
isa_state rf_bank[31:0][2:0];  // Banked R0-R7 for RB=1
isa_state sr[31:0];
mem umem[23:0];

var rm[3:0];
var disp[3:0];
var Rm[31:0];
var R0[31:0];
var movb_disp_store_addr[31:0];
var byte_data[7:0];

// Register banking variables (unique to movb_disp_store instruction)
var movb_disp_store_r0_lo[2:0];
var movb_disp_store_rm_lo[2:0];
var movb_disp_store_rb[0:0];
var movb_disp_store_rm_bk[0:0];

// Branch delay slot state
isa_state delay_slot[0:0];
isa_state branch_target[31:0];

// Include delay slot aspect - handles PC override if we're in a delay slot
aspect delay_slot.isa gates pc, delay_slot;

instr = umem[pc];
assume instr[15:8] == 0x80;
rm = instr[7:4];
disp = instr[3:0];

// Register banking setup
movb_disp_store_r0_lo = 3'b000;
movb_disp_store_rm_lo = rm[2:0];
movb_disp_store_rb = sr[29];  // RB bit (bit 29 in SR)
movb_disp_store_rm_bk = (rm[3] == 1'b0) & movb_disp_store_rb;

Rm = movb_disp_store_rm_bk ? rf_bank[movb_disp_store_rm_lo] : rf[rm];
R0 = movb_disp_store_rb ? rf_bank[movb_disp_store_r0_lo] : rf[0];

// MOV.B R0,@(disp,Rn): movb_disp_store_addr = Rn + disp (using rm for bits 7:4)
movb_disp_store_addr = Rm + {28'b0, disp};

byte_data = R0[7:0];
umem[movb_disp_store_addr] = byte_data;
pc = pc + 2;
