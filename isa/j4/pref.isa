// SPDX-License-Identifier: BSD-3-Clause
// PREF @Rn - Prefetch Data to Cache
// Prefetches data at address in Rn into operand cache
// Without cache: NOP (just decode and advance PC)
// Encoding: 0000nnnn10000011 (0x0n83)
isa_state pc[31:0];
var instr[15:0];
isa_state rf[31:0][3:0];
isa_state rf_bank[31:0][2:0];
isa_state sr[31:0];
mem umem[23:0];

var rn[3:0];

isa_state delay_slot[0:0];
isa_state branch_target[31:0];
aspect delay_slot.isa gates pc, delay_slot;

instr = umem[pc];
assume instr[15:12] == 0x0;
assume instr[7:0] == 0x83;
rn = instr[11:8];

// No-op for cache-less implementation
// Address in Rn is ignored (could be hint to memory controller)

pc = pc + 2;
