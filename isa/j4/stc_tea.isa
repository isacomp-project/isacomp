// SPDX-License-Identifier: BSD-3-Clause
// STC TEA,Rn - Store TEA to register
// Encoding: 0000nnnn00110101 (0x0n35)
// Read the TLB Exception Address (faulting address)
isa_state pc[31:0];
var instr[15:0];
isa_state rf[31:0][3:0];
isa_state rf_bank[31:0][2:0];
isa_state sr[31:0];
isa_state tea[31:0];
mem umem[23:0];

var rn[3:0];
var stc_tea_rn_lo[2:0];
var stc_tea_rb[0:0];
var stc_tea_rn_bk[0:0];

isa_state delay_slot[0:0];
isa_state branch_target[31:0];
aspect delay_slot.isa gates pc, delay_slot;

instr = umem[pc];
assume instr[15:12] == 0x0;
assume instr[7:0] == 0x35;
rn = instr[11:8];

stc_tea_rn_lo = rn[2:0];
stc_tea_rb = sr[29];  // RB bit (bit 29 in SR)
stc_tea_rn_bk = (rn[3] == 1'b0) & stc_tea_rb;

rf[rn] when (stc_tea_rn_bk == 0) = tea;
rf_bank[stc_tea_rn_lo] when (stc_tea_rn_bk) = tea;
pc = pc + 2;
