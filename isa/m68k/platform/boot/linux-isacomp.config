# M68K Linux Kernel Configuration for ISAComp Platform
# Minimal config for simulation boot testing
#
# Target: MC68030-compatible with MMU
# Peripherals: Goldfish timer, PIC, TTY

# Basic identification
CONFIG_LOCALVERSION="-isacomp"
CONFIG_DEFAULT_HOSTNAME="m68k-isacomp"

# Core settings - minimal
CONFIG_EXPERT=y
# CONFIG_SYSVIPC is not set
# CONFIG_POSIX_MQUEUE is not set
CONFIG_NO_HZ_IDLE=y
# CONFIG_HIGH_RES_TIMERS is not set
CONFIG_PREEMPT_NONE=y
CONFIG_LOG_BUF_SHIFT=14

# M68K Architecture - use VIRT machine as base
CONFIG_MMU=y
CONFIG_M68KCLASSIC=y
CONFIG_M68030=y
CONFIG_VIRT=y
CONFIG_MMU_MOTOROLA=y
# CONFIG_PROC_HARDWARE is not set

# FPU Emulation (required since we don't have hardware FPU)
CONFIG_FPU=y
CONFIG_M68KFPU_EMU=y
CONFIG_M68KFPU_EMU_EXTRAPREC=y
CONFIG_M68KFPU_EMU_ONLY=y

# Memory configuration
CONFIG_SINGLE_MEMORY_CHUNK=y

# Generic clockevents (required by VIRT)
CONFIG_GENERIC_CLOCKEVENTS=y

# Goldfish devices (required by VIRT machine)
CONFIG_GOLDFISH=y
CONFIG_GOLDFISH_TIMER=y
CONFIG_GOLDFISH_TTY=y
CONFIG_GOLDFISH_PIC=y

# Enable early printk
CONFIG_EARLY_PRINTK=y

# Serial/TTY - minimal
CONFIG_TTY=y
CONFIG_SERIAL_CORE=y
CONFIG_SERIAL_CORE_CONSOLE=y

# Enable earlycon
CONFIG_SERIAL_EARLYCON=y

# Disable /proc, /sys, devtmpfs — not needed for minimal init, speeds up boot
# CONFIG_PROC_FS is not set
# CONFIG_SYSFS is not set
# CONFIG_DEVTMPFS is not set

# Embedded initramfs (no external initrd needed)
CONFIG_BLK_DEV_INITRD=y
CONFIG_INITRAMFS_SOURCE="/home/jbalkind/Documents/projects/isacomp-m68k/isacomp/isa/m68k/platform/initramfs/initramfs.cpio"
CONFIG_INITRAMFS_ROOT_UID=0
CONFIG_INITRAMFS_ROOT_GID=0
CONFIG_INITRAMFS_COMPRESSION_NONE=y
# CONFIG_RD_GZIP is not set
# CONFIG_RD_BZIP2 is not set
# CONFIG_RD_LZMA is not set
# CONFIG_RD_XZ is not set
# CONFIG_RD_LZO is not set
# CONFIG_RD_LZ4 is not set
# CONFIG_RD_ZSTD is not set

# No block layer needed
# CONFIG_BLOCK is not set

# No networking needed
# CONFIG_NET is not set

# Disable io_uring (not needed, causes WARN on boot)
# CONFIG_IO_URING is not set

# Disable modules and swap
# CONFIG_MODULES is not set
# CONFIG_SWAP is not set
# CONFIG_COMPAT_BRK is not set
# CONFIG_COMPACTION is not set

# Debugging options
CONFIG_PRINTK=y
CONFIG_BUG=y
CONFIG_DEBUG_KERNEL=y
CONFIG_DEBUG_INFO=y
CONFIG_DEBUG_INFO_DWARF_TOOLCHAIN_DEFAULT=y
CONFIG_FRAME_WARN=1024
CONFIG_PANIC_ON_OOPS=y
CONFIG_PANIC_TIMEOUT=0

# Disable unneeded debug options
# CONFIG_DEBUG_MEMORY_INIT is not set
# CONFIG_SLUB_DEBUG is not set
# CONFIG_SCHEDSTATS is not set
# CONFIG_DEBUG_SPINLOCK is not set
# CONFIG_DEBUG_MUTEXES is not set
# CONFIG_DEBUG_ATOMIC_SLEEP is not set
# CONFIG_STACKTRACE is not set
# CONFIG_FTRACE is not set

# Minimal file systems (no block-based FS needed)
# CONFIG_TMPFS is not set

# Required for boot
CONFIG_BINFMT_ELF=y
# CONFIG_BINFMT_SCRIPT is not set

# Disable unnecessary features
# CONFIG_SOUND is not set
# CONFIG_USB_SUPPORT is not set
# CONFIG_WIRELESS is not set
# CONFIG_VIRTIO_MENU is not set
# CONFIG_VIRTIO_BLK is not set
# CONFIG_SCSI is not set
# CONFIG_ATA is not set
# CONFIG_MD is not set
# CONFIG_NETDEVICES is not set
# CONFIG_INPUT is not set
# CONFIG_SERIO is not set
# CONFIG_VT is not set
# CONFIG_HW_RANDOM is not set
# CONFIG_I2C is not set
# CONFIG_SPI is not set
# CONFIG_GPIO_SYSFS is not set
# CONFIG_HWMON is not set
# CONFIG_THERMAL is not set
# CONFIG_WATCHDOG is not set
# CONFIG_REGULATOR is not set
# CONFIG_FB is not set
# CONFIG_BACKLIGHT_CLASS_DEVICE is not set
# CONFIG_LOGO is not set
# CONFIG_HID is not set
# CONFIG_USB is not set
# CONFIG_NEW_LEDS is not set
# CONFIG_ACCESSIBILITY is not set
# CONFIG_RTC_CLASS is not set
# CONFIG_IOMMU_SUPPORT is not set
# CONFIG_PM is not set
# CONFIG_CRYPTO is not set
# CONFIG_VIRTUALIZATION is not set
# CONFIG_CRC_CCITT is not set
# CONFIG_CRC16 is not set
# CONFIG_CRC32 is not set
# CONFIG_LIBCRC32C is not set
# CONFIG_EXT2_FS is not set
# CONFIG_EXT4_FS is not set
# CONFIG_KALLSYMS is not set
