// SPDX-License-Identifier: BSD-3-Clause
// MC68030 PMOVE to TT1 - Move to Transparent Translation 1
// Opcode: 1111 000 000 mmm rrr followed by extension word
// Extension: 000 0110 0 0000 0000 (0C00) - PMOVE <ea>,TT1

isa_state pc[31:0];
var instr[15:0];
var extw[15:0];
isa_state dregs[31:0][2:0];
isa_state aregs[31:0][2:0];
isa_state imem[15:0][23:0];
mem dmem[23:0];

isa_state sr[15:0];
isa_state tt1[31:0];

isa_state flag_X[0:0];
isa_state flag_N[0:0];
isa_state flag_Z[0:0];
isa_state flag_V[0:0];
isa_state flag_C[0:0];

var ea_mode[2:0];
var ea_reg[2:0];
var addr[31:0];

// Include interrupt and exception handling aspects
aspect ../m68k_exception.isa gates pc, sr, ssp, aregs, dmem, flag_C, flag_N, flag_Z, flag_V, flag_X, usp;
aspect ../m68k_interrupt.isa gates sr;

instr = imem[pc_pa];
assume instr[15:6] == 10'b1111000000;
pc when (~m68k_exc_taken) = pc + 2;

ea_mode = instr[5:3];
ea_reg = instr[2:0];

extw = imem[pc_pa];
assume extw == 16'h0C00;  // PMOVE to TT1
pc when (~m68k_exc_taken) = pc + 2;

assume sr[13] == 1'b1;

assume instr[5:3] == 3'b010;
addr = aregs[ea_reg];

tt1 when (~m68k_exc_taken) = {dmem[addr], dmem[addr + 2]};
