// SPDX-License-Identifier: BSD-3-Clause
// M68000 ADD.B Dn,(d16,An) - Add data register byte to memory with displacement
// Opcode: 1101 DDD1 00 101 AAA + d16 where DDD=data reg, AAA=addr reg
// Opmode 100 = ADD.B Dn,EA (direction: Dn to EA)

isa_state pc[31:0];
var instr[15:0];
isa_state dregs[31:0][2:0];
isa_state aregs[31:0][2:0];
mem dmem[25:0];
#ifdef MMU
// MMU state (added by MMU preprocessor)
isa_state tc[31:0];
isa_state tt0[31:0];
isa_state tt1[31:0];
isa_state crp[63:0];
isa_state srp[63:0];
isa_state vbr[31:0];
isa_state ssp[31:0];
isa_state usp[31:0];
#endif
isa_state flag_X[0:0];
isa_state flag_N[0:0];
isa_state flag_Z[0:0];
isa_state flag_V[0:0];
isa_state flag_C[0:0];

var src_reg[2:0];
var addr_reg[2:0];
var abdad_disp[15:0];
var abdad_disp_ext[31:0];
var eff_addr[31:0];
var mem_word[15:0];
var dst_byte[7:0];
var src_byte[7:0];
var result[8:0];

// Include interrupt and exception handling aspects
aspect m68k_exception.isa gates pc:2, sr:2, ssp:2, aregs:2, dmem:2, flag_C:2, flag_N:2, flag_Z:2, flag_V:2, flag_X:2, usp:2;
aspect m68k_interrupt.isa gates sr;
#ifdef MMU
aspect mmu/atc_translate_instr.isa gates pc, dmem;
#else
var pc_pa[31:0];
pc_pa = pc;
var pc_pa_delta[31:0];
pc_pa_delta = 32'd0;
#endif

// Fetch instruction
instr = dmem[pc_pa];
assume instr[15:12] == 0b1101;  // ADD
assume instr[8:6] == 0b100;     // Opmode: ADD.B Dn,EA
assume instr[5:3] == 0b101;     // EA mode: d(An)
pc when (~m68k_exc_taken) = pc + 2;

// Decode
src_reg = instr[11:9];
addr_reg = instr[2:0];

// Fetch 16-bit displacement
abdad_disp = dmem[pc + pc_pa_delta];
pc when (~m68k_exc_taken) = pc + 2;
abdad_disp_ext = {{16{abdad_disp[15]}}, abdad_disp};

// Calculate effective address
eff_addr = aregs[addr_reg] + abdad_disp_ext;

// Source byte from data register
src_byte = dregs[src_reg][7:0];

// Read destination byte from memory (16-bit dmem, big-endian)
#ifdef MMU
var mmu_va[31:0];
mmu_va = {eff_addr[31:1], 1'b0};
var is_write[0:0];
is_write = 1'b0;
aspect mmu/atc_translate_data.isa gates pc:1, sr:1, ssp:1, aregs:1, dmem:1, flag_C:1, flag_N:1, flag_Z:1, flag_V:1, flag_X:1, usp:1;
#endif

#ifdef MMU
mem_word = dmem[ea_pa];
#else
mem_word = dmem[{eff_addr[31:1], 1'b0}];
#endif
dst_byte = eff_addr[0] ? mem_word[7:0] : mem_word[15:8];

// Execute byte add
result = dst_byte + src_byte;

// Write result byte back (preserve other byte in word)
#ifdef MMU
dmem[ea_pa] when (~m68k_exc_taken & ~data_exc_taken) = eff_addr[0] ? {mem_word[15:8], result[7:0]} : {result[7:0], mem_word[7:0]};
#else
dmem[{eff_addr[31:1], 1'b0}] when (~m68k_exc_taken & ~data_exc_taken) = eff_addr[0] ? {mem_word[15:8], result[7:0]} : {result[7:0], mem_word[7:0]};
#endif

// Update CCR
flag_X when (~m68k_exc_taken & ~data_exc_taken) = result[8];
flag_C when (~m68k_exc_taken & ~data_exc_taken) = result[8];
flag_V when (~m68k_exc_taken & ~data_exc_taken) = (~dst_byte[7] & ~src_byte[7] & result[7]) | (dst_byte[7] & src_byte[7] & ~result[7]);
flag_Z when (~m68k_exc_taken & ~data_exc_taken) = result[7:0] == 0;
flag_N when (~m68k_exc_taken & ~data_exc_taken) = result[7];
