// SPDX-License-Identifier: BSD-3-Clause
// M68000 MOVEA.L (An)+,An - Move long from memory with post-increment to address register
// Opcode: 0010 DDD0 01011 SSS where DDD=dest addr reg, SSS=src addr reg
// This is commonly used as a stack pop: MOVEA.L (A7)+,An

isa_state pc[31:0];
var instr[15:0];
isa_state dregs[31:0][2:0];
isa_state aregs[31:0][2:0];
mem dmem[25:0];
#ifdef MMU
// MMU state (added by MMU preprocessor)
isa_state tc[31:0];
isa_state tt0[31:0];
isa_state tt1[31:0];
isa_state crp[63:0];
isa_state srp[63:0];
isa_state vbr[31:0];
isa_state ssp[31:0];
isa_state usp[31:0];
#endif
isa_state flag_X[0:0];
isa_state flag_N[0:0];
isa_state flag_Z[0:0];
isa_state flag_V[0:0];
isa_state flag_C[0:0];

var dst_reg[2:0];
var src_reg[2:0];
var addr[31:0];
var val_hi[15:0];
var val_lo[15:0];
var val[31:0];

// Include interrupt and exception handling aspects
aspect m68k_exception.isa gates pc:2, sr:2, ssp:2, aregs:2, dmem:2, flag_C:2, flag_N:2, flag_Z:2, flag_V:2, flag_X:2, usp:2;
aspect m68k_interrupt.isa gates sr;
#ifdef MMU
aspect mmu/atc_translate_instr.isa gates pc, dmem;
#else
var pc_pa[31:0];
pc_pa = pc;
var pc_pa_delta[31:0];
pc_pa_delta = 32'd0;
#endif

// Fetch instruction
instr = dmem[pc_pa];
assume instr[15:12] == 0b0010;  // MOVE.L opcode
assume instr[8:6] == 0b001;     // Destination mode: Address Register Direct (MOVEA)
assume instr[5:3] == 0b011;     // Source mode: Address Register Indirect with Postincrement
pc when (~m68k_exc_taken) = pc + 2;

// Decode
dst_reg = instr[11:9];
src_reg = instr[2:0];

// Read source from memory (two 16-bit reads, big-endian)
addr = aregs[src_reg];
#ifdef MMU
var mmu_va[31:0];
mmu_va = addr;
var is_write[0:0];
is_write = 1'b0;
aspect mmu/atc_translate_data.isa gates pc:1, sr:1, ssp:1, aregs:1, dmem:1, flag_C:1, flag_N:1, flag_Z:1, flag_V:1, flag_X:1, usp:1;
#endif

#ifdef MMU
val_hi = dmem[ea_pa];
#else
val_hi = dmem[addr];
#endif
#ifdef MMU
val_lo = dmem[ea_pa + 2];
#else
val_lo = dmem[addr + 2];
#endif
val = {val_hi, val_lo};

// Post-increment source address register by 4 (long word)
aregs[src_reg] when (~m68k_exc_taken & ~data_exc_taken) = addr + 4;

// Write to destination address register
aregs[dst_reg] when (~m68k_exc_taken & ~data_exc_taken) = val;

// MOVEA does not affect condition codes
