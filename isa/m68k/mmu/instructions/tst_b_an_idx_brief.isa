// SPDX-License-Identifier: BSD-3-Clause
// M68000 TST.B (d8,An,Xn) - Test byte at brief indexed address
// Opcode: 0100 1010 00 110 AAA followed by brief extension word

isa_state pc[31:0];
var instr[15:0];
isa_state dregs[31:0][2:0];
isa_state aregs[31:0][2:0];
mem dmem[25:0];
#ifdef MMU
// MMU state (added by MMU preprocessor)
isa_state tc[31:0];
isa_state tt0[31:0];
isa_state tt1[31:0];
isa_state crp[63:0];
isa_state srp[63:0];
isa_state vbr[31:0];
isa_state ssp[31:0];
isa_state usp[31:0];
#endif
isa_state flag_X[0:0];
isa_state flag_N[0:0];
isa_state flag_Z[0:0];
isa_state flag_V[0:0];
isa_state flag_C[0:0];

var base_reg[2:0];
var tbix_ext[15:0];
var tbix_idx_is_areg[0:0];
var idx_reg[2:0];
var tbix_idx_is_long[0:0];
var tbix_scale[1:0];
var tbix_disp8[7:0];
var tbix_disp_ext[31:0];
var tbix_idx_raw[31:0];
var tbix_idx_val[31:0];
var tbix_scaled_idx[31:0];
var tbix_addr[31:0];
var tbix_word[15:0];
var tbix_val[7:0];

// Include interrupt and exception handling aspects
aspect m68k_exception.isa gates pc:2, sr:2, ssp:2, aregs:2, dmem:2, flag_C:2, flag_N:2, flag_Z:2, flag_V:2, flag_X:2, usp:2;
aspect m68k_interrupt.isa gates sr;
#ifdef MMU
aspect mmu/atc_translate_instr.isa gates pc, dmem;
#else
var pc_pa[31:0];
pc_pa = pc;
var pc_pa_delta[31:0];
pc_pa_delta = 32'd0;
#endif

// Fetch instruction
instr = dmem[pc_pa];
assume instr[15:8] == 0b01001010;  // TST
assume instr[7:6] == 0b00;         // Byte
assume instr[5:3] == 0b110;        // EA mode: indexed
pc when (~m68k_exc_taken) = pc + 2;

base_reg = instr[2:0];

// Fetch brief extension word
tbix_ext = dmem[pc + pc_pa_delta];
assume tbix_ext[8] == 0b0;  // Brief format
pc when (~m68k_exc_taken) = pc + 2;

// Decode extension word
tbix_idx_is_areg = tbix_ext[15];
idx_reg = tbix_ext[14:12];
tbix_idx_is_long = tbix_ext[11];
tbix_scale = tbix_ext[10:9];
tbix_disp8 = tbix_ext[7:0];

// Sign-extend displacement
tbix_disp_ext = {{24{tbix_disp8[7]}}, tbix_disp8};

// Get index value
tbix_idx_raw = tbix_idx_is_areg ? aregs[idx_reg] : dregs[idx_reg];
tbix_idx_val = tbix_idx_is_long ? tbix_idx_raw : (tbix_idx_raw[15] ? {16'hFFFF, tbix_idx_raw[15:0]} : {16'h0000, tbix_idx_raw[15:0]});

// Apply scale factor
tbix_scaled_idx = tbix_scale == 0 ? tbix_idx_val :
                  tbix_scale == 1 ? (tbix_idx_val << 1) :
                  tbix_scale == 2 ? (tbix_idx_val << 2) :
                                    (tbix_idx_val << 3);

// Calculate effective address
tbix_addr = aregs[base_reg] + tbix_disp_ext + tbix_scaled_idx;

// MMU translate for read
#ifdef MMU
var mmu_va[31:0];
mmu_va = tbix_addr;
var is_write[0:0];
is_write = 1'b0;
aspect mmu/atc_translate_data.isa gates pc:1, sr:1, ssp:1, aregs:1, dmem:1, flag_C:1, flag_N:1, flag_Z:1, flag_V:1, flag_X:1, usp:1;
#endif

// Read word and extract byte (big-endian)
#ifdef MMU
tbix_word = dmem[{ea_pa[31:1], 1'b0}];
#else
tbix_word = dmem[{tbix_addr[31:1], 1'b0}];
#endif
tbix_val = tbix_addr[0] ? tbix_word[7:0] : tbix_word[15:8];

// Update flags
flag_N when (~m68k_exc_taken & ~data_exc_taken) = tbix_val[7];
flag_Z when (~m68k_exc_taken & ~data_exc_taken) = tbix_val == 0;
flag_V when (~m68k_exc_taken & ~data_exc_taken) = 1'b0;
flag_C when (~m68k_exc_taken & ~data_exc_taken) = 1'b0;
