// SPDX-License-Identifier: BSD-3-Clause
// M68000 ADDQ.W #data,(d16,An) - Add quick word to memory displacement
// Opcode: 0101 DDD0 01 101 AAA + 16-bit displacement

isa_state pc[31:0];
var instr[15:0];
isa_state dregs[31:0][2:0];
isa_state aregs[31:0][2:0];
mem dmem[25:0];
#ifdef MMU
// MMU state (added by MMU preprocessor)
isa_state tc[31:0];
isa_state tt0[31:0];
isa_state tt1[31:0];
isa_state crp[63:0];
isa_state srp[63:0];
isa_state vbr[31:0];
isa_state ssp[31:0];
isa_state usp[31:0];
#endif
isa_state flag_X[0:0];
isa_state flag_N[0:0];
isa_state flag_Z[0:0];
isa_state flag_V[0:0];
isa_state flag_C[0:0];

var aqwd_qdata[2:0];
var aqwd_imm[15:0];
var aqwd_reg[2:0];
var aqwd_disp[15:0];
var aqwd_disp_ext[31:0];
var aqwd_addr[31:0];
var aqwd_dst[15:0];
var aqwd_result[16:0];

aspect m68k_exception.isa gates pc:2, sr:2, ssp:2, aregs:2, dmem:2, flag_C:2, flag_N:2, flag_Z:2, flag_V:2, flag_X:2, usp:2;
aspect m68k_interrupt.isa gates sr;
#ifdef MMU
aspect mmu/atc_translate_instr.isa gates pc, dmem;
#else
var pc_pa[31:0];
pc_pa = pc;
var pc_pa_delta[31:0];
pc_pa_delta = 32'd0;
#endif

instr = dmem[pc_pa];
assume instr[15:12] == 0b0101;
assume instr[8] == 0b0;         // ADDQ
assume instr[7:6] == 0b01;      // Word size
assume instr[5:3] == 0b101;     // EA: (d16,An)
pc when (~m68k_exc_taken) = pc + 2;

aqwd_qdata = instr[11:9];
aqwd_reg = instr[2:0];
aqwd_imm = aqwd_qdata == 0 ? 16'h0008 : {13'b0, aqwd_qdata};

aqwd_disp = dmem[pc + pc_pa_delta];
pc when (~m68k_exc_taken) = pc + 2;
aqwd_disp_ext = {{16{aqwd_disp[15]}}, aqwd_disp};
aqwd_addr = aregs[aqwd_reg] + aqwd_disp_ext;

#ifdef MMU
var mmu_va[31:0];
mmu_va = aqwd_addr;
var is_write[0:0];
is_write = 1'b1;
aspect mmu/atc_translate_data.isa gates pc:1, sr:1, ssp:1, aregs:1, dmem:1, flag_C:1, flag_N:1, flag_Z:1, flag_V:1, flag_X:1, usp:1;
#endif

#ifdef MMU
aqwd_dst = dmem[ea_pa];
#else
aqwd_dst = dmem[aqwd_addr];
#endif
aqwd_result = aqwd_dst + aqwd_imm;
#ifdef MMU
dmem[ea_pa] when (~m68k_exc_taken & ~data_exc_taken) = aqwd_result[15:0];
#else
dmem[aqwd_addr] when (~m68k_exc_taken & ~data_exc_taken) = aqwd_result[15:0];
#endif

flag_X when (~m68k_exc_taken & ~data_exc_taken) = aqwd_result[16];
flag_C when (~m68k_exc_taken & ~data_exc_taken) = aqwd_result[16];
flag_V when (~m68k_exc_taken & ~data_exc_taken) = (~aqwd_dst[15] & ~aqwd_imm[15] & aqwd_result[15]) | (aqwd_dst[15] & aqwd_imm[15] & ~aqwd_result[15]);
flag_Z when (~m68k_exc_taken & ~data_exc_taken) = aqwd_result[15:0] == 0;
flag_N when (~m68k_exc_taken & ~data_exc_taken) = aqwd_result[15];
