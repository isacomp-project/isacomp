// SPDX-License-Identifier: BSD-3-Clause
// M68000 CMP.L (d8,PC,Xn),Dn - Compare long, PC-relative brief indexed source
// Opcode: 1011 DDD 010 111 011 + brief extension word

isa_state pc[31:0];
var instr[15:0];
isa_state dregs[31:0][2:0];
isa_state aregs[31:0][2:0];
mem dmem[25:0];
#ifdef MMU
// MMU state (added by MMU preprocessor)
isa_state tc[31:0];
isa_state tt0[31:0];
isa_state tt1[31:0];
isa_state crp[63:0];
isa_state srp[63:0];
isa_state vbr[31:0];
isa_state ssp[31:0];
isa_state usp[31:0];
#endif
isa_state flag_X[0:0];
isa_state flag_N[0:0];
isa_state flag_Z[0:0];
isa_state flag_V[0:0];
isa_state flag_C[0:0];

var dn_reg[2:0];
var clpib_ext[15:0];
var clpib_disp8[7:0];
var clpib_disp8_ext[31:0];
var clpib_idx_reg[2:0];
var clpib_idx_is_addr[0:0];
var clpib_idx_is_long[0:0];
var clpib_scale[1:0];
var clpib_raw_idx[31:0];
var clpib_idx_val[31:0];
var clpib_scaled_idx[31:0];
var clpib_base_pc[31:0];
var clpib_addr[31:0];
var clpib_data_hi[15:0];
var clpib_data_lo[15:0];
var clpib_src[31:0];
var clpib_dst[31:0];
var clpib_result[31:0];

// Include interrupt and exception handling aspects
aspect m68k_exception.isa gates pc:2, sr:2, ssp:2, aregs:2, dmem:2, flag_C:2, flag_N:2, flag_Z:2, flag_V:2, flag_X:2, usp:2;
aspect m68k_interrupt.isa gates sr;
#ifdef MMU
aspect mmu/atc_translate_instr.isa gates pc, dmem;
#else
var pc_pa[31:0];
pc_pa = pc;
var pc_pa_delta[31:0];
pc_pa_delta = 32'd0;
#endif

// Fetch instruction
instr = dmem[pc_pa];
assume instr[15:12] == 0b1011;  // CMP
assume instr[8:6] == 0b010;     // Opmode: CMP.L
assume instr[5:3] == 0b111;     // EA mode: special
assume instr[2:0] == 0b011;     // PC with index
pc when (~m68k_exc_taken) = pc + 32'd2;

dn_reg = instr[11:9];

// Save PC for base address (points to extension word = opcode + 2)
clpib_base_pc = pc;

// Fetch brief extension word
clpib_ext = dmem[pc + pc_pa_delta];
assume clpib_ext[8] == 0b0;  // Brief format
pc when (~m68k_exc_taken) = pc + 32'd2;

// Decode extension
clpib_idx_reg = clpib_ext[14:12];
clpib_idx_is_addr = clpib_ext[15];
clpib_idx_is_long = clpib_ext[11];
clpib_scale = clpib_ext[10:9];
clpib_disp8 = clpib_ext[7:0];
clpib_disp8_ext = {{24{clpib_disp8[7]}}, clpib_disp8};

// Get index value
clpib_raw_idx = clpib_idx_is_addr ? aregs[clpib_idx_reg] : dregs[clpib_idx_reg];
clpib_idx_val = clpib_idx_is_long ? clpib_raw_idx : {{16{clpib_raw_idx[15]}}, clpib_raw_idx[15:0]};

// Scale index
clpib_scaled_idx = clpib_scale == 2'b00 ? clpib_idx_val :
                   clpib_scale == 2'b01 ? (clpib_idx_val << 1) :
                   clpib_scale == 2'b10 ? (clpib_idx_val << 2) :
                                          (clpib_idx_val << 3);

// Calculate address: PC (at extension word) + d8 + scaled index
clpib_addr = clpib_base_pc + clpib_disp8_ext + clpib_scaled_idx;
#ifdef MMU
var mmu_va[31:0];
mmu_va = clpib_addr;
var is_write[0:0];
is_write = 1'b0;
aspect mmu/atc_translate_data.isa gates pc:1, sr:1, ssp:1, aregs:1, dmem:1, flag_C:1, flag_N:1, flag_Z:1, flag_V:1, flag_X:1, usp:1;
#endif

#ifdef MMU
clpib_data_hi = dmem[ea_pa];
#else
clpib_data_hi = dmem[clpib_addr];
#endif
#ifdef MMU
clpib_data_lo = dmem[ea_pa + 32'd2];
#else
clpib_data_lo = dmem[clpib_addr + 32'd2];
#endif
clpib_src = {clpib_data_hi, clpib_data_lo};
clpib_dst = dregs[dn_reg];
clpib_result = clpib_dst - clpib_src;

// Update CCR (X not affected)
flag_N when (~m68k_exc_taken & ~data_exc_taken) = clpib_result[31];
flag_Z when (~m68k_exc_taken & ~data_exc_taken) = clpib_result == 0;
flag_V when (~m68k_exc_taken & ~data_exc_taken) = (~clpib_src[31] & clpib_dst[31] & ~clpib_result[31]) | (clpib_src[31] & ~clpib_dst[31] & clpib_result[31]);
flag_C when (~m68k_exc_taken & ~data_exc_taken) = clpib_src > clpib_dst;
