// SPDX-License-Identifier: BSD-3-Clause
// M68000 SUBI.W #imm,Dn - Subtract Immediate Word from Data Register
// Opcode: 0000 0100 01 000 DDD followed by 16-bit immediate
// Subtracts immediate word from low word of Dn

isa_state pc[31:0];
var instr[15:0];
isa_state dregs[31:0][2:0];
isa_state aregs[31:0][2:0];
mem dmem[25:0];
isa_state flag_X[0:0];
isa_state flag_N[0:0];
isa_state flag_Z[0:0];
isa_state flag_V[0:0];
isa_state flag_C[0:0];

var dst_reg[2:0];
var imm16[15:0];
var src[15:0];
var dst_val[31:0];
var result[16:0];

// Include interrupt and exception handling aspects
aspect m68k_exception.isa gates pc:2, sr:2, ssp:2, aregs:2, dmem:2, flag_C:2, flag_N:2, flag_Z:2, flag_V:2, flag_X:2, usp:2;
aspect m68k_interrupt.isa gates sr;
#ifdef MMU
aspect mmu/atc_translate_instr.isa gates pc, dmem;
#else
var pc_pa[31:0];
pc_pa = pc;
var pc_pa_delta[31:0];
pc_pa_delta = 32'd0;
#endif

// Fetch instruction
instr = dmem[pc_pa];
assume instr[15:8] == 0b00000100;  // SUBI opcode
assume instr[7:6] == 0b01;          // Size: word
assume instr[5:3] == 0b000;         // EA mode: Data Register Direct
pc when (~m68k_exc_taken) = pc + 2;

// Decode destination register
dst_reg = instr[2:0];

// Fetch 16-bit immediate
imm16 = dmem[pc + pc_pa_delta];
pc when (~m68k_exc_taken) = pc + 2;

// Read source word from register
dst_val = dregs[dst_reg];
src = dst_val[15:0];

// Execute SUBTRACT
result = src - imm16;

// Write result (only low word changes, upper 16 bits unchanged)
dregs[dst_reg] when (~m68k_exc_taken) = {dst_val[31:16], result[15:0]};

// Update CCR
flag_X when (~m68k_exc_taken) = imm16 > src;
flag_C when (~m68k_exc_taken) = imm16 > src;
flag_V when (~m68k_exc_taken) = (src[15] & ~imm16[15] & ~result[15]) | (~src[15] & imm16[15] & result[15]);
flag_Z when (~m68k_exc_taken) = result[15:0] == 0;
flag_N when (~m68k_exc_taken) = result[15];
