// SPDX-License-Identifier: BSD-3-Clause
// M68000 NEGX.B Dn - Negate with Extend Byte
// Opcode: 0100 0000 00 000 DDD where DDD=reg
// Operation: 0 - Dn[7:0] - X -> Dn[7:0] (byte only, preserves upper bits)
// Special: Z flag is only cleared if result is non-zero (not set if zero)

isa_state pc[31:0];
var instr[15:0];
isa_state dregs[31:0][2:0];
isa_state aregs[31:0][2:0];
mem dmem[25:0];
isa_state flag_X[0:0];
isa_state flag_N[0:0];
isa_state flag_Z[0:0];
isa_state flag_V[0:0];
isa_state flag_C[0:0];

// Byte sub-registers using 'of' keyword
isa_state dregs_negxb[7:0][2:0] of dregs[0b***][7:0];

var negxb_dst_reg[2:0];
var negxb_src_val[7:0];
var negxb_x_val[7:0];
var negxb_result[8:0];
var negxb_old_z[0:0];

// Include interrupt and exception handling aspects
aspect m68k_exception.isa gates pc:2, sr:2, ssp:2, aregs:2, dmem:2, flag_C:2, flag_N:2, flag_Z:2, flag_V:2, flag_X:2, usp:2;
aspect m68k_interrupt.isa gates sr;
#ifdef MMU
aspect mmu/atc_translate_instr.isa gates pc, dmem;
#else
var pc_pa[31:0];
pc_pa = pc;
var pc_pa_delta[31:0];
pc_pa_delta = 32'd0;
#endif

// Fetch instruction
instr = dmem[pc_pa];
assume instr[15:8] == 0b01000000;  // NEGX opcode
assume instr[7:6] == 0b00;         // Size: byte
assume instr[5:3] == 0b000;        // EA mode: Data Register Direct
pc when (~m68k_exc_taken) = pc + 2;

// Decode
negxb_dst_reg = instr[2:0];

// Save old Z flag for special Z handling
negxb_old_z = flag_Z;

// Execute: 0 - destination - X (byte)
negxb_src_val = dregs_negxb[negxb_dst_reg];
negxb_x_val = flag_X;
negxb_result = 0 - negxb_src_val - negxb_x_val;

// Write result (byte only, upper bits preserved via 'of')
dregs_negxb[negxb_dst_reg] when (~m68k_exc_taken) = negxb_result[7:0];

// Update CCR
// X and C: Set if there was a borrow (source or X non-zero)
flag_X when (~m68k_exc_taken) = (negxb_src_val != 0) | (negxb_x_val != 0);
flag_C when (~m68k_exc_taken) = (negxb_src_val != 0) | (negxb_x_val != 0);

// V: Overflow for byte NEGX
flag_V when (~m68k_exc_taken) = ((negxb_src_val + negxb_x_val) == 8'h80);

// Z: Special handling - only CLEARED if result is non-zero, not set if zero
flag_Z when (~m68k_exc_taken) = negxb_old_z & (negxb_result[7:0] == 0);

// N: Sign of result
flag_N when (~m68k_exc_taken) = negxb_result[7];
