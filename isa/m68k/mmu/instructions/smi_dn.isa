// SPDX-License-Identifier: BSD-3-Clause
// M68000 SMI Dn - Set byte if minus
// Opcode: 0101 1011 11000 DDD where DDD=register
// Sets byte to $FF if N, $00 otherwise

isa_state pc[31:0];
var instr[15:0];
isa_state dregs[31:0][2:0];
isa_state aregs[31:0][2:0];
mem dmem[25:0];
isa_state flag_X[0:0];
isa_state flag_N[0:0];
isa_state flag_Z[0:0];
isa_state flag_V[0:0];
isa_state flag_C[0:0];

var dst_reg[2:0];
var result[7:0];

// Include interrupt and exception handling aspects
aspect m68k_exception.isa gates pc:2, sr:2, ssp:2, aregs:2, dmem:2, flag_C:2, flag_N:2, flag_Z:2, flag_V:2, flag_X:2, usp:2;
aspect m68k_interrupt.isa gates sr;
#ifdef MMU
aspect mmu/atc_translate_instr.isa gates pc, dmem;
#else
var pc_pa[31:0];
pc_pa = pc;
var pc_pa_delta[31:0];
pc_pa_delta = 32'd0;
#endif

// Fetch instruction
instr = dmem[pc_pa];
assume instr[15:12] == 0b0101;    // Scc opcode
assume instr[11:8] == 0b1011;     // SMI condition (N)
assume instr[7:6] == 0b11;        // Scc encoding
assume instr[5:3] == 0b000;       // EA mode: Data Register Direct
pc when (~m68k_exc_taken) = pc + 2;

// Decode
dst_reg = instr[2:0];

// Execute - set byte based on condition
result = flag_N ? 8'hFF : 8'h00;

// Write result (only affects low byte)
dregs[dst_reg] when (~m68k_exc_taken) = {dregs[dst_reg][31:8], result};

// Scc does not affect flags
