// SPDX-License-Identifier: BSD-3-Clause
// M68000 JMP (d8,An,Xn) - Jump with indexed addressing (brief format)
// Opcode: 0100 1110 11 110 AAA followed by brief extension word

isa_state pc[31:0];
var instr[15:0];
isa_state dregs[31:0][2:0];
isa_state aregs[31:0][2:0];
mem dmem[25:0];
isa_state flag_X[0:0];
isa_state flag_N[0:0];
isa_state flag_Z[0:0];
isa_state flag_V[0:0];
isa_state flag_C[0:0];

var jmp_ix_reg[2:0];
var jmp_ix_ext[15:0];
var idx_reg[2:0];
var jmp_ix_idx_is_addr[0:0];
var jmp_ix_idx_is_long[0:0];
var jmp_ix_scale[1:0];
var jmp_ix_disp8[7:0];
var jmp_ix_disp_ext[31:0];
var jmp_ix_raw_idx[31:0];
var jmp_ix_idx_val[31:0];
var jmp_ix_scaled_idx[31:0];
var jmp_ix_target[31:0];

// Include interrupt and exception handling aspects
aspect m68k_exception.isa gates pc:2, sr:2, ssp:2, aregs:2, dmem:2, flag_C:2, flag_N:2, flag_Z:2, flag_V:2, flag_X:2, usp:2;
aspect m68k_interrupt.isa gates sr;
#ifdef MMU
aspect mmu/atc_translate_instr.isa gates pc, dmem;
#else
var pc_pa[31:0];
pc_pa = pc;
var pc_pa_delta[31:0];
pc_pa_delta = 32'd0;
#endif

// Fetch instruction
instr = dmem[pc_pa];
assume instr[15:6] == 0b0100111011;  // JMP opcode
assume instr[5:3] == 0b110;          // EA mode: indexed
pc when (~m68k_exc_taken) = pc + 2;

// Decode base register
jmp_ix_reg = instr[2:0];

// Fetch extension word
jmp_ix_ext = dmem[pc + pc_pa_delta];
assume jmp_ix_ext[8] == 0b0;  // Brief format
pc when (~m68k_exc_taken) = pc + 2;

// Decode extension word
idx_reg = jmp_ix_ext[14:12];
jmp_ix_idx_is_addr = jmp_ix_ext[15];
jmp_ix_idx_is_long = jmp_ix_ext[11];
jmp_ix_scale = jmp_ix_ext[10:9];
jmp_ix_disp8 = jmp_ix_ext[7:0];
jmp_ix_disp_ext = {{24{jmp_ix_disp8[7]}}, jmp_ix_disp8};

// Get index register value
jmp_ix_raw_idx = jmp_ix_idx_is_addr ? aregs[idx_reg] : dregs[idx_reg];
jmp_ix_idx_val = jmp_ix_idx_is_long ? jmp_ix_raw_idx : {{16{jmp_ix_raw_idx[15]}}, jmp_ix_raw_idx[15:0]};

// Apply scale
jmp_ix_scaled_idx = jmp_ix_scale == 2'b00 ? jmp_ix_idx_val :
                    jmp_ix_scale == 2'b01 ? (jmp_ix_idx_val << 1) :
                    jmp_ix_scale == 2'b10 ? (jmp_ix_idx_val << 2) :
                                            (jmp_ix_idx_val << 3);

// Calculate target address
jmp_ix_target = aregs[jmp_ix_reg] + jmp_ix_disp_ext + jmp_ix_scaled_idx;

// Jump to target
pc when (~m68k_exc_taken) = jmp_ix_target;

// JMP does not affect flags
