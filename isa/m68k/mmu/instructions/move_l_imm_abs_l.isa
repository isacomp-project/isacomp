// SPDX-License-Identifier: BSD-3-Clause
// M68000 MOVE.L #imm,(xxx).L - Move immediate long to absolute long address
// Opcode: 0010 001 111 111 100 (0x23fc)
// Followed by 32-bit immediate value, then 32-bit destination address
// Total: 10 bytes

isa_state pc[31:0];
var instr[15:0];
isa_state dregs[31:0][2:0];
isa_state aregs[31:0][2:0];
mem dmem[25:0];
#ifdef MMU
// MMU state (added by MMU preprocessor)
isa_state tc[31:0];
isa_state tt0[31:0];
isa_state tt1[31:0];
isa_state crp[63:0];
isa_state srp[63:0];
isa_state vbr[31:0];
isa_state ssp[31:0];
isa_state usp[31:0];
#endif
isa_state flag_X[0:0];
isa_state flag_N[0:0];
isa_state flag_Z[0:0];
isa_state flag_V[0:0];
isa_state flag_C[0:0];

var imm_hi[15:0];
var imm_lo[15:0];
var imm_val[31:0];
var dst_addr_hi[15:0];
var dst_addr_lo[15:0];
var dst_addr[31:0];

// Include interrupt and exception handling aspects
aspect m68k_exception.isa gates pc:2, sr:2, ssp:2, aregs:2, dmem:2, flag_C:2, flag_N:2, flag_Z:2, flag_V:2, flag_X:2, usp:2;
aspect m68k_interrupt.isa gates sr;
#ifdef MMU
aspect mmu/atc_translate_instr.isa gates pc, dmem;
#else
var pc_pa[31:0];
pc_pa = pc;
var pc_pa_delta[31:0];
pc_pa_delta = 32'd0;
#endif

// Fetch instruction
instr = dmem[pc_pa];
assume instr[15:12] == 0b0010;  // MOVE.L opcode
assume instr[11:9] == 0b001;    // Destination register (abs long indicator)
assume instr[8:6] == 0b111;     // Destination mode: Absolute/Special
assume instr[5:3] == 0b111;     // Source mode: Absolute/Special
assume instr[2:0] == 0b100;     // Source: Immediate
pc when (~m68k_exc_taken) = pc + 2;

// Fetch 32-bit immediate value (big-endian)
imm_hi = dmem[pc + pc_pa_delta];
pc when (~m68k_exc_taken) = pc + 2;
imm_lo = dmem[pc + pc_pa_delta];
pc when (~m68k_exc_taken) = pc + 2;
imm_val = {imm_hi, imm_lo};

// Fetch destination absolute address (32-bit, big-endian)
dst_addr_hi = dmem[pc + pc_pa_delta];
pc when (~m68k_exc_taken) = pc + 2;
dst_addr_lo = dmem[pc + pc_pa_delta];
pc when (~m68k_exc_taken) = pc + 2;
dst_addr = {dst_addr_hi, dst_addr_lo};

// Write to destination (two 16-bit writes for 32-bit value, big-endian)
#ifdef MMU
var mmu_va[31:0];
mmu_va = dst_addr;
var is_write[0:0];
is_write = 1'b1;
aspect mmu/atc_translate_data.isa gates pc:1, sr:1, ssp:1, aregs:1, dmem:1, flag_C:1, flag_N:1, flag_Z:1, flag_V:1, flag_X:1, usp:1;
#endif

#ifdef MMU
dmem[ea_pa] when (~m68k_exc_taken & ~data_exc_taken) = imm_val[31:16];
#else
dmem[dst_addr] when (~m68k_exc_taken & ~data_exc_taken) = imm_val[31:16];
#endif
#ifdef MMU
dmem[ea_pa + 2] when (~m68k_exc_taken & ~data_exc_taken) = imm_val[15:0];
#else
dmem[dst_addr + 2] when (~m68k_exc_taken & ~data_exc_taken) = imm_val[15:0];
#endif

// Update CCR
flag_N when (~m68k_exc_taken & ~data_exc_taken) = imm_val[31];
flag_Z when (~m68k_exc_taken & ~data_exc_taken) = imm_val == 0;
flag_V when (~m68k_exc_taken & ~data_exc_taken) = 1'b0;
flag_C when (~m68k_exc_taken & ~data_exc_taken) = 1'b0;
