// SPDX-License-Identifier: BSD-3-Clause
// M68000 CMPA.W Dn,An - Compare word from data register with address register
// Opcode: 1011 AAA 011 000 DDD where AAA=addr reg, DDD=src data reg
// Source word is sign-extended to 32 bits, then An - sign_extend(Dn) as 32-bit subtract
// Flags set from 32-bit result; X not affected

isa_state pc[31:0];
var instr[15:0];
isa_state dregs[31:0][2:0];
isa_state aregs[31:0][2:0];
mem dmem[25:0];
isa_state flag_X[0:0];
isa_state flag_N[0:0];
isa_state flag_Z[0:0];
isa_state flag_V[0:0];
isa_state flag_C[0:0];

var dst_reg[2:0];
var src_reg[2:0];
var cmpaw_src_word[15:0];
var cmpaw_src_val[31:0];
var cmpaw_dst_val[31:0];
var cmpaw_result[32:0];

// Include interrupt and exception handling aspects
aspect m68k_exception.isa gates pc:2, sr:2, ssp:2, aregs:2, dmem:2, flag_C:2, flag_N:2, flag_Z:2, flag_V:2, flag_X:2, usp:2;
aspect m68k_interrupt.isa gates sr;
#ifdef MMU
aspect mmu/atc_translate_instr.isa gates pc, dmem;
#else
var pc_pa[31:0];
pc_pa = pc;
var pc_pa_delta[31:0];
pc_pa_delta = 32'd0;
#endif

// Fetch instruction
instr = dmem[pc_pa];
assume instr[15:12] == 0b1011;  // CMPA opcode
assume instr[8:6] == 0b011;     // Opmode: CMPA.W
assume instr[5:3] == 0b000;     // EA mode: Data Register Direct
pc when (~m68k_exc_taken) = pc + 2;

// Decode
dst_reg = instr[11:9];
src_reg = instr[2:0];

// Get source word from data register and sign-extend to 32 bits
cmpaw_src_word = dregs[src_reg][15:0];
cmpaw_src_val = cmpaw_src_word[15] ? {16'hFFFF, cmpaw_src_word} : {16'h0000, cmpaw_src_word};

// Execute: An - sign_extend(Dn) (32-bit subtraction, result not stored)
cmpaw_dst_val = aregs[dst_reg];
cmpaw_result = cmpaw_dst_val - cmpaw_src_val;

// Update CCR (X not affected by CMPA)
flag_C when (~m68k_exc_taken) = cmpaw_src_val > cmpaw_dst_val;
flag_V when (~m68k_exc_taken) = (~cmpaw_dst_val[31] & cmpaw_src_val[31] & cmpaw_result[31]) | (cmpaw_dst_val[31] & ~cmpaw_src_val[31] & ~cmpaw_result[31]);
flag_Z when (~m68k_exc_taken) = cmpaw_result[31:0] == 0;
flag_N when (~m68k_exc_taken) = cmpaw_result[31];
