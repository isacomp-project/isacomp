// SPDX-License-Identifier: BSD-3-Clause
// M68000 ROL.L Dc,Dn - Rotate left long by register count
// Opcode: 1110 CCC1 10111 DDD where bit[5]=1 (register count), CCC=count reg

isa_state pc[31:0];
var instr[15:0];
isa_state dregs[31:0][2:0];
isa_state aregs[31:0][2:0];
mem dmem[25:0];
isa_state flag_X[0:0];
isa_state flag_N[0:0];
isa_state flag_Z[0:0];
isa_state flag_V[0:0];
isa_state flag_C[0:0];

var dst_reg[2:0];
var cnt_reg[2:0];
var count[5:0];
var src_val[31:0];
var result[31:0];
var left_part[31:0];
var right_part[31:0];

// Include interrupt and exception handling aspects
aspect m68k_exception.isa gates pc:2, sr:2, ssp:2, aregs:2, dmem:2, flag_C:2, flag_N:2, flag_Z:2, flag_V:2, flag_X:2, usp:2;
aspect m68k_interrupt.isa gates sr;
#ifdef MMU
aspect mmu/atc_translate_instr.isa gates pc, dmem;
#else
var pc_pa[31:0];
pc_pa = pc;
var pc_pa_delta[31:0];
pc_pa_delta = 32'd0;
#endif

// Fetch instruction
instr = dmem[pc_pa];
assume instr[15:12] == 0b1110;  // Shift/rotate opcode
assume instr[8] == 1;           // Direction: left
assume instr[7:6] == 0b10;      // Size: long
assume instr[5] == 1;           // i/r: register count
assume instr[4:3] == 0b11;      // ROL type
pc when (~m68k_exc_taken) = pc + 2;

// Decode
cnt_reg = instr[11:9];
dst_reg = instr[2:0];

// Count modulo 32 for 32-bit rotate
count = dregs[cnt_reg][4:0];

// Execute - rotate left
src_val = dregs[dst_reg];
left_part = count == 0 ? src_val : (src_val << count);
right_part = count == 0 ? 32'h00000000 : (src_val >> (32 - count));
result = left_part | right_part;

// Write result
dregs[dst_reg] when (~m68k_exc_taken) = result;

// Update CCR (X not affected by ROL)
flag_C when (~m68k_exc_taken) = count == 0 ? 1'b0 : result[0];
flag_N when (~m68k_exc_taken) = result[31];
flag_Z when (~m68k_exc_taken) = result == 0;
flag_V when (~m68k_exc_taken) = 1'b0;
