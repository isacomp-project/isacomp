// SPDX-License-Identifier: BSD-3-Clause
// M68000 BNE.B label - Branch if not equal (Z=0) (8-bit displacement)
// Opcode: 0110 0110 DDDDDDDD where DDDDDDDD=8-bit signed displacement

isa_state pc[31:0];
var instr[15:0];
isa_state dregs[31:0][2:0];
isa_state aregs[31:0][2:0];
mem dmem[25:0];
isa_state flag_X[0:0];
isa_state flag_N[0:0];
isa_state flag_Z[0:0];
isa_state flag_V[0:0];
isa_state flag_C[0:0];

var disp8[7:0];
var sign_ext_disp[31:0];
var branch_pc[31:0];
var branch_dest[31:0];
var take_branch[0:0];

// Include interrupt and exception handling aspects
aspect m68k_exception.isa gates pc:2, sr:2, ssp:2, aregs:2, dmem:2, flag_C:2, flag_N:2, flag_Z:2, flag_V:2, flag_X:2, usp:2;
aspect m68k_interrupt.isa gates sr;
#ifdef MMU
aspect mmu/atc_translate_instr.isa gates pc, dmem;
#else
var pc_pa[31:0];
pc_pa = pc;
var pc_pa_delta[31:0];
pc_pa_delta = 32'd0;
#endif

// Fetch instruction
instr = dmem[pc_pa];
assume instr[15:8] == 0b01100110;  // BNE opcode
assume instr[7:0] != 0;            // Not word displacement
assume instr[7:0] != 8'hFF;        // Not long displacement
branch_pc = pc + 2;
pc when (~m68k_exc_taken) = pc + 2;

// Decode 8-bit displacement
disp8 = instr[7:0];
sign_ext_disp = {{24{disp8[7]}}, disp8};

// Calculate branch destination
branch_dest = branch_pc + sign_ext_disp;

// Condition: Z=0
take_branch = ~flag_Z;

// Execute
pc when (~m68k_exc_taken) = take_branch ? branch_dest : pc;

// Branch does not affect flags
