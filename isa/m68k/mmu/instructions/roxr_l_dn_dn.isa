// SPDX-License-Identifier: BSD-3-Clause
// M68000 ROXR.L Dn,Dm - Rotate right through extend, long, by register count
// Opcode: 1110 CCC0 10110 DDD where CCC=count reg, DDD=data reg
// Rotates the 32-bit register + X flag (33 bits total) right by count

isa_state pc[31:0];
var instr[15:0];
isa_state dregs[31:0][2:0];
isa_state aregs[31:0][2:0];
mem dmem[25:0];
isa_state flag_X[0:0];
isa_state flag_N[0:0];
isa_state flag_Z[0:0];
isa_state flag_V[0:0];
isa_state flag_C[0:0];

var dst_reg[2:0];
var cnt_reg[2:0];
var raw_count[5:0];
var src_val[31:0];
var old_X[0:0];
var result[31:0];
var new_X[0:0];
var temp_val[32:0];
var rotated[65:0];
var left_part[65:0];
var right_part[65:0];

// Include interrupt and exception handling aspects
aspect m68k_exception.isa gates pc:2, sr:2, ssp:2, aregs:2, dmem:2, flag_C:2, flag_N:2, flag_Z:2, flag_V:2, flag_X:2, usp:2;
aspect m68k_interrupt.isa gates sr;
#ifdef MMU
aspect mmu/atc_translate_instr.isa gates pc, dmem;
#else
var pc_pa[31:0];
pc_pa = pc;
var pc_pa_delta[31:0];
pc_pa_delta = 32'd0;
#endif

// Fetch instruction
instr = dmem[pc_pa];
assume instr[15:12] == 0b1110;
assume instr[8] == 0;           // Direction: right
assume instr[7:6] == 0b10;     // Size: long
assume instr[5] == 1;           // i/r: register count
assume instr[4:3] == 0b10;     // ROXR type
pc when (~m68k_exc_taken) = pc + 2;

// Decode
cnt_reg = instr[11:9];
dst_reg = instr[2:0];
raw_count = dregs[cnt_reg][5:0];

// Execute - rotate right through X flag (33-bit rotation)
src_val = dregs[dst_reg];
old_X = flag_X;
temp_val = {src_val, old_X};

// Rotate right by count positions (33-bit circular)
right_part = {{33{1'b0}}, temp_val} >> raw_count;
left_part = {{33{1'b0}}, temp_val} << (33 - raw_count);
rotated = left_part | right_part;

result = rotated[32:1];
new_X = rotated[0];

// Write result
dregs[dst_reg] when (~m68k_exc_taken) = result;

// Update CCR
flag_X when (~m68k_exc_taken) = new_X;
flag_C when (~m68k_exc_taken) = new_X;
flag_N when (~m68k_exc_taken) = result[31];
flag_Z when (~m68k_exc_taken) = result == 0;
flag_V when (~m68k_exc_taken) = 1'b0;
