// SPDX-License-Identifier: BSD-3-Clause
// M68000 JMP (PC,Xn) - Jump to PC-relative with index
// Opcode: 0100 1110 11 111 011 followed by brief extension word
// Used for jump tables: jmp %pc@(disp,%dn:w)

isa_state pc[31:0];
var instr[15:0];
isa_state dregs[31:0][2:0];
isa_state aregs[31:0][2:0];
mem dmem[25:0];
isa_state flag_X[0:0];
isa_state flag_N[0:0];
isa_state flag_Z[0:0];
isa_state flag_V[0:0];
isa_state flag_C[0:0];

var ext_word[15:0];
var base_pc[31:0];
var disp8[7:0];
var disp_ext[31:0];
var idx_reg[2:0];
var idx_is_addr[0:0];
var idx_is_long[0:0];
var scale[1:0];
var idx_val[31:0];
var raw_idx[31:0];
var scaled_idx[31:0];
var target[31:0];

// Include interrupt and exception handling aspects
aspect m68k_exception.isa gates pc:2, sr:2, ssp:2, aregs:2, dmem:2, flag_C:2, flag_N:2, flag_Z:2, flag_V:2, flag_X:2, usp:2;
aspect m68k_interrupt.isa gates sr;
#ifdef MMU
aspect mmu/atc_translate_instr.isa gates pc, dmem;
#else
var pc_pa[31:0];
pc_pa = pc;
var pc_pa_delta[31:0];
pc_pa_delta = 32'd0;
#endif

// Fetch instruction
instr = dmem[pc_pa];
assume instr == 16'h4EFB;  // JMP (PC,Xn)
pc when (~m68k_exc_taken) = pc + 2;

// Save PC for base calculation (points to extension word)
base_pc = pc;

// Fetch extension word
ext_word = dmem[pc + pc_pa_delta];
assume ext_word[8] == 0b0;  // Brief format
pc when (~m68k_exc_taken) = pc + 2;

// Decode extension word
idx_reg = ext_word[14:12];
idx_is_addr = ext_word[15];
idx_is_long = ext_word[11];
scale = ext_word[10:9];
disp8 = ext_word[7:0];

// Sign-extend displacement
disp_ext = disp8[7] ? {24'hFFFFFF, disp8} : {24'h000000, disp8};

// Get index register value
raw_idx = idx_is_addr ? aregs[idx_reg] : dregs[idx_reg];

// Sign-extend word index if needed
idx_val = idx_is_long ? raw_idx : (raw_idx[15] ? {16'hFFFF, raw_idx[15:0]} : {16'h0000, raw_idx[15:0]});

// Apply scale factor
scaled_idx = scale == 0 ? idx_val :
             scale == 1 ? (idx_val << 1) :
             scale == 2 ? (idx_val << 2) :
                          (idx_val << 3);

// Calculate target: base_pc + displacement + scaled index
target = base_pc + disp_ext + scaled_idx;

// Jump
pc when (~m68k_exc_taken) = target;
