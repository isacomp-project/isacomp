// SPDX-License-Identifier: BSD-3-Clause
// M68000 ADDA.L (d8,An,Xn),An - Add Address Long with Index
// Opcode: 1101 DDD 111 110 AAA + brief extension word
// EA mode 110 = Address Register Indirect with Index (8-bit displacement)
// Extension word: D/A Xn2 Xn1 Xn0 W/L SC1 SC0 0 d7..d0
// Note: ADDA does NOT affect condition codes

isa_state pc[31:0];
var instr[15:0];
var briefword[15:0];
isa_state dregs[31:0][2:0];
isa_state aregs[31:0][2:0];
mem dmem[25:0];
#ifdef MMU
// MMU state (added by MMU preprocessor)
isa_state tc[31:0];
isa_state tt0[31:0];
isa_state tt1[31:0];
isa_state crp[63:0];
isa_state srp[63:0];
isa_state vbr[31:0];
isa_state ssp[31:0];
isa_state usp[31:0];
#endif
isa_state flag_X[0:0];
isa_state flag_N[0:0];
isa_state flag_Z[0:0];
isa_state flag_V[0:0];
isa_state flag_C[0:0];

var dst_reg[2:0];
var base_reg[2:0];
var idx_reg[2:0];
var idx_is_addr[0:0];
var idx_is_long[0:0];
var scale[1:0];
var disp8[7:0];
var base_addr[31:0];
var idx_val[31:0];
var scaled_idx[31:0];
var signed_disp[31:0];
var eff_addr[31:0];
var src_hi[15:0];
var src_lo[15:0];
var src_val[31:0];
var result[31:0];

// Include interrupt and exception handling aspects
aspect m68k_exception.isa gates pc:2, sr:2, ssp:2, aregs:2, dmem:2, flag_C:2, flag_N:2, flag_Z:2, flag_V:2, flag_X:2, usp:2;
aspect m68k_interrupt.isa gates sr;
#ifdef MMU
aspect mmu/atc_translate_instr.isa gates pc, dmem;
#else
var pc_pa[31:0];
pc_pa = pc;
var pc_pa_delta[31:0];
pc_pa_delta = 32'd0;
#endif

// Fetch instruction
instr = dmem[pc_pa];
assume instr[15:12] == 0b1101;    // ADD/ADDA
assume instr[8:6] == 0b111;       // ADDA.L opmode
assume instr[5:3] == 0b110;       // EA mode: (d8,An,Xn)
pc when (~m68k_exc_taken) = pc + 2;

// Fetch brief extension word
briefword = dmem[pc + pc_pa_delta];
assume briefword[8] == 0;         // Brief format
pc when (~m68k_exc_taken) = pc + 2;

// Decode instruction
dst_reg = instr[11:9];
base_reg = instr[2:0];

// Decode extension word
idx_is_addr = briefword[15];
idx_reg = briefword[14:12];
idx_is_long = briefword[11];
scale = briefword[10:9];
disp8 = briefword[7:0];

// Get base address
base_addr = aregs[base_reg];

// Get index value (sign-extend if word-sized)
case (idx_is_addr) {
    0: idx_val = idx_is_long ? dregs[idx_reg] : {{16{dregs[idx_reg][15]}}, dregs[idx_reg][15:0]};
    1: idx_val = idx_is_long ? aregs[idx_reg] : {{16{aregs[idx_reg][15]}}, aregs[idx_reg][15:0]};
}

// Sign-extend 8-bit displacement to 32 bits
signed_disp = {{24{disp8[7]}}, disp8};

// Apply scale factor
scaled_idx = scale == 0 ? idx_val :
             scale == 1 ? (idx_val << 1) :
             scale == 2 ? (idx_val << 2) :
                          (idx_val << 3);

// Calculate effective address: An + scaled_Xn + d8
eff_addr = base_addr + scaled_idx + signed_disp;

// Read source from memory (two 16-bit reads, big-endian)
#ifdef MMU
var mmu_va[31:0];
mmu_va = eff_addr;
var is_write[0:0];
is_write = 1'b0;
aspect mmu/atc_translate_data.isa gates pc:1, sr:1, ssp:1, aregs:1, dmem:1, flag_C:1, flag_N:1, flag_Z:1, flag_V:1, flag_X:1, usp:1;
#endif

#ifdef MMU
src_hi = dmem[ea_pa];
#else
src_hi = dmem[eff_addr];
#endif
#ifdef MMU
src_lo = dmem[ea_pa + 2];
#else
src_lo = dmem[eff_addr + 2];
#endif
src_val = {src_hi, src_lo};

// Execute
result = aregs[dst_reg] + src_val;

// Write result
aregs[dst_reg] when (~m68k_exc_taken & ~data_exc_taken) = result;

// ADDA does not affect flags
