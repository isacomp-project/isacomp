// SPDX-License-Identifier: BSD-3-Clause
// M68000 AND.L Dn,(d8,An,Xn) - Logical AND data register to long in memory (brief indexed)
// Opcode: 1100 DDD1 10 110 AAA + brief extension word

isa_state pc[31:0];
var instr[15:0];
isa_state dregs[31:0][2:0];
isa_state aregs[31:0][2:0];
mem dmem[25:0];
#ifdef MMU
// MMU state (added by MMU preprocessor)
isa_state tc[31:0];
isa_state tt0[31:0];
isa_state tt1[31:0];
isa_state crp[63:0];
isa_state srp[63:0];
isa_state vbr[31:0];
isa_state ssp[31:0];
isa_state usp[31:0];
#endif
isa_state flag_X[0:0];
isa_state flag_N[0:0];
isa_state flag_Z[0:0];
isa_state flag_V[0:0];
isa_state flag_C[0:0];

var src_reg[2:0];
var base_reg[2:0];
var alix_ext[15:0];
var alix_idx_is_addr[0:0];
var idx_reg[2:0];
var alix_idx_is_long[0:0];
var alix_scale[1:0];
var alix_disp8[7:0];
var alix_disp_ext[31:0];
var alix_idx_raw[31:0];
var alix_idx_val[31:0];
var alix_scaled_idx[31:0];
var alix_addr[31:0];
var alix_dst_hi[15:0];
var alix_dst_lo[15:0];
var alix_src_val[31:0];
var alix_dst_val[31:0];
var alix_result[31:0];

// Include interrupt and exception handling aspects
aspect m68k_exception.isa gates pc:2, sr:2, ssp:2, aregs:2, dmem:2, flag_C:2, flag_N:2, flag_Z:2, flag_V:2, flag_X:2, usp:2;
aspect m68k_interrupt.isa gates sr;
#ifdef MMU
aspect mmu/atc_translate_instr.isa gates pc, dmem;
#else
var pc_pa[31:0];
pc_pa = pc;
var pc_pa_delta[31:0];
pc_pa_delta = 32'd0;
#endif

// Fetch instruction
instr = dmem[pc_pa];
assume instr[15:12] == 0b1100;  // AND opcode
assume instr[8:6] == 0b110;     // Opmode: long, Dn to EA
assume instr[5:3] == 0b110;     // EA mode: Indexed
pc when (~m68k_exc_taken) = pc + 2;

// Decode
src_reg = instr[11:9];
base_reg = instr[2:0];

// Fetch brief extension word
alix_ext = dmem[pc + pc_pa_delta];
assume alix_ext[8] == 0b0;  // Brief format
pc when (~m68k_exc_taken) = pc + 2;

// Decode extension word
alix_idx_is_addr = alix_ext[15];
idx_reg = alix_ext[14:12];
alix_idx_is_long = alix_ext[11];
alix_scale = alix_ext[10:9];
alix_disp8 = alix_ext[7:0];

// Sign-extend displacement
alix_disp_ext = {{24{alix_disp8[7]}}, alix_disp8};

// Get index register value
alix_idx_raw = alix_idx_is_addr ? aregs[idx_reg] : dregs[idx_reg];

// Sign-extend word index if needed
alix_idx_val = alix_idx_is_long ? alix_idx_raw : (alix_idx_raw[15] ? {16'hFFFF, alix_idx_raw[15:0]} : {16'h0000, alix_idx_raw[15:0]});

// Apply scale factor
alix_scaled_idx = alix_scale == 0 ? alix_idx_val :
                  alix_scale == 1 ? (alix_idx_val << 1) :
                  alix_scale == 2 ? (alix_idx_val << 2) :
                                    (alix_idx_val << 3);

// Calculate effective address
alix_addr = aregs[base_reg] + alix_disp_ext + alix_scaled_idx;

// MMU translation
#ifdef MMU
var mmu_va[31:0];
mmu_va = alix_addr;
var is_write[0:0];
is_write = 1'b1;
aspect mmu/atc_translate_data.isa gates pc:1, sr:1, ssp:1, aregs:1, dmem:1, flag_C:1, flag_N:1, flag_Z:1, flag_V:1, flag_X:1, usp:1;
#endif

// Read destination from memory (two 16-bit reads, big-endian)
#ifdef MMU
alix_dst_hi = dmem[ea_pa];
#else
alix_dst_hi = dmem[alix_addr];
#endif
#ifdef MMU
alix_dst_lo = dmem[ea_pa + 2];
#else
alix_dst_lo = dmem[alix_addr + 2];
#endif
alix_dst_val = {alix_dst_hi, alix_dst_lo};

// Execute
alix_src_val = dregs[src_reg];
alix_result = alix_dst_val & alix_src_val;

// Write result back to memory
#ifdef MMU
dmem[ea_pa] when (~m68k_exc_taken & ~data_exc_taken) = alix_result[31:16];
#else
dmem[alix_addr] when (~m68k_exc_taken & ~data_exc_taken) = alix_result[31:16];
#endif
#ifdef MMU
dmem[ea_pa + 2] when (~m68k_exc_taken & ~data_exc_taken) = alix_result[15:0];
#else
dmem[alix_addr + 2] when (~m68k_exc_taken & ~data_exc_taken) = alix_result[15:0];
#endif

// Update CCR (X not affected)
flag_N when (~m68k_exc_taken & ~data_exc_taken) = alix_result[31];
flag_Z when (~m68k_exc_taken & ~data_exc_taken) = alix_result == 0;
flag_V when (~m68k_exc_taken & ~data_exc_taken) = 1'b0;
flag_C when (~m68k_exc_taken & ~data_exc_taken) = 1'b0;
