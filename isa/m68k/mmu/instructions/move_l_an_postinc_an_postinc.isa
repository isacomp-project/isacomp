// SPDX-License-Identifier: BSD-3-Clause
// M68000 MOVE.L (An)+,(Am)+ - Move long from memory to memory with postincrement
// Opcode: 0010 MMM0 11 011 SSS
// Memory-to-memory transfer, both source and destination postincrement by 4
// 68020+ supports misaligned access from odd addresses

isa_state pc[31:0];
var instr[15:0];
isa_state dregs[31:0][2:0];
isa_state aregs[31:0][2:0];
mem dmem[25:0];
#ifdef MMU
// MMU state (added by MMU preprocessor)
isa_state tc[31:0];
isa_state tt0[31:0];
isa_state tt1[31:0];
isa_state crp[63:0];
isa_state srp[63:0];
isa_state vbr[31:0];
isa_state ssp[31:0];
isa_state usp[31:0];
#endif
isa_state flag_X[0:0];
isa_state flag_N[0:0];
isa_state flag_Z[0:0];
isa_state flag_V[0:0];
isa_state flag_C[0:0];

var src_reg[2:0];
var dst_reg[2:0];
var src_addr[31:0];
var dst_addr[31:0];
var data_hi[15:0];
var data_lo[15:0];
var data[31:0];
var mlapp_src_aligned[31:0];
var mlapp_src_w0[15:0];
var mlapp_src_w1[15:0];
var mlapp_src_w2[15:0];
var mlapp_dst_aligned[31:0];
var mlapp_dst_e0[15:0];
var mlapp_dst_e1[15:0];
var mlapp_dst_e2[15:0];

// Include interrupt and exception handling aspects
aspect m68k_exception.isa gates pc:2, sr:2, ssp:2, aregs:2, dmem:2, flag_C:2, flag_N:2, flag_Z:2, flag_V:2, flag_X:2, usp:2;
aspect m68k_interrupt.isa gates sr;
#ifdef MMU
aspect mmu/atc_translate_instr.isa gates pc, dmem;
#else
var pc_pa[31:0];
pc_pa = pc;
var pc_pa_delta[31:0];
pc_pa_delta = 32'd0;
#endif

// Fetch instruction
instr = dmem[pc_pa];
assume instr[15:12] == 0b0010;  // MOVE.L opcode
assume instr[8:6] == 0b011;     // Destination mode: Postincrement
assume instr[5:3] == 0b011;     // Source mode: Postincrement
pc when (~m68k_exc_taken) = pc + 2;

// Decode registers
dst_reg = instr[11:9];
src_reg = instr[2:0];

// Get source address
src_addr = aregs[src_reg];

// Read from source memory (32-bit, big-endian, handle misaligned access)
#ifdef MMU
var mmu_va[31:0];
mmu_va = src_addr;
var is_write[0:0];
is_write = 1'b1;
aspect mmu/atc_translate_data.isa gates pc:1, sr:1, ssp:1, aregs:1, dmem:1, flag_C:1, flag_N:1, flag_Z:1, flag_V:1, flag_X:1, usp:1;
mlapp_src_aligned = {ea_pa[31:1], 1'b0};
#else
mlapp_src_aligned = {src_addr[31:1], 1'b0};
#endif
mlapp_src_w0 = dmem[mlapp_src_aligned];
mlapp_src_w1 = dmem[mlapp_src_aligned + 2];
mlapp_src_w2 = dmem[mlapp_src_aligned + 4];
// Even: data_hi = w0, data_lo = w1
// Odd: data_hi = {w0[7:0], w1[15:8]}, data_lo = {w1[7:0], w2[15:8]}
data_hi = src_addr[0] ? {mlapp_src_w0[7:0], mlapp_src_w1[15:8]} : mlapp_src_w0;
data_lo = src_addr[0] ? {mlapp_src_w1[7:0], mlapp_src_w2[15:8]} : mlapp_src_w1;
data = {data_hi, data_lo};

// Postincrement source by 4
aregs[src_reg] when (~m68k_exc_taken & ~data_exc_taken) = src_addr + 4;

// Get destination address
dst_addr = aregs[dst_reg];

// Write to destination memory (32-bit, big-endian, handle misaligned access)
mlapp_dst_aligned = {dst_addr[31:1], 1'b0};
mlapp_dst_e0 = dmem[mlapp_dst_aligned];
mlapp_dst_e1 = dmem[mlapp_dst_aligned + 2];
mlapp_dst_e2 = dmem[mlapp_dst_aligned + 4];
dmem[mlapp_dst_aligned] when (~m68k_exc_taken & ~data_exc_taken) = dst_addr[0] ? {mlapp_dst_e0[15:8], data[31:24]} : data[31:16];
dmem[mlapp_dst_aligned + 2] when (~m68k_exc_taken & ~data_exc_taken) = dst_addr[0] ? {data[23:16], data[15:8]} : data[15:0];
dmem[mlapp_dst_aligned + 4] when (~m68k_exc_taken & ~data_exc_taken) = dst_addr[0] ? {data[7:0], mlapp_dst_e2[7:0]} : mlapp_dst_e2;

// Postincrement destination by 4
aregs[dst_reg] when (~m68k_exc_taken & ~data_exc_taken) = dst_addr + 4;

// Update CCR
flag_N when (~m68k_exc_taken & ~data_exc_taken) = data[31];
flag_Z when (~m68k_exc_taken & ~data_exc_taken) = data == 0;
flag_V when (~m68k_exc_taken & ~data_exc_taken) = 1'b0;
flag_C when (~m68k_exc_taken & ~data_exc_taken) = 1'b0;
// X not affected

