// SPDX-License-Identifier: BSD-3-Clause
// M68000 MOVE.L (d8,An,Xn),(d8,An,Xn) - Move long from indexed to indexed
// Opcode: 0010 DDD 110 110 SSS followed by src brief ext, then dst brief ext
// Both source and destination use brief indexed addressing

isa_state pc[31:0];
var instr[15:0];
isa_state dregs[31:0][2:0];
isa_state aregs[31:0][2:0];
mem dmem[25:0];
#ifdef MMU
// MMU state (added by MMU preprocessor)
isa_state tc[31:0];
isa_state tt0[31:0];
isa_state tt1[31:0];
isa_state crp[63:0];
isa_state srp[63:0];
isa_state vbr[31:0];
isa_state ssp[31:0];
isa_state usp[31:0];
#endif
isa_state flag_X[0:0];
isa_state flag_N[0:0];
isa_state flag_Z[0:0];
isa_state flag_V[0:0];
isa_state flag_C[0:0];

var mlii_src_base[2:0];
var mlii_dst_base[2:0];

// Source index vars
var mlii_src_ext[15:0];
var mlii_src_disp8[7:0];
var mlii_src_disp_ext[31:0];
var mlii_src_idx_reg[2:0];
var mlii_src_idx_is_addr[0:0];
var mlii_src_idx_is_long[0:0];
var mlii_src_scale[1:0];
var mlii_src_raw_idx[31:0];
var mlii_src_idx_val[31:0];
var mlii_src_scaled_idx[31:0];
var mlii_src_addr[31:0];

// Destination index vars
var mlii_dst_ext[15:0];
var mlii_dst_disp8[7:0];
var mlii_dst_disp_ext[31:0];
var idx_reg[2:0];
var mlii_dst_idx_is_addr[0:0];
var mlii_dst_idx_is_long[0:0];
var mlii_dst_scale[1:0];
var mlii_dst_raw_idx[31:0];
var mlii_dst_idx_val[31:0];
var mlii_dst_scaled_idx[31:0];
var mlii_dst_addr[31:0];

// Data vars
var mlii_data_hi[15:0];
var mlii_data_lo[15:0];
var mlii_data[31:0];

// Include interrupt and exception handling aspects
aspect m68k_exception.isa gates pc:2, sr:2, ssp:2, aregs:2, dmem:2, flag_C:2, flag_N:2, flag_Z:2, flag_V:2, flag_X:2, usp:2;
aspect m68k_interrupt.isa gates sr;
#ifdef MMU
aspect mmu/atc_translate_instr.isa gates pc, dmem;
#else
var pc_pa[31:0];
pc_pa = pc;
var pc_pa_delta[31:0];
pc_pa_delta = 32'd0;
#endif

// Fetch instruction
instr = dmem[pc_pa];
assume instr[15:12] == 0b0010;  // MOVE.L
assume instr[8:6] == 0b110;     // Dest mode: (d8,An,Xn)
assume instr[5:3] == 0b110;     // Source mode: (d8,An,Xn)
pc when (~m68k_exc_taken) = pc + 2;

mlii_dst_base = instr[11:9];
mlii_src_base = instr[2:0];

// Fetch source brief extension word
mlii_src_ext = dmem[pc + pc_pa_delta];
assume mlii_src_ext[8] == 0b0;  // Brief format
pc when (~m68k_exc_taken) = pc + 2;

// Decode source index
mlii_src_idx_reg = mlii_src_ext[14:12];
mlii_src_idx_is_addr = mlii_src_ext[15];
mlii_src_idx_is_long = mlii_src_ext[11];
mlii_src_scale = mlii_src_ext[10:9];
mlii_src_disp8 = mlii_src_ext[7:0];
mlii_src_disp_ext = {{24{mlii_src_disp8[7]}}, mlii_src_disp8};

mlii_src_raw_idx = mlii_src_idx_is_addr ? aregs[mlii_src_idx_reg] : dregs[mlii_src_idx_reg];
mlii_src_idx_val = mlii_src_idx_is_long ? mlii_src_raw_idx : {{16{mlii_src_raw_idx[15]}}, mlii_src_raw_idx[15:0]};

mlii_src_scaled_idx = mlii_src_scale == 0 ? mlii_src_idx_val :
                      mlii_src_scale == 1 ? (mlii_src_idx_val << 1) :
                      mlii_src_scale == 2 ? (mlii_src_idx_val << 2) :
                                            (mlii_src_idx_val << 3);

mlii_src_addr = aregs[mlii_src_base] + mlii_src_disp_ext + mlii_src_scaled_idx;

// Read source data
#ifdef MMU
var mmu_va[31:0];
mmu_va = mlii_src_addr;
var is_write[0:0];
is_write = 1'b0;
aspect mmu/atc_translate_data.isa gates pc:1, sr:1, ssp:1, aregs:1, dmem:1, flag_C:1, flag_N:1, flag_Z:1, flag_V:1, flag_X:1, usp:1;
#endif

#ifdef MMU
mlii_data_hi = dmem[ea_pa];
#else
mlii_data_hi = dmem[mlii_src_addr];
#endif
#ifdef MMU
mlii_data_lo = dmem[ea_pa + 2];
#else
mlii_data_lo = dmem[mlii_src_addr + 2];
#endif
mlii_data = {mlii_data_hi, mlii_data_lo};

// Fetch destination brief extension word
mlii_dst_ext = dmem[pc + pc_pa_delta];
assume mlii_dst_ext[8] == 0b0;  // Brief format
pc when (~m68k_exc_taken) = pc + 2;

// Decode destination index
idx_reg = mlii_dst_ext[14:12];
mlii_dst_idx_is_addr = mlii_dst_ext[15];
mlii_dst_idx_is_long = mlii_dst_ext[11];
mlii_dst_scale = mlii_dst_ext[10:9];
mlii_dst_disp8 = mlii_dst_ext[7:0];
mlii_dst_disp_ext = {{24{mlii_dst_disp8[7]}}, mlii_dst_disp8};

mlii_dst_raw_idx = mlii_dst_idx_is_addr ? aregs[idx_reg] : dregs[idx_reg];
mlii_dst_idx_val = mlii_dst_idx_is_long ? mlii_dst_raw_idx : {{16{mlii_dst_raw_idx[15]}}, mlii_dst_raw_idx[15:0]};

mlii_dst_scaled_idx = mlii_dst_scale == 0 ? mlii_dst_idx_val :
                      mlii_dst_scale == 1 ? (mlii_dst_idx_val << 1) :
                      mlii_dst_scale == 2 ? (mlii_dst_idx_val << 2) :
                                            (mlii_dst_idx_val << 3);

mlii_dst_addr = aregs[mlii_dst_base] + mlii_dst_disp_ext + mlii_dst_scaled_idx;

// Write to destination
dmem[mlii_dst_addr] when (~m68k_exc_taken & ~data_exc_taken) = mlii_data[31:16];
dmem[mlii_dst_addr + 2] when (~m68k_exc_taken & ~data_exc_taken) = mlii_data[15:0];

// Update CCR
flag_N when (~m68k_exc_taken & ~data_exc_taken) = mlii_data[31];
flag_Z when (~m68k_exc_taken & ~data_exc_taken) = mlii_data == 0;
flag_V when (~m68k_exc_taken & ~data_exc_taken) = 1'b0;
flag_C when (~m68k_exc_taken & ~data_exc_taken) = 1'b0;
