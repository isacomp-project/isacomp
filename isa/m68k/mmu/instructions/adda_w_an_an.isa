// SPDX-License-Identifier: BSD-3-Clause
// M68000 ADDA.W An,Am - Add word from address register to address register (sign-extended)
// Opcode: 1101 DDD 011 001 SSS where DDD=dest addr reg, SSS=src addr reg
// ADDA does NOT affect condition codes

isa_state pc[31:0];
var instr[15:0];
isa_state dregs[31:0][2:0];
isa_state aregs[31:0][2:0];
mem dmem[25:0];
#ifdef MMU
// MMU state (added by MMU preprocessor)
isa_state tc[31:0];
isa_state tt0[31:0];
isa_state tt1[31:0];
isa_state crp[63:0];
isa_state srp[63:0];
isa_state vbr[31:0];
isa_state ssp[31:0];
isa_state usp[31:0];
#endif
isa_state flag_X[0:0];
isa_state flag_N[0:0];
isa_state flag_Z[0:0];
isa_state flag_V[0:0];
isa_state flag_C[0:0];

var src_reg[2:0];
var dst_reg[2:0];
var awaa_src_word[15:0];
var awaa_src_val[31:0];
var awaa_result[31:0];

// Include interrupt and exception handling aspects
aspect m68k_exception.isa gates pc:2, sr:2, ssp:2, aregs:2, dmem:2, flag_C:2, flag_N:2, flag_Z:2, flag_V:2, flag_X:2, usp:2;
aspect m68k_interrupt.isa gates sr;
#ifdef MMU
aspect mmu/atc_translate_instr.isa gates pc, dmem;
#else
var pc_pa[31:0];
pc_pa = pc;
var pc_pa_delta[31:0];
pc_pa_delta = 32'd0;
#endif

// Fetch instruction
instr = dmem[pc_pa];
assume instr[15:12] == 0b1101;  // ADDA opcode
assume instr[8:6] == 0b011;     // Opmode: ADDA.W
assume instr[5:3] == 0b001;     // EA mode: Address Register Direct
pc when (~m68k_exc_taken) = pc + 2;

dst_reg = instr[11:9];
src_reg = instr[2:0];

// Get source word from address register and sign-extend
awaa_src_word = aregs[src_reg][15:0];
awaa_src_val = {{16{awaa_src_word[15]}}, awaa_src_word};

// Execute
awaa_result = aregs[dst_reg] + awaa_src_val;
aregs[dst_reg] when (~m68k_exc_taken) = awaa_result;
