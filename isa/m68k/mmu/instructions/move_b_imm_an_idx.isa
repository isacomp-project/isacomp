// SPDX-License-Identifier: BSD-3-Clause
// M68000 MOVE.B #imm,(d8,An,Xn) - Move immediate byte to indexed address
// Opcode: 0001 AAA 110 111 100 followed by immediate word (byte in low 8), then brief extension word
// Note: In MOVE, source extension words come before destination extension words

isa_state pc[31:0];
var instr[15:0];
isa_state dregs[31:0][2:0];
isa_state aregs[31:0][2:0];
mem dmem[25:0];
#ifdef MMU
// MMU state (added by MMU preprocessor)
isa_state tc[31:0];
isa_state tt0[31:0];
isa_state tt1[31:0];
isa_state crp[63:0];
isa_state srp[63:0];
isa_state vbr[31:0];
isa_state ssp[31:0];
isa_state usp[31:0];
#endif
isa_state flag_X[0:0];
isa_state flag_N[0:0];
isa_state flag_Z[0:0];
isa_state flag_V[0:0];
isa_state flag_C[0:0];

var addr_reg[2:0];
var mbiax_imm_word[15:0];
var mbiax_data_byte[7:0];
var mbiax_ext[15:0];
var mbiax_idx_is_addr[0:0];
var idx_reg[2:0];
var mbiax_idx_is_long[0:0];
var mbiax_scale[1:0];
var mbiax_disp8[7:0];
var mbiax_disp_ext[31:0];
var mbiax_idx_raw[31:0];
var mbiax_idx_val[31:0];
var mbiax_scaled_idx[31:0];
var mbiax_eff_addr[31:0];
var mbiax_mem_word[15:0];
var mbiax_new_word[15:0];

// Include interrupt and exception handling aspects
aspect m68k_exception.isa gates pc:2, sr:2, ssp:2, aregs:2, dmem:2, flag_C:2, flag_N:2, flag_Z:2, flag_V:2, flag_X:2, usp:2;
aspect m68k_interrupt.isa gates sr;
#ifdef MMU
aspect mmu/atc_translate_instr.isa gates pc, dmem;
#else
var pc_pa[31:0];
pc_pa = pc;
var pc_pa_delta[31:0];
pc_pa_delta = 32'd0;
#endif

// Fetch instruction
instr = dmem[pc_pa];
assume instr[15:12] == 0b0001;  // MOVE.B
assume instr[8:6] == 0b110;     // Dest mode: indexed (d8,An,Xn)
assume instr[5:3] == 0b111;     // Source mode: Special
assume instr[2:0] == 0b100;     // Immediate
pc when (~m68k_exc_taken) = pc + 2;

addr_reg = instr[11:9];

// Fetch immediate word (source extension comes first)
mbiax_imm_word = dmem[pc + pc_pa_delta];
pc when (~m68k_exc_taken) = pc + 2;
mbiax_data_byte = mbiax_imm_word[7:0];

// Fetch brief extension word (destination extension)
mbiax_ext = dmem[pc + pc_pa_delta];
assume mbiax_ext[8] == 0b0;  // Brief format
pc when (~m68k_exc_taken) = pc + 2;

// Decode extension word
mbiax_idx_is_addr = mbiax_ext[15];
idx_reg = mbiax_ext[14:12];
mbiax_idx_is_long = mbiax_ext[11];
mbiax_scale = mbiax_ext[10:9];
mbiax_disp8 = mbiax_ext[7:0];

mbiax_disp_ext = {{24{mbiax_disp8[7]}}, mbiax_disp8};
mbiax_idx_raw = mbiax_idx_is_addr ? aregs[idx_reg] : dregs[idx_reg];
mbiax_idx_val = mbiax_idx_is_long ? mbiax_idx_raw : (mbiax_idx_raw[15] ? {16'hFFFF, mbiax_idx_raw[15:0]} : {16'h0000, mbiax_idx_raw[15:0]});

mbiax_scaled_idx = mbiax_scale == 0 ? mbiax_idx_val :
                   mbiax_scale == 1 ? (mbiax_idx_val << 1) :
                   mbiax_scale == 2 ? (mbiax_idx_val << 2) :
                                      (mbiax_idx_val << 3);

mbiax_eff_addr = aregs[addr_reg] + mbiax_disp_ext + mbiax_scaled_idx;

// Read-modify-write: read word, update byte, write back (big-endian)
#ifdef MMU
var mmu_va[31:0];
mmu_va = {mbiax_eff_addr[31:1], 1'b0};
var is_write[0:0];
is_write = 1'b0;
aspect mmu/atc_translate_data.isa gates pc:1, sr:1, ssp:1, aregs:1, dmem:1, flag_C:1, flag_N:1, flag_Z:1, flag_V:1, flag_X:1, usp:1;
#endif

#ifdef MMU
mbiax_mem_word = dmem[ea_pa];
#else
mbiax_mem_word = dmem[{mbiax_eff_addr[31:1], 1'b0}];
#endif
mbiax_new_word = mbiax_eff_addr[0] ? {mbiax_mem_word[15:8], mbiax_data_byte} : {mbiax_data_byte, mbiax_mem_word[7:0]};
#ifdef MMU
dmem[ea_pa] when (~m68k_exc_taken & ~data_exc_taken) = mbiax_new_word;
#else
dmem[{mbiax_eff_addr[31:1], 1'b0}] when (~m68k_exc_taken & ~data_exc_taken) = mbiax_new_word;
#endif

// Update CCR
flag_N when (~m68k_exc_taken & ~data_exc_taken) = mbiax_data_byte[7];
flag_Z when (~m68k_exc_taken & ~data_exc_taken) = mbiax_data_byte == 0;
flag_V when (~m68k_exc_taken & ~data_exc_taken) = 1'b0;
flag_C when (~m68k_exc_taken & ~data_exc_taken) = 1'b0;
