// SPDX-License-Identifier: BSD-3-Clause
// M68000 SUBQ.W #imm,Dn - Subtract Quick Word from Data Register
// Opcode: 0101 QQQ 101 000 DDD

isa_state pc[31:0];
var instr[15:0];
isa_state dregs[31:0][2:0];
isa_state aregs[31:0][2:0];
mem dmem[25:0];
isa_state flag_X[0:0];
isa_state flag_N[0:0];
isa_state flag_Z[0:0];
isa_state flag_V[0:0];
isa_state flag_C[0:0];

var dst_reg[2:0];
var quick_val[2:0];
var imm[15:0];
var src[15:0];
var result[15:0];

// Include interrupt and exception handling aspects
aspect m68k_exception.isa gates pc:2, sr:2, ssp:2, aregs:2, dmem:2, flag_C:2, flag_N:2, flag_Z:2, flag_V:2, flag_X:2, usp:2;
aspect m68k_interrupt.isa gates sr;
#ifdef MMU
aspect mmu/atc_translate_instr.isa gates pc, dmem;
#else
var pc_pa[31:0];
pc_pa = pc;
var pc_pa_delta[31:0];
pc_pa_delta = 32'd0;
#endif

// Fetch instruction
instr = dmem[pc_pa];
assume instr[15:12] == 0b0101;  // SUBQ
assume instr[8:6] == 0b101;     // Word size (subq)
assume instr[5:3] == 0b000;     // EA mode: Dn
pc when (~m68k_exc_taken) = pc + 2;

dst_reg = instr[2:0];
quick_val = instr[11:9];

// Quick value: 0 means 8
imm = quick_val == 0 ? 16'd8 : {13'b0, quick_val};

src = dregs[dst_reg][15:0];
result = src - imm;

// Write back (only lower 16 bits)
dregs[dst_reg] when (~m68k_exc_taken) = {dregs[dst_reg][31:16], result};

// Update CCR
flag_X when (~m68k_exc_taken) = imm > src;
flag_N when (~m68k_exc_taken) = result[15];
flag_Z when (~m68k_exc_taken) = result == 0;
flag_V when (~m68k_exc_taken) = (src[15] & ~imm[15] & ~result[15]) | (~src[15] & imm[15] & result[15]);
flag_C when (~m68k_exc_taken) = imm > src;
