// SPDX-License-Identifier: BSD-3-Clause
// M68000 CMPM.L (Ay)+,(Ax)+ - Compare memory long with post-increment
// Opcode: 1011 XXX1 10001 YYY where XXX=Ax, YYY=Ay
// Operation: (Ax)+ - (Ay)+, result discarded, both registers incremented

isa_state pc[31:0];
var instr[15:0];
isa_state dregs[31:0][2:0];
isa_state aregs[31:0][2:0];
mem dmem[25:0];
#ifdef MMU
// MMU state (added by MMU preprocessor)
isa_state tc[31:0];
isa_state tt0[31:0];
isa_state tt1[31:0];
isa_state crp[63:0];
isa_state srp[63:0];
isa_state vbr[31:0];
isa_state ssp[31:0];
isa_state usp[31:0];
#endif
isa_state flag_X[0:0];
isa_state flag_N[0:0];
isa_state flag_Z[0:0];
isa_state flag_V[0:0];
isa_state flag_C[0:0];

var dst_reg[2:0];
var src_reg[2:0];
var src_addr[31:0];
var dst_addr[31:0];
var src_hi[15:0];
var src_lo[15:0];
var src_val[31:0];
var dst_hi[15:0];
var dst_lo[15:0];
var dst_val[31:0];
var result[32:0];

// Include interrupt and exception handling aspects
aspect m68k_exception.isa gates pc:2, sr:2, ssp:2, aregs:2, dmem:2, flag_C:2, flag_N:2, flag_Z:2, flag_V:2, flag_X:2, usp:2;
aspect m68k_interrupt.isa gates sr;
#ifdef MMU
aspect mmu/atc_translate_instr.isa gates pc, dmem;
#else
var pc_pa[31:0];
pc_pa = pc;
var pc_pa_delta[31:0];
pc_pa_delta = 32'd0;
#endif

// Fetch instruction
instr = dmem[pc_pa];
assume instr[15:12] == 0b1011;  // CMP opcode
assume instr[8:6] == 0b110;     // Opmode: long CMPM
assume instr[5:3] == 0b001;     // EA mode: CMPM indicator
pc when (~m68k_exc_taken) = pc + 2;

// Decode
dst_reg = instr[11:9];  // Ax
src_reg = instr[2:0];   // Ay

// Read source long from memory (Ay)+ - big endian
src_addr = aregs[src_reg];
#ifdef MMU
var mmu_va[31:0];
mmu_va = src_addr;
var is_write[0:0];
is_write = 1'b0;
aspect mmu/atc_translate_data.isa gates pc:1, sr:1, ssp:1, aregs:1, dmem:1, flag_C:1, flag_N:1, flag_Z:1, flag_V:1, flag_X:1, usp:1;
#endif

#ifdef MMU
src_hi = dmem[ea_pa];
#else
src_hi = dmem[src_addr];
#endif
#ifdef MMU
src_lo = dmem[ea_pa + 2];
#else
src_lo = dmem[src_addr + 2];
#endif
src_val = {src_hi, src_lo};
aregs[src_reg] when (~m68k_exc_taken & ~data_exc_taken) = src_addr + 4;

// Read destination long from memory (Ax)+ - big endian
dst_addr = aregs[dst_reg];
dst_hi = dmem[dst_addr];
dst_lo = dmem[dst_addr + 2];
dst_val = {dst_hi, dst_lo};
aregs[dst_reg] when (~m68k_exc_taken & ~data_exc_taken) = dst_addr + 4;

// Execute (subtract but don't store result)
result = dst_val - src_val;

// Update CCR (X not affected by CMP)
flag_C when (~m68k_exc_taken & ~data_exc_taken) = src_val > dst_val;
flag_V when (~m68k_exc_taken & ~data_exc_taken) = (~dst_val[31] & src_val[31] & result[31]) | (dst_val[31] & ~src_val[31] & ~result[31]);
flag_Z when (~m68k_exc_taken & ~data_exc_taken) = result[31:0] == 0;
flag_N when (~m68k_exc_taken & ~data_exc_taken) = result[31];
