// SPDX-License-Identifier: BSD-3-Clause
// M68000 MOVE.L (xxx).L,(An)+ - Move long from absolute long to postincrement
// Opcode: 0010 DDD 011 111 001 + 32-bit source address

isa_state pc[31:0];
var instr[15:0];
isa_state dregs[31:0][2:0];
isa_state aregs[31:0][2:0];
mem dmem[25:0];
#ifdef MMU
// MMU state (added by MMU preprocessor)
isa_state tc[31:0];
isa_state tt0[31:0];
isa_state tt1[31:0];
isa_state crp[63:0];
isa_state srp[63:0];
isa_state vbr[31:0];
isa_state ssp[31:0];
isa_state usp[31:0];
#endif
isa_state flag_X[0:0];
isa_state flag_N[0:0];
isa_state flag_Z[0:0];
isa_state flag_V[0:0];
isa_state flag_C[0:0];

var dst_reg[2:0];
var mlap_src_hi[15:0];
var mlap_src_lo[15:0];
var mlap_src_addr[31:0];
var mlap_data_hi[15:0];
var mlap_data_lo[15:0];
var mlap_data[31:0];
var mlap_dst_addr[31:0];

aspect m68k_exception.isa gates pc:2, sr:2, ssp:2, aregs:2, dmem:2, flag_C:2, flag_N:2, flag_Z:2, flag_V:2, flag_X:2, usp:2;
aspect m68k_interrupt.isa gates sr;
#ifdef MMU
aspect mmu/atc_translate_instr.isa gates pc, dmem;
#else
var pc_pa[31:0];
pc_pa = pc;
var pc_pa_delta[31:0];
pc_pa_delta = 32'd0;
#endif

instr = dmem[pc_pa];
assume instr[15:12] == 0b0010;  // MOVE.L
assume instr[8:6] == 0b011;     // Dst: (An)+
assume instr[5:3] == 0b111;
assume instr[2:0] == 0b001;     // Src: (xxx).L
pc when (~m68k_exc_taken) = pc + 2;

dst_reg = instr[11:9];

// Fetch 32-bit source address
mlap_src_hi = dmem[pc + pc_pa_delta];
pc when (~m68k_exc_taken) = pc + 2;
mlap_src_lo = dmem[pc + pc_pa_delta];
pc when (~m68k_exc_taken) = pc + 2;
mlap_src_addr = {mlap_src_hi, mlap_src_lo};

// Read long (two words, big-endian)
#ifdef MMU
var mmu_va[31:0];
mmu_va = mlap_src_addr;
var is_write[0:0];
is_write = 1'b1;
aspect mmu/atc_translate_data.isa gates pc:1, sr:1, ssp:1, aregs:1, dmem:1, flag_C:1, flag_N:1, flag_Z:1, flag_V:1, flag_X:1, usp:1;
#endif

#ifdef MMU
mlap_data_hi = dmem[ea_pa];
#else
mlap_data_hi = dmem[mlap_src_addr];
#endif
#ifdef MMU
mlap_data_lo = dmem[ea_pa + 2];
#else
mlap_data_lo = dmem[mlap_src_addr + 2];
#endif
mlap_data = {mlap_data_hi, mlap_data_lo};

// Write to destination with postincrement
mlap_dst_addr = aregs[dst_reg];
dmem[mlap_dst_addr] when (~m68k_exc_taken & ~data_exc_taken) = mlap_data[31:16];
dmem[mlap_dst_addr + 2] when (~m68k_exc_taken & ~data_exc_taken) = mlap_data[15:0];
aregs[dst_reg] when (~m68k_exc_taken & ~data_exc_taken) = aregs[dst_reg] + 4;

flag_N when (~m68k_exc_taken & ~data_exc_taken) = mlap_data[31];
flag_Z when (~m68k_exc_taken & ~data_exc_taken) = mlap_data == 0;
flag_V when (~m68k_exc_taken & ~data_exc_taken) = 1'b0;
flag_C when (~m68k_exc_taken & ~data_exc_taken) = 1'b0;
