// SPDX-License-Identifier: BSD-3-Clause
// MC68020 BFCLR d(An,Xn){Dn:width} - Clear Bit Field in indexed memory
// Opcode: 1110 1100 11 110 AAA followed by BF ext word, then brief index ext word
// BF ext: 0 xxx D ooooo 0 wwwww (register offset, immediate width)

isa_state pc[31:0];
var instr[15:0];
isa_state dregs[31:0][2:0];
isa_state aregs[31:0][2:0];
mem dmem[25:0];
#ifdef MMU
// MMU state (added by MMU preprocessor)
isa_state tc[31:0];
isa_state tt0[31:0];
isa_state tt1[31:0];
isa_state crp[63:0];
isa_state srp[63:0];
isa_state vbr[31:0];
isa_state ssp[31:0];
isa_state usp[31:0];
#endif
isa_state flag_X[0:0];
isa_state flag_N[0:0];
isa_state flag_Z[0:0];
isa_state flag_V[0:0];
isa_state flag_C[0:0];

var base_reg[2:0];
var bfci_ext[15:0];
var offset_reg[2:0];
var width_field[4:0];
var width[5:0];
var idx_ext[15:0];
var idx_reg[2:0];
var idx_is_addr[0:0];
var idx_is_long[0:0];
var idx_scale[1:0];
var disp8[7:0];
var disp_ext[31:0];
var raw_idx[31:0];
var idx_val[31:0];
var scaled_idx[31:0];
var base_addr[31:0];
var bit_offset[31:0];
var byte_offset[31:0];
var eff_addr[31:0];
var word_addr[31:0];
var bit_in_word[3:0];
var mem_word[15:0];
var mask[15:0];
var result_word[15:0];

// Include interrupt and exception handling aspects
aspect m68k_exception.isa gates pc:2, sr:2, ssp:2, aregs:2, dmem:2, flag_C:2, flag_N:2, flag_Z:2, flag_V:2, flag_X:2, usp:2;
aspect m68k_interrupt.isa gates sr;
#ifdef MMU
aspect mmu/atc_translate_instr.isa gates pc, dmem;
#else
var pc_pa[31:0];
pc_pa = pc;
var pc_pa_delta[31:0];
pc_pa_delta = 32'd0;
#endif

// Fetch instruction
instr = dmem[pc_pa];
assume instr[15:6] == 0b1110110011;  // BFCLR
assume instr[5:3] == 0b110;          // EA mode: d(An,Xn)
pc when (~m68k_exc_taken) = pc + 2;

base_reg = instr[2:0];

// Fetch BF extension word
bfci_ext = dmem[pc + pc_pa_delta];
assume bfci_ext[11] == 0b1;   // Offset is register
assume bfci_ext[5] == 0b0;    // Width is immediate
pc when (~m68k_exc_taken) = pc + 2;

offset_reg = bfci_ext[8:6];
width_field = bfci_ext[4:0];
width = width_field == 0 ? 6'd32 : {{1{1'b0}}, width_field};

// Fetch brief extension word for indexed addressing
idx_ext = dmem[pc + pc_pa_delta];
assume idx_ext[8] == 0b0;     // Brief format
pc when (~m68k_exc_taken) = pc + 2;

idx_reg = idx_ext[14:12];
idx_is_addr = idx_ext[15];
idx_is_long = idx_ext[11];
idx_scale = idx_ext[10:9];
disp8 = idx_ext[7:0];
disp_ext = {{24{disp8[7]}}, disp8};

raw_idx = idx_is_addr ? aregs[idx_reg] : dregs[idx_reg];
idx_val = idx_is_long ? raw_idx : {{16{raw_idx[15]}}, raw_idx[15:0]};

scaled_idx = idx_scale == 2'b00 ? idx_val :
             idx_scale == 2'b01 ? (idx_val << 1) :
             idx_scale == 2'b10 ? (idx_val << 2) :
                                  (idx_val << 3);

// Calculate base effective address
base_addr = aregs[base_reg] + disp_ext + scaled_idx;

// Get bit offset from register
bit_offset = dregs[offset_reg];

// Calculate byte address: base + bit_offset/8
byte_offset = {bit_offset[31], bit_offset[31], bit_offset[31], bit_offset[31:3]};
eff_addr = base_addr + byte_offset;

// Align to word boundary and find bit within word
word_addr = {eff_addr[31:1], 1'b0};
bit_in_word = {eff_addr[0], bit_offset[2:0]};

// Read the word
#ifdef MMU
var mmu_va[31:0];
mmu_va = word_addr;
var is_write[0:0];
is_write = 1'b1;
aspect mmu/atc_translate_data.isa gates pc:1, sr:1, ssp:1, aregs:1, dmem:1, flag_C:1, flag_N:1, flag_Z:1, flag_V:1, flag_X:1, usp:1;
#endif

#ifdef MMU
mem_word = dmem[ea_pa];
#else
mem_word = dmem[word_addr];
#endif

// For width=1: clear single bit
mask = 16'h8000 >> bit_in_word;
result_word = mem_word & ~mask;

// Write back
#ifdef MMU
dmem[ea_pa] when (~m68k_exc_taken & ~data_exc_taken) = result_word;
#else
dmem[word_addr] when (~m68k_exc_taken & ~data_exc_taken) = result_word;
#endif

// Update CCR based on original bit value
flag_N when (~m68k_exc_taken & ~data_exc_taken) = 1'b0;
flag_Z when (~m68k_exc_taken & ~data_exc_taken) = ~((mem_word >> (4'hF - bit_in_word)) & 16'h0001);
flag_V when (~m68k_exc_taken & ~data_exc_taken) = 1'b0;
flag_C when (~m68k_exc_taken & ~data_exc_taken) = 1'b0;
