// SPDX-License-Identifier: BSD-3-Clause
// MC68010+ MOVE from CCR - Move from Condition Code Register to Dn
// Opcode: 0100 0010 11 000 rrr (42C0-42C7 for Dn mode)
// Operation: Dn[15:0] = {11'b0, X, N, Z, V, C}
// Not privileged (unlike MOVE from SR on 68010+)

isa_state pc[31:0];
var instr[15:0];
isa_state dregs[31:0][2:0];
isa_state aregs[31:0][2:0];
mem dmem[25:0];
isa_state flag_X[0:0];
isa_state flag_N[0:0];
isa_state flag_Z[0:0];
isa_state flag_V[0:0];
isa_state flag_C[0:0];

var dst_reg[2:0];
var mfccr_result[31:0];

// Include interrupt and exception handling aspects
aspect m68k_exception.isa gates pc:2, sr:2, ssp:2, aregs:2, dmem:2, flag_C:2, flag_N:2, flag_Z:2, flag_V:2, flag_X:2, usp:2;
aspect m68k_interrupt.isa gates sr;
#ifdef MMU
aspect mmu/atc_translate_instr.isa gates pc, dmem;
#else
var pc_pa[31:0];
pc_pa = pc;
var pc_pa_delta[31:0];
pc_pa_delta = 32'd0;
#endif

// Fetch instruction
instr = dmem[pc_pa];
assume instr[15:6] == 0b0100001011;  // MOVE from CCR opcode
assume instr[5:3] == 0b000;          // EA mode: Data Register Direct
pc when (~m68k_exc_taken) = pc + 2;

// Decode destination register
dst_reg = instr[2:0];

// Build CCR value: {11'b0, X, N, Z, V, C}
mfccr_result = {16'b0, 11'b0, flag_X, flag_N, flag_Z, flag_V, flag_C};

// Store to destination register (replaces low word, upper word preserved on 68010+)
dregs[dst_reg] when (~m68k_exc_taken) = {dregs[dst_reg][31:16], mfccr_result[15:0]};

// MOVE from CCR does not affect flags
