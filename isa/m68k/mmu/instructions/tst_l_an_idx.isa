// SPDX-License-Identifier: BSD-3-Clause
// M68000 TST.L (An,Xn) - Test long at indexed address (brief format)
// Opcode: 01001010 10 110 AAA

isa_state pc[31:0];
var instr[15:0];
isa_state dregs[31:0][2:0];
isa_state aregs[31:0][2:0];
mem dmem[25:0];
#ifdef MMU
// MMU state (added by MMU preprocessor)
isa_state tc[31:0];
isa_state tt0[31:0];
isa_state tt1[31:0];
isa_state crp[63:0];
isa_state srp[63:0];
isa_state vbr[31:0];
isa_state ssp[31:0];
isa_state usp[31:0];
#endif
isa_state flag_X[0:0];
isa_state flag_N[0:0];
isa_state flag_Z[0:0];
isa_state flag_V[0:0];
isa_state flag_C[0:0];

var base_reg[2:0];
var ext_word[15:0];
var idx_reg[2:0];
var idx_is_addr[0:0];
var idx_is_long[0:0];
var scale[1:0];
var disp8[7:0];
var disp8_ext[31:0];
var raw_idx[31:0];
var idx_val[31:0];
var scaled_idx[31:0];
var addr[31:0];
var data_hi[15:0];
var data_lo[15:0];
var val[31:0];

// Include interrupt and exception handling aspects
aspect m68k_exception.isa gates pc:2, sr:2, ssp:2, aregs:2, dmem:2, flag_C:2, flag_N:2, flag_Z:2, flag_V:2, flag_X:2, usp:2;
aspect m68k_interrupt.isa gates sr;
#ifdef MMU
aspect mmu/atc_translate_instr.isa gates pc, dmem;
#else
var pc_pa[31:0];
pc_pa = pc;
var pc_pa_delta[31:0];
pc_pa_delta = 32'd0;
#endif

// Fetch instruction
instr = dmem[pc_pa];
assume instr[15:8] == 0b01001010;
assume instr[7:6] == 0b10;        // Long
assume instr[5:3] == 0b110;       // EA mode: indexed
pc when (~m68k_exc_taken) = pc + 2;

base_reg = instr[2:0];

// Fetch extension word
ext_word = dmem[pc + pc_pa_delta];
assume ext_word[8] == 0b0;  // Brief format
pc when (~m68k_exc_taken) = pc + 2;

// Decode extension
idx_reg = ext_word[14:12];
idx_is_addr = ext_word[15];
idx_is_long = ext_word[11];
scale = ext_word[10:9];
disp8 = ext_word[7:0];
disp8_ext = {{24{disp8[7]}}, disp8};

// Get index value
raw_idx = idx_is_addr ? aregs[idx_reg] : dregs[idx_reg];
idx_val = idx_is_long ? raw_idx : {{16{raw_idx[15]}}, raw_idx[15:0]};

// Scale index
scaled_idx = scale == 2'b00 ? idx_val :
             scale == 2'b01 ? (idx_val << 1) :
             scale == 2'b10 ? (idx_val << 2) :
                              (idx_val << 3);

// Calculate address
addr = aregs[base_reg] + disp8_ext + scaled_idx;

// Read and test
#ifdef MMU
var mmu_va[31:0];
mmu_va = addr;
var is_write[0:0];
is_write = 1'b0;
aspect mmu/atc_translate_data.isa gates pc:1, sr:1, ssp:1, aregs:1, dmem:1, flag_C:1, flag_N:1, flag_Z:1, flag_V:1, flag_X:1, usp:1;
#endif

#ifdef MMU
data_hi = dmem[ea_pa];
#else
data_hi = dmem[addr];
#endif
#ifdef MMU
data_lo = dmem[ea_pa + 2];
#else
data_lo = dmem[addr + 2];
#endif
val = {data_hi, data_lo};

flag_N when (~m68k_exc_taken & ~data_exc_taken) = val[31];
flag_Z when (~m68k_exc_taken & ~data_exc_taken) = val == 0;
flag_V when (~m68k_exc_taken & ~data_exc_taken) = 1'b0;
flag_C when (~m68k_exc_taken & ~data_exc_taken) = 1'b0;
