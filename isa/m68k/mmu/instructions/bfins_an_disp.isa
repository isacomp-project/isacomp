// SPDX-License-Identifier: BSD-3-Clause
// MC68020 BFINS Dn,d(An){#offset:#width} - Bit Field Insert into memory (displacement)
// Opcode: 1110 1111 11 101 AAA followed by extension word, then 16-bit displacement
// Extension: 0 DDD 0 ooooo 0 wwwww (immediate offset, immediate width)
// Inserts low 'width' bits of Dn into bit field at EA+bit offset

isa_state pc[31:0];
var instr[15:0];
isa_state dregs[31:0][2:0];
isa_state aregs[31:0][2:0];
mem dmem[25:0];
#ifdef MMU
// MMU state (added by MMU preprocessor)
isa_state tc[31:0];
isa_state tt0[31:0];
isa_state tt1[31:0];
isa_state crp[63:0];
isa_state srp[63:0];
isa_state vbr[31:0];
isa_state ssp[31:0];
isa_state usp[31:0];
#endif
isa_state flag_X[0:0];
isa_state flag_N[0:0];
isa_state flag_Z[0:0];
isa_state flag_V[0:0];
isa_state flag_C[0:0];

var addr_reg[2:0];
var bfid_ext[15:0];
var src_reg[2:0];
var offset_field[4:0];
var width_field[4:0];
var width[5:0];
var bfid_disp[15:0];
var disp_ext[31:0];
var base_addr[31:0];
var byte_addr[31:0];
var bit_in_byte[2:0];
var word_addr[31:0];
var bit_in_word[3:0];
var w0[15:0];
var w1[15:0];
var val32[31:0];
var shift_amt[5:0];
var field_mask[31:0];
var shifted_mask[31:0];
var insert_bits[31:0];
var shifted_bits[31:0];
var result32[31:0];
var source[31:0];

// Include interrupt and exception handling aspects
aspect m68k_exception.isa gates pc:2, sr:2, ssp:2, aregs:2, dmem:2, flag_C:2, flag_N:2, flag_Z:2, flag_V:2, flag_X:2, usp:2;
aspect m68k_interrupt.isa gates sr;
#ifdef MMU
aspect mmu/atc_translate_instr.isa gates pc, dmem;
#else
var pc_pa[31:0];
pc_pa = pc;
var pc_pa_delta[31:0];
pc_pa_delta = 32'd0;
#endif

// Fetch instruction
instr = dmem[pc_pa];
assume instr[15:6] == 10'b1110111111;  // BFINS
assume instr[5:3] == 3'b101;           // EA mode: d(An)
pc when (~m68k_exc_taken) = pc + 2;

addr_reg = instr[2:0];

// Fetch extension word
bfid_ext = dmem[pc + pc_pa_delta];
assume bfid_ext[15] == 1'b0;
assume bfid_ext[11] == 1'b0;  // Immediate offset
assume bfid_ext[5] == 1'b0;   // Immediate width
pc when (~m68k_exc_taken) = pc + 2;

src_reg = bfid_ext[14:12];
offset_field = bfid_ext[10:6];
width_field = bfid_ext[4:0];
width = width_field == 0 ? 6'd32 : {1'b0, width_field};

// Fetch 16-bit displacement
bfid_disp = dmem[pc + pc_pa_delta];
pc when (~m68k_exc_taken) = pc + 2;
disp_ext = {{16{bfid_disp[15]}}, bfid_disp};

// Calculate base effective address
base_addr = aregs[addr_reg] + disp_ext;

// Calculate byte address where bit field starts
byte_addr = base_addr + {27'b0, offset_field[4:3]};
bit_in_byte = offset_field[2:0];

// Align to word boundary
word_addr = {byte_addr[31:1], 1'b0};
bit_in_word = {byte_addr[0], bit_in_byte};

// Read 32 bits (two words) for field manipulation
#ifdef MMU
var mmu_va[31:0];
mmu_va = word_addr;
var is_write[0:0];
is_write = 1'b1;
aspect mmu/atc_translate_data.isa gates pc:1, sr:1, ssp:1, aregs:1, dmem:1, flag_C:1, flag_N:1, flag_Z:1, flag_V:1, flag_X:1, usp:1;
#endif

#ifdef MMU
w0 = dmem[ea_pa];
#else
w0 = dmem[word_addr];
#endif
#ifdef MMU
w1 = dmem[ea_pa + 2];
#else
w1 = dmem[word_addr + 2];
#endif
val32 = {w0, w1};

// Get source value
source = dregs[src_reg];

// Create mask and insert value
// bit_in_word is position from MSB of 32-bit value (0-15)
shift_amt = 6'd32 - {2'b0, bit_in_word} - width;
field_mask = (width == 6'd32) ? 32'hFFFFFFFF : ((32'b1 << width) - 1);
shifted_mask = field_mask << shift_amt;
insert_bits = source & field_mask;
shifted_bits = insert_bits << shift_amt;

// Merge: clear field, then insert
result32 = (val32 & ~shifted_mask) | shifted_bits;

// Write back both words
#ifdef MMU
dmem[ea_pa] when (~m68k_exc_taken & ~data_exc_taken) = result32[31:16];
#else
dmem[word_addr] when (~m68k_exc_taken & ~data_exc_taken) = result32[31:16];
#endif
#ifdef MMU
dmem[ea_pa + 2] when (~m68k_exc_taken & ~data_exc_taken) = result32[15:0];
#else
dmem[word_addr + 2] when (~m68k_exc_taken & ~data_exc_taken) = result32[15:0];
#endif

// Update CCR based on inserted field value
flag_N when (~m68k_exc_taken & ~data_exc_taken) = insert_bits[width - 1];
flag_Z when (~m68k_exc_taken & ~data_exc_taken) = insert_bits == 0;
flag_V when (~m68k_exc_taken & ~data_exc_taken) = 1'b0;
flag_C when (~m68k_exc_taken & ~data_exc_taken) = 1'b0;
