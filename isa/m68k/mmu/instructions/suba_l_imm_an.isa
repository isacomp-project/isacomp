// SPDX-License-Identifier: BSD-3-Clause
// M68000 SUBA.L #imm,An - Subtract long immediate from address register
// Opcode: 1001 AAA1 11111 100 followed by 32-bit immediate
// where AAA=dest addr reg
// Note: SUBA does NOT affect condition codes

isa_state pc[31:0];
var instr[15:0];
isa_state dregs[31:0][2:0];
isa_state aregs[31:0][2:0];
mem dmem[25:0];
isa_state flag_X[0:0];
isa_state flag_N[0:0];
isa_state flag_Z[0:0];
isa_state flag_V[0:0];
isa_state flag_C[0:0];

var dst_reg[2:0];
var imm_hi[15:0];
var imm_lo[15:0];
var imm_val[31:0];
var dst_val[31:0];
var result[31:0];

// Include interrupt and exception handling aspects
aspect m68k_exception.isa gates pc:2, sr:2, ssp:2, aregs:2, dmem:2, flag_C:2, flag_N:2, flag_Z:2, flag_V:2, flag_X:2, usp:2;
aspect m68k_interrupt.isa gates sr;
#ifdef MMU
aspect mmu/atc_translate_instr.isa gates pc, dmem;
#else
var pc_pa[31:0];
pc_pa = pc;
var pc_pa_delta[31:0];
pc_pa_delta = 32'd0;
#endif

// Fetch instruction
instr = dmem[pc_pa];
assume instr[15:12] == 0b1001;  // SUBA opcode
assume instr[8:6] == 0b111;     // Opmode: SUBA.L
assume instr[5:3] == 0b111;     // EA mode: Mode 7 (special)
assume instr[2:0] == 0b100;     // EA reg: 4 (immediate)
pc when (~m68k_exc_taken) = pc + 2;

// Decode
dst_reg = instr[11:9];

// Fetch 32-bit immediate (big-endian)
imm_hi = dmem[pc + pc_pa_delta];
pc when (~m68k_exc_taken) = pc + 2;
imm_lo = dmem[pc + pc_pa_delta];
pc when (~m68k_exc_taken) = pc + 2;
imm_val = {imm_hi, imm_lo};

// Execute
dst_val = aregs[dst_reg];
result = dst_val - imm_val;

// Write result
aregs[dst_reg] when (~m68k_exc_taken) = result;

// SUBA does not affect flags
