// SPDX-License-Identifier: BSD-3-Clause
// MC68020 CMPI.L #imm,(bd32,PC) - Compare immediate with PC-relative 32-bit displacement
// Opcode: 0000 1100 10 111 011 followed by 32-bit immediate then full extension word
// For CMPI, immediate operand comes BEFORE the EA extension word
// Full extension word format with index suppressed and 32-bit base displacement
// EA Mode 7, Register 3 with full extension word
//
// NOTE: Cannot use assume statements on ext_word bits because ext_word is
// fetched after instruction decode. The enable signal is generated at decode
// time before ext_word is available.

isa_state pc[31:0];
var instr[15:0];
isa_state dregs[31:0][2:0];
isa_state aregs[31:0][2:0];
mem dmem[25:0];
#ifdef MMU
// MMU state (added by MMU preprocessor)
isa_state tc[31:0];
isa_state tt0[31:0];
isa_state tt1[31:0];
isa_state crp[63:0];
isa_state srp[63:0];
isa_state vbr[31:0];
isa_state ssp[31:0];
isa_state usp[31:0];
#endif
isa_state flag_X[0:0];
isa_state flag_N[0:0];
isa_state flag_Z[0:0];
isa_state flag_V[0:0];
isa_state flag_C[0:0];

var cmpi_d32_ext[15:0];
var disp_hi[15:0];
var disp_lo[15:0];
var disp32[31:0];
var base_pc[31:0];
var eff_addr[31:0];
var imm_hi[15:0];
var imm_lo[15:0];
var imm_val[31:0];
var mem_val_hi[15:0];
var mem_val_lo[15:0];
var mem_val[31:0];
var result[32:0];

// Include interrupt and exception handling aspects
aspect m68k_exception.isa gates pc:2, sr:2, ssp:2, aregs:2, dmem:2, flag_C:2, flag_N:2, flag_Z:2, flag_V:2, flag_X:2, usp:2;
aspect m68k_interrupt.isa gates sr;
#ifdef MMU
aspect mmu/atc_translate_instr.isa gates pc, dmem;
#else
var pc_pa[31:0];
pc_pa = pc;
var pc_pa_delta[31:0];
pc_pa_delta = 32'd0;
#endif

// Fetch instruction
instr = dmem[pc_pa];
assume instr[15:8] == 0b00001100;  // CMPI opcode
assume instr[7:6] == 0b10;         // Size: long
assume instr[5:3] == 0b111;        // EA mode: 7 (PC-relative)
assume instr[2:0] == 0b011;        // EA reg: 3 (full extension)
pc when (~m68k_exc_taken) = pc + 2;

// Fetch 32-bit immediate (big-endian) - comes FIRST before extension word
imm_hi = dmem[pc + pc_pa_delta];
pc when (~m68k_exc_taken) = pc + 2;
imm_lo = dmem[pc + pc_pa_delta];
pc when (~m68k_exc_taken) = pc + 2;
imm_val = {imm_hi, imm_lo};

// PC for address calculation is address of extension word
base_pc = pc;

// Fetch extension word (unique name - read at PC+6 due to 32-bit immediate)
cmpi_d32_ext = dmem[pc + pc_pa_delta];
assume cmpi_d32_ext[8] == 0b1;      // Full format indicator
assume cmpi_d32_ext[5:4] == 0b11;   // BD size = long (32-bit displacement)
pc when (~m68k_exc_taken) = pc + 2;

// Fetch 32-bit displacement (high word first)
disp_hi = dmem[pc + pc_pa_delta];
pc when (~m68k_exc_taken) = pc + 2;
disp_lo = dmem[pc + pc_pa_delta];
pc when (~m68k_exc_taken) = pc + 2;
disp32 = {disp_hi, disp_lo};

// Calculate effective address: PC + displacement
eff_addr = base_pc + disp32;

// Read memory value (32-bit, big-endian)
#ifdef MMU
var mmu_va[31:0];
mmu_va = eff_addr;
var is_write[0:0];
is_write = 1'b0;
aspect mmu/atc_translate_data.isa gates pc:1, sr:1, ssp:1, aregs:1, dmem:1, flag_C:1, flag_N:1, flag_Z:1, flag_V:1, flag_X:1, usp:1;
#endif

#ifdef MMU
mem_val_hi = dmem[ea_pa];
#else
mem_val_hi = dmem[eff_addr];
#endif
#ifdef MMU
mem_val_lo = dmem[ea_pa + 2];
#else
mem_val_lo = dmem[eff_addr + 2];
#endif
mem_val = {mem_val_hi, mem_val_lo};

// Execute comparison (subtract but don't store result)
result = mem_val - imm_val;

// Update CCR (X not affected by CMP)
flag_C when (~m68k_exc_taken & ~data_exc_taken) = imm_val > mem_val;
flag_V when (~m68k_exc_taken & ~data_exc_taken) = (~mem_val[31] & imm_val[31] & result[31]) | (mem_val[31] & ~imm_val[31] & ~result[31]);
flag_Z when (~m68k_exc_taken & ~data_exc_taken) = result[31:0] == 0;
flag_N when (~m68k_exc_taken & ~data_exc_taken) = result[31];
