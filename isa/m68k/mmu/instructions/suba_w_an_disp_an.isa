// SPDX-License-Identifier: BSD-3-Clause
// M68000 SUBA.W d(An),An - Subtract word from displacement memory to address register
// Opcode: 1001 DDD 011 101 AAA followed by 16-bit displacement
// SUBA.W reads a 16-bit word, sign-extends to 32 bits, subtracts from An
// SUBA does NOT affect condition codes

isa_state pc[31:0];
var instr[15:0];
isa_state dregs[31:0][2:0];
isa_state aregs[31:0][2:0];
mem dmem[25:0];
#ifdef MMU
// MMU state (added by MMU preprocessor)
isa_state tc[31:0];
isa_state tt0[31:0];
isa_state tt1[31:0];
isa_state crp[63:0];
isa_state srp[63:0];
isa_state vbr[31:0];
isa_state ssp[31:0];
isa_state usp[31:0];
#endif
isa_state flag_X[0:0];
isa_state flag_N[0:0];
isa_state flag_Z[0:0];
isa_state flag_V[0:0];
isa_state flag_C[0:0];

var dst_reg[2:0];
var base_reg[2:0];
var swda_disp[15:0];
var swda_disp_ext[31:0];
var swda_eff_addr[31:0];
var swda_src_word[15:0];
var swda_src_ext[31:0];
var swda_result[31:0];

// Include interrupt and exception handling aspects
aspect m68k_exception.isa gates pc:2, sr:2, ssp:2, aregs:2, dmem:2, flag_C:2, flag_N:2, flag_Z:2, flag_V:2, flag_X:2, usp:2;
aspect m68k_interrupt.isa gates sr;
#ifdef MMU
aspect mmu/atc_translate_instr.isa gates pc, dmem;
#else
var pc_pa[31:0];
pc_pa = pc;
var pc_pa_delta[31:0];
pc_pa_delta = 32'd0;
#endif

// Fetch instruction
instr = dmem[pc_pa];
assume instr[15:12] == 0b1001;  // SUB/SUBA
assume instr[8:6] == 0b011;     // Opmode: SUBA.W
assume instr[5:3] == 0b101;     // EA mode: d(An)
pc when (~m68k_exc_taken) = pc + 2;

dst_reg = instr[11:9];
base_reg = instr[2:0];

// Fetch displacement
swda_disp = dmem[pc + pc_pa_delta];
pc when (~m68k_exc_taken) = pc + 2;
swda_disp_ext = {{16{swda_disp[15]}}, swda_disp};

// Calculate effective address
swda_eff_addr = aregs[base_reg] + swda_disp_ext;

// Read 16-bit word from memory
#ifdef MMU
var mmu_va[31:0];
mmu_va = swda_eff_addr;
var is_write[0:0];
is_write = 1'b0;
aspect mmu/atc_translate_data.isa gates pc:1, sr:1, ssp:1, aregs:1, dmem:1, flag_C:1, flag_N:1, flag_Z:1, flag_V:1, flag_X:1, usp:1;
#endif

#ifdef MMU
swda_src_word = dmem[ea_pa];
#else
swda_src_word = dmem[swda_eff_addr];
#endif

// Sign-extend word to long
swda_src_ext = {{16{swda_src_word[15]}}, swda_src_word};

// Execute subtraction (SUBA does not affect flags)
swda_result = aregs[dst_reg] - swda_src_ext;
aregs[dst_reg] when (~m68k_exc_taken & ~data_exc_taken) = swda_result;
