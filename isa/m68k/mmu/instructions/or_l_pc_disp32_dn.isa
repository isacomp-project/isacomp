// SPDX-License-Identifier: BSD-3-Clause
// MC68020 OR.L (bd32,PC),Dn - OR long from PC-relative with 32-bit displacement to data register
// Opcode: 1000 DDD0 10111 011 followed by full extension word and 32-bit displacement
// Full extension word format with index suppressed

isa_state pc[31:0];
var instr[15:0];
isa_state dregs[31:0][2:0];
isa_state aregs[31:0][2:0];
mem dmem[25:0];
#ifdef MMU
// MMU state (added by MMU preprocessor)
isa_state tc[31:0];
isa_state tt0[31:0];
isa_state tt1[31:0];
isa_state crp[63:0];
isa_state srp[63:0];
isa_state vbr[31:0];
isa_state ssp[31:0];
isa_state usp[31:0];
#endif
isa_state flag_X[0:0];
isa_state flag_N[0:0];
isa_state flag_Z[0:0];
isa_state flag_V[0:0];
isa_state flag_C[0:0];

var dst_reg[2:0];
var ext_word[15:0];
var disp_hi[15:0];
var disp_lo[15:0];
var disp32[31:0];
var base_pc[31:0];
var eff_addr[31:0];
var data_hi[15:0];
var data_lo[15:0];
var src_val[31:0];
var dst_val[31:0];
var result[31:0];

// Include interrupt and exception handling aspects
aspect m68k_exception.isa gates pc:2, sr:2, ssp:2, aregs:2, dmem:2, flag_C:2, flag_N:2, flag_Z:2, flag_V:2, flag_X:2, usp:2;
aspect m68k_interrupt.isa gates sr;
#ifdef MMU
aspect mmu/atc_translate_instr.isa gates pc, dmem;
#else
var pc_pa[31:0];
pc_pa = pc;
var pc_pa_delta[31:0];
pc_pa_delta = 32'd0;
#endif

// Fetch instruction
instr = dmem[pc_pa];
assume instr[15:12] == 0b1000;  // OR opcode
assume instr[8:6] == 0b010;     // Opmode: long, EA to Dn
assume instr[5:3] == 0b111;     // Source mode: Mode 7 (PC-relative)
assume instr[2:0] == 0b011;     // Source reg: 3 (full extension word)
base_pc = pc + 2;               // PC for address calculation
pc when (~m68k_exc_taken) = pc + 2;

// Decode destination register
dst_reg = instr[11:9];

// Fetch extension word
ext_word = dmem[pc + pc_pa_delta];
assume ext_word[8] == 0b1;      // Full format indicator
assume ext_word[5:4] == 0b11;   // BD size = long (32-bit displacement)
pc when (~m68k_exc_taken) = pc + 2;

// Fetch 32-bit displacement (high word first)
disp_hi = dmem[pc + pc_pa_delta];
pc when (~m68k_exc_taken) = pc + 2;
disp_lo = dmem[pc + pc_pa_delta];
pc when (~m68k_exc_taken) = pc + 2;
disp32 = {disp_hi, disp_lo};

// Calculate effective address: PC + displacement
eff_addr = base_pc + disp32;

// Read from memory (two 16-bit reads for 32-bit value, big-endian)
#ifdef MMU
var mmu_va[31:0];
mmu_va = eff_addr;
var is_write[0:0];
is_write = 1'b0;
aspect mmu/atc_translate_data.isa gates pc:1, sr:1, ssp:1, aregs:1, dmem:1, flag_C:1, flag_N:1, flag_Z:1, flag_V:1, flag_X:1, usp:1;
#endif

#ifdef MMU
data_hi = dmem[ea_pa];
#else
data_hi = dmem[eff_addr];
#endif
#ifdef MMU
data_lo = dmem[ea_pa + 2];
#else
data_lo = dmem[eff_addr + 2];
#endif
src_val = {data_hi, data_lo};

// Execute OR
dst_val = dregs[dst_reg];
result = dst_val | src_val;

// Store result
dregs[dst_reg] when (~m68k_exc_taken & ~data_exc_taken) = result;

// Update CCR (X not affected)
flag_N when (~m68k_exc_taken & ~data_exc_taken) = result[31];
flag_Z when (~m68k_exc_taken & ~data_exc_taken) = result == 0;
flag_V when (~m68k_exc_taken & ~data_exc_taken) = 1'b0;
flag_C when (~m68k_exc_taken & ~data_exc_taken) = 1'b0;
