// SPDX-License-Identifier: BSD-3-Clause
// M68000 MOVE.L An,-(Am) - Move address register to memory with pre-decrement
// Opcode: 0010 MMM1 00 001 SSS
// Pushes address register value to stack (or other pre-decrement destination)

isa_state pc[31:0];
var instr[15:0];
isa_state dregs[31:0][2:0];
isa_state aregs[31:0][2:0];
mem dmem[25:0];
#ifdef MMU
// MMU state (added by MMU preprocessor)
isa_state tc[31:0];
isa_state tt0[31:0];
isa_state tt1[31:0];
isa_state crp[63:0];
isa_state srp[63:0];
isa_state vbr[31:0];
isa_state ssp[31:0];
isa_state usp[31:0];
#endif
isa_state flag_X[0:0];
isa_state flag_N[0:0];
isa_state flag_Z[0:0];
isa_state flag_V[0:0];
isa_state flag_C[0:0];

var src_reg[2:0];
var dst_reg[2:0];
var src_val[31:0];
var eff_addr[31:0];

// Include interrupt and exception handling aspects
aspect m68k_exception.isa gates pc:2, sr:2, ssp:2, aregs:2, dmem:2, flag_C:2, flag_N:2, flag_Z:2, flag_V:2, flag_X:2, usp:2;
aspect m68k_interrupt.isa gates sr;
#ifdef MMU
aspect mmu/atc_translate_instr.isa gates pc, dmem;
#else
var pc_pa[31:0];
pc_pa = pc;
var pc_pa_delta[31:0];
pc_pa_delta = 32'd0;
#endif

// Fetch instruction
instr = dmem[pc_pa];
assume instr[15:12] == 0b0010;  // MOVE.L opcode
assume instr[8:6] == 0b100;     // Destination mode: Pre-decrement
assume instr[5:3] == 0b001;     // Source mode: Address Register Direct
pc when (~m68k_exc_taken) = pc + 2;

// Decode registers
dst_reg = instr[11:9];
src_reg = instr[2:0];

// Get source value from address register
src_val = aregs[src_reg];

// Pre-decrement destination address register by 4 (long size)
eff_addr = aregs[dst_reg] - 4;
aregs[dst_reg] when (~m68k_exc_taken) = eff_addr;

// Write to memory (32-bit, big-endian)
#ifdef MMU
var mmu_va[31:0];
mmu_va = eff_addr;
var is_write[0:0];
is_write = 1'b1;
aspect mmu/atc_translate_data.isa gates pc:1, sr:1, ssp:1, aregs:1, dmem:1, flag_C:1, flag_N:1, flag_Z:1, flag_V:1, flag_X:1, usp:1;
#endif

#ifdef MMU
dmem[ea_pa] when (~m68k_exc_taken & ~data_exc_taken) = src_val[31:16];
#else
dmem[eff_addr] when (~m68k_exc_taken & ~data_exc_taken) = src_val[31:16];
#endif
#ifdef MMU
dmem[ea_pa + 2] when (~m68k_exc_taken & ~data_exc_taken) = src_val[15:0];
#else
dmem[eff_addr + 2] when (~m68k_exc_taken & ~data_exc_taken) = src_val[15:0];
#endif

// Update CCR
flag_N when (~m68k_exc_taken & ~data_exc_taken) = src_val[31];
flag_Z when (~m68k_exc_taken & ~data_exc_taken) = src_val == 0;
flag_V when (~m68k_exc_taken & ~data_exc_taken) = 1'b0;
flag_C when (~m68k_exc_taken & ~data_exc_taken) = 1'b0;
// X not affected

