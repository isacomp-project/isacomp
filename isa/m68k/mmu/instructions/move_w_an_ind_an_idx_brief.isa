// SPDX-License-Identifier: BSD-3-Clause
// M68000 MOVE.W (An),(d8,Am,Xn) - Move word from address register indirect to brief indexed
// Opcode: 0011 DDD 110 010 SSS followed by brief extension word
// DDD=dest addr reg (base), SSS=src addr reg (indirect)
// Source: word at (An), Dest: (d8,Am,Xn)

isa_state pc[31:0];
var instr[15:0];
isa_state dregs[31:0][2:0];
isa_state aregs[31:0][2:0];
mem dmem[25:0];
#ifdef MMU
// MMU state (added by MMU preprocessor)
isa_state tc[31:0];
isa_state tt0[31:0];
isa_state tt1[31:0];
isa_state crp[63:0];
isa_state srp[63:0];
isa_state vbr[31:0];
isa_state ssp[31:0];
isa_state usp[31:0];
#endif
isa_state flag_X[0:0];
isa_state flag_N[0:0];
isa_state flag_Z[0:0];
isa_state flag_V[0:0];
isa_state flag_C[0:0];

var src_reg[2:0];
var base_reg[2:0];
var mwni_ext_word[15:0];
var mwni_idx_is_areg[0:0];
var idx_reg[2:0];
var mwni_idx_is_long[0:0];
var mwni_scale[1:0];
var mwni_disp8[7:0];
var mwni_disp_ext[31:0];
var mwni_idx_raw[31:0];
var mwni_idx_val[31:0];
var mwni_scaled_idx[31:0];
var mwni_src_addr[31:0];
var mwni_dst_addr[31:0];
var mwni_data[15:0];

// Include interrupt and exception handling aspects
aspect m68k_exception.isa gates pc:2, sr:2, ssp:2, aregs:2, dmem:2, flag_C:2, flag_N:2, flag_Z:2, flag_V:2, flag_X:2, usp:2;
aspect m68k_interrupt.isa gates sr;
#ifdef MMU
aspect mmu/atc_translate_instr.isa gates pc, dmem;
#else
var pc_pa[31:0];
pc_pa = pc;
var pc_pa_delta[31:0];
pc_pa_delta = 32'd0;
#endif

// Fetch instruction
instr = dmem[pc_pa];
assume instr[15:12] == 0b0011;  // MOVE.W
assume instr[8:6] == 0b110;     // Dest mode: (d8,An,Xn) indexed
assume instr[5:3] == 0b010;     // Source mode: (An) indirect
pc when (~m68k_exc_taken) = pc + 2;

base_reg = instr[11:9];
src_reg = instr[2:0];

// Fetch brief extension word for destination
mwni_ext_word = dmem[pc + pc_pa_delta];
assume mwni_ext_word[8] == 0b0;  // Brief format
pc when (~m68k_exc_taken) = pc + 2;

// Decode extension word
mwni_idx_is_areg = mwni_ext_word[15];
idx_reg = mwni_ext_word[14:12];
mwni_idx_is_long = mwni_ext_word[11];
mwni_scale = mwni_ext_word[10:9];
mwni_disp8 = mwni_ext_word[7:0];

// Sign-extend displacement
mwni_disp_ext = {{24{mwni_disp8[7]}}, mwni_disp8};

// Get index value
mwni_idx_raw = mwni_idx_is_areg ? aregs[idx_reg] : dregs[idx_reg];
mwni_idx_val = mwni_idx_is_long ? mwni_idx_raw : (mwni_idx_raw[15] ? {16'hFFFF, mwni_idx_raw[15:0]} : {16'h0000, mwni_idx_raw[15:0]});

// Apply scale factor
mwni_scaled_idx = mwni_scale == 0 ? mwni_idx_val :
             mwni_scale == 1 ? (mwni_idx_val << 1) :
             mwni_scale == 2 ? (mwni_idx_val << 2) :
                          (mwni_idx_val << 3);

// Read source from memory: (An) indirect
mwni_src_addr = aregs[src_reg];
mwni_data = dmem[mwni_src_addr];

// Calculate destination effective address
mwni_dst_addr = aregs[base_reg] + mwni_disp_ext + mwni_scaled_idx;

// Write word to memory
#ifdef MMU
var mmu_va[31:0];
mmu_va = mwni_dst_addr;
var is_write[0:0];
is_write = 1'b1;
aspect mmu/atc_translate_data.isa gates pc:1, sr:1, ssp:1, aregs:1, dmem:1, flag_C:1, flag_N:1, flag_Z:1, flag_V:1, flag_X:1, usp:1;
#endif

#ifdef MMU
dmem[ea_pa] when (~m68k_exc_taken & ~data_exc_taken) = mwni_data;
#else
dmem[mwni_dst_addr] when (~m68k_exc_taken & ~data_exc_taken) = mwni_data;
#endif

// Update CCR
flag_N when (~m68k_exc_taken & ~data_exc_taken) = mwni_data[15];
flag_Z when (~m68k_exc_taken & ~data_exc_taken) = mwni_data == 0;
flag_V when (~m68k_exc_taken & ~data_exc_taken) = 1'b0;
flag_C when (~m68k_exc_taken & ~data_exc_taken) = 1'b0;
