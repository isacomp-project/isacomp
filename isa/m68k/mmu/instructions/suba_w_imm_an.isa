// SPDX-License-Identifier: BSD-3-Clause
// M68000 SUBA.W #imm,An - Subtract immediate word from address register (sign-extended)
// Opcode: 1001 DDD 011 111 100 followed by 16-bit immediate
// SUBA does NOT affect condition codes

isa_state pc[31:0];
var instr[15:0];
isa_state dregs[31:0][2:0];
isa_state aregs[31:0][2:0];
mem dmem[25:0];
#ifdef MMU
// MMU state (added by MMU preprocessor)
isa_state tc[31:0];
isa_state tt0[31:0];
isa_state tt1[31:0];
isa_state crp[63:0];
isa_state srp[63:0];
isa_state vbr[31:0];
isa_state ssp[31:0];
isa_state usp[31:0];
#endif
isa_state flag_X[0:0];
isa_state flag_N[0:0];
isa_state flag_Z[0:0];
isa_state flag_V[0:0];
isa_state flag_C[0:0];

var dst_reg[2:0];
var swia_imm[15:0];
var swia_src_val[31:0];
var swia_result[31:0];

// Include interrupt and exception handling aspects
aspect m68k_exception.isa gates pc:2, sr:2, ssp:2, aregs:2, dmem:2, flag_C:2, flag_N:2, flag_Z:2, flag_V:2, flag_X:2, usp:2;
aspect m68k_interrupt.isa gates sr;
#ifdef MMU
aspect mmu/atc_translate_instr.isa gates pc, dmem;
#else
var pc_pa[31:0];
pc_pa = pc;
var pc_pa_delta[31:0];
pc_pa_delta = 32'd0;
#endif

// Fetch instruction
instr = dmem[pc_pa];
assume instr[15:12] == 0b1001;  // SUBA opcode
assume instr[8:6] == 0b011;     // Opmode: SUBA.W
assume instr[5:3] == 0b111;     // EA mode: special
assume instr[2:0] == 0b100;     // EA reg: immediate
pc when (~m68k_exc_taken) = pc + 2;

dst_reg = instr[11:9];

// Fetch immediate word
swia_imm = dmem[pc + pc_pa_delta];
pc when (~m68k_exc_taken) = pc + 2;

// Sign-extend to 32 bits
swia_src_val = {{16{swia_imm[15]}}, swia_imm};

// Execute
swia_result = aregs[dst_reg] - swia_src_val;
aregs[dst_reg] when (~m68k_exc_taken) = swia_result;
