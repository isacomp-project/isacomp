// SPDX-License-Identifier: BSD-3-Clause
// M68000 LEA (d16,PC),An - Load effective address with PC-relative 16-bit displacement
// Opcode: 0100 AAA1 11111 010 followed by 16-bit displacement
// Mode 7, Register 2 = (d16,PC)

isa_state pc[31:0];
var instr[15:0];
isa_state dregs[31:0][2:0];
isa_state aregs[31:0][2:0];
mem dmem[25:0];
isa_state flag_X[0:0];
isa_state flag_N[0:0];
isa_state flag_Z[0:0];
isa_state flag_V[0:0];
isa_state flag_C[0:0];

var dst_reg[2:0];
var disp16[15:0];
var sign_ext_disp[31:0];
var base_pc[31:0];
var eff_addr[31:0];

// Include interrupt and exception handling aspects
aspect m68k_exception.isa gates pc:2, sr:2, ssp:2, aregs:2, dmem:2, flag_C:2, flag_N:2, flag_Z:2, flag_V:2, flag_X:2, usp:2;
aspect m68k_interrupt.isa gates sr;
#ifdef MMU
aspect mmu/atc_translate_instr.isa gates pc, dmem;
#else
var pc_pa[31:0];
pc_pa = pc;
var pc_pa_delta[31:0];
pc_pa_delta = 32'd0;
#endif

// Fetch instruction
instr = dmem[pc_pa];
assume instr[15:12] == 0b0100;  // LEA opcode
assume instr[8:6] == 0b111;     // LEA encoding
assume instr[5:3] == 0b111;     // Mode 7 (PC-relative)
assume instr[2:0] == 0b010;     // Register 2 = (d16,PC)
base_pc = pc + 2;               // PC for address calculation
pc when (~m68k_exc_taken) = pc + 2;

// Decode destination register
dst_reg = instr[11:9];

// Fetch 16-bit displacement
disp16 = dmem[pc + pc_pa_delta];
pc when (~m68k_exc_taken) = pc + 2;

// Sign extend displacement
sign_ext_disp = {{16{disp16[15]}}, disp16};

// Calculate effective address: PC + sign_ext(displacement)
eff_addr = base_pc + sign_ext_disp;

// Store effective address in destination register
aregs[dst_reg] when (~m68k_exc_taken) = eff_addr;

// LEA does not affect flags
