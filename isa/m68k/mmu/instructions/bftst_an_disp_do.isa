// SPDX-License-Identifier: BSD-3-Clause
// MC68020 BFTST d(An){Dn:width} - Test Bit Field in displacement indirect
// Opcode: 1110 1000 11 101 AAA followed by extension word + 16-bit displacement
// Handles register offset (Do=1) with immediate width (Dw=0)

isa_state pc[31:0];
var instr[15:0];
isa_state dregs[31:0][2:0];
isa_state aregs[31:0][2:0];
mem dmem[25:0];
#ifdef MMU
// MMU state (added by MMU preprocessor)
isa_state tc[31:0];
isa_state tt0[31:0];
isa_state tt1[31:0];
isa_state crp[63:0];
isa_state srp[63:0];
isa_state vbr[31:0];
isa_state ssp[31:0];
isa_state usp[31:0];
#endif
isa_state flag_X[0:0];
isa_state flag_N[0:0];
isa_state flag_Z[0:0];
isa_state flag_V[0:0];
isa_state flag_C[0:0];

var bftd_ext[15:0];
var ea_reg[2:0];
var bftd_off_reg[2:0];
var bftd_wf[4:0];
var bftd_width[5:0];
var bftd_bitoff[31:0];
var bftd_byteoff[31:0];
var bftd_disp[15:0];
var bftd_disp_ext[31:0];
var bftd_base[31:0];
var bftd_eff[31:0];
var bftd_waddr[31:0];
var bftd_biw[3:0];
var bftd_mem[15:0];

// Include interrupt and exception handling aspects
aspect m68k_exception.isa gates pc:2, sr:2, ssp:2, aregs:2, dmem:2, flag_C:2, flag_N:2, flag_Z:2, flag_V:2, flag_X:2, usp:2;
aspect m68k_interrupt.isa gates sr;
#ifdef MMU
aspect mmu/atc_translate_instr.isa gates pc, dmem;
#else
var pc_pa[31:0];
pc_pa = pc;
var pc_pa_delta[31:0];
pc_pa_delta = 32'd0;
#endif

// Fetch instruction
instr = dmem[pc_pa];
assume instr[15:6] == 10'b1110100011;  // BFTST
assume instr[5:3] == 3'b101;           // EA mode: d(An)
pc when (~m68k_exc_taken) = pc + 2;

ea_reg = instr[2:0];

// Fetch extension word
bftd_ext = dmem[pc + pc_pa_delta];
assume bftd_ext[15] == 1'b0;
assume bftd_ext[11] == 1'b1;   // Offset is register (Do=1)
assume bftd_ext[5] == 1'b0;    // Width is immediate (Dw=0)
pc when (~m68k_exc_taken) = pc + 2;

bftd_off_reg = bftd_ext[8:6];
bftd_wf = bftd_ext[4:0];
bftd_width = bftd_wf == 0 ? 6'd32 : {1'b0, bftd_wf};

// Fetch 16-bit displacement
bftd_disp = dmem[pc + pc_pa_delta];
pc when (~m68k_exc_taken) = pc + 2;
bftd_disp_ext = bftd_disp[15] ? {16'hFFFF, bftd_disp} : {16'h0000, bftd_disp};

// Get bit offset from register (full 32-bit signed)
bftd_bitoff = dregs[bftd_off_reg];

// Calculate base effective address with displacement
bftd_base = aregs[ea_reg] + bftd_disp_ext;

// Calculate byte address: base + bit_offset/8 (arithmetic shift right by 3)
bftd_byteoff = {bftd_bitoff[31], bftd_bitoff[31], bftd_bitoff[31], bftd_bitoff[31:3]};
bftd_eff = bftd_base + bftd_byteoff;

// Align to word boundary and find bit within word
bftd_waddr = {bftd_eff[31:1], 1'b0};
bftd_biw = {bftd_eff[0], bftd_bitoff[2:0]};

// Read the word
#ifdef MMU
var mmu_va[31:0];
mmu_va = bftd_waddr;
var is_write[0:0];
is_write = 1'b0;
aspect mmu/atc_translate_data.isa gates pc:1, sr:1, ssp:1, aregs:1, dmem:1, flag_C:1, flag_N:1, flag_Z:1, flag_V:1, flag_X:1, usp:1;
#endif

#ifdef MMU
bftd_mem = dmem[ea_pa];
#else
bftd_mem = dmem[bftd_waddr];
#endif

// Update CCR based on bit value (no write-back for BFTST)
flag_N when (~m68k_exc_taken & ~data_exc_taken) = 1'b0;
flag_Z when (~m68k_exc_taken & ~data_exc_taken) = ~((bftd_mem >> (4'hF - bftd_biw)) & 16'h0001);
flag_V when (~m68k_exc_taken & ~data_exc_taken) = 1'b0;
flag_C when (~m68k_exc_taken & ~data_exc_taken) = 1'b0;
