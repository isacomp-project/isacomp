// SPDX-License-Identifier: BSD-3-Clause
// M68000 MOVE.W (d8,An,Xn),(d16,An) - Move word from indexed to displacement
// Opcode: 0011 AAA 101 110 BBB followed by brief extension word, then 16-bit displacement

isa_state pc[31:0];
var instr[15:0];
isa_state dregs[31:0][2:0];
isa_state aregs[31:0][2:0];
mem dmem[25:0];
#ifdef MMU
// MMU state (added by MMU preprocessor)
isa_state tc[31:0];
isa_state tt0[31:0];
isa_state tt1[31:0];
isa_state crp[63:0];
isa_state srp[63:0];
isa_state vbr[31:0];
isa_state ssp[31:0];
isa_state usp[31:0];
#endif
isa_state flag_X[0:0];
isa_state flag_N[0:0];
isa_state flag_Z[0:0];
isa_state flag_V[0:0];
isa_state flag_C[0:0];

var dst_reg[2:0];
var base_reg[2:0];
var mmwid_ext[15:0];
var mmwid_disp8[7:0];
var mmwid_disp_ext[31:0];
var idx_reg[2:0];
var mmwid_idx_is_addr[0:0];
var mmwid_idx_is_long[0:0];
var mmwid_scale[1:0];
var mmwid_raw_idx[31:0];
var mmwid_idx_val[31:0];
var mmwid_scaled_idx[31:0];
var mmwid_src_addr[31:0];
var mmwid_dst_disp[15:0];
var mmwid_dst_disp_ext[31:0];
var mmwid_dst_addr[31:0];
var mmwid_data[15:0];

// Include interrupt and exception handling aspects
aspect m68k_exception.isa gates pc:2, sr:2, ssp:2, aregs:2, dmem:2, flag_C:2, flag_N:2, flag_Z:2, flag_V:2, flag_X:2, usp:2;
aspect m68k_interrupt.isa gates sr;
#ifdef MMU
aspect mmu/atc_translate_instr.isa gates pc, dmem;
#else
var pc_pa[31:0];
pc_pa = pc;
var pc_pa_delta[31:0];
pc_pa_delta = 32'd0;
#endif

// Fetch instruction
instr = dmem[pc_pa];
assume instr[15:12] == 0b0011;  // MOVE.W
assume instr[8:6] == 0b101;     // Dest mode: (d16,An)
assume instr[5:3] == 0b110;     // Source mode: indexed
pc when (~m68k_exc_taken) = pc + 2;

dst_reg = instr[11:9];
base_reg = instr[2:0];

// Fetch brief extension word (for source)
mmwid_ext = dmem[pc + pc_pa_delta];
assume mmwid_ext[8] == 0b0;  // Brief format
pc when (~m68k_exc_taken) = pc + 2;

// Decode source index
idx_reg = mmwid_ext[14:12];
mmwid_idx_is_addr = mmwid_ext[15];
mmwid_idx_is_long = mmwid_ext[11];
mmwid_scale = mmwid_ext[10:9];
mmwid_disp8 = mmwid_ext[7:0];

mmwid_disp_ext = mmwid_disp8[7] ? {24'hFFFFFF, mmwid_disp8} : {24'h000000, mmwid_disp8};
mmwid_raw_idx = mmwid_idx_is_addr ? aregs[idx_reg] : dregs[idx_reg];
mmwid_idx_val = mmwid_idx_is_long ? mmwid_raw_idx : (mmwid_raw_idx[15] ? {16'hFFFF, mmwid_raw_idx[15:0]} : {16'h0000, mmwid_raw_idx[15:0]});

mmwid_scaled_idx = mmwid_scale == 0 ? mmwid_idx_val :
                   mmwid_scale == 1 ? (mmwid_idx_val << 1) :
                   mmwid_scale == 2 ? (mmwid_idx_val << 2) :
                                      (mmwid_idx_val << 3);

// Calculate source effective address
mmwid_src_addr = aregs[base_reg] + mmwid_disp_ext + mmwid_scaled_idx;

// Fetch destination displacement
mmwid_dst_disp = dmem[pc + pc_pa_delta];
pc when (~m68k_exc_taken) = pc + 2;
mmwid_dst_disp_ext = mmwid_dst_disp[15] ? {16'hFFFF, mmwid_dst_disp} : {16'h0000, mmwid_dst_disp};

// Read word from source
#ifdef MMU
var mmu_va[31:0];
mmu_va = mmwid_src_addr;
var is_write[0:0];
is_write = 1'b0;
aspect mmu/atc_translate_data.isa gates pc:1, sr:1, ssp:1, aregs:1, dmem:1, flag_C:1, flag_N:1, flag_Z:1, flag_V:1, flag_X:1, usp:1;
#endif

#ifdef MMU
mmwid_data = dmem[ea_pa];
#else
mmwid_data = dmem[mmwid_src_addr];
#endif

// Calculate destination address and write
mmwid_dst_addr = aregs[dst_reg] + mmwid_dst_disp_ext;
dmem[mmwid_dst_addr] when (~m68k_exc_taken & ~data_exc_taken) = mmwid_data;

// Update CCR
flag_N when (~m68k_exc_taken & ~data_exc_taken) = mmwid_data[15];
flag_Z when (~m68k_exc_taken & ~data_exc_taken) = mmwid_data == 0;
flag_V when (~m68k_exc_taken & ~data_exc_taken) = 1'b0;
flag_C when (~m68k_exc_taken & ~data_exc_taken) = 1'b0;
