// SPDX-License-Identifier: BSD-3-Clause
// MC68020 ADD.L Dn,(bd16,An,Xn) - Add register to full indexed (word BD)
// Opcode: 1101 DDD1 10 110 AAA followed by full extension word + 16-bit BD
// Full ext word: BS=0 (base used), IS=0 (index used), BD=word
// EA = An + sign_ext(bd16) + index_reg * scale

isa_state pc[31:0];
var instr[15:0];
isa_state dregs[31:0][2:0];
isa_state aregs[31:0][2:0];
mem dmem[25:0];
#ifdef MMU
// MMU state (added by MMU preprocessor)
isa_state tc[31:0];
isa_state tt0[31:0];
isa_state tt1[31:0];
isa_state crp[63:0];
isa_state srp[63:0];
isa_state vbr[31:0];
isa_state ssp[31:0];
isa_state usp[31:0];
#endif
isa_state flag_X[0:0];
isa_state flag_N[0:0];
isa_state flag_Z[0:0];
isa_state flag_V[0:0];
isa_state flag_C[0:0];

var src_reg[2:0];
var base_reg[2:0];
var fext[15:0];
var idx_reg[2:0];
var idx_is_addr[0:0];
var idx_is_long[0:0];
var scale[1:0];
var raw_idx[31:0];
var idx_val[31:0];
var scaled_idx[31:0];
var bd16[15:0];
var bd_ext[31:0];
var eff_addr[31:0];
var src_val[31:0];
var mem_hi[15:0];
var mem_lo[15:0];
var dst_val[31:0];
var result[32:0];

// Include interrupt and exception handling aspects
aspect m68k_exception.isa gates pc:2, sr:2, ssp:2, aregs:2, dmem:2, flag_C:2, flag_N:2, flag_Z:2, flag_V:2, flag_X:2, usp:2;
aspect m68k_interrupt.isa gates sr;
#ifdef MMU
aspect mmu/atc_translate_instr.isa gates pc, dmem;
#else
var pc_pa[31:0];
pc_pa = pc;
var pc_pa_delta[31:0];
pc_pa_delta = 32'd0;
#endif

// Fetch instruction
instr = dmem[pc_pa];
assume instr[15:12] == 0b1101;  // ADD
assume instr[8:6] == 0b110;     // Opmode: long, Dn to EA
assume instr[5:3] == 0b110;     // EA mode: indexed
pc when (~m68k_exc_taken) = pc + 2;

src_reg = instr[11:9];
base_reg = instr[2:0];

// Fetch full extension word
fext = dmem[pc + pc_pa_delta];
assume fext[8] == 0b1;       // Full format
assume fext[7] == 0b0;       // Base NOT suppressed (BS=0)
assume fext[6] == 0b0;       // Index NOT suppressed (IS=0)
assume fext[5:4] == 0b10;    // BD size = word (16-bit)
assume fext[3:0] == 0b0000;  // No memory indirect
pc when (~m68k_exc_taken) = pc + 2;

// Decode index
idx_reg = fext[14:12];
idx_is_addr = fext[15];
idx_is_long = fext[11];
scale = fext[10:9];

raw_idx = idx_is_addr ? aregs[idx_reg] : dregs[idx_reg];
idx_val = idx_is_long ? raw_idx : (raw_idx[15] ? {16'hFFFF, raw_idx[15:0]} : {16'h0000, raw_idx[15:0]});

scaled_idx = scale == 2'b00 ? idx_val :
             scale == 2'b01 ? (idx_val << 1) :
             scale == 2'b10 ? (idx_val << 2) :
                              (idx_val << 3);

// Fetch 16-bit base displacement
bd16 = dmem[pc + pc_pa_delta];
pc when (~m68k_exc_taken) = pc + 2;
bd_ext = {{16{bd16[15]}}, bd16};

// Calculate effective address
eff_addr = aregs[base_reg] + bd_ext + scaled_idx;

// MMU translation
#ifdef MMU
var mmu_va[31:0];
mmu_va = eff_addr;
var is_write[0:0];
is_write = 1'b1;
aspect mmu/atc_translate_data.isa gates pc:1, sr:1, ssp:1, aregs:1, dmem:1, flag_C:1, flag_N:1, flag_Z:1, flag_V:1, flag_X:1, usp:1;
#endif

// Read memory
#ifdef MMU
mem_hi = dmem[ea_pa];
#else
mem_hi = dmem[eff_addr];
#endif
#ifdef MMU
mem_lo = dmem[ea_pa + 2];
#else
mem_lo = dmem[eff_addr + 2];
#endif
dst_val = {mem_hi, mem_lo};

// Execute ADD
src_val = dregs[src_reg];
result = dst_val + src_val;

// Write result
#ifdef MMU
dmem[ea_pa] when (~m68k_exc_taken & ~data_exc_taken) = result[31:16];
#else
dmem[eff_addr] when (~m68k_exc_taken & ~data_exc_taken) = result[31:16];
#endif
#ifdef MMU
dmem[ea_pa + 2] when (~m68k_exc_taken & ~data_exc_taken) = result[15:0];
#else
dmem[eff_addr + 2] when (~m68k_exc_taken & ~data_exc_taken) = result[15:0];
#endif

// Update CCR
flag_X when (~m68k_exc_taken & ~data_exc_taken) = result[32];
flag_C when (~m68k_exc_taken & ~data_exc_taken) = result[32];
flag_V when (~m68k_exc_taken & ~data_exc_taken) = (~dst_val[31] & ~src_val[31] & result[31]) | (dst_val[31] & src_val[31] & ~result[31]);
flag_Z when (~m68k_exc_taken & ~data_exc_taken) = result[31:0] == 0;
flag_N when (~m68k_exc_taken & ~data_exc_taken) = result[31];
