// SPDX-License-Identifier: BSD-3-Clause
// MC68020 TST.L (bd32,Xn) - Test Long with full indexed (base suppressed)
// Opcode: 0100 1010 10 110 AAA followed by full extension word + 32-bit BD
// Full ext word: BS=1 (base suppressed), IS=0 (index not suppressed), BD=long
// EA = bd32 + index_reg * scale

isa_state pc[31:0];
var instr[15:0];
isa_state dregs[31:0][2:0];
isa_state aregs[31:0][2:0];
mem dmem[25:0];
#ifdef MMU
// MMU state (added by MMU preprocessor)
isa_state tc[31:0];
isa_state tt0[31:0];
isa_state tt1[31:0];
isa_state crp[63:0];
isa_state srp[63:0];
isa_state vbr[31:0];
isa_state ssp[31:0];
isa_state usp[31:0];
#endif
isa_state flag_X[0:0];
isa_state flag_N[0:0];
isa_state flag_Z[0:0];
isa_state flag_V[0:0];
isa_state flag_C[0:0];

var tst_ext[15:0];
var idx_reg[2:0];
var idx_is_addr[0:0];
var idx_is_long[0:0];
var scale[1:0];
var raw_idx[31:0];
var idx_val[31:0];
var scaled_idx[31:0];
var bd_hi[15:0];
var bd_lo[15:0];
var bd32[31:0];
var eff_addr[31:0];
var data_hi[15:0];
var data_lo[15:0];
var data[31:0];

// Include interrupt and exception handling aspects
aspect m68k_exception.isa gates pc:2, sr:2, ssp:2, aregs:2, dmem:2, flag_C:2, flag_N:2, flag_Z:2, flag_V:2, flag_X:2, usp:2;
aspect m68k_interrupt.isa gates sr;
#ifdef MMU
aspect mmu/atc_translate_instr.isa gates pc, dmem;
#else
var pc_pa[31:0];
pc_pa = pc;
var pc_pa_delta[31:0];
pc_pa_delta = 32'd0;
#endif

// Fetch instruction
instr = dmem[pc_pa];
assume instr[15:8] == 0b01001010;  // TST opcode
assume instr[7:6] == 0b10;         // Size: long
assume instr[5:3] == 0b110;        // EA mode: indexed
pc when (~m68k_exc_taken) = pc + 2;

// Fetch full extension word
tst_ext = dmem[pc + pc_pa_delta];
assume tst_ext[8] == 0b1;       // Full format
assume tst_ext[7] == 0b1;       // Base suppressed (BS=1)
assume tst_ext[6] == 0b0;       // Index NOT suppressed (IS=0)
assume tst_ext[5:4] == 0b11;    // BD size = long
assume tst_ext[3:0] == 0b0000;  // No memory indirect
pc when (~m68k_exc_taken) = pc + 2;

// Decode index
idx_reg = tst_ext[14:12];
idx_is_addr = tst_ext[15];
idx_is_long = tst_ext[11];
scale = tst_ext[10:9];

raw_idx = idx_is_addr ? aregs[idx_reg] : dregs[idx_reg];
idx_val = idx_is_long ? raw_idx : {{16{raw_idx[15]}}, raw_idx[15:0]};

scaled_idx = scale == 2'b00 ? idx_val :
             scale == 2'b01 ? (idx_val << 1) :
             scale == 2'b10 ? (idx_val << 2) :
                              (idx_val << 3);

// Fetch 32-bit base displacement
bd_hi = dmem[pc + pc_pa_delta];
pc when (~m68k_exc_taken) = pc + 2;
bd_lo = dmem[pc + pc_pa_delta];
pc when (~m68k_exc_taken) = pc + 2;
bd32 = {bd_hi, bd_lo};

// Calculate effective address (no base register)
eff_addr = bd32 + scaled_idx;

// Read memory
#ifdef MMU
var mmu_va[31:0];
mmu_va = eff_addr;
var is_write[0:0];
is_write = 1'b0;
aspect mmu/atc_translate_data.isa gates pc:1, sr:1, ssp:1, aregs:1, dmem:1, flag_C:1, flag_N:1, flag_Z:1, flag_V:1, flag_X:1, usp:1;
#endif

#ifdef MMU
data_hi = dmem[ea_pa];
#else
data_hi = dmem[eff_addr];
#endif
#ifdef MMU
data_lo = dmem[ea_pa + 2];
#else
data_lo = dmem[eff_addr + 2];
#endif
data = {data_hi, data_lo};

// Update CCR
flag_N when (~m68k_exc_taken & ~data_exc_taken) = data[31];
flag_Z when (~m68k_exc_taken & ~data_exc_taken) = data == 0;
flag_V when (~m68k_exc_taken & ~data_exc_taken) = 1'b0;
flag_C when (~m68k_exc_taken & ~data_exc_taken) = 1'b0;
