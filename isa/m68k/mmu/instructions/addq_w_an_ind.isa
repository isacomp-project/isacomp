// SPDX-License-Identifier: BSD-3-Clause
// M68000 ADDQ.W #data,(An) - Add quick word to memory indirect
// Opcode: 0101 DDD0 01 010 AAA

isa_state pc[31:0];
var instr[15:0];
isa_state dregs[31:0][2:0];
isa_state aregs[31:0][2:0];
mem dmem[25:0];
#ifdef MMU
// MMU state (added by MMU preprocessor)
isa_state tc[31:0];
isa_state tt0[31:0];
isa_state tt1[31:0];
isa_state crp[63:0];
isa_state srp[63:0];
isa_state vbr[31:0];
isa_state ssp[31:0];
isa_state usp[31:0];
#endif
isa_state flag_X[0:0];
isa_state flag_N[0:0];
isa_state flag_Z[0:0];
isa_state flag_V[0:0];
isa_state flag_C[0:0];

var aqwi_qdata[2:0];
var aqwi_imm[15:0];
var aqwi_reg[2:0];
var aqwi_addr[31:0];
var aqwi_dst[15:0];
var aqwi_result[16:0];

aspect m68k_exception.isa gates pc:2, sr:2, ssp:2, aregs:2, dmem:2, flag_C:2, flag_N:2, flag_Z:2, flag_V:2, flag_X:2, usp:2;
aspect m68k_interrupt.isa gates sr;
#ifdef MMU
aspect mmu/atc_translate_instr.isa gates pc, dmem;
#else
var pc_pa[31:0];
pc_pa = pc;
var pc_pa_delta[31:0];
pc_pa_delta = 32'd0;
#endif

instr = dmem[pc_pa];
assume instr[15:12] == 0b0101;
assume instr[8] == 0b0;
assume instr[7:6] == 0b01;
assume instr[5:3] == 0b010;     // EA: (An)
pc when (~m68k_exc_taken) = pc + 2;

aqwi_qdata = instr[11:9];
aqwi_reg = instr[2:0];
aqwi_imm = aqwi_qdata == 0 ? 16'h0008 : {13'b0, aqwi_qdata};

aqwi_addr = aregs[aqwi_reg];
#ifdef MMU
var mmu_va[31:0];
mmu_va = aqwi_addr;
var is_write[0:0];
is_write = 1'b1;
aspect mmu/atc_translate_data.isa gates pc:1, sr:1, ssp:1, aregs:1, dmem:1, flag_C:1, flag_N:1, flag_Z:1, flag_V:1, flag_X:1, usp:1;
#endif

#ifdef MMU
aqwi_dst = dmem[ea_pa];
#else
aqwi_dst = dmem[aqwi_addr];
#endif
aqwi_result = aqwi_dst + aqwi_imm;
#ifdef MMU
dmem[ea_pa] when (~m68k_exc_taken & ~data_exc_taken) = aqwi_result[15:0];
#else
dmem[aqwi_addr] when (~m68k_exc_taken & ~data_exc_taken) = aqwi_result[15:0];
#endif

flag_X when (~m68k_exc_taken & ~data_exc_taken) = aqwi_result[16];
flag_C when (~m68k_exc_taken & ~data_exc_taken) = aqwi_result[16];
flag_V when (~m68k_exc_taken & ~data_exc_taken) = (~aqwi_dst[15] & ~aqwi_imm[15] & aqwi_result[15]) | (aqwi_dst[15] & aqwi_imm[15] & ~aqwi_result[15]);
flag_Z when (~m68k_exc_taken & ~data_exc_taken) = aqwi_result[15:0] == 0;
flag_N when (~m68k_exc_taken & ~data_exc_taken) = aqwi_result[15];
