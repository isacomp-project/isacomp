// SPDX-License-Identifier: BSD-3-Clause
// M68000 SUBA.W Dn,An - Subtract word from data register to address register (sign-extended)
// Opcode: 1001 AAA0 11000 DDD where AAA=dest addr reg, DDD=src data reg
// Operation: An - sign_extend(Dn[15:0]) -> An
// Note: SUBA does NOT affect condition codes

isa_state pc[31:0];
var instr[15:0];
isa_state dregs[31:0][2:0];
isa_state aregs[31:0][2:0];
mem dmem[25:0];
isa_state flag_X[0:0];
isa_state flag_N[0:0];
isa_state flag_Z[0:0];
isa_state flag_V[0:0];
isa_state flag_C[0:0];

var src_reg[2:0];
var dst_reg[2:0];
var subaw_src_word[15:0];
var subaw_src_val[31:0];
var subaw_dst_val[31:0];
var subaw_result[31:0];

// Include interrupt and exception handling aspects
aspect m68k_exception.isa gates pc:2, sr:2, ssp:2, aregs:2, dmem:2, flag_C:2, flag_N:2, flag_Z:2, flag_V:2, flag_X:2, usp:2;
aspect m68k_interrupt.isa gates sr;
#ifdef MMU
aspect mmu/atc_translate_instr.isa gates pc, dmem;
#else
var pc_pa[31:0];
pc_pa = pc;
var pc_pa_delta[31:0];
pc_pa_delta = 32'd0;
#endif

// Fetch instruction
instr = dmem[pc_pa];
assume instr[15:12] == 0b1001;  // SUBA opcode
assume instr[8:6] == 0b011;     // Opmode: SUBA.W
assume instr[5:3] == 0b000;     // EA mode: Data Register Direct
pc when (~m68k_exc_taken) = pc + 2;

// Decode
dst_reg = instr[11:9];
src_reg = instr[2:0];

// Get source word from data register and sign-extend
subaw_src_word = dregs[src_reg][15:0];
subaw_src_val = {{16{subaw_src_word[15]}}, subaw_src_word};  // Sign extend to 32 bits

// Execute
subaw_dst_val = aregs[dst_reg];
subaw_result = subaw_dst_val - subaw_src_val;

// Write result
aregs[dst_reg] when (~m68k_exc_taken) = subaw_result;

// SUBA does not affect flags
