// SPDX-License-Identifier: BSD-3-Clause
// M68000 EORI to CCR - Exclusive OR immediate with Condition Code Register
// Opcode: 0000 1010 0011 1100 followed by 16-bit word (low byte used)
// Operation: CCR = CCR ^ immediate_byte
// Affects all CCR flags (X, N, Z, V, C) based on XOR operation

isa_state pc[31:0];
var instr[15:0];
isa_state dregs[31:0][2:0];
isa_state aregs[31:0][2:0];
mem dmem[25:0];
isa_state flag_X[0:0];
isa_state flag_N[0:0];
isa_state flag_Z[0:0];
isa_state flag_V[0:0];
isa_state flag_C[0:0];

var imm_word[15:0];
var imm_byte[7:0];

// Include interrupt and exception handling aspects
aspect m68k_exception.isa gates pc:2, sr:2, ssp:2, aregs:2, dmem:2, flag_C:2, flag_N:2, flag_Z:2, flag_V:2, flag_X:2, usp:2;
aspect m68k_interrupt.isa gates sr;
#ifdef MMU
aspect mmu/atc_translate_instr.isa gates pc, dmem;
#else
var pc_pa[31:0];
pc_pa = pc;
var pc_pa_delta[31:0];
pc_pa_delta = 32'd0;
#endif

// Fetch instruction
instr = dmem[pc_pa];
assume instr == 16'h0A3C;  // EORI to CCR opcode
pc when (~m68k_exc_taken) = pc + 2;

// Fetch immediate word (only low byte is used)
imm_word = dmem[pc + pc_pa_delta];
pc when (~m68k_exc_taken) = pc + 2;
imm_byte = imm_word[7:0];

// Execute - XOR each flag bit with corresponding immediate bit
// CCR bits: bit4=X, bit3=N, bit2=Z, bit1=V, bit0=C
flag_X when (~m68k_exc_taken) = flag_X ^ imm_byte[4];
flag_N when (~m68k_exc_taken) = flag_N ^ imm_byte[3];
flag_Z when (~m68k_exc_taken) = flag_Z ^ imm_byte[2];
flag_V when (~m68k_exc_taken) = flag_V ^ imm_byte[1];
flag_C when (~m68k_exc_taken) = flag_C ^ imm_byte[0];
