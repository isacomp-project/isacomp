// SPDX-License-Identifier: BSD-3-Clause
// MC68020 MOVEA.L (bd16,An,Xn),Am - Move address from full indexed (word BD) to address register
// Opcode: 0010 DDD 001 110 SSS followed by full extension word + 16-bit BD
// Full ext: BS=0 (base used), IS=0 (index used), BD=word, no indirect
// EA = An + bd16 + index * scale
// MOVEA does NOT affect CCR

isa_state pc[31:0];
var instr[15:0];
isa_state dregs[31:0][2:0];
isa_state aregs[31:0][2:0];
mem dmem[25:0];
#ifdef MMU
// MMU state (added by MMU preprocessor)
isa_state tc[31:0];
isa_state tt0[31:0];
isa_state tt1[31:0];
isa_state crp[63:0];
isa_state srp[63:0];
isa_state vbr[31:0];
isa_state ssp[31:0];
isa_state usp[31:0];
#endif
isa_state flag_X[0:0];
isa_state flag_N[0:0];
isa_state flag_Z[0:0];
isa_state flag_V[0:0];
isa_state flag_C[0:0];

var dst_reg[2:0];
var base_reg[2:0];
var mafwd_ext[15:0];
var idx_reg[2:0];
var mafwd_idx_is_addr[0:0];
var mafwd_idx_is_long[0:0];
var mafwd_scale[1:0];
var mafwd_raw_idx[31:0];
var mafwd_idx_val[31:0];
var mafwd_scaled_idx[31:0];
var mafwd_bd16[15:0];
var mafwd_bd_ext[31:0];
var mafwd_eff_addr[31:0];
var mafwd_data_hi[15:0];
var mafwd_data_lo[15:0];
var mafwd_data[31:0];

// Include interrupt and exception handling aspects
aspect m68k_exception.isa gates pc:2, sr:2, ssp:2, aregs:2, dmem:2, flag_C:2, flag_N:2, flag_Z:2, flag_V:2, flag_X:2, usp:2;
aspect m68k_interrupt.isa gates sr;
#ifdef MMU
aspect mmu/atc_translate_instr.isa gates pc, dmem;
#else
var pc_pa[31:0];
pc_pa = pc;
var pc_pa_delta[31:0];
pc_pa_delta = 32'd0;
#endif

// Fetch instruction
instr = dmem[pc_pa];
assume instr[15:12] == 0b0010;  // MOVE.L
assume instr[8:6] == 0b001;     // Dest mode: An (MOVEA)
assume instr[5:3] == 0b110;     // Source mode: indexed
pc when (~m68k_exc_taken) = pc + 2;

dst_reg = instr[11:9];
base_reg = instr[2:0];

// Fetch full extension word
mafwd_ext = dmem[pc + pc_pa_delta];
assume mafwd_ext[8] == 0b1;       // Full format
assume mafwd_ext[7] == 0b0;       // Base NOT suppressed (BS=0)
assume mafwd_ext[6] == 0b0;       // Index NOT suppressed (IS=0)
assume mafwd_ext[5:4] == 0b10;    // BD size = word
assume mafwd_ext[3:0] == 0b0000;  // No memory indirect
pc when (~m68k_exc_taken) = pc + 2;

// Decode index
idx_reg = mafwd_ext[14:12];
mafwd_idx_is_addr = mafwd_ext[15];
mafwd_idx_is_long = mafwd_ext[11];
mafwd_scale = mafwd_ext[10:9];

mafwd_raw_idx = mafwd_idx_is_addr ? aregs[idx_reg] : dregs[idx_reg];
mafwd_idx_val = mafwd_idx_is_long ? mafwd_raw_idx : {{16{mafwd_raw_idx[15]}}, mafwd_raw_idx[15:0]};

mafwd_scaled_idx = mafwd_scale == 2'b00 ? mafwd_idx_val :
                   mafwd_scale == 2'b01 ? (mafwd_idx_val << 1) :
                   mafwd_scale == 2'b10 ? (mafwd_idx_val << 2) :
                                          (mafwd_idx_val << 3);

// Fetch 16-bit base displacement
mafwd_bd16 = dmem[pc + pc_pa_delta];
pc when (~m68k_exc_taken) = pc + 2;
mafwd_bd_ext = {{16{mafwd_bd16[15]}}, mafwd_bd16};

// Calculate effective address
mafwd_eff_addr = aregs[base_reg] + mafwd_bd_ext + mafwd_scaled_idx;

// Read 32-bit data
#ifdef MMU
var mmu_va[31:0];
mmu_va = mafwd_eff_addr;
var is_write[0:0];
is_write = 1'b0;
aspect mmu/atc_translate_data.isa gates pc:1, sr:1, ssp:1, aregs:1, dmem:1, flag_C:1, flag_N:1, flag_Z:1, flag_V:1, flag_X:1, usp:1;
#endif

#ifdef MMU
mafwd_data_hi = dmem[ea_pa];
#else
mafwd_data_hi = dmem[mafwd_eff_addr];
#endif
#ifdef MMU
mafwd_data_lo = dmem[ea_pa + 2];
#else
mafwd_data_lo = dmem[mafwd_eff_addr + 2];
#endif
mafwd_data = {mafwd_data_hi, mafwd_data_lo};

// Store in address register (MOVEA does NOT affect CCR)
aregs[dst_reg] when (~m68k_exc_taken & ~data_exc_taken) = mafwd_data;
