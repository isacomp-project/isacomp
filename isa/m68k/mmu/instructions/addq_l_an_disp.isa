// SPDX-License-Identifier: BSD-3-Clause
// M68000 ADDQ.L #data,d(An) - Add quick to long in memory (displacement)
// Opcode: 0101 DDD0 10101 AAA followed by 16-bit displacement
// DDD=data (0=8, 1-7=1-7), AAA=addr reg

isa_state pc[31:0];
var instr[15:0];
isa_state dregs[31:0][2:0];
isa_state aregs[31:0][2:0];
mem dmem[25:0];
#ifdef MMU
// MMU state (added by MMU preprocessor)
isa_state tc[31:0];
isa_state tt0[31:0];
isa_state tt1[31:0];
isa_state crp[63:0];
isa_state srp[63:0];
isa_state vbr[31:0];
isa_state ssp[31:0];
isa_state usp[31:0];
#endif
isa_state flag_X[0:0];
isa_state flag_N[0:0];
isa_state flag_Z[0:0];
isa_state flag_V[0:0];
isa_state flag_C[0:0];

var addr_reg[2:0];
var quick_data[2:0];
var imm_val[31:0];
var disp[15:0];
var disp_ext[31:0];
var addr[31:0];
var dst_hi[15:0];
var dst_lo[15:0];
var dst_val[31:0];
var result[32:0];

// Include interrupt and exception handling aspects
aspect m68k_exception.isa gates pc:2, sr:2, ssp:2, aregs:2, dmem:2, flag_C:2, flag_N:2, flag_Z:2, flag_V:2, flag_X:2, usp:2;
aspect m68k_interrupt.isa gates sr;
#ifdef MMU
aspect mmu/atc_translate_instr.isa gates pc, dmem;
#else
var pc_pa[31:0];
pc_pa = pc;
var pc_pa_delta[31:0];
pc_pa_delta = 32'd0;
#endif

// Fetch instruction
instr = dmem[pc_pa];
assume instr[15:12] == 0b0101;  // ADDQ opcode
assume instr[8] == 0;           // ADDQ (not SUBQ)
assume instr[7:6] == 0b10;      // Size: long
assume instr[5:3] == 0b101;     // EA mode: d(An)
pc when (~m68k_exc_taken) = pc + 2;

// Decode
quick_data = instr[11:9];
addr_reg = instr[2:0];

// Fetch 16-bit displacement
disp = dmem[pc + pc_pa_delta];
pc when (~m68k_exc_taken) = pc + 2;
disp_ext = {{16{disp[15]}}, disp};

// Convert quick data (0 means 8, 1-7 means 1-7)
imm_val = quick_data == 0 ? 32'h00000008 : {{29{1'b0}}, quick_data};

// Calculate effective address
addr = aregs[addr_reg] + disp_ext;

// Read destination from memory
#ifdef MMU
var mmu_va[31:0];
mmu_va = addr;
var is_write[0:0];
is_write = 1'b1;
aspect mmu/atc_translate_data.isa gates pc:1, sr:1, ssp:1, aregs:1, dmem:1, flag_C:1, flag_N:1, flag_Z:1, flag_V:1, flag_X:1, usp:1;
#endif

#ifdef MMU
dst_hi = dmem[ea_pa];
#else
dst_hi = dmem[addr];
#endif
#ifdef MMU
dst_lo = dmem[ea_pa + 2];
#else
dst_lo = dmem[addr + 2];
#endif
dst_val = {dst_hi, dst_lo};

// Execute
result = dst_val + imm_val;

// Write result back to memory
#ifdef MMU
dmem[ea_pa] when (~m68k_exc_taken & ~data_exc_taken) = result[31:16];
#else
dmem[addr] when (~m68k_exc_taken & ~data_exc_taken) = result[31:16];
#endif
#ifdef MMU
dmem[ea_pa + 2] when (~m68k_exc_taken & ~data_exc_taken) = result[15:0];
#else
dmem[addr + 2] when (~m68k_exc_taken & ~data_exc_taken) = result[15:0];
#endif

// Update CCR
flag_X when (~m68k_exc_taken & ~data_exc_taken) = result[32];
flag_C when (~m68k_exc_taken & ~data_exc_taken) = result[32];
flag_V when (~m68k_exc_taken & ~data_exc_taken) = (~dst_val[31] & ~imm_val[31] & result[31]) | (dst_val[31] & imm_val[31] & ~result[31]);
flag_Z when (~m68k_exc_taken & ~data_exc_taken) = result[31:0] == 0;
flag_N when (~m68k_exc_taken & ~data_exc_taken) = result[31];
