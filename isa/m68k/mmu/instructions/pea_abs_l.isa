// SPDX-License-Identifier: BSD-3-Clause
// M68000 PEA (xxx).L - Push Effective Address (absolute long)
// Opcode: 0100 1000 01 111 001 (0x4879) followed by 32-bit address
// Pushes the 32-bit address onto the stack

isa_state pc[31:0];
var instr[15:0];
isa_state dregs[31:0][2:0];
isa_state aregs[31:0][2:0];
mem dmem[25:0];
#ifdef MMU
// MMU state (added by MMU preprocessor)
isa_state tc[31:0];
isa_state tt0[31:0];
isa_state tt1[31:0];
isa_state crp[63:0];
isa_state srp[63:0];
isa_state vbr[31:0];
isa_state ssp[31:0];
isa_state usp[31:0];
#endif
isa_state flag_X[0:0];
isa_state flag_N[0:0];
isa_state flag_Z[0:0];
isa_state flag_V[0:0];
isa_state flag_C[0:0];

var addr_hi[15:0];
var addr_lo[15:0];
var addr[31:0];
var sp[31:0];

// Include interrupt and exception handling aspects
aspect m68k_exception.isa gates pc:2, sr:2, ssp:2, aregs:2, dmem:2, flag_C:2, flag_N:2, flag_Z:2, flag_V:2, flag_X:2, usp:2;
aspect m68k_interrupt.isa gates sr;
#ifdef MMU
aspect mmu/atc_translate_instr.isa gates pc, dmem;
#else
var pc_pa[31:0];
pc_pa = pc;
var pc_pa_delta[31:0];
pc_pa_delta = 32'd0;
#endif

// Fetch instruction
instr = dmem[pc_pa];
assume instr[15:6] == 0b0100100001;  // PEA opcode
assume instr[5:3] == 0b111;          // Special EA mode
assume instr[2:0] == 0b001;          // Absolute long
pc when (~m68k_exc_taken) = pc + 2;

// Fetch 32-bit address
addr_hi = dmem[pc + pc_pa_delta];
pc when (~m68k_exc_taken) = pc + 2;
addr_lo = dmem[pc + pc_pa_delta];
pc when (~m68k_exc_taken) = pc + 2;
addr = {addr_hi, addr_lo};

// Push address onto stack (predecrement A7)
sp = aregs[7] - 4;
#ifdef MMU
var mmu_va[31:0];
mmu_va = sp;
var is_write[0:0];
is_write = 1'b1;
aspect mmu/atc_translate_data.isa gates pc:1, sr:1, ssp:1, aregs:1, dmem:1, flag_C:1, flag_N:1, flag_Z:1, flag_V:1, flag_X:1, usp:1;
#endif

#ifdef MMU
dmem[ea_pa] when (~m68k_exc_taken & ~data_exc_taken) = addr[31:16];
#else
dmem[sp] when (~m68k_exc_taken & ~data_exc_taken) = addr[31:16];
#endif
#ifdef MMU
dmem[ea_pa + 2] when (~m68k_exc_taken & ~data_exc_taken) = addr[15:0];
#else
dmem[sp + 2] when (~m68k_exc_taken & ~data_exc_taken) = addr[15:0];
#endif
aregs[7] when (~m68k_exc_taken & ~data_exc_taken) = sp;

// PEA does not affect CCR
