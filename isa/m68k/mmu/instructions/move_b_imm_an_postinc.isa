// SPDX-License-Identifier: BSD-3-Clause
// M68000 MOVE.B #imm,(An)+ - Move immediate byte to memory with postincrement
// Opcode: 0001 AAA 011 111 100 followed by byte immediate

isa_state pc[31:0];
var instr[15:0];
isa_state dregs[31:0][2:0];
isa_state aregs[31:0][2:0];
mem dmem[25:0];
#ifdef MMU
// MMU state (added by MMU preprocessor)
isa_state tc[31:0];
isa_state tt0[31:0];
isa_state tt1[31:0];
isa_state crp[63:0];
isa_state srp[63:0];
isa_state vbr[31:0];
isa_state ssp[31:0];
isa_state usp[31:0];
#endif
isa_state flag_X[0:0];
isa_state flag_N[0:0];
isa_state flag_Z[0:0];
isa_state flag_V[0:0];
isa_state flag_C[0:0];

var dst_reg[2:0];
var mbipa_imm[15:0];
var mbipa_byte[7:0];
var mbipa_addr[31:0];
var mbipa_word[15:0];
var mbipa_new[15:0];

aspect m68k_exception.isa gates pc:2, sr:2, ssp:2, aregs:2, dmem:2, flag_C:2, flag_N:2, flag_Z:2, flag_V:2, flag_X:2, usp:2;
aspect m68k_interrupt.isa gates sr;
#ifdef MMU
aspect mmu/atc_translate_instr.isa gates pc, dmem;
#else
var pc_pa[31:0];
pc_pa = pc;
var pc_pa_delta[31:0];
pc_pa_delta = 32'd0;
#endif

instr = dmem[pc_pa];
assume instr[15:12] == 0b0001;
assume instr[8:6] == 0b011;     // Dst mode: (An)+
assume instr[5:0] == 0b111100;  // Src: #imm
pc when (~m68k_exc_taken) = pc + 2;

dst_reg = instr[11:9];

// Fetch immediate byte (in low byte of extension word)
mbipa_imm = dmem[pc + pc_pa_delta];
pc when (~m68k_exc_taken) = pc + 2;
mbipa_byte = mbipa_imm[7:0];

// Write byte to memory
mbipa_addr = aregs[dst_reg];
#ifdef MMU
var mmu_va[31:0];
mmu_va = {mbipa_addr[31:1], 1'b0};
var is_write[0:0];
is_write = 1'b0;
aspect mmu/atc_translate_data.isa gates pc:1, sr:1, ssp:1, aregs:1, dmem:1, flag_C:1, flag_N:1, flag_Z:1, flag_V:1, flag_X:1, usp:1;
#endif

#ifdef MMU
mbipa_word = dmem[ea_pa];
#else
mbipa_word = dmem[{mbipa_addr[31:1], 1'b0}];
#endif
mbipa_new = mbipa_addr[0] ? {mbipa_word[15:8], mbipa_byte} : {mbipa_byte, mbipa_word[7:0]};
#ifdef MMU
dmem[ea_pa] when (~m68k_exc_taken & ~data_exc_taken) = mbipa_new;
#else
dmem[{mbipa_addr[31:1], 1'b0}] when (~m68k_exc_taken & ~data_exc_taken) = mbipa_new;
#endif
aregs[dst_reg] when (~m68k_exc_taken & ~data_exc_taken) = aregs[dst_reg] + 1;

flag_N when (~m68k_exc_taken & ~data_exc_taken) = mbipa_byte[7];
flag_Z when (~m68k_exc_taken & ~data_exc_taken) = mbipa_byte == 0;
flag_V when (~m68k_exc_taken & ~data_exc_taken) = 1'b0;
flag_C when (~m68k_exc_taken & ~data_exc_taken) = 1'b0;
