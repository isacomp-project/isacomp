// SPDX-License-Identifier: BSD-3-Clause
// MC68020 BFEXTU d(An){offset:width},Dn - Bit Field Extract Unsigned from displacement indirect
// Opcode: 1110 1001 11 101 AAA followed by extension word + 16-bit displacement
// Extension: 0 DDD Do ooooo Dw wwwww
// Only handles immediate offset and immediate width (most common kernel pattern)
// Bit numbering: offset 0 = MSB of byte at EA, extends toward LSB / higher addresses

isa_state pc[31:0];
var instr[15:0];
isa_state dregs[31:0][2:0];
isa_state aregs[31:0][2:0];
mem dmem[25:0];
#ifdef MMU
// MMU state (added by MMU preprocessor)
isa_state tc[31:0];
isa_state tt0[31:0];
isa_state tt1[31:0];
isa_state crp[63:0];
isa_state srp[63:0];
isa_state vbr[31:0];
isa_state ssp[31:0];
isa_state usp[31:0];
#endif
isa_state flag_X[0:0];
isa_state flag_N[0:0];
isa_state flag_Z[0:0];
isa_state flag_V[0:0];
isa_state flag_C[0:0];

var bfeu_ext[15:0];
var ea_reg[2:0];
var dst_reg[2:0];
var offset[5:0];
var width[5:0];
var disp[15:0];
var disp_ext[31:0];
var base_addr[31:0];
var byte_addr[31:0];
var bit_in_byte[2:0];
var word_addr[31:0];
var mem_hi[15:0];
var mem_lo[15:0];
var mem_raw[31:0];
var mem_adj[31:0];
var shifted[31:0];
var mask[31:0];
var field[31:0];

// Include interrupt and exception handling aspects
aspect m68k_exception.isa gates pc:2, sr:2, ssp:2, aregs:2, dmem:2, flag_C:2, flag_N:2, flag_Z:2, flag_V:2, flag_X:2, usp:2;
aspect m68k_interrupt.isa gates sr;
#ifdef MMU
aspect mmu/atc_translate_instr.isa gates pc, dmem;
#else
var pc_pa[31:0];
pc_pa = pc;
var pc_pa_delta[31:0];
pc_pa_delta = 32'd0;
#endif

// Fetch instruction
instr = dmem[pc_pa];
assume instr[15:6] == 10'b1110100111;  // BFEXTU opcode
assume instr[5:3] == 3'b101;           // EA mode: d(An)
pc when (~m68k_exc_taken) = pc + 2;

ea_reg = instr[2:0];

// Fetch extension word
bfeu_ext = dmem[pc + pc_pa_delta];
assume bfeu_ext[15] == 1'b0;
assume bfeu_ext[11] == 1'b0;  // Immediate offset
assume bfeu_ext[5] == 1'b0;   // Immediate width
pc when (~m68k_exc_taken) = pc + 2;

dst_reg = bfeu_ext[14:12];
offset = {1'b0, bfeu_ext[10:6]};
width = bfeu_ext[4:0] == 0 ? 6'd32 : {1'b0, bfeu_ext[4:0]};

// Fetch 16-bit displacement
disp = dmem[pc + pc_pa_delta];
pc when (~m68k_exc_taken) = pc + 2;
disp_ext = disp[15] ? {16'hFFFF, disp} : {16'h0000, disp};

// Calculate base effective address (byte address)
base_addr = aregs[ea_reg] + disp_ext;

// Add byte offset from bit offset (offset / 8)
byte_addr = base_addr + {{29{offset[5]}}, offset[5:3]};
bit_in_byte = offset[2:0];

// Align to word boundary for 16-bit memory reads
word_addr = {byte_addr[31:1], 1'b0};

// Read 4 bytes (2 words) to cover any bit field spanning up to 32+7 bits
#ifdef MMU
var mmu_va[31:0];
mmu_va = word_addr;
var is_write[0:0];
is_write = 1'b0;
aspect mmu/atc_translate_data.isa gates pc:1, sr:1, ssp:1, aregs:1, dmem:1, flag_C:1, flag_N:1, flag_Z:1, flag_V:1, flag_X:1, usp:1;
#endif

#ifdef MMU
mem_hi = dmem[ea_pa];
#else
mem_hi = dmem[word_addr];
#endif
#ifdef MMU
mem_lo = dmem[ea_pa + 2];
#else
mem_lo = dmem[word_addr + 2];
#endif
mem_raw = {mem_hi, mem_lo};

// Adjust for odd byte address: shift left 8 if base byte is at odd address
mem_adj = byte_addr[0] ? (mem_raw << 4'd8) : mem_raw;

// Now bit 31 of mem_adj corresponds to bit 0 of the byte at byte_addr
// Shift left by bit_in_byte to align field MSB to bit 31
shifted = mem_adj << bit_in_byte;

// Extract 'width' bits from the top of shifted, zero-extend
mask = (width == 6'd32) ? 32'hFFFFFFFF : ((32'b1 << width) - 1);
field = (shifted >> (6'd32 - width)) & mask;

// Store result
dregs[dst_reg] when (~m68k_exc_taken & ~data_exc_taken) = field;

// Update CCR
flag_N when (~m68k_exc_taken & ~data_exc_taken) = (shifted[31]);
flag_Z when (~m68k_exc_taken & ~data_exc_taken) = field == 0;
flag_V when (~m68k_exc_taken & ~data_exc_taken) = 1'b0;
flag_C when (~m68k_exc_taken & ~data_exc_taken) = 1'b0;
