// SPDX-License-Identifier: BSD-3-Clause
// M68000 OR.B (An)+,Dn - Logical OR byte from memory with post-increment to data register
// Opcode: 1000 DDD0 00011 AAA where DDD=dest data reg, AAA=addr reg

isa_state pc[31:0];
var instr[15:0];
isa_state dregs[31:0][2:0];
isa_state aregs[31:0][2:0];
mem dmem[25:0];
#ifdef MMU
// MMU state (added by MMU preprocessor)
isa_state tc[31:0];
isa_state tt0[31:0];
isa_state tt1[31:0];
isa_state crp[63:0];
isa_state srp[63:0];
isa_state vbr[31:0];
isa_state ssp[31:0];
isa_state usp[31:0];
#endif
isa_state flag_X[0:0];
isa_state flag_N[0:0];
isa_state flag_Z[0:0];
isa_state flag_V[0:0];
isa_state flag_C[0:0];

// Byte sub-registers using 'of' keyword
// dregs_b[n] maps to dregs[n][7:0] (low byte of each data register)
isa_state dregs_b[7:0][2:0] of dregs[0b***][7:0];

var dst_reg[2:0];
var addr_reg[2:0];
var addr[31:0];
var src_word[15:0];
var src_val[7:0];
var dst_val[7:0];
var result[7:0];

// Include interrupt and exception handling aspects
aspect m68k_exception.isa gates pc:2, sr:2, ssp:2, aregs:2, dmem:2, flag_C:2, flag_N:2, flag_Z:2, flag_V:2, flag_X:2, usp:2;
aspect m68k_interrupt.isa gates sr;
#ifdef MMU
aspect mmu/atc_translate_instr.isa gates pc, dmem;
#else
var pc_pa[31:0];
pc_pa = pc;
var pc_pa_delta[31:0];
pc_pa_delta = 32'd0;
#endif

// Fetch instruction
instr = dmem[pc_pa];
assume instr[15:12] == 0b1000;  // OR opcode
assume instr[8:6] == 0b000;     // Opmode: byte, EA to Dn
assume instr[5:3] == 0b011;     // EA mode: Address Register Indirect with Postincrement
pc when (~m68k_exc_taken) = pc + 2;

// Decode
dst_reg = instr[11:9];
addr_reg = instr[2:0];

// Read source from memory (single byte read)
addr = aregs[addr_reg];
#ifdef MMU
var mmu_va[31:0];
mmu_va = addr;
var is_write[0:0];
is_write = 1'b0;
aspect mmu/atc_translate_data.isa gates pc:1, sr:1, ssp:1, aregs:1, dmem:1, flag_C:1, flag_N:1, flag_Z:1, flag_V:1, flag_X:1, usp:1;
#endif

#ifdef MMU
src_word = dmem[{ea_pa[31:1], 1'b0}];
src_val = addr[0] ? src_word[7:0] : src_word[15:8];
#else
src_word = dmem[{addr[31:1], 1'b0}];
src_val = addr[0] ? src_word[7:0] : src_word[15:8];
#endif

// Post-increment address register by 1 (byte)
aregs[addr_reg] when (~m68k_exc_taken & ~data_exc_taken) = addr + 1;

// Execute
dst_val = dregs_b[dst_reg];
result = dst_val | src_val;

// Write result (preserves upper bits via 'of' mapping)
dregs_b[dst_reg] when (~m68k_exc_taken & ~data_exc_taken) = result;

// Update CCR (X not affected)
flag_N when (~m68k_exc_taken & ~data_exc_taken) = result[7];
flag_Z when (~m68k_exc_taken & ~data_exc_taken) = result == 0;
flag_V when (~m68k_exc_taken & ~data_exc_taken) = 1'b0;
flag_C when (~m68k_exc_taken & ~data_exc_taken) = 1'b0;
