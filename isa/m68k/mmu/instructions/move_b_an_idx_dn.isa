// SPDX-License-Identifier: BSD-3-Clause
// M68000 MOVE.B d(An,Xn),Dn - Move byte from brief indexed to data register
// Opcode: 0001 DDD 000 110 AAA followed by brief extension word

isa_state pc[31:0];
var instr[15:0];
isa_state dregs[31:0][2:0];
isa_state aregs[31:0][2:0];
mem dmem[25:0];
#ifdef MMU
// MMU state (added by MMU preprocessor)
isa_state tc[31:0];
isa_state tt0[31:0];
isa_state tt1[31:0];
isa_state crp[63:0];
isa_state srp[63:0];
isa_state vbr[31:0];
isa_state ssp[31:0];
isa_state usp[31:0];
#endif
isa_state flag_X[0:0];
isa_state flag_N[0:0];
isa_state flag_Z[0:0];
isa_state flag_V[0:0];
isa_state flag_C[0:0];

var dst_reg[2:0];
var base_reg[2:0];
var mbid_ext[15:0];
var idx_reg[2:0];
var idx_is_addr[0:0];
var idx_is_long[0:0];
var idx_scale[1:0];
var disp8[7:0];
var disp_ext[31:0];
var raw_idx[31:0];
var idx_val[31:0];
var scaled_idx[31:0];
var eff_addr[31:0];
var mem_word[15:0];
var byte_val[7:0];

// Include interrupt and exception handling aspects
aspect m68k_exception.isa gates pc:2, sr:2, ssp:2, aregs:2, dmem:2, flag_C:2, flag_N:2, flag_Z:2, flag_V:2, flag_X:2, usp:2;
aspect m68k_interrupt.isa gates sr;
#ifdef MMU
aspect mmu/atc_translate_instr.isa gates pc, dmem;
#else
var pc_pa[31:0];
pc_pa = pc;
var pc_pa_delta[31:0];
pc_pa_delta = 32'd0;
#endif

// Fetch instruction
instr = dmem[pc_pa];
assume instr[15:12] == 0b0001;  // MOVE.B
assume instr[8:6] == 0b000;     // Dest mode: Dn
assume instr[5:3] == 0b110;     // Source mode: indexed
pc when (~m68k_exc_taken) = pc + 2;

dst_reg = instr[11:9];
base_reg = instr[2:0];

// Fetch brief extension word
mbid_ext = dmem[pc + pc_pa_delta];
assume mbid_ext[8] == 0b0;  // Brief format
pc when (~m68k_exc_taken) = pc + 2;

idx_reg = mbid_ext[14:12];
idx_is_addr = mbid_ext[15];
idx_is_long = mbid_ext[11];
idx_scale = mbid_ext[10:9];
disp8 = mbid_ext[7:0];
disp_ext = {{24{disp8[7]}}, disp8};

raw_idx = idx_is_addr ? aregs[idx_reg] : dregs[idx_reg];
idx_val = idx_is_long ? raw_idx : {{16{raw_idx[15]}}, raw_idx[15:0]};

scaled_idx = idx_scale == 2'b00 ? idx_val :
             idx_scale == 2'b01 ? (idx_val << 1) :
             idx_scale == 2'b10 ? (idx_val << 2) :
                                  (idx_val << 3);

// Calculate effective address
eff_addr = aregs[base_reg] + disp_ext + scaled_idx;

// Read byte from memory
#ifdef MMU
var mmu_va[31:0];
mmu_va = {eff_addr[31:1], 1'b0};
var is_write[0:0];
is_write = 1'b0;
aspect mmu/atc_translate_data.isa gates pc:1, sr:1, ssp:1, aregs:1, dmem:1, flag_C:1, flag_N:1, flag_Z:1, flag_V:1, flag_X:1, usp:1;
#endif

#ifdef MMU
mem_word = dmem[ea_pa];
#else
mem_word = dmem[{eff_addr[31:1], 1'b0}];
#endif
byte_val = eff_addr[0] ? mem_word[7:0] : mem_word[15:8];

// Write to register (preserve upper 24 bits)
dregs[dst_reg] when (~m68k_exc_taken & ~data_exc_taken) = {dregs[dst_reg][31:8], byte_val};

// Update CCR
flag_N when (~m68k_exc_taken & ~data_exc_taken) = byte_val[7];
flag_Z when (~m68k_exc_taken & ~data_exc_taken) = byte_val == 0;
flag_V when (~m68k_exc_taken & ~data_exc_taken) = 1'b0;
flag_C when (~m68k_exc_taken & ~data_exc_taken) = 1'b0;
