// SPDX-License-Identifier: BSD-3-Clause
// M68000 MOVE.B (xxx).L,(xxx).L - Move byte from absolute long to absolute long
// Opcode: 0001 001 111 111 001 followed by 32-bit source address, then 32-bit destination address
// Total: 10 bytes

isa_state pc[31:0];
var instr[15:0];
isa_state dregs[31:0][2:0];
isa_state aregs[31:0][2:0];
mem dmem[25:0];
#ifdef MMU
// MMU state (added by MMU preprocessor)
isa_state tc[31:0];
isa_state tt0[31:0];
isa_state tt1[31:0];
isa_state crp[63:0];
isa_state srp[63:0];
isa_state vbr[31:0];
isa_state ssp[31:0];
isa_state usp[31:0];
#endif
isa_state flag_X[0:0];
isa_state flag_N[0:0];
isa_state flag_Z[0:0];
isa_state flag_V[0:0];
isa_state flag_C[0:0];

var src_addr_hi[15:0];
var src_addr_lo[15:0];
var src_addr[31:0];
var dst_addr_hi[15:0];
var dst_addr_lo[15:0];
var dst_addr[31:0];
var src_word[15:0];
var data_byte[7:0];
var dst_word[15:0];
var new_word[15:0];

// Include interrupt and exception handling aspects
aspect m68k_exception.isa gates pc:2, sr:2, ssp:2, aregs:2, dmem:2, flag_C:2, flag_N:2, flag_Z:2, flag_V:2, flag_X:2, usp:2;
aspect m68k_interrupt.isa gates sr;
#ifdef MMU
aspect mmu/atc_translate_instr.isa gates pc, dmem;
#else
var pc_pa[31:0];
pc_pa = pc;
var pc_pa_delta[31:0];
pc_pa_delta = 32'd0;
#endif

// Fetch instruction
instr = dmem[pc_pa];
assume instr[15:12] == 0b0001;  // MOVE.B
assume instr[11:9] == 0b001;    // Dest reg field for abs.L
assume instr[8:6] == 0b111;     // Dest mode: Special
assume instr[5:3] == 0b111;     // Source mode: Special
assume instr[2:0] == 0b001;     // Source: Absolute long
pc when (~m68k_exc_taken) = pc + 2;

// Fetch 32-bit source address
src_addr_hi = dmem[pc + pc_pa_delta];
pc when (~m68k_exc_taken) = pc + 2;
src_addr_lo = dmem[pc + pc_pa_delta];
pc when (~m68k_exc_taken) = pc + 2;
src_addr = {src_addr_hi, src_addr_lo};

// Fetch 32-bit destination address
dst_addr_hi = dmem[pc + pc_pa_delta];
pc when (~m68k_exc_taken) = pc + 2;
dst_addr_lo = dmem[pc + pc_pa_delta];
pc when (~m68k_exc_taken) = pc + 2;
dst_addr = {dst_addr_hi, dst_addr_lo};

// Read byte from source
#ifdef MMU
var mmu_va[31:0];
mmu_va = src_addr;
var is_write[0:0];
is_write = 1'b1;
aspect mmu/atc_translate_data.isa gates pc:1, sr:1, ssp:1, aregs:1, dmem:1, flag_C:1, flag_N:1, flag_Z:1, flag_V:1, flag_X:1, usp:1;
#endif

#ifdef MMU
src_word = dmem[{ea_pa[31:1], 1'b0}];
#else
src_word = dmem[{src_addr[31:1], 1'b0}];
#endif
data_byte = src_addr[0] ? src_word[7:0] : src_word[15:8];

// Write byte to destination (read-modify-write)
dst_word = dmem[{dst_addr[31:1], 1'b0}];
new_word = dst_addr[0] ? {dst_word[15:8], data_byte} : {data_byte, dst_word[7:0]};
dmem[{dst_addr[31:1], 1'b0}] when (~m68k_exc_taken & ~data_exc_taken) = new_word;

// Update CCR
flag_N when (~m68k_exc_taken & ~data_exc_taken) = data_byte[7];
flag_Z when (~m68k_exc_taken & ~data_exc_taken) = data_byte == 0;
flag_V when (~m68k_exc_taken & ~data_exc_taken) = 1'b0;
flag_C when (~m68k_exc_taken & ~data_exc_taken) = 1'b0;
