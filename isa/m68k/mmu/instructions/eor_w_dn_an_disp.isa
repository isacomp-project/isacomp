// SPDX-License-Identifier: BSD-3-Clause
// M68000 EOR.W Dn,(d16,An) - Exclusive OR word data register with memory (displacement)
// Opcode: 1011 SSS1 01101 AAA followed by 16-bit signed displacement
// Operation: (d16,An) XOR Dn -> (d16,An)

isa_state pc[31:0];
var instr[15:0];
isa_state dregs[31:0][2:0];
isa_state aregs[31:0][2:0];
mem dmem[25:0];
#ifdef MMU
// MMU state (added by MMU preprocessor)
isa_state tc[31:0];
isa_state tt0[31:0];
isa_state tt1[31:0];
isa_state crp[63:0];
isa_state srp[63:0];
isa_state vbr[31:0];
isa_state ssp[31:0];
isa_state usp[31:0];
#endif
isa_state flag_X[0:0];
isa_state flag_N[0:0];
isa_state flag_Z[0:0];
isa_state flag_V[0:0];
isa_state flag_C[0:0];

// Word sub-registers using 'of' keyword
isa_state dregs_w[15:0][2:0] of dregs[0b***][15:0];

var src_reg[2:0];
var addr_reg[2:0];
var mewda_disp[15:0];
var mewda_disp_ext[31:0];
var mewda_addr[31:0];
var mewda_src_val[15:0];
var mewda_dst_val[15:0];
var mewda_result[15:0];

// Include interrupt and exception handling aspects
aspect m68k_exception.isa gates pc:2, sr:2, ssp:2, aregs:2, dmem:2, flag_C:2, flag_N:2, flag_Z:2, flag_V:2, flag_X:2, usp:2;
aspect m68k_interrupt.isa gates sr;
#ifdef MMU
aspect mmu/atc_translate_instr.isa gates pc, dmem;
#else
var pc_pa[31:0];
pc_pa = pc;
var pc_pa_delta[31:0];
pc_pa_delta = 32'd0;
#endif

// Fetch instruction
instr = dmem[pc_pa];
assume instr[15:12] == 0b1011;  // EOR opcode
assume instr[8:6] == 0b101;     // Opmode: word
assume instr[5:3] == 0b101;     // EA mode: Address Register Indirect with Displacement
pc when (~m68k_exc_taken) = pc + 2;

// Decode
src_reg = instr[11:9];
addr_reg = instr[2:0];

// Read source from Dn (low word)
mewda_src_val = dregs_w[src_reg];

// Fetch displacement
mewda_disp = dmem[pc + pc_pa_delta];
pc when (~m68k_exc_taken) = pc + 2;
mewda_disp_ext = {{16{mewda_disp[15]}}, mewda_disp};

// Calculate effective address
mewda_addr = aregs[addr_reg] + mewda_disp_ext;

// MMU translate
#ifdef MMU
var mmu_va[31:0];
mmu_va = mewda_addr;
var is_write[0:0];
is_write = 1'b1;
aspect mmu/atc_translate_data.isa gates pc:1, sr:1, ssp:1, aregs:1, dmem:1, flag_C:1, flag_N:1, flag_Z:1, flag_V:1, flag_X:1, usp:1;
#endif

// Read destination from memory
#ifdef MMU
mewda_dst_val = dmem[ea_pa];
#else
mewda_dst_val = dmem[mewda_addr];
#endif

// Execute
mewda_result = mewda_dst_val ^ mewda_src_val;

// Write result back to memory
#ifdef MMU
dmem[ea_pa] when (~m68k_exc_taken & ~data_exc_taken) = mewda_result;
#else
dmem[mewda_addr] when (~m68k_exc_taken & ~data_exc_taken) = mewda_result;
#endif

// Update CCR (X not affected)
flag_N when (~m68k_exc_taken & ~data_exc_taken) = mewda_result[15];
flag_Z when (~m68k_exc_taken & ~data_exc_taken) = mewda_result == 0;
flag_V when (~m68k_exc_taken & ~data_exc_taken) = 1'b0;
flag_C when (~m68k_exc_taken & ~data_exc_taken) = 1'b0;
