// SPDX-License-Identifier: BSD-3-Clause
// M68000 JSR (xxx).W - Jump to subroutine at absolute word address
// Opcode: 0100 1110 10 111 000 followed by 16-bit address (sign-extended)
// Pushes return address onto stack (A7)

isa_state pc[31:0];
var instr[15:0];
isa_state dregs[31:0][2:0];
isa_state aregs[31:0][2:0];
mem dmem[25:0];
#ifdef MMU
// MMU state (added by MMU preprocessor)
isa_state tc[31:0];
isa_state tt0[31:0];
isa_state tt1[31:0];
isa_state crp[63:0];
isa_state srp[63:0];
isa_state vbr[31:0];
isa_state ssp[31:0];
isa_state usp[31:0];
#endif
isa_state flag_X[0:0];
isa_state flag_N[0:0];
isa_state flag_Z[0:0];
isa_state flag_V[0:0];
isa_state flag_C[0:0];

var jsr_aw_addr_word[15:0];
var jsr_aw_target[31:0];
var jsr_aw_return[31:0];
var jsr_aw_sp[31:0];

// Include interrupt and exception handling aspects
aspect m68k_exception.isa gates pc:2, sr:2, ssp:2, aregs:2, dmem:2, flag_C:2, flag_N:2, flag_Z:2, flag_V:2, flag_X:2, usp:2;
aspect m68k_interrupt.isa gates sr;
#ifdef MMU
aspect mmu/atc_translate_instr.isa gates pc, dmem;
#else
var pc_pa[31:0];
pc_pa = pc;
var pc_pa_delta[31:0];
pc_pa_delta = 32'd0;
#endif

// Fetch instruction
instr = dmem[pc_pa];
assume instr[15:6] == 0b0100111010;  // JSR opcode
assume instr[5:3] == 0b111;          // EA mode: special
assume instr[2:0] == 0b000;          // Absolute word

// Fetch 16-bit address
jsr_aw_addr_word = dmem[pc + 2 + pc_pa_delta];

// Sign-extend to 32-bit address
jsr_aw_target = {{16{jsr_aw_addr_word[15]}}, jsr_aw_addr_word};

// Return address is after the full instruction (pc + 4 for this 4-byte instruction)
jsr_aw_return = pc + 4;

// Push return address onto stack (A7, pre-decrement)
jsr_aw_sp = aregs[7] - 4;
aregs[7] when (~m68k_exc_taken) = jsr_aw_sp;
#ifdef MMU
var mmu_va[31:0];
mmu_va = jsr_aw_sp;
var is_write[0:0];
is_write = 1'b1;
aspect mmu/atc_translate_data.isa gates pc:1, sr:1, ssp:1, aregs:1, dmem:1, flag_C:1, flag_N:1, flag_Z:1, flag_V:1, flag_X:1, usp:1;
#endif

#ifdef MMU
dmem[ea_pa] when (~m68k_exc_taken & ~data_exc_taken) = jsr_aw_return[31:16];
#else
dmem[jsr_aw_sp] when (~m68k_exc_taken & ~data_exc_taken) = jsr_aw_return[31:16];
#endif
#ifdef MMU
dmem[ea_pa + 2] when (~m68k_exc_taken & ~data_exc_taken) = jsr_aw_return[15:0];
#else
dmem[jsr_aw_sp + 2] when (~m68k_exc_taken & ~data_exc_taken) = jsr_aw_return[15:0];
#endif

// Jump to subroutine
pc when (~m68k_exc_taken) = jsr_aw_target;

// JSR does not affect flags
