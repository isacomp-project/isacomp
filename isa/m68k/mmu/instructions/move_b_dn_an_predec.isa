// SPDX-License-Identifier: BSD-3-Clause
// M68000 MOVE.B Dn,-(An) - Move byte from data register to memory (address register predecrement)
// Opcode: 0001 AAA 100 000 SSS where AAA=addr reg, SSS=data reg

isa_state pc[31:0];
var instr[15:0];
isa_state dregs[31:0][2:0];
isa_state aregs[31:0][2:0];
mem dmem[25:0];
#ifdef MMU
// MMU state (added by MMU preprocessor)
isa_state tc[31:0];
isa_state tt0[31:0];
isa_state tt1[31:0];
isa_state crp[63:0];
isa_state srp[63:0];
isa_state vbr[31:0];
isa_state ssp[31:0];
isa_state usp[31:0];
#endif
isa_state flag_X[0:0];
isa_state flag_N[0:0];
isa_state flag_Z[0:0];
isa_state flag_V[0:0];
isa_state flag_C[0:0];

var src_reg[2:0];
var addr_reg[2:0];
var data_byte[7:0];
var addr[31:0];
var mem_word[15:0];
var new_word[15:0];

// Include interrupt and exception handling aspects
aspect m68k_exception.isa gates pc:2, sr:2, ssp:2, aregs:2, dmem:2, flag_C:2, flag_N:2, flag_Z:2, flag_V:2, flag_X:2, usp:2;
aspect m68k_interrupt.isa gates sr;
#ifdef MMU
aspect mmu/atc_translate_instr.isa gates pc, dmem;
#else
var pc_pa[31:0];
pc_pa = pc;
var pc_pa_delta[31:0];
pc_pa_delta = 32'd0;
#endif

// Fetch instruction
instr = dmem[pc_pa];
assume instr[15:12] == 0b0001;  // MOVE.B opcode
assume instr[8:6] == 0b100;     // Destination mode: Address Register Indirect with Predecrement
assume instr[5:3] == 0b000;     // Source mode: Data Register Direct
pc when (~m68k_exc_taken) = pc + 2;

// Decode
addr_reg = instr[11:9];
src_reg = instr[2:0];

// Get source data
data_byte = dregs[src_reg][7:0];

// Predecrement address register (decrement by 1 for byte)
addr = aregs[addr_reg] - 1;
aregs[addr_reg] when (~m68k_exc_taken) = addr;

// Write byte to memory (read-modify-write)
#ifdef MMU
var mmu_va[31:0];
mmu_va = {addr[31:1], 1'b0};
var is_write[0:0];
is_write = 1'b0;
aspect mmu/atc_translate_data.isa gates pc:1, sr:1, ssp:1, aregs:1, dmem:1, flag_C:1, flag_N:1, flag_Z:1, flag_V:1, flag_X:1, usp:1;
#endif

#ifdef MMU
mem_word = dmem[ea_pa];
#else
mem_word = dmem[{addr[31:1], 1'b0}];
#endif
new_word = addr[0] ? {mem_word[15:8], data_byte} : {data_byte, mem_word[7:0]};
#ifdef MMU
dmem[ea_pa] when (~m68k_exc_taken & ~data_exc_taken) = new_word;
#else
dmem[{addr[31:1], 1'b0}] when (~m68k_exc_taken & ~data_exc_taken) = new_word;
#endif

// Update CCR
flag_N when (~m68k_exc_taken & ~data_exc_taken) = data_byte[7];
flag_Z when (~m68k_exc_taken & ~data_exc_taken) = data_byte == 0;
flag_V when (~m68k_exc_taken & ~data_exc_taken) = 1'b0;
flag_C when (~m68k_exc_taken & ~data_exc_taken) = 1'b0;
