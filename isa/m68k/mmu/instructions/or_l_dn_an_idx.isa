// SPDX-License-Identifier: BSD-3-Clause
// M68000 OR.L Dn,(d8,An,Xn) - Logical OR data register to long in memory (brief indexed)
// Opcode: 1000 DDD1 10 110 AAA + brief extension word

isa_state pc[31:0];
var instr[15:0];
isa_state dregs[31:0][2:0];
isa_state aregs[31:0][2:0];
mem dmem[25:0];
#ifdef MMU
// MMU state (added by MMU preprocessor)
isa_state tc[31:0];
isa_state tt0[31:0];
isa_state tt1[31:0];
isa_state crp[63:0];
isa_state srp[63:0];
isa_state vbr[31:0];
isa_state ssp[31:0];
isa_state usp[31:0];
#endif
isa_state flag_X[0:0];
isa_state flag_N[0:0];
isa_state flag_Z[0:0];
isa_state flag_V[0:0];
isa_state flag_C[0:0];

var src_reg[2:0];
var base_reg[2:0];
var olix_ext[15:0];
var olix_idx_is_addr[0:0];
var idx_reg[2:0];
var olix_idx_is_long[0:0];
var olix_scale[1:0];
var olix_disp8[7:0];
var olix_disp_ext[31:0];
var olix_idx_raw[31:0];
var olix_idx_val[31:0];
var olix_scaled_idx[31:0];
var olix_addr[31:0];
var olix_dst_hi[15:0];
var olix_dst_lo[15:0];
var olix_src_val[31:0];
var olix_dst_val[31:0];
var olix_result[31:0];

// Include interrupt and exception handling aspects
aspect m68k_exception.isa gates pc:2, sr:2, ssp:2, aregs:2, dmem:2, flag_C:2, flag_N:2, flag_Z:2, flag_V:2, flag_X:2, usp:2;
aspect m68k_interrupt.isa gates sr;
#ifdef MMU
aspect mmu/atc_translate_instr.isa gates pc, dmem;
#else
var pc_pa[31:0];
pc_pa = pc;
var pc_pa_delta[31:0];
pc_pa_delta = 32'd0;
#endif

// Fetch instruction
instr = dmem[pc_pa];
assume instr[15:12] == 0b1000;  // OR opcode
assume instr[8:6] == 0b110;     // Opmode: long, Dn to EA
assume instr[5:3] == 0b110;     // EA mode: Indexed
pc when (~m68k_exc_taken) = pc + 2;

// Decode
src_reg = instr[11:9];
base_reg = instr[2:0];

// Fetch brief extension word
olix_ext = dmem[pc + pc_pa_delta];
assume olix_ext[8] == 0b0;  // Brief format
pc when (~m68k_exc_taken) = pc + 2;

// Decode extension word
olix_idx_is_addr = olix_ext[15];
idx_reg = olix_ext[14:12];
olix_idx_is_long = olix_ext[11];
olix_scale = olix_ext[10:9];
olix_disp8 = olix_ext[7:0];

// Sign-extend displacement
olix_disp_ext = {{24{olix_disp8[7]}}, olix_disp8};

// Get index register value
olix_idx_raw = olix_idx_is_addr ? aregs[idx_reg] : dregs[idx_reg];

// Sign-extend word index if needed
olix_idx_val = olix_idx_is_long ? olix_idx_raw : (olix_idx_raw[15] ? {16'hFFFF, olix_idx_raw[15:0]} : {16'h0000, olix_idx_raw[15:0]});

// Apply scale factor
olix_scaled_idx = olix_scale == 0 ? olix_idx_val :
                  olix_scale == 1 ? (olix_idx_val << 1) :
                  olix_scale == 2 ? (olix_idx_val << 2) :
                                    (olix_idx_val << 3);

// Calculate effective address
olix_addr = aregs[base_reg] + olix_disp_ext + olix_scaled_idx;

// MMU translation
#ifdef MMU
var mmu_va[31:0];
mmu_va = olix_addr;
var is_write[0:0];
is_write = 1'b1;
aspect mmu/atc_translate_data.isa gates pc:1, sr:1, ssp:1, aregs:1, dmem:1, flag_C:1, flag_N:1, flag_Z:1, flag_V:1, flag_X:1, usp:1;
#endif

// Read destination from memory (two 16-bit reads, big-endian)
#ifdef MMU
olix_dst_hi = dmem[ea_pa];
#else
olix_dst_hi = dmem[olix_addr];
#endif
#ifdef MMU
olix_dst_lo = dmem[ea_pa + 2];
#else
olix_dst_lo = dmem[olix_addr + 2];
#endif
olix_dst_val = {olix_dst_hi, olix_dst_lo};

// Execute
olix_src_val = dregs[src_reg];
olix_result = olix_dst_val | olix_src_val;

// Write result back to memory
#ifdef MMU
dmem[ea_pa] when (~m68k_exc_taken & ~data_exc_taken) = olix_result[31:16];
#else
dmem[olix_addr] when (~m68k_exc_taken & ~data_exc_taken) = olix_result[31:16];
#endif
#ifdef MMU
dmem[ea_pa + 2] when (~m68k_exc_taken & ~data_exc_taken) = olix_result[15:0];
#else
dmem[olix_addr + 2] when (~m68k_exc_taken & ~data_exc_taken) = olix_result[15:0];
#endif

// Update CCR (X not affected)
flag_N when (~m68k_exc_taken & ~data_exc_taken) = olix_result[31];
flag_Z when (~m68k_exc_taken & ~data_exc_taken) = olix_result == 0;
flag_V when (~m68k_exc_taken & ~data_exc_taken) = 1'b0;
flag_C when (~m68k_exc_taken & ~data_exc_taken) = 1'b0;
