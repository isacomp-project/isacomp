// SPDX-License-Identifier: BSD-3-Clause
// M68000 BCLR #bit,Dn - Test and clear bit in data register
// Opcode: 0000 1000 10000 DDD followed by 16-bit immediate (bit number)
// Tests bit, sets Z flag, then clears the bit to 0

isa_state pc[31:0];
var instr[15:0];
isa_state dregs[31:0][2:0];
isa_state aregs[31:0][2:0];
mem dmem[25:0];
isa_state flag_X[0:0];
isa_state flag_N[0:0];
isa_state flag_Z[0:0];
isa_state flag_V[0:0];
isa_state flag_C[0:0];

var dst_reg[2:0];
var bit_num[15:0];
var src_val[31:0];
var bit_pos[4:0];
var bit_val[0:0];
var mask[31:0];
var result[31:0];

// Include interrupt and exception handling aspects
aspect m68k_exception.isa gates pc:2, sr:2, ssp:2, aregs:2, dmem:2, flag_C:2, flag_N:2, flag_Z:2, flag_V:2, flag_X:2, usp:2;
aspect m68k_interrupt.isa gates sr;
#ifdef MMU
aspect mmu/atc_translate_instr.isa gates pc, dmem;
#else
var pc_pa[31:0];
pc_pa = pc;
var pc_pa_delta[31:0];
pc_pa_delta = 32'd0;
#endif

// Fetch instruction
instr = dmem[pc_pa];
assume instr[15:6] == 0b0000100010;  // BCLR immediate opcode
assume instr[5:3] == 0b000;          // EA mode: Data Register Direct
pc when (~m68k_exc_taken) = pc + 2;

// Decode
dst_reg = instr[2:0];

// Fetch bit number
bit_num = dmem[pc + pc_pa_delta];
pc when (~m68k_exc_taken) = pc + 2;

// Get source value and test bit (modulo 32 for long)
src_val = dregs[dst_reg];
bit_pos = bit_num[4:0];
bit_val = (src_val >> bit_pos) & 1;

// Update Z flag (set if bit was zero before clearing)
flag_Z when (~m68k_exc_taken) = ~bit_val;

// Clear the bit
mask = ~(1 << bit_pos);
result = src_val & mask;
dregs[dst_reg] when (~m68k_exc_taken) = result;

// Other flags not affected
