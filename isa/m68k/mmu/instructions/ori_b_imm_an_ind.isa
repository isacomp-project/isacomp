// SPDX-License-Identifier: BSD-3-Clause
// M68000 ORI.B #imm,(An) - OR immediate byte to memory (address register indirect)
// Opcode: 0000 0000 00 010 AAA followed by immediate word
// Read-modify-write byte operation

isa_state pc[31:0];
var instr[15:0];
isa_state dregs[31:0][2:0];
isa_state aregs[31:0][2:0];
mem dmem[25:0];
#ifdef MMU
// MMU state (added by MMU preprocessor)
isa_state tc[31:0];
isa_state tt0[31:0];
isa_state tt1[31:0];
isa_state crp[63:0];
isa_state srp[63:0];
isa_state vbr[31:0];
isa_state ssp[31:0];
isa_state usp[31:0];
#endif
isa_state flag_X[0:0];
isa_state flag_N[0:0];
isa_state flag_Z[0:0];
isa_state flag_V[0:0];
isa_state flag_C[0:0];

var addr_reg[2:0];
var obian_ext_word[15:0];
var obian_imm_byte[7:0];
var obian_eff_addr[31:0];
var obian_dst_word[15:0];
var obian_dst_byte[7:0];
var obian_result_byte[7:0];
var obian_new_word[15:0];

// Include interrupt and exception handling aspects
aspect m68k_exception.isa gates pc:2, sr:2, ssp:2, aregs:2, dmem:2, flag_C:2, flag_N:2, flag_Z:2, flag_V:2, flag_X:2, usp:2;
aspect m68k_interrupt.isa gates sr;
#ifdef MMU
aspect mmu/atc_translate_instr.isa gates pc, dmem;
#else
var pc_pa[31:0];
pc_pa = pc;
var pc_pa_delta[31:0];
pc_pa_delta = 32'd0;
#endif

// Fetch instruction
instr = dmem[pc_pa];
assume instr[15:8] == 0b00000000;  // ORI opcode
assume instr[7:6] == 0b00;         // Size: byte
assume instr[5:3] == 0b010;        // EA mode: (An)
pc when (~m68k_exc_taken) = pc + 2;

addr_reg = instr[2:0];

// Fetch immediate byte
obian_ext_word = dmem[pc + pc_pa_delta];
pc when (~m68k_exc_taken) = pc + 2;
obian_imm_byte = obian_ext_word[7:0];

// Effective address is register contents directly
obian_eff_addr = aregs[addr_reg];

// Read-modify-write byte in memory (16-bit word access)
#ifdef MMU
var mmu_va[31:0];
mmu_va = obian_eff_addr;
var is_write[0:0];
is_write = 1'b1;
aspect mmu/atc_translate_data.isa gates pc:1, sr:1, ssp:1, aregs:1, dmem:1, flag_C:1, flag_N:1, flag_Z:1, flag_V:1, flag_X:1, usp:1;
#endif

#ifdef MMU
obian_dst_word = dmem[{ea_pa[31:1], 1'b0}];
#else
obian_dst_word = dmem[{obian_eff_addr[31:1], 1'b0}];
#endif
obian_dst_byte = obian_eff_addr[0] ? obian_dst_word[7:0] : obian_dst_word[15:8];
obian_result_byte = obian_dst_byte | obian_imm_byte;
obian_new_word = obian_eff_addr[0] ? {obian_dst_word[15:8], obian_result_byte} : {obian_result_byte, obian_dst_word[7:0]};
#ifdef MMU
dmem[{ea_pa[31:1], 1'b0}] when (~m68k_exc_taken & ~data_exc_taken) = obian_new_word;
#else
dmem[{obian_eff_addr[31:1], 1'b0}] when (~m68k_exc_taken & ~data_exc_taken) = obian_new_word;
#endif

// Update CCR
flag_N when (~m68k_exc_taken & ~data_exc_taken) = obian_result_byte[7];
flag_Z when (~m68k_exc_taken & ~data_exc_taken) = obian_result_byte == 0;
flag_V when (~m68k_exc_taken & ~data_exc_taken) = 1'b0;
flag_C when (~m68k_exc_taken & ~data_exc_taken) = 1'b0;
