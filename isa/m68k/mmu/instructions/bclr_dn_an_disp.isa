// SPDX-License-Identifier: BSD-3-Clause
// M68000 BCLR Dn,(d16,An) - Test and clear bit in memory byte (dynamic, displacement)
// Opcode: 0000 SSS 110 101 AAA followed by 16-bit displacement

isa_state pc[31:0];
var instr[15:0];
isa_state dregs[31:0][2:0];
isa_state aregs[31:0][2:0];
mem dmem[25:0];
#ifdef MMU
// MMU state (added by MMU preprocessor)
isa_state tc[31:0];
isa_state tt0[31:0];
isa_state tt1[31:0];
isa_state crp[63:0];
isa_state srp[63:0];
isa_state vbr[31:0];
isa_state ssp[31:0];
isa_state usp[31:0];
#endif
isa_state flag_X[0:0];
isa_state flag_N[0:0];
isa_state flag_Z[0:0];
isa_state flag_V[0:0];
isa_state flag_C[0:0];

var src_reg[2:0];
var addr_reg[2:0];
var bcad_bit_num[31:0];
var bcad_disp16[15:0];
var bcad_disp_ext[31:0];
var bcad_byte_addr[31:0];
var bcad_bit_pos[2:0];
var bcad_dst_word[15:0];
var bcad_dst_byte[7:0];
var bcad_bit_val[0:0];
var bcad_mask[7:0];
var bcad_new_byte[7:0];
var bcad_new_word[15:0];

// Include interrupt and exception handling aspects
aspect m68k_exception.isa gates pc:2, sr:2, ssp:2, aregs:2, dmem:2, flag_C:2, flag_N:2, flag_Z:2, flag_V:2, flag_X:2, usp:2;
aspect m68k_interrupt.isa gates sr;
#ifdef MMU
aspect mmu/atc_translate_instr.isa gates pc, dmem;
#else
var pc_pa[31:0];
pc_pa = pc;
var pc_pa_delta[31:0];
pc_pa_delta = 32'd0;
#endif

// Fetch instruction
instr = dmem[pc_pa];
assume instr[15:12] == 0b0000;       // Bit manipulation
assume instr[8:6] == 0b110;          // BCLR dynamic opcode
assume instr[5:3] == 0b101;          // EA mode: d(An)
pc when (~m68k_exc_taken) = pc + 2;

src_reg = instr[11:9];  // Register containing bit number
addr_reg = instr[2:0];

bcad_bit_num = dregs[src_reg];

// Fetch displacement
bcad_disp16 = dmem[pc + pc_pa_delta];
pc when (~m68k_exc_taken) = pc + 2;
bcad_disp_ext = bcad_disp16[15] ? {16'hFFFF, bcad_disp16} : {16'h0000, bcad_disp16};

// Calculate byte address
bcad_byte_addr = aregs[addr_reg] + bcad_disp_ext;
bcad_bit_pos = bcad_bit_num[2:0];  // Modulo 8 for byte operation

// MMU translate for write
#ifdef MMU
var mmu_va[31:0];
mmu_va = bcad_byte_addr;
var is_write[0:0];
is_write = 1'b1;
aspect mmu/atc_translate_data.isa gates pc:1, sr:1, ssp:1, aregs:1, dmem:1, flag_C:1, flag_N:1, flag_Z:1, flag_V:1, flag_X:1, usp:1;
#endif

// Read-modify-write byte
#ifdef MMU
bcad_dst_word = dmem[{ea_pa[31:1], 1'b0}];
#else
bcad_dst_word = dmem[{bcad_byte_addr[31:1], 1'b0}];
#endif
bcad_dst_byte = bcad_byte_addr[0] ? bcad_dst_word[7:0] : bcad_dst_word[15:8];

bcad_bit_val = (bcad_dst_byte >> bcad_bit_pos) & 1;
flag_Z when (~m68k_exc_taken & ~data_exc_taken) = ~bcad_bit_val;

// Clear the bit using AND with inverted mask
bcad_mask = 1 << bcad_bit_pos;
bcad_new_byte = bcad_dst_byte & (~bcad_mask);

// Write back
bcad_new_word = bcad_byte_addr[0] ? {bcad_dst_word[15:8], bcad_new_byte} : {bcad_new_byte, bcad_dst_word[7:0]};
#ifdef MMU
dmem[{ea_pa[31:1], 1'b0}] when (~m68k_exc_taken & ~data_exc_taken) = bcad_new_word;
#else
dmem[{bcad_byte_addr[31:1], 1'b0}] when (~m68k_exc_taken & ~data_exc_taken) = bcad_new_word;
#endif
