// SPDX-License-Identifier: BSD-3-Clause
// MC68020 CMPI.B #imm,(xxx).L - Compare immediate byte with absolute long address
// Opcode: 0000 1100 00 111 001 followed by 16-bit immediate word, then 32-bit address
// Compares (xxx).L - #imm, updates flags, discards result

isa_state pc[31:0];
var instr[15:0];
isa_state dregs[31:0][2:0];
isa_state aregs[31:0][2:0];
mem dmem[25:0];
#ifdef MMU
// MMU state (added by MMU preprocessor)
isa_state tc[31:0];
isa_state tt0[31:0];
isa_state tt1[31:0];
isa_state crp[63:0];
isa_state srp[63:0];
isa_state vbr[31:0];
isa_state ssp[31:0];
isa_state usp[31:0];
#endif
isa_state flag_X[0:0];
isa_state flag_N[0:0];
isa_state flag_Z[0:0];
isa_state flag_V[0:0];
isa_state flag_C[0:0];

var mcbal_imm_word[15:0];
var mcbal_imm_val[7:0];
var mcbal_addr_hi[15:0];
var mcbal_addr_lo[15:0];
var mcbal_abs_addr[31:0];
var mcbal_mem_word[15:0];
var mcbal_dst_val[7:0];
var mcbal_result[8:0];

// Include interrupt and exception handling aspects
aspect m68k_exception.isa gates pc:2, sr:2, ssp:2, aregs:2, dmem:2, flag_C:2, flag_N:2, flag_Z:2, flag_V:2, flag_X:2, usp:2;
aspect m68k_interrupt.isa gates sr;
#ifdef MMU
aspect mmu/atc_translate_instr.isa gates pc, dmem;
#else
var pc_pa[31:0];
pc_pa = pc;
var pc_pa_delta[31:0];
pc_pa_delta = 32'd0;
#endif

// Fetch instruction
instr = dmem[pc_pa];
assume instr[15:8] == 0b00001100;  // CMPI opcode
assume instr[7:6] == 0b00;         // Size: byte
assume instr[5:3] == 0b111;        // EA mode: special
assume instr[2:0] == 0b001;        // EA reg: absolute long
pc when (~m68k_exc_taken) = pc + 2;

// Fetch immediate value (byte is in low byte of word)
mcbal_imm_word = dmem[pc + pc_pa_delta];
pc when (~m68k_exc_taken) = pc + 2;
mcbal_imm_val = mcbal_imm_word[7:0];

// Fetch 32-bit absolute address
mcbal_addr_hi = dmem[pc + pc_pa_delta];
pc when (~m68k_exc_taken) = pc + 2;
mcbal_addr_lo = dmem[pc + pc_pa_delta];
pc when (~m68k_exc_taken) = pc + 2;
mcbal_abs_addr = {mcbal_addr_hi, mcbal_addr_lo};

// Read byte from memory
#ifdef MMU
var mmu_va[31:0];
mmu_va = mcbal_abs_addr;
var is_write[0:0];
is_write = 1'b0;
aspect mmu/atc_translate_data.isa gates pc:1, sr:1, ssp:1, aregs:1, dmem:1, flag_C:1, flag_N:1, flag_Z:1, flag_V:1, flag_X:1, usp:1;
#endif

#ifdef MMU
mcbal_mem_word = dmem[{ea_pa[31:1], 1'b0}];
mcbal_dst_val = mcbal_abs_addr[0] ? mcbal_mem_word[7:0] : mcbal_mem_word[15:8];
#else
mcbal_mem_word = dmem[{mcbal_abs_addr[31:1], 1'b0}];
mcbal_dst_val = mcbal_abs_addr[0] ? mcbal_mem_word[7:0] : mcbal_mem_word[15:8];
#endif

// Execute comparison (subtract but don't store result)
mcbal_result = mcbal_dst_val - mcbal_imm_val;

// Update CCR (X not affected by CMP)
flag_C when (~m68k_exc_taken & ~data_exc_taken) = mcbal_imm_val > mcbal_dst_val;
flag_V when (~m68k_exc_taken & ~data_exc_taken) = (~mcbal_dst_val[7] & mcbal_imm_val[7] & mcbal_result[7]) | (mcbal_dst_val[7] & ~mcbal_imm_val[7] & ~mcbal_result[7]);
flag_Z when (~m68k_exc_taken & ~data_exc_taken) = mcbal_result[7:0] == 0;
flag_N when (~m68k_exc_taken & ~data_exc_taken) = mcbal_result[7];
