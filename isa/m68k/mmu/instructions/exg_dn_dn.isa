// SPDX-License-Identifier: BSD-3-Clause
// M68000 EXG Dx,Dy - Exchange data registers
// Opcode: 1100 xxx 1 01000 yyy where xxx=Rx, yyy=Ry
// Note: EXG does NOT affect condition codes

isa_state pc[31:0];
var instr[15:0];
isa_state dregs[31:0][2:0];
isa_state aregs[31:0][2:0];
mem dmem[25:0];
isa_state flag_X[0:0];
isa_state flag_N[0:0];
isa_state flag_Z[0:0];
isa_state flag_V[0:0];
isa_state flag_C[0:0];

var reg_x[2:0];
var reg_y[2:0];
var temp_x[31:0];
var temp_y[31:0];

// Include interrupt and exception handling aspects
aspect m68k_exception.isa gates pc:2, sr:2, ssp:2, aregs:2, dmem:2, flag_C:2, flag_N:2, flag_Z:2, flag_V:2, flag_X:2, usp:2;
aspect m68k_interrupt.isa gates sr;
#ifdef MMU
aspect mmu/atc_translate_instr.isa gates pc, dmem;
#else
var pc_pa[31:0];
pc_pa = pc;
var pc_pa_delta[31:0];
pc_pa_delta = 32'd0;
#endif

// Fetch instruction
instr = dmem[pc_pa];
assume instr[15:12] == 0b1100;  // EXG opcode
assume instr[8] == 1'b1;        // EXG identifier bit
assume instr[7:3] == 0b01000;   // Opmode: data register to data register
pc when (~m68k_exc_taken) = pc + 2;

// Decode
reg_x = instr[11:9];
reg_y = instr[2:0];

// Execute - exchange register contents
temp_x = dregs[reg_x];
temp_y = dregs[reg_y];
dregs[reg_x] when (~m68k_exc_taken) = temp_y;
dregs[reg_y] when (~m68k_exc_taken) = temp_x;

// EXG does not affect flags
