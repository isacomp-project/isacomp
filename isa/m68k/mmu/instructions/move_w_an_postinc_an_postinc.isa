// SPDX-License-Identifier: BSD-3-Clause
// M68000 MOVE.W (An)+,(Am)+ - Move word between postincrement addresses
// Opcode: 0011 DDD 011 011 SSS where DDD=dest addr reg, SSS=src addr reg
// 68020+ supports misaligned word access from odd addresses

isa_state pc[31:0];
var instr[15:0];
isa_state dregs[31:0][2:0];
isa_state aregs[31:0][2:0];
mem dmem[25:0];
#ifdef MMU
// MMU state (added by MMU preprocessor)
isa_state tc[31:0];
isa_state tt0[31:0];
isa_state tt1[31:0];
isa_state crp[63:0];
isa_state srp[63:0];
isa_state vbr[31:0];
isa_state ssp[31:0];
isa_state usp[31:0];
#endif
isa_state flag_X[0:0];
isa_state flag_N[0:0];
isa_state flag_Z[0:0];
isa_state flag_V[0:0];
isa_state flag_C[0:0];

var src_reg[2:0];
var dst_reg[2:0];
var src_addr[31:0];
var dst_addr[31:0];
var data[15:0];
var mwapap_src_aligned[31:0];
var mwapap_src_w0[15:0];
var mwapap_src_w1[15:0];
var mwapap_dst_aligned[31:0];
var mwapap_dst_e0[15:0];
var mwapap_dst_e1[15:0];

// Include interrupt and exception handling aspects
aspect m68k_exception.isa gates pc:2, sr:2, ssp:2, aregs:2, dmem:2, flag_C:2, flag_N:2, flag_Z:2, flag_V:2, flag_X:2, usp:2;
aspect m68k_interrupt.isa gates sr;
#ifdef MMU
aspect mmu/atc_translate_instr.isa gates pc, dmem;
#else
var pc_pa[31:0];
pc_pa = pc;
var pc_pa_delta[31:0];
pc_pa_delta = 32'd0;
#endif

// Fetch instruction
instr = dmem[pc_pa];
assume instr[15:12] == 0b0011;  // MOVE.W
assume instr[8:6] == 0b011;     // Dest mode: (An)+
assume instr[5:3] == 0b011;     // Source mode: (An)+
pc when (~m68k_exc_taken) = pc + 2;

dst_reg = instr[11:9];
src_reg = instr[2:0];

// Read word from source (handle odd address for 68020+ misaligned access)
src_addr = aregs[src_reg];
#ifdef MMU
var mmu_va[31:0];
mmu_va = src_addr;
var is_write[0:0];
is_write = 1'b1;
aspect mmu/atc_translate_data.isa gates pc:1, sr:1, ssp:1, aregs:1, dmem:1, flag_C:1, flag_N:1, flag_Z:1, flag_V:1, flag_X:1, usp:1;
#endif

#ifdef MMU
mwapap_src_aligned = {ea_pa[31:1], 1'b0};
#else
mwapap_src_aligned = {src_addr[31:1], 1'b0};
#endif
mwapap_src_w0 = dmem[mwapap_src_aligned];
mwapap_src_w1 = dmem[mwapap_src_aligned + 2];
// Even addr: data = w0
// Odd addr: data = {w0[7:0], w1[15:8]} (straddles two aligned words)
data = src_addr[0] ? {mwapap_src_w0[7:0], mwapap_src_w1[15:8]} : mwapap_src_w0;

// Write word to destination (handle odd address for 68020+ misaligned access)
dst_addr = aregs[dst_reg];
mwapap_dst_aligned = {dst_addr[31:1], 1'b0};
mwapap_dst_e0 = dmem[mwapap_dst_aligned];
mwapap_dst_e1 = dmem[mwapap_dst_aligned + 2];
dmem[mwapap_dst_aligned] when (~m68k_exc_taken & ~data_exc_taken) = dst_addr[0] ? {mwapap_dst_e0[15:8], data[15:8]} : data;
dmem[mwapap_dst_aligned + 2] when (~m68k_exc_taken & ~data_exc_taken) = dst_addr[0] ? {data[7:0], mwapap_dst_e1[7:0]} : mwapap_dst_e1;

// Post-increment both address registers by 2 (word)
aregs[src_reg] when (~m68k_exc_taken & ~data_exc_taken) = src_addr + 2;
aregs[dst_reg] when (~m68k_exc_taken & ~data_exc_taken) = dst_addr + 2;

// Update CCR
flag_N when (~m68k_exc_taken & ~data_exc_taken) = data[15];
flag_Z when (~m68k_exc_taken & ~data_exc_taken) = data == 0;
flag_V when (~m68k_exc_taken & ~data_exc_taken) = 1'b0;
flag_C when (~m68k_exc_taken & ~data_exc_taken) = 1'b0;
