// SPDX-License-Identifier: BSD-3-Clause
// M68000 ASR.W #count,Dn - Arithmetic shift right word by immediate count
// Opcode: 1110 CCC0 01100 DDD where CCC=count (0=8, 1-7=1-7), DDD=reg

isa_state pc[31:0];
var instr[15:0];
isa_state dregs[31:0][2:0];
isa_state aregs[31:0][2:0];
mem dmem[25:0];
isa_state flag_X[0:0];
isa_state flag_N[0:0];
isa_state flag_Z[0:0];
isa_state flag_V[0:0];
isa_state flag_C[0:0];

var dst_reg[2:0];
var count_field[2:0];
var count[5:0];
var src_word[15:0];
var result_word[15:0];
var last_bit_out[0:0];

// Include interrupt and exception handling aspects
aspect m68k_exception.isa gates pc:2, sr:2, ssp:2, aregs:2, dmem:2, flag_C:2, flag_N:2, flag_Z:2, flag_V:2, flag_X:2, usp:2;
aspect m68k_interrupt.isa gates sr;
#ifdef MMU
aspect mmu/atc_translate_instr.isa gates pc, dmem;
#else
var pc_pa[31:0];
pc_pa = pc;
var pc_pa_delta[31:0];
pc_pa_delta = 32'd0;
#endif

// Fetch instruction
instr = dmem[pc_pa];
assume instr[15:12] == 0b1110;  // Shift/rotate opcode
assume instr[8] == 0;           // Direction: right
assume instr[7:6] == 0b01;     // Size: word
assume instr[5] == 0;           // i/r: immediate count
assume instr[4:3] == 0b00;      // ASR type
pc when (~m68k_exc_taken) = pc + 2;

// Decode
count_field = instr[11:9];
dst_reg = instr[2:0];

// Convert count (0 means 8, 1-7 means 1-7)
count = count_field == 0 ? 6'h08 : {{3{1'b0}}, count_field};

// Execute - arithmetic shift right on low 16 bits
src_word = dregs[dst_reg][15:0];
result_word = {{16{src_word[15]}}, src_word} >> count;

// Last bit shifted out (for carry)
last_bit_out = (src_word >> (count - 1)) & 1;

// Write result - preserve upper 16 bits
dregs[dst_reg] when (~m68k_exc_taken) = {dregs[dst_reg][31:16], result_word[15:0]};

// Update CCR
flag_X when (~m68k_exc_taken) = last_bit_out;
flag_C when (~m68k_exc_taken) = last_bit_out;
flag_N when (~m68k_exc_taken) = result_word[15];
flag_Z when (~m68k_exc_taken) = result_word == 0;
flag_V when (~m68k_exc_taken) = 1'b0;
