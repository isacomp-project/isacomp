// SPDX-License-Identifier: BSD-3-Clause
// MC68020 BFCLR d(An){Dn:width} - Clear Bit Field in displacement indirect
// Opcode: 1110 1100 11 101 AAA followed by extension word + 16-bit displacement
// Handles register offset (Do=1) with immediate width (Dw=0)

isa_state pc[31:0];
var instr[15:0];
isa_state dregs[31:0][2:0];
isa_state aregs[31:0][2:0];
mem dmem[25:0];
#ifdef MMU
// MMU state (added by MMU preprocessor)
isa_state tc[31:0];
isa_state tt0[31:0];
isa_state tt1[31:0];
isa_state crp[63:0];
isa_state srp[63:0];
isa_state vbr[31:0];
isa_state ssp[31:0];
isa_state usp[31:0];
#endif
isa_state flag_X[0:0];
isa_state flag_N[0:0];
isa_state flag_Z[0:0];
isa_state flag_V[0:0];
isa_state flag_C[0:0];

var bfcd_ext[15:0];
var ea_reg[2:0];
var bfcd_off_reg[2:0];
var bfcd_wf[4:0];
var bfcd_width[5:0];
var bfcd_bitoff[31:0];
var bfcd_byteoff[31:0];
var bfcd_disp[15:0];
var bfcd_disp_ext[31:0];
var bfcd_base[31:0];
var bfcd_eff[31:0];
var bfcd_waddr[31:0];
var bfcd_biw[3:0];
var bfcd_mem[15:0];
var bfcd_mask[15:0];
var bfcd_result[15:0];

// Include interrupt and exception handling aspects
aspect m68k_exception.isa gates pc:2, sr:2, ssp:2, aregs:2, dmem:2, flag_C:2, flag_N:2, flag_Z:2, flag_V:2, flag_X:2, usp:2;
aspect m68k_interrupt.isa gates sr;
#ifdef MMU
aspect mmu/atc_translate_instr.isa gates pc, dmem;
#else
var pc_pa[31:0];
pc_pa = pc;
var pc_pa_delta[31:0];
pc_pa_delta = 32'd0;
#endif

// Fetch instruction
instr = dmem[pc_pa];
assume instr[15:6] == 0b1110110011;  // BFCLR
assume instr[5:3] == 0b101;          // EA mode: d(An)
pc when (~m68k_exc_taken) = pc + 2;

ea_reg = instr[2:0];

// Fetch extension word
bfcd_ext = dmem[pc + pc_pa_delta];
assume bfcd_ext[11] == 0b1;   // Offset is register (Do=1)
assume bfcd_ext[5] == 0b0;    // Width is immediate (Dw=0)
pc when (~m68k_exc_taken) = pc + 2;

bfcd_off_reg = bfcd_ext[8:6];
bfcd_wf = bfcd_ext[4:0];
bfcd_width = bfcd_wf == 0 ? 6'd32 : {{1{1'b0}}, bfcd_wf};

// Fetch 16-bit displacement
bfcd_disp = dmem[pc + pc_pa_delta];
pc when (~m68k_exc_taken) = pc + 2;
bfcd_disp_ext = bfcd_disp[15] ? {16'hFFFF, bfcd_disp} : {16'h0000, bfcd_disp};

// Get bit offset from register (full 32-bit signed)
bfcd_bitoff = dregs[bfcd_off_reg];

// Calculate base effective address with displacement
bfcd_base = aregs[ea_reg] + bfcd_disp_ext;

// Calculate byte address: base + bit_offset/8 (arithmetic shift right by 3)
bfcd_byteoff = {bfcd_bitoff[31], bfcd_bitoff[31], bfcd_bitoff[31], bfcd_bitoff[31:3]};
bfcd_eff = bfcd_base + bfcd_byteoff;

// Align to word boundary and find bit within word
bfcd_waddr = {bfcd_eff[31:1], 1'b0};
bfcd_biw = {bfcd_eff[0], bfcd_bitoff[2:0]};

// Read the word
#ifdef MMU
var mmu_va[31:0];
mmu_va = bfcd_waddr;
var is_write[0:0];
is_write = 1'b1;
aspect mmu/atc_translate_data.isa gates pc:1, sr:1, ssp:1, aregs:1, dmem:1, flag_C:1, flag_N:1, flag_Z:1, flag_V:1, flag_X:1, usp:1;
#endif

#ifdef MMU
bfcd_mem = dmem[ea_pa];
#else
bfcd_mem = dmem[bfcd_waddr];
#endif

// Clear single bit (bit_in_word counts from MSB, big-endian bit numbering)
bfcd_mask = 16'h8000 >> bfcd_biw;
bfcd_result = bfcd_mem & ~bfcd_mask;

// Write back
#ifdef MMU
dmem[ea_pa] when (~m68k_exc_taken & ~data_exc_taken) = bfcd_result;
#else
dmem[bfcd_waddr] when (~m68k_exc_taken & ~data_exc_taken) = bfcd_result;
#endif

// Update CCR based on original bit value
flag_N when (~m68k_exc_taken & ~data_exc_taken) = 1'b0;
flag_Z when (~m68k_exc_taken & ~data_exc_taken) = ~((bfcd_mem >> (4'hF - bfcd_biw)) & 16'h0001);
flag_V when (~m68k_exc_taken & ~data_exc_taken) = 1'b0;
flag_C when (~m68k_exc_taken & ~data_exc_taken) = 1'b0;
