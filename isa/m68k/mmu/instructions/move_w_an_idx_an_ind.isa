// SPDX-License-Identifier: BSD-3-Clause
// M68000 MOVE.W (d8,An,Xn),(An) - Move word from indexed to address register indirect
// Opcode: 0011 AAA 010 110 BBB followed by brief extension word

isa_state pc[31:0];
var instr[15:0];
isa_state dregs[31:0][2:0];
isa_state aregs[31:0][2:0];
mem dmem[25:0];
#ifdef MMU
// MMU state (added by MMU preprocessor)
isa_state tc[31:0];
isa_state tt0[31:0];
isa_state tt1[31:0];
isa_state crp[63:0];
isa_state srp[63:0];
isa_state vbr[31:0];
isa_state ssp[31:0];
isa_state usp[31:0];
#endif
isa_state flag_X[0:0];
isa_state flag_N[0:0];
isa_state flag_Z[0:0];
isa_state flag_V[0:0];
isa_state flag_C[0:0];

var dst_reg[2:0];
var base_reg[2:0];
var mmwia_ext[15:0];
var mmwia_disp8[7:0];
var mmwia_disp_ext[31:0];
var idx_reg[2:0];
var mmwia_idx_is_addr[0:0];
var mmwia_idx_is_long[0:0];
var mmwia_scale[1:0];
var mmwia_raw_idx[31:0];
var mmwia_idx_val[31:0];
var mmwia_scaled_idx[31:0];
var mmwia_src_addr[31:0];
var mmwia_dst_addr[31:0];
var mmwia_data[15:0];

// Include interrupt and exception handling aspects
aspect m68k_exception.isa gates pc:2, sr:2, ssp:2, aregs:2, dmem:2, flag_C:2, flag_N:2, flag_Z:2, flag_V:2, flag_X:2, usp:2;
aspect m68k_interrupt.isa gates sr;
#ifdef MMU
aspect mmu/atc_translate_instr.isa gates pc, dmem;
#else
var pc_pa[31:0];
pc_pa = pc;
var pc_pa_delta[31:0];
pc_pa_delta = 32'd0;
#endif

// Fetch instruction
instr = dmem[pc_pa];
assume instr[15:12] == 0b0011;  // MOVE.W
assume instr[8:6] == 0b010;     // Dest mode: (An)
assume instr[5:3] == 0b110;     // Source mode: indexed
pc when (~m68k_exc_taken) = pc + 2;

dst_reg = instr[11:9];
base_reg = instr[2:0];

// Fetch brief extension word
mmwia_ext = dmem[pc + pc_pa_delta];
assume mmwia_ext[8] == 0b0;  // Brief format
pc when (~m68k_exc_taken) = pc + 2;

// Decode index
idx_reg = mmwia_ext[14:12];
mmwia_idx_is_addr = mmwia_ext[15];
mmwia_idx_is_long = mmwia_ext[11];
mmwia_scale = mmwia_ext[10:9];
mmwia_disp8 = mmwia_ext[7:0];

mmwia_disp_ext = mmwia_disp8[7] ? {24'hFFFFFF, mmwia_disp8} : {24'h000000, mmwia_disp8};
mmwia_raw_idx = mmwia_idx_is_addr ? aregs[idx_reg] : dregs[idx_reg];
mmwia_idx_val = mmwia_idx_is_long ? mmwia_raw_idx : (mmwia_raw_idx[15] ? {16'hFFFF, mmwia_raw_idx[15:0]} : {16'h0000, mmwia_raw_idx[15:0]});

mmwia_scaled_idx = mmwia_scale == 0 ? mmwia_idx_val :
                   mmwia_scale == 1 ? (mmwia_idx_val << 1) :
                   mmwia_scale == 2 ? (mmwia_idx_val << 2) :
                                      (mmwia_idx_val << 3);

// Calculate source effective address
mmwia_src_addr = aregs[base_reg] + mmwia_disp_ext + mmwia_scaled_idx;

// Read word from source
#ifdef MMU
var mmu_va[31:0];
mmu_va = mmwia_src_addr;
var is_write[0:0];
is_write = 1'b0;
aspect mmu/atc_translate_data.isa gates pc:1, sr:1, ssp:1, aregs:1, dmem:1, flag_C:1, flag_N:1, flag_Z:1, flag_V:1, flag_X:1, usp:1;
#endif

#ifdef MMU
mmwia_data = dmem[ea_pa];
#else
mmwia_data = dmem[mmwia_src_addr];
#endif

// Write word to destination (An)
mmwia_dst_addr = aregs[dst_reg];
dmem[mmwia_dst_addr] when (~m68k_exc_taken & ~data_exc_taken) = mmwia_data;

// Update CCR
flag_N when (~m68k_exc_taken & ~data_exc_taken) = mmwia_data[15];
flag_Z when (~m68k_exc_taken & ~data_exc_taken) = mmwia_data == 0;
flag_V when (~m68k_exc_taken & ~data_exc_taken) = 1'b0;
flag_C when (~m68k_exc_taken & ~data_exc_taken) = 1'b0;
