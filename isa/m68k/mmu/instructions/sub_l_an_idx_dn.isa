// SPDX-License-Identifier: BSD-3-Clause
// M68000 SUB.L (d8,An,Xn),Dn - Subtract long from indexed memory from data register
// Opcode: 1001 DDD0 10 110 AAA followed by brief extension word

isa_state pc[31:0];
var instr[15:0];
isa_state dregs[31:0][2:0];
isa_state aregs[31:0][2:0];
mem dmem[25:0];
#ifdef MMU
// MMU state (added by MMU preprocessor)
isa_state tc[31:0];
isa_state tt0[31:0];
isa_state tt1[31:0];
isa_state crp[63:0];
isa_state srp[63:0];
isa_state vbr[31:0];
isa_state ssp[31:0];
isa_state usp[31:0];
#endif
isa_state flag_X[0:0];
isa_state flag_N[0:0];
isa_state flag_Z[0:0];
isa_state flag_V[0:0];
isa_state flag_C[0:0];

var dst_reg[2:0];
var base_reg[2:0];
var slid_ext[15:0];
var idx_reg[2:0];
var slid_idx_is_addr[0:0];
var slid_idx_is_long[0:0];
var slid_idx_scale[1:0];
var slid_disp8[7:0];
var slid_disp_ext[31:0];
var slid_raw_idx[31:0];
var slid_idx_val[31:0];
var slid_scaled_idx[31:0];
var slid_eff_addr[31:0];
var slid_src_hi[15:0];
var slid_src_lo[15:0];
var slid_src_val[31:0];
var slid_dst_val[31:0];
var slid_result[32:0];

// Include interrupt and exception handling aspects
aspect m68k_exception.isa gates pc:2, sr:2, ssp:2, aregs:2, dmem:2, flag_C:2, flag_N:2, flag_Z:2, flag_V:2, flag_X:2, usp:2;
aspect m68k_interrupt.isa gates sr;
#ifdef MMU
aspect mmu/atc_translate_instr.isa gates pc, dmem;
#else
var pc_pa[31:0];
pc_pa = pc;
var pc_pa_delta[31:0];
pc_pa_delta = 32'd0;
#endif

// Fetch instruction
instr = dmem[pc_pa];
assume instr[15:12] == 0b1001;  // SUB opcode
assume instr[8:6] == 0b010;     // Opmode: long, EA to Dn
assume instr[5:3] == 0b110;     // EA mode: indexed (d8,An,Xn)
pc when (~m68k_exc_taken) = pc + 2;

dst_reg = instr[11:9];
base_reg = instr[2:0];

// Fetch brief extension word
slid_ext = dmem[pc + pc_pa_delta];
assume slid_ext[8] == 0b0;  // Brief format
pc when (~m68k_exc_taken) = pc + 2;

idx_reg = slid_ext[14:12];
slid_idx_is_addr = slid_ext[15];
slid_idx_is_long = slid_ext[11];
slid_idx_scale = slid_ext[10:9];
slid_disp8 = slid_ext[7:0];
slid_disp_ext = {{24{slid_disp8[7]}}, slid_disp8};

slid_raw_idx = slid_idx_is_addr ? aregs[idx_reg] : dregs[idx_reg];
slid_idx_val = slid_idx_is_long ? slid_raw_idx : {{16{slid_raw_idx[15]}}, slid_raw_idx[15:0]};

slid_scaled_idx = slid_idx_scale == 2'b00 ? slid_idx_val :
                  slid_idx_scale == 2'b01 ? (slid_idx_val << 1) :
                  slid_idx_scale == 2'b10 ? (slid_idx_val << 2) :
                                            (slid_idx_val << 3);

// Calculate effective address
slid_eff_addr = aregs[base_reg] + slid_disp_ext + slid_scaled_idx;

// MMU translate (read-only)
#ifdef MMU
var mmu_va[31:0];
mmu_va = slid_eff_addr;
var is_write[0:0];
is_write = 1'b0;
aspect mmu/atc_translate_data.isa gates pc:1, sr:1, ssp:1, aregs:1, dmem:1, flag_C:1, flag_N:1, flag_Z:1, flag_V:1, flag_X:1, usp:1;
#endif

// Read source from memory (two 16-bit reads, big-endian)
#ifdef MMU
slid_src_hi = dmem[ea_pa];
#else
slid_src_hi = dmem[slid_eff_addr];
#endif
#ifdef MMU
slid_src_lo = dmem[ea_pa + 2];
#else
slid_src_lo = dmem[slid_eff_addr + 2];
#endif
slid_src_val = {slid_src_hi, slid_src_lo};

// Execute: Dn - source
slid_dst_val = dregs[dst_reg];
slid_result = slid_dst_val - slid_src_val;

// Write result to data register
dregs[dst_reg] when (~m68k_exc_taken & ~data_exc_taken) = slid_result[31:0];

// Update CCR
flag_X when (~m68k_exc_taken & ~data_exc_taken) = slid_src_val > slid_dst_val;
flag_C when (~m68k_exc_taken & ~data_exc_taken) = slid_src_val > slid_dst_val;
flag_V when (~m68k_exc_taken & ~data_exc_taken) = (~slid_dst_val[31] & slid_src_val[31] & slid_result[31]) | (slid_dst_val[31] & ~slid_src_val[31] & ~slid_result[31]);
flag_Z when (~m68k_exc_taken & ~data_exc_taken) = slid_result[31:0] == 0;
flag_N when (~m68k_exc_taken & ~data_exc_taken) = slid_result[31];
