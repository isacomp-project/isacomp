// SPDX-License-Identifier: BSD-3-Clause
// M68000 CMPA.L (d8,An,Xn),Am - Compare long, brief indexed source with address register
// Opcode: 1011 DDD 111 110 AAA + brief extension word

isa_state pc[31:0];
var instr[15:0];
isa_state dregs[31:0][2:0];
isa_state aregs[31:0][2:0];
mem dmem[25:0];
#ifdef MMU
// MMU state (added by MMU preprocessor)
isa_state tc[31:0];
isa_state tt0[31:0];
isa_state tt1[31:0];
isa_state crp[63:0];
isa_state srp[63:0];
isa_state vbr[31:0];
isa_state ssp[31:0];
isa_state usp[31:0];
#endif
isa_state flag_X[0:0];
isa_state flag_N[0:0];
isa_state flag_Z[0:0];
isa_state flag_V[0:0];
isa_state flag_C[0:0];

var dst_reg[2:0];
var base_reg[2:0];
var claia_ext[15:0];
var claia_disp8[7:0];
var claia_disp8_ext[31:0];
var idx_reg[2:0];
var claia_idx_is_addr[0:0];
var claia_idx_is_long[0:0];
var claia_scale[1:0];
var claia_raw_idx[31:0];
var claia_idx_val[31:0];
var claia_scaled_idx[31:0];
var claia_addr[31:0];
var claia_data_hi[15:0];
var claia_data_lo[15:0];
var claia_src[31:0];
var claia_dst[31:0];
var claia_result[31:0];

// Include interrupt and exception handling aspects
aspect m68k_exception.isa gates pc:2, sr:2, ssp:2, aregs:2, dmem:2, flag_C:2, flag_N:2, flag_Z:2, flag_V:2, flag_X:2, usp:2;
aspect m68k_interrupt.isa gates sr;
#ifdef MMU
aspect mmu/atc_translate_instr.isa gates pc, dmem;
#else
var pc_pa[31:0];
pc_pa = pc;
var pc_pa_delta[31:0];
pc_pa_delta = 32'd0;
#endif

// Fetch instruction
instr = dmem[pc_pa];
assume instr[15:12] == 0b1011;  // CMP/CMPA group
assume instr[8:6] == 0b111;     // Opmode: CMPA.L
assume instr[5:3] == 0b110;     // EA mode: indexed
pc when (~m68k_exc_taken) = pc + 2;

dst_reg = instr[11:9];
base_reg = instr[2:0];

// Fetch brief extension word
claia_ext = dmem[pc + pc_pa_delta];
assume claia_ext[8] == 0b0;  // Brief format
pc when (~m68k_exc_taken) = pc + 2;

// Decode extension
idx_reg = claia_ext[14:12];
claia_idx_is_addr = claia_ext[15];
claia_idx_is_long = claia_ext[11];
claia_scale = claia_ext[10:9];
claia_disp8 = claia_ext[7:0];
claia_disp8_ext = {{24{claia_disp8[7]}}, claia_disp8};

// Get index value
claia_raw_idx = claia_idx_is_addr ? aregs[idx_reg] : dregs[idx_reg];
claia_idx_val = claia_idx_is_long ? claia_raw_idx : {{16{claia_raw_idx[15]}}, claia_raw_idx[15:0]};

// Scale index
claia_scaled_idx = claia_scale == 2'b00 ? claia_idx_val :
                   claia_scale == 2'b01 ? (claia_idx_val << 1) :
                   claia_scale == 2'b10 ? (claia_idx_val << 2) :
                                          (claia_idx_val << 3);

// Calculate address and read 32-bit value
claia_addr = aregs[base_reg] + claia_disp8_ext + claia_scaled_idx;
#ifdef MMU
var mmu_va[31:0];
mmu_va = claia_addr;
var is_write[0:0];
is_write = 1'b0;
aspect mmu/atc_translate_data.isa gates pc:1, sr:1, ssp:1, aregs:1, dmem:1, flag_C:1, flag_N:1, flag_Z:1, flag_V:1, flag_X:1, usp:1;
#endif

#ifdef MMU
claia_data_hi = dmem[ea_pa];
#else
claia_data_hi = dmem[claia_addr];
#endif
#ifdef MMU
claia_data_lo = dmem[ea_pa + 2];
#else
claia_data_lo = dmem[claia_addr + 2];
#endif
claia_src = {claia_data_hi, claia_data_lo};

// Execute comparison against address register
claia_dst = aregs[dst_reg];
claia_result = claia_dst - claia_src;

// Update CCR (X not affected by CMPA)
flag_N when (~m68k_exc_taken & ~data_exc_taken) = claia_result[31];
flag_Z when (~m68k_exc_taken & ~data_exc_taken) = claia_result == 0;
flag_V when (~m68k_exc_taken & ~data_exc_taken) = (~claia_src[31] & claia_dst[31] & ~claia_result[31]) | (claia_src[31] & ~claia_dst[31] & claia_result[31]);
flag_C when (~m68k_exc_taken & ~data_exc_taken) = claia_src > claia_dst;
