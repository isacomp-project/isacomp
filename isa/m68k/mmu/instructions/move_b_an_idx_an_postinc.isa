// SPDX-License-Identifier: BSD-3-Clause
// M68000 MOVE.B (d8,An,Xn),(Am)+ - Move byte from brief indexed to postincrement
// Opcode: 0001 DDD 011 110 AAA followed by brief extension word

isa_state pc[31:0];
var instr[15:0];
isa_state dregs[31:0][2:0];
isa_state aregs[31:0][2:0];
mem dmem[25:0];
#ifdef MMU
// MMU state (added by MMU preprocessor)
isa_state tc[31:0];
isa_state tt0[31:0];
isa_state tt1[31:0];
isa_state crp[63:0];
isa_state srp[63:0];
isa_state vbr[31:0];
isa_state ssp[31:0];
isa_state usp[31:0];
#endif
isa_state flag_X[0:0];
isa_state flag_N[0:0];
isa_state flag_Z[0:0];
isa_state flag_V[0:0];
isa_state flag_C[0:0];

var dst_reg[2:0];
var base_reg[2:0];
var mbiap_ext[15:0];
var idx_reg[2:0];
var mbiap_idx_is_addr[0:0];
var mbiap_idx_is_long[0:0];
var mbiap_idx_scale[1:0];
var mbiap_disp8[7:0];
var mbiap_disp_ext[31:0];
var mbiap_raw_idx[31:0];
var mbiap_idx_val[31:0];
var mbiap_scaled_idx[31:0];
var mbiap_src_addr[31:0];
var mbiap_src_word[15:0];
var mbiap_byte_val[7:0];
var mbiap_dst_addr[31:0];
var mbiap_dst_word[15:0];
var mbiap_new_word[15:0];

aspect m68k_exception.isa gates pc:2, sr:2, ssp:2, aregs:2, dmem:2, flag_C:2, flag_N:2, flag_Z:2, flag_V:2, flag_X:2, usp:2;
aspect m68k_interrupt.isa gates sr;
#ifdef MMU
aspect mmu/atc_translate_instr.isa gates pc, dmem;
#else
var pc_pa[31:0];
pc_pa = pc;
var pc_pa_delta[31:0];
pc_pa_delta = 32'd0;
#endif

instr = dmem[pc_pa];
assume instr[15:12] == 0b0001;  // MOVE.B
assume instr[8:6] == 0b011;     // Dest mode: (An)+
assume instr[5:3] == 0b110;     // Source mode: indexed
pc when (~m68k_exc_taken) = pc + 2;

dst_reg = instr[11:9];
base_reg = instr[2:0];

// Fetch brief extension word
mbiap_ext = dmem[pc + pc_pa_delta];
assume mbiap_ext[8] == 0b0;  // Brief format
pc when (~m68k_exc_taken) = pc + 2;

idx_reg = mbiap_ext[14:12];
mbiap_idx_is_addr = mbiap_ext[15];
mbiap_idx_is_long = mbiap_ext[11];
mbiap_idx_scale = mbiap_ext[10:9];
mbiap_disp8 = mbiap_ext[7:0];
mbiap_disp_ext = {{24{mbiap_disp8[7]}}, mbiap_disp8};

mbiap_raw_idx = mbiap_idx_is_addr ? aregs[idx_reg] : dregs[idx_reg];
mbiap_idx_val = mbiap_idx_is_long ? mbiap_raw_idx : {{16{mbiap_raw_idx[15]}}, mbiap_raw_idx[15:0]};

mbiap_scaled_idx = mbiap_idx_scale == 2'b00 ? mbiap_idx_val :
                   mbiap_idx_scale == 2'b01 ? (mbiap_idx_val << 1) :
                   mbiap_idx_scale == 2'b10 ? (mbiap_idx_val << 2) :
                                              (mbiap_idx_val << 3);

mbiap_src_addr = aregs[base_reg] + mbiap_disp_ext + mbiap_scaled_idx;

// Read source byte
#ifdef MMU
var mmu_va[31:0];
mmu_va = {mbiap_src_addr[31:1], 1'b0};
var is_write[0:0];
is_write = 1'b0;
aspect mmu/atc_translate_data.isa gates pc:1, sr:1, ssp:1, aregs:1, dmem:1, flag_C:1, flag_N:1, flag_Z:1, flag_V:1, flag_X:1, usp:1;
#endif

#ifdef MMU
mbiap_src_word = dmem[ea_pa];
#else
mbiap_src_word = dmem[{mbiap_src_addr[31:1], 1'b0}];
#endif
mbiap_byte_val = mbiap_src_addr[0] ? mbiap_src_word[7:0] : mbiap_src_word[15:8];

// Write byte to (An)+ destination (read-modify-write)
mbiap_dst_addr = aregs[dst_reg];
mbiap_dst_word = dmem[{mbiap_dst_addr[31:1], 1'b0}];
mbiap_new_word = mbiap_dst_addr[0] ? {mbiap_dst_word[15:8], mbiap_byte_val} : {mbiap_byte_val, mbiap_dst_word[7:0]};
dmem[{mbiap_dst_addr[31:1], 1'b0}] when (~m68k_exc_taken & ~data_exc_taken) = mbiap_new_word;
aregs[dst_reg] when (~m68k_exc_taken & ~data_exc_taken) = mbiap_dst_addr + 1;

// Update CCR
flag_N when (~m68k_exc_taken & ~data_exc_taken) = mbiap_byte_val[7];
flag_Z when (~m68k_exc_taken & ~data_exc_taken) = mbiap_byte_val == 0;
flag_V when (~m68k_exc_taken & ~data_exc_taken) = 1'b0;
flag_C when (~m68k_exc_taken & ~data_exc_taken) = 1'b0;
