// SPDX-License-Identifier: BSD-3-Clause
// M68000 BTST #bit,(xxx).L - Test bit at absolute long address
// Opcode: 0000 1000 00 111 001 followed by immediate word, then 32-bit address
// For memory operands, bit number is modulo 8 (byte operation)

isa_state pc[31:0];
var instr[15:0];
isa_state dregs[31:0][2:0];
isa_state aregs[31:0][2:0];
mem dmem[25:0];
#ifdef MMU
// MMU state (added by MMU preprocessor)
isa_state tc[31:0];
isa_state tt0[31:0];
isa_state tt1[31:0];
isa_state crp[63:0];
isa_state srp[63:0];
isa_state vbr[31:0];
isa_state ssp[31:0];
isa_state usp[31:0];
#endif
isa_state flag_X[0:0];
isa_state flag_N[0:0];
isa_state flag_Z[0:0];
isa_state flag_V[0:0];
isa_state flag_C[0:0];

var bit_num[15:0];
var addr_hi[15:0];
var addr_lo[15:0];
var abs_addr[31:0];
var mem_word[15:0];
var byte_val[7:0];
var bit_pos[2:0];
var bit_val[0:0];

// Include interrupt and exception handling aspects
aspect m68k_exception.isa gates pc:2, sr:2, ssp:2, aregs:2, dmem:2, flag_C:2, flag_N:2, flag_Z:2, flag_V:2, flag_X:2, usp:2;
aspect m68k_interrupt.isa gates sr;
#ifdef MMU
aspect mmu/atc_translate_instr.isa gates pc, dmem;
#else
var pc_pa[31:0];
pc_pa = pc;
var pc_pa_delta[31:0];
pc_pa_delta = 32'd0;
#endif

// Fetch instruction
instr = dmem[pc_pa];
assume instr[15:6] == 0b0000100000;  // BTST immediate opcode
assume instr[5:3] == 0b111;          // EA mode: absolute
assume instr[2:0] == 0b001;          // EA reg: long
pc when (~m68k_exc_taken) = pc + 2;

// Fetch immediate (bit number)
bit_num = dmem[pc + pc_pa_delta];
pc when (~m68k_exc_taken) = pc + 2;

// Fetch 32-bit absolute address
addr_hi = dmem[pc + pc_pa_delta];
pc when (~m68k_exc_taken) = pc + 2;
addr_lo = dmem[pc + pc_pa_delta];
pc when (~m68k_exc_taken) = pc + 2;
abs_addr = {addr_hi, addr_lo};

// Read byte from memory
#ifdef MMU
var mmu_va[31:0];
mmu_va = abs_addr;
var is_write[0:0];
is_write = 1'b0;
aspect mmu/atc_translate_data.isa gates pc:1, sr:1, ssp:1, aregs:1, dmem:1, flag_C:1, flag_N:1, flag_Z:1, flag_V:1, flag_X:1, usp:1;
#endif

#ifdef MMU
mem_word = dmem[{ea_pa[31:1], 1'b0}];
#else
mem_word = dmem[{abs_addr[31:1], 1'b0}];
#endif
byte_val = abs_addr[0] ? mem_word[7:0] : mem_word[15:8];

// Test bit (modulo 8 for byte)
bit_pos = bit_num[2:0];
bit_val = (byte_val >> bit_pos) & 1;

// Update Z flag (set if bit is zero)
flag_Z when (~m68k_exc_taken & ~data_exc_taken) = ~bit_val;

// Other flags not affected
