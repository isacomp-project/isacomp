// SPDX-License-Identifier: BSD-3-Clause
// M68000 AND.B (d16,An),Dn - AND byte from displacement
// Opcode: 1100 DDD 000 101 AAA + 16-bit displacement

isa_state pc[31:0];
var instr[15:0];
isa_state dregs[31:0][2:0];
isa_state aregs[31:0][2:0];
mem dmem[25:0];
#ifdef MMU
// MMU state (added by MMU preprocessor)
isa_state tc[31:0];
isa_state tt0[31:0];
isa_state tt1[31:0];
isa_state crp[63:0];
isa_state srp[63:0];
isa_state vbr[31:0];
isa_state ssp[31:0];
isa_state usp[31:0];
#endif
isa_state flag_X[0:0];
isa_state flag_N[0:0];
isa_state flag_Z[0:0];
isa_state flag_V[0:0];
isa_state flag_C[0:0];

isa_state dregs_b[7:0][2:0] of dregs[0b***][7:0];

var dst_reg[2:0];
var base_reg[2:0];
var abdd_disp[15:0];
var abdd_disp_ext[31:0];
var abdd_addr[31:0];
var abdd_word[15:0];
var abdd_src[7:0];
var abdd_dst[7:0];
var abdd_result[7:0];

aspect m68k_exception.isa gates pc:2, sr:2, ssp:2, aregs:2, dmem:2, flag_C:2, flag_N:2, flag_Z:2, flag_V:2, flag_X:2, usp:2;
aspect m68k_interrupt.isa gates sr;
#ifdef MMU
aspect mmu/atc_translate_instr.isa gates pc, dmem;
#else
var pc_pa[31:0];
pc_pa = pc;
var pc_pa_delta[31:0];
pc_pa_delta = 32'd0;
#endif

instr = dmem[pc_pa];
assume instr[15:12] == 0b1100;
assume instr[8:6] == 0b000;     // Byte, EA to Dn
assume instr[5:3] == 0b101;     // EA: (d16,An)
pc when (~m68k_exc_taken) = pc + 2;

dst_reg = instr[11:9];
base_reg = instr[2:0];

abdd_disp = dmem[pc + pc_pa_delta];
pc when (~m68k_exc_taken) = pc + 2;
abdd_disp_ext = {{16{abdd_disp[15]}}, abdd_disp};
abdd_addr = aregs[base_reg] + abdd_disp_ext;
#ifdef MMU
var mmu_va[31:0];
mmu_va = {abdd_addr[31:1], 1'b0};
var is_write[0:0];
is_write = 1'b0;
aspect mmu/atc_translate_data.isa gates pc:1, sr:1, ssp:1, aregs:1, dmem:1, flag_C:1, flag_N:1, flag_Z:1, flag_V:1, flag_X:1, usp:1;
#endif

#ifdef MMU
abdd_word = dmem[ea_pa];
#else
abdd_word = dmem[{abdd_addr[31:1], 1'b0}];
#endif
abdd_src = abdd_addr[0] ? abdd_word[7:0] : abdd_word[15:8];

abdd_dst = dregs_b[dst_reg];
abdd_result = abdd_dst & abdd_src;
dregs_b[dst_reg] when (~m68k_exc_taken & ~data_exc_taken) = abdd_result;

flag_N when (~m68k_exc_taken & ~data_exc_taken) = abdd_result[7];
flag_Z when (~m68k_exc_taken & ~data_exc_taken) = abdd_result == 0;
flag_V when (~m68k_exc_taken & ~data_exc_taken) = 1'b0;
flag_C when (~m68k_exc_taken & ~data_exc_taken) = 1'b0;
