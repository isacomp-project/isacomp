// SPDX-License-Identifier: BSD-3-Clause
// MC68040 PFLUSHA - Flush All ATC Entries
// Opcode: 0xf518 - 2 bytes total
// Invalidates all 22 entries in the ATC
// Privileged instruction (must be in supervisor mode)

isa_state pc[31:0];
var instr[15:0];
isa_state dregs[31:0][2:0];
isa_state aregs[31:0][2:0];
mem dmem[25:0];
isa_state flag_X[0:0];
isa_state flag_N[0:0];
isa_state flag_Z[0:0];
isa_state flag_V[0:0];
isa_state flag_C[0:0];
isa_state sr[15:0];

// ATC valid bits (22 entries)
isa_state atc_v[0:0][4:0];

// Include interrupt and exception handling aspects
aspect m68k_exception.isa gates pc:2, sr:2, ssp:2, aregs:2, dmem:2, flag_C:2, flag_N:2, flag_Z:2, flag_V:2, flag_X:2, usp:2;
aspect m68k_interrupt.isa gates sr;
#ifdef MMU
aspect mmu/atc_translate_instr.isa gates pc, dmem;
#else
var pc_pa[31:0];
pc_pa = pc;
var pc_pa_delta[31:0];
pc_pa_delta = 32'd0;
#endif

// Fetch instruction
instr = dmem[pc_pa];
assume instr == 16'hf518;
pc when (~m68k_exc_taken) = pc + 2;

// Must be in supervisor mode
assume sr[13] == 1'b1;

// Invalidate all 22 ATC entries
atc_v[0] when (~m68k_exc_taken) = 1'b0;
atc_v[1] when (~m68k_exc_taken) = 1'b0;
atc_v[2] when (~m68k_exc_taken) = 1'b0;
atc_v[3] when (~m68k_exc_taken) = 1'b0;
atc_v[4] when (~m68k_exc_taken) = 1'b0;
atc_v[5] when (~m68k_exc_taken) = 1'b0;
atc_v[6] when (~m68k_exc_taken) = 1'b0;
atc_v[7] when (~m68k_exc_taken) = 1'b0;
atc_v[8] when (~m68k_exc_taken) = 1'b0;
atc_v[9] when (~m68k_exc_taken) = 1'b0;
atc_v[10] when (~m68k_exc_taken) = 1'b0;
atc_v[11] when (~m68k_exc_taken) = 1'b0;
atc_v[12] when (~m68k_exc_taken) = 1'b0;
atc_v[13] when (~m68k_exc_taken) = 1'b0;
atc_v[14] when (~m68k_exc_taken) = 1'b0;
atc_v[15] when (~m68k_exc_taken) = 1'b0;
atc_v[16] when (~m68k_exc_taken) = 1'b0;
atc_v[17] when (~m68k_exc_taken) = 1'b0;
atc_v[18] when (~m68k_exc_taken) = 1'b0;
atc_v[19] when (~m68k_exc_taken) = 1'b0;
atc_v[20] when (~m68k_exc_taken) = 1'b0;
atc_v[21] when (~m68k_exc_taken) = 1'b0;
