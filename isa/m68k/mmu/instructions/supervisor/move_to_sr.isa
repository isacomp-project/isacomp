// SPDX-License-Identifier: BSD-3-Clause
// M68000 MOVE to SR - Move to Status Register
// Opcode: 0100 0110 11 mmm rrr (46xx)
// where mmm=mode, rrr=register (this variant: Dn)
// Privileged instruction - loads entire SR from source
// Affects all SR bits including supervisor byte

isa_state pc[31:0];
var instr[15:0];
isa_state dregs[31:0][2:0];
isa_state aregs[31:0][2:0];
mem dmem[23:0];

// Full Status Register
isa_state sr[15:0];
isa_state usp[31:0];
isa_state ssp[31:0];

// CCR flags
isa_state flag_X[0:0];
isa_state flag_N[0:0];
isa_state flag_Z[0:0];
isa_state flag_V[0:0];
isa_state flag_C[0:0];

var src_reg[2:0];
var src_val[31:0];
var new_sr[15:0];
var old_s[0:0];
var new_s[0:0];

// Include interrupt and exception handling aspects
aspect ../m68k_exception.isa gates pc, sr, ssp, aregs, dmem, flag_C, flag_N, flag_Z, flag_V, flag_X, usp;
aspect ../m68k_interrupt.isa gates sr;
#ifdef MMU
aspect mmu/atc_translate_instr.isa gates pc, dmem;
#else
var pc_pa[31:0];
pc_pa = pc;
var pc_pa_delta[31:0];
pc_pa_delta = 32'd0;
#endif

// Fetch instruction
instr = dmem[pc_pa];
assume instr[15:6] == 10'b0100011011;  // MOVE to SR opcode
assume instr[5:3] == 3'b000;            // EA mode: Data Register Direct
pc when (~m68k_exc_taken) = pc + 2;

// Must be in supervisor mode
assume sr[13] == 1'b1;

// Decode source register
src_reg = instr[2:0];

// Get source value (only low 16 bits used)
src_val = dregs[src_reg];
new_sr = src_val[15:0];

// Check for mode change (S bit)
old_s = sr[13];
new_s = new_sr[13];

// If transitioning from supervisor to user mode, save SSP and restore USP
ssp when (old_s & ~new_s & ~m68k_exc_taken) = aregs[7];
aregs[7] when (old_s & ~new_s & ~m68k_exc_taken) = usp;

// If transitioning from user to supervisor (shouldn't happen from user mode,
// but handle for completeness), save USP and restore SSP
usp when (~old_s & new_s & ~m68k_exc_taken) = aregs[7];
aregs[7] when (~old_s & new_s & ~m68k_exc_taken) = ssp;

// Update Status Register
sr when (~m68k_exc_taken) = new_sr;

// Update CCR flag aliases
flag_C when (~m68k_exc_taken) = new_sr[0];
flag_V when (~m68k_exc_taken) = new_sr[1];
flag_Z when (~m68k_exc_taken) = new_sr[2];
flag_N when (~m68k_exc_taken) = new_sr[3];
flag_X when (~m68k_exc_taken) = new_sr[4];
