// SPDX-License-Identifier: BSD-3-Clause
// M68000/68020/68030 Supervisor State Definitions
// This file defines the full processor state including supervisor-only registers.
// Include this file in supervisor-mode instructions.

// ============================================================================
// Program Counter and Memory
// ============================================================================
isa_state pc[31:0];
mem dmem[23:0];

// ============================================================================
// General Purpose Registers
// ============================================================================
isa_state dregs[31:0][2:0];   // D0-D7 Data Registers
isa_state aregs[31:0][2:0];   // A0-A6 Address Registers (A7 handled specially)

// ============================================================================
// Stack Pointers (68000: USP/SSP, 68020+: USP/ISP/MSP)
// ============================================================================
isa_state usp[31:0];          // User Stack Pointer
isa_state ssp[31:0];          // Supervisor Stack Pointer (68000) / ISP (68020+)
isa_state msp[31:0];          // Master Stack Pointer (68020+ only)

// ============================================================================
// Status Register (16-bit)
// ============================================================================
// Bit layout:
//   [15]    T1    - Trace Enable (1 = trace on any instruction)
//   [14]    T0    - Trace Enable (68020+: 1 = trace on change of flow)
//   [13]    S     - Supervisor State (1 = supervisor, 0 = user)
//   [12]    M     - Master/Interrupt State (68020+: 1 = master stack)
//   [11]    -     - Reserved
//   [10:8]  I2:I0 - Interrupt Priority Mask (0-7)
//   [7:5]   -     - Reserved
//   [4]     X     - Extend
//   [3]     N     - Negative
//   [2]     Z     - Zero
//   [1]     V     - Overflow
//   [0]     C     - Carry
isa_state sr[15:0];

// Individual flag aliases for compatibility
isa_state flag_X[0:0];
isa_state flag_N[0:0];
isa_state flag_Z[0:0];
isa_state flag_V[0:0];
isa_state flag_C[0:0];

// ============================================================================
// 68010+ Control Registers (accessible via MOVEC)
// ============================================================================
isa_state vbr[31:0];          // Vector Base Register (68010+)
isa_state sfc[2:0];           // Source Function Code (68010+)
isa_state dfc[2:0];           // Destination Function Code (68010+)
isa_state cacr[31:0];         // Cache Control Register (68020+)
isa_state caar[31:0];         // Cache Address Register (68020/030)

// ============================================================================
// Exception Processing State
// ============================================================================
// Exception vector numbers (multiply by 4 for offset from VBR):
//   0  - Reset: Initial SSP
//   1  - Reset: Initial PC
//   2  - Bus Error
//   3  - Address Error
//   4  - Illegal Instruction
//   5  - Zero Divide
//   6  - CHK/CHK2 Instruction
//   7  - cpTRAPcc, TRAPcc, TRAPV
//   8  - Privilege Violation
//   9  - Trace
//   10 - Line-A Emulator (1010)
//   11 - Line-F Emulator (1111)
//   12-14 - Reserved
//   15 - Uninitialized Interrupt Vector
//   16-23 - Reserved
//   24 - Spurious Interrupt
//   25-31 - Level 1-7 Autovectors
//   32-47 - TRAP #0-15 Instruction Vectors
//   48-54 - FP Exceptions (68040/68060)
//   55 - MMU Configuration Error
//   56-58 - MMU Exceptions
//   59-63 - Reserved
//   64-255 - User Defined Vectors

// ============================================================================
// Helper: Get current stack pointer based on S and M bits
// ============================================================================
// When S=0 (user mode): use USP
// When S=1, M=0 (interrupt): use ISP (ssp)
// When S=1, M=1 (master): use MSP
