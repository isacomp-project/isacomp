// SPDX-License-Identifier: BSD-3-Clause
// MC68010+ MOVES.L (An)+,Dn - Move from address space with post-increment
// Opcode: 0000 1110 10 011 AAA followed by extension word
// Extension: 0RRR 0 000 0000 0000 where RRR=data reg, bit 11=0 (read from EA)
// Supervisor instruction - moves data from address space using SFC
// Without MMU, acts as normal MOVE.L (An)+,Dn

isa_state pc[31:0];
var instr[15:0];
isa_state dregs[31:0][2:0];
isa_state aregs[31:0][2:0];
mem dmem[25:0];
#ifdef MMU
isa_state tc[31:0];
isa_state tt0[31:0];
isa_state tt1[31:0];
isa_state crp[63:0];
isa_state srp[63:0];
isa_state vbr[31:0];
isa_state ssp[31:0];
isa_state usp[31:0];
isa_state sfc[2:0];
#endif
isa_state sr[15:0];
isa_state flag_X[0:0];
isa_state flag_N[0:0];
isa_state flag_Z[0:0];
isa_state flag_V[0:0];
isa_state flag_C[0:0];

var mvsr_ext[15:0];
var mvsr_dst_reg[2:0];
var mvsr_addr_reg[2:0];
var mvsr_addr[31:0];
var mvsr_data_hi[15:0];
var mvsr_data_lo[15:0];
var mvsr_data[31:0];

// Include interrupt and exception handling aspects
aspect m68k_exception.isa gates pc:2, sr:2, ssp:2, aregs:2, dmem:2, flag_C:2, flag_N:2, flag_Z:2, flag_V:2, flag_X:2, usp:2;
aspect m68k_interrupt.isa gates sr;
#ifdef MMU
aspect mmu/atc_translate_instr.isa gates pc, dmem;
#else
var pc_pa[31:0];
pc_pa = pc;
var pc_pa_delta[31:0];
pc_pa_delta = 32'd0;
#endif

// Fetch instruction
instr = dmem[pc_pa];
assume instr[15:6] == 10'b0000111010;  // MOVES.L
assume instr[5:3] == 0b011;            // EA mode: (An)+
pc when (~m68k_exc_taken) = pc + 2;

mvsr_addr_reg = instr[2:0];

// Fetch extension word
mvsr_ext = dmem[pc + pc_pa_delta];
assume mvsr_ext[15] == 0b0;     // D/A = 0 (data register)
assume mvsr_ext[11] == 0b0;     // Direction: read from EA (EA -> Rn)
assume mvsr_ext[10:0] == 11'b00000000000;
pc when (~m68k_exc_taken) = pc + 2;

mvsr_dst_reg = mvsr_ext[14:12];

// Supervisor check
assume sr[13] == 1'b1;

// Get address and read (with MMU translation)
mvsr_addr = aregs[mvsr_addr_reg];
#ifdef MMU
var mmu_va[31:0];
mmu_va = mvsr_addr;
var is_write[0:0];
is_write = 1'b0;
var fc_is_super[0:0];
fc_is_super = sfc[2];
aspect mmu/atc_translate_data_fc.isa gates pc:1, sr:1, ssp:1, aregs:1, dmem:1, flag_C:1, flag_N:1, flag_Z:1, flag_V:1, flag_X:1, usp:1;
#endif

#ifdef MMU
mvsr_data_hi = dmem[ea_pa];
mvsr_data_lo = dmem[ea_pa + 2];
#else
mvsr_data_hi = dmem[mvsr_addr];
mvsr_data_lo = dmem[mvsr_addr + 2];
#endif
mvsr_data = {mvsr_data_hi, mvsr_data_lo};

// Store result in data register
dregs[mvsr_dst_reg] when (~m68k_exc_taken & ~data_exc_taken) = mvsr_data;

// Post-increment by 4 (long)
aregs[mvsr_addr_reg] when (~m68k_exc_taken & ~data_exc_taken) = mvsr_addr + 4;

// MOVES does not affect CCR
