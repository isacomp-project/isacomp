// SPDX-License-Identifier: BSD-3-Clause
// M68000 MOVE from SR - Move from Status Register
// Opcode: 0100 0000 11 mmm rrr (40xx)
// where mmm=mode, rrr=register (this variant: Dn)
// On 68000: not privileged (user can read SR)
// On 68010+: privileged instruction
// Stores entire SR to destination

isa_state pc[31:0];
var instr[15:0];
isa_state dregs[31:0][2:0];
isa_state aregs[31:0][2:0];
mem dmem[23:0];

// Full Status Register
isa_state sr[15:0];

// CCR flags (not modified)
isa_state flag_X[0:0];
isa_state flag_N[0:0];
isa_state flag_Z[0:0];
isa_state flag_V[0:0];
isa_state flag_C[0:0];

var dst_reg[2:0];
var result[31:0];

// Include interrupt and exception handling aspects
aspect ../m68k_exception.isa gates pc, sr, ssp, aregs, dmem, flag_C, flag_N, flag_Z, flag_V, flag_X, usp;
aspect ../m68k_interrupt.isa gates sr;
#ifdef MMU
aspect mmu/atc_translate_instr.isa gates pc, dmem;
#else
var pc_pa[31:0];
pc_pa = pc;
var pc_pa_delta[31:0];
pc_pa_delta = 32'd0;
#endif

// Fetch instruction
instr = dmem[pc_pa];
assume instr[15:6] == 10'b0100000011;  // MOVE from SR opcode
assume instr[5:3] == 3'b000;            // EA mode: Data Register Direct
pc when (~m68k_exc_taken) = pc + 2;

// On 68010+, this is privileged - for this spec assume supervisor mode
// assume sr[13] == 1'b1;

// Decode destination register
dst_reg = instr[2:0];

// Reconstruct current SR from live flag values (sr[4:0] may be stale
// since regular instructions only update flag_* not sr)
var current_sr[15:0];
current_sr = {sr[15:5], flag_X, flag_N, flag_Z, flag_V, flag_C};

// Store SR to destination (zero-extended to 32 bits)
result = {16'b0, current_sr};
dregs[dst_reg] when (~m68k_exc_taken) = result;

// MOVE from SR does not affect CCR flags
