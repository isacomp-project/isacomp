// SPDX-License-Identifier: BSD-3-Clause
// M68000 TRAP #vector - Trap instruction
// Opcode: 0100 1110 0100 vvvv (4E40-4E4F)
// where vvvv is the vector number (0-15)
// Causes exception processing using vector 32+vvvv
// Pushes PC and SR onto supervisor stack, enters supervisor mode

isa_state pc[31:0];
var instr[15:0];
isa_state dregs[31:0][2:0];
isa_state aregs[31:0][2:0];
mem dmem[23:0];
#ifdef MMU
// MMU state (added by MMU preprocessor)
isa_state tc[31:0];
isa_state tt0[31:0];
isa_state tt1[31:0];
isa_state crp[63:0];
isa_state srp[63:0];
isa_state vbr[31:0];
isa_state ssp[31:0];
isa_state usp[31:0];
#endif

// Full Status Register
isa_state sr[15:0];
isa_state usp[31:0];
isa_state ssp[31:0];
isa_state vbr[31:0];

// CCR flags
isa_state flag_X[0:0];
isa_state flag_N[0:0];
isa_state flag_Z[0:0];
isa_state flag_V[0:0];
isa_state flag_C[0:0];

var vector[3:0];
var vector_num[7:0];
var vector_addr[31:0];
var handler_hi[15:0];
var handler_lo[15:0];
var handler[31:0];
var sp_after_format[31:0];
var sp_after_pc[31:0];
var sp_after_sr[31:0];
var old_sr[15:0];
var new_sr[15:0];
var return_pc[31:0];
var was_user[0:0];
var format_vector[15:0];
var trap_frame_lo[31:0];
var trap_frame_hi[31:0];

// Include interrupt and exception handling aspects
aspect ../m68k_exception.isa gates pc, sr, ssp, aregs, dmem, flag_C, flag_N, flag_Z, flag_V, flag_X, usp;
aspect ../m68k_interrupt.isa gates sr;
#ifdef MMU
aspect mmu/atc_translate_instr.isa gates pc, dmem;
#else
var pc_pa[31:0];
pc_pa = pc;
var pc_pa_delta[31:0];
pc_pa_delta = 32'd0;
#endif

// Fetch instruction
instr = dmem[pc_pa];
assume instr[15:4] == 12'h4E4;  // TRAP opcode prefix
pc when (~m68k_exc_taken) = pc + 2;

// Decode vector number (0-15)
vector = instr[3:0];

// Save current PC as return address (points to next instruction)
return_pc = pc;

// Save old SR (reconstruct from live flags to get correct CCR bits)
old_sr = {sr[15:5], flag_X, flag_N, flag_Z, flag_V, flag_C};

// Check if we're coming from user mode
was_user = ~sr[13];

// If in user mode, save USP and switch to SSP
usp when (was_user & ~m68k_exc_taken) = aregs[7];

// Calculate vector address: (32 + vector) * 4 + VBR
vector_num = {4'b0010, vector};  // 32 + vector (0-15) = vectors 32-47
vector_addr = vbr + {22'b0, vector_num, 2'b00};

// Read exception handler address from vector table
#ifdef MMU
var mmu_va[31:0];
mmu_va = vector_addr;
var is_write[0:0];
is_write = 1'b0;  // Vector table READ, not write
aspect mmu/atc_translate_data.isa gates pc:1, sr:1, ssp:1, aregs:1, dmem:1, flag_C:1, flag_N:1, flag_Z:1, flag_V:1, flag_X:1, usp:1;
#endif

#ifdef MMU
handler_hi = dmem[ea_pa];
#else
handler_hi = dmem[vector_addr];
#endif
#ifdef MMU
handler_lo = dmem[ea_pa + 2];
#else
handler_lo = dmem[vector_addr + 2];
#endif
handler = {handler_hi, handler_lo};

// Calculate stack positions (68010+ format 0: 8 bytes)
// When coming from user mode, use ssp (the supervisor stack);
// when already in supervisor mode, use aregs[7] (the live SP).
var base_sp[31:0];
base_sp = was_user ? ssp : aregs[7];
sp_after_format = base_sp - 2;
sp_after_pc = sp_after_format - 4;
sp_after_sr = sp_after_pc - 2;

// Format/vector word: format 0, vector offset = (32 + vector) * 4
format_vector = {4'b0000, 2'b00, vector_num, 2'b00};

// Push exception frame as two 32-bit writes to avoid dual-half collision
// Frame layout: [sp_after_sr]={SR, PC[31:16]}, [sp_after_sr+4]={PC[15:0], format}
trap_frame_lo = {old_sr, return_pc[31:16]};
trap_frame_hi = {return_pc[15:0], format_vector};
dmem[sp_after_sr] when (~m68k_exc_taken & ~data_exc_taken) = trap_frame_lo;
dmem[sp_after_sr + 4] when (~m68k_exc_taken & ~data_exc_taken) = trap_frame_hi;

// Update SSP
ssp when (~m68k_exc_taken & ~data_exc_taken) = sp_after_sr;

// Update A7 to point to supervisor stack
aregs[7] when (~m68k_exc_taken & ~data_exc_taken) = sp_after_sr;

// Enter supervisor mode, clear trace bits
// SR: set S bit (13), clear T1 (15) and T0 (14)
new_sr = {2'b00, 1'b1, old_sr[12:0]};
sr when (~m68k_exc_taken & ~data_exc_taken) = new_sr;

// CCR flags unchanged (they're part of saved SR)
flag_C when (~m68k_exc_taken & ~data_exc_taken) = new_sr[0];
flag_V when (~m68k_exc_taken & ~data_exc_taken) = new_sr[1];
flag_Z when (~m68k_exc_taken & ~data_exc_taken) = new_sr[2];
flag_N when (~m68k_exc_taken & ~data_exc_taken) = new_sr[3];
flag_X when (~m68k_exc_taken & ~data_exc_taken) = new_sr[4];

// Jump to exception handler
pc when (~m68k_exc_taken) = handler;
