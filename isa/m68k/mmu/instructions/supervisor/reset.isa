// SPDX-License-Identifier: BSD-3-Clause
// M68000 RESET - Assert RESET Line
// Opcode: 0100 1110 0111 0000 (4E70)
// Privileged instruction - asserts external RESET line for 124 clock cycles
// Does not affect internal processor state, only external devices
// Used to reset peripherals without resetting the processor

isa_state pc[31:0];
var instr[15:0];
isa_state dregs[31:0][2:0];
isa_state aregs[31:0][2:0];
mem dmem[23:0];

// Full Status Register
isa_state sr[15:0];

// CCR flags (not modified)
isa_state flag_X[0:0];
isa_state flag_N[0:0];
isa_state flag_Z[0:0];
isa_state flag_V[0:0];
isa_state flag_C[0:0];

// External reset signal (active high)
isa_state reset_out[0:0];

// Include interrupt and exception handling aspects
aspect ../m68k_exception.isa gates pc, sr, ssp, aregs, dmem, flag_C, flag_N, flag_Z, flag_V, flag_X, usp;
aspect ../m68k_interrupt.isa gates sr;
#ifdef MMU
aspect mmu/atc_translate_instr.isa gates pc, dmem;
#else
var pc_pa[31:0];
pc_pa = pc;
var pc_pa_delta[31:0];
pc_pa_delta = 32'd0;
#endif

// Fetch instruction
instr = dmem[pc_pa];
assume instr == 16'h4E70;  // RESET opcode
pc when (~m68k_exc_taken) = pc + 2;

// Must be in supervisor mode
assume sr[13] == 1'b1;

// Assert RESET line (external effect)
// In actual hardware, this would be asserted for 124 clock cycles
// For specification purposes, we model it as a state change
reset_out when (~m68k_exc_taken) = 1'b1;

// RESET does not affect CCR flags or any internal state
