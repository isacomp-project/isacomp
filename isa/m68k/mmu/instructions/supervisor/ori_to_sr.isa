// SPDX-License-Identifier: BSD-3-Clause
// M68000 ORI to SR - OR Immediate to Status Register
// Opcode: 0000 0000 0111 1100 (007C) followed by 16-bit immediate
// Privileged instruction - ORs immediate with SR
// Used to set specific SR bits (e.g., enter supervisor mode, set interrupt mask)

isa_state pc[31:0];
var instr[15:0];
var imm[15:0];
isa_state dregs[31:0][2:0];
isa_state aregs[31:0][2:0];
mem dmem[23:0];

// Full Status Register
isa_state sr[15:0];
isa_state usp[31:0];
isa_state ssp[31:0];

// CCR flags
isa_state flag_X[0:0];
isa_state flag_N[0:0];
isa_state flag_Z[0:0];
isa_state flag_V[0:0];
isa_state flag_C[0:0];

var new_sr[15:0];
var old_s[0:0];
var new_s[0:0];

// Include interrupt and exception handling aspects
aspect ../m68k_exception.isa gates pc, sr, ssp, aregs, dmem, flag_C, flag_N, flag_Z, flag_V, flag_X, usp;
aspect ../m68k_interrupt.isa gates sr;
#ifdef MMU
aspect mmu/atc_translate_instr.isa gates pc, dmem;
#else
var pc_pa[31:0];
pc_pa = pc;
var pc_pa_delta[31:0];
pc_pa_delta = 32'd0;
#endif

// Fetch instruction
instr = dmem[pc_pa];
assume instr == 16'h007C;  // ORI to SR opcode
pc when (~m68k_exc_taken) = pc + 2;

// Must be in supervisor mode
assume sr[13] == 1'b1;

// Fetch immediate value
imm = dmem[pc + pc_pa_delta];
pc when (~m68k_exc_taken) = pc + 2;

// Reconstruct current SR from live flag values (sr[4:0] may be stale
// since regular instructions only update flag_* not sr)
var current_sr[15:0];
current_sr = {sr[15:5], flag_X, flag_N, flag_Z, flag_V, flag_C};

// OR SR with immediate
new_sr = current_sr | imm;

// Check for mode change (S bit going from 0 to 1)
old_s = current_sr[13];
new_s = new_sr[13];

// Handle stack pointer switching
usp when (~old_s & new_s & ~m68k_exc_taken) = aregs[7];
aregs[7] when (~old_s & new_s & ~m68k_exc_taken) = ssp;

// Update Status Register
sr when (~m68k_exc_taken) = new_sr;

// Update CCR flag aliases
flag_C when (~m68k_exc_taken) = new_sr[0];
flag_V when (~m68k_exc_taken) = new_sr[1];
flag_Z when (~m68k_exc_taken) = new_sr[2];
flag_N when (~m68k_exc_taken) = new_sr[3];
flag_X when (~m68k_exc_taken) = new_sr[4];
