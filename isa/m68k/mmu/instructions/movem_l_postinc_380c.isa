// SPDX-License-Identifier: BSD-3-Clause
// M68000 MOVEM.L (An)+,d2, d3, a3, a4, a5 - postincrement (mask 0x380c)
// Generated ISA stub for MOVEM.L from memory with postincrement
// Loads 5 registers (20 bytes)

isa_state pc[31:0];
var instr[15:0];
isa_state dregs[31:0][2:0];
isa_state aregs[31:0][2:0];
mem dmem[25:0];
#ifdef MMU
// MMU state (added by MMU preprocessor)
isa_state tc[31:0];
isa_state tt0[31:0];
isa_state tt1[31:0];
isa_state crp[63:0];
isa_state srp[63:0];
isa_state vbr[31:0];
isa_state ssp[31:0];
isa_state usp[31:0];
#endif
isa_state flag_X[0:0];
isa_state flag_N[0:0];
isa_state flag_Z[0:0];
isa_state flag_V[0:0];
isa_state flag_C[0:0];

var addr_reg[2:0];
var movem_postinc_380c_mask[15:0];
var movem_postinc_380c_base[31:0];
var movem_postinc_380c_d2_val[31:0];
var movem_postinc_380c_d3_val[31:0];
var movem_postinc_380c_a3_val[31:0];
var movem_postinc_380c_a4_val[31:0];
var movem_postinc_380c_a5_val[31:0];

// Include interrupt and exception handling aspects
aspect m68k_exception.isa gates pc:2, sr:2, ssp:2, aregs:2, dmem:2, flag_C:2, flag_N:2, flag_Z:2, flag_V:2, flag_X:2, usp:2;
aspect m68k_interrupt.isa gates sr;
#ifdef MMU
aspect mmu/atc_translate_instr.isa gates pc, dmem;
#else
var pc_pa[31:0];
pc_pa = pc;
var pc_pa_delta[31:0];
pc_pa_delta = 32'd0;
#endif

// Fetch instruction
instr = dmem[pc_pa];
assume instr[15:6] == 0b0100110011;  // MOVEM.L from memory opcode
assume instr[5:3] == 0b011;          // Postincrement mode
pc when (~m68k_exc_taken) = pc + 32'd2;

addr_reg = instr[2:0];

// Fetch register mask
movem_postinc_380c_mask = dmem[pc + pc_pa_delta];
assume movem_postinc_380c_mask == 16'h380c;
pc when (~m68k_exc_taken) = pc + 32'd2;

movem_postinc_380c_base = aregs[addr_reg];

// Load registers (postincrement order)
#ifdef MMU
var mmu_va[31:0];
mmu_va = movem_postinc_380c_base;
var is_write[0:0];
is_write = 1'b0;
aspect mmu/atc_translate_data.isa gates pc:1, sr:1, ssp:1, aregs:1, dmem:1, flag_C:1, flag_N:1, flag_Z:1, flag_V:1, flag_X:1, usp:1;
#endif

#ifdef MMU
movem_postinc_380c_d2_val[31:16] = dmem[ea_pa + 32'd0];
#else
movem_postinc_380c_d2_val[31:16] = dmem[movem_postinc_380c_base + 32'd0];
#endif
#ifdef MMU
movem_postinc_380c_d2_val[15:0] = dmem[ea_pa + 32'd2];
#else
movem_postinc_380c_d2_val[15:0] = dmem[movem_postinc_380c_base + 32'd2];
#endif
dregs[2] when (~m68k_exc_taken & ~data_exc_taken) = movem_postinc_380c_d2_val;
#ifdef MMU
movem_postinc_380c_d3_val[31:16] = dmem[ea_pa + 32'd4];
#else
movem_postinc_380c_d3_val[31:16] = dmem[movem_postinc_380c_base + 32'd4];
#endif
#ifdef MMU
movem_postinc_380c_d3_val[15:0] = dmem[ea_pa + 32'd6];
#else
movem_postinc_380c_d3_val[15:0] = dmem[movem_postinc_380c_base + 32'd6];
#endif
dregs[3] when (~m68k_exc_taken & ~data_exc_taken) = movem_postinc_380c_d3_val;
#ifdef MMU
movem_postinc_380c_a3_val[31:16] = dmem[ea_pa + 32'd8];
#else
movem_postinc_380c_a3_val[31:16] = dmem[movem_postinc_380c_base + 32'd8];
#endif
#ifdef MMU
movem_postinc_380c_a3_val[15:0] = dmem[ea_pa + 32'd10];
#else
movem_postinc_380c_a3_val[15:0] = dmem[movem_postinc_380c_base + 32'd10];
#endif
aregs[3] when (~m68k_exc_taken & ~data_exc_taken) = movem_postinc_380c_a3_val;
#ifdef MMU
movem_postinc_380c_a4_val[31:16] = dmem[ea_pa + 32'd12];
#else
movem_postinc_380c_a4_val[31:16] = dmem[movem_postinc_380c_base + 32'd12];
#endif
#ifdef MMU
movem_postinc_380c_a4_val[15:0] = dmem[ea_pa + 32'd14];
#else
movem_postinc_380c_a4_val[15:0] = dmem[movem_postinc_380c_base + 32'd14];
#endif
aregs[4] when (~m68k_exc_taken & ~data_exc_taken) = movem_postinc_380c_a4_val;
#ifdef MMU
movem_postinc_380c_a5_val[31:16] = dmem[ea_pa + 32'd16];
#else
movem_postinc_380c_a5_val[31:16] = dmem[movem_postinc_380c_base + 32'd16];
#endif
#ifdef MMU
movem_postinc_380c_a5_val[15:0] = dmem[ea_pa + 32'd18];
#else
movem_postinc_380c_a5_val[15:0] = dmem[movem_postinc_380c_base + 32'd18];
#endif
aregs[5] when (~m68k_exc_taken & ~data_exc_taken) = movem_postinc_380c_a5_val;

// Update address register: base + 20
aregs[addr_reg] when (~m68k_exc_taken & ~data_exc_taken) = movem_postinc_380c_base + 32'd20;

// MOVEM does not affect flags
