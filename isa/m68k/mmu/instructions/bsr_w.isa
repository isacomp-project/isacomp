// SPDX-License-Identifier: BSD-3-Clause
// M68000 BSR.W label - Branch to subroutine (16-bit displacement)
// Opcode: 0110 0001 0000 0000 followed by 16-bit signed displacement
// Pushes return address onto stack (A7)

isa_state pc[31:0];
var instr[15:0];
isa_state dregs[31:0][2:0];
isa_state aregs[31:0][2:0];
mem dmem[25:0];
#ifdef MMU
// MMU state (added by MMU preprocessor)
isa_state tc[31:0];
isa_state tt0[31:0];
isa_state tt1[31:0];
isa_state crp[63:0];
isa_state srp[63:0];
isa_state vbr[31:0];
isa_state ssp[31:0];
isa_state usp[31:0];
#endif
isa_state flag_X[0:0];
isa_state flag_N[0:0];
isa_state flag_Z[0:0];
isa_state flag_V[0:0];
isa_state flag_C[0:0];

var disp16[15:0];
var sign_ext_disp[31:0];
var branch_pc[31:0];
var target[31:0];
var return_addr[31:0];
var sp[31:0];

// Include interrupt and exception handling aspects
aspect m68k_exception.isa gates pc:2, sr:2, ssp:2, aregs:2, dmem:2, flag_C:2, flag_N:2, flag_Z:2, flag_V:2, flag_X:2, usp:2;
aspect m68k_interrupt.isa gates sr;
#ifdef MMU
aspect mmu/atc_translate_instr.isa gates pc, dmem;
#else
var pc_pa[31:0];
pc_pa = pc;
var pc_pa_delta[31:0];
pc_pa_delta = 32'd0;
#endif

// Fetch instruction
instr = dmem[pc_pa];
assume instr == 16'h6100;  // BSR.W opcode (displacement = 0 means word follows)
branch_pc = pc + 2;  // PC for displacement calculation

// Fetch 16-bit displacement
disp16 = dmem[pc + 2 + pc_pa_delta];
sign_ext_disp = {{16{disp16[15]}}, disp16};

// Calculate target address
target = branch_pc + sign_ext_disp;

// Calculate return address (pc + 4 for this 4-byte instruction)
return_addr = pc + 4;

// Push return address onto stack (A7, pre-decrement)
sp = aregs[7] - 4;
aregs[7] when (~m68k_exc_taken) = sp;
#ifdef MMU
var mmu_va[31:0];
mmu_va = sp;
var is_write[0:0];
is_write = 1'b1;
aspect mmu/atc_translate_data.isa gates pc:1, sr:1, ssp:1, aregs:1, dmem:1, flag_C:1, flag_N:1, flag_Z:1, flag_V:1, flag_X:1, usp:1;
#endif

#ifdef MMU
dmem[ea_pa] when (~m68k_exc_taken & ~data_exc_taken) = return_addr[31:16];
#else
dmem[sp] when (~m68k_exc_taken & ~data_exc_taken) = return_addr[31:16];
#endif
#ifdef MMU
dmem[ea_pa + 2] when (~m68k_exc_taken & ~data_exc_taken) = return_addr[15:0];
#else
dmem[sp + 2] when (~m68k_exc_taken & ~data_exc_taken) = return_addr[15:0];
#endif

// Execute - branch to subroutine
pc when (~m68k_exc_taken) = target;

// BSR does not affect flags
