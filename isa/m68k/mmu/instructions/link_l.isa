// SPDX-License-Identifier: BSD-3-Clause
// MC68020 LINK.L An,#disp32 - Create stack frame with 32-bit displacement
// Opcode: 0100 1000 0000 1 AAA followed by 32-bit signed displacement
// Pushes An onto stack, copies SP to An, then adds displacement to SP

isa_state pc[31:0];
var instr[15:0];
isa_state dregs[31:0][2:0];
isa_state aregs[31:0][2:0];
mem dmem[25:0];
#ifdef MMU
// MMU state (added by MMU preprocessor)
isa_state tc[31:0];
isa_state tt0[31:0];
isa_state tt1[31:0];
isa_state crp[63:0];
isa_state srp[63:0];
isa_state vbr[31:0];
isa_state ssp[31:0];
isa_state usp[31:0];
#endif
isa_state flag_X[0:0];
isa_state flag_N[0:0];
isa_state flag_Z[0:0];
isa_state flag_V[0:0];
isa_state flag_C[0:0];

var addr_reg[2:0];
var link_l_disp_hi[15:0];
var link_l_disp_lo[15:0];
var link_l_disp32[31:0];
var link_l_sp[31:0];
var link_l_old_an[31:0];

// Include interrupt and exception handling aspects
aspect m68k_exception.isa gates pc:2, sr:2, ssp:2, aregs:2, dmem:2, flag_C:2, flag_N:2, flag_Z:2, flag_V:2, flag_X:2, usp:2;
aspect m68k_interrupt.isa gates sr;
#ifdef MMU
aspect mmu/atc_translate_instr.isa gates pc, dmem;
#else
var pc_pa[31:0];
pc_pa = pc;
var pc_pa_delta[31:0];
pc_pa_delta = 32'd0;
#endif

// Fetch instruction
instr = dmem[pc_pa];
assume instr[15:3] == 0b0100100000001;  // LINK.L opcode
pc when (~m68k_exc_taken) = pc + 2;

// Decode address register
addr_reg = instr[2:0];

// Fetch 32-bit displacement (big-endian: high word first)
link_l_disp_hi = dmem[pc + pc_pa_delta];
pc when (~m68k_exc_taken) = pc + 2;
link_l_disp_lo = dmem[pc + pc_pa_delta];
pc when (~m68k_exc_taken) = pc + 2;
link_l_disp32 = {link_l_disp_hi, link_l_disp_lo};

// Save current An value
link_l_old_an = aregs[addr_reg];

// Push An onto stack (pre-decrement SP/A7)
// Calculate sp = A7 - 4 but don't write to A7 yet (avoid OR bug)
link_l_sp = aregs[7] - 4;
#ifdef MMU
var mmu_va[31:0];
mmu_va = link_l_sp;
var is_write[0:0];
is_write = 1'b1;
aspect mmu/atc_translate_data.isa gates pc:1, sr:1, ssp:1, aregs:1, dmem:1, flag_C:1, flag_N:1, flag_Z:1, flag_V:1, flag_X:1, usp:1;
#endif

#ifdef MMU
dmem[ea_pa] when (~m68k_exc_taken & ~data_exc_taken) = link_l_old_an[31:16];
#else
dmem[link_l_sp] when (~m68k_exc_taken & ~data_exc_taken) = link_l_old_an[31:16];
#endif
#ifdef MMU
dmem[ea_pa + 2] when (~m68k_exc_taken & ~data_exc_taken) = link_l_old_an[15:0];
#else
dmem[link_l_sp + 2] when (~m68k_exc_taken & ~data_exc_taken) = link_l_old_an[15:0];
#endif

// Copy SP to An (An becomes the frame pointer)
aregs[addr_reg] when (~m68k_exc_taken & ~data_exc_taken) = link_l_sp;

// Set final SP value: sp + displacement (only write to A7 once)
aregs[7] when (~m68k_exc_taken & ~data_exc_taken) = link_l_sp + link_l_disp32;

// LINK does not affect flags
