// SPDX-License-Identifier: BSD-3-Clause
// M68000 ADDQ.L #imm,(xxx).L - Add quick to absolute long address
// Opcode: 0101 QQQ 010 111 001 followed by 32-bit address

isa_state pc[31:0];
var instr[15:0];
isa_state dregs[31:0][2:0];
isa_state aregs[31:0][2:0];
mem dmem[25:0];
#ifdef MMU
// MMU state (added by MMU preprocessor)
isa_state tc[31:0];
isa_state tt0[31:0];
isa_state tt1[31:0];
isa_state crp[63:0];
isa_state srp[63:0];
isa_state vbr[31:0];
isa_state ssp[31:0];
isa_state usp[31:0];
#endif
isa_state flag_X[0:0];
isa_state flag_N[0:0];
isa_state flag_Z[0:0];
isa_state flag_V[0:0];
isa_state flag_C[0:0];

var quick_val[2:0];
var addr_hi[15:0];
var addr_lo[15:0];
var abs_addr[31:0];
var data_hi[15:0];
var data_lo[15:0];
var src[31:0];
var imm_ext[31:0];
var result[31:0];

// Include interrupt and exception handling aspects
aspect m68k_exception.isa gates pc:2, sr:2, ssp:2, aregs:2, dmem:2, flag_C:2, flag_N:2, flag_Z:2, flag_V:2, flag_X:2, usp:2;
aspect m68k_interrupt.isa gates sr;
#ifdef MMU
aspect mmu/atc_translate_instr.isa gates pc, dmem;
#else
var pc_pa[31:0];
pc_pa = pc;
var pc_pa_delta[31:0];
pc_pa_delta = 32'd0;
#endif

// Fetch instruction
instr = dmem[pc_pa];
assume instr[15:12] == 0b0101;  // ADDQ
assume instr[8:6] == 0b010;     // Long size
assume instr[5:3] == 0b111;     // EA: Special
assume instr[2:0] == 0b001;     // Absolute long
pc when (~m68k_exc_taken) = pc + 2;

quick_val = instr[11:9];

// Fetch 32-bit address
addr_hi = dmem[pc + pc_pa_delta];
pc when (~m68k_exc_taken) = pc + 2;
addr_lo = dmem[pc + pc_pa_delta];
pc when (~m68k_exc_taken) = pc + 2;
abs_addr = {addr_hi, addr_lo};

// Read memory (32-bit, two 16-bit reads)
#ifdef MMU
var mmu_va[31:0];
mmu_va = abs_addr;
var is_write[0:0];
is_write = 1'b1;
aspect mmu/atc_translate_data.isa gates pc:1, sr:1, ssp:1, aregs:1, dmem:1, flag_C:1, flag_N:1, flag_Z:1, flag_V:1, flag_X:1, usp:1;
#endif

#ifdef MMU
data_hi = dmem[ea_pa];
#else
data_hi = dmem[abs_addr];
#endif
#ifdef MMU
data_lo = dmem[ea_pa + 2];
#else
data_lo = dmem[abs_addr + 2];
#endif
src = {data_hi, data_lo};

// Quick value: 0 means 8
imm_ext = quick_val == 0 ? 32'd8 : {29'b0, quick_val};

// Add
result = src + imm_ext;

// Write back
#ifdef MMU
dmem[ea_pa] when (~m68k_exc_taken & ~data_exc_taken) = result[31:16];
#else
dmem[abs_addr] when (~m68k_exc_taken & ~data_exc_taken) = result[31:16];
#endif
#ifdef MMU
dmem[ea_pa + 2] when (~m68k_exc_taken & ~data_exc_taken) = result[15:0];
#else
dmem[abs_addr + 2] when (~m68k_exc_taken & ~data_exc_taken) = result[15:0];
#endif

// Update CCR
flag_X when (~m68k_exc_taken & ~data_exc_taken) = result[31:0] < src[31:0];
flag_N when (~m68k_exc_taken & ~data_exc_taken) = result[31];
flag_Z when (~m68k_exc_taken & ~data_exc_taken) = result == 0;
flag_V when (~m68k_exc_taken & ~data_exc_taken) = (~src[31] & ~imm_ext[31] & result[31]) | (src[31] & imm_ext[31] & ~result[31]);
flag_C when (~m68k_exc_taken & ~data_exc_taken) = result[31:0] < src[31:0];
