// SPDX-License-Identifier: BSD-3-Clause
// M68000 ADDA.W (xxx).L,An - Add word from absolute long address to address register
// Opcode: 1101 DDD 011 111 001 followed by 32-bit address
// ADDA does NOT affect condition codes

isa_state pc[31:0];
var instr[15:0];
isa_state dregs[31:0][2:0];
isa_state aregs[31:0][2:0];
mem dmem[25:0];
#ifdef MMU
// MMU state (added by MMU preprocessor)
isa_state tc[31:0];
isa_state tt0[31:0];
isa_state tt1[31:0];
isa_state crp[63:0];
isa_state srp[63:0];
isa_state vbr[31:0];
isa_state ssp[31:0];
isa_state usp[31:0];
#endif
isa_state flag_X[0:0];
isa_state flag_N[0:0];
isa_state flag_Z[0:0];
isa_state flag_V[0:0];
isa_state flag_C[0:0];

var dst_reg[2:0];
var awala_addr_hi[15:0];
var awala_addr_lo[15:0];
var awala_addr[31:0];
var awala_src_word[15:0];
var awala_src_val[31:0];
var awala_result[31:0];

aspect m68k_exception.isa gates pc:2, sr:2, ssp:2, aregs:2, dmem:2, flag_C:2, flag_N:2, flag_Z:2, flag_V:2, flag_X:2, usp:2;
aspect m68k_interrupt.isa gates sr;
#ifdef MMU
aspect mmu/atc_translate_instr.isa gates pc, dmem;
#else
var pc_pa[31:0];
pc_pa = pc;
var pc_pa_delta[31:0];
pc_pa_delta = 32'd0;
#endif

instr = dmem[pc_pa];
assume instr[15:12] == 0b1101;  // ADDA opcode
assume instr[8:6] == 0b011;     // Opmode: ADDA.W
assume instr[5:3] == 0b111;     // EA mode: special
assume instr[2:0] == 0b001;     // EA reg: absolute long
pc when (~m68k_exc_taken) = pc + 2;

dst_reg = instr[11:9];

// Fetch 32-bit absolute address
awala_addr_hi = dmem[pc + pc_pa_delta];
pc when (~m68k_exc_taken) = pc + 2;
awala_addr_lo = dmem[pc + pc_pa_delta];
pc when (~m68k_exc_taken) = pc + 2;
awala_addr = {awala_addr_hi, awala_addr_lo};

// Read word from memory
#ifdef MMU
var mmu_va[31:0];
mmu_va = awala_addr;
var is_write[0:0];
is_write = 1'b0;
aspect mmu/atc_translate_data.isa gates pc:1, sr:1, ssp:1, aregs:1, dmem:1, flag_C:1, flag_N:1, flag_Z:1, flag_V:1, flag_X:1, usp:1;
#endif

#ifdef MMU
awala_src_word = dmem[ea_pa];
#else
awala_src_word = dmem[awala_addr];
#endif

awala_src_val = {{16{awala_src_word[15]}}, awala_src_word};

awala_result = aregs[dst_reg] + awala_src_val;
aregs[dst_reg] when (~m68k_exc_taken & ~data_exc_taken) = awala_result;
