// SPDX-License-Identifier: BSD-3-Clause
// MC68020 MOVE.B (bd32,An),Dn - Move byte from full indexed (IS) to data register
// Source: full ext word with IS=1 BS=0 BD=long (EA = An + bd32)
// Dest mode 000 = Dn
// Opcode: 0001 DDD 000 110 SSS

isa_state pc[31:0];
var instr[15:0];
isa_state dregs[31:0][2:0];
isa_state aregs[31:0][2:0];
mem dmem[25:0];
#ifdef MMU
// MMU state (added by MMU preprocessor)
isa_state tc[31:0];
isa_state tt0[31:0];
isa_state tt1[31:0];
isa_state crp[63:0];
isa_state srp[63:0];
isa_state vbr[31:0];
isa_state ssp[31:0];
isa_state usp[31:0];
#endif
isa_state flag_X[0:0];
isa_state flag_N[0:0];
isa_state flag_Z[0:0];
isa_state flag_V[0:0];
isa_state flag_C[0:0];

var dst_reg[2:0];
var src_reg[2:0];
var mbfis_ext[15:0];
var bd_hi[15:0];
var bd_lo[15:0];
var bd32[31:0];
var src_addr[31:0];
var mem_word[15:0];
var byte_val[7:0];
var result[31:0];

// Include interrupt and exception handling aspects
aspect m68k_exception.isa gates pc:2, sr:2, ssp:2, aregs:2, dmem:2, flag_C:2, flag_N:2, flag_Z:2, flag_V:2, flag_X:2, usp:2;
aspect m68k_interrupt.isa gates sr;
#ifdef MMU
aspect mmu/atc_translate_instr.isa gates pc, dmem;
#else
var pc_pa[31:0];
pc_pa = pc;
var pc_pa_delta[31:0];
pc_pa_delta = 32'd0;
#endif

// Fetch instruction
instr = dmem[pc_pa];
assume instr[15:12] == 0b0001;  // MOVE.B
assume instr[8:6] == 0b000;     // Dest mode: Dn
assume instr[5:3] == 0b110;     // Source mode: indexed
pc when (~m68k_exc_taken) = pc + 2;

dst_reg = instr[11:9];
src_reg = instr[2:0];

// Fetch source full extension word
mbfis_ext = dmem[pc + pc_pa_delta];
assume mbfis_ext[8] == 0b1;       // Full format
assume mbfis_ext[7] == 0b0;       // Base NOT suppressed (BS=0)
assume mbfis_ext[6] == 0b1;       // Index suppressed (IS=1)
assume mbfis_ext[5:4] == 0b11;    // BD size = long
assume mbfis_ext[3:0] == 0b0000;  // No memory indirect
pc when (~m68k_exc_taken) = pc + 2;

// Fetch 32-bit base displacement
bd_hi = dmem[pc + pc_pa_delta];
pc when (~m68k_exc_taken) = pc + 2;
bd_lo = dmem[pc + pc_pa_delta];
pc when (~m68k_exc_taken) = pc + 2;
bd32 = {bd_hi, bd_lo};

// Source effective address = An + bd32 (index suppressed)
src_addr = aregs[src_reg] + bd32;

// Read byte from memory
#ifdef MMU
var mmu_va[31:0];
mmu_va = {src_addr[31:1], 1'b0};
var is_write[0:0];
is_write = 1'b0;
aspect mmu/atc_translate_data.isa gates pc:1, sr:1, ssp:1, aregs:1, dmem:1, flag_C:1, flag_N:1, flag_Z:1, flag_V:1, flag_X:1, usp:1;
#endif

#ifdef MMU
mem_word = dmem[ea_pa];
#else
mem_word = dmem[{src_addr[31:1], 1'b0}];
#endif
byte_val = src_addr[0] ? mem_word[7:0] : mem_word[15:8];

// Write to data register (low byte only, upper 24 bits unchanged)
result = {dregs[dst_reg][31:8], byte_val};
dregs[dst_reg] when (~m68k_exc_taken & ~data_exc_taken) = result;

// Update CCR
flag_N when (~m68k_exc_taken & ~data_exc_taken) = byte_val[7];
flag_Z when (~m68k_exc_taken & ~data_exc_taken) = byte_val == 0;
flag_V when (~m68k_exc_taken & ~data_exc_taken) = 1'b0;
flag_C when (~m68k_exc_taken & ~data_exc_taken) = 1'b0;
