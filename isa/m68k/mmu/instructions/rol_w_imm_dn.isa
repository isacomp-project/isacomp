// SPDX-License-Identifier: BSD-3-Clause
// M68000 ROL.W #imm,Dn - Rotate Left Word by immediate count
// Opcode: 1110 CCC 1 01 0 11 DDD (CCC=count, DDD=register)

isa_state pc[31:0];
var instr[15:0];
isa_state dregs[31:0][2:0];
isa_state aregs[31:0][2:0];
mem dmem[25:0];
isa_state flag_X[0:0];
isa_state flag_N[0:0];
isa_state flag_Z[0:0];
isa_state flag_V[0:0];
isa_state flag_C[0:0];

var dst_reg[2:0];
var count[2:0];
var count_val[3:0];
var src[15:0];
var result[15:0];

// Include interrupt and exception handling aspects
aspect m68k_exception.isa gates pc:2, sr:2, ssp:2, aregs:2, dmem:2, flag_C:2, flag_N:2, flag_Z:2, flag_V:2, flag_X:2, usp:2;
aspect m68k_interrupt.isa gates sr;
#ifdef MMU
aspect mmu/atc_translate_instr.isa gates pc, dmem;
#else
var pc_pa[31:0];
pc_pa = pc;
var pc_pa_delta[31:0];
pc_pa_delta = 32'd0;
#endif

// Fetch instruction
instr = dmem[pc_pa];
assume instr[15:12] == 0b1110;  // Shift/Rotate
assume instr[8] == 0b1;          // Direction: left
assume instr[7:6] == 0b01;       // Word size
assume instr[5] == 0b0;          // Immediate count (not register)
assume instr[4:3] == 0b11;       // ROL type
pc when (~m68k_exc_taken) = pc + 2;

dst_reg = instr[2:0];
count = instr[11:9];

// Count: 0 means 8
count_val = count == 0 ? 4'd8 : {1'b0, count};

src = dregs[dst_reg][15:0];

// Rotate left by count_val
result = (src << count_val) | (src >> (5'd16 - count_val));

// Write back (only lower 16 bits)
dregs[dst_reg] when (~m68k_exc_taken) = {dregs[dst_reg][31:16], result};

// Update flags
flag_N when (~m68k_exc_taken) = result[15];
flag_Z when (~m68k_exc_taken) = result == 0;
flag_V when (~m68k_exc_taken) = 1'b0;
flag_C when (~m68k_exc_taken) = result[0];  // Last bit rotated out
