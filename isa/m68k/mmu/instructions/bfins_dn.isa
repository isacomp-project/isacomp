// SPDX-License-Identifier: BSD-3-Clause
// MC68020 BFINS Dn,Dn{offset:width} - Bit Field Insert into register
// Opcode: 1110 1111 11 000 rrr followed by extension word
// Extension: 0 DDD Do ooooo Dw wwwww
//   DDD = source data register (value to insert)
//   rrr = destination data register (target)
// Inserts 'width' bits from low bits of source into destination at offset

isa_state pc[31:0];
var instr[15:0];
isa_state dregs[31:0][2:0];
isa_state aregs[31:0][2:0];
mem dmem[25:0];
isa_state flag_X[0:0];
isa_state flag_N[0:0];
isa_state flag_Z[0:0];
isa_state flag_V[0:0];
isa_state flag_C[0:0];

var bfi_extw[15:0];
var ea_reg[2:0];
var src_reg[2:0];
var offset_field[4:0];
var width_field[4:0];
var offset[5:0];
var width[5:0];
var source[31:0];
var dest[31:0];
var insert_val[31:0];
var field_mask[31:0];
var shifted_mask[31:0];
var shifted_val[31:0];
var result[31:0];

// Include interrupt and exception handling aspects
aspect m68k_exception.isa gates pc:2, sr:2, ssp:2, aregs:2, dmem:2, flag_C:2, flag_N:2, flag_Z:2, flag_V:2, flag_X:2, usp:2;
aspect m68k_interrupt.isa gates sr;
#ifdef MMU
aspect mmu/atc_translate_instr.isa gates pc, dmem;
#else
var pc_pa[31:0];
pc_pa = pc;
var pc_pa_delta[31:0];
pc_pa_delta = 32'd0;
#endif

// Fetch instruction
instr = dmem[pc_pa];
assume instr[15:6] == 10'b1110111111;  // BFINS opcode
assume instr[5:3] == 3'b000;           // EA mode: Dn
pc when (~m68k_exc_taken) = pc + 2;

ea_reg = instr[2:0];

// Fetch extension word
bfi_extw = dmem[pc + pc_pa_delta];
assume bfi_extw[15] == 1'b0;
assume bfi_extw[11] == 1'b0;  // Immediate offset
assume bfi_extw[5] == 1'b0;   // Immediate width
pc when (~m68k_exc_taken) = pc + 2;

src_reg = bfi_extw[14:12];
offset_field = bfi_extw[10:6];
width_field = bfi_extw[4:0];

offset = {1'b0, offset_field};
width = width_field == 0 ? 6'd32 : {1'b0, width_field};

// Get values
source = dregs[src_reg];
dest = dregs[ea_reg];

// Extract low 'width' bits from source
field_mask = (width == 6'd32) ? 32'hFFFFFFFF : ((32'b1 << width) - 1);
insert_val = source & field_mask;

// Create mask and value at the correct position in the 32-bit register
// Bit offset 0 = MSB (bit 31), so field starts at bit (31 - offset)
shifted_mask = field_mask << (6'd32 - offset - width);
shifted_val = insert_val << (6'd32 - offset - width);

// Clear field bits and insert
result = (dest & ~shifted_mask) | shifted_val;

// Store result
dregs[ea_reg] when (~m68k_exc_taken) = result;

// Update CCR
flag_N when (~m68k_exc_taken) = insert_val[width - 1];
flag_Z when (~m68k_exc_taken) = insert_val == 0;
flag_V when (~m68k_exc_taken) = 1'b0;
flag_C when (~m68k_exc_taken) = 1'b0;
