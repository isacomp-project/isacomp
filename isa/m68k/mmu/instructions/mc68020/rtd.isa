// SPDX-License-Identifier: BSD-3-Clause
// MC68020 RTD - Return and Deallocate
// Opcode: 0100 1110 0111 0100 (4E74) followed by 16-bit displacement
// Pops return address and adds displacement to SP
// Used for returning from functions with stack parameters

isa_state pc[31:0];
var instr[15:0];
var disp[15:0];
isa_state dregs[31:0][2:0];
isa_state aregs[31:0][2:0];
mem dmem[25:0];
#ifdef MMU
// MMU state (added by MMU preprocessor)
isa_state tc[31:0];
isa_state tt0[31:0];
isa_state tt1[31:0];
isa_state crp[63:0];
isa_state srp[63:0];
isa_state vbr[31:0];
isa_state ssp[31:0];
isa_state usp[31:0];
#endif

isa_state sr[15:0];
isa_state flag_X[0:0];
isa_state flag_N[0:0];
isa_state flag_Z[0:0];
isa_state flag_V[0:0];
isa_state flag_C[0:0];

var sp[31:0];
var return_hi[15:0];
var return_lo[15:0];
var return_addr[31:0];
var disp_ext[31:0];

// Include interrupt and exception handling aspects
aspect ../m68k_exception.isa gates pc, sr, ssp, aregs, dmem, flag_C, flag_N, flag_Z, flag_V, flag_X, usp;
aspect ../m68k_interrupt.isa gates sr;
#ifdef MMU
aspect mmu/atc_translate_instr.isa gates pc, dmem;
#else
var pc_pa[31:0];
pc_pa = pc;
var pc_pa_delta[31:0];
pc_pa_delta = 32'd0;
#endif

instr = dmem[pc_pa];
assume instr == 16'h4E74;  // RTD opcode

// Fetch displacement (at pc + 2)
disp = dmem[pc + 2 + pc_pa_delta];

// Get stack pointer
sp = aregs[7];

// Pop return address
#ifdef MMU
var mmu_va[31:0];
mmu_va = sp;
var is_write[0:0];
is_write = 1'b0;
aspect mmu/atc_translate_data.isa gates pc:1, sr:1, ssp:1, aregs:1, dmem:1, flag_C:1, flag_N:1, flag_Z:1, flag_V:1, flag_X:1, usp:1;
#endif

#ifdef MMU
return_hi = dmem[ea_pa];
#else
return_hi = dmem[sp];
#endif
#ifdef MMU
return_lo = dmem[ea_pa + 2];
#else
return_lo = dmem[sp + 2];
#endif
return_addr = {return_hi, return_lo};

// Update SP: pop return address (4 bytes) + displacement
disp_ext = {{16{disp[15]}}, disp};  // Sign extend
aregs[7] when (~m68k_exc_taken & ~data_exc_taken) = sp + 4 + disp_ext;

// Return
pc when (~m68k_exc_taken) = return_addr;

// RTD does not affect flags
