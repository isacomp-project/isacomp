// SPDX-License-Identifier: BSD-3-Clause
// MC68020 TRAPcc - Trap on Condition
// Opcode: 0101 cccc 1111 1ooo
//   cccc = condition code (same as Bcc)
//   ooo = 010 (no operand), 011 (word operand), 100 (long operand)
// Traps (vector 7) if condition is true
// Operand is pushed onto stack for debugging

isa_state pc[31:0];
var instr[15:0];
isa_state dregs[31:0][2:0];
isa_state aregs[31:0][2:0];
mem dmem[25:0];
#ifdef MMU
// MMU state (added by MMU preprocessor)
isa_state tc[31:0];
isa_state tt0[31:0];
isa_state tt1[31:0];
isa_state crp[63:0];
isa_state srp[63:0];
isa_state vbr[31:0];
isa_state ssp[31:0];
isa_state usp[31:0];
#endif

isa_state sr[15:0];
isa_state usp[31:0];
isa_state ssp[31:0];
isa_state vbr[31:0];
isa_state flag_X[0:0];
isa_state flag_N[0:0];
isa_state flag_Z[0:0];
isa_state flag_V[0:0];
isa_state flag_C[0:0];

var cond[3:0];
var opmode[2:0];
var condition_true[0:0];

var vector_addr[31:0];
var handler_hi[15:0];
var handler_lo[15:0];
var handler[31:0];
var sp_after_format[31:0];
var sp_after_pc[31:0];
var sp_after_sr[31:0];
var old_sr[15:0];
var new_sr[15:0];
var return_pc[31:0];
var was_user[0:0];
var format_vector[15:0];
var trapcc_frame_lo[31:0];
var trapcc_frame_hi[31:0];

// Include interrupt and exception handling aspects
aspect ../m68k_exception.isa gates pc, sr, ssp, aregs, dmem, flag_C, flag_N, flag_Z, flag_V, flag_X, usp;
aspect ../m68k_interrupt.isa gates sr;
#ifdef MMU
aspect mmu/atc_translate_instr.isa gates pc, dmem;
#else
var pc_pa[31:0];
pc_pa = pc;
var pc_pa_delta[31:0];
pc_pa_delta = 32'd0;
#endif

instr = dmem[pc_pa];
assume instr[15:12] == 4'b0101;
assume instr[7:6] == 2'b11;
assume instr[5:3] == 3'b111;
pc when (~m68k_exc_taken) = pc + 2;

cond = instr[11:8];
opmode = instr[2:0];

// Skip operand word(s) if present
pc when (opmode == 3'b011 & ~m68k_exc_taken) = pc + 2;  // Word operand
pc when (opmode == 3'b100 & ~m68k_exc_taken) = pc + 4;  // Long operand

return_pc = pc;

// Evaluate condition (same as Bcc)
condition_true =
    (cond == 4'b0000) ? 1'b1 :                              // T (True)
    (cond == 4'b0001) ? 1'b0 :                              // F (False)
    (cond == 4'b0010) ? ~(flag_C | flag_Z) :                // HI
    (cond == 4'b0011) ? (flag_C | flag_Z) :                 // LS
    (cond == 4'b0100) ? ~flag_C :                           // CC/HS
    (cond == 4'b0101) ? flag_C :                            // CS/LO
    (cond == 4'b0110) ? ~flag_Z :                           // NE
    (cond == 4'b0111) ? flag_Z :                            // EQ
    (cond == 4'b1000) ? ~flag_V :                           // VC
    (cond == 4'b1001) ? flag_V :                            // VS
    (cond == 4'b1010) ? ~flag_N :                           // PL
    (cond == 4'b1011) ? flag_N :                            // MI
    (cond == 4'b1100) ? ~(flag_N ^ flag_V) :                // GE
    (cond == 4'b1101) ? (flag_N ^ flag_V) :                 // LT
    (cond == 4'b1110) ? ~(flag_Z | (flag_N ^ flag_V)) :     // GT
    (flag_Z | (flag_N ^ flag_V));                           // LE

// If condition true, trap (vector 7)
old_sr = sr;
was_user = ~sr[13];

usp when (condition_true & was_user & ~m68k_exc_taken) = aregs[7];

vector_addr = vbr + 32'h1C;  // Vector 7

#ifdef MMU
var mmu_va[31:0];
mmu_va = vector_addr;
var is_write[0:0];
is_write = 1'b1;
aspect mmu/atc_translate_data.isa gates pc:1, sr:1, ssp:1, aregs:1, dmem:1, flag_C:1, flag_N:1, flag_Z:1, flag_V:1, flag_X:1, usp:1;
#endif

#ifdef MMU
handler_hi = dmem[ea_pa];
#else
handler_hi = dmem[vector_addr];
#endif
#ifdef MMU
handler_lo = dmem[ea_pa + 2];
#else
handler_lo = dmem[vector_addr + 2];
#endif
handler = {handler_hi, handler_lo};

// Calculate stack positions (68010+ format 0: 8 bytes)
sp_after_format = ssp - 2;
sp_after_pc = sp_after_format - 4;
sp_after_sr = sp_after_pc - 2;

// Format/vector word: format 0, vector 7, offset = 7 * 4 = 28
format_vector = {4'b0000, 12'h01C};

// Push exception frame as two 32-bit writes to avoid dual-half collision
trapcc_frame_lo = {old_sr, return_pc[31:16]};
trapcc_frame_hi = {return_pc[15:0], format_vector};
dmem[sp_after_sr] when (condition_true & ~m68k_exc_taken) = trapcc_frame_lo;
dmem[sp_after_sr + 4] when (condition_true & ~m68k_exc_taken) = trapcc_frame_hi;

ssp when (condition_true & ~m68k_exc_taken) = sp_after_sr;
aregs[7] when (condition_true & ~m68k_exc_taken) = sp_after_sr;

new_sr = {2'b00, 1'b1, old_sr[12:0]};
sr when (condition_true & ~m68k_exc_taken) = new_sr;

flag_C when (condition_true & ~m68k_exc_taken) = new_sr[0];
flag_V when (condition_true & ~m68k_exc_taken) = new_sr[1];
flag_Z when (condition_true & ~m68k_exc_taken) = new_sr[2];
flag_N when (condition_true & ~m68k_exc_taken) = new_sr[3];
flag_X when (condition_true & ~m68k_exc_taken) = new_sr[4];

pc when (condition_true & ~m68k_exc_taken) = handler;
