// SPDX-License-Identifier: BSD-3-Clause
// M68000 MOVE.W An,Dn - Move word from address register to data register
// Opcode: 0011 DDD 000 001 AAA where DDD=dest data reg, AAA=src addr reg

isa_state pc[31:0];
var instr[15:0];
isa_state dregs[31:0][2:0];
isa_state aregs[31:0][2:0];
mem dmem[25:0];
isa_state flag_X[0:0];
isa_state flag_N[0:0];
isa_state flag_Z[0:0];
isa_state flag_V[0:0];
isa_state flag_C[0:0];

var dst_reg[2:0];
var src_reg[2:0];
var data[15:0];

// Include interrupt and exception handling aspects
aspect m68k_exception.isa gates pc:2, sr:2, ssp:2, aregs:2, dmem:2, flag_C:2, flag_N:2, flag_Z:2, flag_V:2, flag_X:2, usp:2;
aspect m68k_interrupt.isa gates sr;
#ifdef MMU
aspect mmu/atc_translate_instr.isa gates pc, dmem;
#else
var pc_pa[31:0];
pc_pa = pc;
var pc_pa_delta[31:0];
pc_pa_delta = 32'd0;
#endif

// Fetch instruction
instr = dmem[pc_pa];
assume instr[15:12] == 0b0011;  // MOVE.W opcode
assume instr[8:6] == 0b000;     // Destination mode: Data Register Direct
assume instr[5:3] == 0b001;     // Source mode: Address Register Direct
pc when (~m68k_exc_taken) = pc + 2;

// Decode
dst_reg = instr[11:9];
src_reg = instr[2:0];

// Get low word of address register
data = aregs[src_reg][15:0];

// Write to data register (word, preserve upper word)
dregs[dst_reg] when (~m68k_exc_taken) = {dregs[dst_reg][31:16], data};

// Update CCR
flag_N when (~m68k_exc_taken) = data[15];
flag_Z when (~m68k_exc_taken) = data == 0;
flag_V when (~m68k_exc_taken) = 1'b0;
flag_C when (~m68k_exc_taken) = 1'b0;
