// SPDX-License-Identifier: BSD-3-Clause
// M68000 NEGX.L Dn - Negate with Extend (two's complement with X) data register long
// Opcode: 0100 0000 10000 DDD where DDD=reg

isa_state pc[31:0];
var instr[15:0];
isa_state dregs[31:0][2:0];
isa_state aregs[31:0][2:0];
mem dmem[25:0];
isa_state flag_X[0:0];
isa_state flag_N[0:0];
isa_state flag_Z[0:0];
isa_state flag_V[0:0];
isa_state flag_C[0:0];

var dst_reg[2:0];
var src_val[31:0];
var x_val[31:0];
var result[32:0];
var old_z[0:0];

// Include interrupt and exception handling aspects
aspect m68k_exception.isa gates pc:2, sr:2, ssp:2, aregs:2, dmem:2, flag_C:2, flag_N:2, flag_Z:2, flag_V:2, flag_X:2, usp:2;
aspect m68k_interrupt.isa gates sr;
#ifdef MMU
aspect mmu/atc_translate_instr.isa gates pc, dmem;
#else
var pc_pa[31:0];
pc_pa = pc;
var pc_pa_delta[31:0];
pc_pa_delta = 32'd0;
#endif

// Fetch instruction
instr = dmem[pc_pa];
assume instr[15:8] == 0b01000000;  // NEGX opcode
assume instr[7:6] == 0b10;         // Size: long
assume instr[5:3] == 0b000;        // EA mode: Data Register Direct
pc when (~m68k_exc_taken) = pc + 2;

// Decode
dst_reg = instr[2:0];

// Save old Z flag for special Z handling
old_z = flag_Z;

// Execute: 0 - destination - X
src_val = dregs[dst_reg];
x_val = flag_X;
result = 0 - src_val - x_val;

// Write result
dregs[dst_reg] when (~m68k_exc_taken) = result[31:0];

// Update CCR
// X and C: Set if there was a borrow (result != 0 or original had borrow)
flag_X when (~m68k_exc_taken) = (src_val != 0) | (x_val != 0);
flag_C when (~m68k_exc_taken) = (src_val != 0) | (x_val != 0);

// V: Overflow occurs when negating the most negative number (0x80000000)
// For NEGX, this happens when (src_val + X) == 0x80000000
flag_V when (~m68k_exc_taken) = ((src_val + x_val) == 32'h80000000);

// Z: Special handling - only CLEARED if result is non-zero, not set if zero
// Z = Z AND (result == 0)
flag_Z when (~m68k_exc_taken) = old_z & (result[31:0] == 0);

// N: Sign of result
flag_N when (~m68k_exc_taken) = result[31];
