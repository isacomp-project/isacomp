// SPDX-License-Identifier: BSD-3-Clause
// M68000 MOVE.B d(An),(xxx).L - Move byte from displacement to absolute long
// Opcode: 0001 001 111 101 AAA followed by 16-bit displacement, then 32-bit address

isa_state pc[31:0];
var instr[15:0];
isa_state dregs[31:0][2:0];
isa_state aregs[31:0][2:0];
mem dmem[25:0];
#ifdef MMU
// MMU state (added by MMU preprocessor)
isa_state tc[31:0];
isa_state tt0[31:0];
isa_state tt1[31:0];
isa_state crp[63:0];
isa_state srp[63:0];
isa_state vbr[31:0];
isa_state ssp[31:0];
isa_state usp[31:0];
#endif
isa_state flag_X[0:0];
isa_state flag_N[0:0];
isa_state flag_Z[0:0];
isa_state flag_V[0:0];
isa_state flag_C[0:0];

var src_reg[2:0];
var disp[15:0];
var src_addr[31:0];
var dst_addr_hi[15:0];
var dst_addr_lo[15:0];
var dst_addr[31:0];
var mem_word_src[15:0];
var mem_word_dst[15:0];
var data[7:0];

// Include interrupt and exception handling aspects
aspect m68k_exception.isa gates pc:2, sr:2, ssp:2, aregs:2, dmem:2, flag_C:2, flag_N:2, flag_Z:2, flag_V:2, flag_X:2, usp:2;
aspect m68k_interrupt.isa gates sr;
#ifdef MMU
aspect mmu/atc_translate_instr.isa gates pc, dmem;
#else
var pc_pa[31:0];
pc_pa = pc;
var pc_pa_delta[31:0];
pc_pa_delta = 32'd0;
#endif

// Fetch instruction
instr = dmem[pc_pa];
assume instr[15:12] == 0b0001;  // MOVE.B
assume instr[11:9] == 0b001;    // Dst register for abs.L
assume instr[8:6] == 0b111;     // Dst mode: Special
assume instr[5:3] == 0b101;     // Src mode: d(An)
pc when (~m68k_exc_taken) = pc + 2;

src_reg = instr[2:0];

// Fetch displacement
disp = dmem[pc + pc_pa_delta];
pc when (~m68k_exc_taken) = pc + 2;

// Fetch 32-bit destination address
dst_addr_hi = dmem[pc + pc_pa_delta];
pc when (~m68k_exc_taken) = pc + 2;
dst_addr_lo = dmem[pc + pc_pa_delta];
pc when (~m68k_exc_taken) = pc + 2;
dst_addr = {dst_addr_hi, dst_addr_lo};

// Calculate source address
src_addr = aregs[src_reg] + {{16{disp[15]}}, disp};

// Read byte from source
#ifdef MMU
var mmu_va[31:0];
mmu_va = {src_addr[31:1], 1'b0};
var is_write[0:0];
is_write = 1'b0;
aspect mmu/atc_translate_data.isa gates pc:1, sr:1, ssp:1, aregs:1, dmem:1, flag_C:1, flag_N:1, flag_Z:1, flag_V:1, flag_X:1, usp:1;
#endif

#ifdef MMU
mem_word_src = dmem[ea_pa];
#else
mem_word_src = dmem[{src_addr[31:1], 1'b0}];
#endif
data = src_addr[0] ? mem_word_src[7:0] : mem_word_src[15:8];

// Write byte to destination
mem_word_dst = dmem[{dst_addr[31:1], 1'b0}];
dmem[{dst_addr[31:1], 1'b0}] when (~m68k_exc_taken & ~data_exc_taken) = dst_addr[0] ? {mem_word_dst[15:8], data} : {data, mem_word_dst[7:0]};

// Update CCR
flag_N when (~m68k_exc_taken & ~data_exc_taken) = data[7];
flag_Z when (~m68k_exc_taken & ~data_exc_taken) = data == 0;
flag_V when (~m68k_exc_taken & ~data_exc_taken) = 1'b0;
flag_C when (~m68k_exc_taken & ~data_exc_taken) = 1'b0;
