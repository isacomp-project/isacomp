// SPDX-License-Identifier: BSD-3-Clause
// M68000 SUBQ.L #data,d(An,Xn) - Subtract quick from long in memory (indexed)
// Opcode: 0101 DDD1 10110 AAA followed by brief extension word

isa_state pc[31:0];
var instr[15:0];
isa_state dregs[31:0][2:0];
isa_state aregs[31:0][2:0];
mem dmem[25:0];
#ifdef MMU
// MMU state (added by MMU preprocessor)
isa_state tc[31:0];
isa_state tt0[31:0];
isa_state tt1[31:0];
isa_state crp[63:0];
isa_state srp[63:0];
isa_state vbr[31:0];
isa_state ssp[31:0];
isa_state usp[31:0];
#endif
isa_state flag_X[0:0];
isa_state flag_N[0:0];
isa_state flag_Z[0:0];
isa_state flag_V[0:0];
isa_state flag_C[0:0];

var addr_reg[2:0];
var quick_data[2:0];
var imm_val[31:0];
var briefword[15:0];
var idx_reg[2:0];
var idx_is_addr[0:0];
var idx_is_long[0:0];
var scale[1:0];
var disp8[7:0];
var disp_ext[31:0];
var idx_raw[31:0];
var idx_val[31:0];
var scaled_idx[31:0];
var addr[31:0];
var dst_hi[15:0];
var dst_lo[15:0];
var dst_val[31:0];
var result[32:0];

// Include interrupt and exception handling aspects
aspect m68k_exception.isa gates pc:2, sr:2, ssp:2, aregs:2, dmem:2, flag_C:2, flag_N:2, flag_Z:2, flag_V:2, flag_X:2, usp:2;
aspect m68k_interrupt.isa gates sr;
#ifdef MMU
aspect mmu/atc_translate_instr.isa gates pc, dmem;
#else
var pc_pa[31:0];
pc_pa = pc;
var pc_pa_delta[31:0];
pc_pa_delta = 32'd0;
#endif

// Fetch instruction
instr = dmem[pc_pa];
assume instr[15:12] == 0b0101;  // ADDQ/SUBQ opcode
assume instr[8] == 1;           // SUBQ (not ADDQ)
assume instr[7:6] == 0b10;      // Size: long
assume instr[5:3] == 0b110;     // EA mode: d(An,Xn)
pc when (~m68k_exc_taken) = pc + 2;

quick_data = instr[11:9];
addr_reg = instr[2:0];

// Fetch brief extension word
briefword = dmem[pc + pc_pa_delta];
assume briefword[8] == 0;  // Brief format
pc when (~m68k_exc_taken) = pc + 2;

idx_is_addr = briefword[15];
idx_reg = briefword[14:12];
idx_is_long = briefword[11];
scale = briefword[10:9];
disp8 = briefword[7:0];
disp_ext = {{24{disp8[7]}}, disp8};

// Get index register value
idx_raw = idx_is_addr ? aregs[idx_reg] : dregs[idx_reg];
idx_val = idx_is_long ? idx_raw : {{16{idx_raw[15]}}, idx_raw[15:0]};

// Apply scale
scaled_idx = scale == 0b00 ? idx_val : (scale == 0b01 ? idx_val << 1 : (scale == 0b10 ? idx_val << 2 : idx_val << 3));

// Convert quick data (0 means 8, 1-7 means 1-7)
imm_val = quick_data == 0 ? 32'h00000008 : {{29{1'b0}}, quick_data};

// Calculate effective address
addr = aregs[addr_reg] + disp_ext + scaled_idx;

// Read destination from memory
#ifdef MMU
var mmu_va[31:0];
mmu_va = addr;
var is_write[0:0];
is_write = 1'b1;
aspect mmu/atc_translate_data.isa gates pc:1, sr:1, ssp:1, aregs:1, dmem:1, flag_C:1, flag_N:1, flag_Z:1, flag_V:1, flag_X:1, usp:1;
#endif

#ifdef MMU
dst_hi = dmem[ea_pa];
#else
dst_hi = dmem[addr];
#endif
#ifdef MMU
dst_lo = dmem[ea_pa + 2];
#else
dst_lo = dmem[addr + 2];
#endif
dst_val = {dst_hi, dst_lo};

// Execute
result = dst_val - imm_val;

// Write result back to memory
#ifdef MMU
dmem[ea_pa] when (~m68k_exc_taken & ~data_exc_taken) = result[31:16];
#else
dmem[addr] when (~m68k_exc_taken & ~data_exc_taken) = result[31:16];
#endif
#ifdef MMU
dmem[ea_pa + 2] when (~m68k_exc_taken & ~data_exc_taken) = result[15:0];
#else
dmem[addr + 2] when (~m68k_exc_taken & ~data_exc_taken) = result[15:0];
#endif

// Update CCR
flag_X when (~m68k_exc_taken & ~data_exc_taken) = imm_val > dst_val;
flag_C when (~m68k_exc_taken & ~data_exc_taken) = imm_val > dst_val;
flag_V when (~m68k_exc_taken & ~data_exc_taken) = (dst_val[31] & ~imm_val[31] & ~result[31]) | (~dst_val[31] & imm_val[31] & result[31]);
flag_Z when (~m68k_exc_taken & ~data_exc_taken) = result[31:0] == 0;
flag_N when (~m68k_exc_taken & ~data_exc_taken) = result[31];
