// SPDX-License-Identifier: BSD-3-Clause
// M68000 NEG.L (d16,An) - Negate long in memory with displacement
// Opcode: 0100 0100 10 101 AAA followed by d16

isa_state pc[31:0];
var instr[15:0];
isa_state dregs[31:0][2:0];
isa_state aregs[31:0][2:0];
mem dmem[25:0];
#ifdef MMU
// MMU state (added by MMU preprocessor)
isa_state tc[31:0];
isa_state tt0[31:0];
isa_state tt1[31:0];
isa_state crp[63:0];
isa_state srp[63:0];
isa_state vbr[31:0];
isa_state ssp[31:0];
isa_state usp[31:0];
#endif
isa_state flag_X[0:0];
isa_state flag_N[0:0];
isa_state flag_Z[0:0];
isa_state flag_V[0:0];
isa_state flag_C[0:0];

var addr_reg[2:0];
var nlgd_disp[15:0];
var nlgd_addr[31:0];
var nlgd_src_hi[15:0];
var nlgd_src_lo[15:0];
var nlgd_src_val[31:0];
var nlgd_result[31:0];

// Include interrupt and exception handling aspects
aspect m68k_exception.isa gates pc:2, sr:2, ssp:2, aregs:2, dmem:2, flag_C:2, flag_N:2, flag_Z:2, flag_V:2, flag_X:2, usp:2;
aspect m68k_interrupt.isa gates sr;
#ifdef MMU
aspect mmu/atc_translate_instr.isa gates pc, dmem;
#else
var pc_pa[31:0];
pc_pa = pc;
var pc_pa_delta[31:0];
pc_pa_delta = 32'd0;
#endif

// Fetch instruction
instr = dmem[pc_pa];
assume instr[15:8] == 0b01000100;  // NEG opcode
assume instr[7:6] == 0b10;         // Size: long
assume instr[5:3] == 0b101;        // EA mode: (d16,An)
pc when (~m68k_exc_taken) = pc + 2;

// Decode
addr_reg = instr[2:0];

// Fetch displacement
nlgd_disp = dmem[pc + pc_pa_delta];
pc when (~m68k_exc_taken) = pc + 2;

// Calculate effective address
nlgd_addr = aregs[addr_reg] + {{16{nlgd_disp[15]}}, nlgd_disp};

// MMU translate
#ifdef MMU
var mmu_va[31:0];
mmu_va = nlgd_addr;
var is_write[0:0];
is_write = 1'b1;
aspect mmu/atc_translate_data.isa gates pc:1, sr:1, ssp:1, aregs:1, dmem:1, flag_C:1, flag_N:1, flag_Z:1, flag_V:1, flag_X:1, usp:1;
#endif

// Read from memory (two 16-bit reads for 32-bit value, big-endian)
#ifdef MMU
nlgd_src_hi = dmem[ea_pa];
#else
nlgd_src_hi = dmem[nlgd_addr];
#endif
#ifdef MMU
nlgd_src_lo = dmem[ea_pa + 2];
#else
nlgd_src_lo = dmem[nlgd_addr + 2];
#endif
nlgd_src_val = {nlgd_src_hi, nlgd_src_lo};

// Execute: 0 - source
nlgd_result = 0 - nlgd_src_val;

// Write result back to memory
#ifdef MMU
dmem[ea_pa] when (~m68k_exc_taken & ~data_exc_taken) = nlgd_result[31:16];
#else
dmem[nlgd_addr] when (~m68k_exc_taken & ~data_exc_taken) = nlgd_result[31:16];
#endif
#ifdef MMU
dmem[ea_pa + 2] when (~m68k_exc_taken & ~data_exc_taken) = nlgd_result[15:0];
#else
dmem[nlgd_addr + 2] when (~m68k_exc_taken & ~data_exc_taken) = nlgd_result[15:0];
#endif

// Update CCR
flag_X when (~m68k_exc_taken & ~data_exc_taken) = nlgd_src_val != 0;
flag_C when (~m68k_exc_taken & ~data_exc_taken) = nlgd_src_val != 0;
flag_V when (~m68k_exc_taken & ~data_exc_taken) = nlgd_src_val == 32'h80000000;
flag_Z when (~m68k_exc_taken & ~data_exc_taken) = nlgd_result == 0;
flag_N when (~m68k_exc_taken & ~data_exc_taken) = nlgd_result[31];
