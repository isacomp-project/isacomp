// SPDX-License-Identifier: BSD-3-Clause
// MC68020 BFTST d(An,Xn){offset:width} - Bit Field Test from indexed memory
// Opcode: 1110 1000 11 110 AAA followed by BF extension word + brief index ext word
// BF ext: 0 000 Do ooooo Dw wwwww
// Handles immediate offset and immediate width

isa_state pc[31:0];
var instr[15:0];
isa_state dregs[31:0][2:0];
isa_state aregs[31:0][2:0];
mem dmem[25:0];
#ifdef MMU
// MMU state (added by MMU preprocessor)
isa_state tc[31:0];
isa_state tt0[31:0];
isa_state tt1[31:0];
isa_state crp[63:0];
isa_state srp[63:0];
isa_state vbr[31:0];
isa_state ssp[31:0];
isa_state usp[31:0];
#endif
isa_state flag_X[0:0];
isa_state flag_N[0:0];
isa_state flag_Z[0:0];
isa_state flag_V[0:0];
isa_state flag_C[0:0];

var bf_ext[15:0];
var ea_reg[2:0];
var offset[5:0];
var width[5:0];
var idx_ext[15:0];
var idx_reg[2:0];
var idx_is_addr[0:0];
var idx_is_long[0:0];
var idx_scale[1:0];
var disp8[7:0];
var disp_ext[31:0];
var raw_idx[31:0];
var idx_val[31:0];
var scaled_idx[31:0];
var base_addr[31:0];
var byte_addr[31:0];
var bit_in_byte[2:0];
var word_addr[31:0];
var mem_hi[15:0];
var mem_lo[15:0];
var mem_raw[31:0];
var mem_adj[31:0];
var shifted[31:0];
var mask[31:0];
var field[31:0];

// Include interrupt and exception handling aspects
aspect m68k_exception.isa gates pc:2, sr:2, ssp:2, aregs:2, dmem:2, flag_C:2, flag_N:2, flag_Z:2, flag_V:2, flag_X:2, usp:2;
aspect m68k_interrupt.isa gates sr;
#ifdef MMU
aspect mmu/atc_translate_instr.isa gates pc, dmem;
#else
var pc_pa[31:0];
pc_pa = pc;
var pc_pa_delta[31:0];
pc_pa_delta = 32'd0;
#endif

// Fetch instruction
instr = dmem[pc_pa];
assume instr[15:6] == 10'b1110100011;  // BFTST opcode
assume instr[5:3] == 3'b110;           // EA mode: d(An,Xn)
pc when (~m68k_exc_taken) = pc + 2;

ea_reg = instr[2:0];

// Fetch BF extension word
bf_ext = dmem[pc + pc_pa_delta];
assume bf_ext[15] == 1'b0;
assume bf_ext[11] == 1'b0;  // Immediate offset
assume bf_ext[5] == 1'b0;   // Immediate width
pc when (~m68k_exc_taken) = pc + 2;

offset = {1'b0, bf_ext[10:6]};
width = bf_ext[4:0] == 0 ? 6'd32 : {1'b0, bf_ext[4:0]};

// Fetch brief extension word for indexed addressing
idx_ext = dmem[pc + pc_pa_delta];
assume idx_ext[8] == 1'b0;  // Brief format
pc when (~m68k_exc_taken) = pc + 2;

idx_reg = idx_ext[14:12];
idx_is_addr = idx_ext[15];
idx_is_long = idx_ext[11];
idx_scale = idx_ext[10:9];
disp8 = idx_ext[7:0];
disp_ext = {{24{disp8[7]}}, disp8};

raw_idx = idx_is_addr ? aregs[idx_reg] : dregs[idx_reg];
idx_val = idx_is_long ? raw_idx : {{16{raw_idx[15]}}, raw_idx[15:0]};

scaled_idx = idx_scale == 2'b00 ? idx_val :
             idx_scale == 2'b01 ? (idx_val << 1) :
             idx_scale == 2'b10 ? (idx_val << 2) :
                                  (idx_val << 3);

// Calculate base effective address
base_addr = aregs[ea_reg] + disp_ext + scaled_idx;

// Add byte offset from bit offset (offset / 8)
byte_addr = base_addr + {{29{offset[5]}}, offset[5:3]};
bit_in_byte = offset[2:0];

// Align to word boundary for 16-bit memory reads
word_addr = {byte_addr[31:1], 1'b0};

// Read 4 bytes (2 words) to cover any bit field
#ifdef MMU
var mmu_va[31:0];
mmu_va = word_addr;
var is_write[0:0];
is_write = 1'b0;
aspect mmu/atc_translate_data.isa gates pc:1, sr:1, ssp:1, aregs:1, dmem:1, flag_C:1, flag_N:1, flag_Z:1, flag_V:1, flag_X:1, usp:1;
#endif

#ifdef MMU
mem_hi = dmem[ea_pa];
#else
mem_hi = dmem[word_addr];
#endif
#ifdef MMU
mem_lo = dmem[ea_pa + 2];
#else
mem_lo = dmem[word_addr + 2];
#endif
mem_raw = {mem_hi, mem_lo};

// Adjust for odd byte address
mem_adj = byte_addr[0] ? (mem_raw << 4'd8) : mem_raw;

// Shift to align field MSB to bit 31
shifted = mem_adj << bit_in_byte;

// Extract field
mask = (width == 6'd32) ? 32'hFFFFFFFF : ((32'b1 << width) - 1);
field = (shifted >> (6'd32 - width)) & mask;

// Update CCR (no result stored for BFTST)
flag_N when (~m68k_exc_taken & ~data_exc_taken) = shifted[31];
flag_Z when (~m68k_exc_taken & ~data_exc_taken) = field == 0;
flag_V when (~m68k_exc_taken & ~data_exc_taken) = 1'b0;
flag_C when (~m68k_exc_taken & ~data_exc_taken) = 1'b0;
