// SPDX-License-Identifier: BSD-3-Clause
// M68000 MOVEQ #imm8,Dn - Move quick (8-bit immediate sign-extended to 32 bits)
// Opcode: 0111 DDD0 DDDD DDDD where DDD=reg, DDDDDDDD=8-bit data

isa_state pc[31:0];
var instr[15:0];
isa_state dregs[31:0][2:0];
isa_state aregs[31:0][2:0];
mem dmem[25:0];
isa_state flag_X[0:0];
isa_state flag_N[0:0];
isa_state flag_Z[0:0];
isa_state flag_V[0:0];
isa_state flag_C[0:0];

var dst_reg[2:0];
var imm8[7:0];
var imm_val[31:0];

// Include interrupt and exception handling aspects
aspect m68k_exception.isa gates pc:2, sr:2, ssp:2, aregs:2, dmem:2, flag_C:2, flag_N:2, flag_Z:2, flag_V:2, flag_X:2, usp:2;
aspect m68k_interrupt.isa gates sr;
#ifdef MMU
aspect mmu/atc_translate_instr.isa gates pc, dmem;
#else
var pc_pa[31:0];
pc_pa = pc;
var pc_pa_delta[31:0];
pc_pa_delta = 32'd0;
#endif

// Fetch instruction
instr = dmem[pc_pa];
assume instr[15:12] == 0b0111;  // MOVEQ opcode
assume instr[8] == 0;           // Must be 0 for MOVEQ
pc when (~m68k_exc_taken) = pc + 2;

// Decode
dst_reg = instr[11:9];
imm8 = instr[7:0];

// Sign extend to 32 bits
imm_val = {{24{imm8[7]}}, imm8};

// Execute
dregs[dst_reg] when (~m68k_exc_taken) = imm_val;

// Update CCR
flag_N when (~m68k_exc_taken) = imm_val[31];
flag_Z when (~m68k_exc_taken) = imm_val == 0;
flag_V when (~m68k_exc_taken) = 1'b0;
flag_C when (~m68k_exc_taken) = 1'b0;
