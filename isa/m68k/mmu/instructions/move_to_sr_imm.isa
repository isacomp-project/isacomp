// SPDX-License-Identifier: BSD-3-Clause
// M68000 MOVE #imm,SR - Move immediate to Status Register
// Opcode: 0100 0110 11 111 100 (46FC) followed by 16-bit immediate
// Privileged instruction - loads entire SR from immediate value
// Full supervisor implementation with sr/usp/ssp state

isa_state pc[31:0];
var instr[15:0];
isa_state dregs[31:0][2:0];
isa_state aregs[31:0][2:0];
mem dmem[25:0];

// Full Status Register and supervisor state
isa_state sr[15:0];
isa_state usp[31:0];
isa_state ssp[31:0];
isa_state vbr[31:0];

// CCR flags
isa_state flag_X[0:0];
isa_state flag_N[0:0];
isa_state flag_Z[0:0];
isa_state flag_V[0:0];
isa_state flag_C[0:0];

var imm_val[15:0];
var new_sr[15:0];
var old_s[0:0];
var new_s[0:0];

// Include interrupt and exception handling aspects
aspect m68k_exception.isa gates pc:2, sr:2, ssp:2, aregs:2, dmem:2, flag_C:2, flag_N:2, flag_Z:2, flag_V:2, flag_X:2, usp:2;
aspect m68k_interrupt.isa gates sr;
#ifdef MMU
aspect mmu/atc_translate_instr.isa gates pc, dmem;
#else
var pc_pa[31:0];
pc_pa = pc;
var pc_pa_delta[31:0];
pc_pa_delta = 32'd0;
#endif

// Fetch instruction
instr = dmem[pc_pa];
assume instr[15:6] == 0b0100011011;  // MOVE to SR opcode
assume instr[5:3] == 0b111;           // EA mode: Mode 7
assume instr[2:0] == 0b100;           // EA reg: 4 (immediate)
pc when (~m68k_exc_taken) = pc + 2;

// Must be in supervisor mode (privileged on 68010+)
assume sr[13] == 1'b1;

// Fetch immediate value
imm_val = dmem[pc + pc_pa_delta];
pc when (~m68k_exc_taken) = pc + 2;

new_sr = imm_val;

// Check for mode change
old_s = sr[13];
new_s = new_sr[13];

// Handle stack pointer switching
ssp when (old_s & ~new_s & ~m68k_exc_taken) = aregs[7];
aregs[7] when (old_s & ~new_s & ~m68k_exc_taken) = usp;
usp when (~old_s & new_s & ~m68k_exc_taken) = aregs[7];
aregs[7] when (~old_s & new_s & ~m68k_exc_taken) = ssp;

// Update Status Register
sr when (~m68k_exc_taken) = new_sr;

// Update CCR flag aliases
flag_C when (~m68k_exc_taken) = new_sr[0];
flag_V when (~m68k_exc_taken) = new_sr[1];
flag_Z when (~m68k_exc_taken) = new_sr[2];
flag_N when (~m68k_exc_taken) = new_sr[3];
flag_X when (~m68k_exc_taken) = new_sr[4];
