// SPDX-License-Identifier: BSD-3-Clause
// M68000 EORI.W #imm,(xxx).W - Exclusive OR Immediate Word with Absolute Short Address
// Opcode: 0000 1010 0111 1000 followed by 16-bit immediate and 16-bit address

isa_state pc[31:0];
var instr[15:0];
isa_state dregs[31:0][2:0];
isa_state aregs[31:0][2:0];
mem dmem[25:0];
#ifdef MMU
// MMU state (added by MMU preprocessor)
isa_state tc[31:0];
isa_state tt0[31:0];
isa_state tt1[31:0];
isa_state crp[63:0];
isa_state srp[63:0];
isa_state vbr[31:0];
isa_state ssp[31:0];
isa_state usp[31:0];
#endif
isa_state flag_X[0:0];
isa_state flag_N[0:0];
isa_state flag_Z[0:0];
isa_state flag_V[0:0];
isa_state flag_C[0:0];

var eiwa_imm16[15:0];
var eiwa_addr_raw[15:0];
var eiwa_addr[31:0];
var eiwa_mem_val[15:0];
var eiwa_result[15:0];

// Include interrupt and exception handling aspects
aspect m68k_exception.isa gates pc:2, sr:2, ssp:2, aregs:2, dmem:2, flag_C:2, flag_N:2, flag_Z:2, flag_V:2, flag_X:2, usp:2;
aspect m68k_interrupt.isa gates sr;
#ifdef MMU
aspect mmu/atc_translate_instr.isa gates pc, dmem;
#else
var pc_pa[31:0];
pc_pa = pc;
var pc_pa_delta[31:0];
pc_pa_delta = 32'd0;
#endif

// Fetch instruction
instr = dmem[pc_pa];
assume instr == 16'h0A78;  // EORI.W (xxx).W
pc when (~m68k_exc_taken) = pc + 2;

// Fetch 16-bit immediate
eiwa_imm16 = dmem[pc + pc_pa_delta];
pc when (~m68k_exc_taken) = pc + 2;

// Fetch 16-bit absolute short address (sign-extended to 32)
eiwa_addr_raw = dmem[pc + pc_pa_delta];
pc when (~m68k_exc_taken) = pc + 2;
eiwa_addr = {{16{eiwa_addr_raw[15]}}, eiwa_addr_raw};

// MMU translation
#ifdef MMU
var mmu_va[31:0];
mmu_va = eiwa_addr;
var is_write[0:0];
is_write = 1'b1;
aspect mmu/atc_translate_data.isa gates pc:1, sr:1, ssp:1, aregs:1, dmem:1, flag_C:1, flag_N:1, flag_Z:1, flag_V:1, flag_X:1, usp:1;
#endif

// Read word from memory
#ifdef MMU
eiwa_mem_val = dmem[ea_pa];
#else
eiwa_mem_val = dmem[eiwa_addr];
#endif

// Execute EOR
eiwa_result = eiwa_mem_val ^ eiwa_imm16;

// Write result back to memory
#ifdef MMU
dmem[ea_pa] when (~m68k_exc_taken & ~data_exc_taken) = eiwa_result;
#else
dmem[eiwa_addr] when (~m68k_exc_taken & ~data_exc_taken) = eiwa_result;
#endif

// Update CCR (X not affected)
flag_N when (~m68k_exc_taken & ~data_exc_taken) = eiwa_result[15];
flag_Z when (~m68k_exc_taken & ~data_exc_taken) = eiwa_result == 0;
flag_V when (~m68k_exc_taken & ~data_exc_taken) = 1'b0;
flag_C when (~m68k_exc_taken & ~data_exc_taken) = 1'b0;
