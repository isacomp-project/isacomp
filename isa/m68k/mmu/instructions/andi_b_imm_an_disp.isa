// SPDX-License-Identifier: BSD-3-Clause
// M68000 ANDI.B #imm,d(An) - AND immediate byte to memory (displacement)
// Opcode: 0000 0010 00 101 AAA followed by immediate word, then 16-bit displacement

isa_state pc[31:0];
var instr[15:0];
isa_state dregs[31:0][2:0];
isa_state aregs[31:0][2:0];
mem dmem[25:0];
#ifdef MMU
// MMU state (added by MMU preprocessor)
isa_state tc[31:0];
isa_state tt0[31:0];
isa_state tt1[31:0];
isa_state crp[63:0];
isa_state srp[63:0];
isa_state vbr[31:0];
isa_state ssp[31:0];
isa_state usp[31:0];
#endif
isa_state flag_X[0:0];
isa_state flag_N[0:0];
isa_state flag_Z[0:0];
isa_state flag_V[0:0];
isa_state flag_C[0:0];

var addr_reg[2:0];
var ext_word[15:0];
var imm_byte[7:0];
var disp[15:0];
var disp_ext[31:0];
var eff_addr[31:0];
var dst_word[15:0];
var dst_byte[7:0];
var result_byte[7:0];
var new_word[15:0];

// Include interrupt and exception handling aspects
aspect m68k_exception.isa gates pc:2, sr:2, ssp:2, aregs:2, dmem:2, flag_C:2, flag_N:2, flag_Z:2, flag_V:2, flag_X:2, usp:2;
aspect m68k_interrupt.isa gates sr;
#ifdef MMU
aspect mmu/atc_translate_instr.isa gates pc, dmem;
#else
var pc_pa[31:0];
pc_pa = pc;
var pc_pa_delta[31:0];
pc_pa_delta = 32'd0;
#endif

// Fetch instruction
instr = dmem[pc_pa];
assume instr[15:8] == 0b00000010;  // ANDI opcode
assume instr[7:6] == 0b00;         // Size: byte
assume instr[5:3] == 0b101;        // EA mode: d(An)
pc when (~m68k_exc_taken) = pc + 2;

addr_reg = instr[2:0];

// Fetch immediate byte
ext_word = dmem[pc + pc_pa_delta];
pc when (~m68k_exc_taken) = pc + 2;
imm_byte = ext_word[7:0];

// Fetch 16-bit displacement
disp = dmem[pc + pc_pa_delta];
pc when (~m68k_exc_taken) = pc + 2;
disp_ext = {{16{disp[15]}}, disp};

// Calculate effective address
eff_addr = aregs[addr_reg] + disp_ext;

// Read-modify-write byte
#ifdef MMU
var mmu_va[31:0];
mmu_va = eff_addr;
var is_write[0:0];
is_write = 1'b1;
aspect mmu/atc_translate_data.isa gates pc:1, sr:1, ssp:1, aregs:1, dmem:1, flag_C:1, flag_N:1, flag_Z:1, flag_V:1, flag_X:1, usp:1;
#endif

#ifdef MMU
dst_word = dmem[{ea_pa[31:1], 1'b0}];
#else
dst_word = dmem[{eff_addr[31:1], 1'b0}];
#endif
dst_byte = eff_addr[0] ? dst_word[7:0] : dst_word[15:8];
result_byte = dst_byte & imm_byte;
new_word = eff_addr[0] ? {dst_word[15:8], result_byte} : {result_byte, dst_word[7:0]};
#ifdef MMU
dmem[{ea_pa[31:1], 1'b0}] when (~m68k_exc_taken & ~data_exc_taken) = new_word;
#else
dmem[{eff_addr[31:1], 1'b0}] when (~m68k_exc_taken & ~data_exc_taken) = new_word;
#endif

// Update CCR
flag_N when (~m68k_exc_taken & ~data_exc_taken) = result_byte[7];
flag_Z when (~m68k_exc_taken & ~data_exc_taken) = result_byte == 0;
flag_V when (~m68k_exc_taken & ~data_exc_taken) = 1'b0;
flag_C when (~m68k_exc_taken & ~data_exc_taken) = 1'b0;
