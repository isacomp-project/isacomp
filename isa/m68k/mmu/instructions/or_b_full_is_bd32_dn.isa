// SPDX-License-Identifier: BSD-3-Clause
// MC68020 OR.B (bd32,An),Dn - OR byte from full indexed (IS=1, BD=long) to data register
// Full ext: BS=0 (base used), IS=1 (index suppressed), BD=long (32-bit), I/IS=000
// EA = An + bd32
// Opcode: 1000 DDD 000 110 AAA followed by full ext word + bd32

isa_state pc[31:0];
var instr[15:0];
isa_state dregs[31:0][2:0];
isa_state aregs[31:0][2:0];
mem dmem[25:0];
#ifdef MMU
// MMU state (added by MMU preprocessor)
isa_state tc[31:0];
isa_state tt0[31:0];
isa_state tt1[31:0];
isa_state crp[63:0];
isa_state srp[63:0];
isa_state vbr[31:0];
isa_state ssp[31:0];
isa_state usp[31:0];
#endif
isa_state flag_X[0:0];
isa_state flag_N[0:0];
isa_state flag_Z[0:0];
isa_state flag_V[0:0];
isa_state flag_C[0:0];

isa_state dregs_b[7:0][2:0] of dregs[0b***][7:0];

var dst_reg[2:0];
var base_reg[2:0];
var mobfi_ext[15:0];
var bd_hi[15:0];
var bd_lo[15:0];
var bd32[31:0];
var eff_addr[31:0];
var mobfi_word[15:0];
var src_val[7:0];
var dst_val[7:0];
var result[7:0];

// Include interrupt and exception handling aspects
aspect m68k_exception.isa gates pc:2, sr:2, ssp:2, aregs:2, dmem:2, flag_C:2, flag_N:2, flag_Z:2, flag_V:2, flag_X:2, usp:2;
aspect m68k_interrupt.isa gates sr;
#ifdef MMU
aspect mmu/atc_translate_instr.isa gates pc, dmem;
#else
var pc_pa[31:0];
pc_pa = pc;
var pc_pa_delta[31:0];
pc_pa_delta = 32'd0;
#endif

// Fetch instruction
instr = dmem[pc_pa];
assume instr[15:12] == 0b1000;  // OR opcode
assume instr[8:6] == 0b000;     // Opmode: byte, EA to Dn
assume instr[5:3] == 0b110;     // EA mode: indexed
pc when (~m68k_exc_taken) = pc + 2;

dst_reg = instr[11:9];
base_reg = instr[2:0];

// Fetch full extension word
mobfi_ext = dmem[pc + pc_pa_delta];
assume mobfi_ext[8] == 0b1;       // Full format
assume mobfi_ext[7] == 0b0;       // Base NOT suppressed (An used)
assume mobfi_ext[6] == 0b1;       // Index suppressed
assume mobfi_ext[5:4] == 0b11;    // BD size = long (32-bit)
assume mobfi_ext[3:0] == 0b0000;  // No memory indirect
pc when (~m68k_exc_taken) = pc + 2;

// Fetch 32-bit base displacement
bd_hi = dmem[pc + pc_pa_delta];
pc when (~m68k_exc_taken) = pc + 2;
bd_lo = dmem[pc + pc_pa_delta];
pc when (~m68k_exc_taken) = pc + 2;
bd32 = {bd_hi, bd_lo};

// Calculate effective address (base + displacement, no index)
eff_addr = aregs[base_reg] + bd32;

// Read byte from memory
#ifdef MMU
var mmu_va[31:0];
mmu_va = eff_addr;
var is_write[0:0];
is_write = 1'b0;
aspect mmu/atc_translate_data.isa gates pc:1, sr:1, ssp:1, aregs:1, dmem:1, flag_C:1, flag_N:1, flag_Z:1, flag_V:1, flag_X:1, usp:1;
#endif

#ifdef MMU
mobfi_word = dmem[{ea_pa[31:1], 1'b0}];
src_val = eff_addr[0] ? mobfi_word[7:0] : mobfi_word[15:8];
#else
mobfi_word = dmem[{eff_addr[31:1], 1'b0}];
src_val = eff_addr[0] ? mobfi_word[7:0] : mobfi_word[15:8];
#endif

// Execute OR
dst_val = dregs_b[dst_reg];
result = dst_val | src_val;

// Write result
dregs_b[dst_reg] when (~m68k_exc_taken & ~data_exc_taken) = result;

// Update CCR (X not affected)
flag_N when (~m68k_exc_taken & ~data_exc_taken) = result[7];
flag_Z when (~m68k_exc_taken & ~data_exc_taken) = result == 0;
flag_V when (~m68k_exc_taken & ~data_exc_taken) = 1'b0;
flag_C when (~m68k_exc_taken & ~data_exc_taken) = 1'b0;
