// SPDX-License-Identifier: BSD-3-Clause
// M68000 NOT.L (d16,An) - Logical complement (one's complement) long in memory (displacement)
// Opcode: 0100 0110 10101 AAA followed by 16-bit signed displacement

isa_state pc[31:0];
var instr[15:0];
isa_state dregs[31:0][2:0];
isa_state aregs[31:0][2:0];
mem dmem[25:0];
#ifdef MMU
// MMU state (added by MMU preprocessor)
isa_state tc[31:0];
isa_state tt0[31:0];
isa_state tt1[31:0];
isa_state crp[63:0];
isa_state srp[63:0];
isa_state vbr[31:0];
isa_state ssp[31:0];
isa_state usp[31:0];
#endif
isa_state flag_X[0:0];
isa_state flag_N[0:0];
isa_state flag_Z[0:0];
isa_state flag_V[0:0];
isa_state flag_C[0:0];

var addr_reg[2:0];
var mnlda_disp[15:0];
var mnlda_disp_ext[31:0];
var mnlda_addr[31:0];
var mnlda_src_hi[15:0];
var mnlda_src_lo[15:0];
var mnlda_src_val[31:0];
var mnlda_result[31:0];

// Include interrupt and exception handling aspects
aspect m68k_exception.isa gates pc:2, sr:2, ssp:2, aregs:2, dmem:2, flag_C:2, flag_N:2, flag_Z:2, flag_V:2, flag_X:2, usp:2;
aspect m68k_interrupt.isa gates sr;
#ifdef MMU
aspect mmu/atc_translate_instr.isa gates pc, dmem;
#else
var pc_pa[31:0];
pc_pa = pc;
var pc_pa_delta[31:0];
pc_pa_delta = 32'd0;
#endif

// Fetch instruction
instr = dmem[pc_pa];
assume instr[15:8] == 0b01000110;  // NOT opcode
assume instr[7:6] == 0b10;         // Size: long
assume instr[5:3] == 0b101;        // EA mode: Address Register Indirect with Displacement
pc when (~m68k_exc_taken) = pc + 2;

// Decode
addr_reg = instr[2:0];

// Fetch displacement
mnlda_disp = dmem[pc + pc_pa_delta];
pc when (~m68k_exc_taken) = pc + 2;
mnlda_disp_ext = {{16{mnlda_disp[15]}}, mnlda_disp};

// Calculate effective address
mnlda_addr = aregs[addr_reg] + mnlda_disp_ext;

// MMU translate
#ifdef MMU
var mmu_va[31:0];
mmu_va = mnlda_addr;
var is_write[0:0];
is_write = 1'b1;
aspect mmu/atc_translate_data.isa gates pc:1, sr:1, ssp:1, aregs:1, dmem:1, flag_C:1, flag_N:1, flag_Z:1, flag_V:1, flag_X:1, usp:1;
#endif

// Read from memory (two 16-bit reads for 32-bit value, big-endian)
#ifdef MMU
mnlda_src_hi = dmem[ea_pa];
#else
mnlda_src_hi = dmem[mnlda_addr];
#endif
#ifdef MMU
mnlda_src_lo = dmem[ea_pa + 2];
#else
mnlda_src_lo = dmem[mnlda_addr + 2];
#endif
mnlda_src_val = {mnlda_src_hi, mnlda_src_lo};

// Execute: invert all bits
mnlda_result = ~mnlda_src_val;

// Write result back to memory
#ifdef MMU
dmem[ea_pa] when (~m68k_exc_taken & ~data_exc_taken) = mnlda_result[31:16];
#else
dmem[mnlda_addr] when (~m68k_exc_taken & ~data_exc_taken) = mnlda_result[31:16];
#endif
#ifdef MMU
dmem[ea_pa + 2] when (~m68k_exc_taken & ~data_exc_taken) = mnlda_result[15:0];
#else
dmem[mnlda_addr + 2] when (~m68k_exc_taken & ~data_exc_taken) = mnlda_result[15:0];
#endif

// Update CCR (X not affected)
flag_N when (~m68k_exc_taken & ~data_exc_taken) = mnlda_result[31];
flag_Z when (~m68k_exc_taken & ~data_exc_taken) = mnlda_result == 0;
flag_V when (~m68k_exc_taken & ~data_exc_taken) = 1'b0;
flag_C when (~m68k_exc_taken & ~data_exc_taken) = 1'b0;
