// SPDX-License-Identifier: BSD-3-Clause
// M68000 ANDI.W #imm,d(An) - AND Immediate Word with memory displacement
// Opcode: 0000 0010 01 101 AAA followed by 16-bit immediate, then 16-bit displacement

isa_state pc[31:0];
var instr[15:0];
isa_state dregs[31:0][2:0];
isa_state aregs[31:0][2:0];
mem dmem[25:0];
#ifdef MMU
// MMU state (added by MMU preprocessor)
isa_state tc[31:0];
isa_state tt0[31:0];
isa_state tt1[31:0];
isa_state crp[63:0];
isa_state srp[63:0];
isa_state vbr[31:0];
isa_state ssp[31:0];
isa_state usp[31:0];
#endif
isa_state flag_X[0:0];
isa_state flag_N[0:0];
isa_state flag_Z[0:0];
isa_state flag_V[0:0];
isa_state flag_C[0:0];

var addr_reg[2:0];
var imm16[15:0];
var disp16[15:0];
var disp_ext[31:0];
var eff_addr[31:0];
var mem_val[15:0];
var result[15:0];

// Include interrupt and exception handling aspects
aspect m68k_exception.isa gates pc:2, sr:2, ssp:2, aregs:2, dmem:2, flag_C:2, flag_N:2, flag_Z:2, flag_V:2, flag_X:2, usp:2;
aspect m68k_interrupt.isa gates sr;
#ifdef MMU
aspect mmu/atc_translate_instr.isa gates pc, dmem;
#else
var pc_pa[31:0];
pc_pa = pc;
var pc_pa_delta[31:0];
pc_pa_delta = 32'd0;
#endif

// Fetch instruction
instr = dmem[pc_pa];
assume instr[15:8] == 0b00000010;  // ANDI
assume instr[7:6] == 0b01;         // Word size
assume instr[5:3] == 0b101;        // EA mode: d(An)
pc when (~m68k_exc_taken) = pc + 2;

addr_reg = instr[2:0];

// Fetch immediate
imm16 = dmem[pc + pc_pa_delta];
pc when (~m68k_exc_taken) = pc + 2;

// Fetch displacement
disp16 = dmem[pc + pc_pa_delta];
pc when (~m68k_exc_taken) = pc + 2;
disp_ext = disp16[15] ? {16'hFFFF, disp16} : {16'h0000, disp16};

// Calculate effective address
eff_addr = aregs[addr_reg] + disp_ext;

// Read, AND, write
#ifdef MMU
var mmu_va[31:0];
mmu_va = eff_addr;
var is_write[0:0];
is_write = 1'b1;
aspect mmu/atc_translate_data.isa gates pc:1, sr:1, ssp:1, aregs:1, dmem:1, flag_C:1, flag_N:1, flag_Z:1, flag_V:1, flag_X:1, usp:1;
#endif

#ifdef MMU
mem_val = dmem[ea_pa];
#else
mem_val = dmem[eff_addr];
#endif
result = mem_val & imm16;
#ifdef MMU
dmem[ea_pa] when (~m68k_exc_taken & ~data_exc_taken) = result;
#else
dmem[eff_addr] when (~m68k_exc_taken & ~data_exc_taken) = result;
#endif

// Update CCR (X not affected)
flag_N when (~m68k_exc_taken & ~data_exc_taken) = result[15];
flag_Z when (~m68k_exc_taken & ~data_exc_taken) = result == 0;
flag_V when (~m68k_exc_taken & ~data_exc_taken) = 1'b0;
flag_C when (~m68k_exc_taken & ~data_exc_taken) = 1'b0;
