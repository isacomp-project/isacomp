// SPDX-License-Identifier: BSD-3-Clause
// M68000 BSET Dn,(An)+ - BSET bit in byte, postincrement
// Opcode: 0000 SSS 111 011 AAA

isa_state pc[31:0];
var instr[15:0];
isa_state dregs[31:0][2:0];
isa_state aregs[31:0][2:0];
mem dmem[25:0];
#ifdef MMU
// MMU state (added by MMU preprocessor)
isa_state tc[31:0];
isa_state tt0[31:0];
isa_state tt1[31:0];
isa_state crp[63:0];
isa_state srp[63:0];
isa_state vbr[31:0];
isa_state ssp[31:0];
isa_state usp[31:0];
#endif
isa_state flag_X[0:0];
isa_state flag_N[0:0];
isa_state flag_Z[0:0];
isa_state flag_V[0:0];
isa_state flag_C[0:0];

var src_reg[2:0];
var addr_reg[2:0];
var bspi_bit_num[31:0];
var bspi_byte_addr[31:0];
var bspi_bit_pos[2:0];
var bspi_dst_word[15:0];
var bspi_dst_byte[7:0];
var bspi_bit_val[0:0];
var bspi_mask[7:0];
var bspi_new_byte[7:0];
var bspi_new_word[15:0];

aspect m68k_exception.isa gates pc:2, sr:2, ssp:2, aregs:2, dmem:2, flag_C:2, flag_N:2, flag_Z:2, flag_V:2, flag_X:2, usp:2;
aspect m68k_interrupt.isa gates sr;
#ifdef MMU
aspect mmu/atc_translate_instr.isa gates pc, dmem;
#else
var pc_pa[31:0];
pc_pa = pc;
var pc_pa_delta[31:0];
pc_pa_delta = 32'd0;
#endif

instr = dmem[pc_pa];
assume instr[15:12] == 0b0000;
assume instr[8:6] == 0b111;
assume instr[5:3] == 0b011;     // EA: (An)+
pc when (~m68k_exc_taken) = pc + 2;

src_reg = instr[11:9];
addr_reg = instr[2:0];
bspi_bit_num = dregs[src_reg];
bspi_byte_addr = aregs[addr_reg];
bspi_bit_pos = bspi_bit_num[2:0];

#ifdef MMU
var mmu_va[31:0];
mmu_va = bspi_byte_addr;
var is_write[0:0];
is_write = 1'b1;
aspect mmu/atc_translate_data.isa gates pc:1, sr:1, ssp:1, aregs:1, dmem:1, flag_C:1, flag_N:1, flag_Z:1, flag_V:1, flag_X:1, usp:1;
#endif

#ifdef MMU
bspi_dst_word = dmem[ea_pa];
#else
bspi_dst_word = dmem[bspi_byte_addr];
#endif
bspi_dst_byte = bspi_byte_addr[0] ? bspi_dst_word[7:0] : bspi_dst_word[15:8];

bspi_bit_val = (bspi_dst_byte >> bspi_bit_pos) & 1;
flag_Z when (~m68k_exc_taken & ~data_exc_taken) = ~bspi_bit_val;
bspi_mask = 1 << bspi_bit_pos;
bspi_new_byte = bspi_dst_byte | bspi_mask;
bspi_new_word = bspi_byte_addr[0] ? {bspi_dst_word[15:8], bspi_new_byte} : {bspi_new_byte, bspi_dst_word[7:0]};
#ifdef MMU
dmem[ea_pa] when (~m68k_exc_taken & ~data_exc_taken) = bspi_new_word;
#else
dmem[bspi_byte_addr] when (~m68k_exc_taken & ~data_exc_taken) = bspi_new_word;
#endif

aregs[addr_reg] when (~m68k_exc_taken & ~data_exc_taken) = aregs[addr_reg] + 1;
