// SPDX-License-Identifier: BSD-3-Clause
// M68000 MOVE.W d(An),d(Am) - Move word between displacement-addressed memory locations
// Opcode: 0011 DDD 101 101 SSS followed by src displacement, then dest displacement

isa_state pc[31:0];
var instr[15:0];
isa_state dregs[31:0][2:0];
isa_state aregs[31:0][2:0];
mem dmem[25:0];
#ifdef MMU
// MMU state (added by MMU preprocessor)
isa_state tc[31:0];
isa_state tt0[31:0];
isa_state tt1[31:0];
isa_state crp[63:0];
isa_state srp[63:0];
isa_state vbr[31:0];
isa_state ssp[31:0];
isa_state usp[31:0];
#endif
isa_state flag_X[0:0];
isa_state flag_N[0:0];
isa_state flag_Z[0:0];
isa_state flag_V[0:0];
isa_state flag_C[0:0];

var src_reg[2:0];
var dst_reg[2:0];
var src_disp[15:0];
var dst_disp[15:0];
var src_disp_ext[31:0];
var dst_disp_ext[31:0];
var src_addr[31:0];
var dst_addr[31:0];
var data[15:0];

// Include interrupt and exception handling aspects
aspect m68k_exception.isa gates pc:2, sr:2, ssp:2, aregs:2, dmem:2, flag_C:2, flag_N:2, flag_Z:2, flag_V:2, flag_X:2, usp:2;
aspect m68k_interrupt.isa gates sr;
#ifdef MMU
aspect mmu/atc_translate_instr.isa gates pc, dmem;
#else
var pc_pa[31:0];
pc_pa = pc;
var pc_pa_delta[31:0];
pc_pa_delta = 32'd0;
#endif

// Fetch instruction
instr = dmem[pc_pa];
assume instr[15:12] == 0b0011;  // MOVE.W
assume instr[8:6] == 0b101;     // Dest mode: d(An)
assume instr[5:3] == 0b101;     // Source mode: d(An)
pc when (~m68k_exc_taken) = pc + 2;

dst_reg = instr[11:9];
src_reg = instr[2:0];

// Fetch source displacement
src_disp = dmem[pc + pc_pa_delta];
pc when (~m68k_exc_taken) = pc + 2;

// Fetch destination displacement
dst_disp = dmem[pc + pc_pa_delta];
pc when (~m68k_exc_taken) = pc + 2;

// Sign-extend displacements
src_disp_ext = {{16{src_disp[15]}}, src_disp};
dst_disp_ext = {{16{dst_disp[15]}}, dst_disp};

// Calculate addresses
src_addr = aregs[src_reg] + src_disp_ext;
dst_addr = aregs[dst_reg] + dst_disp_ext;

// Read word from source
#ifdef MMU
var mmu_va[31:0];
mmu_va = src_addr;
var is_write[0:0];
is_write = 1'b1;
aspect mmu/atc_translate_data.isa gates pc:1, sr:1, ssp:1, aregs:1, dmem:1, flag_C:1, flag_N:1, flag_Z:1, flag_V:1, flag_X:1, usp:1;
#endif

#ifdef MMU
data = dmem[ea_pa];
#else
data = dmem[src_addr];
#endif

// Write word to destination
dmem[dst_addr] when (~m68k_exc_taken & ~data_exc_taken) = data;

// Update CCR
flag_N when (~m68k_exc_taken & ~data_exc_taken) = data[15];
flag_Z when (~m68k_exc_taken & ~data_exc_taken) = data == 0;
flag_V when (~m68k_exc_taken & ~data_exc_taken) = 1'b0;
flag_C when (~m68k_exc_taken & ~data_exc_taken) = 1'b0;
