// SPDX-License-Identifier: BSD-3-Clause
// M68000 BVC.W label - Branch if overflow clear (V=0) (16-bit displacement)
// Opcode: 0110 1000 0000 0000 followed by 16-bit signed displacement

isa_state pc[31:0];
var instr[15:0];
isa_state dregs[31:0][2:0];
isa_state aregs[31:0][2:0];
mem dmem[25:0];
isa_state flag_X[0:0];
isa_state flag_N[0:0];
isa_state flag_Z[0:0];
isa_state flag_V[0:0];
isa_state flag_C[0:0];

var bvc_w_disp16[15:0];
var bvc_w_sign_ext_disp[31:0];
var bvc_w_branch_pc[31:0];
var bvc_w_branch_dest[31:0];
var bvc_w_take_branch[0:0];

// Include interrupt and exception handling aspects
aspect m68k_exception.isa gates pc:2, sr:2, ssp:2, aregs:2, dmem:2, flag_C:2, flag_N:2, flag_Z:2, flag_V:2, flag_X:2, usp:2;
aspect m68k_interrupt.isa gates sr;
#ifdef MMU
aspect mmu/atc_translate_instr.isa gates pc, dmem;
#else
var pc_pa[31:0];
pc_pa = pc;
var pc_pa_delta[31:0];
pc_pa_delta = 32'd0;
#endif

// Fetch instruction
instr = dmem[pc_pa];
assume instr == 16'h6800;  // BVC.W opcode (displacement = 0 means word follows)
bvc_w_branch_pc = pc + 2;  // PC value after instruction fetch
pc when (~m68k_exc_taken) = pc + 2;

// Fetch 16-bit displacement
bvc_w_disp16 = dmem[pc + pc_pa_delta];
pc when (~m68k_exc_taken) = pc + 2;
bvc_w_sign_ext_disp = {{16{bvc_w_disp16[15]}}, bvc_w_disp16};

// Calculate branch destination
bvc_w_branch_dest = bvc_w_branch_pc + bvc_w_sign_ext_disp;

// Condition: V=0
bvc_w_take_branch = ~flag_V;

// Execute
pc when (~m68k_exc_taken) = bvc_w_take_branch ? bvc_w_branch_dest : pc;

// Branch does not affect flags
