// SPDX-License-Identifier: BSD-3-Clause
// MC68020 MULS.L d(An),Dl - Signed Multiply Long from d(An) (32x32->32)
// Opcode: 0100 1100 00 101 AAA followed by extension word, then 16-bit displacement
// Extension: 0 DDD x 0 0000000 000 where DDD=Dl register, bit11=1 (signed), bit10=0 (32-bit result)

isa_state pc[31:0];
var instr[15:0];
isa_state dregs[31:0][2:0];
isa_state aregs[31:0][2:0];
mem dmem[25:0];
#ifdef MMU
// MMU state (added by MMU preprocessor)
isa_state tc[31:0];
isa_state tt0[31:0];
isa_state tt1[31:0];
isa_state crp[63:0];
isa_state srp[63:0];
isa_state vbr[31:0];
isa_state ssp[31:0];
isa_state usp[31:0];
#endif
isa_state flag_X[0:0];
isa_state flag_N[0:0];
isa_state flag_Z[0:0];
isa_state flag_V[0:0];
isa_state flag_C[0:0];

var base_reg[2:0];
var msld_ext[15:0];
var dst_reg[2:0];
var disp[15:0];
var disp_ext[31:0];
var eff_addr[31:0];
var src_hi[15:0];
var src_lo[15:0];
var src[31:0];
var dst[31:0];
var result[31:0];

// Include interrupt and exception handling aspects
aspect m68k_exception.isa gates pc:2, sr:2, ssp:2, aregs:2, dmem:2, flag_C:2, flag_N:2, flag_Z:2, flag_V:2, flag_X:2, usp:2;
aspect m68k_interrupt.isa gates sr;
#ifdef MMU
aspect mmu/atc_translate_instr.isa gates pc, dmem;
#else
var pc_pa[31:0];
pc_pa = pc;
var pc_pa_delta[31:0];
pc_pa_delta = 32'd0;
#endif

// Fetch instruction
instr = dmem[pc_pa];
assume instr[15:6] == 0b0100110000;  // MULU.L/MULS.L
assume instr[5:3] == 0b101;          // EA mode: d(An)
pc when (~m68k_exc_taken) = pc + 2;

base_reg = instr[2:0];

// Fetch extension word
msld_ext = dmem[pc + pc_pa_delta];
assume msld_ext[11] == 0b1;    // Signed (MULS) - bit 11 distinguishes signed/unsigned
assume msld_ext[10] == 0b0;    // 32-bit result (prevents OR-mux collision with 64-bit _dh_dl variant)
pc when (~m68k_exc_taken) = pc + 2;

dst_reg = msld_ext[14:12];

// Fetch 16-bit displacement
disp = dmem[pc + pc_pa_delta];
pc when (~m68k_exc_taken) = pc + 2;
disp_ext = {{16{disp[15]}}, disp};

// Calculate effective address
eff_addr = aregs[base_reg] + disp_ext;

// Read 32-bit source from memory
#ifdef MMU
var mmu_va[31:0];
mmu_va = eff_addr;
var is_write[0:0];
is_write = 1'b0;
aspect mmu/atc_translate_data.isa gates pc:1, sr:1, ssp:1, aregs:1, dmem:1, flag_C:1, flag_N:1, flag_Z:1, flag_V:1, flag_X:1, usp:1;
#endif

#ifdef MMU
src_hi = dmem[ea_pa];
#else
src_hi = dmem[eff_addr];
#endif
#ifdef MMU
src_lo = dmem[ea_pa + 2];
#else
src_lo = dmem[eff_addr + 2];
#endif
src = {src_hi, src_lo};

// Execute multiply (32x32->32, lower 32 bits only)
// For signed multiplication, the lower 32 bits are the same as unsigned
dst = dregs[dst_reg];
result = src * dst;
dregs[dst_reg] when (~m68k_exc_taken & ~data_exc_taken) = result;

// Update CCR
flag_N when (~m68k_exc_taken & ~data_exc_taken) = result[31];
flag_Z when (~m68k_exc_taken & ~data_exc_taken) = result == 0;
flag_V when (~m68k_exc_taken & ~data_exc_taken) = 1'b0;
flag_C when (~m68k_exc_taken & ~data_exc_taken) = 1'b0;
