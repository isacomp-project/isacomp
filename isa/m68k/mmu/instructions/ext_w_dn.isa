// SPDX-License-Identifier: BSD-3-Clause
// M68000 EXT.W Dn - Sign extend byte to word
// Opcode: 0100 1000 1000 0DDD where DDD=register

isa_state pc[31:0];
var instr[15:0];
isa_state dregs[31:0][2:0];
isa_state aregs[31:0][2:0];
mem dmem[25:0];
isa_state flag_X[0:0];
isa_state flag_N[0:0];
isa_state flag_Z[0:0];
isa_state flag_V[0:0];
isa_state flag_C[0:0];

var dst_reg[2:0];
var byte_val[7:0];
var word_val[15:0];
var result[31:0];

// Include interrupt and exception handling aspects
aspect m68k_exception.isa gates pc:2, sr:2, ssp:2, aregs:2, dmem:2, flag_C:2, flag_N:2, flag_Z:2, flag_V:2, flag_X:2, usp:2;
aspect m68k_interrupt.isa gates sr;
#ifdef MMU
aspect mmu/atc_translate_instr.isa gates pc, dmem;
#else
var pc_pa[31:0];
pc_pa = pc;
var pc_pa_delta[31:0];
pc_pa_delta = 32'd0;
#endif

// Fetch instruction
instr = dmem[pc_pa];
assume instr[15:3] == 0b0100100010000;  // EXT.W opcode
pc when (~m68k_exc_taken) = pc + 2;

// Decode
dst_reg = instr[2:0];

// Execute - sign extend low byte to low word
byte_val = dregs[dst_reg][7:0];
word_val = {{8{byte_val[7]}}, byte_val};

// Preserve high word
result = {dregs[dst_reg][31:16], word_val};
dregs[dst_reg] when (~m68k_exc_taken) = result;

// Update CCR (X not affected)
flag_N when (~m68k_exc_taken) = word_val[15];
flag_Z when (~m68k_exc_taken) = word_val == 0;
flag_V when (~m68k_exc_taken) = 1'b0;
flag_C when (~m68k_exc_taken) = 1'b0;
