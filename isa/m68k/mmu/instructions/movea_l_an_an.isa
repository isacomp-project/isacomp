// SPDX-License-Identifier: BSD-3-Clause
// M68000 MOVEA.L An,Am - Move address register to address register
// Opcode: 0010 MMM0 01 001 SSS
// MMM=destination reg, SSS=source reg
// MOVEA does NOT affect condition codes

isa_state pc[31:0];
var instr[15:0];
isa_state dregs[31:0][2:0];
isa_state aregs[31:0][2:0];
mem dmem[25:0];
isa_state flag_X[0:0];
isa_state flag_N[0:0];
isa_state flag_Z[0:0];
isa_state flag_V[0:0];
isa_state flag_C[0:0];

var src_reg[2:0];
var dst_reg[2:0];
var data[31:0];

// Include interrupt and exception handling aspects
aspect m68k_exception.isa gates pc:2, sr:2, ssp:2, aregs:2, dmem:2, flag_C:2, flag_N:2, flag_Z:2, flag_V:2, flag_X:2, usp:2;
aspect m68k_interrupt.isa gates sr;
#ifdef MMU
aspect mmu/atc_translate_instr.isa gates pc, dmem;
#else
var pc_pa[31:0];
pc_pa = pc;
var pc_pa_delta[31:0];
pc_pa_delta = 32'd0;
#endif

// Fetch instruction
instr = dmem[pc_pa];
assume instr[15:12] == 0b0010;  // MOVE.L opcode
assume instr[8:6] == 0b001;     // Destination mode: Address Register Direct (MOVEA)
assume instr[5:3] == 0b001;     // Source mode: Address Register Direct
pc when (~m68k_exc_taken) = pc + 2;

// Decode registers
dst_reg = instr[11:9];
src_reg = instr[2:0];

// Get value from source address register
data = aregs[src_reg];

// Write to destination address register
aregs[dst_reg] when (~m68k_exc_taken) = data;

// MOVEA does NOT affect CCR

