// SPDX-License-Identifier: BSD-3-Clause
// MC68020 MOVE.L (bd32,Xn),(d16,An) - Move long from full indexed (BS=1) to displacement
// Base register suppressed, index active, 32-bit base displacement
// Opcode: 0010 DDD 101 110 AAA + full ext word (bit8=1, BS=1, IS=0, BD=long) + bd32 + dst_disp16
// Source EA = sign_ext(bd32) + index_reg * scale
// Destination: d(An) displacement indirect

isa_state pc[31:0];
var instr[15:0];
isa_state dregs[31:0][2:0];
isa_state aregs[31:0][2:0];
mem dmem[25:0];
#ifdef MMU
// MMU state (added by MMU preprocessor)
isa_state tc[31:0];
isa_state tt0[31:0];
isa_state tt1[31:0];
isa_state crp[63:0];
isa_state srp[63:0];
isa_state vbr[31:0];
isa_state ssp[31:0];
isa_state usp[31:0];
#endif
isa_state flag_X[0:0];
isa_state flag_N[0:0];
isa_state flag_Z[0:0];
isa_state flag_V[0:0];
isa_state flag_C[0:0];

var dst_reg[2:0];
var mlfba_ext[15:0];
var mlfba_idx_is_addr[0:0];
var idx_reg[2:0];
var mlfba_idx_is_long[0:0];
var mlfba_scale[1:0];
var mlfba_bd_hi[15:0];
var mlfba_bd_lo[15:0];
var mlfba_bd[31:0];
var mlfba_idx_raw[31:0];
var mlfba_idx_val[31:0];
var mlfba_scaled_idx[31:0];
var mlfba_src_addr[31:0];
var mlfba_data_hi[15:0];
var mlfba_data_lo[15:0];
var mlfba_data[31:0];
var mlfba_dst_disp[15:0];
var mlfba_dst_disp_ext[31:0];
var mlfba_dst_addr[31:0];

// Include interrupt and exception handling aspects
aspect m68k_exception.isa gates pc:2, sr:2, ssp:2, aregs:2, dmem:2, flag_C:2, flag_N:2, flag_Z:2, flag_V:2, flag_X:2, usp:2;
aspect m68k_interrupt.isa gates sr;
#ifdef MMU
aspect mmu/atc_translate_instr.isa gates pc, dmem;
#else
var pc_pa[31:0];
pc_pa = pc;
var pc_pa_delta[31:0];
pc_pa_delta = 32'd0;
#endif

// Fetch instruction
instr = dmem[pc_pa];
assume instr[15:12] == 0b0010;  // MOVE.L
assume instr[8:6] == 0b101;     // Dest mode: d(An)
assume instr[5:3] == 0b110;     // Source mode: indexed (full format)
pc when (~m68k_exc_taken) = pc + 2;

dst_reg = instr[11:9];

// Fetch full extension word
mlfba_ext = dmem[pc + pc_pa_delta];
assume mlfba_ext[8] == 0b1;    // Full format
assume mlfba_ext[7] == 0b1;    // BS=1: base register suppressed
assume mlfba_ext[6] == 0b0;    // IS=0: index NOT suppressed
assume mlfba_ext[5:4] == 0b11; // BD size: long (32-bit)
assume mlfba_ext[3:0] == 0b0000; // No memory indirect
pc when (~m68k_exc_taken) = pc + 2;

mlfba_idx_is_addr = mlfba_ext[15];
idx_reg = mlfba_ext[14:12];
mlfba_idx_is_long = mlfba_ext[11];
mlfba_scale = mlfba_ext[10:9];

// Fetch 32-bit base displacement
mlfba_bd_hi = dmem[pc + pc_pa_delta];
pc when (~m68k_exc_taken) = pc + 2;
mlfba_bd_lo = dmem[pc + pc_pa_delta];
pc when (~m68k_exc_taken) = pc + 2;
mlfba_bd = {mlfba_bd_hi, mlfba_bd_lo};

// Get index register value
mlfba_idx_raw = mlfba_idx_is_addr ? aregs[idx_reg] : dregs[idx_reg];
mlfba_idx_val = mlfba_idx_is_long ? mlfba_idx_raw : (mlfba_idx_raw[15] ? {16'hFFFF, mlfba_idx_raw[15:0]} : {16'h0000, mlfba_idx_raw[15:0]});

// Apply scale factor
mlfba_scaled_idx = mlfba_scale == 0 ? mlfba_idx_val :
                   mlfba_scale == 1 ? (mlfba_idx_val << 1) :
                   mlfba_scale == 2 ? (mlfba_idx_val << 2) :
                                      (mlfba_idx_val << 3);

// Calculate source effective address: bd + scaled_index (no base register)
mlfba_src_addr = mlfba_bd + mlfba_scaled_idx;

// Read 32-bit source data
#ifdef MMU
var mmu_va[31:0];
mmu_va = mlfba_src_addr;
var is_write[0:0];
is_write = 1'b0;
aspect mmu/atc_translate_data.isa gates pc:1, sr:1, ssp:1, aregs:1, dmem:1, flag_C:1, flag_N:1, flag_Z:1, flag_V:1, flag_X:1, usp:1;
#endif

#ifdef MMU
mlfba_data_hi = dmem[ea_pa];
#else
mlfba_data_hi = dmem[mlfba_src_addr];
#endif
#ifdef MMU
mlfba_data_lo = dmem[ea_pa + 2];
#else
mlfba_data_lo = dmem[mlfba_src_addr + 2];
#endif
mlfba_data = {mlfba_data_hi, mlfba_data_lo};

// Fetch destination displacement
mlfba_dst_disp = dmem[pc + pc_pa_delta];
pc when (~m68k_exc_taken) = pc + 2;
mlfba_dst_disp_ext = {{16{mlfba_dst_disp[15]}}, mlfba_dst_disp};

// Destination effective address: An + sign_ext(dst_disp)
mlfba_dst_addr = aregs[dst_reg] + mlfba_dst_disp_ext;

// Write to destination
dmem[mlfba_dst_addr] when (~m68k_exc_taken & ~data_exc_taken) = mlfba_data[31:16];
dmem[mlfba_dst_addr + 2] when (~m68k_exc_taken & ~data_exc_taken) = mlfba_data[15:0];

// Update CCR
flag_N when (~m68k_exc_taken & ~data_exc_taken) = mlfba_data[31];
flag_Z when (~m68k_exc_taken & ~data_exc_taken) = mlfba_data == 0;
flag_V when (~m68k_exc_taken & ~data_exc_taken) = 1'b0;
flag_C when (~m68k_exc_taken & ~data_exc_taken) = 1'b0;
