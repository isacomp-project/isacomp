// SPDX-License-Identifier: BSD-3-Clause
// M68000 ADDX.W Dx,Dy - Add Extended Word (with X flag)
// Opcode: 1101 yyy 1 01 00 0 xxx where yyy=Dy (dest), xxx=Dx (src)
// Operation: Dx + Dy + X -> Dy (word only, preserves upper bits)
// Special: Z flag is only cleared if result is non-zero (not set if zero)

isa_state pc[31:0];
var instr[15:0];
isa_state dregs[31:0][2:0];
isa_state aregs[31:0][2:0];
mem dmem[25:0];
isa_state flag_X[0:0];
isa_state flag_N[0:0];
isa_state flag_Z[0:0];
isa_state flag_V[0:0];
isa_state flag_C[0:0];

// Word sub-registers using 'of' keyword
isa_state dregs_addxw[15:0][2:0] of dregs[0b***][15:0];

var addxw_src_reg[2:0];
var addxw_dst_reg[2:0];
var addxw_src_val[15:0];
var addxw_dst_val[15:0];
var addxw_x_val[0:0];
var addxw_result[16:0];

// Include interrupt and exception handling aspects
aspect m68k_exception.isa gates pc:2, sr:2, ssp:2, aregs:2, dmem:2, flag_C:2, flag_N:2, flag_Z:2, flag_V:2, flag_X:2, usp:2;
aspect m68k_interrupt.isa gates sr;
#ifdef MMU
aspect mmu/atc_translate_instr.isa gates pc, dmem;
#else
var pc_pa[31:0];
pc_pa = pc;
var pc_pa_delta[31:0];
pc_pa_delta = 32'd0;
#endif

// Fetch instruction
instr = dmem[pc_pa];
assume instr[15:12] == 0b1101;  // ADDX opcode
assume instr[8] == 0b1;          // Fixed bit
assume instr[7:6] == 0b01;       // Size: word
assume instr[5:4] == 0b00;       // Fixed bits
assume instr[3] == 0b0;          // Register to register mode
pc when (~m68k_exc_taken) = pc + 2;

// Decode
addxw_dst_reg = instr[11:9];
addxw_src_reg = instr[2:0];

// Execute: Dx + Dy + X (word)
addxw_src_val = dregs_addxw[addxw_src_reg];
addxw_dst_val = dregs_addxw[addxw_dst_reg];
addxw_x_val = flag_X;
addxw_result = addxw_dst_val + addxw_src_val + addxw_x_val;

// Write result (word only, upper bits preserved via 'of')
dregs_addxw[addxw_dst_reg] when (~m68k_exc_taken) = addxw_result[15:0];

// Update CCR
flag_X when (~m68k_exc_taken) = addxw_result[16];
flag_C when (~m68k_exc_taken) = addxw_result[16];
flag_V when (~m68k_exc_taken) = (~addxw_dst_val[15] & ~addxw_src_val[15] & addxw_result[15]) | (addxw_dst_val[15] & addxw_src_val[15] & ~addxw_result[15]);
flag_N when (~m68k_exc_taken) = addxw_result[15];
// Z flag special: only cleared if result is non-zero, unchanged otherwise
flag_Z when (~m68k_exc_taken) = flag_Z & (addxw_result[15:0] == 0);
