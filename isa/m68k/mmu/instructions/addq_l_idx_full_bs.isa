// SPDX-License-Identifier: BSD-3-Clause
// MC68020 ADDQ.L #data,(bd32,Xn) - Add quick to full indexed (base suppressed)
// Opcode: 0101 DDD0 10 110 AAA followed by full extension word + 32-bit BD
// Full ext word: BS=1 (base suppressed), IS=0 (index not suppressed), BD=long
// EA = bd32 + index_reg * scale

isa_state pc[31:0];
var instr[15:0];
isa_state dregs[31:0][2:0];
isa_state aregs[31:0][2:0];
mem dmem[25:0];
#ifdef MMU
// MMU state (added by MMU preprocessor)
isa_state tc[31:0];
isa_state tt0[31:0];
isa_state tt1[31:0];
isa_state crp[63:0];
isa_state srp[63:0];
isa_state vbr[31:0];
isa_state ssp[31:0];
isa_state usp[31:0];
#endif
isa_state flag_X[0:0];
isa_state flag_N[0:0];
isa_state flag_Z[0:0];
isa_state flag_V[0:0];
isa_state flag_C[0:0];

var aqfb_quick_data[2:0];
var aqfb_imm_val[31:0];
var aqfb_ext[15:0];
var idx_reg[2:0];
var aqfb_idx_is_addr[0:0];
var aqfb_idx_is_long[0:0];
var aqfb_scale[1:0];
var aqfb_raw_idx[31:0];
var aqfb_idx_val[31:0];
var aqfb_scaled_idx[31:0];
var aqfb_bd_hi[15:0];
var aqfb_bd_lo[15:0];
var aqfb_bd32[31:0];
var aqfb_eff_addr[31:0];
var aqfb_mem_hi[15:0];
var aqfb_mem_lo[15:0];
var aqfb_dst_val[31:0];
var aqfb_result[32:0];

// Include interrupt and exception handling aspects
aspect m68k_exception.isa gates pc:2, sr:2, ssp:2, aregs:2, dmem:2, flag_C:2, flag_N:2, flag_Z:2, flag_V:2, flag_X:2, usp:2;
aspect m68k_interrupt.isa gates sr;
#ifdef MMU
aspect mmu/atc_translate_instr.isa gates pc, dmem;
#else
var pc_pa[31:0];
pc_pa = pc;
var pc_pa_delta[31:0];
pc_pa_delta = 32'd0;
#endif

// Fetch instruction
instr = dmem[pc_pa];
assume instr[15:12] == 0b0101;  // ADDQ/SUBQ
assume instr[8] == 0;           // ADDQ (not SUBQ)
assume instr[7:6] == 0b10;      // Size: long
assume instr[5:3] == 0b110;     // EA mode: indexed
pc when (~m68k_exc_taken) = pc + 2;

aqfb_quick_data = instr[11:9];

// Fetch full extension word
aqfb_ext = dmem[pc + pc_pa_delta];
assume aqfb_ext[8] == 0b1;       // Full format
assume aqfb_ext[7] == 0b1;       // Base suppressed (BS=1)
assume aqfb_ext[6] == 0b0;       // Index NOT suppressed (IS=0)
assume aqfb_ext[5:4] == 0b11;    // BD size = long
assume aqfb_ext[3:0] == 0b0000;  // No memory indirect
pc when (~m68k_exc_taken) = pc + 2;

// Decode index
idx_reg = aqfb_ext[14:12];
aqfb_idx_is_addr = aqfb_ext[15];
aqfb_idx_is_long = aqfb_ext[11];
aqfb_scale = aqfb_ext[10:9];

aqfb_raw_idx = aqfb_idx_is_addr ? aregs[idx_reg] : dregs[idx_reg];
aqfb_idx_val = aqfb_idx_is_long ? aqfb_raw_idx : (aqfb_raw_idx[15] ? {16'hFFFF, aqfb_raw_idx[15:0]} : {16'h0000, aqfb_raw_idx[15:0]});

aqfb_scaled_idx = aqfb_scale == 2'b00 ? aqfb_idx_val :
             aqfb_scale == 2'b01 ? (aqfb_idx_val << 1) :
             aqfb_scale == 2'b10 ? (aqfb_idx_val << 2) :
                              (aqfb_idx_val << 3);

// Fetch 32-bit base displacement
aqfb_bd_hi = dmem[pc + pc_pa_delta];
pc when (~m68k_exc_taken) = pc + 2;
aqfb_bd_lo = dmem[pc + pc_pa_delta];
pc when (~m68k_exc_taken) = pc + 2;
aqfb_bd32 = {aqfb_bd_hi, aqfb_bd_lo};

// Convert quick data (0 means 8, 1-7 means 1-7)
aqfb_imm_val = aqfb_quick_data == 0 ? 32'h00000008 : {{29{1'b0}}, aqfb_quick_data};

// Calculate effective address
aqfb_eff_addr = aqfb_bd32 + aqfb_scaled_idx;

// Read destination from memory
#ifdef MMU
var mmu_va[31:0];
mmu_va = aqfb_eff_addr;
var is_write[0:0];
is_write = 1'b1;
aspect mmu/atc_translate_data.isa gates pc:1, sr:1, ssp:1, aregs:1, dmem:1, flag_C:1, flag_N:1, flag_Z:1, flag_V:1, flag_X:1, usp:1;
aqfb_mem_hi = dmem[ea_pa];
aqfb_mem_lo = dmem[ea_pa + 2];
#else
aqfb_mem_hi = dmem[aqfb_eff_addr];
aqfb_mem_lo = dmem[aqfb_eff_addr + 2];
#endif
aqfb_dst_val = {aqfb_mem_hi, aqfb_mem_lo};

// Execute ADDQ
aqfb_result = aqfb_dst_val + aqfb_imm_val;

// Write result back to memory
#ifdef MMU
dmem[ea_pa] when (~m68k_exc_taken & ~data_exc_taken) = aqfb_result[31:16];
dmem[ea_pa + 2] when (~m68k_exc_taken & ~data_exc_taken) = aqfb_result[15:0];
#else
dmem[aqfb_eff_addr] when (~m68k_exc_taken & ~data_exc_taken) = aqfb_result[31:16];
dmem[aqfb_eff_addr + 2] when (~m68k_exc_taken & ~data_exc_taken) = aqfb_result[15:0];
#endif

// Update CCR
flag_X when (~m68k_exc_taken & ~data_exc_taken) = aqfb_result[32];
flag_C when (~m68k_exc_taken & ~data_exc_taken) = aqfb_result[32];
flag_V when (~m68k_exc_taken & ~data_exc_taken) = (~aqfb_dst_val[31] & ~aqfb_imm_val[31] & aqfb_result[31]) | (aqfb_dst_val[31] & aqfb_imm_val[31] & ~aqfb_result[31]);
flag_Z when (~m68k_exc_taken & ~data_exc_taken) = aqfb_result[31:0] == 0;
flag_N when (~m68k_exc_taken & ~data_exc_taken) = aqfb_result[31];
