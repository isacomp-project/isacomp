// SPDX-License-Identifier: BSD-3-Clause
// MC68020 CMPI.B #imm,(bd16,An,Xn) - Compare immediate byte with full indexed word displacement
// Full ext: BS=0 (base used), IS=0 (index used), BD=word (16-bit), I/IS=0000
// EA = An + sign_extend(bd16) + Xn * scale
// Opcode: 0000 1100 00 110 AAA + imm word + full ext + bd16

isa_state pc[31:0];
var instr[15:0];
isa_state dregs[31:0][2:0];
isa_state aregs[31:0][2:0];
mem dmem[25:0];
#ifdef MMU
// MMU state (added by MMU preprocessor)
isa_state tc[31:0];
isa_state tt0[31:0];
isa_state tt1[31:0];
isa_state crp[63:0];
isa_state srp[63:0];
isa_state vbr[31:0];
isa_state ssp[31:0];
isa_state usp[31:0];
#endif
isa_state flag_X[0:0];
isa_state flag_N[0:0];
isa_state flag_Z[0:0];
isa_state flag_V[0:0];
isa_state flag_C[0:0];

var cbfw_addr_reg[2:0];
var cbfw_imm_word[15:0];
var cbfw_imm_val[7:0];
var cbfw_ext[15:0];
var cbfw_idx_is_areg[0:0];
var cbfw_idx_reg[2:0];
var cbfw_idx_is_long[0:0];
var cbfw_scale[1:0];
var cbfw_idx_raw[31:0];
var cbfw_idx_val[31:0];
var cbfw_scaled_idx[31:0];
var cbfw_bd16[15:0];
var cbfw_bd16_ext[31:0];
var cbfw_eff_addr[31:0];
var cbfw_mem_word[15:0];
var cbfw_dst_val[7:0];
var cbfw_result[8:0];

// Include interrupt and exception handling aspects
aspect m68k_exception.isa gates pc:2, sr:2, ssp:2, aregs:2, dmem:2, flag_C:2, flag_N:2, flag_Z:2, flag_V:2, flag_X:2, usp:2;
aspect m68k_interrupt.isa gates sr;
#ifdef MMU
aspect mmu/atc_translate_instr.isa gates pc, dmem;
#else
var pc_pa[31:0];
pc_pa = pc;
var pc_pa_delta[31:0];
pc_pa_delta = 32'd0;
#endif

// Fetch instruction
instr = dmem[pc_pa];
assume instr[15:8] == 0b00001100;  // CMPI opcode
assume instr[7:6] == 0b00;         // Size: byte
assume instr[5:3] == 0b110;        // EA mode: indexed
pc when (~m68k_exc_taken) = pc + 2;

cbfw_addr_reg = instr[2:0];

// Fetch immediate
cbfw_imm_word = dmem[pc + pc_pa_delta];
pc when (~m68k_exc_taken) = pc + 2;
cbfw_imm_val = cbfw_imm_word[7:0];

// Fetch full extension word
cbfw_ext = dmem[pc + pc_pa_delta];
assume cbfw_ext[8] == 0b1;       // Full format
assume cbfw_ext[7] == 0b0;       // BS=0: base register used
assume cbfw_ext[6] == 0b0;       // IS=0: index used
assume cbfw_ext[5:4] == 0b10;    // BD size = word (16-bit)
assume cbfw_ext[3:0] == 0b0000;  // No memory indirect
pc when (~m68k_exc_taken) = pc + 2;

// Decode full extension word
cbfw_idx_is_areg = cbfw_ext[15];
cbfw_idx_reg = cbfw_ext[14:12];
cbfw_idx_is_long = cbfw_ext[11];
cbfw_scale = cbfw_ext[10:9];

// Fetch 16-bit base displacement
cbfw_bd16 = dmem[pc + pc_pa_delta];
pc when (~m68k_exc_taken) = pc + 2;
cbfw_bd16_ext = {{16{cbfw_bd16[15]}}, cbfw_bd16};

// Index value
cbfw_idx_raw = cbfw_idx_is_areg ? aregs[cbfw_idx_reg] : dregs[cbfw_idx_reg];
cbfw_idx_val = cbfw_idx_is_long ? cbfw_idx_raw : (cbfw_idx_raw[15] ? {16'hFFFF, cbfw_idx_raw[15:0]} : {16'h0000, cbfw_idx_raw[15:0]});

// Scale
cbfw_scaled_idx = cbfw_scale == 0 ? cbfw_idx_val :
                  cbfw_scale == 1 ? (cbfw_idx_val << 1) :
                  cbfw_scale == 2 ? (cbfw_idx_val << 2) :
                                    (cbfw_idx_val << 3);

// Effective address = An + sign_extend(bd16) + Xn*scale
cbfw_eff_addr = aregs[cbfw_addr_reg] + cbfw_bd16_ext + cbfw_scaled_idx;

// Read byte from memory
#ifdef MMU
var mmu_va[31:0];
mmu_va = {cbfw_eff_addr[31:1], 1'b0};
var is_write[0:0];
is_write = 1'b0;
aspect mmu/atc_translate_data.isa gates pc:1, sr:1, ssp:1, aregs:1, dmem:1, flag_C:1, flag_N:1, flag_Z:1, flag_V:1, flag_X:1, usp:1;
#endif

#ifdef MMU
cbfw_mem_word = dmem[ea_pa];
#else
cbfw_mem_word = dmem[{cbfw_eff_addr[31:1], 1'b0}];
#endif
cbfw_dst_val = cbfw_eff_addr[0] ? cbfw_mem_word[7:0] : cbfw_mem_word[15:8];

// Compare
cbfw_result = cbfw_dst_val - cbfw_imm_val;

// Update CCR (X not affected by CMP)
flag_C when (~m68k_exc_taken & ~data_exc_taken) = cbfw_imm_val > cbfw_dst_val;
flag_V when (~m68k_exc_taken & ~data_exc_taken) = (~cbfw_dst_val[7] & cbfw_imm_val[7] & cbfw_result[7]) | (cbfw_dst_val[7] & ~cbfw_imm_val[7] & ~cbfw_result[7]);
flag_Z when (~m68k_exc_taken & ~data_exc_taken) = cbfw_result[7:0] == 0;
flag_N when (~m68k_exc_taken & ~data_exc_taken) = cbfw_result[7];
