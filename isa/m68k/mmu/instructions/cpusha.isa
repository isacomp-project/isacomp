// SPDX-License-Identifier: BSD-3-Clause
// MC68040 Cache Management Instructions (NOP in simulation, no real cache)
// Opcode: 1111 0100 cc ooo rrr
//   cc [7:6] = cache select: 01=DC, 10=IC, 11=BC
//   ooo [5:3] = operation: 001=CINVL, 010=CINVP, 011=CINVA, 101=CPUSHL, 110=CPUSHP, 111=CPUSHA
//   rrr [2:0] = address register (for line/page ops, 000 for all)
// All cache management instructions are NOP in our simulation.

isa_state pc[31:0];
var instr[15:0];
isa_state dregs[31:0][2:0];
isa_state aregs[31:0][2:0];
mem dmem[25:0];
isa_state flag_X[0:0];
isa_state flag_N[0:0];
isa_state flag_Z[0:0];
isa_state flag_V[0:0];
isa_state flag_C[0:0];

// Include interrupt and exception handling aspects
aspect m68k_exception.isa gates pc:2, sr:2, ssp:2, aregs:2, dmem:2, flag_C:2, flag_N:2, flag_Z:2, flag_V:2, flag_X:2, usp:2;
aspect m68k_interrupt.isa gates sr;
#ifdef MMU
aspect mmu/atc_translate_instr.isa gates pc, dmem;
#else
var pc_pa[31:0];
pc_pa = pc;
var pc_pa_delta[31:0];
pc_pa_delta = 32'd0;
#endif

// Fetch instruction
instr = dmem[pc_pa];
assume instr[15:8] == 0b11110100;  // 68040 cache management prefix
// Bits [7:6] = cache select (any nonzero is valid)
// Bits [5:3] = operation type (any valid combo)
// Bits [2:0] = register (for line/page) or 000 (for all)
// We accept all variants as NOP
pc when (~m68k_exc_taken) = pc + 2;

// NOP - no cache in simulation
