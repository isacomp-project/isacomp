// SPDX-License-Identifier: BSD-3-Clause
// MC68020 BFSET (An){Dn:width} - Set Bit Field in address register indirect
// Opcode: 1110 1110 11 010 AAA followed by extension word
// Handles register offset with immediate width (common kernel pattern)

isa_state pc[31:0];
var instr[15:0];
isa_state dregs[31:0][2:0];
isa_state aregs[31:0][2:0];
mem dmem[25:0];
#ifdef MMU
// MMU state (added by MMU preprocessor)
isa_state tc[31:0];
isa_state tt0[31:0];
isa_state tt1[31:0];
isa_state crp[63:0];
isa_state srp[63:0];
isa_state vbr[31:0];
isa_state ssp[31:0];
isa_state usp[31:0];
#endif
isa_state flag_X[0:0];
isa_state flag_N[0:0];
isa_state flag_Z[0:0];
isa_state flag_V[0:0];
isa_state flag_C[0:0];

var base_reg[2:0];
var ext_word[15:0];
var offset_reg[2:0];
var width_field[4:0];
var width[5:0];
var bit_offset[31:0];
var byte_offset[31:0];
var eff_addr[31:0];
var word_addr[31:0];
var bit_in_word[3:0];
var mem_word[15:0];
var mask[15:0];
var result_word[15:0];

// Include interrupt and exception handling aspects
aspect m68k_exception.isa gates pc:2, sr:2, ssp:2, aregs:2, dmem:2, flag_C:2, flag_N:2, flag_Z:2, flag_V:2, flag_X:2, usp:2;
aspect m68k_interrupt.isa gates sr;
#ifdef MMU
aspect mmu/atc_translate_instr.isa gates pc, dmem;
#else
var pc_pa[31:0];
pc_pa = pc;
var pc_pa_delta[31:0];
pc_pa_delta = 32'd0;
#endif

// Fetch instruction
instr = dmem[pc_pa];
assume instr[15:6] == 0b1110111011;  // BFSET
assume instr[5:3] == 0b010;          // EA mode: (An)
pc when (~m68k_exc_taken) = pc + 2;

base_reg = instr[2:0];

// Fetch extension word
ext_word = dmem[pc + pc_pa_delta];
assume ext_word[11] == 0b1;   // Offset is register
assume ext_word[5] == 0b0;    // Width is immediate
pc when (~m68k_exc_taken) = pc + 2;

offset_reg = ext_word[8:6];
width_field = ext_word[4:0];
width = width_field == 0 ? 6'd32 : {{1{1'b0}}, width_field};

// Get bit offset from register
bit_offset = dregs[offset_reg];

// Calculate byte address: base + bit_offset/8 (arithmetic shift right by 3)
byte_offset = {bit_offset[31], bit_offset[31], bit_offset[31], bit_offset[31:3]};
eff_addr = aregs[base_reg] + byte_offset;

// Align to word boundary and find bit within word
word_addr = {eff_addr[31:1], 1'b0};
bit_in_word = {eff_addr[0], bit_offset[2:0]};

// Read the word
#ifdef MMU
var mmu_va[31:0];
mmu_va = word_addr;
var is_write[0:0];
is_write = 1'b1;
aspect mmu/atc_translate_data.isa gates pc:1, sr:1, ssp:1, aregs:1, dmem:1, flag_C:1, flag_N:1, flag_Z:1, flag_V:1, flag_X:1, usp:1;
#endif

#ifdef MMU
mem_word = dmem[ea_pa];
#else
mem_word = dmem[word_addr];
#endif

// For width=1 (most common case): set single bit
// bit_in_word counts from MSB (big-endian bit numbering)
mask = 16'h8000 >> bit_in_word;
result_word = mem_word | mask;

// Write back
#ifdef MMU
dmem[ea_pa] when (~m68k_exc_taken & ~data_exc_taken) = result_word;
#else
dmem[word_addr] when (~m68k_exc_taken & ~data_exc_taken) = result_word;
#endif

// Update CCR based on original bit value
flag_N when (~m68k_exc_taken & ~data_exc_taken) = 1'b0;
flag_Z when (~m68k_exc_taken & ~data_exc_taken) = ~((mem_word >> (4'hF - bit_in_word)) & 16'h0001);
flag_V when (~m68k_exc_taken & ~data_exc_taken) = 1'b0;
flag_C when (~m68k_exc_taken & ~data_exc_taken) = 1'b0;
