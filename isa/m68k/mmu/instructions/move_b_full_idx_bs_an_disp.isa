// SPDX-License-Identifier: BSD-3-Clause
// MC68020 MOVE.B (bd32,Xn),d(An) - Move byte from full indexed (BS) to displacement
// Source: full ext word with BS=1 IS=0 BD=long (EA = Xn * scale + bd32)
// Dest: d16(An)
// Opcode: 0001 DDD 101 110 SSS

isa_state pc[31:0];
var instr[15:0];
isa_state dregs[31:0][2:0];
isa_state aregs[31:0][2:0];
mem dmem[25:0];
#ifdef MMU
// MMU state (added by MMU preprocessor)
isa_state tc[31:0];
isa_state tt0[31:0];
isa_state tt1[31:0];
isa_state crp[63:0];
isa_state srp[63:0];
isa_state vbr[31:0];
isa_state ssp[31:0];
isa_state usp[31:0];
#endif
isa_state flag_X[0:0];
isa_state flag_N[0:0];
isa_state flag_Z[0:0];
isa_state flag_V[0:0];
isa_state flag_C[0:0];

var src_reg[2:0];
var dst_reg[2:0];
var mbfb_ext[15:0];
var idx_reg[2:0];
var idx_is_addr[0:0];
var idx_is_long[0:0];
var scale[1:0];
var raw_idx[31:0];
var idx_val[31:0];
var scaled_idx[31:0];
var bd_hi[15:0];
var bd_lo[15:0];
var bd32[31:0];
var src_addr[31:0];
var src_word[15:0];
var byte_val[7:0];
var dst_disp[15:0];
var dst_disp_ext[31:0];
var dst_addr[31:0];
var dst_word[15:0];
var new_word[15:0];

// Include interrupt and exception handling aspects
aspect m68k_exception.isa gates pc:2, sr:2, ssp:2, aregs:2, dmem:2, flag_C:2, flag_N:2, flag_Z:2, flag_V:2, flag_X:2, usp:2;
aspect m68k_interrupt.isa gates sr;
#ifdef MMU
aspect mmu/atc_translate_instr.isa gates pc, dmem;
#else
var pc_pa[31:0];
pc_pa = pc;
var pc_pa_delta[31:0];
pc_pa_delta = 32'd0;
#endif

// Fetch instruction
instr = dmem[pc_pa];
assume instr[15:12] == 0b0001;  // MOVE.B
assume instr[8:6] == 0b101;     // Dest mode: d(An)
assume instr[5:3] == 0b110;     // Source mode: indexed
pc when (~m68k_exc_taken) = pc + 2;

dst_reg = instr[11:9];
src_reg = instr[2:0];

// Fetch source full extension word
mbfb_ext = dmem[pc + pc_pa_delta];
assume mbfb_ext[8] == 0b1;       // Full format
assume mbfb_ext[7] == 0b1;       // Base suppressed (BS=1)
assume mbfb_ext[6] == 0b0;       // Index NOT suppressed (IS=0)
assume mbfb_ext[5:4] == 0b11;    // BD size = long
assume mbfb_ext[3:0] == 0b0000;  // No memory indirect
pc when (~m68k_exc_taken) = pc + 2;

// Decode index register and scale
idx_reg = mbfb_ext[14:12];
idx_is_addr = mbfb_ext[15];
idx_is_long = mbfb_ext[11];
scale = mbfb_ext[10:9];

// Get index value
raw_idx = idx_is_addr ? aregs[idx_reg] : dregs[idx_reg];
idx_val = idx_is_long ? raw_idx : {{16{raw_idx[15]}}, raw_idx[15:0]};

// Scale index
scaled_idx = scale == 2'b00 ? idx_val :
             scale == 2'b01 ? (idx_val << 1) :
             scale == 2'b10 ? (idx_val << 2) :
                              (idx_val << 3);

// Fetch 32-bit base displacement for source
bd_hi = dmem[pc + pc_pa_delta];
pc when (~m68k_exc_taken) = pc + 2;
bd_lo = dmem[pc + pc_pa_delta];
pc when (~m68k_exc_taken) = pc + 2;
bd32 = {bd_hi, bd_lo};

// Source address = Xn * scale + bd32 (base suppressed)
src_addr = scaled_idx + bd32;

// Read source byte
#ifdef MMU
var mmu_va[31:0];
mmu_va = {src_addr[31:1], 1'b0};
var is_write[0:0];
is_write = 1'b0;
aspect mmu/atc_translate_data.isa gates pc:1, sr:1, ssp:1, aregs:1, dmem:1, flag_C:1, flag_N:1, flag_Z:1, flag_V:1, flag_X:1, usp:1;
#endif

#ifdef MMU
src_word = dmem[ea_pa];
#else
src_word = dmem[{src_addr[31:1], 1'b0}];
#endif
byte_val = src_addr[0] ? src_word[7:0] : src_word[15:8];

// Fetch destination displacement
dst_disp = dmem[pc + pc_pa_delta];
pc when (~m68k_exc_taken) = pc + 2;
dst_disp_ext = {{16{dst_disp[15]}}, dst_disp};

// Calculate destination address
dst_addr = aregs[dst_reg] + dst_disp_ext;

// Write byte to memory (read-modify-write)
dst_word = dmem[{dst_addr[31:1], 1'b0}];
new_word = dst_addr[0] ? {dst_word[15:8], byte_val} : {byte_val, dst_word[7:0]};
dmem[{dst_addr[31:1], 1'b0}] when (~m68k_exc_taken & ~data_exc_taken) = new_word;

// Update CCR
flag_N when (~m68k_exc_taken & ~data_exc_taken) = byte_val[7];
flag_Z when (~m68k_exc_taken & ~data_exc_taken) = byte_val == 0;
flag_V when (~m68k_exc_taken & ~data_exc_taken) = 1'b0;
flag_C when (~m68k_exc_taken & ~data_exc_taken) = 1'b0;
