// SPDX-License-Identifier: BSD-3-Clause
// M68000 SUBA.L (An)+,Am - Subtract long from postincrement to address register
// Opcode: 1001 DDD 111 011 SSS
// SUBA does NOT affect condition codes

isa_state pc[31:0];
var instr[15:0];
isa_state dregs[31:0][2:0];
isa_state aregs[31:0][2:0];
mem dmem[25:0];
#ifdef MMU
// MMU state (added by MMU preprocessor)
isa_state tc[31:0];
isa_state tt0[31:0];
isa_state tt1[31:0];
isa_state crp[63:0];
isa_state srp[63:0];
isa_state vbr[31:0];
isa_state ssp[31:0];
isa_state usp[31:0];
#endif
isa_state flag_X[0:0];
isa_state flag_N[0:0];
isa_state flag_Z[0:0];
isa_state flag_V[0:0];
isa_state flag_C[0:0];

var dst_reg[2:0];
var src_reg[2:0];
var slpa_eff_addr[31:0];
var slpa_src_hi[15:0];
var slpa_src_lo[15:0];
var slpa_src[31:0];
var slpa_result[31:0];

// Include interrupt and exception handling aspects
aspect m68k_exception.isa gates pc:2, sr:2, ssp:2, aregs:2, dmem:2, flag_C:2, flag_N:2, flag_Z:2, flag_V:2, flag_X:2, usp:2;
aspect m68k_interrupt.isa gates sr;
#ifdef MMU
aspect mmu/atc_translate_instr.isa gates pc, dmem;
#else
var pc_pa[31:0];
pc_pa = pc;
var pc_pa_delta[31:0];
pc_pa_delta = 32'd0;
#endif

// Fetch instruction
instr = dmem[pc_pa];
assume instr[15:12] == 0b1001;  // SUBA opcode
assume instr[8:6] == 0b111;     // Opmode: SUBA.L
assume instr[5:3] == 0b011;     // EA mode: Address Register Indirect with Postincrement
pc when (~m68k_exc_taken) = pc + 2;

dst_reg = instr[11:9];
src_reg = instr[2:0];

// Read 32-bit from memory and postincrement
slpa_eff_addr = aregs[src_reg];

#ifdef MMU
var mmu_va[31:0];
mmu_va = slpa_eff_addr;
var is_write[0:0];
is_write = 1'b0;
aspect mmu/atc_translate_data.isa gates pc:1, sr:1, ssp:1, aregs:1, dmem:1, flag_C:1, flag_N:1, flag_Z:1, flag_V:1, flag_X:1, usp:1;
#endif

#ifdef MMU
slpa_src_hi = dmem[ea_pa];
#else
slpa_src_hi = dmem[slpa_eff_addr];
#endif
#ifdef MMU
slpa_src_lo = dmem[ea_pa + 2];
#else
slpa_src_lo = dmem[slpa_eff_addr + 2];
#endif
slpa_src = {slpa_src_hi, slpa_src_lo};
aregs[src_reg] when (~m68k_exc_taken & ~data_exc_taken) = slpa_eff_addr + 4;

// Execute
slpa_result = aregs[dst_reg] - slpa_src;
aregs[dst_reg] when (~m68k_exc_taken & ~data_exc_taken) = slpa_result;
