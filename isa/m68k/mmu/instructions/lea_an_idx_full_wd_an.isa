// SPDX-License-Identifier: BSD-3-Clause
// MC68020 LEA (bd16,An,Xn),Am - Load effective address with index (full format, word displacement)
// Opcode: 0100 AAA1 11 110 BBB followed by full extension word + 16-bit displacement
// Full extension word format (bit 8 = 1) with bd_size=10 (word)

isa_state pc[31:0];
var instr[15:0];
isa_state dregs[31:0][2:0];
isa_state aregs[31:0][2:0];
mem dmem[25:0];
isa_state flag_X[0:0];
isa_state flag_N[0:0];
isa_state flag_Z[0:0];
isa_state flag_V[0:0];
isa_state flag_C[0:0];

var dst_reg[2:0];
var base_reg[2:0];
var lea_fw_ext[15:0];
var idx_is_areg[0:0];
var idx_reg[2:0];
var idx_is_long[0:0];
var scale[1:0];
var base_suppress[0:0];
var idx_suppress[0:0];
var disp_word[15:0];
var disp32[31:0];
var base_val[31:0];
var idx_raw[31:0];
var idx_val[31:0];
var idx_scaled[31:0];
var idx_final[31:0];
var eff_addr[31:0];

// Include interrupt and exception handling aspects
aspect m68k_exception.isa gates pc:2, sr:2, ssp:2, aregs:2, dmem:2, flag_C:2, flag_N:2, flag_Z:2, flag_V:2, flag_X:2, usp:2;
aspect m68k_interrupt.isa gates sr;
#ifdef MMU
aspect mmu/atc_translate_instr.isa gates pc, dmem;
#else
var pc_pa[31:0];
pc_pa = pc;
var pc_pa_delta[31:0];
pc_pa_delta = 32'd0;
#endif

// Fetch instruction
instr = dmem[pc_pa];
assume instr[15:12] == 0b0100;  // LEA pattern
assume instr[8:6] == 0b111;     // LEA opcode
assume instr[5:3] == 0b110;     // EA mode: Address Register Indirect with Index
pc when (~m68k_exc_taken) = pc + 2;

// Decode registers
dst_reg = instr[11:9];
base_reg = instr[2:0];

// Fetch extension word (unique name to avoid collision)
lea_fw_ext = dmem[pc + pc_pa_delta];
assume lea_fw_ext[8] == 0b1;    // Full format indicator
assume lea_fw_ext[5:4] == 0b10; // BD size = word (16-bit displacement)
pc when (~m68k_exc_taken) = pc + 2;

// Decode extension word
idx_is_areg = lea_fw_ext[15];
idx_reg = lea_fw_ext[14:12];
idx_is_long = lea_fw_ext[11];
scale = lea_fw_ext[10:9];
base_suppress = lea_fw_ext[7];
idx_suppress = lea_fw_ext[6];

// Fetch 16-bit base displacement, sign-extend to 32 bits
disp_word = dmem[pc + pc_pa_delta];
pc when (~m68k_exc_taken) = pc + 2;
disp32 = {{16{disp_word[15]}}, disp_word};

// Get base address (0 if suppressed)
base_val = base_suppress ? 32'h00000000 : aregs[base_reg];

// Get index value (data or address register)
idx_raw = idx_is_areg ? aregs[idx_reg] : dregs[idx_reg];

// Sign-extend to 32 bits if word index
idx_val = idx_is_long ? idx_raw : (idx_raw[15] ? {16'hFFFF, idx_raw[15:0]} : {16'h0000, idx_raw[15:0]});

// Apply scale factor
idx_scaled = scale == 0 ? idx_val :
             scale == 1 ? (idx_val << 1) :
             scale == 2 ? (idx_val << 2) :
                          (idx_val << 3);

// Suppress index if requested
idx_final = idx_suppress ? 32'h00000000 : idx_scaled;

// Calculate effective address: base + index*scale + displacement
eff_addr = base_val + idx_final + disp32;

// Store result in destination address register
aregs[dst_reg] when (~m68k_exc_taken) = eff_addr;

// LEA does NOT affect CCR
