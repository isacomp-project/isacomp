// SPDX-License-Identifier: BSD-3-Clause
// M68000 MOVE #imm,CCR - Move immediate to Condition Code Register
// Opcode: 0100 0100 11 111 100 (44FC) followed by 16-bit immediate
// Not privileged - only affects CCR (low 5 bits of SR)

isa_state pc[31:0];
var instr[15:0];
isa_state dregs[31:0][2:0];
isa_state aregs[31:0][2:0];
mem dmem[25:0];
isa_state flag_X[0:0];
isa_state flag_N[0:0];
isa_state flag_Z[0:0];
isa_state flag_V[0:0];
isa_state flag_C[0:0];

var mtccr_imm_val[15:0];

// Include interrupt and exception handling aspects
aspect m68k_exception.isa gates pc:2, sr:2, ssp:2, aregs:2, dmem:2, flag_C:2, flag_N:2, flag_Z:2, flag_V:2, flag_X:2, usp:2;
aspect m68k_interrupt.isa gates sr;
#ifdef MMU
aspect mmu/atc_translate_instr.isa gates pc, dmem;
#else
var pc_pa[31:0];
pc_pa = pc;
var pc_pa_delta[31:0];
pc_pa_delta = 32'd0;
#endif

// Fetch instruction
instr = dmem[pc_pa];
assume instr[15:6] == 10'b0100010011;  // MOVE to CCR opcode
assume instr[5:3] == 3'b111;            // EA mode: Mode 7
assume instr[2:0] == 3'b100;            // EA reg: 4 (immediate)
pc when (~m68k_exc_taken) = pc + 2;

// Fetch immediate value (only low byte used per M68K spec)
mtccr_imm_val = dmem[pc + pc_pa_delta];
pc when (~m68k_exc_taken) = pc + 2;

// CCR bits: bit4=X, bit3=N, bit2=Z, bit1=V, bit0=C
flag_X when (~m68k_exc_taken) = mtccr_imm_val[4];
flag_N when (~m68k_exc_taken) = mtccr_imm_val[3];
flag_Z when (~m68k_exc_taken) = mtccr_imm_val[2];
flag_V when (~m68k_exc_taken) = mtccr_imm_val[1];
flag_C when (~m68k_exc_taken) = mtccr_imm_val[0];
