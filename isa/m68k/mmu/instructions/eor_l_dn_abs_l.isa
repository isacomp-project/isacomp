// SPDX-License-Identifier: BSD-3-Clause
// M68000 EOR.L Dn,(xxx).L - Exclusive OR long data register with memory (absolute long)
// Opcode: 1011 SSS1 10111 001 followed by 32-bit absolute address
// Operation: (xxx).L XOR Dn -> (xxx).L

isa_state pc[31:0];
var instr[15:0];
isa_state dregs[31:0][2:0];
isa_state aregs[31:0][2:0];
mem dmem[25:0];
#ifdef MMU
// MMU state (added by MMU preprocessor)
isa_state tc[31:0];
isa_state tt0[31:0];
isa_state tt1[31:0];
isa_state crp[63:0];
isa_state srp[63:0];
isa_state vbr[31:0];
isa_state ssp[31:0];
isa_state usp[31:0];
#endif
isa_state flag_X[0:0];
isa_state flag_N[0:0];
isa_state flag_Z[0:0];
isa_state flag_V[0:0];
isa_state flag_C[0:0];

var src_reg[2:0];
var melal_abs_hi[15:0];
var melal_abs_lo[15:0];
var melal_addr[31:0];
var melal_src_val[31:0];
var melal_dst_hi[15:0];
var melal_dst_lo[15:0];
var melal_dst_val[31:0];
var melal_result[31:0];

// Include interrupt and exception handling aspects
aspect m68k_exception.isa gates pc:2, sr:2, ssp:2, aregs:2, dmem:2, flag_C:2, flag_N:2, flag_Z:2, flag_V:2, flag_X:2, usp:2;
aspect m68k_interrupt.isa gates sr;
#ifdef MMU
aspect mmu/atc_translate_instr.isa gates pc, dmem;
#else
var pc_pa[31:0];
pc_pa = pc;
var pc_pa_delta[31:0];
pc_pa_delta = 32'd0;
#endif

// Fetch instruction
instr = dmem[pc_pa];
assume instr[15:12] == 0b1011;  // EOR opcode
assume instr[8:6] == 0b110;     // Opmode: long
assume instr[5:3] == 0b111;     // EA mode: absolute
assume instr[2:0] == 0b001;     // absolute long
pc when (~m68k_exc_taken) = pc + 2;

// Decode
src_reg = instr[11:9];

// Fetch 32-bit absolute address
melal_abs_hi = dmem[pc + pc_pa_delta];
pc when (~m68k_exc_taken) = pc + 2;
melal_abs_lo = dmem[pc + pc_pa_delta];
pc when (~m68k_exc_taken) = pc + 2;
melal_addr = {melal_abs_hi, melal_abs_lo};

// Read source from Dn
melal_src_val = dregs[src_reg];

// MMU translate
#ifdef MMU
var mmu_va[31:0];
mmu_va = melal_addr;
var is_write[0:0];
is_write = 1'b1;
aspect mmu/atc_translate_data.isa gates pc:1, sr:1, ssp:1, aregs:1, dmem:1, flag_C:1, flag_N:1, flag_Z:1, flag_V:1, flag_X:1, usp:1;
#endif

// Read destination from memory (two 16-bit reads, big-endian)
#ifdef MMU
melal_dst_hi = dmem[ea_pa];
#else
melal_dst_hi = dmem[melal_addr];
#endif
#ifdef MMU
melal_dst_lo = dmem[ea_pa + 2];
#else
melal_dst_lo = dmem[melal_addr + 2];
#endif
melal_dst_val = {melal_dst_hi, melal_dst_lo};

// Execute
melal_result = melal_dst_val ^ melal_src_val;

// Write result back to memory
#ifdef MMU
dmem[ea_pa] when (~m68k_exc_taken & ~data_exc_taken) = melal_result[31:16];
#else
dmem[melal_addr] when (~m68k_exc_taken & ~data_exc_taken) = melal_result[31:16];
#endif
#ifdef MMU
dmem[ea_pa + 2] when (~m68k_exc_taken & ~data_exc_taken) = melal_result[15:0];
#else
dmem[melal_addr + 2] when (~m68k_exc_taken & ~data_exc_taken) = melal_result[15:0];
#endif

// Update CCR (X not affected)
flag_N when (~m68k_exc_taken & ~data_exc_taken) = melal_result[31];
flag_Z when (~m68k_exc_taken & ~data_exc_taken) = melal_result == 0;
flag_V when (~m68k_exc_taken & ~data_exc_taken) = 1'b0;
flag_C when (~m68k_exc_taken & ~data_exc_taken) = 1'b0;
