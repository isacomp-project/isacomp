// SPDX-License-Identifier: BSD-3-Clause
// MC68020 MULS.L (xxx).L,Dl - Signed Multiply Long from absolute long address (32x32->32)
// Opcode: 0100 1100 00 111 001 followed by extension word, then 32-bit address
// Extension: 1 DDD x 0 0000000000 where DDD=Dl register, bit15=1 (signed), bit10=0 (32-bit)

isa_state pc[31:0];
var instr[15:0];
isa_state dregs[31:0][2:0];
isa_state aregs[31:0][2:0];
mem dmem[25:0];
#ifdef MMU
// MMU state (added by MMU preprocessor)
isa_state tc[31:0];
isa_state tt0[31:0];
isa_state tt1[31:0];
isa_state crp[63:0];
isa_state srp[63:0];
isa_state vbr[31:0];
isa_state ssp[31:0];
isa_state usp[31:0];
#endif
isa_state flag_X[0:0];
isa_state flag_N[0:0];
isa_state flag_Z[0:0];
isa_state flag_V[0:0];
isa_state flag_C[0:0];

var ext_word[15:0];
var dl_reg[2:0];
var addr_hi[15:0];
var addr_lo[15:0];
var abs_addr[31:0];
var data_hi[15:0];
var data_lo[15:0];
var src[31:0];
var dl_val[31:0];
var result[31:0];

// Include interrupt and exception handling aspects
aspect m68k_exception.isa gates pc:2, sr:2, ssp:2, aregs:2, dmem:2, flag_C:2, flag_N:2, flag_Z:2, flag_V:2, flag_X:2, usp:2;
aspect m68k_interrupt.isa gates sr;
#ifdef MMU
aspect mmu/atc_translate_instr.isa gates pc, dmem;
#else
var pc_pa[31:0];
pc_pa = pc;
var pc_pa_delta[31:0];
pc_pa_delta = 32'd0;
#endif

// Fetch instruction
instr = dmem[pc_pa];
assume instr[15:6] == 0b0100110000;  // MULU.L/MULS.L
assume instr[5:3] == 0b111;          // EA mode: Special
assume instr[2:0] == 0b001;          // Absolute long
pc when (~m68k_exc_taken) = pc + 2;

// Fetch extension word
ext_word = dmem[pc + pc_pa_delta];
assume ext_word[11] == 0b1;    // Signed (MULS.L) - bit 11 distinguishes signed/unsigned
assume ext_word[10] == 0b0;    // 32-bit result (prevents OR-mux collision with 64-bit _dh_dl variant)
pc when (~m68k_exc_taken) = pc + 2;

dl_reg = ext_word[14:12];

// Fetch 32-bit absolute address (big-endian)
addr_hi = dmem[pc + pc_pa_delta];
pc when (~m68k_exc_taken) = pc + 2;
addr_lo = dmem[pc + pc_pa_delta];
pc when (~m68k_exc_taken) = pc + 2;
abs_addr = {addr_hi, addr_lo};

// Read 32-bit source from memory (two 16-bit reads)
#ifdef MMU
var mmu_va[31:0];
mmu_va = abs_addr;
var is_write[0:0];
is_write = 1'b0;
aspect mmu/atc_translate_data.isa gates pc:1, sr:1, ssp:1, aregs:1, dmem:1, flag_C:1, flag_N:1, flag_Z:1, flag_V:1, flag_X:1, usp:1;
#endif

#ifdef MMU
data_hi = dmem[ea_pa];
#else
data_hi = dmem[abs_addr];
#endif
#ifdef MMU
data_lo = dmem[ea_pa + 2];
#else
data_lo = dmem[abs_addr + 2];
#endif
src = {data_hi, data_lo};

// Execute signed multiply (32x32->32, lower 32 bits only)
dl_val = dregs[dl_reg];
result = dl_val * src;
dregs[dl_reg] when (~m68k_exc_taken & ~data_exc_taken) = result;

// Update CCR
flag_N when (~m68k_exc_taken & ~data_exc_taken) = result[31];
flag_Z when (~m68k_exc_taken & ~data_exc_taken) = result == 0;
flag_V when (~m68k_exc_taken & ~data_exc_taken) = 1'b0;
flag_C when (~m68k_exc_taken & ~data_exc_taken) = 1'b0;
