// SPDX-License-Identifier: BSD-3-Clause
// M68000 LSL.W Dn,Dm - Logical shift left word by register count
// Opcode: 1110 CCC1 01101 DDD where CCC=count reg, DDD=data reg
// Shift count is modulo 64 from Dn

isa_state pc[31:0];
var instr[15:0];
isa_state dregs[31:0][2:0];
isa_state aregs[31:0][2:0];
mem dmem[25:0];
isa_state flag_X[0:0];
isa_state flag_N[0:0];
isa_state flag_Z[0:0];
isa_state flag_V[0:0];
isa_state flag_C[0:0];

var dst_reg[2:0];
var count_reg[2:0];
var count[5:0];
var src_val[15:0];
var result[15:0];
var shifted[31:0];
var last_bit_out[0:0];
var count_eq_0[0:0];

// Include interrupt and exception handling aspects
aspect m68k_exception.isa gates pc:2, sr:2, ssp:2, aregs:2, dmem:2, flag_C:2, flag_N:2, flag_Z:2, flag_V:2, flag_X:2, usp:2;
aspect m68k_interrupt.isa gates sr;
#ifdef MMU
aspect mmu/atc_translate_instr.isa gates pc, dmem;
#else
var pc_pa[31:0];
pc_pa = pc;
var pc_pa_delta[31:0];
pc_pa_delta = 32'd0;
#endif

// Fetch instruction
instr = dmem[pc_pa];
assume instr[15:12] == 0b1110;  // Shift/rotate opcode
assume instr[8] == 1;           // Direction: left
assume instr[7:6] == 0b01;     // Size: word
assume instr[5] == 1;           // i/r: register count
assume instr[4:3] == 0b01;     // LSL type
pc when (~m68k_exc_taken) = pc + 2;

// Decode
count_reg = instr[11:9];
dst_reg = instr[2:0];

// Get shift count (modulo 64)
count = dregs[count_reg][5:0];
count_eq_0 = count == 0;

// Execute - word operation
src_val = dregs[dst_reg][15:0];
shifted = {{16{1'b0}}, src_val} << count;
result = shifted[15:0];

// Last bit shifted out (for carry)
last_bit_out = count_eq_0 ? 1'b0 : ({{16{1'b0}}, src_val} >> (16 - count)) & 1;

// Write result (word operation: preserve upper 16 bits)
dregs[dst_reg] when (~m68k_exc_taken) = {dregs[dst_reg][31:16], result};

// Update CCR
flag_X when (~m68k_exc_taken) = count_eq_0 ? flag_X : last_bit_out;
flag_C when (~m68k_exc_taken) = count_eq_0 ? 1'b0 : last_bit_out;
flag_N when (~m68k_exc_taken) = result[15];
flag_Z when (~m68k_exc_taken) = result == 0;
flag_V when (~m68k_exc_taken) = 1'b0;  // LSL always clears overflow
