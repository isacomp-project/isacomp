// SPDX-License-Identifier: BSD-3-Clause
// M68000 LEA abs.L,An - Load effective address from absolute long address
// Opcode: 0100 AAA1 11111 001 followed by 32-bit absolute address
// EA mode 7, register 1 (absolute long)

isa_state pc[31:0];
var instr[15:0];
isa_state dregs[31:0][2:0];
isa_state aregs[31:0][2:0];
mem dmem[25:0];
isa_state flag_X[0:0];
isa_state flag_N[0:0];
isa_state flag_Z[0:0];
isa_state flag_V[0:0];
isa_state flag_C[0:0];

var dst_reg[2:0];
var addr_hi[15:0];
var addr_lo[15:0];
var abs_addr[31:0];

// Include interrupt and exception handling aspects
aspect m68k_exception.isa gates pc:2, sr:2, ssp:2, aregs:2, dmem:2, flag_C:2, flag_N:2, flag_Z:2, flag_V:2, flag_X:2, usp:2;
aspect m68k_interrupt.isa gates sr;
#ifdef MMU
aspect mmu/atc_translate_instr.isa gates pc, dmem;
#else
var pc_pa[31:0];
pc_pa = pc;
var pc_pa_delta[31:0];
pc_pa_delta = 32'd0;
#endif

// Fetch instruction
instr = dmem[pc_pa];
assume instr[15:12] == 0b0100;  // LEA pattern
assume instr[8:6] == 0b111;     // LEA opcode
assume instr[5:3] == 0b111;     // EA mode: Mode 7 (special)
assume instr[2:0] == 0b001;     // EA reg: 1 (absolute long)
pc when (~m68k_exc_taken) = pc + 2;

// Decode destination register
dst_reg = instr[11:9];

// Fetch 32-bit absolute address (big-endian: high word first)
addr_hi = dmem[pc + pc_pa_delta];
pc when (~m68k_exc_taken) = pc + 2;
addr_lo = dmem[pc + pc_pa_delta];
pc when (~m68k_exc_taken) = pc + 2;

abs_addr = {addr_hi, addr_lo};

// Store effective address (the absolute address itself) in destination register
aregs[dst_reg] when (~m68k_exc_taken) = abs_addr;

// LEA does NOT affect CCR

