// SPDX-License-Identifier: BSD-3-Clause
// M68000 SUBQ.W #data,(An) - Subtract quick word from memory indirect
// Opcode: 0101 DDD1 01 010 AAA

isa_state pc[31:0];
var instr[15:0];
isa_state dregs[31:0][2:0];
isa_state aregs[31:0][2:0];
mem dmem[25:0];
#ifdef MMU
// MMU state (added by MMU preprocessor)
isa_state tc[31:0];
isa_state tt0[31:0];
isa_state tt1[31:0];
isa_state crp[63:0];
isa_state srp[63:0];
isa_state vbr[31:0];
isa_state ssp[31:0];
isa_state usp[31:0];
#endif
isa_state flag_X[0:0];
isa_state flag_N[0:0];
isa_state flag_Z[0:0];
isa_state flag_V[0:0];
isa_state flag_C[0:0];

var sqwi_qdata[2:0];
var sqwi_imm[15:0];
var sqwi_reg[2:0];
var sqwi_addr[31:0];
var sqwi_dst[15:0];
var sqwi_result[16:0];

aspect m68k_exception.isa gates pc:2, sr:2, ssp:2, aregs:2, dmem:2, flag_C:2, flag_N:2, flag_Z:2, flag_V:2, flag_X:2, usp:2;
aspect m68k_interrupt.isa gates sr;
#ifdef MMU
aspect mmu/atc_translate_instr.isa gates pc, dmem;
#else
var pc_pa[31:0];
pc_pa = pc;
var pc_pa_delta[31:0];
pc_pa_delta = 32'd0;
#endif

instr = dmem[pc_pa];
assume instr[15:12] == 0b0101;
assume instr[8] == 0b1;         // SUBQ
assume instr[7:6] == 0b01;      // Word size
assume instr[5:3] == 0b010;     // EA: (An)
pc when (~m68k_exc_taken) = pc + 2;

sqwi_qdata = instr[11:9];
sqwi_reg = instr[2:0];
sqwi_imm = sqwi_qdata == 0 ? 16'h0008 : {13'b0, sqwi_qdata};

sqwi_addr = aregs[sqwi_reg];
#ifdef MMU
var mmu_va[31:0];
mmu_va = sqwi_addr;
var is_write[0:0];
is_write = 1'b1;
aspect mmu/atc_translate_data.isa gates pc:1, sr:1, ssp:1, aregs:1, dmem:1, flag_C:1, flag_N:1, flag_Z:1, flag_V:1, flag_X:1, usp:1;
#endif

#ifdef MMU
sqwi_dst = dmem[ea_pa];
#else
sqwi_dst = dmem[sqwi_addr];
#endif
sqwi_result = sqwi_dst - sqwi_imm;
#ifdef MMU
dmem[ea_pa] when (~m68k_exc_taken & ~data_exc_taken) = sqwi_result[15:0];
#else
dmem[sqwi_addr] when (~m68k_exc_taken & ~data_exc_taken) = sqwi_result[15:0];
#endif

flag_X when (~m68k_exc_taken & ~data_exc_taken) = sqwi_imm > sqwi_dst;
flag_C when (~m68k_exc_taken & ~data_exc_taken) = sqwi_imm > sqwi_dst;
flag_V when (~m68k_exc_taken & ~data_exc_taken) = (sqwi_dst[15] & ~sqwi_imm[15] & ~sqwi_result[15]) | (~sqwi_dst[15] & sqwi_imm[15] & sqwi_result[15]);
flag_Z when (~m68k_exc_taken & ~data_exc_taken) = sqwi_result[15:0] == 0;
flag_N when (~m68k_exc_taken & ~data_exc_taken) = sqwi_result[15];
