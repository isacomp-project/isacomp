// SPDX-License-Identifier: BSD-3-Clause
// M68000 ADDX.L Dx,Dy - Add Extended Long (with X flag)
// Opcode: 1101 yyy 1 10 00 0 xxx where yyy=Dy (dest), xxx=Dx (src)
// Operation: Dx + Dy + X -> Dy
// Special: Z flag is only cleared if result is non-zero (not set if zero)

isa_state pc[31:0];
var instr[15:0];
isa_state dregs[31:0][2:0];
isa_state aregs[31:0][2:0];
mem dmem[25:0];
isa_state flag_X[0:0];
isa_state flag_N[0:0];
isa_state flag_Z[0:0];
isa_state flag_V[0:0];
isa_state flag_C[0:0];

var src_reg[2:0];
var dst_reg[2:0];
var src_val[31:0];
var dst_val[31:0];
var x_val[0:0];
var result[32:0];

// Include interrupt and exception handling aspects
aspect m68k_exception.isa gates pc:2, sr:2, ssp:2, aregs:2, dmem:2, flag_C:2, flag_N:2, flag_Z:2, flag_V:2, flag_X:2, usp:2;
aspect m68k_interrupt.isa gates sr;
#ifdef MMU
aspect mmu/atc_translate_instr.isa gates pc, dmem;
#else
var pc_pa[31:0];
pc_pa = pc;
var pc_pa_delta[31:0];
pc_pa_delta = 32'd0;
#endif

// Fetch instruction
instr = dmem[pc_pa];
assume instr[15:12] == 0b1101;  // ADDX opcode
assume instr[8] == 0b1;          // Fixed bit
assume instr[7:6] == 0b10;       // Size: long
assume instr[5:4] == 0b00;       // Fixed bits
assume instr[3] == 0b0;          // Register to register mode
pc when (~m68k_exc_taken) = pc + 2;

// Decode
dst_reg = instr[11:9];
src_reg = instr[2:0];

// Execute: Dx + Dy + X
src_val = dregs[src_reg];
dst_val = dregs[dst_reg];
x_val = flag_X;
result = dst_val + src_val + x_val;

// Write result
dregs[dst_reg] when (~m68k_exc_taken) = result[31:0];

// Update CCR
flag_X when (~m68k_exc_taken) = result[32];
flag_C when (~m68k_exc_taken) = result[32];
flag_V when (~m68k_exc_taken) = (~dst_val[31] & ~src_val[31] & result[31]) | (dst_val[31] & src_val[31] & ~result[31]);
flag_N when (~m68k_exc_taken) = result[31];
// Z flag special: only cleared if result is non-zero, unchanged otherwise
flag_Z when (~m68k_exc_taken) = flag_Z & (result[31:0] == 0);
