// SPDX-License-Identifier: BSD-3-Clause
// M68000 MOVE.B (An),(An)+ - Move byte from (An) to (An) with post-increment
// Opcode: 0001 DDD 011 010 SSS

isa_state pc[31:0];
var instr[15:0];
isa_state dregs[31:0][2:0];
isa_state aregs[31:0][2:0];
mem dmem[25:0];
#ifdef MMU
// MMU state (added by MMU preprocessor)
isa_state tc[31:0];
isa_state tt0[31:0];
isa_state tt1[31:0];
isa_state crp[63:0];
isa_state srp[63:0];
isa_state vbr[31:0];
isa_state ssp[31:0];
isa_state usp[31:0];
#endif
isa_state flag_X[0:0];
isa_state flag_N[0:0];
isa_state flag_Z[0:0];
isa_state flag_V[0:0];
isa_state flag_C[0:0];

var src_reg[2:0];
var dst_reg[2:0];
var mmbip_src_addr[31:0];
var mmbip_dst_addr[31:0];
var mmbip_data_val[7:0];
var mmbip_src_word[15:0];
var mmbip_dst_word[15:0];
var mmbip_new[15:0];

// Include interrupt and exception handling aspects
aspect m68k_exception.isa gates pc:2, sr:2, ssp:2, aregs:2, dmem:2, flag_C:2, flag_N:2, flag_Z:2, flag_V:2, flag_X:2, usp:2;
aspect m68k_interrupt.isa gates sr;
#ifdef MMU
aspect mmu/atc_translate_instr.isa gates pc, dmem;
#else
var pc_pa[31:0];
pc_pa = pc;
var pc_pa_delta[31:0];
pc_pa_delta = 32'd0;
#endif

// Fetch instruction
instr = dmem[pc_pa];
assume instr[15:12] == 0b0001;  // MOVE.B opcode
assume instr[8:6] == 0b011;     // Destination mode: (An)+
assume instr[5:3] == 0b010;     // Source mode: (An)
pc when (~m68k_exc_taken) = pc + 2;

// Decode
dst_reg = instr[11:9];
src_reg = instr[2:0];

// Execute
mmbip_src_addr = aregs[src_reg];
mmbip_dst_addr = aregs[dst_reg];

// Read source byte
#ifdef MMU
var mmu_va[31:0];
mmu_va = mmbip_src_addr;
var is_write[0:0];
is_write = 1'b0;
aspect mmu/atc_translate_data.isa gates pc:1, sr:1, ssp:1, aregs:1, dmem:1, flag_C:1, flag_N:1, flag_Z:1, flag_V:1, flag_X:1, usp:1;
#endif

#ifdef MMU
mmbip_src_word = dmem[{ea_pa[31:1], 1'b0}];
mmbip_data_val = mmbip_src_addr[0] ? mmbip_src_word[7:0] : mmbip_src_word[15:8];
#else
mmbip_src_word = dmem[{mmbip_src_addr[31:1], 1'b0}];
mmbip_data_val = mmbip_src_addr[0] ? mmbip_src_word[7:0] : mmbip_src_word[15:8];
#endif

// Write to memory (read-modify-write for correct byte lane)
mmbip_dst_word = dmem[{mmbip_dst_addr[31:1], 1'b0}];
mmbip_new = mmbip_dst_addr[0] ? {mmbip_dst_word[15:8], mmbip_data_val} : {mmbip_data_val, mmbip_dst_word[7:0]};
dmem[{mmbip_dst_addr[31:1], 1'b0}] when (~m68k_exc_taken & ~data_exc_taken) = mmbip_new;

// Post-increment destination
aregs[dst_reg] when (~m68k_exc_taken & ~data_exc_taken) = mmbip_dst_addr + 1;

// Update CCR
flag_N when (~m68k_exc_taken & ~data_exc_taken) = mmbip_data_val[7];
flag_Z when (~m68k_exc_taken & ~data_exc_taken) = mmbip_data_val == 0;
flag_V when (~m68k_exc_taken & ~data_exc_taken) = 1'b0;
flag_C when (~m68k_exc_taken & ~data_exc_taken) = 1'b0;
