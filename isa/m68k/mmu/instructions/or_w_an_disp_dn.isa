// SPDX-License-Identifier: BSD-3-Clause
// M68000 OR.W (d16,An),Dn - OR word from displacement
// Opcode: 1000 DDD 001 101 AAA + 16-bit displacement

isa_state pc[31:0];
var instr[15:0];
isa_state dregs[31:0][2:0];
isa_state aregs[31:0][2:0];
mem dmem[25:0];
#ifdef MMU
// MMU state (added by MMU preprocessor)
isa_state tc[31:0];
isa_state tt0[31:0];
isa_state tt1[31:0];
isa_state crp[63:0];
isa_state srp[63:0];
isa_state vbr[31:0];
isa_state ssp[31:0];
isa_state usp[31:0];
#endif
isa_state flag_X[0:0];
isa_state flag_N[0:0];
isa_state flag_Z[0:0];
isa_state flag_V[0:0];
isa_state flag_C[0:0];

isa_state dregs_w[15:0][2:0] of dregs[0b***][15:0];

var dst_reg[2:0];
var base_reg[2:0];
var owdd_disp[15:0];
var owdd_disp_ext[31:0];
var owdd_addr[31:0];
var owdd_src[15:0];
var owdd_dst[15:0];
var owdd_result[15:0];

aspect m68k_exception.isa gates pc:2, sr:2, ssp:2, aregs:2, dmem:2, flag_C:2, flag_N:2, flag_Z:2, flag_V:2, flag_X:2, usp:2;
aspect m68k_interrupt.isa gates sr;
#ifdef MMU
aspect mmu/atc_translate_instr.isa gates pc, dmem;
#else
var pc_pa[31:0];
pc_pa = pc;
var pc_pa_delta[31:0];
pc_pa_delta = 32'd0;
#endif

instr = dmem[pc_pa];
assume instr[15:12] == 0b1000;
assume instr[8:6] == 0b001;     // Word, EA to Dn
assume instr[5:3] == 0b101;     // EA: (d16,An)
pc when (~m68k_exc_taken) = pc + 2;

dst_reg = instr[11:9];
base_reg = instr[2:0];

owdd_disp = dmem[pc + pc_pa_delta];
pc when (~m68k_exc_taken) = pc + 2;
owdd_disp_ext = {{16{owdd_disp[15]}}, owdd_disp};
owdd_addr = aregs[base_reg] + owdd_disp_ext;
#ifdef MMU
var mmu_va[31:0];
mmu_va = owdd_addr;
var is_write[0:0];
is_write = 1'b0;
aspect mmu/atc_translate_data.isa gates pc:1, sr:1, ssp:1, aregs:1, dmem:1, flag_C:1, flag_N:1, flag_Z:1, flag_V:1, flag_X:1, usp:1;
#endif

#ifdef MMU
owdd_src = dmem[ea_pa];
#else
owdd_src = dmem[owdd_addr];
#endif

owdd_dst = dregs_w[dst_reg];
owdd_result = owdd_dst | owdd_src;
dregs_w[dst_reg] when (~m68k_exc_taken & ~data_exc_taken) = owdd_result;

flag_N when (~m68k_exc_taken & ~data_exc_taken) = owdd_result[15];
flag_Z when (~m68k_exc_taken & ~data_exc_taken) = owdd_result == 0;
flag_V when (~m68k_exc_taken & ~data_exc_taken) = 1'b0;
flag_C when (~m68k_exc_taken & ~data_exc_taken) = 1'b0;
