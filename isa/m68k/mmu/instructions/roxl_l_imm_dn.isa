// SPDX-License-Identifier: BSD-3-Clause
// M68000 ROXL.L #count,Dn - Rotate left through extend, long, by immediate count
// Opcode: 1110 CCC1 10110 DDD where CCC=count (0=8, 1-7=1-7), DDD=reg
// Rotates the 32-bit register + X flag (33 bits total) left by count

isa_state pc[31:0];
var instr[15:0];
isa_state dregs[31:0][2:0];
isa_state aregs[31:0][2:0];
mem dmem[25:0];
isa_state flag_X[0:0];
isa_state flag_N[0:0];
isa_state flag_Z[0:0];
isa_state flag_V[0:0];
isa_state flag_C[0:0];

var dst_reg[2:0];
var count_field[2:0];
var count[5:0];
var src_val[31:0];
var old_X[0:0];
var result[31:0];
var new_X[0:0];
var temp_val[32:0];
var rotated[65:0];
var left_part[65:0];
var right_part[65:0];

// Include interrupt and exception handling aspects
aspect m68k_exception.isa gates pc:2, sr:2, ssp:2, aregs:2, dmem:2, flag_C:2, flag_N:2, flag_Z:2, flag_V:2, flag_X:2, usp:2;
aspect m68k_interrupt.isa gates sr;
#ifdef MMU
aspect mmu/atc_translate_instr.isa gates pc, dmem;
#else
var pc_pa[31:0];
pc_pa = pc;
var pc_pa_delta[31:0];
pc_pa_delta = 32'd0;
#endif

// Fetch instruction
instr = dmem[pc_pa];
assume instr[15:12] == 0b1110;  // Shift/rotate opcode
assume instr[8] == 1;           // Direction: left
assume instr[7:6] == 0b10;      // Size: long
assume instr[5] == 0;           // i/r: immediate count
assume instr[4:3] == 0b10;      // ROXL type (rotate with extend)
pc when (~m68k_exc_taken) = pc + 2;

// Decode
count_field = instr[11:9];
dst_reg = instr[2:0];

// Convert count (0 means 8, 1-7 means 1-7)
count = count_field == 0 ? 6'h08 : {{3{1'b0}}, count_field};

// Execute - rotate left through X flag (33-bit rotation)
src_val = dregs[dst_reg];
old_X = flag_X;

// Build 33-bit value: {src_val[31:0], old_X}
temp_val = {src_val, old_X};

// Rotate left by count positions (33-bit circular rotation)
// For 33-bit rotation: rotated = (temp << count) | (temp >> (33 - count))
left_part = {{33{1'b0}}, temp_val} << count;
right_part = {{33{1'b0}}, temp_val} >> (33 - count);
rotated = left_part | right_part;

// Extract result: bits [32:1] are the new register value, bit [0] is new X
result = rotated[32:1];
new_X = rotated[0];

// Write result
dregs[dst_reg] when (~m68k_exc_taken) = result;

// Update CCR
flag_X when (~m68k_exc_taken) = new_X;
flag_C when (~m68k_exc_taken) = new_X;  // C gets same value as X
flag_N when (~m68k_exc_taken) = result[31];
flag_Z when (~m68k_exc_taken) = result == 0;
flag_V when (~m68k_exc_taken) = 1'b0;  // ROXL always clears overflow
