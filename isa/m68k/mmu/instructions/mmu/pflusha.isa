// SPDX-License-Identifier: BSD-3-Clause
// MC68030/68851 PFLUSHA - Flush All ATC Entries
// Opcode: 1111 000 000 000 000 (F000) followed by extension
// Extension: 001 0010 0 0000 0000 (2400)
// Invalidates all entries in the ATC
// Privileged instruction

isa_state pc[31:0];
var instr[15:0];
var extw[15:0];
isa_state dregs[31:0][2:0];
isa_state aregs[31:0][2:0];
mem dmem[23:0];

isa_state sr[15:0];

// ATC entries (22 entries on 68030)
isa_state atc_v[0:0][4:0];

isa_state flag_X[0:0];
isa_state flag_N[0:0];
isa_state flag_Z[0:0];
isa_state flag_V[0:0];
isa_state flag_C[0:0];

// Include interrupt and exception handling aspects
aspect ../m68k_exception.isa gates pc, sr, ssp, aregs, dmem, flag_C, flag_N, flag_Z, flag_V, flag_X, usp;
aspect ../m68k_interrupt.isa gates sr;
#ifdef MMU
aspect mmu/atc_translate_instr.isa gates pc, dmem;
#else
var pc_pa[31:0];
pc_pa = pc;
var pc_pa_delta[31:0];
pc_pa_delta = 32'd0;
#endif

instr = dmem[pc_pa];
assume instr == 16'hF000;
pc when (~m68k_exc_taken) = pc + 2;

extw = dmem[pc + pc_pa_delta];
assume extw == 16'h2400;  // PFLUSHA
pc when (~m68k_exc_taken) = pc + 2;

assume sr[13] == 1'b1;

// Invalidate all ATC entries
atc_v[0] when (~m68k_exc_taken) = 1'b0;
atc_v[1] when (~m68k_exc_taken) = 1'b0;
atc_v[2] when (~m68k_exc_taken) = 1'b0;
atc_v[3] when (~m68k_exc_taken) = 1'b0;
atc_v[4] when (~m68k_exc_taken) = 1'b0;
atc_v[5] when (~m68k_exc_taken) = 1'b0;
atc_v[6] when (~m68k_exc_taken) = 1'b0;
atc_v[7] when (~m68k_exc_taken) = 1'b0;
atc_v[8] when (~m68k_exc_taken) = 1'b0;
atc_v[9] when (~m68k_exc_taken) = 1'b0;
atc_v[10] when (~m68k_exc_taken) = 1'b0;
atc_v[11] when (~m68k_exc_taken) = 1'b0;
atc_v[12] when (~m68k_exc_taken) = 1'b0;
atc_v[13] when (~m68k_exc_taken) = 1'b0;
atc_v[14] when (~m68k_exc_taken) = 1'b0;
atc_v[15] when (~m68k_exc_taken) = 1'b0;
atc_v[16] when (~m68k_exc_taken) = 1'b0;
atc_v[17] when (~m68k_exc_taken) = 1'b0;
atc_v[18] when (~m68k_exc_taken) = 1'b0;
atc_v[19] when (~m68k_exc_taken) = 1'b0;
atc_v[20] when (~m68k_exc_taken) = 1'b0;
atc_v[21] when (~m68k_exc_taken) = 1'b0;

// PFLUSHA does not affect CCR
