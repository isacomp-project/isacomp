// SPDX-License-Identifier: BSD-3-Clause
// MC68030 Instruction Fetch Translation Aspect
// Translates PC (virtual address) to pc_pa (physical address)
// Performs 3-level page table walk (68030 short format descriptors)
// On walk failure: sets instr_access_exception for bus error signaling
//
// No ATC/TLB modelling — the ATC is a microarchitectural cache, not ISA state.
// Like RISC-V Sv39, we do a pure page table walk every cycle.

// ============================================================================
// State declarations
// ============================================================================
isa_state pc[31:0];
isa_state sr[15:0];
isa_state tc[31:0];
isa_state tt0[31:0];
isa_state tt1[31:0];
isa_state crp[63:0];
isa_state srp[63:0];

// Physical address output (32-bit)
var pc_pa[31:0];

// Data memory for page table walks (physical access)
mem dmem[25:0];

// ============================================================================
// Extract processor state for translation
// ============================================================================
var is_supervisor[0:0];
is_supervisor = sr[13];

var mmu_enabled[0:0];
mmu_enabled = tc[31];

// Function code for instruction fetch
// FC = 6 (supervisor program) if S=1, FC = 2 (user program) if S=0
var fc[2:0];
fc = is_supervisor ? 3'b110 : 3'b010;

// ============================================================================
// Transparent Translation Check (TT0, TT1)
// ============================================================================
var tt0_base[7:0];
var tt0_mask[7:0];
var tt0_enable[0:0];
var tt0_match[0:0];

var tt1_base[7:0];
var tt1_mask[7:0];
var tt1_enable[0:0];
var tt1_match[0:0];

var transparent[0:0];

tt0_base = tt0[31:24];
tt0_mask = tt0[23:16];
tt0_enable = tt0[15];

tt1_base = tt1[31:24];
tt1_mask = tt1[23:16];
tt1_enable = tt1[15];

// S-field: 00=match always, 01=user only, 10=supervisor only, 11=never match
var tt0_sfield[1:0];
var tt1_sfield[1:0];
var tt0_s_ok[0:0];
var tt1_s_ok[0:0];

tt0_sfield = tt0[14:13];
tt1_sfield = tt1[14:13];

tt0_s_ok = (tt0_sfield == 2'b00) | ((tt0_sfield == 2'b01) & ~is_supervisor) | ((tt0_sfield == 2'b10) & is_supervisor);
tt1_s_ok = (tt1_sfield == 2'b00) | ((tt1_sfield == 2'b01) & ~is_supervisor) | ((tt1_sfield == 2'b10) & is_supervisor);

// TT match: enabled AND S-field ok AND ((addr[31:24] & ~mask) == (base & ~mask))
tt0_match = tt0_enable & tt0_s_ok & ((pc[31:24] & ~tt0_mask) == (tt0_base & ~tt0_mask));
tt1_match = tt1_enable & tt1_s_ok & ((pc[31:24] & ~tt1_mask) == (tt1_base & ~tt1_mask));

transparent = tt0_match | tt1_match;

// ============================================================================
// Address decomposition
// ============================================================================
var pc_vpn[19:0];         // Virtual Page Number (for 4KB pages)
var pc_offset[11:0];      // Page offset (preserved through translation)

pc_vpn = pc[31:12];
pc_offset = pc[11:0];

// ============================================================================
// Page Table Walk (68030 short format descriptors)
// ============================================================================
// Walk 3-level page table: Root -> Level A -> Level B -> Level C (page)
// Standard Linux/m68k layout: TIA=7, TIB=7, TIC=6, PS=4 (4KB pages)

// Select root pointer: SRP if SRE=1 and supervisor, else CRP
// Fallback: also use SRP when CRP is invalid (DT=00), matching Linux boot behavior
var crp_dt_invalid[0:0];
crp_dt_invalid = ~((crp[33:32] == 2'b10) | (crp[33:32] == 2'b11));
var use_srp[0:0];
// MC68030 TC register: SRE is bit 25 (not bit 30 as in some references)
use_srp = (tc[25] & is_supervisor) | crp_dt_invalid;

var root_desc[31:0];
root_desc = use_srp ? srp[31:0] : crp[31:0];

// DT is in the upper longword bits [1:0] = register bits [33:32]
var root_dt[1:0];
root_dt = use_srp ? srp[33:32] : crp[33:32];
var root_valid[0:0];
root_valid = (root_dt == 2'b10) | (root_dt == 2'b11);

// Level A: index from VA[31:25] (TIA=7 bits)
var level_a_idx[6:0];
level_a_idx = pc[31:25];

var root_table_base[31:0];
root_table_base = {root_desc[31:4], 4'b0000};

var level_a_desc_addr[31:0];
level_a_desc_addr = root_table_base + {23'b0, level_a_idx, 2'b00};

var level_a_desc_hi[15:0];
var level_a_desc_lo[15:0];
level_a_desc_hi = dmem[level_a_desc_addr];
level_a_desc_lo = dmem[level_a_desc_addr + 2];

var level_a_desc[31:0];
level_a_desc = {level_a_desc_hi, level_a_desc_lo};

var level_a_dt[1:0];
level_a_dt = level_a_desc[1:0];
var level_a_valid[0:0];
level_a_valid = (level_a_dt == 2'b10) | (level_a_dt == 2'b11);
var level_a_is_page[0:0];
level_a_is_page = (level_a_dt == 2'b01);

// Level B: index from VA[24:18] (TIB=7 bits)
var level_b_idx[6:0];
level_b_idx = pc[24:18];

// 68030 short-format table descriptor: bits[31:2]=table address, [1:0]=DT
var level_b_table_base[31:0];
level_b_table_base = {level_a_desc[31:4], 4'b0000};

var level_b_desc_addr[31:0];
level_b_desc_addr = level_b_table_base + {23'b0, level_b_idx, 2'b00};

var level_b_desc_hi[15:0];
var level_b_desc_lo[15:0];
level_b_desc_hi = dmem[level_b_desc_addr];
level_b_desc_lo = dmem[level_b_desc_addr + 2];

var level_b_desc[31:0];
level_b_desc = {level_b_desc_hi, level_b_desc_lo};

var level_b_dt[1:0];
level_b_dt = level_b_desc[1:0];
var level_b_valid[0:0];
level_b_valid = (level_b_dt == 2'b10) | (level_b_dt == 2'b11);
var level_b_is_page[0:0];
level_b_is_page = (level_b_dt == 2'b01);

// Level C: index from VA[17:12] (TIC=6 bits)
var level_c_idx[5:0];
level_c_idx = pc[17:12];

var level_c_table_base[31:0];
level_c_table_base = {level_b_desc[31:4], 4'b0000};

var level_c_desc_addr[31:0];
level_c_desc_addr = level_c_table_base + {24'b0, level_c_idx, 2'b00};

var level_c_desc_hi[15:0];
var level_c_desc_lo[15:0];
level_c_desc_hi = dmem[level_c_desc_addr];
level_c_desc_lo = dmem[level_c_desc_addr + 2];

var level_c_desc[31:0];
level_c_desc = {level_c_desc_hi, level_c_desc_lo};

var level_c_dt[1:0];
level_c_dt = level_c_desc[1:0];
var level_c_is_page[0:0];
level_c_is_page = (level_c_dt == 2'b01);

// Extract walked physical page number (supports early termination)
var walked_ppn[19:0];
walked_ppn = level_a_is_page ? {level_a_desc[31:25], pc[24:12]} :
             (level_a_valid & level_b_is_page) ? {level_b_desc[31:18], pc[17:12]} :
             level_c_desc[31:12];

// Walk success/failure
var need_walk[0:0];
need_walk = mmu_enabled & ~transparent;

var walk_ok[0:0];
walk_ok = root_valid & (level_a_is_page | (level_a_valid & (level_b_is_page | (level_b_valid & level_c_is_page))));

var walk_success[0:0];
walk_success = need_walk & walk_ok;

var walk_fault[0:0];
walk_fault = need_walk & ~walk_ok;

// ============================================================================
// Instruction fetch access exception
// ============================================================================
var instr_access_exception[0:0];
instr_access_exception = walk_fault;

// Bus error frame data for exception aspect (instruction fetch fault)
var instr_fault_addr[31:0];
instr_fault_addr = pc;

// MC68030 SSW layout: FC(15) FB(14) RC(13) RB(12) res(11:9) DF(8) RM(7) RW(6) SZ(5:4) res(3) DFC(2:0)
// Instruction fetch fault: FB=1 (stage B pipe fault), RW=1 (read), SZ=10 (word)
var instr_fault_ssw[15:0];
instr_fault_ssw = {1'b0, 1'b1, 5'b00000, 1'b0, 1'b0, 1'b1, 2'b10, 1'b0, fc};

// ============================================================================
// Compute physical address
// ============================================================================
var walked_pa[31:0];
walked_pa = {walked_ppn, pc_offset};

pc_pa = (~mmu_enabled | transparent) ? pc :
        walk_success ? walked_pa :
        pc;

// Delta for extension word reads: pc_pa - pc
var pc_pa_delta[31:0];
pc_pa_delta = pc_pa - pc;
