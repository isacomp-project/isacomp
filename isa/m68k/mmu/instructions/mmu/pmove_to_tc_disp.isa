// SPDX-License-Identifier: BSD-3-Clause
// MC68030/68851 PMOVE to TC - Move to Translation Control Register (displacement mode)
// Opcode: 1111 000 000 101 rrr followed by displacement and extension word
// Extension: 010 000 0 0 0000 0000 (4000) - PMOVE <ea>,TC (write to TC, no flush)
// Loads 32-bit TC from memory at (d16,An)

isa_state pc[31:0];
var instr[15:0];
var extw[15:0];
var disp[15:0];
var disp_ext[31:0];
isa_state dregs[31:0][2:0];
isa_state aregs[31:0][2:0];
mem dmem[23:0];
#ifdef MMU
// MMU state (added by MMU preprocessor)
isa_state tc[31:0];
isa_state tt0[31:0];
isa_state tt1[31:0];
isa_state crp[63:0];
isa_state srp[63:0];
isa_state vbr[31:0];
isa_state ssp[31:0];
isa_state usp[31:0];
#endif

isa_state sr[15:0];
isa_state tc[31:0];

isa_state flag_X[0:0];
isa_state flag_N[0:0];
isa_state flag_Z[0:0];
isa_state flag_V[0:0];
isa_state flag_C[0:0];

var ea_mode[2:0];
var ea_reg[2:0];
var addr[31:0];
var data_hi[15:0];
var data_lo[15:0];
var new_tc[31:0];

// Include interrupt and exception handling aspects
aspect ../m68k_exception.isa gates pc, sr, ssp, aregs, dmem, flag_C, flag_N, flag_Z, flag_V, flag_X, usp;
aspect ../m68k_interrupt.isa gates sr;
#ifdef MMU
aspect mmu/atc_translate_instr.isa gates pc, dmem;
#else
var pc_pa[31:0];
pc_pa = pc;
var pc_pa_delta[31:0];
pc_pa_delta = 32'd0;
#endif

instr = dmem[pc_pa];
assume instr[15:6] == 10'b1111000000;
pc when (~m68k_exc_taken) = pc + 2;

ea_mode = instr[5:3];
ea_reg = instr[2:0];

// Fetch extension word (PMOVE command)
extw = dmem[pc + pc_pa_delta];
assume extw == 16'h4000;  // PMOVE to TC (write to TC)
pc when (~m68k_exc_taken) = pc + 2;

// Fetch displacement
disp = dmem[pc + pc_pa_delta];
pc when (~m68k_exc_taken) = pc + 2;
disp_ext = {{16{disp[15]}}, disp};

assume sr[13] == 1'b1;

// Address register indirect with displacement
assume instr[5:3] == 3'b101;
addr = aregs[ea_reg] + disp_ext;

// Read TC value from memory (32 bits, big-endian)
#ifdef MMU
var mmu_va[31:0];
mmu_va = addr;
var is_write[0:0];
is_write = 1'b0;
aspect mmu/atc_translate_data.isa gates pc:1, sr:1, ssp:1, aregs:1, dmem:1, flag_C:1, flag_N:1, flag_Z:1, flag_V:1, flag_X:1, usp:1;
#endif

#ifdef MMU
data_hi = dmem[ea_pa];
#else
data_hi = dmem[addr];
#endif
#ifdef MMU
data_lo = dmem[ea_pa + 2];
#else
data_lo = dmem[addr + 2];
#endif
new_tc = {data_hi, data_lo};

// Load TC
tc when (~m68k_exc_taken & ~data_exc_taken) = new_tc;

