// SPDX-License-Identifier: BSD-3-Clause
// M68000 SUBX.L Dx,Dy - Subtract Extended long data registers
// Opcode: 1001 yyy 1 10 00 0 xxx where yyy=Dy (dest), xxx=Dx (src)
// Operation: Dy - Dx - X -> Dy

isa_state pc[31:0];
var instr[15:0];
isa_state dregs[31:0][2:0];
isa_state aregs[31:0][2:0];
mem dmem[25:0];
isa_state flag_X[0:0];
isa_state flag_N[0:0];
isa_state flag_Z[0:0];
isa_state flag_V[0:0];
isa_state flag_C[0:0];

var src_reg[2:0];
var dst_reg[2:0];
var src_val[31:0];
var dst_val[31:0];
var x_val[0:0];
var result[32:0];
var old_z[0:0];

// Include interrupt and exception handling aspects
aspect m68k_exception.isa gates pc:2, sr:2, ssp:2, aregs:2, dmem:2, flag_C:2, flag_N:2, flag_Z:2, flag_V:2, flag_X:2, usp:2;
aspect m68k_interrupt.isa gates sr;
#ifdef MMU
aspect mmu/atc_translate_instr.isa gates pc, dmem;
#else
var pc_pa[31:0];
pc_pa = pc;
var pc_pa_delta[31:0];
pc_pa_delta = 32'd0;
#endif

// Fetch instruction
instr = dmem[pc_pa];
assume instr[15:12] == 0b1001;  // SUBX opcode
assume instr[8] == 1;            // SUBX identifier
assume instr[7:6] == 0b10;       // Size: long
assume instr[5:4] == 0b00;       // SUBX pattern
assume instr[3] == 0;            // Register mode (R/M bit)
pc when (~m68k_exc_taken) = pc + 2;

// Decode
dst_reg = instr[11:9];
src_reg = instr[2:0];

// Execute: Dy - Dx - X -> Dy
src_val = dregs[src_reg];
dst_val = dregs[dst_reg];
x_val = flag_X;
old_z = flag_Z;

// Perform subtraction with extend
result = dst_val - src_val - x_val;

// Write result
dregs[dst_reg] when (~m68k_exc_taken) = result[31:0];

// Update CCR
// X and C are set if borrow occurred
// Borrow occurs if (src_val + x_val) > dst_val
flag_X when (~m68k_exc_taken) = (src_val + x_val) > dst_val;
flag_C when (~m68k_exc_taken) = (src_val + x_val) > dst_val;

// V flag: overflow when operands have opposite signs and result differs from destination
flag_V when (~m68k_exc_taken) = (~dst_val[31] & src_val[31] & result[31]) | (dst_val[31] & ~src_val[31] & ~result[31]);

// N flag: set from result MSB
flag_N when (~m68k_exc_taken) = result[31];

// Z flag: special handling - only cleared if result is non-zero, never set
// Z = Z_old & (result == 0)
flag_Z when (~m68k_exc_taken) = old_z & (result[31:0] == 0);
