// SPDX-License-Identifier: BSD-3-Clause
// M68000 CMPI.B #imm,(d8,An,Xn) - Compare immediate byte with indexed memory
// Opcode: 0000 1100 00 110 AAA followed by immediate word, then brief extension word
// Note: CMPI has immediate BEFORE extension word

isa_state pc[31:0];
var instr[15:0];
isa_state dregs[31:0][2:0];
isa_state aregs[31:0][2:0];
mem dmem[25:0];
#ifdef MMU
// MMU state (added by MMU preprocessor)
isa_state tc[31:0];
isa_state tt0[31:0];
isa_state tt1[31:0];
isa_state crp[63:0];
isa_state srp[63:0];
isa_state vbr[31:0];
isa_state ssp[31:0];
isa_state usp[31:0];
#endif
isa_state flag_X[0:0];
isa_state flag_N[0:0];
isa_state flag_Z[0:0];
isa_state flag_V[0:0];
isa_state flag_C[0:0];

var addr_reg[2:0];
var imm_word[15:0];
var imm_val[7:0];
var brief_ext[15:0];
var idx_is_addr[0:0];
var idx_reg[2:0];
var idx_is_long[0:0];
var scale[1:0];
var disp8[7:0];
var disp_ext[31:0];
var idx_raw[31:0];
var idx_val[31:0];
var scaled_idx[31:0];
var eff_addr[31:0];
var dst_val[7:0];
var result[8:0];
var mcbix_word[15:0];

// Include interrupt and exception handling aspects
aspect m68k_exception.isa gates pc:2, sr:2, ssp:2, aregs:2, dmem:2, flag_C:2, flag_N:2, flag_Z:2, flag_V:2, flag_X:2, usp:2;
aspect m68k_interrupt.isa gates sr;
#ifdef MMU
aspect mmu/atc_translate_instr.isa gates pc, dmem;
#else
var pc_pa[31:0];
pc_pa = pc;
var pc_pa_delta[31:0];
pc_pa_delta = 32'd0;
#endif

// Fetch instruction
instr = dmem[pc_pa];
assume instr[15:8] == 0b00001100;  // CMPI opcode
assume instr[7:6] == 0b00;         // Size: byte
assume instr[5:3] == 0b110;        // EA mode: Address Register Indirect with Index
pc when (~m68k_exc_taken) = pc + 2;

addr_reg = instr[2:0];

// Fetch immediate value (byte is in low byte of word)
imm_word = dmem[pc + pc_pa_delta];
pc when (~m68k_exc_taken) = pc + 2;
imm_val = imm_word[7:0];

// Fetch brief extension word
brief_ext = dmem[pc + pc_pa_delta];
assume brief_ext[8] == 0b0;  // Brief format
pc when (~m68k_exc_taken) = pc + 2;

// Decode extension word
idx_is_addr = brief_ext[15];
idx_reg = brief_ext[14:12];
idx_is_long = brief_ext[11];
scale = brief_ext[10:9];
disp8 = brief_ext[7:0];

// Sign-extend displacement
disp_ext = {{24{disp8[7]}}, disp8};

// Get index register value
idx_raw = idx_is_addr ? aregs[idx_reg] : dregs[idx_reg];

// Sign-extend word index if needed
idx_val = idx_is_long ? idx_raw : (idx_raw[15] ? {16'hFFFF, idx_raw[15:0]} : {16'h0000, idx_raw[15:0]});

// Apply scale factor
scaled_idx = scale == 0 ? idx_val :
             scale == 1 ? (idx_val << 1) :
             scale == 2 ? (idx_val << 2) :
                          (idx_val << 3);

// Calculate effective address
eff_addr = aregs[addr_reg] + disp_ext + scaled_idx;

// Read memory byte
#ifdef MMU
var mmu_va[31:0];
mmu_va = eff_addr;
var is_write[0:0];
is_write = 1'b0;
aspect mmu/atc_translate_data.isa gates pc:1, sr:1, ssp:1, aregs:1, dmem:1, flag_C:1, flag_N:1, flag_Z:1, flag_V:1, flag_X:1, usp:1;
#endif

#ifdef MMU
mcbix_word = dmem[{ea_pa[31:1], 1'b0}];
dst_val = eff_addr[0] ? mcbix_word[7:0] : mcbix_word[15:8];
#else
mcbix_word = dmem[{eff_addr[31:1], 1'b0}];
dst_val = eff_addr[0] ? mcbix_word[7:0] : mcbix_word[15:8];
#endif

// Execute comparison (subtract but don't store result)
result = dst_val - imm_val;

// Update CCR (X not affected by CMP)
flag_C when (~m68k_exc_taken & ~data_exc_taken) = imm_val > dst_val;
flag_V when (~m68k_exc_taken & ~data_exc_taken) = (~dst_val[7] & imm_val[7] & result[7]) | (dst_val[7] & ~imm_val[7] & ~result[7]);
flag_Z when (~m68k_exc_taken & ~data_exc_taken) = result[7:0] == 0;
flag_N when (~m68k_exc_taken & ~data_exc_taken) = result[7];
