// SPDX-License-Identifier: BSD-3-Clause
// M68000 ADD.L Dn,-(An) - Add data register to long in memory with pre-decrement
// Opcode: 1101 DDD1 10 100 AAA where DDD=data reg (source), AAA=addr reg

isa_state pc[31:0];
var instr[15:0];
isa_state dregs[31:0][2:0];
isa_state aregs[31:0][2:0];
mem dmem[25:0];
#ifdef MMU
// MMU state (added by MMU preprocessor)
isa_state tc[31:0];
isa_state tt0[31:0];
isa_state tt1[31:0];
isa_state crp[63:0];
isa_state srp[63:0];
isa_state vbr[31:0];
isa_state ssp[31:0];
isa_state usp[31:0];
#endif
isa_state flag_X[0:0];
isa_state flag_N[0:0];
isa_state flag_Z[0:0];
isa_state flag_V[0:0];
isa_state flag_C[0:0];

var src_reg[2:0];
var addr_reg[2:0];
var alpd_addr[31:0];
var alpd_dst_hi[15:0];
var alpd_dst_lo[15:0];
var alpd_src_val[31:0];
var alpd_dst_val[31:0];
var alpd_result[32:0];

// Include interrupt and exception handling aspects
aspect m68k_exception.isa gates pc:2, sr:2, ssp:2, aregs:2, dmem:2, flag_C:2, flag_N:2, flag_Z:2, flag_V:2, flag_X:2, usp:2;
aspect m68k_interrupt.isa gates sr;
#ifdef MMU
aspect mmu/atc_translate_instr.isa gates pc, dmem;
#else
var pc_pa[31:0];
pc_pa = pc;
var pc_pa_delta[31:0];
pc_pa_delta = 32'd0;
#endif

// Fetch instruction
instr = dmem[pc_pa];
assume instr[15:12] == 0b1101;  // ADD opcode
assume instr[8:6] == 0b110;     // Opmode: long, Dn to EA
assume instr[5:3] == 0b100;     // EA mode: -(An) pre-decrement
pc when (~m68k_exc_taken) = pc + 2;

// Decode
src_reg = instr[11:9];
addr_reg = instr[2:0];

// Pre-decrement address register by 4 (long word)
alpd_addr = aregs[addr_reg] - 4;
aregs[addr_reg] when (~m68k_exc_taken) = alpd_addr;

// MMU translate
#ifdef MMU
var mmu_va[31:0];
mmu_va = alpd_addr;
var is_write[0:0];
is_write = 1'b1;
aspect mmu/atc_translate_data.isa gates pc:1, sr:1, ssp:1, aregs:1, dmem:1, flag_C:1, flag_N:1, flag_Z:1, flag_V:1, flag_X:1, usp:1;
#endif

// Read destination from memory (two 16-bit reads, big-endian)
#ifdef MMU
alpd_dst_hi = dmem[ea_pa];
#else
alpd_dst_hi = dmem[alpd_addr];
#endif
#ifdef MMU
alpd_dst_lo = dmem[ea_pa + 2];
#else
alpd_dst_lo = dmem[alpd_addr + 2];
#endif
alpd_dst_val = {alpd_dst_hi, alpd_dst_lo};

// Execute
alpd_src_val = dregs[src_reg];
alpd_result = alpd_dst_val + alpd_src_val;

// Write result back to memory
#ifdef MMU
dmem[ea_pa] when (~m68k_exc_taken & ~data_exc_taken) = alpd_result[31:16];
#else
dmem[alpd_addr] when (~m68k_exc_taken & ~data_exc_taken) = alpd_result[31:16];
#endif
#ifdef MMU
dmem[ea_pa + 2] when (~m68k_exc_taken & ~data_exc_taken) = alpd_result[15:0];
#else
dmem[alpd_addr + 2] when (~m68k_exc_taken & ~data_exc_taken) = alpd_result[15:0];
#endif

// Update CCR
flag_X when (~m68k_exc_taken & ~data_exc_taken) = alpd_result[32];
flag_C when (~m68k_exc_taken & ~data_exc_taken) = alpd_result[32];
flag_V when (~m68k_exc_taken & ~data_exc_taken) = (~alpd_dst_val[31] & ~alpd_src_val[31] & alpd_result[31]) | (alpd_dst_val[31] & alpd_src_val[31] & ~alpd_result[31]);
flag_Z when (~m68k_exc_taken & ~data_exc_taken) = alpd_result[31:0] == 0;
flag_N when (~m68k_exc_taken & ~data_exc_taken) = alpd_result[31];
