// SPDX-License-Identifier: BSD-3-Clause
// M68000 MOVEA.W (An)+,Am - Move word from postincrement to address register (sign-extended)
// Opcode: 0011 DDD 001 011 SSS
// MOVEA does NOT affect condition codes

isa_state pc[31:0];
var instr[15:0];
isa_state dregs[31:0][2:0];
isa_state aregs[31:0][2:0];
mem dmem[25:0];
#ifdef MMU
// MMU state (added by MMU preprocessor)
isa_state tc[31:0];
isa_state tt0[31:0];
isa_state tt1[31:0];
isa_state crp[63:0];
isa_state srp[63:0];
isa_state vbr[31:0];
isa_state ssp[31:0];
isa_state usp[31:0];
#endif
isa_state flag_X[0:0];
isa_state flag_N[0:0];
isa_state flag_Z[0:0];
isa_state flag_V[0:0];
isa_state flag_C[0:0];

var dst_reg[2:0];
var src_reg[2:0];
var mwpa_eff_addr[31:0];
var mwpa_src_word[15:0];
var mwpa_result[31:0];

aspect m68k_exception.isa gates pc:2, sr:2, ssp:2, aregs:2, dmem:2, flag_C:2, flag_N:2, flag_Z:2, flag_V:2, flag_X:2, usp:2;
aspect m68k_interrupt.isa gates sr;
#ifdef MMU
aspect mmu/atc_translate_instr.isa gates pc, dmem;
#else
var pc_pa[31:0];
pc_pa = pc;
var pc_pa_delta[31:0];
pc_pa_delta = 32'd0;
#endif

instr = dmem[pc_pa];
assume instr[15:12] == 0b0011;  // MOVEA.W
assume instr[8:6] == 0b001;     // Dest mode: An (MOVEA)
assume instr[5:3] == 0b011;     // Source mode: Postincrement
pc when (~m68k_exc_taken) = pc + 2;

dst_reg = instr[11:9];
src_reg = instr[2:0];

mwpa_eff_addr = aregs[src_reg];

#ifdef MMU
var mmu_va[31:0];
mmu_va = mwpa_eff_addr;
var is_write[0:0];
is_write = 1'b0;
aspect mmu/atc_translate_data.isa gates pc:1, sr:1, ssp:1, aregs:1, dmem:1, flag_C:1, flag_N:1, flag_Z:1, flag_V:1, flag_X:1, usp:1;
#endif

#ifdef MMU
mwpa_src_word = dmem[ea_pa];
#else
mwpa_src_word = dmem[mwpa_eff_addr];
#endif
aregs[src_reg] when (~m68k_exc_taken & ~data_exc_taken) = mwpa_eff_addr + 2;

mwpa_result = {{16{mwpa_src_word[15]}}, mwpa_src_word};
aregs[dst_reg] when (~m68k_exc_taken & ~data_exc_taken) = mwpa_result;
