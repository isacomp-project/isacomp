// SPDX-License-Identifier: BSD-3-Clause
// M68000 SUB.W An,Dn - Subtract word from address register from data register
// Opcode: 1001 DDD 001 001 AAA where DDD=dest data reg, AAA=src addr reg

isa_state pc[31:0];
var instr[15:0];
isa_state dregs[31:0][2:0];
isa_state aregs[31:0][2:0];
mem dmem[25:0];
#ifdef MMU
// MMU state (added by MMU preprocessor)
isa_state tc[31:0];
isa_state tt0[31:0];
isa_state tt1[31:0];
isa_state crp[63:0];
isa_state srp[63:0];
isa_state vbr[31:0];
isa_state ssp[31:0];
isa_state usp[31:0];
#endif
isa_state flag_X[0:0];
isa_state flag_N[0:0];
isa_state flag_Z[0:0];
isa_state flag_V[0:0];
isa_state flag_C[0:0];

// Word sub-registers using 'of' keyword
isa_state dregs_w[15:0][2:0] of dregs[0b***][15:0];

var dst_reg[2:0];
var src_reg[2:0];
var swad_src_val[15:0];
var swad_dst_val[15:0];
var swad_result[16:0];

// Include interrupt and exception handling aspects
aspect m68k_exception.isa gates pc:2, sr:2, ssp:2, aregs:2, dmem:2, flag_C:2, flag_N:2, flag_Z:2, flag_V:2, flag_X:2, usp:2;
aspect m68k_interrupt.isa gates sr;
#ifdef MMU
aspect mmu/atc_translate_instr.isa gates pc, dmem;
#else
var pc_pa[31:0];
pc_pa = pc;
var pc_pa_delta[31:0];
pc_pa_delta = 32'd0;
#endif

// Fetch instruction
instr = dmem[pc_pa];
assume instr[15:12] == 0b1001;  // SUB opcode
assume instr[8:6] == 0b001;     // Opmode: word, Dn - <ea> -> Dn
assume instr[5:3] == 0b001;     // EA mode: Address Register Direct
pc when (~m68k_exc_taken) = pc + 2;

// Decode
dst_reg = instr[11:9];
src_reg = instr[2:0];

// Execute - use low 16 bits of address register (no memory access needed)
swad_src_val = aregs[src_reg][15:0];
swad_dst_val = dregs_w[dst_reg];
swad_result = swad_dst_val - swad_src_val;

// Write back low word only (preserves upper word via 'of' mapping)
dregs_w[dst_reg] when (~m68k_exc_taken) = swad_result[15:0];

// Update CCR
flag_X when (~m68k_exc_taken) = swad_result[16];
flag_C when (~m68k_exc_taken) = swad_result[16];
flag_V when (~m68k_exc_taken) = (swad_dst_val[15] & ~swad_src_val[15] & ~swad_result[15]) | (~swad_dst_val[15] & swad_src_val[15] & swad_result[15]);
flag_Z when (~m68k_exc_taken) = swad_result[15:0] == 0;
flag_N when (~m68k_exc_taken) = swad_result[15];
