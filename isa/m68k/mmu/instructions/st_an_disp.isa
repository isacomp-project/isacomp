// SPDX-License-Identifier: BSD-3-Clause
// M68000 ST (d16,An) - Set byte if true (always) at displacement
// Opcode: 0101 0000 11 101 AAA + 16-bit displacement

isa_state pc[31:0];
var instr[15:0];
isa_state dregs[31:0][2:0];
isa_state aregs[31:0][2:0];
mem dmem[25:0];
#ifdef MMU
// MMU state (added by MMU preprocessor)
isa_state tc[31:0];
isa_state tt0[31:0];
isa_state tt1[31:0];
isa_state crp[63:0];
isa_state srp[63:0];
isa_state vbr[31:0];
isa_state ssp[31:0];
isa_state usp[31:0];
#endif
isa_state flag_X[0:0];
isa_state flag_N[0:0];
isa_state flag_Z[0:0];
isa_state flag_V[0:0];
isa_state flag_C[0:0];

var std_reg[2:0];
var std_disp[15:0];
var std_disp_ext[31:0];
var std_addr[31:0];
var std_word[15:0];
var std_new[15:0];

aspect m68k_exception.isa gates pc:2, sr:2, ssp:2, aregs:2, dmem:2, flag_C:2, flag_N:2, flag_Z:2, flag_V:2, flag_X:2, usp:2;
aspect m68k_interrupt.isa gates sr;
#ifdef MMU
aspect mmu/atc_translate_instr.isa gates pc, dmem;
#else
var pc_pa[31:0];
pc_pa = pc;
var pc_pa_delta[31:0];
pc_pa_delta = 32'd0;
#endif

instr = dmem[pc_pa];
assume instr[15:12] == 0b0101;
assume instr[11:8] == 0b0000;   // ST condition
assume instr[7:6] == 0b11;
assume instr[5:3] == 0b101;     // EA: (d16,An)
pc when (~m68k_exc_taken) = pc + 2;

std_reg = instr[2:0];
std_disp = dmem[pc + pc_pa_delta];
pc when (~m68k_exc_taken) = pc + 2;
std_disp_ext = {{16{std_disp[15]}}, std_disp};
std_addr = aregs[std_reg] + std_disp_ext;

// Write 0xFF byte (read-modify-write)
#ifdef MMU
var mmu_va[31:0];
mmu_va = {std_addr[31:1], 1'b0};
var is_write[0:0];
is_write = 1'b0;
aspect mmu/atc_translate_data.isa gates pc:1, sr:1, ssp:1, aregs:1, dmem:1, flag_C:1, flag_N:1, flag_Z:1, flag_V:1, flag_X:1, usp:1;
#endif

#ifdef MMU
std_word = dmem[ea_pa];
#else
std_word = dmem[{std_addr[31:1], 1'b0}];
#endif
std_new = std_addr[0] ? {std_word[15:8], 8'hFF} : {8'hFF, std_word[7:0]};
#ifdef MMU
dmem[ea_pa] when (~m68k_exc_taken & ~data_exc_taken) = std_new;
#else
dmem[{std_addr[31:1], 1'b0}] when (~m68k_exc_taken & ~data_exc_taken) = std_new;
#endif
