// SPDX-License-Identifier: BSD-3-Clause
// M68000 CMPA.L d(An),Am - Compare long from d(An) with address register
// Opcode: 1011 DDD1 11 101 SSS followed by 16-bit displacement

isa_state pc[31:0];
var instr[15:0];
isa_state dregs[31:0][2:0];
isa_state aregs[31:0][2:0];
mem dmem[25:0];
#ifdef MMU
// MMU state (added by MMU preprocessor)
isa_state tc[31:0];
isa_state tt0[31:0];
isa_state tt1[31:0];
isa_state crp[63:0];
isa_state srp[63:0];
isa_state vbr[31:0];
isa_state ssp[31:0];
isa_state usp[31:0];
#endif
isa_state flag_X[0:0];
isa_state flag_N[0:0];
isa_state flag_Z[0:0];
isa_state flag_V[0:0];
isa_state flag_C[0:0];

var dst_reg[2:0];
var src_reg[2:0];
var disp[15:0];
var disp_ext[31:0];
var eff_addr[31:0];
var src_hi[15:0];
var src_lo[15:0];
var src_val[31:0];
var dst_val[31:0];
var result[32:0];

// Include interrupt and exception handling aspects
aspect m68k_exception.isa gates pc:2, sr:2, ssp:2, aregs:2, dmem:2, flag_C:2, flag_N:2, flag_Z:2, flag_V:2, flag_X:2, usp:2;
aspect m68k_interrupt.isa gates sr;
#ifdef MMU
aspect mmu/atc_translate_instr.isa gates pc, dmem;
#else
var pc_pa[31:0];
pc_pa = pc;
var pc_pa_delta[31:0];
pc_pa_delta = 32'd0;
#endif

// Fetch instruction
instr = dmem[pc_pa];
assume instr[15:12] == 0b1011;  // CMPA opcode
assume instr[8:6] == 0b111;     // Opmode: CMPA.L
assume instr[5:3] == 0b101;     // EA mode: d(An)
pc when (~m68k_exc_taken) = pc + 2;

dst_reg = instr[11:9];
src_reg = instr[2:0];

// Fetch 16-bit displacement
disp = dmem[pc + pc_pa_delta];
pc when (~m68k_exc_taken) = pc + 2;
disp_ext = {{16{disp[15]}}, disp};

// Calculate effective address
eff_addr = aregs[src_reg] + disp_ext;

// Read 32-bit source from memory
#ifdef MMU
var mmu_va[31:0];
mmu_va = eff_addr;
var is_write[0:0];
is_write = 1'b0;
aspect mmu/atc_translate_data.isa gates pc:1, sr:1, ssp:1, aregs:1, dmem:1, flag_C:1, flag_N:1, flag_Z:1, flag_V:1, flag_X:1, usp:1;
#endif

#ifdef MMU
src_hi = dmem[ea_pa];
#else
src_hi = dmem[eff_addr];
#endif
#ifdef MMU
src_lo = dmem[ea_pa + 2];
#else
src_lo = dmem[eff_addr + 2];
#endif
src_val = {src_hi, src_lo};

// Execute (subtract but don't store result)
dst_val = aregs[dst_reg];
result = dst_val - src_val;

// Update CCR (X not affected by CMPA)
flag_C when (~m68k_exc_taken & ~data_exc_taken) = src_val > dst_val;
flag_V when (~m68k_exc_taken & ~data_exc_taken) = (~dst_val[31] & src_val[31] & result[31]) | (dst_val[31] & ~src_val[31] & ~result[31]);
flag_Z when (~m68k_exc_taken & ~data_exc_taken) = result[31:0] == 0;
flag_N when (~m68k_exc_taken & ~data_exc_taken) = result[31];
