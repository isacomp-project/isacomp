// SPDX-License-Identifier: BSD-3-Clause
// M68000 MOVE.B (d8,An,Xn),(An) - Move byte indexed to indirect
// Opcode: 0001 DDD 010 110 SSS + brief extension word

isa_state pc[31:0];
var instr[15:0];
isa_state dregs[31:0][2:0];
isa_state aregs[31:0][2:0];
mem dmem[25:0];
#ifdef MMU
// MMU state (added by MMU preprocessor)
isa_state tc[31:0];
isa_state tt0[31:0];
isa_state tt1[31:0];
isa_state crp[63:0];
isa_state srp[63:0];
isa_state vbr[31:0];
isa_state ssp[31:0];
isa_state usp[31:0];
#endif
isa_state flag_X[0:0];
isa_state flag_N[0:0];
isa_state flag_Z[0:0];
isa_state flag_V[0:0];
isa_state flag_C[0:0];

var dst_reg[2:0];
var base_reg[2:0];
var mbia_ext[15:0];
var idx_reg[2:0];
var mbia_idx_is_addr[0:0];
var mbia_idx_is_long[0:0];
var mbia_idx_scale[1:0];
var mbia_disp8[7:0];
var mbia_disp_ext[31:0];
var mbia_raw_idx[31:0];
var mbia_idx_val[31:0];
var mbia_scaled_idx[31:0];
var mbia_src_addr[31:0];
var mbia_dst_addr[31:0];
var mbia_src_word[15:0];
var mbia_byte[7:0];
var mbia_dst_word[15:0];
var mbia_new[15:0];

aspect m68k_exception.isa gates pc:2, sr:2, ssp:2, aregs:2, dmem:2, flag_C:2, flag_N:2, flag_Z:2, flag_V:2, flag_X:2, usp:2;
aspect m68k_interrupt.isa gates sr;
#ifdef MMU
aspect mmu/atc_translate_instr.isa gates pc, dmem;
#else
var pc_pa[31:0];
pc_pa = pc;
var pc_pa_delta[31:0];
pc_pa_delta = 32'd0;
#endif

instr = dmem[pc_pa];
assume instr[15:12] == 0b0001;
assume instr[8:6] == 0b010;     // Dst: (An)
assume instr[5:3] == 0b110;     // Src: (d8,An,Xn)
pc when (~m68k_exc_taken) = pc + 2;

dst_reg = instr[11:9];
base_reg = instr[2:0];

mbia_ext = dmem[pc + pc_pa_delta];
assume mbia_ext[8] == 0b0;
pc when (~m68k_exc_taken) = pc + 2;

idx_reg = mbia_ext[14:12];
mbia_idx_is_addr = mbia_ext[15];
mbia_idx_is_long = mbia_ext[11];
mbia_idx_scale = mbia_ext[10:9];
mbia_disp8 = mbia_ext[7:0];
mbia_disp_ext = {{24{mbia_disp8[7]}}, mbia_disp8};

mbia_raw_idx = mbia_idx_is_addr ? aregs[idx_reg] : dregs[idx_reg];
mbia_idx_val = mbia_idx_is_long ? mbia_raw_idx : {{16{mbia_raw_idx[15]}}, mbia_raw_idx[15:0]};
mbia_scaled_idx = mbia_idx_scale == 2'b00 ? mbia_idx_val :
                  mbia_idx_scale == 2'b01 ? (mbia_idx_val << 1) :
                  mbia_idx_scale == 2'b10 ? (mbia_idx_val << 2) :
                                             (mbia_idx_val << 3);

mbia_src_addr = aregs[base_reg] + mbia_disp_ext + mbia_scaled_idx;
#ifdef MMU
var mmu_va[31:0];
mmu_va = {mbia_src_addr[31:1], 1'b0};
var is_write[0:0];
is_write = 1'b0;
aspect mmu/atc_translate_data.isa gates pc:1, sr:1, ssp:1, aregs:1, dmem:1, flag_C:1, flag_N:1, flag_Z:1, flag_V:1, flag_X:1, usp:1;
#endif

#ifdef MMU
mbia_src_word = dmem[ea_pa];
#else
mbia_src_word = dmem[{mbia_src_addr[31:1], 1'b0}];
#endif
mbia_byte = mbia_src_addr[0] ? mbia_src_word[7:0] : mbia_src_word[15:8];

mbia_dst_addr = aregs[dst_reg];
mbia_dst_word = dmem[{mbia_dst_addr[31:1], 1'b0}];
mbia_new = mbia_dst_addr[0] ? {mbia_dst_word[15:8], mbia_byte} : {mbia_byte, mbia_dst_word[7:0]};
dmem[{mbia_dst_addr[31:1], 1'b0}] when (~m68k_exc_taken & ~data_exc_taken) = mbia_new;

flag_N when (~m68k_exc_taken & ~data_exc_taken) = mbia_byte[7];
flag_Z when (~m68k_exc_taken & ~data_exc_taken) = mbia_byte == 0;
flag_V when (~m68k_exc_taken & ~data_exc_taken) = 1'b0;
flag_C when (~m68k_exc_taken & ~data_exc_taken) = 1'b0;
