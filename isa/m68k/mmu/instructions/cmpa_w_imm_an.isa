// SPDX-License-Identifier: BSD-3-Clause
// M68000 CMPA.W #imm,An - Compare immediate word with address register
// Opcode: 1011 AAA0 11 111 100 followed by 16-bit immediate
// Word immediate is sign-extended to 32 bits before comparison

isa_state pc[31:0];
var instr[15:0];
isa_state dregs[31:0][2:0];
isa_state aregs[31:0][2:0];
mem dmem[25:0];
isa_state flag_X[0:0];
isa_state flag_N[0:0];
isa_state flag_Z[0:0];
isa_state flag_V[0:0];
isa_state flag_C[0:0];

var dst_reg[2:0];
var imm_word[15:0];
var imm_val[31:0];
var dst_val[31:0];
var result[32:0];

// Include interrupt and exception handling aspects
aspect m68k_exception.isa gates pc:2, sr:2, ssp:2, aregs:2, dmem:2, flag_C:2, flag_N:2, flag_Z:2, flag_V:2, flag_X:2, usp:2;
aspect m68k_interrupt.isa gates sr;
#ifdef MMU
aspect mmu/atc_translate_instr.isa gates pc, dmem;
#else
var pc_pa[31:0];
pc_pa = pc;
var pc_pa_delta[31:0];
pc_pa_delta = 32'd0;
#endif

// Fetch instruction
instr = dmem[pc_pa];
assume instr[15:12] == 0b1011;  // CMPA opcode
assume instr[8:6] == 0b011;     // Opmode: CMPA.W
assume instr[5:3] == 0b111;     // EA mode: Immediate
assume instr[2:0] == 0b100;     // EA reg: 100 for immediate mode
pc when (~m68k_exc_taken) = pc + 2;

// Decode
dst_reg = instr[11:9];

// Fetch 16-bit immediate
imm_word = dmem[pc + pc_pa_delta];
pc when (~m68k_exc_taken) = pc + 2;

// Sign-extend to 32 bits
imm_val = imm_word[15] ? {16'hFFFF, imm_word} : {16'h0000, imm_word};

// Execute (subtract but don't store result)
dst_val = aregs[dst_reg];
result = dst_val - imm_val;

// Update CCR (X not affected by CMPA)
flag_C when (~m68k_exc_taken) = imm_val > dst_val;
flag_V when (~m68k_exc_taken) = (~dst_val[31] & imm_val[31] & result[31]) | (dst_val[31] & ~imm_val[31] & ~result[31]);
flag_Z when (~m68k_exc_taken) = result[31:0] == 0;
flag_N when (~m68k_exc_taken) = result[31];
