// SPDX-License-Identifier: BSD-3-Clause
// MC68020 MOVE.L Dn,(bd32,An) - Move long from data register to full indexed (index suppressed)
// Opcode: 0010 DDD 110 000 SSS + full extension word + 32-bit base displacement
// Full ext: BS=0 (base used), IS=1 (index suppressed), BD=long, I/IS=000
// EA = An + bd32

isa_state pc[31:0];
var instr[15:0];
isa_state dregs[31:0][2:0];
isa_state aregs[31:0][2:0];
mem dmem[25:0];
#ifdef MMU
// MMU state (added by MMU preprocessor)
isa_state tc[31:0];
isa_state tt0[31:0];
isa_state tt1[31:0];
isa_state crp[63:0];
isa_state srp[63:0];
isa_state vbr[31:0];
isa_state ssp[31:0];
isa_state usp[31:0];
#endif
isa_state flag_X[0:0];
isa_state flag_N[0:0];
isa_state flag_Z[0:0];
isa_state flag_V[0:0];
isa_state flag_C[0:0];

var src_reg[2:0];
var base_reg[2:0];
var mldi_ext[15:0];
var bd_hi[15:0];
var bd_lo[15:0];
var bd32[31:0];
var eff_addr[31:0];
var data[31:0];

// Include interrupt and exception handling aspects
aspect m68k_exception.isa gates pc:2, sr:2, ssp:2, aregs:2, dmem:2, flag_C:2, flag_N:2, flag_Z:2, flag_V:2, flag_X:2, usp:2;
aspect m68k_interrupt.isa gates sr;
#ifdef MMU
aspect mmu/atc_translate_instr.isa gates pc, dmem;
#else
var pc_pa[31:0];
pc_pa = pc;
var pc_pa_delta[31:0];
pc_pa_delta = 32'd0;
#endif

// Fetch instruction
instr = dmem[pc_pa];
assume instr[15:12] == 0b0010;  // MOVE.L
assume instr[8:6] == 0b110;     // Dest mode: indexed
assume instr[5:3] == 0b000;     // Source mode: Dn
pc when (~m68k_exc_taken) = pc + 2;

base_reg = instr[11:9];
src_reg = instr[2:0];

// Fetch full extension word
mldi_ext = dmem[pc + pc_pa_delta];
assume mldi_ext[8] == 0b1;       // Full format
assume mldi_ext[7] == 0b0;       // Base NOT suppressed (BS=0)
assume mldi_ext[6] == 0b1;       // Index suppressed (IS=1)
assume mldi_ext[5:4] == 0b11;    // BD size = long
assume mldi_ext[3:0] == 0b0000;  // No memory indirect
pc when (~m68k_exc_taken) = pc + 2;

// Fetch 32-bit base displacement
bd_hi = dmem[pc + pc_pa_delta];
pc when (~m68k_exc_taken) = pc + 2;
bd_lo = dmem[pc + pc_pa_delta];
pc when (~m68k_exc_taken) = pc + 2;
bd32 = {bd_hi, bd_lo};

// Calculate effective address: base register + displacement
eff_addr = aregs[base_reg] + bd32;

// Get source data
data = dregs[src_reg];

// Write to destination
#ifdef MMU
var mmu_va[31:0];
mmu_va = eff_addr;
var is_write[0:0];
is_write = 1'b1;
aspect mmu/atc_translate_data.isa gates pc:1, sr:1, ssp:1, aregs:1, dmem:1, flag_C:1, flag_N:1, flag_Z:1, flag_V:1, flag_X:1, usp:1;
#endif

#ifdef MMU
dmem[ea_pa] when (~m68k_exc_taken & ~data_exc_taken) = data[31:16];
#else
dmem[eff_addr] when (~m68k_exc_taken & ~data_exc_taken) = data[31:16];
#endif
#ifdef MMU
dmem[ea_pa + 2] when (~m68k_exc_taken & ~data_exc_taken) = data[15:0];
#else
dmem[eff_addr + 2] when (~m68k_exc_taken & ~data_exc_taken) = data[15:0];
#endif

// Update CCR
flag_N when (~m68k_exc_taken & ~data_exc_taken) = data[31];
flag_Z when (~m68k_exc_taken & ~data_exc_taken) = data == 0;
flag_V when (~m68k_exc_taken & ~data_exc_taken) = 1'b0;
flag_C when (~m68k_exc_taken & ~data_exc_taken) = 1'b0;
