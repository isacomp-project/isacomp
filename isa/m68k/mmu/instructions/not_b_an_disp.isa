// SPDX-License-Identifier: BSD-3-Clause
// M68000 NOT.B (d16,An) - Logical complement (one's complement) byte in memory (displacement)
// Opcode: 0100 0110 00101 AAA followed by 16-bit signed displacement

isa_state pc[31:0];
var instr[15:0];
isa_state dregs[31:0][2:0];
isa_state aregs[31:0][2:0];
mem dmem[25:0];
#ifdef MMU
// MMU state (added by MMU preprocessor)
isa_state tc[31:0];
isa_state tt0[31:0];
isa_state tt1[31:0];
isa_state crp[63:0];
isa_state srp[63:0];
isa_state vbr[31:0];
isa_state ssp[31:0];
isa_state usp[31:0];
#endif
isa_state flag_X[0:0];
isa_state flag_N[0:0];
isa_state flag_Z[0:0];
isa_state flag_V[0:0];
isa_state flag_C[0:0];

var addr_reg[2:0];
var mnbda_disp[15:0];
var mnbda_disp_ext[31:0];
var mnbda_addr[31:0];
var mnbda_word[15:0];
var mnbda_src_val[7:0];
var mnbda_result[7:0];
var mnbda_new[15:0];

// Include interrupt and exception handling aspects
aspect m68k_exception.isa gates pc:2, sr:2, ssp:2, aregs:2, dmem:2, flag_C:2, flag_N:2, flag_Z:2, flag_V:2, flag_X:2, usp:2;
aspect m68k_interrupt.isa gates sr;
#ifdef MMU
aspect mmu/atc_translate_instr.isa gates pc, dmem;
#else
var pc_pa[31:0];
pc_pa = pc;
var pc_pa_delta[31:0];
pc_pa_delta = 32'd0;
#endif

// Fetch instruction
instr = dmem[pc_pa];
assume instr[15:8] == 0b01000110;  // NOT opcode
assume instr[7:6] == 0b00;         // Size: byte
assume instr[5:3] == 0b101;        // EA mode: Address Register Indirect with Displacement
pc when (~m68k_exc_taken) = pc + 2;

// Decode
addr_reg = instr[2:0];

// Fetch displacement
mnbda_disp = dmem[pc + pc_pa_delta];
pc when (~m68k_exc_taken) = pc + 2;
mnbda_disp_ext = {{16{mnbda_disp[15]}}, mnbda_disp};

// Calculate effective address
mnbda_addr = aregs[addr_reg] + mnbda_disp_ext;

// MMU translate
#ifdef MMU
var mmu_va[31:0];
mmu_va = mnbda_addr;
var is_write[0:0];
is_write = 1'b1;
aspect mmu/atc_translate_data.isa gates pc:1, sr:1, ssp:1, aregs:1, dmem:1, flag_C:1, flag_N:1, flag_Z:1, flag_V:1, flag_X:1, usp:1;
#endif

// Read from memory (byte lane selection for big-endian)
#ifdef MMU
mnbda_word = dmem[{ea_pa[31:1], 1'b0}];
mnbda_src_val = mnbda_addr[0] ? mnbda_word[7:0] : mnbda_word[15:8];
#else
mnbda_word = dmem[{mnbda_addr[31:1], 1'b0}];
mnbda_src_val = mnbda_addr[0] ? mnbda_word[7:0] : mnbda_word[15:8];
#endif

// Execute: invert all bits
mnbda_result = ~mnbda_src_val;

// Write result back to memory (read-modify-write for correct byte lane)
#ifdef MMU
mnbda_new = mnbda_addr[0] ? {mnbda_word[15:8], mnbda_result} : {mnbda_result, mnbda_word[7:0]};
dmem[{ea_pa[31:1], 1'b0}] when (~m68k_exc_taken & ~data_exc_taken) = mnbda_new;
#else
mnbda_new = mnbda_addr[0] ? {mnbda_word[15:8], mnbda_result} : {mnbda_result, mnbda_word[7:0]};
dmem[{mnbda_addr[31:1], 1'b0}] when (~m68k_exc_taken & ~data_exc_taken) = mnbda_new;
#endif

// Update CCR (X not affected)
flag_N when (~m68k_exc_taken & ~data_exc_taken) = mnbda_result[7];
flag_Z when (~m68k_exc_taken & ~data_exc_taken) = mnbda_result == 0;
flag_V when (~m68k_exc_taken & ~data_exc_taken) = 1'b0;
flag_C when (~m68k_exc_taken & ~data_exc_taken) = 1'b0;
