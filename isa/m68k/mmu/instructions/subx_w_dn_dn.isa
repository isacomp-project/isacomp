// SPDX-License-Identifier: BSD-3-Clause
// M68000 SUBX.W Dx,Dy - Subtract Extended Word (with X flag)
// Opcode: 1001 yyy 1 01 00 0 xxx where yyy=Dy (dest), xxx=Dx (src)
// Operation: Dy - Dx - X -> Dy (word only, preserves upper bits)
// Special: Z flag is only cleared if result is non-zero (not set if zero)

isa_state pc[31:0];
var instr[15:0];
isa_state dregs[31:0][2:0];
isa_state aregs[31:0][2:0];
mem dmem[25:0];
isa_state flag_X[0:0];
isa_state flag_N[0:0];
isa_state flag_Z[0:0];
isa_state flag_V[0:0];
isa_state flag_C[0:0];

// Word sub-registers using 'of' keyword
isa_state dregs_subxw[15:0][2:0] of dregs[0b***][15:0];

var subxw_src_reg[2:0];
var subxw_dst_reg[2:0];
var subxw_src_val[15:0];
var subxw_dst_val[15:0];
var subxw_x_val[0:0];
var subxw_result[16:0];
var subxw_old_z[0:0];

// Include interrupt and exception handling aspects
aspect m68k_exception.isa gates pc:2, sr:2, ssp:2, aregs:2, dmem:2, flag_C:2, flag_N:2, flag_Z:2, flag_V:2, flag_X:2, usp:2;
aspect m68k_interrupt.isa gates sr;
#ifdef MMU
aspect mmu/atc_translate_instr.isa gates pc, dmem;
#else
var pc_pa[31:0];
pc_pa = pc;
var pc_pa_delta[31:0];
pc_pa_delta = 32'd0;
#endif

// Fetch instruction
instr = dmem[pc_pa];
assume instr[15:12] == 0b1001;  // SUBX opcode
assume instr[8] == 1;            // SUBX identifier
assume instr[7:6] == 0b01;       // Size: word
assume instr[5:4] == 0b00;       // SUBX pattern
assume instr[3] == 0;            // Register mode (R/M bit)
pc when (~m68k_exc_taken) = pc + 2;

// Decode
subxw_dst_reg = instr[11:9];
subxw_src_reg = instr[2:0];

// Execute: Dy - Dx - X -> Dy (word)
subxw_src_val = dregs_subxw[subxw_src_reg];
subxw_dst_val = dregs_subxw[subxw_dst_reg];
subxw_x_val = flag_X;
subxw_old_z = flag_Z;

// Perform subtraction with extend
subxw_result = subxw_dst_val - subxw_src_val - subxw_x_val;

// Write result (word only, upper bits preserved via 'of')
dregs_subxw[subxw_dst_reg] when (~m68k_exc_taken) = subxw_result[15:0];

// Update CCR
// X and C are set if borrow occurred
flag_X when (~m68k_exc_taken) = (subxw_src_val + subxw_x_val) > subxw_dst_val;
flag_C when (~m68k_exc_taken) = (subxw_src_val + subxw_x_val) > subxw_dst_val;

// V flag: overflow when operands have opposite signs and result differs from destination
flag_V when (~m68k_exc_taken) = (~subxw_dst_val[15] & subxw_src_val[15] & subxw_result[15]) | (subxw_dst_val[15] & ~subxw_src_val[15] & ~subxw_result[15]);

// N flag: set from result MSB
flag_N when (~m68k_exc_taken) = subxw_result[15];

// Z flag: special handling - only cleared if result is non-zero, never set
flag_Z when (~m68k_exc_taken) = subxw_old_z & (subxw_result[15:0] == 0);
