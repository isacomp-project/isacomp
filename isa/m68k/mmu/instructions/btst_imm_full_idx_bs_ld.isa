// SPDX-License-Identifier: BSD-3-Clause
// MC68020 BTST #bit,(bd32,Xn) - Test bit at full indexed address (BS=1, BD=long)
// Full ext: BS=1 (base suppressed), IS=0 (index used), BD=long (32-bit), I/IS=0000
// EA = Xn * scale + bd32
// Opcode: 0000 1000 00 110 AAA followed by immediate bit number, then full ext, then bd32

isa_state pc[31:0];
var instr[15:0];
isa_state dregs[31:0][2:0];
isa_state aregs[31:0][2:0];
mem dmem[25:0];
#ifdef MMU
isa_state tc[31:0];
isa_state tt0[31:0];
isa_state tt1[31:0];
isa_state crp[63:0];
isa_state srp[63:0];
isa_state vbr[31:0];
isa_state ssp[31:0];
isa_state usp[31:0];
#endif
isa_state flag_X[0:0];
isa_state flag_N[0:0];
isa_state flag_Z[0:0];
isa_state flag_V[0:0];
isa_state flag_C[0:0];

var btfl_bit_num[15:0];
var btfl_ext[15:0];
var idx_reg[2:0];
var idx_is_addr[0:0];
var idx_is_long[0:0];
var scale[1:0];
var raw_idx[31:0];
var idx_val[31:0];
var scaled_idx[31:0];
var bd_hi[15:0];
var bd_lo[15:0];
var bd32[31:0];
var btfl_addr[31:0];
var btfl_word[15:0];
var btfl_byte[7:0];
var btfl_bit_pos[2:0];
var btfl_bit_val[0:0];

// Include interrupt and exception handling aspects
aspect m68k_exception.isa gates pc:2, sr:2, ssp:2, aregs:2, dmem:2, flag_C:2, flag_N:2, flag_Z:2, flag_V:2, flag_X:2, usp:2;
aspect m68k_interrupt.isa gates sr;
#ifdef MMU
aspect mmu/atc_translate_instr.isa gates pc, dmem;
#else
var pc_pa[31:0];
pc_pa = pc;
var pc_pa_delta[31:0];
pc_pa_delta = 32'd0;
#endif

// Fetch instruction
instr = dmem[pc_pa];
assume instr[15:6] == 0b0000100000;  // BTST immediate opcode
assume instr[5:3] == 0b110;          // EA mode: indexed
pc when (~m68k_exc_taken) = pc + 2;

// Fetch immediate (bit number)
btfl_bit_num = dmem[pc + pc_pa_delta];
pc when (~m68k_exc_taken) = pc + 2;

// Fetch full extension word
btfl_ext = dmem[pc + pc_pa_delta];
assume btfl_ext[8] == 0b1;       // Full format
assume btfl_ext[7] == 0b1;       // Base suppressed (BS=1)
assume btfl_ext[6] == 0b0;       // Index NOT suppressed (IS=0)
assume btfl_ext[5:4] == 0b11;    // BD size = long (32-bit)
assume btfl_ext[3:0] == 0b0000;  // No memory indirect
pc when (~m68k_exc_taken) = pc + 2;

// Decode index register and scale
idx_reg = btfl_ext[14:12];
idx_is_addr = btfl_ext[15];
idx_is_long = btfl_ext[11];
scale = btfl_ext[10:9];

// Get index value
raw_idx = idx_is_addr ? aregs[idx_reg] : dregs[idx_reg];
idx_val = idx_is_long ? raw_idx : {{16{raw_idx[15]}}, raw_idx[15:0]};

// Scale index
scaled_idx = scale == 2'b00 ? idx_val :
             scale == 2'b01 ? (idx_val << 1) :
             scale == 2'b10 ? (idx_val << 2) :
                              (idx_val << 3);

// Fetch 32-bit base displacement
bd_hi = dmem[pc + pc_pa_delta];
pc when (~m68k_exc_taken) = pc + 2;
bd_lo = dmem[pc + pc_pa_delta];
pc when (~m68k_exc_taken) = pc + 2;
bd32 = {bd_hi, bd_lo};

// Calculate address (base suppressed, so just Xn*scale + bd32)
btfl_addr = scaled_idx + bd32;

// Read byte from memory (with MMU translation)
#ifdef MMU
var mmu_va[31:0];
mmu_va = {btfl_addr[31:1], 1'b0};
var is_write[0:0];
is_write = 1'b0;
aspect mmu/atc_translate_data.isa gates pc:1, sr:1, ssp:1, aregs:1, dmem:1, flag_C:1, flag_N:1, flag_Z:1, flag_V:1, flag_X:1, usp:1;
#endif

#ifdef MMU
btfl_word = dmem[ea_pa];
#else
btfl_word = dmem[{btfl_addr[31:1], 1'b0}];
#endif
btfl_byte = btfl_addr[0] ? btfl_word[7:0] : btfl_word[15:8];

// Test specific bit (modulo 8 for byte)
btfl_bit_pos = btfl_bit_num[2:0];
btfl_bit_val = (btfl_byte >> btfl_bit_pos) & 1;

// Update Z flag only (set if tested bit is zero)
flag_Z when (~m68k_exc_taken & ~data_exc_taken) = ~btfl_bit_val;

// BTST does not affect N, V, C, X flags
