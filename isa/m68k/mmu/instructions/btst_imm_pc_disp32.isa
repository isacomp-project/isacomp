// SPDX-License-Identifier: BSD-3-Clause
// MC68020 BTST #bit,(bd32,PC) - Test bit in memory with PC-relative 32-bit displacement
// Opcode: 0000 1000 00 111 011 followed by bit number, extension word, and 32-bit displacement
// Full extension word format with index suppressed
// Tests bit specified by immediate in memory, sets Z flag accordingly
//
// NOTE: Cannot use assume statements on ext_word bits because ext_word is
// fetched after instruction decode. The enable signal is generated at decode
// time before ext_word is available.

isa_state pc[31:0];
var instr[15:0];
isa_state dregs[31:0][2:0];
isa_state aregs[31:0][2:0];
mem dmem[25:0];
#ifdef MMU
// MMU state (added by MMU preprocessor)
isa_state tc[31:0];
isa_state tt0[31:0];
isa_state tt1[31:0];
isa_state crp[63:0];
isa_state srp[63:0];
isa_state vbr[31:0];
isa_state ssp[31:0];
isa_state usp[31:0];
#endif
isa_state flag_X[0:0];
isa_state flag_N[0:0];
isa_state flag_Z[0:0];
isa_state flag_V[0:0];
isa_state flag_C[0:0];

var bit_num[15:0];
var btst_d32_ext[15:0];
var disp_hi[15:0];
var disp_lo[15:0];
var disp32[31:0];
var base_pc[31:0];
var eff_addr[31:0];
var mem_word[15:0];
var byte_val[7:0];
var bit_pos[2:0];
var bit_val[0:0];

// Include interrupt and exception handling aspects
aspect m68k_exception.isa gates pc:2, sr:2, ssp:2, aregs:2, dmem:2, flag_C:2, flag_N:2, flag_Z:2, flag_V:2, flag_X:2, usp:2;
aspect m68k_interrupt.isa gates sr;
#ifdef MMU
aspect mmu/atc_translate_instr.isa gates pc, dmem;
#else
var pc_pa[31:0];
pc_pa = pc;
var pc_pa_delta[31:0];
pc_pa_delta = 32'd0;
#endif

// Fetch instruction
instr = dmem[pc_pa];
assume instr[15:6] == 0b0000100000;  // BTST immediate opcode
assume instr[5:3] == 0b111;          // EA mode: Mode 7 (PC-relative)
assume instr[2:0] == 0b011;          // EA reg: 3 (full extension)
pc when (~m68k_exc_taken) = pc + 2;

// Fetch bit number
bit_num = dmem[pc + pc_pa_delta];
pc when (~m68k_exc_taken) = pc + 2;

// PC for address calculation is address of extension word
base_pc = pc;

// Fetch extension word (unique name - read at PC+4 due to bit number word)
btst_d32_ext = dmem[pc + pc_pa_delta];
assume btst_d32_ext[8] == 0b1;      // Full format indicator
assume btst_d32_ext[5:4] == 0b11;   // BD size = long (32-bit displacement)
pc when (~m68k_exc_taken) = pc + 2;

// Fetch 32-bit displacement (high word first)
disp_hi = dmem[pc + pc_pa_delta];
pc when (~m68k_exc_taken) = pc + 2;
disp_lo = dmem[pc + pc_pa_delta];
pc when (~m68k_exc_taken) = pc + 2;
disp32 = {disp_hi, disp_lo};

// Calculate effective address: PC + displacement
eff_addr = base_pc + disp32;

// Read byte from memory (byte operations use modulo 8)
#ifdef MMU
var mmu_va[31:0];
mmu_va = eff_addr;
var is_write[0:0];
is_write = 1'b0;
aspect mmu/atc_translate_data.isa gates pc:1, sr:1, ssp:1, aregs:1, dmem:1, flag_C:1, flag_N:1, flag_Z:1, flag_V:1, flag_X:1, usp:1;
#endif

#ifdef MMU
mem_word = dmem[{ea_pa[31:1], 1'b0}];
#else
mem_word = dmem[{eff_addr[31:1], 1'b0}];
#endif
byte_val = eff_addr[0] ? mem_word[7:0] : mem_word[15:8];

// Test bit (modulo 8 for byte operations)
bit_pos = bit_num[2:0];
bit_val = (byte_val >> bit_pos) & 1;

// Update Z flag (set if bit is zero)
flag_Z when (~m68k_exc_taken & ~data_exc_taken) = ~bit_val;

// Other flags not affected
