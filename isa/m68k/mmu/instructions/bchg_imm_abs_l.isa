// SPDX-License-Identifier: BSD-3-Clause
// M68000 BCHG #bit,(abs).L - Test and change bit in memory at absolute long address
// Opcode: 0000 1000 01 111 001 followed by 16-bit bit number, then 32-bit address

isa_state pc[31:0];
var instr[15:0];
isa_state dregs[31:0][2:0];
isa_state aregs[31:0][2:0];
mem dmem[25:0];
#ifdef MMU
// MMU state (added by MMU preprocessor)
isa_state tc[31:0];
isa_state tt0[31:0];
isa_state tt1[31:0];
isa_state crp[63:0];
isa_state srp[63:0];
isa_state vbr[31:0];
isa_state ssp[31:0];
isa_state usp[31:0];
#endif
isa_state flag_X[0:0];
isa_state flag_N[0:0];
isa_state flag_Z[0:0];
isa_state flag_V[0:0];
isa_state flag_C[0:0];

var bit_num[15:0];
var addr_hi[15:0];
var addr_lo[15:0];
var byte_addr[31:0];
var bit_pos[2:0];
var dst_word[15:0];
var dst_byte[7:0];
var bit_val[0:0];
var mask[7:0];
var new_byte[7:0];
var new_word[15:0];

// Include interrupt and exception handling aspects
aspect m68k_exception.isa gates pc:2, sr:2, ssp:2, aregs:2, dmem:2, flag_C:2, flag_N:2, flag_Z:2, flag_V:2, flag_X:2, usp:2;
aspect m68k_interrupt.isa gates sr;
#ifdef MMU
aspect mmu/atc_translate_instr.isa gates pc, dmem;
#else
var pc_pa[31:0];
pc_pa = pc;
var pc_pa_delta[31:0];
pc_pa_delta = 32'd0;
#endif

// Fetch instruction
instr = dmem[pc_pa];
assume instr[15:6] == 0b0000100001;  // BCHG immediate
assume instr[5:3] == 0b111;          // EA mode: special
assume instr[2:0] == 0b001;          // Absolute long
pc when (~m68k_exc_taken) = pc + 2;

// Fetch bit number
bit_num = dmem[pc + pc_pa_delta];
pc when (~m68k_exc_taken) = pc + 2;

// Fetch 32-bit address
addr_hi = dmem[pc + pc_pa_delta];
pc when (~m68k_exc_taken) = pc + 2;
addr_lo = dmem[pc + pc_pa_delta];
pc when (~m68k_exc_taken) = pc + 2;
byte_addr = {addr_hi, addr_lo};

// Bit position modulo 8
bit_pos = bit_num[2:0];

// Read-modify-write byte
#ifdef MMU
var mmu_va[31:0];
mmu_va = byte_addr;
var is_write[0:0];
is_write = 1'b1;
aspect mmu/atc_translate_data.isa gates pc:1, sr:1, ssp:1, aregs:1, dmem:1, flag_C:1, flag_N:1, flag_Z:1, flag_V:1, flag_X:1, usp:1;
#endif

#ifdef MMU
dst_word = dmem[{ea_pa[31:1], 1'b0}];
#else
dst_word = dmem[{byte_addr[31:1], 1'b0}];
#endif
dst_byte = byte_addr[0] ? dst_word[7:0] : dst_word[15:8];

bit_val = (dst_byte >> bit_pos) & 1;
flag_Z when (~m68k_exc_taken & ~data_exc_taken) = ~bit_val;

// Toggle the bit using XOR
mask = 1 << bit_pos;
new_byte = dst_byte ^ mask;

new_word = byte_addr[0] ? {dst_word[15:8], new_byte} : {new_byte, dst_word[7:0]};
#ifdef MMU
dmem[{ea_pa[31:1], 1'b0}] when (~m68k_exc_taken & ~data_exc_taken) = new_word;
#else
dmem[{byte_addr[31:1], 1'b0}] when (~m68k_exc_taken & ~data_exc_taken) = new_word;
#endif
