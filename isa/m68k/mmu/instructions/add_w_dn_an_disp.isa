// SPDX-License-Identifier: BSD-3-Clause
// M68000 ADD.W Dn,(d16,An) - Add data register to word in memory with displacement
// Opcode: 1101 DDD1 01 101 AAA + d16 where DDD=data reg, AAA=addr reg
// Opmode 101 = ADD.W Dn,EA (direction: Dn to EA)

isa_state pc[31:0];
var instr[15:0];
var awda_disp16[15:0];
isa_state dregs[31:0][2:0];
isa_state aregs[31:0][2:0];
mem dmem[25:0];
#ifdef MMU
// MMU state (added by MMU preprocessor)
isa_state tc[31:0];
isa_state tt0[31:0];
isa_state tt1[31:0];
isa_state crp[63:0];
isa_state srp[63:0];
isa_state vbr[31:0];
isa_state ssp[31:0];
isa_state usp[31:0];
#endif
isa_state flag_X[0:0];
isa_state flag_N[0:0];
isa_state flag_Z[0:0];
isa_state flag_V[0:0];
isa_state flag_C[0:0];

var src_reg[2:0];
var addr_reg[2:0];
var awda_signed_disp[31:0];
var awda_eff_addr[31:0];
var awda_src_val[15:0];
var awda_dst_val[15:0];
var awda_result[16:0];

aspect m68k_exception.isa gates pc:2, sr:2, ssp:2, aregs:2, dmem:2, flag_C:2, flag_N:2, flag_Z:2, flag_V:2, flag_X:2, usp:2;
aspect m68k_interrupt.isa gates sr;
#ifdef MMU
aspect mmu/atc_translate_instr.isa gates pc, dmem;
#else
var pc_pa[31:0];
pc_pa = pc;
var pc_pa_delta[31:0];
pc_pa_delta = 32'd0;
#endif

instr = dmem[pc_pa];
assume instr[15:12] == 0b1101;
assume instr[8:6] == 0b101;     // Opmode: ADD.W Dn,EA
assume instr[5:3] == 0b101;     // EA mode: (d16,An)
pc when (~m68k_exc_taken) = pc + 2;

awda_disp16 = dmem[pc + pc_pa_delta];
pc when (~m68k_exc_taken) = pc + 2;

src_reg = instr[11:9];
addr_reg = instr[2:0];

awda_signed_disp = {{16{awda_disp16[15]}}, awda_disp16};
awda_eff_addr = aregs[addr_reg] + awda_signed_disp;

#ifdef MMU
var mmu_va[31:0];
mmu_va = awda_eff_addr;
var is_write[0:0];
is_write = 1'b1;
aspect mmu/atc_translate_data.isa gates pc:1, sr:1, ssp:1, aregs:1, dmem:1, flag_C:1, flag_N:1, flag_Z:1, flag_V:1, flag_X:1, usp:1;
#endif

#ifdef MMU
awda_dst_val = dmem[ea_pa];
#else
awda_dst_val = dmem[awda_eff_addr];
#endif
awda_src_val = dregs[src_reg][15:0];

awda_result = awda_dst_val + awda_src_val;
#ifdef MMU
dmem[ea_pa] when (~m68k_exc_taken & ~data_exc_taken) = awda_result[15:0];
#else
dmem[awda_eff_addr] when (~m68k_exc_taken & ~data_exc_taken) = awda_result[15:0];
#endif

flag_X when (~m68k_exc_taken & ~data_exc_taken) = awda_result[16];
flag_C when (~m68k_exc_taken & ~data_exc_taken) = awda_result[16];
flag_V when (~m68k_exc_taken & ~data_exc_taken) = (~awda_dst_val[15] & ~awda_src_val[15] & awda_result[15]) | (awda_dst_val[15] & awda_src_val[15] & ~awda_result[15]);
flag_Z when (~m68k_exc_taken & ~data_exc_taken) = awda_result[15:0] == 0;
flag_N when (~m68k_exc_taken & ~data_exc_taken) = awda_result[15];
