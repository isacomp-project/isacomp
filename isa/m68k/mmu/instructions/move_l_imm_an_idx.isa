// SPDX-License-Identifier: BSD-3-Clause
// MC68020 MOVE.L #imm,(d8,An,Xn) - Move long immediate to indexed indirect
// Opcode: 0010 AAA1 10111 100 followed by 32-bit immediate, then brief extension word
// Source extensions (immediate) come BEFORE destination extensions (brief ext)

isa_state pc[31:0];
var instr[15:0];
isa_state dregs[31:0][2:0];
isa_state aregs[31:0][2:0];
mem dmem[25:0];
#ifdef MMU
// MMU state (added by MMU preprocessor)
isa_state tc[31:0];
isa_state tt0[31:0];
isa_state tt1[31:0];
isa_state crp[63:0];
isa_state srp[63:0];
isa_state vbr[31:0];
isa_state ssp[31:0];
isa_state usp[31:0];
#endif
isa_state flag_X[0:0];
isa_state flag_N[0:0];
isa_state flag_Z[0:0];
isa_state flag_V[0:0];
isa_state flag_C[0:0];

var dst_reg[2:0];
var imm_hi[15:0];
var imm_lo[15:0];
var imm_val[31:0];
var mlbi_ext[15:0];
var disp8[7:0];
var disp8_ext[31:0];
var idx_reg[2:0];
var idx_is_addr[0:0];
var idx_is_long[0:0];
var scale[1:0];
var raw_idx[31:0];
var idx_val[31:0];
var scaled_idx[31:0];
var dst_addr[31:0];

// Include interrupt and exception handling aspects
aspect m68k_exception.isa gates pc:2, sr:2, ssp:2, aregs:2, dmem:2, flag_C:2, flag_N:2, flag_Z:2, flag_V:2, flag_X:2, usp:2;
aspect m68k_interrupt.isa gates sr;
#ifdef MMU
aspect mmu/atc_translate_instr.isa gates pc, dmem;
#else
var pc_pa[31:0];
pc_pa = pc;
var pc_pa_delta[31:0];
pc_pa_delta = 32'd0;
#endif

// Fetch instruction
instr = dmem[pc_pa];
assume instr[15:12] == 0b0010;  // MOVE.L
assume instr[8:6] == 0b110;     // Dest mode: (d8,An,Xn)
assume instr[5:3] == 0b111;     // Source mode: special
assume instr[2:0] == 0b100;     // Source reg: #imm
pc when (~m68k_exc_taken) = pc + 2;

dst_reg = instr[11:9];

// Fetch 32-bit immediate (source extension words come first)
imm_hi = dmem[pc + pc_pa_delta];
pc when (~m68k_exc_taken) = pc + 2;
imm_lo = dmem[pc + pc_pa_delta];
pc when (~m68k_exc_taken) = pc + 2;
imm_val = {imm_hi, imm_lo};

// Fetch brief extension word (destination)
mlbi_ext = dmem[pc + pc_pa_delta];
assume mlbi_ext[8] == 0b0;  // Brief format
pc when (~m68k_exc_taken) = pc + 2;

// Decode extension word
idx_reg = mlbi_ext[14:12];
idx_is_addr = mlbi_ext[15];
idx_is_long = mlbi_ext[11];
scale = mlbi_ext[10:9];
disp8 = mlbi_ext[7:0];
disp8_ext = disp8[7] ? {24'hFFFFFF, disp8} : {24'h000000, disp8};

// Get index value
raw_idx = idx_is_addr ? aregs[idx_reg] : dregs[idx_reg];
idx_val = idx_is_long ? raw_idx : (raw_idx[15] ? {16'hFFFF, raw_idx[15:0]} : {16'h0000, raw_idx[15:0]});

// Scale index
scaled_idx = scale == 2'b00 ? idx_val :
             scale == 2'b01 ? (idx_val << 1) :
             scale == 2'b10 ? (idx_val << 2) :
                              (idx_val << 3);

// Calculate destination address
dst_addr = aregs[dst_reg] + disp8_ext + scaled_idx;

// Write to memory (32-bit, big-endian)
#ifdef MMU
var mmu_va[31:0];
mmu_va = dst_addr;
var is_write[0:0];
is_write = 1'b1;
aspect mmu/atc_translate_data.isa gates pc:1, sr:1, ssp:1, aregs:1, dmem:1, flag_C:1, flag_N:1, flag_Z:1, flag_V:1, flag_X:1, usp:1;
#endif

#ifdef MMU
dmem[ea_pa] when (~m68k_exc_taken & ~data_exc_taken) = imm_val[31:16];
#else
dmem[dst_addr] when (~m68k_exc_taken & ~data_exc_taken) = imm_val[31:16];
#endif
#ifdef MMU
dmem[ea_pa + 2] when (~m68k_exc_taken & ~data_exc_taken) = imm_val[15:0];
#else
dmem[dst_addr + 2] when (~m68k_exc_taken & ~data_exc_taken) = imm_val[15:0];
#endif

// Update CCR
flag_N when (~m68k_exc_taken & ~data_exc_taken) = imm_val[31];
flag_Z when (~m68k_exc_taken & ~data_exc_taken) = imm_val == 0;
flag_V when (~m68k_exc_taken & ~data_exc_taken) = 1'b0;
flag_C when (~m68k_exc_taken & ~data_exc_taken) = 1'b0;
