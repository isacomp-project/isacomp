// SPDX-License-Identifier: BSD-3-Clause
// M68000 BTST #bit,(d8,PC,Xn) - Test bit in PC-relative indexed memory
// Opcode: 0000 1000 00 111 011 followed by immediate word, then brief extension word
// For memory operands, bit number is modulo 8 (byte operation)

isa_state pc[31:0];
var instr[15:0];
isa_state dregs[31:0][2:0];
isa_state aregs[31:0][2:0];
mem dmem[25:0];
#ifdef MMU
// MMU state (added by MMU preprocessor)
isa_state tc[31:0];
isa_state tt0[31:0];
isa_state tt1[31:0];
isa_state crp[63:0];
isa_state srp[63:0];
isa_state vbr[31:0];
isa_state ssp[31:0];
isa_state usp[31:0];
#endif
isa_state flag_X[0:0];
isa_state flag_N[0:0];
isa_state flag_Z[0:0];
isa_state flag_V[0:0];
isa_state flag_C[0:0];

var bit_num[15:0];
var brief_ext[15:0];
var idx_is_areg[0:0];
var idx_reg[2:0];
var idx_is_long[0:0];
var scale[1:0];
var disp8[7:0];
var disp_ext[31:0];
var idx_raw[31:0];
var idx_val[31:0];
var scaled_idx[31:0];
var base_pc[31:0];
var eff_addr[31:0];
var data[15:0];
var byte_val[7:0];
var bit_pos[2:0];
var bit_val[0:0];

// Include interrupt and exception handling aspects
aspect m68k_exception.isa gates pc:2, sr:2, ssp:2, aregs:2, dmem:2, flag_C:2, flag_N:2, flag_Z:2, flag_V:2, flag_X:2, usp:2;
aspect m68k_interrupt.isa gates sr;
#ifdef MMU
aspect mmu/atc_translate_instr.isa gates pc, dmem;
#else
var pc_pa[31:0];
pc_pa = pc;
var pc_pa_delta[31:0];
pc_pa_delta = 32'd0;
#endif

// Fetch instruction
instr = dmem[pc_pa];
assume instr[15:6] == 0b0000100000;  // BTST immediate opcode
assume instr[5:3] == 0b111;          // EA mode: Mode 7
assume instr[2:0] == 0b011;          // EA reg: PC-relative with index
pc when (~m68k_exc_taken) = pc + 2;

// Fetch immediate (bit number)
bit_num = dmem[pc + pc_pa_delta];
pc when (~m68k_exc_taken) = pc + 2;

// PC for address calculation is address of extension word
base_pc = pc;

// Fetch brief extension word
brief_ext = dmem[pc + pc_pa_delta];
assume brief_ext[8] == 0b0;  // Brief format
pc when (~m68k_exc_taken) = pc + 2;

// Decode extension word
idx_is_areg = brief_ext[15];
idx_reg = brief_ext[14:12];
idx_is_long = brief_ext[11];
scale = brief_ext[10:9];
disp8 = brief_ext[7:0];

// Sign-extend displacement
disp_ext = {{24{disp8[7]}}, disp8};

// Get index value
idx_raw = idx_is_areg ? aregs[idx_reg] : dregs[idx_reg];
idx_val = idx_is_long ? idx_raw : (idx_raw[15] ? {16'hFFFF, idx_raw[15:0]} : {16'h0000, idx_raw[15:0]});

// Apply scale factor
scaled_idx = scale == 0 ? idx_val :
             scale == 1 ? (idx_val << 1) :
             scale == 2 ? (idx_val << 2) :
                          (idx_val << 3);

// Calculate effective address: PC + disp8 + scaled_index
eff_addr = base_pc + disp_ext + scaled_idx;

// Read byte from memory (upper byte of word at even address)
#ifdef MMU
var mmu_va[31:0];
mmu_va = eff_addr & 32'hFFFFFFFE;
var is_write[0:0];
is_write = 1'b0;
aspect mmu/atc_translate_data.isa gates pc:1, sr:1, ssp:1, aregs:1, dmem:1, flag_C:1, flag_N:1, flag_Z:1, flag_V:1, flag_X:1, usp:1;
#endif

#ifdef MMU
data = dmem[ea_pa];
#else
data = dmem[eff_addr & 32'hFFFFFFFE];
#endif
byte_val = eff_addr[0] ? data[7:0] : data[15:8];

// Test bit (modulo 8 for byte)
bit_pos = bit_num[2:0];
bit_val = (byte_val >> bit_pos) & 1;

// Update Z flag (set if bit is zero)
flag_Z when (~m68k_exc_taken & ~data_exc_taken) = ~bit_val;

// Other flags not affected
