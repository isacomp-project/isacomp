// SPDX-License-Identifier: BSD-3-Clause
// M68000 EOR.B Dn,(d16,An) - Exclusive OR byte data register with memory (displacement)
// Opcode: 1011 SSS1 00101 AAA followed by 16-bit signed displacement
// Operation: (d16,An) XOR Dn -> (d16,An)

isa_state pc[31:0];
var instr[15:0];
isa_state dregs[31:0][2:0];
isa_state aregs[31:0][2:0];
mem dmem[25:0];
#ifdef MMU
// MMU state (added by MMU preprocessor)
isa_state tc[31:0];
isa_state tt0[31:0];
isa_state tt1[31:0];
isa_state crp[63:0];
isa_state srp[63:0];
isa_state vbr[31:0];
isa_state ssp[31:0];
isa_state usp[31:0];
#endif
isa_state flag_X[0:0];
isa_state flag_N[0:0];
isa_state flag_Z[0:0];
isa_state flag_V[0:0];
isa_state flag_C[0:0];

// Byte sub-registers using 'of' keyword
isa_state dregs_b[7:0][2:0] of dregs[0b***][7:0];

var src_reg[2:0];
var addr_reg[2:0];
var mebda_disp[15:0];
var mebda_disp_ext[31:0];
var mebda_addr[31:0];
var mebda_src_val[7:0];
var mebda_dst_val[7:0];
var mebda_result[7:0];
var mebda_word[15:0];
var mebda_new[15:0];

// Include interrupt and exception handling aspects
aspect m68k_exception.isa gates pc:2, sr:2, ssp:2, aregs:2, dmem:2, flag_C:2, flag_N:2, flag_Z:2, flag_V:2, flag_X:2, usp:2;
aspect m68k_interrupt.isa gates sr;
#ifdef MMU
aspect mmu/atc_translate_instr.isa gates pc, dmem;
#else
var pc_pa[31:0];
pc_pa = pc;
var pc_pa_delta[31:0];
pc_pa_delta = 32'd0;
#endif

// Fetch instruction
instr = dmem[pc_pa];
assume instr[15:12] == 0b1011;  // EOR opcode
assume instr[8:6] == 0b100;     // Opmode: byte
assume instr[5:3] == 0b101;     // EA mode: Address Register Indirect with Displacement
pc when (~m68k_exc_taken) = pc + 2;

// Decode
src_reg = instr[11:9];
addr_reg = instr[2:0];

// Read source from Dn (low byte)
mebda_src_val = dregs_b[src_reg];

// Fetch displacement
mebda_disp = dmem[pc + pc_pa_delta];
pc when (~m68k_exc_taken) = pc + 2;
mebda_disp_ext = {{16{mebda_disp[15]}}, mebda_disp};

// Calculate effective address
mebda_addr = aregs[addr_reg] + mebda_disp_ext;

// MMU translate
#ifdef MMU
var mmu_va[31:0];
mmu_va = mebda_addr;
var is_write[0:0];
is_write = 1'b1;
aspect mmu/atc_translate_data.isa gates pc:1, sr:1, ssp:1, aregs:1, dmem:1, flag_C:1, flag_N:1, flag_Z:1, flag_V:1, flag_X:1, usp:1;
#endif

// Read destination from memory (byte lane selection for big-endian)
#ifdef MMU
mebda_word = dmem[{ea_pa[31:1], 1'b0}];
mebda_dst_val = mebda_addr[0] ? mebda_word[7:0] : mebda_word[15:8];
#else
mebda_word = dmem[{mebda_addr[31:1], 1'b0}];
mebda_dst_val = mebda_addr[0] ? mebda_word[7:0] : mebda_word[15:8];
#endif

// Execute
mebda_result = mebda_dst_val ^ mebda_src_val;

// Write result back to memory (read-modify-write for correct byte lane)
#ifdef MMU
mebda_new = mebda_addr[0] ? {mebda_word[15:8], mebda_result} : {mebda_result, mebda_word[7:0]};
dmem[{ea_pa[31:1], 1'b0}] when (~m68k_exc_taken & ~data_exc_taken) = mebda_new;
#else
mebda_new = mebda_addr[0] ? {mebda_word[15:8], mebda_result} : {mebda_result, mebda_word[7:0]};
dmem[{mebda_addr[31:1], 1'b0}] when (~m68k_exc_taken & ~data_exc_taken) = mebda_new;
#endif

// Update CCR (X not affected)
flag_N when (~m68k_exc_taken & ~data_exc_taken) = mebda_result[7];
flag_Z when (~m68k_exc_taken & ~data_exc_taken) = mebda_result == 0;
flag_V when (~m68k_exc_taken & ~data_exc_taken) = 1'b0;
flag_C when (~m68k_exc_taken & ~data_exc_taken) = 1'b0;
