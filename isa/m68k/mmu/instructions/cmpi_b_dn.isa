// SPDX-License-Identifier: BSD-3-Clause
// M68000 CMPI.B #imm,Dn - Compare immediate byte with data register
// Opcode: 0000 1100 00 000 DDD followed by 16-bit word (byte immediate in low byte)
// Compares Dn - #imm, updates flags, discards result

isa_state pc[31:0];
var instr[15:0];
isa_state dregs[31:0][2:0];
isa_state aregs[31:0][2:0];
mem dmem[25:0];
isa_state flag_X[0:0];
isa_state flag_N[0:0];
isa_state flag_Z[0:0];
isa_state flag_V[0:0];
isa_state flag_C[0:0];

// Byte sub-registers
isa_state dregs_b[7:0][2:0] of dregs[0b***][7:0];

var dst_reg[2:0];
var imm_word[15:0];
var imm_val[7:0];
var dst_val[7:0];
var result[8:0];

// Include interrupt and exception handling aspects
aspect m68k_exception.isa gates pc:2, sr:2, ssp:2, aregs:2, dmem:2, flag_C:2, flag_N:2, flag_Z:2, flag_V:2, flag_X:2, usp:2;
aspect m68k_interrupt.isa gates sr;
#ifdef MMU
aspect mmu/atc_translate_instr.isa gates pc, dmem;
#else
var pc_pa[31:0];
pc_pa = pc;
var pc_pa_delta[31:0];
pc_pa_delta = 32'd0;
#endif

// Fetch instruction
instr = dmem[pc_pa];
assume instr[15:8] == 0b00001100;  // CMPI opcode
assume instr[7:6] == 0b00;         // Size: byte
assume instr[5:3] == 0b000;        // EA mode: Data Register Direct
pc when (~m68k_exc_taken) = pc + 2;

// Decode destination register
dst_reg = instr[2:0];

// Fetch immediate value (byte is in low byte of word)
imm_word = dmem[pc + pc_pa_delta];
pc when (~m68k_exc_taken) = pc + 2;
imm_val = imm_word[7:0];

// Execute comparison (subtract but don't store result)
dst_val = dregs_b[dst_reg];
result = dst_val - imm_val;

// Update CCR (X not affected by CMP)
flag_C when (~m68k_exc_taken) = imm_val > dst_val;
flag_V when (~m68k_exc_taken) = (~dst_val[7] & imm_val[7] & result[7]) | (dst_val[7] & ~imm_val[7] & ~result[7]);
flag_Z when (~m68k_exc_taken) = result[7:0] == 0;
flag_N when (~m68k_exc_taken) = result[7];
