// SPDX-License-Identifier: BSD-3-Clause
// M68000 SEQ (d16,An) - Set byte if equal (Z=1) at displacement
// Opcode: 0101 0111 11 101 AAA + 16-bit displacement

isa_state pc[31:0];
var instr[15:0];
isa_state dregs[31:0][2:0];
isa_state aregs[31:0][2:0];
mem dmem[25:0];
#ifdef MMU
// MMU state (added by MMU preprocessor)
isa_state tc[31:0];
isa_state tt0[31:0];
isa_state tt1[31:0];
isa_state crp[63:0];
isa_state srp[63:0];
isa_state vbr[31:0];
isa_state ssp[31:0];
isa_state usp[31:0];
#endif
isa_state flag_X[0:0];
isa_state flag_N[0:0];
isa_state flag_Z[0:0];
isa_state flag_V[0:0];
isa_state flag_C[0:0];

var seqd_reg[2:0];
var seqd_disp[15:0];
var seqd_disp_ext[31:0];
var seqd_addr[31:0];
var seqd_word[15:0];
var seqd_new[15:0];
var seqd_byte[7:0];

aspect m68k_exception.isa gates pc:2, sr:2, ssp:2, aregs:2, dmem:2, flag_C:2, flag_N:2, flag_Z:2, flag_V:2, flag_X:2, usp:2;
aspect m68k_interrupt.isa gates sr;
#ifdef MMU
aspect mmu/atc_translate_instr.isa gates pc, dmem;
#else
var pc_pa[31:0];
pc_pa = pc;
var pc_pa_delta[31:0];
pc_pa_delta = 32'd0;
#endif

instr = dmem[pc_pa];
assume instr[15:12] == 0b0101;
assume instr[11:8] == 0b0111;   // SEQ condition (Z=1)
assume instr[7:6] == 0b11;
assume instr[5:3] == 0b101;     // EA: (d16,An)
pc when (~m68k_exc_taken) = pc + 2;

seqd_reg = instr[2:0];
seqd_disp = dmem[pc + pc_pa_delta];
pc when (~m68k_exc_taken) = pc + 2;
seqd_disp_ext = {{16{seqd_disp[15]}}, seqd_disp};
seqd_addr = aregs[seqd_reg] + seqd_disp_ext;

seqd_byte = flag_Z ? 8'hFF : 8'h00;

// Write byte (read-modify-write)
#ifdef MMU
var mmu_va[31:0];
mmu_va = {seqd_addr[31:1], 1'b0};
var is_write[0:0];
is_write = 1'b0;
aspect mmu/atc_translate_data.isa gates pc:1, sr:1, ssp:1, aregs:1, dmem:1, flag_C:1, flag_N:1, flag_Z:1, flag_V:1, flag_X:1, usp:1;
#endif

#ifdef MMU
seqd_word = dmem[ea_pa];
#else
seqd_word = dmem[{seqd_addr[31:1], 1'b0}];
#endif
seqd_new = seqd_addr[0] ? {seqd_word[15:8], seqd_byte} : {seqd_byte, seqd_word[7:0]};
#ifdef MMU
dmem[ea_pa] when (~m68k_exc_taken & ~data_exc_taken) = seqd_new;
#else
dmem[{seqd_addr[31:1], 1'b0}] when (~m68k_exc_taken & ~data_exc_taken) = seqd_new;
#endif
