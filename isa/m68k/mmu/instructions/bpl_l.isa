// SPDX-License-Identifier: BSD-3-Clause
// MC68020 BPL.L label - Branch if plus (N=0) (32-bit displacement)
// Opcode: 0110 1010 1111 1111 followed by 32-bit signed displacement

isa_state pc[31:0];
var instr[15:0];
isa_state dregs[31:0][2:0];
isa_state aregs[31:0][2:0];
mem dmem[25:0];
isa_state flag_X[0:0];
isa_state flag_N[0:0];
isa_state flag_Z[0:0];
isa_state flag_V[0:0];
isa_state flag_C[0:0];

var bpl_l_disp_hi[15:0];
var bpl_l_disp_lo[15:0];
var bpl_l_disp32[31:0];
var bpl_l_branch_pc[31:0];
var bpl_l_branch_dest[31:0];
var bpl_l_take_branch[0:0];

// Include interrupt and exception handling aspects
aspect m68k_exception.isa gates pc:2, sr:2, ssp:2, aregs:2, dmem:2, flag_C:2, flag_N:2, flag_Z:2, flag_V:2, flag_X:2, usp:2;
aspect m68k_interrupt.isa gates sr;
#ifdef MMU
aspect mmu/atc_translate_instr.isa gates pc, dmem;
#else
var pc_pa[31:0];
pc_pa = pc;
var pc_pa_delta[31:0];
pc_pa_delta = 32'd0;
#endif

// Fetch instruction
instr = dmem[pc_pa];
assume instr == 16'h6AFF;  // BPL.L opcode
bpl_l_branch_pc = pc + 2;
pc when (~m68k_exc_taken) = pc + 2;

// Fetch 32-bit displacement (high word first, then low word)
bpl_l_disp_hi = dmem[pc + pc_pa_delta];
pc when (~m68k_exc_taken) = pc + 2;
bpl_l_disp_lo = dmem[pc + pc_pa_delta];
pc when (~m68k_exc_taken) = pc + 2;
bpl_l_disp32 = {bpl_l_disp_hi, bpl_l_disp_lo};

// Calculate branch destination
bpl_l_branch_dest = bpl_l_branch_pc + bpl_l_disp32;

// Condition: N=0
bpl_l_take_branch = ~flag_N;

// Execute
pc when (~m68k_exc_taken) = bpl_l_take_branch ? bpl_l_branch_dest : pc;

// Branch does not affect flags
