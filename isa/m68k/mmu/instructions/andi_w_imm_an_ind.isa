// SPDX-License-Identifier: BSD-3-Clause
// M68000 ANDI.W #imm,(An) - AND Immediate Word with memory indirect
// Opcode: 0000 0010 01 010 AAA followed by 16-bit immediate
// ANDs immediate with 16-bit memory at (An), writes result back

isa_state pc[31:0];
var instr[15:0];
isa_state dregs[31:0][2:0];
isa_state aregs[31:0][2:0];
mem dmem[25:0];
#ifdef MMU
// MMU state (added by MMU preprocessor)
isa_state tc[31:0];
isa_state tt0[31:0];
isa_state tt1[31:0];
isa_state crp[63:0];
isa_state srp[63:0];
isa_state vbr[31:0];
isa_state ssp[31:0];
isa_state usp[31:0];
#endif
isa_state flag_X[0:0];
isa_state flag_N[0:0];
isa_state flag_Z[0:0];
isa_state flag_V[0:0];
isa_state flag_C[0:0];

var awia_reg[2:0];
var awia_imm[15:0];
var awia_addr[31:0];
var awia_mem[15:0];
var awia_result[15:0];

// Include interrupt and exception handling aspects
aspect m68k_exception.isa gates pc:2, sr:2, ssp:2, aregs:2, dmem:2, flag_C:2, flag_N:2, flag_Z:2, flag_V:2, flag_X:2, usp:2;
aspect m68k_interrupt.isa gates sr;
#ifdef MMU
aspect mmu/atc_translate_instr.isa gates pc, dmem;
#else
var pc_pa[31:0];
pc_pa = pc;
var pc_pa_delta[31:0];
pc_pa_delta = 32'd0;
#endif

// Fetch instruction
instr = dmem[pc_pa];
assume instr[15:8] == 0b00000010;  // ANDI opcode
assume instr[7:6] == 0b01;          // Size: word
assume instr[5:3] == 0b010;         // EA mode: Address Register Indirect
pc when (~m68k_exc_taken) = pc + 2;

// Decode address register
awia_reg = instr[2:0];

// Fetch 16-bit immediate
awia_imm = dmem[pc + pc_pa_delta];
pc when (~m68k_exc_taken) = pc + 2;

// Get effective address
awia_addr = aregs[awia_reg];

// Read 16-bit word from memory
#ifdef MMU
var mmu_va[31:0];
mmu_va = awia_addr;
var is_write[0:0];
is_write = 1'b1;
aspect mmu/atc_translate_data.isa gates pc:1, sr:1, ssp:1, aregs:1, dmem:1, flag_C:1, flag_N:1, flag_Z:1, flag_V:1, flag_X:1, usp:1;
#endif

#ifdef MMU
awia_mem = dmem[ea_pa];
#else
awia_mem = dmem[awia_addr];
#endif

// Execute AND
awia_result = awia_mem & awia_imm;

// Write result back to memory
#ifdef MMU
dmem[ea_pa] when (~m68k_exc_taken & ~data_exc_taken) = awia_result;
#else
dmem[awia_addr] when (~m68k_exc_taken & ~data_exc_taken) = awia_result;
#endif

// Update CCR
flag_N when (~m68k_exc_taken & ~data_exc_taken) = awia_result[15];
flag_Z when (~m68k_exc_taken & ~data_exc_taken) = awia_result == 0;
flag_V when (~m68k_exc_taken & ~data_exc_taken) = 1'b0;
flag_C when (~m68k_exc_taken & ~data_exc_taken) = 1'b0;
// X not affected
