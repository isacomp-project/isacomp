// SPDX-License-Identifier: BSD-3-Clause
// MC68020 BEQ.L label - Branch if equal (Z=1) (32-bit displacement)
// Opcode: 0110 0111 1111 1111 followed by 32-bit signed displacement

isa_state pc[31:0];
var instr[15:0];
isa_state dregs[31:0][2:0];
isa_state aregs[31:0][2:0];
mem dmem[25:0];
isa_state flag_X[0:0];
isa_state flag_N[0:0];
isa_state flag_Z[0:0];
isa_state flag_V[0:0];
isa_state flag_C[0:0];

var beq_l_disp_hi[15:0];
var beq_l_disp_lo[15:0];
var beq_l_disp32[31:0];
var beq_l_branch_pc[31:0];
var beq_l_branch_dest[31:0];
var beq_l_take_branch[0:0];

// Include interrupt and exception handling aspects
aspect m68k_exception.isa gates pc:2, sr:2, ssp:2, aregs:2, dmem:2, flag_C:2, flag_N:2, flag_Z:2, flag_V:2, flag_X:2, usp:2;
aspect m68k_interrupt.isa gates sr;
#ifdef MMU
aspect mmu/atc_translate_instr.isa gates pc, dmem;
#else
var pc_pa[31:0];
pc_pa = pc;
var pc_pa_delta[31:0];
pc_pa_delta = 32'd0;
#endif

// Fetch instruction
instr = dmem[pc_pa];
assume instr == 16'h67FF;  // BEQ.L opcode
beq_l_branch_pc = pc + 2;
pc when (~m68k_exc_taken) = pc + 2;

// Fetch 32-bit displacement (high word first, then low word)
beq_l_disp_hi = dmem[pc + pc_pa_delta];
pc when (~m68k_exc_taken) = pc + 2;
beq_l_disp_lo = dmem[pc + pc_pa_delta];
pc when (~m68k_exc_taken) = pc + 2;
beq_l_disp32 = {beq_l_disp_hi, beq_l_disp_lo};

// Calculate branch destination
beq_l_branch_dest = beq_l_branch_pc + beq_l_disp32;

// Condition: Z=1
beq_l_take_branch = flag_Z;

// Execute
pc when (~m68k_exc_taken) = beq_l_take_branch ? beq_l_branch_dest : pc;

// Branch does not affect flags
