// SPDX-License-Identifier: BSD-3-Clause
// M68000 ADDQ.B #data,(xxx).L - Add Quick Byte to Absolute Long Address
// Opcode: 0101 iii0 00 111 001 followed by 32-bit address
// iii = data (0 means 8)

isa_state pc[31:0];
var instr[15:0];
isa_state dregs[31:0][2:0];
isa_state aregs[31:0][2:0];
mem dmem[25:0];
#ifdef MMU
// MMU state (added by MMU preprocessor)
isa_state tc[31:0];
isa_state tt0[31:0];
isa_state tt1[31:0];
isa_state crp[63:0];
isa_state srp[63:0];
isa_state vbr[31:0];
isa_state ssp[31:0];
isa_state usp[31:0];
#endif
isa_state flag_X[0:0];
isa_state flag_N[0:0];
isa_state flag_Z[0:0];
isa_state flag_V[0:0];
isa_state flag_C[0:0];

var imm_field[2:0];
var imm_val[7:0];
var addr_hi[15:0];
var addr_lo[15:0];
var abs_addr[31:0];
var mem_word[15:0];
var dst_byte[7:0];
var result[8:0];

// Include interrupt and exception handling aspects
aspect m68k_exception.isa gates pc:2, sr:2, ssp:2, aregs:2, dmem:2, flag_C:2, flag_N:2, flag_Z:2, flag_V:2, flag_X:2, usp:2;
aspect m68k_interrupt.isa gates sr;
#ifdef MMU
aspect mmu/atc_translate_instr.isa gates pc, dmem;
#else
var pc_pa[31:0];
pc_pa = pc;
var pc_pa_delta[31:0];
pc_pa_delta = 32'd0;
#endif

// Fetch instruction
instr = dmem[pc_pa];
assume instr[15:12] == 0b0101;  // ADDQ/SUBQ
assume instr[8] == 0b0;         // ADDQ
assume instr[7:6] == 0b00;      // Byte size
assume instr[5:3] == 0b111;     // EA: Special
assume instr[2:0] == 0b001;     // Absolute long
pc when (~m68k_exc_taken) = pc + 2;

imm_field = instr[11:9];
imm_val = imm_field == 0 ? 8'h08 : {5'b0, imm_field};

// Fetch 32-bit absolute address
addr_hi = dmem[pc + pc_pa_delta];
pc when (~m68k_exc_taken) = pc + 2;
addr_lo = dmem[pc + pc_pa_delta];
pc when (~m68k_exc_taken) = pc + 2;
abs_addr = {addr_hi, addr_lo};

// Read byte from memory (16-bit dmem, byte in upper or lower half)
#ifdef MMU
var mmu_va[31:0];
mmu_va = {abs_addr[31:1], 1'b0};
var is_write[0:0];
is_write = 1'b0;
aspect mmu/atc_translate_data.isa gates pc:1, sr:1, ssp:1, aregs:1, dmem:1, flag_C:1, flag_N:1, flag_Z:1, flag_V:1, flag_X:1, usp:1;
#endif

#ifdef MMU
mem_word = dmem[ea_pa];
#else
mem_word = dmem[{abs_addr[31:1], 1'b0}];
#endif
dst_byte = abs_addr[0] ? mem_word[7:0] : mem_word[15:8];

// Execute byte add
result = dst_byte + imm_val;

// Write result byte back (preserve other byte in word)
#ifdef MMU
dmem[ea_pa] when (~m68k_exc_taken & ~data_exc_taken) = abs_addr[0] ? {mem_word[15:8], result[7:0]} : {result[7:0], mem_word[7:0]};
#else
dmem[{abs_addr[31:1], 1'b0}] when (~m68k_exc_taken & ~data_exc_taken) = abs_addr[0] ? {mem_word[15:8], result[7:0]} : {result[7:0], mem_word[7:0]};
#endif

// Update CCR
flag_X when (~m68k_exc_taken & ~data_exc_taken) = result[8];
flag_C when (~m68k_exc_taken & ~data_exc_taken) = result[8];
flag_V when (~m68k_exc_taken & ~data_exc_taken) = (~dst_byte[7] & ~imm_val[7] & result[7]) | (dst_byte[7] & imm_val[7] & ~result[7]);
flag_Z when (~m68k_exc_taken & ~data_exc_taken) = result[7:0] == 0;
flag_N when (~m68k_exc_taken & ~data_exc_taken) = result[7];
