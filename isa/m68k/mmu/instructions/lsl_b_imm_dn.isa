// SPDX-License-Identifier: BSD-3-Clause
// M68000 LSL.B #imm,Dn - Logical Shift Left Byte by immediate
// Opcode: 1110 CCC 1 01 0 01 DDD where CCC=count (0=8), size=01 (byte)

isa_state pc[31:0];
var instr[15:0];
isa_state dregs[31:0][2:0];
isa_state aregs[31:0][2:0];
mem dmem[25:0];
isa_state flag_X[0:0];
isa_state flag_N[0:0];
isa_state flag_Z[0:0];
isa_state flag_V[0:0];
isa_state flag_C[0:0];

var dst_reg[2:0];
var count_field[2:0];
var count[3:0];
var src[7:0];
var result[7:0];
var last_out[0:0];

// Include interrupt and exception handling aspects
aspect m68k_exception.isa gates pc:2, sr:2, ssp:2, aregs:2, dmem:2, flag_C:2, flag_N:2, flag_Z:2, flag_V:2, flag_X:2, usp:2;
aspect m68k_interrupt.isa gates sr;
#ifdef MMU
aspect mmu/atc_translate_instr.isa gates pc, dmem;
#else
var pc_pa[31:0];
pc_pa = pc;
var pc_pa_delta[31:0];
pc_pa_delta = 32'd0;
#endif

// Fetch instruction
instr = dmem[pc_pa];
assume instr[15:12] == 0b1110;  // Shift/rotate
assume instr[8] == 0b1;          // Direction: left
assume instr[7:6] == 0b00;       // Byte size
assume instr[5] == 0b0;          // Immediate count (not register)
assume instr[4:3] == 0b01;       // LSL type
pc when (~m68k_exc_taken) = pc + 2;

dst_reg = instr[2:0];
count_field = instr[11:9];
count = count_field == 0 ? 4'd8 : {1'b0, count_field};

src = dregs[dst_reg][7:0];

// Shift left
result = src << count;

// Last bit shifted out (for carry)
last_out = src >> (4'd8 - count);

// Write back (only low byte)
dregs[dst_reg] when (~m68k_exc_taken) = {dregs[dst_reg][31:8], result};

// Update CCR
flag_X when (~m68k_exc_taken) = last_out[0];
flag_N when (~m68k_exc_taken) = result[7];
flag_Z when (~m68k_exc_taken) = result == 0;
flag_V when (~m68k_exc_taken) = 1'b0;
flag_C when (~m68k_exc_taken) = last_out[0];
