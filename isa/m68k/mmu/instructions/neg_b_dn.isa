// SPDX-License-Identifier: BSD-3-Clause
// M68000 NEG.B Dn - Negate (two's complement) data register byte
// Opcode: 0100 0100 00000 DDD where DDD=reg

isa_state pc[31:0];
var instr[15:0];
isa_state dregs[31:0][2:0];
isa_state aregs[31:0][2:0];
mem dmem[25:0];
isa_state flag_X[0:0];
isa_state flag_N[0:0];
isa_state flag_Z[0:0];
isa_state flag_V[0:0];
isa_state flag_C[0:0];

// Byte sub-registers using 'of' keyword
// dregs_b[n] maps to dregs[n][7:0] (low byte of each data register)
isa_state dregs_b[7:0][2:0] of dregs[0b***][7:0];

var dst_reg[2:0];
var src_val[7:0];
var result[7:0];

// Include interrupt and exception handling aspects
aspect m68k_exception.isa gates pc:2, sr:2, ssp:2, aregs:2, dmem:2, flag_C:2, flag_N:2, flag_Z:2, flag_V:2, flag_X:2, usp:2;
aspect m68k_interrupt.isa gates sr;
#ifdef MMU
aspect mmu/atc_translate_instr.isa gates pc, dmem;
#else
var pc_pa[31:0];
pc_pa = pc;
var pc_pa_delta[31:0];
pc_pa_delta = 32'd0;
#endif

// Fetch instruction
instr = dmem[pc_pa];
assume instr[15:8] == 0b01000100;  // NEG opcode
assume instr[7:6] == 0b00;         // Size: byte
assume instr[5:3] == 0b000;        // EA mode: Data Register Direct
pc when (~m68k_exc_taken) = pc + 2;

// Decode
dst_reg = instr[2:0];

// Execute: 0 - destination
src_val = dregs_b[dst_reg];
result = 0 - src_val;

// Write result (preserves upper bits via 'of' mapping)
dregs_b[dst_reg] when (~m68k_exc_taken) = result;

// Update CCR
flag_X when (~m68k_exc_taken) = src_val != 0;
flag_C when (~m68k_exc_taken) = src_val != 0;
flag_V when (~m68k_exc_taken) = src_val == 8'h80;  // Overflow only when negating most negative byte
flag_Z when (~m68k_exc_taken) = result == 0;
flag_N when (~m68k_exc_taken) = result[7];
