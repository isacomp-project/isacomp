// SPDX-License-Identifier: BSD-3-Clause
// M68000 ADDI.L #imm,d(An) - Add Immediate Long to memory displacement
// Opcode: 0000 0110 10 101 AAA followed by 32-bit immediate, then 16-bit displacement
// Adds immediate to 32-bit memory at (d16,An), writes result back

isa_state pc[31:0];
var instr[15:0];
isa_state dregs[31:0][2:0];
isa_state aregs[31:0][2:0];
mem dmem[25:0];
#ifdef MMU
// MMU state (added by MMU preprocessor)
isa_state tc[31:0];
isa_state tt0[31:0];
isa_state tt1[31:0];
isa_state crp[63:0];
isa_state srp[63:0];
isa_state vbr[31:0];
isa_state ssp[31:0];
isa_state usp[31:0];
#endif
isa_state flag_X[0:0];
isa_state flag_N[0:0];
isa_state flag_Z[0:0];
isa_state flag_V[0:0];
isa_state flag_C[0:0];

var addr_reg[2:0];
var imm_hi[15:0];
var imm_lo[15:0];
var imm32[31:0];
var disp16[15:0];
var disp_ext[31:0];
var eff_addr[31:0];
var mem_val_hi[15:0];
var mem_val_lo[15:0];
var src[31:0];
var result[32:0];

// Include interrupt and exception handling aspects
aspect m68k_exception.isa gates pc:2, sr:2, ssp:2, aregs:2, dmem:2, flag_C:2, flag_N:2, flag_Z:2, flag_V:2, flag_X:2, usp:2;
aspect m68k_interrupt.isa gates sr;
#ifdef MMU
aspect mmu/atc_translate_instr.isa gates pc, dmem;
#else
var pc_pa[31:0];
pc_pa = pc;
var pc_pa_delta[31:0];
pc_pa_delta = 32'd0;
#endif

// Fetch instruction
instr = dmem[pc_pa];
assume instr[15:8] == 0b00000110;  // ADDI opcode
assume instr[7:6] == 0b10;          // Size: long
assume instr[5:3] == 0b101;         // EA mode: Address Register Indirect with Displacement
pc when (~m68k_exc_taken) = pc + 2;

// Decode address register
addr_reg = instr[2:0];

// Fetch 32-bit immediate (big-endian)
imm_hi = dmem[pc + pc_pa_delta];
pc when (~m68k_exc_taken) = pc + 2;
imm_lo = dmem[pc + pc_pa_delta];
pc when (~m68k_exc_taken) = pc + 2;
imm32 = {imm_hi, imm_lo};

// Fetch 16-bit displacement
disp16 = dmem[pc + pc_pa_delta];
pc when (~m68k_exc_taken) = pc + 2;

// Sign-extend displacement
disp_ext = {{16{disp16[15]}}, disp16};

// Calculate effective address
eff_addr = aregs[addr_reg] + disp_ext;

// Read memory value (32-bit, big-endian)
#ifdef MMU
var mmu_va[31:0];
mmu_va = eff_addr;
var is_write[0:0];
is_write = 1'b1;
aspect mmu/atc_translate_data.isa gates pc:1, sr:1, ssp:1, aregs:1, dmem:1, flag_C:1, flag_N:1, flag_Z:1, flag_V:1, flag_X:1, usp:1;
#endif

#ifdef MMU
mem_val_hi = dmem[ea_pa];
#else
mem_val_hi = dmem[eff_addr];
#endif
#ifdef MMU
mem_val_lo = dmem[ea_pa + 2];
#else
mem_val_lo = dmem[eff_addr + 2];
#endif
src = {mem_val_hi, mem_val_lo};

// Execute ADD
result = src + imm32;

// Write result back to memory (big-endian)
#ifdef MMU
dmem[ea_pa] when (~m68k_exc_taken & ~data_exc_taken) = result[31:16];
#else
dmem[eff_addr] when (~m68k_exc_taken & ~data_exc_taken) = result[31:16];
#endif
#ifdef MMU
dmem[ea_pa + 2] when (~m68k_exc_taken & ~data_exc_taken) = result[15:0];
#else
dmem[eff_addr + 2] when (~m68k_exc_taken & ~data_exc_taken) = result[15:0];
#endif

// Update CCR
flag_X when (~m68k_exc_taken & ~data_exc_taken) = result[32];
flag_C when (~m68k_exc_taken & ~data_exc_taken) = result[32];
flag_V when (~m68k_exc_taken & ~data_exc_taken) = (~src[31] & ~imm32[31] & result[31]) | (src[31] & imm32[31] & ~result[31]);
flag_Z when (~m68k_exc_taken & ~data_exc_taken) = result[31:0] == 0;
flag_N when (~m68k_exc_taken & ~data_exc_taken) = result[31];
