// SPDX-License-Identifier: BSD-3-Clause
// SPARCv8 LD instruction with MMU translation (load word)
// Format 3: op=11, op3=000000
// LD [rs1 + reg_or_imm], rd
// rd <- mem[translate(rs1 + reg_or_imm)]
//
// This version includes TLB translation for virtual->physical address

isa_state pc[31:0];
var instr[31:0];
isa_state rf[31:0][7:0];  // 256 physical registers (136 used for 8 windows)
isa_state cwp[2:0];       // Current Window Pointer (0-7)
isa_state psr[31:0];      // Processor State Register
isa_state tbr[31:0];      // Trap Base Register
mem umem[23:0];

// Branch delay slot state
isa_state delay_slot[0:0];
isa_state branch_target[31:0];

// Include delay slot aspect
aspect ../delay_slot.isa gates pc, delay_slot;

var rd[4:0];
var rs1[4:0];
var imm[0:0];
var rs2[4:0];
var simm13[12:0];

var r1[31:0];
var r2[31:0];
var operand2[31:0];
var addr[31:0];
var data[31:0];

var cwp_m1[2:0];
var phys_rs1[7:0];
var phys_rs2[7:0];
var phys_rd[7:0];

instr = umem[pc];
assume instr[31:30] == 0b11;       // op = 11 (Load/Store)
assume instr[24:19] == 0b000000;   // op3 = LD

rd = instr[29:25];
rs1 = instr[18:14];
imm = instr[13];
rs2 = instr[4:0];
simm13 = instr[12:0];

// Compute physical register indices for windowed register file
cwp_m1 = cwp + 3'b111;  // cwp - 1 mod 8
phys_rs1 = (rs1[4:3] == 2'b00) ? {5'b0, rs1[2:0]} :
           (rs1[4:3] == 2'b01) ? ({5'b0, cwp_m1} << 3) + 8'd8 + {5'b0, rs1[2:0]} :
           (rs1[4:3] == 2'b10) ? ({5'b0, cwp} << 3) + 8'd72 + {5'b0, rs1[2:0]} :
           ({5'b0, cwp} << 3) + 8'd8 + {5'b0, rs1[2:0]};
phys_rs2 = (rs2[4:3] == 2'b00) ? {5'b0, rs2[2:0]} :
           (rs2[4:3] == 2'b01) ? ({5'b0, cwp_m1} << 3) + 8'd8 + {5'b0, rs2[2:0]} :
           (rs2[4:3] == 2'b10) ? ({5'b0, cwp} << 3) + 8'd72 + {5'b0, rs2[2:0]} :
           ({5'b0, cwp} << 3) + 8'd8 + {5'b0, rs2[2:0]};
phys_rd = (rd[4:3] == 2'b00) ? {5'b0, rd[2:0]} :
          (rd[4:3] == 2'b01) ? ({5'b0, cwp_m1} << 3) + 8'd8 + {5'b0, rd[2:0]} :
          (rd[4:3] == 2'b10) ? ({5'b0, cwp} << 3) + 8'd72 + {5'b0, rd[2:0]} :
          ({5'b0, cwp} << 3) + 8'd8 + {5'b0, rd[2:0]};

r1 = (rs1 == 0) ? 32'b0 : rf[phys_rs1];
r2 = (rs2 == 0) ? 32'b0 : rf[phys_rs2];
operand2 = imm ? {{19{simm13[12]}}, simm13} : r2;

addr = r1 + operand2;

// Include MMU registers (must come before translation aspect)
#include "mmu_regs.isa"

// Include TLB translation aspect
// This sets addr_pa and data_access_exception
#include "tlb_translate_data.isa"

// Load from physical address (if no exception)
data = umem[addr_pa[23:0]];

// Write result only if no exception
rf[phys_rd] when ((rd != 0) & (~data_access_exception)) = data;
// PC is updated in tlb_translate_data.isa with ternary: trap_vector or pc+4
