// SPDX-License-Identifier: BSD-3-Clause
// SPARCv8 SRMMU Control Register Write (STA to ASI 0x04)
// Format 3: op=11, op3=010100, i=0, asi=0x04
// STA rd, [rs1 + rs2] 0x04
// Privileged instruction - writes MMU control registers
//
// Register selection based on address[11:8]:
// 0x0: MMU Control Register
// 0x1: Context Table Pointer
// 0x2: Context Register
// 0x3: Fault Status Register (read-only, write ignored)
// 0x4: Fault Address Register (read-only, write ignored)

isa_state pc[31:0];
var instr[31:0];
isa_state rf[31:0][7:0];   // Integer register file (physical windowed)
isa_state cwp[2:0];        // Current Window Pointer
isa_state psr[31:0];       // Processor State Register
mem umem[23:0];

// Branch delay slot state
isa_state delay_slot[0:0];
isa_state branch_target[31:0];

// Include delay slot aspect
aspect ../delay_slot.isa gates pc, delay_slot;

// Include MMU registers
#include "mmu_regs.isa"

var rs1[4:0];
var rs2[4:0];
var rd[4:0];
var asi[7:0];

var r1[31:0];
var r2[31:0];
var addr[31:0];
var data[31:0];

var cwp_m1[2:0];
var phys_rs1[7:0];
var phys_rs2[7:0];
var phys_rd[7:0];

instr = umem[pc];
assume instr[31:30] == 0b11;       // op = 11 (Load/Store)
assume instr[24:19] == 0b010100;   // op3 = STA
assume instr[13] == 0b0;           // i = 0 (register addressing with ASI)
assume instr[12:5] == 8'h04;       // ASI = 0x04 (MMU Registers)

rs1 = instr[18:14];
rs2 = instr[4:0];
rd = instr[29:25];
asi = instr[12:5];

// Compute physical register indices
cwp_m1 = cwp + 3'b111;
phys_rs1 = (rs1[4:3] == 2'b00) ? {5'b0, rs1[2:0]} :
           (rs1[4:3] == 2'b01) ? ({5'b0, cwp_m1} << 3) + 8'd8 + {5'b0, rs1[2:0]} :
           (rs1[4:3] == 2'b10) ? ({5'b0, cwp} << 3) + 8'd72 + {5'b0, rs1[2:0]} :
           ({5'b0, cwp} << 3) + 8'd8 + {5'b0, rs1[2:0]};
phys_rs2 = (rs2[4:3] == 2'b00) ? {5'b0, rs2[2:0]} :
           (rs2[4:3] == 2'b01) ? ({5'b0, cwp_m1} << 3) + 8'd8 + {5'b0, rs2[2:0]} :
           (rs2[4:3] == 2'b10) ? ({5'b0, cwp} << 3) + 8'd72 + {5'b0, rs2[2:0]} :
           ({5'b0, cwp} << 3) + 8'd8 + {5'b0, rs2[2:0]};
phys_rd = (rd[4:3] == 2'b00) ? {5'b0, rd[2:0]} :
          (rd[4:3] == 2'b01) ? ({5'b0, cwp_m1} << 3) + 8'd8 + {5'b0, rd[2:0]} :
          (rd[4:3] == 2'b10) ? ({5'b0, cwp} << 3) + 8'd72 + {5'b0, rd[2:0]} :
          ({5'b0, cwp} << 3) + 8'd8 + {5'b0, rd[2:0]};

r1 = (rs1 == 0) ? 32'b0 : rf[phys_rs1];
r2 = (rs2 == 0) ? 32'b0 : rf[phys_rs2];
data = (rd == 0) ? 32'b0 : rf[phys_rd];

addr = r1 + r2;

// Register select from address bits
var reg_sel[3:0];
reg_sel = addr[11:8];

// Create explicit guard conditions for proper write gating
var write_ctrl[0:0];
var write_ctxptr[0:0];
var write_ctx[0:0];
write_ctrl = (reg_sel == 4'h0);
write_ctxptr = (reg_sel == 4'h1);
write_ctx = (reg_sel == 4'h2);

// Write appropriate register with explicit guards
mmu_ctrl when (write_ctrl) = data;
mmu_ctxptr when (write_ctxptr) = data;
mmu_ctx when (write_ctx) = data;
// FSR and FAR are read-only, writes are ignored

pc = pc + 4;
