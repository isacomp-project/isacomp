// SPDX-License-Identifier: BSD-3-Clause
// SPARCv8 SRMMU Control Register Read (LDA from ASI 0x04)
// Format 3: op=11, op3=010011, i=0, asi=0x04
// LDA [rs1 + rs2] 0x04, rd
// Privileged instruction - reads MMU control registers
//
// Register selection based on address[11:8]:
// 0x0: MMU Control Register
// 0x1: Context Table Pointer
// 0x2: Context Register
// 0x3: Fault Status Register
// 0x4: Fault Address Register

isa_state pc[31:0];
var instr[31:0];
isa_state rf[31:0][7:0];   // Integer register file (physical windowed)
isa_state cwp[2:0];        // Current Window Pointer
isa_state psr[31:0];       // Processor State Register
mem umem[23:0];

// Branch delay slot state
isa_state delay_slot[0:0];
isa_state branch_target[31:0];

// Include delay slot aspect
aspect ../delay_slot.isa gates pc, delay_slot;

// Include MMU registers
#include "mmu_regs.isa"

var rs1[4:0];
var rs2[4:0];
var rd[4:0];
var asi[7:0];

var r1[31:0];
var r2[31:0];
var addr[31:0];
var result[31:0];

var cwp_m1[2:0];
var phys_rs1[7:0];
var phys_rs2[7:0];
var phys_rd[7:0];

instr = umem[pc];
assume instr[31:30] == 0b11;       // op = 11 (Load/Store)
assume instr[24:19] == 0b010011;   // op3 = LDA
assume instr[13] == 0b0;           // i = 0 (register addressing with ASI)
assume instr[12:5] == 8'h04;       // ASI = 0x04 (MMU Registers)

// Differentiate from probe by address range
// Probe uses addr[11:8] for probe type, this uses it for register select
// We'll use addr[31:12] == 0 to indicate register access vs probe

rs1 = instr[18:14];
rs2 = instr[4:0];
rd = instr[29:25];
asi = instr[12:5];

// Compute physical register indices
cwp_m1 = cwp + 3'b111;
phys_rs1 = (rs1[4:3] == 2'b00) ? {5'b0, rs1[2:0]} :
           (rs1[4:3] == 2'b01) ? ({5'b0, cwp_m1} << 3) + 8'd8 + {5'b0, rs1[2:0]} :
           (rs1[4:3] == 2'b10) ? ({5'b0, cwp} << 3) + 8'd72 + {5'b0, rs1[2:0]} :
           ({5'b0, cwp} << 3) + 8'd8 + {5'b0, rs1[2:0]};
phys_rs2 = (rs2[4:3] == 2'b00) ? {5'b0, rs2[2:0]} :
           (rs2[4:3] == 2'b01) ? ({5'b0, cwp_m1} << 3) + 8'd8 + {5'b0, rs2[2:0]} :
           (rs2[4:3] == 2'b10) ? ({5'b0, cwp} << 3) + 8'd72 + {5'b0, rs2[2:0]} :
           ({5'b0, cwp} << 3) + 8'd8 + {5'b0, rs2[2:0]};
phys_rd = (rd[4:3] == 2'b00) ? {5'b0, rd[2:0]} :
          (rd[4:3] == 2'b01) ? ({5'b0, cwp_m1} << 3) + 8'd8 + {5'b0, rd[2:0]} :
          (rd[4:3] == 2'b10) ? ({5'b0, cwp} << 3) + 8'd72 + {5'b0, rd[2:0]} :
          ({5'b0, cwp} << 3) + 8'd8 + {5'b0, rd[2:0]};

r1 = (rs1 == 0) ? 32'b0 : rf[phys_rs1];
r2 = (rs2 == 0) ? 32'b0 : rf[phys_rs2];

addr = r1 + r2;

// Register select from address bits
var reg_sel[3:0];
reg_sel = addr[11:8];

// Read appropriate register
result = (reg_sel == 4'h0) ? mmu_ctrl :
         (reg_sel == 4'h1) ? mmu_ctxptr :
         (reg_sel == 4'h2) ? mmu_ctx :
         (reg_sel == 4'h3) ? mmu_fsr :
         (reg_sel == 4'h4) ? mmu_far :
         32'b0;

// Write result to destination register (unless rd == 0)
rf[phys_rd] when (rd != 5'b0) = result;

pc = pc + 4;
