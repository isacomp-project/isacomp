// SPDX-License-Identifier: BSD-3-Clause
// SPARCv8 LDSTUB instruction (atomic load-store unsigned byte)
// Format 3: op=11, op3=001101
// LDSTUB [rs1 + reg_or_imm], rd
// rd <- zero_extend(mem[rs1 + reg_or_imm][byte])
// mem[rs1 + reg_or_imm][byte] <- 0xFF
// This is an atomic test-and-set operation for synchronization

isa_state pc[31:0];
var instr[31:0];
isa_state rf[31:0][7:0];  // 256 physical registers (136 used for 8 windows)
isa_state cwp[2:0];       // Current Window Pointer (0-7)
mem umem[23:0];

// Branch delay slot state
isa_state delay_slot[0:0];
isa_state branch_target[31:0];

// Include delay slot aspect - handles PC override if we're in a delay slot
aspect delay_slot.isa gates pc, delay_slot;


var rd[4:0];
var rs1[4:0];
var imm[0:0];
var rs2[4:0];
var simm13[12:0];

var r1[31:0];
var r2[31:0];
var operand2[31:0];
var addr[31:0];
var word_addr[31:0];
var byte_offset[1:0];
var mem_word[31:0];
var byte_val[7:0];
var new_word[31:0];

var cwp_m1[2:0];
var phys_rs1[7:0];
var phys_rs2[7:0];
var phys_rd[7:0];

instr = umem[pc];
assume instr[31:30] == 0b11;       // op = 11 (Load/Store)
assume instr[24:19] == 0b001101;   // op3 = LDSTUB

rd = instr[29:25];
rs1 = instr[18:14];
imm = instr[13];
rs2 = instr[4:0];
simm13 = instr[12:0];

// Compute physical register indices for windowed register file
cwp_m1 = cwp + 3'b111;  // cwp - 1 mod 8
phys_rs1 = (rs1[4:3] == 2'b00) ? {5'b0, rs1[2:0]} :
           (rs1[4:3] == 2'b01) ? ({5'b0, cwp_m1} << 3) + 8'd8 + {5'b0, rs1[2:0]} :
           (rs1[4:3] == 2'b10) ? ({5'b0, cwp} << 3) + 8'd72 + {5'b0, rs1[2:0]} :
           ({5'b0, cwp} << 3) + 8'd8 + {5'b0, rs1[2:0]};
phys_rs2 = (rs2[4:3] == 2'b00) ? {5'b0, rs2[2:0]} :
           (rs2[4:3] == 2'b01) ? ({5'b0, cwp_m1} << 3) + 8'd8 + {5'b0, rs2[2:0]} :
           (rs2[4:3] == 2'b10) ? ({5'b0, cwp} << 3) + 8'd72 + {5'b0, rs2[2:0]} :
           ({5'b0, cwp} << 3) + 8'd8 + {5'b0, rs2[2:0]};
phys_rd = (rd[4:3] == 2'b00) ? {5'b0, rd[2:0]} :
          (rd[4:3] == 2'b01) ? ({5'b0, cwp_m1} << 3) + 8'd8 + {5'b0, rd[2:0]} :
          (rd[4:3] == 2'b10) ? ({5'b0, cwp} << 3) + 8'd72 + {5'b0, rd[2:0]} :
          ({5'b0, cwp} << 3) + 8'd8 + {5'b0, rd[2:0]};

r1 = (rs1 == 0) ? 32'b0 : rf[phys_rs1];
r2 = (rs2 == 0) ? 32'b0 : rf[phys_rs2];
operand2 = imm ? {{19{simm13[12]}}, simm13} : r2;

addr = r1 + operand2;
word_addr = {addr[31:2], 2'b00};  // Word-aligned address
byte_offset = addr[1:0];          // Byte offset within word

// Read memory word
mem_word = umem[word_addr];

// Extract byte (big-endian: byte 0 is MSB)
byte_val = (byte_offset == 2'b00) ? mem_word[31:24] :
           (byte_offset == 2'b01) ? mem_word[23:16] :
           (byte_offset == 2'b10) ? mem_word[15:8] :
           mem_word[7:0];

// Create new word with 0xFF in the appropriate byte position
new_word = (byte_offset == 2'b00) ? {8'hFF, mem_word[23:0]} :
           (byte_offset == 2'b01) ? {mem_word[31:24], 8'hFF, mem_word[15:0]} :
           (byte_offset == 2'b10) ? {mem_word[31:16], 8'hFF, mem_word[7:0]} :
           {mem_word[31:8], 8'hFF};

// Write back word with 0xFF in the byte position
umem[word_addr] = new_word;

// Zero-extend byte to 32 bits and store in rd
rf[phys_rd] when (rd != 0) = {24'b0, byte_val};
pc = pc + 4;
