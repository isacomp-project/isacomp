// SPDX-License-Identifier: BSD-3-Clause
// SPARCv8 STBAR instruction (store barrier)
// Format 3: op=10, op3=101000, rd=15, rs1=0, i=0, rs2=0
// STBAR
// Ensures all stores before STBAR complete before any stores after
// This is a memory barrier - no register or memory changes, just ordering

isa_state pc[31:0];
var instr[31:0];
isa_state rf[31:0][7:0];  // 256 physical registers (136 used for 8 windows)
isa_state cwp[2:0];       // Current Window Pointer (0-7)
mem umem[23:0];

// Branch delay slot state
isa_state delay_slot[0:0];
isa_state branch_target[31:0];

// Include delay slot aspect - handles PC override if we're in a delay slot
aspect delay_slot.isa gates pc, delay_slot;

instr = umem[pc];
assume instr[31:30] == 0b10;       // op = 10 (Format 3)
assume instr[29:25] == 0b01111;    // rd = 15 (distinguishes STBAR from RDY)
assume instr[24:19] == 0b101000;   // op3 = STBAR/RDY
assume instr[18:14] == 0b00000;    // rs1 = 0
assume instr[13] == 0b0;           // i = 0
assume instr[4:0] == 0b00000;      // rs2 = 0

// STBAR is a memory fence - no visible state change in ISA model
// In a real implementation this ensures store ordering
pc = pc + 4;
