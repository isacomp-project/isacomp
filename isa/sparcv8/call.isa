// SPARCv8 CALL instruction
// Format 1: op=01
// CALL disp30
// r15 (o7) <- pc; pc <- pc + sign_extend(disp30 << 2)
// Has a delay slot - next instruction always executes before branch

isa_state pc[31:0];
var instr[31:0];
isa_state rf[31:0][7:0];  // 256 physical registers (136 used for 8 windows)
isa_state cwp[2:0];       // Current Window Pointer (0-7)
mem umem[23:0];

// Branch delay slot state
isa_state delay_slot[0:0];
isa_state branch_target[31:0];

var disp30[29:0];
var offset[31:0];
var target[31:0];
var cwp_m1[2:0];
var phys_o7[7:0];

// Include delay slot aspect - handles PC override if we're in a delay slot
aspect delay_slot.isa gates pc, delay_slot;

instr = umem[pc];
assume instr[31:30] == 0b01;       // op = 01 (CALL)

disp30 = instr[29:0];

// Sign-extend and multiply by 4 (word offset)
offset = {{2{disp30[29]}}, disp30} << 2;
target = pc + offset;

// Compute physical register index for o7 (r15) - outputs use cwp_m1
cwp_m1 = cwp + 3'b111;  // cwp - 1 mod 8
phys_o7 = ({5'b0, cwp_m1} << 3) + 8'd8 + 8'd7;  // r15 is outs[7]

// Save return address in r15 (o7)
rf[phys_o7] = pc;

// CALL always branches - set up delay slot for next instruction
// Don't set up delay slot if we're already in one
delay_slot when (in_delay_slot == 0) = 1;
branch_target when (in_delay_slot == 0) = target;

// Always advance to delay slot instruction
pc = pc + 4;
