// SPDX-License-Identifier: BSD-3-Clause
// SPARCv8 RDTBR instruction (read trap base register)
// Format 3: op=10, op3=101011, rs1=0
// RDTBR rd
// rd <- tbr
// Privileged instruction

isa_state pc[31:0];
var instr[31:0];
isa_state rf[31:0][7:0];  // 256 physical registers (136 used for 8 windows)
isa_state cwp[2:0];       // Current Window Pointer (0-7)
isa_state tbr[31:0];      // Trap Base Register
mem umem[23:0];

// Branch delay slot state
isa_state delay_slot[0:0];
isa_state branch_target[31:0];

// Include delay slot aspect - handles PC override if we're in a delay slot
aspect delay_slot.isa gates pc, delay_slot;

var rd[4:0];
var cwp_m1[2:0];
var phys_rd[7:0];

instr = umem[pc];
assume instr[31:30] == 0b10;       // op = 10 (Format 3)
assume instr[24:19] == 0b101011;   // op3 = RDTBR
assume instr[18:14] == 0b00000;    // rs1 = 0

rd = instr[29:25];

// Compute physical register index for windowed register file
cwp_m1 = cwp + 3'b111;  // cwp - 1 mod 8
phys_rd = (rd[4:3] == 2'b00) ? {5'b0, rd[2:0]} :
          (rd[4:3] == 2'b01) ? ({5'b0, cwp_m1} << 3) + 8'd8 + {5'b0, rd[2:0]} :
          (rd[4:3] == 2'b10) ? ({5'b0, cwp} << 3) + 8'd72 + {5'b0, rd[2:0]} :
          ({5'b0, cwp} << 3) + 8'd8 + {5'b0, rd[2:0]};

// Read TBR into destination register
rf[phys_rd] when (rd != 0) = tbr;
pc = pc + 4;
