// SPDX-License-Identifier: BSD-3-Clause
// SPARCv8 FLUSH instruction (instruction cache flush)
// Format 3: op=10, op3=111011
// FLUSH rs1 + reg_or_imm
// Flushes the instruction cache at address rs1 + reg_or_imm
// This is a memory barrier for instruction cache coherency

isa_state pc[31:0];
var instr[31:0];
isa_state rf[31:0][7:0];  // 256 physical registers (136 used for 8 windows)
isa_state cwp[2:0];       // Current Window Pointer (0-7)
mem umem[23:0];

// Branch delay slot state
isa_state delay_slot[0:0];
isa_state branch_target[31:0];

// Include delay slot aspect - handles PC override if we're in a delay slot
aspect delay_slot.isa gates pc, delay_slot;

var rs1[4:0];
var imm[0:0];
var rs2[4:0];
var simm13[12:0];

instr = umem[pc];
assume instr[31:30] == 0b10;       // op = 10 (Format 3)
assume instr[24:19] == 0b111011;   // op3 = FLUSH

rs1 = instr[18:14];
imm = instr[13];
rs2 = instr[4:0];
simm13 = instr[12:0];

// FLUSH is a cache coherency instruction - no visible state change in ISA model
// In a real implementation this flushes the instruction cache
pc = pc + 4;
