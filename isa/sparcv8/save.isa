// SPDX-License-Identifier: BSD-3-Clause
// SPARCv8 SAVE instruction with register windows
// Format 3: op=10, op3=111100
// SAVE rs1, reg_or_imm, rd
// new_CWP = (CWP - 1) mod NWINDOWS
// rd_new_window = rs1_old_window + reg_or_imm_old_window
//
// Register window implementation (NWINDOWS=8):
// Physical registers 0-7: globals (g0-g7)
// Physical registers 8-71: 8 overlap regions (ins/outs shared)
// Physical registers 72-135: 8 local regions
//
// For CWP=W:
//   globals (r0-r7):   physical 0-7
//   outs (r8-r15):     physical 8 + ((W+7)&7)*8 + (r-8)
//   locals (r16-r23):  physical 72 + W*8 + (r-16)
//   ins (r24-r31):     physical 8 + W*8 + (r-24)

isa_state pc[31:0];
var instr[31:0];
isa_state rf[31:0][7:0];  // 256 physical registers (136 used for 8 windows)
isa_state cwp[2:0];       // Current Window Pointer (0-7)
mem umem[23:0];

// Branch delay slot state
isa_state delay_slot[0:0];
isa_state branch_target[31:0];

// Include delay slot aspect - handles PC override if we're in a delay slot
aspect delay_slot.isa gates pc, delay_slot;


var rd[4:0];
var rs1[4:0];
var imm[0:0];
var rs2[4:0];
var simm13[12:0];

var old_cwp[2:0];
var new_cwp[2:0];
var old_cwp_m1[2:0];
var new_cwp_m1[2:0];

var phys_rs1[7:0];
var phys_rs2[7:0];
var phys_rd[7:0];

var r1[31:0];
var r2[31:0];
var operand2[31:0];
var res[31:0];

instr = umem[pc];
assume instr[31:30] == 0b10;       // op = 10 (Format 3)
assume instr[24:19] == 0b111100;   // op3 = SAVE

rd = instr[29:25];
rs1 = instr[18:14];
imm = instr[13];
rs2 = instr[4:0];
simm13 = instr[12:0];

// Save old CWP and compute new CWP (decrement mod 8)
old_cwp = cwp;
new_cwp = cwp + 3'b111;  // CWP - 1 mod 8 (wraps naturally)
old_cwp_m1 = old_cwp + 3'b111;  // For outs mapping

// Compute physical index for rs1 (read from old window)
// globals: r[2:0], outs: 8+(cwp-1)*8+r[2:0], locals: 72+cwp*8+r[2:0], ins: 8+cwp*8+r[2:0]
phys_rs1 = (rs1[4:3] == 2'b00) ? {5'b0, rs1[2:0]} :
           (rs1[4:3] == 2'b01) ? ({5'b0, old_cwp_m1} << 3) + 8'd8 + {5'b0, rs1[2:0]} :
           (rs1[4:3] == 2'b10) ? ({5'b0, old_cwp} << 3) + 8'd72 + {5'b0, rs1[2:0]} :
           ({5'b0, old_cwp} << 3) + 8'd8 + {5'b0, rs1[2:0]};

// Compute physical index for rs2 (read from old window)
phys_rs2 = (rs2[4:3] == 2'b00) ? {5'b0, rs2[2:0]} :
           (rs2[4:3] == 2'b01) ? ({5'b0, old_cwp_m1} << 3) + 8'd8 + {5'b0, rs2[2:0]} :
           (rs2[4:3] == 2'b10) ? ({5'b0, old_cwp} << 3) + 8'd72 + {5'b0, rs2[2:0]} :
           ({5'b0, old_cwp} << 3) + 8'd8 + {5'b0, rs2[2:0]};

// Read source operands from old window
r1 = (rs1 == 5'b0) ? 32'b0 : rf[phys_rs1];
r2 = (rs2 == 5'b0) ? 32'b0 : rf[phys_rs2];
operand2 = imm ? {{19{simm13[12]}}, simm13} : r2;

// Compute result
res = r1 + operand2;

// Compute physical index for rd (write to NEW window)
new_cwp_m1 = new_cwp + 3'b111;  // For outs mapping in new window
phys_rd = (rd[4:3] == 2'b00) ? {5'b0, rd[2:0]} :
          (rd[4:3] == 2'b01) ? ({5'b0, new_cwp_m1} << 3) + 8'd8 + {5'b0, rd[2:0]} :
          (rd[4:3] == 2'b10) ? ({5'b0, new_cwp} << 3) + 8'd72 + {5'b0, rd[2:0]} :
          ({5'b0, new_cwp} << 3) + 8'd8 + {5'b0, rd[2:0]};

// Update CWP (window rotation)
cwp = new_cwp;

// Write result to new window (skip if rd is g0)
rf[phys_rd] when (rd != 5'b0) = res;
pc = pc + 4;
