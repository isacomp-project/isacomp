// SPDX-License-Identifier: BSD-3-Clause
// SPARCv8 FADDd instruction (Floating-point Add Double)
// Format 3: op=10, op3=110100, opf=001000010
// FADDd rs1, rs2, rd
// rd <- rs1 + rs2 (double-precision)
// rs1, rs2, rd must be even-numbered (use register pairs)

isa_state pc[31:0];
var instr[31:0];
isa_state frf[31:0][4:0];  // FP register file (32 single-precision)
isa_state fsr[31:0];       // Floating-point State Register
mem umem[23:0];

// Branch delay slot state
isa_state delay_slot[0:0];
isa_state branch_target[31:0];

// Include delay slot aspect
aspect delay_slot.isa gates pc, delay_slot;

var rs1[4:0];
var rs2[4:0];
var rd[4:0];
var f1_hi[31:0];
var f1_lo[31:0];
var f2_hi[31:0];
var f2_lo[31:0];
var f1[63:0];
var f2[63:0];
var result[63:0];
var rm[1:0];

instr = umem[pc];
assume instr[31:30] == 0b10;         // op = 10 (Format 3)
assume instr[24:19] == 0b110100;     // op3 = FPop1
assume instr[13:5] == 0b001000010;   // opf = FADDd
assume instr[14] == 0b0;             // rs1 must be even
assume instr[0] == 0b0;              // rs2 must be even
assume instr[25] == 0b0;             // rd must be even

rs1 = instr[18:14];
rs2 = instr[4:0];
rd = instr[29:25];

// Get rounding mode from FSR (bits 31:30)
rm = fsr[31:30];

// Read FP operands (double = two consecutive single registers)
f1_hi = frf[rs1];
f1_lo = frf[rs1 + 5'b00001];
f2_hi = frf[rs2];
f2_lo = frf[rs2 + 5'b00001];

// Combine into 64-bit values
f1 = {f1_hi, f1_lo};
f2 = {f2_hi, f2_lo};

// Perform FP addition with rounding mode
result = fp_add_d(f1, f2, {1'b0, rm});

// Write result to FP register pair
frf[rd] = result[63:32];
frf[rd + 5'b00001] = result[31:0];
pc = pc + 4;
