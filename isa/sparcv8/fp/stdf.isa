// SPDX-License-Identifier: BSD-3-Clause
// SPARCv8 STDF instruction (Store Double Floating-point)
// Format 3: op=11, op3=100111
// STDF rd, [rs1 + rs2]  or  STDF rd, [rs1 + simm13]
// Stores 64-bit double-precision value from FP register pair (rd must be even)

isa_state pc[31:0];
var instr[31:0];
isa_state rf[31:0][7:0];   // Integer register file (physical windowed)
isa_state frf[31:0][4:0];  // FP register file (32 single-precision)
isa_state cwp[2:0];        // Current Window Pointer
mem umem[23:0];

// Branch delay slot state
isa_state delay_slot[0:0];
isa_state branch_target[31:0];

// Include delay slot aspect
aspect delay_slot.isa gates pc, delay_slot;

var rs1[4:0];
var rs2[4:0];
var rd[4:0];
var imm[0:0];
var simm13[12:0];

var r1[31:0];
var r2[31:0];
var operand2[31:0];
var addr[31:0];
var data_hi[31:0];
var data_lo[31:0];
var rd_plus1[4:0];

var cwp_m1[2:0];
var phys_rs1[7:0];
var phys_rs2[7:0];

instr = umem[pc];
assume instr[31:30] == 0b11;       // op = 11 (Load/Store)
assume instr[24:19] == 0b100111;   // op3 = STDF
assume instr[25] == 0b0;           // rd must be even (rd[0] = 0)

rs1 = instr[18:14];
rs2 = instr[4:0];
rd = instr[29:25];
imm = instr[13];
simm13 = instr[12:0];

// Compute physical register indices for windowed integer register file
cwp_m1 = cwp + 3'b111;  // cwp - 1 mod 8
phys_rs1 = (rs1[4:3] == 2'b00) ? {5'b0, rs1[2:0]} :
           (rs1[4:3] == 2'b01) ? ({5'b0, cwp_m1} << 3) + 8'd8 + {5'b0, rs1[2:0]} :
           (rs1[4:3] == 2'b10) ? ({5'b0, cwp} << 3) + 8'd72 + {5'b0, rs1[2:0]} :
           ({5'b0, cwp} << 3) + 8'd8 + {5'b0, rs1[2:0]};
phys_rs2 = (rs2[4:3] == 2'b00) ? {5'b0, rs2[2:0]} :
           (rs2[4:3] == 2'b01) ? ({5'b0, cwp_m1} << 3) + 8'd8 + {5'b0, rs2[2:0]} :
           (rs2[4:3] == 2'b10) ? ({5'b0, cwp} << 3) + 8'd72 + {5'b0, rs2[2:0]} :
           ({5'b0, cwp} << 3) + 8'd8 + {5'b0, rs2[2:0]};

r1 = (rs1 == 0) ? 32'b0 : rf[phys_rs1];
r2 = (rs2 == 0) ? 32'b0 : rf[phys_rs2];
operand2 = imm ? {{19{simm13[12]}}, simm13} : r2;

addr = r1 + operand2;
rd_plus1 = rd + 5'b00001;

// Read from FP register pair
data_hi = frf[rd];
data_lo = frf[rd_plus1];

// Store high word first, then low word (big-endian)
umem[addr] = data_hi;
umem[addr + 32'd4] = data_lo;
pc = pc + 4;
