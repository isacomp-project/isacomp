// SPARCv8 FBN instruction (Floating-point Branch Never)
// Format 2: op=00, op2=110, cond=0000
// FBN disp22
// Never branch (NOP for FP branches)

isa_state pc[31:0];
var instr[31:0];
isa_state fsr[31:0];       // Floating-point State Register
mem umem[23:0];

// Branch delay slot state
isa_state delay_slot[0:0];
isa_state branch_target[31:0];

// Include delay slot aspect
aspect delay_slot.isa gates pc, delay_slot;

instr = umem[pc];
assume instr[31:30] == 0b00;       // op = 00 (Format 2)
assume instr[24:22] == 0b110;      // op2 = FBfcc
assume instr[28:25] == 0b0000;     // cond = never

// FBN never branches - just advance PC
pc = pc + 4;
