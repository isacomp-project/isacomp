// SPDX-License-Identifier: BSD-3-Clause
// SPARCv8 FCMPd instruction (Floating-point Compare Double)
// Format 3: op=10, op3=110101, opf=001010010
// FCMPd rs1, rs2
// Sets condition codes in FSR based on rs1 compared to rs2
// rs1, rs2 must be even-numbered (double-precision register pairs)

isa_state pc[31:0];
var instr[31:0];
isa_state frf[31:0][4:0];  // FP register file (32 single-precision)
isa_state fsr[31:0];       // Floating-point State Register
mem umem[23:0];

// Branch delay slot state
isa_state delay_slot[0:0];
isa_state branch_target[31:0];

// Include delay slot aspect
aspect delay_slot.isa gates pc, delay_slot;

var rs1[4:0];
var rs2[4:0];
var f1_hi[31:0];
var f1_lo[31:0];
var f2_hi[31:0];
var f2_lo[31:0];
var f1[63:0];
var f2[63:0];
var fcc[1:0];
var cmp_lt[0:0];
var cmp_eq[0:0];
var cmp_gt[0:0];
var cmp_un[0:0];

instr = umem[pc];
assume instr[31:30] == 0b10;         // op = 10 (Format 3)
assume instr[24:19] == 0b110101;     // op3 = FPop2 (compare)
assume instr[13:5] == 0b001010010;   // opf = FCMPd
assume instr[14] == 0b0;             // rs1 must be even
assume instr[0] == 0b0;              // rs2 must be even

rs1 = instr[18:14];
rs2 = instr[4:0];

// Read FP operands (double = two consecutive single registers)
f1_hi = frf[rs1];
f1_lo = frf[rs1 + 5'b00001];
f2_hi = frf[rs2];
f2_lo = frf[rs2 + 5'b00001];

// Combine into 64-bit values
f1 = {f1_hi, f1_lo};
f2 = {f2_hi, f2_lo};

// Compare doubles
cmp_lt = fp_lt_d(f1, f2);
cmp_eq = fp_eq_d(f1, f2);
cmp_gt = ~cmp_lt & ~cmp_eq;
cmp_un = fp_unordered_d(f1, f2);

// Set FCC (floating-point condition code) in FSR
// FCC: 00 = equal, 01 = less, 10 = greater, 11 = unordered
fcc = cmp_un ? 2'b11 :
      cmp_eq ? 2'b00 :
      cmp_lt ? 2'b01 :
      2'b10;

// Write FCC to FSR bits 11:10
fsr = {fsr[31:12], fcc, fsr[9:0]};
pc = pc + 4;
