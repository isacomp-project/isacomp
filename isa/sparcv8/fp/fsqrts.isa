// SPDX-License-Identifier: BSD-3-Clause
// SPARCv8 FSQRTs instruction (Floating-point Square Root Single)
// Format 3: op=10, op3=110100, opf=000101001
// FSQRTs rs2, rd
// rd <- sqrt(rs2) (single-precision)

isa_state pc[31:0];
var instr[31:0];
isa_state frf[31:0][4:0];  // FP register file (32 single-precision)
isa_state fsr[31:0];       // Floating-point State Register
mem umem[23:0];

// Branch delay slot state
isa_state delay_slot[0:0];
isa_state branch_target[31:0];

// Include delay slot aspect
aspect delay_slot.isa gates pc, delay_slot;

var rs2[4:0];
var rd[4:0];
var f2[31:0];
var result[31:0];
var rm[1:0];

instr = umem[pc];
assume instr[31:30] == 0b10;         // op = 10 (Format 3)
assume instr[24:19] == 0b110100;     // op3 = FPop1
assume instr[13:5] == 0b000101001;   // opf = FSQRTs

rs2 = instr[4:0];
rd = instr[29:25];

// Get rounding mode from FSR (bits 31:30)
rm = fsr[31:30];

// Read FP operand
f2 = frf[rs2];

// Perform FP square root with rounding mode
result = fp_sqrt(f2, {1'b0, rm});

// Write result to FP register
frf[rd] = result;
pc = pc + 4;
