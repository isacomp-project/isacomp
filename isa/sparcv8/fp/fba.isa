// SPDX-License-Identifier: BSD-3-Clause
// SPARCv8 FBA instruction (Floating-point Branch Always)
// Format 2: op=00, op2=110, cond=1000
// FBA disp22
// Always branch

isa_state pc[31:0];
var instr[31:0];
isa_state fsr[31:0];       // Floating-point State Register
mem umem[23:0];

// Branch delay slot state
isa_state delay_slot[0:0];
isa_state branch_target[31:0];

var disp22[21:0];
var target[31:0];

// Include delay slot aspect
aspect delay_slot.isa gates pc, delay_slot;

instr = umem[pc];
assume instr[31:30] == 0b00;       // op = 00 (Format 2)
assume instr[24:22] == 0b110;      // op2 = FBfcc
assume instr[28:25] == 0b1000;     // cond = always

disp22 = instr[21:0];

// Compute branch target (PC + sign-extended disp22 * 4)
target = pc + {{8{disp22[21]}}, disp22, 2'b00};

// FBA always branches - set up delay slot if not already in one
delay_slot when (in_delay_slot == 0) = 1;
branch_target when (in_delay_slot == 0) = target;

pc = pc + 4;
