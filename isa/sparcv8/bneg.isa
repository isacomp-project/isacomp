// SPDX-License-Identifier: BSD-3-Clause
// SPARCv8 BNEG instruction (branch on negative)
// Format 2: op=00, cond=0110, op2=010
// BNEG disp22
// Has a delay slot - next instruction always executes before branch

isa_state pc[31:0];
var instr[31:0];
isa_state rf[31:0][7:0];  // 256 physical registers (136 used for 8 windows)
isa_state cwp[2:0];       // Current Window Pointer (0-7)
isa_state psr[31:0];
mem umem[23:0];

// Branch delay slot state
isa_state delay_slot[0:0];
isa_state branch_target[31:0];

var disp22[21:0];
var offset[31:0];
var target[31:0];
var icc_n[0:0];
var taken[0:0];

// Include delay slot aspect - handles PC override if we're in a delay slot
aspect delay_slot.isa gates pc, delay_slot;

instr = umem[pc];
assume instr[31:30] == 0b00;       // op = 00 (Format 2)
assume instr[28:25] == 0b0110;     // cond = BNEG (negative)
assume instr[24:22] == 0b010;      // op2 = Bicc

disp22 = instr[21:0];
offset = {{10{disp22[21]}}, disp22} << 2;
target = pc + offset;

icc_n = psr[23];
taken = icc_n;

// Set up delay slot if branch is taken and not already in a delay slot
delay_slot when (taken & (in_delay_slot == 0)) = 1;
branch_target when (taken & (in_delay_slot == 0)) = target;

// Always advance to delay slot instruction
pc = pc + 4;
