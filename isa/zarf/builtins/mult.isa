// SPDX-License-Identifier: BSD-3-Clause
// Zarf (H-Machine) ISA - Multiply Builtin (0x03)
//
// Multiplies two primitive integers and returns the result.
// Both arguments must be primitives (eval_tag = 1).

// State declarations
isa_state pc[31:0];
isa_state eval_reg[31:0];
isa_state eval_tag[0:0];
isa_state env_args[31:0];
isa_state csp[19:0];
isa_state lsp[19:0];
isa_state env_clo[31:0];
mem imem[14:0];
mem heap[19:0];
mem cstack[19:0];

// Read arguments from environment
var arg1[31:0];
var arg2[31:0];

arg1 = heap[env_args];
arg2 = heap[env_args + 1];

// Perform multiplication (lower 32 bits)
var result[31:0];
result = arg1 * arg2;

// Set return value as primitive
eval_reg = result;
eval_tag = 1'b1;

// Pop continuation and return
aspect ../aspects/cont_pop.isa gates pc, csp, cstack, env_clo, env_args, lsp, eval_reg, eval_tag, heap;
