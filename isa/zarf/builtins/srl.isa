// SPDX-License-Identifier: BSD-3-Clause
// Zarf (H-Machine) ISA - Shift Right Logical Builtin (0x0D)
//
// Shifts first argument right by amount specified in second argument.
// Zeros are shifted in from the left (logical shift).
// Both arguments must be primitives (eval_tag = 1).

// State declarations
isa_state pc[31:0];
isa_state eval_reg[31:0];
isa_state eval_tag[0:0];
isa_state env_args[31:0];
isa_state csp[19:0];
isa_state lsp[19:0];
isa_state env_clo[31:0];
mem imem[14:0];
mem heap[19:0];
mem cstack[19:0];

// Read arguments from environment
var arg1[31:0];
var arg2[31:0];

arg1 = heap[env_args];
arg2 = heap[env_args + 1];

// Perform shift right logical
// Use lower 5 bits of arg2 for shift amount (0-31)
var shift_amt[4:0];
shift_amt = arg2[4:0];

var result[31:0];
result = arg1 >> shift_amt;

// Set return value as primitive
eval_reg = result;
eval_tag = 1'b1;

// Pop continuation and return
aspect ../aspects/cont_pop.isa gates pc, csp, cstack, env_clo, env_args, lsp, eval_reg, eval_tag, heap;
