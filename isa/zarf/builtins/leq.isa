// SPDX-License-Identifier: BSD-3-Clause
// Zarf (H-Machine) ISA - Less Than or Equal Builtin (0x06)
//
// Tests if first argument is less than or equal to second (signed).
// Returns 1 if true, 0 if false.
// Both arguments must be primitives (eval_tag = 1).

// State declarations
isa_state pc[31:0];
isa_state eval_reg[31:0];
isa_state eval_tag[0:0];
isa_state env_args[31:0];
isa_state csp[19:0];
isa_state lsp[19:0];
isa_state env_clo[31:0];
mem imem[14:0];
mem heap[19:0];
mem cstack[19:0];

// Read arguments from environment
var arg1[31:0];
var arg2[31:0];

arg1 = heap[env_args];
arg2 = heap[env_args + 1];

// Perform signed less-than-or-equal comparison
var is_leq[0:0];
is_leq = (arg1 <=s arg2);

// Set return value as primitive (1 or 0)
var result[31:0];
result = {{31{1'b0}}, is_leq};

eval_reg = result;
eval_tag = 1'b1;

// Pop continuation and return
aspect ../aspects/cont_pop.isa gates pc, csp, cstack, env_clo, env_args, lsp, eval_reg, eval_tag, heap;
