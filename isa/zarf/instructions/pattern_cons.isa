// SPDX-License-Identifier: BSD-3-Clause
// Zarf (H-Machine) ISA - Pattern Constructor Instruction
//
// Opcode: 0x5 (binary 101)
// Format: [31:29]=opcode, [28:19]=n_skip, [18:16]=unused, [15:0]=cons_tag
//
// Tests if the scrutinized value (in eval_reg) is a constructor with the
// specified tag.
// - If match: advance PC by 1 to execute the pattern body
// - If no match: advance PC by 1 + n_skip to try next pattern
//
// The scrutinized value must be a heap reference (eval_tag = 0) to a
// constructor object whose header has the isConstructor bit set and
// whose tag field matches cons_tag.
//
// Constructor heap object format:
//   Word 0 (header): [31]=isConstructor(1), [30:16]=arity, [15:0]=tag
//   Words 1..n: constructor fields

// State declarations
isa_state pc[31:0];
isa_state eval_reg[31:0];
isa_state eval_tag[0:0];
mem imem[14:0];
mem heap[19:0];

// Instruction decode
var instr[31:0];
var opcode[2:0];
var n_skip[9:0];
var cons_tag[15:0];

// Fetch instruction
instr = imem[pc];
opcode = instr[31:29];

// Verify this is a pattern_cons instruction
assume opcode == 3'b101;

// Extract fields
n_skip = instr[28:19];
cons_tag = instr[15:0];

// Read object header from heap (only valid if eval_tag = 0)
var obj_header[31:0];
obj_header = heap[eval_reg];

// Check if this is a constructor and extract tag
var obj_is_constructor[0:0];
var obj_tag[15:0];

obj_is_constructor = obj_header[31];
obj_tag = obj_header[15:0];

// Check for match:
// 1. Must be a heap reference (eval_tag = 0)
// 2. Must be a constructor (bit 31 = 1)
// 3. Tag must match
var pat_cons_match[0:0];
pat_cons_match = (~eval_tag) & obj_is_constructor & (obj_tag == cons_tag);

// Compute next PC
var pc_match[31:0];
var pc_no_match[31:0];

pc_match = pc + 1;
pc_no_match = pc + 1 + {{22{1'b0}}, n_skip};

pc = pat_cons_match ? pc_match : pc_no_match;
