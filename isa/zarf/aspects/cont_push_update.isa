// SPDX-License-Identifier: BSD-3-Clause
// Zarf (H-Machine) ISA - Push Update Continuation Aspect
//
// Pushes an update continuation frame onto the continuation stack.
// Update continuations are used when entering a thunk. When the thunk
// finishes evaluating, the result is written back to overwrite the thunk
// (memoization for lazy evaluation).
//
// Continuation frame format (5 words):
//   Word 0: [31:30]=type(10), [29:0]=saved_pc
//   Word 1: thunk_addr (heap address to update)
//   Word 2: reserved
//   Word 3: [19:0]=saved_lsp
//   Word 4: [19:0]=saved_lb
//
// Requires before inclusion:
//   update_thunk_addr[31:0] - Address of thunk to update
//
// Gates: pc, lsp, lb, csp, cstack, update_thunk_addr

var update_cont_type[1:0];
update_cont_type = 2'b10;  // Update continuation = type 2

// Build continuation frame
var update_cont_word0[31:0];
update_cont_word0 = {update_cont_type, pc[29:0]};

// Push frame to continuation stack
cstack[csp] = update_cont_word0;
cstack[csp + 1] = update_thunk_addr;
cstack[csp + 2] = 32'b0;  // Reserved
cstack[csp + 3] = {{12{1'b0}}, lsp};
cstack[csp + 4] = {{12{1'b0}}, lb};

// Advance stack pointer
csp = csp + 5;
