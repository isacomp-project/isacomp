// SPDX-License-Identifier: BSD-3-Clause
// MMIX ADDUI - Add Unsigned Immediate (no overflow trap)
// ADDUI $X,$Y,Z: $X = $Y + Z (unsigned, no overflow)
// Opcode: 0x23

isa_state pc[63:0];
var instr[31:0];
isa_state rf[63:0][7:0];
mem umem[14:0];

var x[7:0];
var y[7:0];
var z[7:0];
var y_val[63:0];
var z_ext[63:0];
var result[63:0];

instr = umem[pc];
assume instr[31:24] == 0x23;

x = instr[23:16];
y = instr[15:8];
z = instr[7:0];

y_val = rf[y];
z_ext = {56'b0, z};
result = y_val + z_ext;

rf[x] = result;
pc = pc + 4;
