// MMIX PREST - Prestore Data
// PREST X,$Y,$Z: hint that X+1 bytes at $Y+$Z will be stored
// Opcode: 0xBA
// Note: No-op in simple model (cache hint)

isa_state pc[63:0];
var instr[31:0];
mem umem[14:0];

instr = umem[pc];
assume instr[31:24] == 0xBA;

pc = pc + 4;
