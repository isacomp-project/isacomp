// MMIX UNSAVE - Restore Process State
// UNSAVE 0,$Z: restore all state from memory
// Opcode: 0xFB

isa_state pc[63:0];
var instr[31:0];
isa_state rf[63:0][7:0];
isa_state rO[63:0];
mem umem[14:0];

var z[7:0];
var z_val[63:0];

instr = umem[pc];
assume instr[31:24] == 0xFB;

z = instr[7:0];

z_val = rf[z];

// Restore the stack offset from $Z
rO = z_val;

pc = pc + 4;
