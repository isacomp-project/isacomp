// SPDX-License-Identifier: BSD-3-Clause
// MMIX PUSHGOI - Push Registers and Go Immediate
// PUSHGOI $X,$Y,Z: push local registers and jump to $Y+Z
// Opcode: 0xBF

isa_state pc[63:0];
var instr[31:0];
isa_state rf[63:0][7:0];
isa_state rJ[63:0];
mem umem[14:0];

var x[7:0];
var y[7:0];
var z[7:0];
var y_val[63:0];
var z_ext[63:0];
var target[63:0];

instr = umem[pc];
assume instr[31:24] == 0xBF;

x = instr[23:16];
y = instr[15:8];
z = instr[7:0];

y_val = rf[y];
z_ext = {56'h0, z};

rJ = pc + 4;
rf[x] = pc + 4;

target = y_val + z_ext;
pc = target;
