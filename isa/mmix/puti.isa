// MMIX PUTI - Put Immediate to Special Register
// PUTI rX,Z: special register X = Z
// Opcode: 0xF7

isa_state pc[63:0];
var instr[31:0];
isa_state rf[63:0][7:0];
isa_state rA[63:0];
isa_state rG[63:0];
isa_state rL[63:0];
isa_state rM[63:0];
mem umem[14:0];

var x[7:0];
var z[7:0];
var z_ext[63:0];

instr = umem[pc];
assume instr[31:24] == 0xF7;
assume instr[15:8] == 8'h0;

x = instr[23:16];
z = instr[7:0];

z_ext = {56'h0, z};

rA = (x == 8'd7) ? z_ext : rA;
rG = (x == 8'd9) ? z_ext : rG;
rL = (x == 8'd10) ? z_ext : rL;
rM = (x == 8'd5) ? z_ext : rM;

pc = pc + 4;
