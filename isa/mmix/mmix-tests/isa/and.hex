// MMIX AND instruction test
// Test: AND $3,$1,$2 where $1=0xFF, $2=0x0F, expect $3=0x0F

// Address 0x00: SETL $1, 0xFF    (E3 01 00 FF)
E30100FF
// Address 0x04: SETL $2, 0x0F    (E3 02 00 0F)
E302000F
// Address 0x08: AND $3,$1,$2     (C8 03 01 02)
C8030102
// Address 0x0C: SETL $4, 0x0F    (E3 04 00 0F) - expected result
E304000F
// Address 0x10: SUB $5,$3,$4     (24 05 03 04)
24050304
// Address 0x14: BZ $5, +2        (42 05 00 02)
42050002
// Address 0x18: JMP +2           (F0 00 00 02)
F0000002
// Address 0x1C: JMP +1           (F0 00 00 01)
F0000001
// Address 0x20: pass
F0000000
// Address 0x24: fail
F0000000
