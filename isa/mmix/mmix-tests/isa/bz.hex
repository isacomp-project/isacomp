// MMIX BZ (Branch if Zero) instruction test
// Test: BZ branches when register is zero

// Address 0x00: SETL $1, 0       (E3 01 00 00)
E3010000
// Address 0x04: BZ $1, +3        (42 01 00 03) - should branch to 0x10
42010003
// Address 0x08: JMP +4           (F0 00 00 04) - skip to fail if not taken
F0000004
// Address 0x0C: nop              (C0 00 00 00) - OR $0,$0,$0
C0000000
// Address 0x10: JMP +1           (F0 00 00 01) - go to pass
F0000001
// Address 0x14: pass
F0000000
// Address 0x18: fail
F0000000
