// SPDX-License-Identifier: BSD-3-Clause
// MMIX TDIFI - Tetra Difference Immediate
// TDIFI $X,$Y,Z: each tetra of $X = max(0, tetra($Y) - Z)
// Opcode: 0xD5

isa_state pc[63:0];
var instr[31:0];
isa_state rf[63:0][7:0];
mem umem[14:0];

var x[7:0];
var y[7:0];
var z[7:0];
var y_val[63:0];
var z_ext[31:0];
var t0[31:0];
var t1[31:0];
var result[63:0];

instr = umem[pc];
assume instr[31:24] == 0xD5;

x = instr[23:16];
y = instr[15:8];
z = instr[7:0];

y_val = rf[y];
z_ext = {24'h0, z};

// Saturating tetra subtraction
t0 = (y_val[31:0] > z_ext) ? (y_val[31:0] - z_ext) : 32'h0;
t1 = (y_val[63:32] > z_ext) ? (y_val[63:32] - z_ext) : 32'h0;

result = {t1, t0};

rf[x] = result;
pc = pc + 4;
