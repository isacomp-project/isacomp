// SPDX-License-Identifier: BSD-3-Clause
// MMIX BDIF - Byte Difference (saturating subtract per byte)
// BDIF $X,$Y,$Z: each byte of $X = max(0, byte($Y) - byte($Z))
// Opcode: 0xD0

isa_state pc[63:0];
var instr[31:0];
isa_state rf[63:0][7:0];
mem umem[14:0];

var x[7:0];
var y[7:0];
var z[7:0];
var y_val[63:0];
var z_val[63:0];
var b0[7:0];
var b1[7:0];
var b2[7:0];
var b3[7:0];
var b4[7:0];
var b5[7:0];
var b6[7:0];
var b7[7:0];
var result[63:0];

instr = umem[pc];
assume instr[31:24] == 0xD0;

x = instr[23:16];
y = instr[15:8];
z = instr[7:0];

y_val = rf[y];
z_val = rf[z];

// Saturating byte subtraction for each byte
b0 = (y_val[7:0] > z_val[7:0]) ? (y_val[7:0] - z_val[7:0]) : 8'h0;
b1 = (y_val[15:8] > z_val[15:8]) ? (y_val[15:8] - z_val[15:8]) : 8'h0;
b2 = (y_val[23:16] > z_val[23:16]) ? (y_val[23:16] - z_val[23:16]) : 8'h0;
b3 = (y_val[31:24] > z_val[31:24]) ? (y_val[31:24] - z_val[31:24]) : 8'h0;
b4 = (y_val[39:32] > z_val[39:32]) ? (y_val[39:32] - z_val[39:32]) : 8'h0;
b5 = (y_val[47:40] > z_val[47:40]) ? (y_val[47:40] - z_val[47:40]) : 8'h0;
b6 = (y_val[55:48] > z_val[55:48]) ? (y_val[55:48] - z_val[55:48]) : 8'h0;
b7 = (y_val[63:56] > z_val[63:56]) ? (y_val[63:56] - z_val[63:56]) : 8'h0;

result = {b7, b6, b5, b4, b3, b2, b1, b0};

rf[x] = result;
pc = pc + 4;
