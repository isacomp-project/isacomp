// MMIX PRELDI - Preload Data Immediate
// PRELDI X,$Y,Z: hint to preload X+1 bytes at $Y+Z
// Opcode: 0x9B
// Note: No-op in simple model (cache hint)

isa_state pc[63:0];
var instr[31:0];
mem umem[14:0];

instr = umem[pc];
assume instr[31:24] == 0x9B;

pc = pc + 4;
