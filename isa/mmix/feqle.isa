// MMIX FEQLE - Floating Equal with Epsilon
// FEQLE $X,$Y,$Z: $X = (|$Y - $Z| <= rE) ? 1 : 0
// Opcode: 0x12
// Note: Simplified - same as FEQL for now

isa_state pc[63:0];
var instr[31:0];
isa_state rf[63:0][7:0];
mem umem[14:0];

var x[7:0];
var y[7:0];
var z[7:0];
var y_val[63:0];
var z_val[63:0];
var result[63:0];
var eq[0:0];

instr = umem[pc];
assume instr[31:24] == 0x12;

x = instr[23:16];
y = instr[15:8];
z = instr[7:0];

y_val = rf[y];
z_val = rf[z];

// FP equality using supported intrinsics (simplified - ignores epsilon rE)
eq = fp_eq_d(y_val, z_val);
result = eq ? 64'd1 : 64'd0;

rf[x] = result;
pc = pc + 4;
