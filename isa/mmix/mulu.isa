// MMIX MULU - Unsigned Multiply (Register-Register)
// MULU $X,$Y,$Z: $X = $Y * $Z (unsigned)
// Opcode: 0x1A

isa_state pc[63:0];
var instr[31:0];
isa_state rf[63:0][7:0];
mem umem[14:0];

var x[7:0];
var y[7:0];
var z[7:0];
var y_val[63:0];
var z_val[63:0];
var result[63:0];

instr = umem[pc];
assume instr[31:24] == 0x1A;

x = instr[23:16];
y = instr[15:8];
z = instr[7:0];

y_val = rf[y];
z_val = rf[z];

result = y_val * z_val;

rf[x] = result;
pc = pc + 4;
