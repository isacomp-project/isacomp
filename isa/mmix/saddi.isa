// SPDX-License-Identifier: BSD-3-Clause
// MMIX SADDI - Sideways Add Immediate
// SADDI $X,$Y,Z: $X = popcount($Y & ~Z)
// Opcode: 0xD9

isa_state pc[63:0];
var instr[31:0];
isa_state rf[63:0][7:0];
mem umem[14:0];

var x[7:0];
var y[7:0];
var z[7:0];
var y_val[63:0];
var z_ext[63:0];
var masked[63:0];
var count[63:0];

instr = umem[pc];
assume instr[31:24] == 0xD9;

x = instr[23:16];
y = instr[15:8];
z = instr[7:0];

y_val = rf[y];
z_ext = {56'h0, z};

masked = y_val & (~z_ext);

// Population count
count = popcount(masked);

rf[x] = count;
pc = pc + 4;
