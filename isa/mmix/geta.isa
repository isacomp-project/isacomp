// SPDX-License-Identifier: BSD-3-Clause
// MMIX GETA - Get Address (forward)
// GETA $X,YZ: $X = PC + 4*YZ
// Opcode: 0xF4

isa_state pc[63:0];
var instr[31:0];
isa_state rf[63:0][7:0];
mem umem[14:0];

var x[7:0];
var yz[15:0];
var offset[63:0];
var result[63:0];

instr = umem[pc];
assume instr[31:24] == 0xF4;

x = instr[23:16];
yz = instr[15:0];

offset = {46'b0, yz, 2'b0};
result = pc + offset;

rf[x] = result;
pc = pc + 4;
