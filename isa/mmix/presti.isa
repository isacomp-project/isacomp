// MMIX PRESTI - Prestore Data Immediate
// PRESTI X,$Y,Z: hint that X+1 bytes at $Y+Z will be stored
// Opcode: 0xBB
// Note: No-op in simple model (cache hint)

isa_state pc[63:0];
var instr[31:0];
mem umem[14:0];

instr = umem[pc];
assume instr[31:24] == 0xBB;

pc = pc + 4;
