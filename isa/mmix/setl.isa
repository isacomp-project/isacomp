// MMIX SETL - Set Low Wyde
// SETL $X,YZ: $X = YZ
// Opcode: 0xE3

isa_state pc[63:0];
var instr[31:0];
isa_state rf[63:0][7:0];
mem umem[14:0];

var x[7:0];
var yz[15:0];
var result[63:0];

instr = umem[pc];
assume instr[31:24] == 0xE3;

x = instr[23:16];
yz = instr[15:0];

result = {48'b0, yz};

rf[x] = result;
pc = pc + 4;
