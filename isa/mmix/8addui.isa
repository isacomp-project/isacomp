// SPDX-License-Identifier: BSD-3-Clause
// MMIX 8ADDUI - 8x Add Unsigned Immediate
// 8ADDUI $X,$Y,Z: $X = ($Y << 3) + Z
// Opcode: 0x2D

isa_state pc[63:0];
var instr[31:0];
isa_state rf[63:0][7:0];
mem umem[14:0];

var x[7:0];
var y[7:0];
var z[7:0];
var y_val[63:0];
var y_shifted[63:0];
var z_ext[63:0];
var result[63:0];

instr = umem[pc];
assume instr[31:24] == 0x2D;

x = instr[23:16];
y = instr[15:8];
z = instr[7:0];

y_val = rf[y];
y_shifted = y_val << 3;
z_ext = {56'b0, z};
result = y_shifted + z_ext;

rf[x] = result;
pc = pc + 4;
