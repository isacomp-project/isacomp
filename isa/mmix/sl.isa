// SPDX-License-Identifier: BSD-3-Clause
// MMIX SL - Shift Left
// SL $X,$Y,$Z: $X = $Y << $Z (shift amount in $Z)
// Opcode: 0x38

isa_state pc[63:0];
var instr[31:0];
isa_state rf[63:0][7:0];
mem umem[14:0];

var x[7:0];
var y[7:0];
var z[7:0];
var y_val[63:0];
var z_val[63:0];
var shamt[5:0];
var result[63:0];

instr = umem[pc];
assume instr[31:24] == 0x38;

x = instr[23:16];
y = instr[15:8];
z = instr[7:0];

y_val = rf[y];
z_val = rf[z];
shamt = z_val[5:0];

result = y_val << shamt;

rf[x] = result;
pc = pc + 4;
