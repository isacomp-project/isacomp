// SPDX-License-Identifier: BSD-3-Clause
// MMIX ZSNPI - Zero or Set if Not Positive Immediate
// ZSNPI $X,$Y,Z: $X = ($Y <= 0) ? Z : 0
// Opcode: 0x7D

isa_state pc[63:0];
var instr[31:0];
isa_state rf[63:0][7:0];
mem umem[14:0];

var x[7:0];
var y[7:0];
var z[7:0];
var y_val[63:0];
var z_ext[63:0];
var cond[0:0];
var is_neg[0:0];
var is_zero[0:0];
var result[63:0];

instr = umem[pc];
assume instr[31:24] == 0x7D;

x = instr[23:16];
y = instr[15:8];
z = instr[7:0];

y_val = rf[y];
z_ext = {56'b0, z};

is_neg = y_val[63];
is_zero = y_val == 0;
cond = is_neg | is_zero;
result = cond ? z_ext : 64'b0;

rf[x] = result;
pc = pc + 4;
