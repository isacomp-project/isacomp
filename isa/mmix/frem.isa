// SPDX-License-Identifier: BSD-3-Clause
// MMIX FREM - Floating-Point Remainder
// FREM $X,$Y,$Z: $X = $Y rem $Z (IEEE remainder)
// Opcode: 0x0C

isa_state pc[63:0];
var instr[31:0];
isa_state rf[63:0][7:0];
isa_state rA[63:0];
mem umem[14:0];

var x[7:0];
var y[7:0];
var z[7:0];
var y_val[63:0];
var z_val[63:0];
var rm[1:0];
var result[63:0];

instr = umem[pc];
assume instr[31:24] == 0x0C;

x = instr[23:16];
y = instr[15:8];
z = instr[7:0];

y_val = rf[y];
z_val = rf[z];
rm = rA[17:16];

result = fp_rem_d(y_val, z_val, {1'b0, rm});

rf[x] = result;
pc = pc + 4;
