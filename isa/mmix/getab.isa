// MMIX GETAB - Get Address (backward)
// GETA $X,YZ: $X = PC + 4 - 4*YZ
// Opcode: 0xF5

isa_state pc[63:0];
var instr[31:0];
isa_state rf[63:0][7:0];
mem umem[14:0];

var x[7:0];
var yz[15:0];
var offset[63:0];
var result[63:0];

instr = umem[pc];
assume instr[31:24] == 0xF5;

x = instr[23:16];
yz = instr[15:0];

offset = {46'b0, yz, 2'b0};
result = pc + 4 - offset;

rf[x] = result;
pc = pc + 4;
