// SPDX-License-Identifier: BSD-3-Clause
// MMIX LDT - Load Tetra (32-bit, signed)
// LDT $X,$Y,$Z: $X = sign_extend(M[$Y + $Z]) (tetra/32-bit)
// Opcode: 0x88

isa_state pc[63:0];
var instr[31:0];
isa_state rf[63:0][7:0];
mem umem[14:0];

var x[7:0];
var y[7:0];
var z[7:0];
var y_val[63:0];
var z_val[63:0];
var addr[63:0];
var data[63:0];
var tetra_val[31:0];
var result[63:0];

instr = umem[pc];
assume instr[31:24] == 0x88;

x = instr[23:16];
y = instr[15:8];
z = instr[7:0];

y_val = rf[y];
z_val = rf[z];

addr = y_val + z_val;
data = umem[addr];
tetra_val = data[31:0];
result = {{32{tetra_val[31]}}, tetra_val};

rf[x] = result;
pc = pc + 4;
