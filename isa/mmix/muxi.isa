// SPDX-License-Identifier: BSD-3-Clause
// MMIX MUXI - Multiplex Immediate
// MUXI $X,$Y,Z: for each bit, $X[i] = rM[i] ? $Y[i] : Z[i]
// Opcode: 0xDB

isa_state pc[63:0];
var instr[31:0];
isa_state rf[63:0][7:0];
isa_state rM[63:0];
mem umem[14:0];

var x[7:0];
var y[7:0];
var z[7:0];
var y_val[63:0];
var z_ext[63:0];
var result[63:0];

instr = umem[pc];
assume instr[31:24] == 0xDB;

x = instr[23:16];
y = instr[15:8];
z = instr[7:0];

y_val = rf[y];
z_ext = {56'h0, z};

// Bitwise multiplex
result = (y_val & rM) | (z_ext & (~rM));

rf[x] = result;
pc = pc + 4;
