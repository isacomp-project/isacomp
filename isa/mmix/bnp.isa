// SPDX-License-Identifier: BSD-3-Clause
// MMIX BNP - Branch if Not Positive (forward)
// BNP $X,YZ: if $X <= 0, PC = PC + 4*YZ
// Opcode: 0x4C

isa_state pc[63:0];
var instr[31:0];
isa_state rf[63:0][7:0];
mem umem[14:0];

var x[7:0];
var yz[15:0];
var x_val[63:0];
var offset[63:0];
var target[63:0];
var cond[0:0];
var is_neg[0:0];
var is_zero[0:0];

instr = umem[pc];
assume instr[31:24] == 0x4C;

x = instr[23:16];
yz = instr[15:0];

x_val = rf[x];
offset = {46'b0, yz, 2'b0};
target = pc + offset;

is_neg = x_val[63];
is_zero = x_val == 0;
cond = is_neg | is_zero;

pc = cond ? target : pc + 4;
