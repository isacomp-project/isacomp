// SPDX-License-Identifier: BSD-3-Clause
// MMIX CMPI - Compare Immediate (signed)
// CMP $X,$Y,Z: $X = ($Y < Z) ? -1 : (($Y > Z) ? 1 : 0)
// Opcode: 0x31
// Z is unsigned immediate (0-255), always non-negative

isa_state pc[63:0];
var instr[31:0];
isa_state rf[63:0][7:0];
mem umem[14:0];

var x[7:0];
var y[7:0];
var z[7:0];
var y_val[63:0];
var z_ext[63:0];
var y_neg[0:0];
var lt[0:0];
var gt[0:0];
var result[63:0];

instr = umem[pc];
assume instr[31:24] == 0x31;

x = instr[23:16];
y = instr[15:8];
z = instr[7:0];

y_val = rf[y];
z_ext = {56'b0, z};

// Sign bit of y (z_ext is always non-negative)
y_neg = y_val[63];

// If y is negative, y < z_ext (since z_ext is non-negative)
// If y is non-negative, compare as unsigned
lt = y_neg || ((!y_neg) && (y_val < z_ext));

// y > z_ext only if y is non-negative and larger
gt = (!y_neg) && (y_val > z_ext);

result = lt ? 64'hFFFFFFFFFFFFFFFF : (gt ? 64'h0000000000000001 : 64'h0000000000000000);

rf[x] = result;
pc = pc + 4;
