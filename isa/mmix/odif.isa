// SPDX-License-Identifier: BSD-3-Clause
// MMIX ODIF - Octa Difference (saturating subtract 64-bit)
// ODIF $X,$Y,$Z: $X = max(0, $Y - $Z)
// Opcode: 0xD6

isa_state pc[63:0];
var instr[31:0];
isa_state rf[63:0][7:0];
mem umem[14:0];

var x[7:0];
var y[7:0];
var z[7:0];
var y_val[63:0];
var z_val[63:0];
var result[63:0];

instr = umem[pc];
assume instr[31:24] == 0xD6;

x = instr[23:16];
y = instr[15:8];
z = instr[7:0];

y_val = rf[y];
z_val = rf[z];

// Saturating 64-bit subtraction
result = (y_val > z_val) ? (y_val - z_val) : 64'h0;

rf[x] = result;
pc = pc + 4;
