// SPDX-License-Identifier: BSD-3-Clause
// MMIX MOR - Multiple Or (8x8 bit matrix multiply over GF(2) with OR)
// MOR $X,$Y,$Z: bit matrix multiply Y*Z using OR instead of XOR
// Opcode: 0xDC

isa_state pc[63:0];
var instr[31:0];
isa_state rf[63:0][7:0];
mem umem[14:0];

var x[7:0];
var y[7:0];
var z[7:0];
var y_val[63:0];
var z_val[63:0];
var result[63:0];

instr = umem[pc];
assume instr[31:24] == 0xDC;

x = instr[23:16];
y = instr[15:8];
z = instr[7:0];

y_val = rf[y];
z_val = rf[z];

// 8x8 bit matrix OR-multiply
// For each result bit [i][j]: OR of (Y[i][k] AND Z[k][j]) for all k
result = bmatrix_or(y_val, z_val);

rf[x] = result;
pc = pc + 4;
