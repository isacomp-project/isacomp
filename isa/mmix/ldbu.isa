// SPDX-License-Identifier: BSD-3-Clause
// MMIX LDBU - Load Byte Unsigned
// LDBU $X,$Y,$Z: $X = zero_extend(M[$Y + $Z]) (byte)
// Opcode: 0x82

isa_state pc[63:0];
var instr[31:0];
isa_state rf[63:0][7:0];
mem umem[14:0];

var x[7:0];
var y[7:0];
var z[7:0];
var y_val[63:0];
var z_val[63:0];
var addr[63:0];
var data[63:0];
var byte_val[7:0];
var result[63:0];

instr = umem[pc];
assume instr[31:24] == 0x82;

x = instr[23:16];
y = instr[15:8];
z = instr[7:0];

y_val = rf[y];
z_val = rf[z];

addr = y_val + z_val;
data = umem[addr];
byte_val = data[7:0];
result = {56'b0, byte_val};

rf[x] = result;
pc = pc + 4;
