// MMIX MXOR - Multiple Xor (8x8 bit matrix multiply over GF(2))
// MXOR $X,$Y,$Z: bit matrix multiply Y*Z using XOR
// Opcode: 0xDE

isa_state pc[63:0];
var instr[31:0];
isa_state rf[63:0][7:0];
mem umem[14:0];

var x[7:0];
var y[7:0];
var z[7:0];
var y_val[63:0];
var z_val[63:0];
var result[63:0];

instr = umem[pc];
assume instr[31:24] == 0xDE;

x = instr[23:16];
y = instr[15:8];
z = instr[7:0];

y_val = rf[y];
z_val = rf[z];

// 8x8 bit matrix XOR-multiply (GF(2) matrix multiply)
result = bmatrix_xor(y_val, z_val);

rf[x] = result;
pc = pc + 4;
