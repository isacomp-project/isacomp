// SPDX-License-Identifier: BSD-3-Clause
// MMIX STSFI - Store Short Float Immediate
// STSFI $X,$Y,Z: M4[$Y + Z] = (short float)$X
// Opcode: 0xB1

isa_state pc[63:0];
var instr[31:0];
isa_state rf[63:0][7:0];
mem umem[14:0];

var x[7:0];
var y[7:0];
var z[7:0];
var x_val[63:0];
var y_val[63:0];
var z_ext[63:0];
var addr[63:0];

instr = umem[pc];
assume instr[31:24] == 0xB1;

x = instr[23:16];
y = instr[15:8];
z = instr[7:0];

x_val = rf[x];
y_val = rf[y];
z_ext = {56'b0, z};
addr = y_val + z_ext;

umem[addr] = {32'b0, x_val[31:0]};
pc = pc + 4;
