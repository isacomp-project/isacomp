// MMIX PREGOI - Preload for GO Immediate
// PREGOI X,$Y,Z: hint to preload instructions at $Y+Z
// Opcode: 0x9D
// Note: No-op in simple model (cache hint)

isa_state pc[63:0];
var instr[31:0];
mem umem[14:0];

instr = umem[pc];
assume instr[31:24] == 0x9D;

pc = pc + 4;
