// MMIX STOUI - Store Octa Unsigned Immediate
// STOUI $X,$Y,Z: M[63:0][$Y + Z] = $X[63:0]
// Opcode: 0xAF

isa_state pc[63:0];
var instr[31:0];
isa_state rf[63:0][7:0];
mem umem[14:0];

var x[7:0];
var y[7:0];
var z[7:0];
var x_val[63:0];
var y_val[63:0];
var z_ext[63:0];
var addr[63:0];

instr = umem[pc];
assume instr[31:24] == 0xAF;

x = instr[23:16];
y = instr[15:8];
z = instr[7:0];

x_val = rf[x];
y_val = rf[y];
z_ext = {56'b0, z};
addr = y_val + z_ext;

umem[addr] = x_val;
pc = pc + 4;
