// SPDX-License-Identifier: BSD-3-Clause
// 65C02 BIT Zero Page,X (0x34) - Bit Test Zero Page Indexed
// Tests bits in memory with accumulator (A AND memory)
// Sets N flag to bit 7 of memory value
// Sets V flag to bit 6 of memory value
// Sets Z flag if (A AND memory) == 0
// Does not affect A register
// Instruction format: BIT $nn,X (2 bytes)
// NOTE: This is a 65C02-only instruction

#ifdef CPU_65C02

isa_state pc[15:0];
var instr[7:0];
isa_state A[7:0];
isa_state X[7:0];
isa_state flag_N[0:0];
isa_state flag_V[0:0];
isa_state flag_Z[0:0];
isa_state mainmem[7:0][15:0];

var zp_base[7:0];
var zp_x_addr[7:0];
var data[7:0];
var result[7:0];

instr = mainmem[pc];
assume instr == 0x34;
pc = pc + 1;

// Read zero page base address
zp_base = mainmem[pc];
pc = pc + 1;

// Add X (wraps within zero page)
zp_x_addr = zp_base + X;

// Read memory value
data = mainmem[zp_x_addr];
result = A & data;

// Update flags
flag_N = data[7];      // Bit 7 of memory
flag_V = data[6];      // Bit 6 of memory
flag_Z = result == 0 ? 1'b1 : 1'b0;

#endif
