// SPDX-License-Identifier: BSD-3-Clause
// 6502 CMP ABS,X (0xdd)
// Compare A with memory

isa_state pc[15:0];
var instr[7:0];
isa_state A[7:0];
isa_state X[7:0];
isa_state Y[7:0];
isa_state flag_N[0:0];
isa_state flag_Z[0:0];
isa_state flag_C[0:0];
isa_state mainmem[7:0][15:0];

var result[15:0];
var addr_lo[7:0];
var addr_hi[7:0];
var base_addr[15:0];
var abs_x_addr[15:0];
var data[7:0];

instr = mainmem[pc];
assume instr == 0xdd;
pc = pc + 1;

addr_lo = mainmem[pc];
pc = pc + 1;
addr_hi = mainmem[pc];
pc = pc + 1;

base_addr = {addr_hi, addr_lo};
abs_x_addr = base_addr + X;
data = mainmem[abs_x_addr];

result = A - data;

flag_N = result[7];
flag_Z = result[7:0] == 0 ? 1'b1 : 1'b0;
flag_C = result[8] ^ 1'b1;
