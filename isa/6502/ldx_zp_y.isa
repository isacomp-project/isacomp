// SPDX-License-Identifier: BSD-3-Clause
// 6502 LDX Zero Page,Y (0xB6) - Load X Register Zero Page Indexed with Y
// Loads a value from zero page + Y into X register
// Sets N flag if bit 7 is set, sets Z flag if value is zero
// Instruction format: LDX $nn,Y (2 bytes)

isa_state pc[15:0];
var instr[7:0];
isa_state X[7:0];
isa_state Y[7:0];
isa_state flag_N[0:0];
isa_state flag_Z[0:0];
isa_state mainmem[7:0][15:0];

var zp_base[7:0];
var zp_y_addr[7:0];
var data[7:0];

instr = mainmem[pc];
assume instr == 0xB6;
pc = pc + 1;

zp_base = mainmem[pc];
pc = pc + 1;

zp_y_addr = zp_base + Y;
data = mainmem[zp_y_addr];

X = data;
flag_N = data[7];
flag_Z = data == 0 ? 1'b1 : 1'b0;
