// SPDX-License-Identifier: BSD-3-Clause
// 6502 TXS (0x9A) - Transfer X to Stack Pointer
// Copies the value in X register to the Stack Pointer (S)
// Does not affect any flags
// Instruction format: TXS (1 byte)

isa_state pc[15:0];
var instr[7:0];
isa_state X[7:0];
isa_state S[7:0];
isa_state mainmem[7:0][15:0];

instr = mainmem[pc];
assume instr == 0x9A;
pc = pc + 1;

S = X;
