// SPDX-License-Identifier: BSD-3-Clause
// 6502 CLC (0x18) - Clear Carry Flag
// Sets the carry flag to 0
// Does not affect any other flags
// Instruction format: CLC (1 byte)

isa_state pc[15:0];
var instr[7:0];
isa_state flag_C[0:0];
isa_state mainmem[7:0][15:0];

instr = mainmem[pc];
assume instr == 0x18;
pc = pc + 1;

flag_C = 1'b0;
