// SPDX-License-Identifier: BSD-3-Clause
// 6502 RTS - Return from Subroutine (0x60)
// Pull return address from stack and jump to it + 1

isa_state pc[15:0];
var instr[7:0];
isa_state S[7:0];  // Stack pointer
isa_state mainmem[7:0][15:0];

var stack_addr[15:0];
var addr_lo[7:0];
var addr_hi[7:0];
var return_addr[15:0];

instr = mainmem[pc];
assume instr == 0x60;
pc = pc + 1;

// Pull return address from stack (low byte first)
// Use temporary variables to avoid confusing resource graph merger
var S_plus_1[7:0];
var S_plus_2[7:0];
var stack_addr_lo[15:0];
var stack_addr_hi[15:0];

S_plus_1 = S + 1;
S_plus_2 = S_plus_1 + 1;

stack_addr_lo = {8'h01, S_plus_1[7:0]};
addr_lo = mainmem[stack_addr_lo];  // Pull low byte

stack_addr_hi = {8'h01, S_plus_2[7:0]};
addr_hi = mainmem[stack_addr_hi];  // Pull high byte

S = S_plus_2;
return_addr = {addr_hi, addr_lo};

// Jump to return address + 1
pc = return_addr + 1;
