// SPDX-License-Identifier: BSD-3-Clause
// 6502 LDA Absolute,X (0xBD) - Load Accumulator Absolute Indexed with X
// Loads a value from absolute address + X into accumulator
// Sets N flag if bit 7 is set, sets Z flag if value is zero
// Instruction format: LDA $hhll,X (3 bytes)

isa_state pc[15:0];
var instr[7:0];
isa_state A[7:0];
isa_state X[7:0];
isa_state flag_N[0:0];
isa_state flag_Z[0:0];
isa_state mainmem[7:0][15:0];

var addr_lo[7:0];
var addr_hi[7:0];
var base_addr[15:0];
var abs_x_addr[15:0];
var data[7:0];

instr = mainmem[pc];
assume instr == 0xBD;
pc = pc + 1;

addr_lo = mainmem[pc];
pc = pc + 1;
addr_hi = mainmem[pc];
pc = pc + 1;

base_addr = {addr_hi, addr_lo};
abs_x_addr = base_addr + X;

data = mainmem[abs_x_addr];

A = data;
flag_N = data[7];
flag_Z = data == 0 ? 1'b1 : 1'b0;
