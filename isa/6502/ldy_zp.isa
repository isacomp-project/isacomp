// SPDX-License-Identifier: BSD-3-Clause
// 6502 LDY Zero Page (0xA4) - Load Y Register Zero Page
// Loads a value from zero page into Y register
// Sets N flag if bit 7 is set, sets Z flag if value is zero
// Instruction format: LDY $nn (2 bytes)

isa_state pc[15:0];
var instr[7:0];
isa_state Y[7:0];
isa_state flag_N[0:0];
isa_state flag_Z[0:0];
isa_state mainmem[7:0][15:0];

var zp_direct_addr[7:0];
var data[7:0];

instr = mainmem[pc];
assume instr == 0xA4;
pc = pc + 1;

zp_direct_addr = mainmem[pc];
pc = pc + 1;

data = mainmem[zp_direct_addr];

Y = data;
flag_N = data[7];
flag_Z = data == 0 ? 1'b1 : 1'b0;
