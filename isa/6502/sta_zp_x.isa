// SPDX-License-Identifier: BSD-3-Clause
// 6502 STA Zero Page,X (0x95) - Store Accumulator Zero Page Indexed
// Stores accumulator to zero page + X address
// Does not affect any flags
// Instruction format: STA $nn,X (2 bytes)

isa_state pc[15:0];
var instr[7:0];
isa_state A[7:0];
isa_state X[7:0];
isa_state mainmem[7:0][15:0];

var zp_base[7:0];
var zp_x_addr[7:0];

instr = mainmem[pc];
assume instr == 0x95;
pc = pc + 1;

zp_base = mainmem[pc];
pc = pc + 1;

zp_x_addr = zp_base + X;
mainmem[zp_x_addr] = A;
