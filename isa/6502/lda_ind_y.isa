// SPDX-License-Identifier: BSD-3-Clause
// 6502 LDA Indirect Indexed (0xB1) - Load Accumulator Indirect Indexed
// Loads from (address stored at zp) + Y
// Address = (mainmem[zp] + mainmem[zp+1] * 256) + Y
// Sets N flag if bit 7 is set, sets Z flag if value is zero
// Instruction format: LDA ($nn),Y (2 bytes)

isa_state pc[15:0];
var instr[7:0];
isa_state A[7:0];
isa_state Y[7:0];
isa_state flag_N[0:0];
isa_state flag_Z[0:0];
isa_state mainmem[7:0][15:0];

var zp_direct_addr[7:0];
var base_lo[7:0];
var base_hi[7:0];
var base_addr[15:0];
var ind_y_target_addr[15:0];
var data[7:0];

instr = mainmem[pc];
assume instr == 0xB1;
pc = pc + 1;

zp_direct_addr = mainmem[pc];
pc = pc + 1;

// Read base address from zero page
base_lo = mainmem[zp_direct_addr];
base_hi = mainmem[zp_direct_addr + 1];
base_addr = {base_hi, base_lo};

// Add Y to get target address
ind_y_target_addr = base_addr + Y;

// Load from target address
data = mainmem[ind_y_target_addr];

A = data;
flag_N = data[7];
flag_Z = data == 0 ? 1'b1 : 1'b0;
