// SPDX-License-Identifier: BSD-3-Clause
// 65C02 JMP Absolute Indexed Indirect (0x7C) - Jump Indexed Indirect
// Jumps to address stored at (given address + X)
// Used for jump tables: JMP (TABLE,X) where X selects the entry
// Instruction format: JMP ($hhll,X) (3 bytes)
// NOTE: This is a 65C02-only instruction

#ifdef CPU_65C02

isa_state pc[15:0];
var instr[7:0];
isa_state X[7:0];
isa_state mainmem[7:0][15:0];

var pc_plus_1[15:0];
var pc_plus_2[15:0];
var base_addr_lo[7:0];
var base_addr_hi[7:0];
var base_addr[15:0];
var ind_addr[15:0];
var target_lo[7:0];
var target_hi[7:0];
var target_addr[15:0];

instr = mainmem[pc];
assume instr == 0x7C;

// Read base address
pc_plus_1 = pc + 1;
pc_plus_2 = pc_plus_1 + 1;

base_addr_lo = mainmem[pc_plus_1];
base_addr_hi = mainmem[pc_plus_2];

base_addr = {base_addr_hi, base_addr_lo};

// Add X to get indirect address
ind_addr = base_addr + X;

// Read target address from indirect address
target_lo = mainmem[ind_addr];
target_hi = mainmem[ind_addr + 1];

target_addr = {target_hi, target_lo};

// Jump to target
pc = target_addr;

#endif
