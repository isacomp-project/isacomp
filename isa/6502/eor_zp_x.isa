// SPDX-License-Identifier: BSD-3-Clause
// 6502 EOR - Exclusive OR with Zero Page,X addressing (0x55)
// A = A XOR mainmem[zp_addr + X]

isa_state pc[15:0];
var instr[7:0];
isa_state A[7:0];
isa_state X[7:0];
isa_state mainmem[7:0][15:0];
isa_state flag_N[0:0];
isa_state flag_Z[0:0];

var zp_base[7:0];
var zp_x_addr[7:0];
var data[7:0];
var result[15:0];

instr = mainmem[pc];
assume instr == 0x55;
pc = pc + 1;

// Read zero page base address
zp_base = mainmem[pc];
pc = pc + 1;

// Add X to get effective address (stays in zero page)
zp_x_addr = zp_base + X;

// Read data from zero page
data = mainmem[zp_x_addr];

// XOR with A
result = A ^ data;

// Store result
A = result;

// Update flags
flag_N = result[7];
flag_Z = result == 0 ? 1'b1 : 1'b0;
