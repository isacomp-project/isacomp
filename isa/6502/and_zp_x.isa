// SPDX-License-Identifier: BSD-3-Clause
// 6502 AND zp,X (0x35)
// A = A & mainmem

isa_state pc[15:0];
var instr[7:0];
isa_state A[7:0];
isa_state X[7:0];
isa_state Y[7:0];
isa_state flag_N[0:0];
isa_state flag_Z[0:0];
isa_state mainmem[7:0][15:0];

var zp_x_addr[7:0];
var zp_base[7:0];
var addr_lo[7:0];
var addr_hi[7:0];
var target_lo[7:0];
var target_hi[7:0];
var base_lo[7:0];
var base_hi[7:0];
var data[7:0];
var result[15:0];

instr = mainmem[pc];
assume instr == 0x35;
pc = pc + 1;

zp_base = mainmem[pc];
pc = pc + 1;
data = mainmem[zp_base + X];

result = A & data;

flag_N = result[7];
flag_Z = result == 0 ? 1'b1 : 1'b0;

A = result;
