isa_state pc[15:0];
var instr[7:0];
isa_state A[7:0];
isa_state mainmem[7:0][15:0];
isa_state flag_N[0:0];
isa_state flag_Z[0:0];

var zp_direct_addr[7:0];
var data[7:0];
var result[15:0];

instr = mainmem[pc];
assume instr == 0x05;
pc = pc + 1;
zp_direct_addr = mainmem[pc];
pc = pc + 1;

data = mainmem[zp_direct_addr];
result = A | data;

A = result;

flag_N = result[7];
flag_Z = result == 0 ? 1'b1 : 1'b0;
