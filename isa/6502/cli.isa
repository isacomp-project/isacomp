// SPDX-License-Identifier: BSD-3-Clause
// 6502 CLI (0x58) - Clear Interrupt Disable Flag
// Sets the interrupt disable flag to 0 (enables interrupts)
// Does not affect any other flags
// Instruction format: CLI (1 byte)

isa_state pc[15:0];
var instr[7:0];
isa_state flag_I[0:0];
isa_state mainmem[7:0][15:0];

instr = mainmem[pc];
assume instr == 0x58;
pc = pc + 1;

flag_I = 1'b0;
