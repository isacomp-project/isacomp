// SPDX-License-Identifier: BSD-3-Clause
// 6502 STA Indexed Indirect (0x81) - Store Accumulator Indexed Indirect
// Stores accumulator to address stored at (zp + X)
// Address = mainmem[(zp + X)] + mainmem[(zp + X + 1)] * 256
// Does not affect any flags
// Instruction format: STA ($nn,X) (2 bytes)

isa_state pc[15:0];
var instr[7:0];
isa_state A[7:0];
isa_state X[7:0];
isa_state mainmem[7:0][15:0];

var zp_base[7:0];
var ind_x_zp_addr[7:0];
var target_lo[7:0];
var target_hi[7:0];
var ind_x_target_addr[15:0];

instr = mainmem[pc];
assume instr == 0x81;
pc = pc + 1;

zp_base = mainmem[pc];
pc = pc + 1;

ind_x_zp_addr = zp_base + X;

target_lo = mainmem[ind_x_zp_addr];
target_hi = mainmem[ind_x_zp_addr + 1];
ind_x_target_addr = {target_hi, target_lo};

mainmem[ind_x_target_addr] = A;
