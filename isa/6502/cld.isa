// SPDX-License-Identifier: BSD-3-Clause
// 6502 CLD (0xD8) - Clear Decimal Mode Flag
// Sets the decimal mode flag to 0 (binary mode)
// Does not affect any other flags
// Note: This implementation doesn't support BCD arithmetic, so this is mostly a no-op
// Instruction format: CLD (1 byte)

isa_state pc[15:0];
var instr[7:0];
isa_state flag_D[0:0];
isa_state mainmem[7:0][15:0];

instr = mainmem[pc];
assume instr == 0xD8;
pc = pc + 1;

flag_D = 1'b0;
