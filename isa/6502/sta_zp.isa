// SPDX-License-Identifier: BSD-3-Clause
// 6502 STA Zero Page (0x85) - Store Accumulator Zero Page
// Stores accumulator value to zero page address
// Does not affect any flags
// Instruction format: STA $nn (2 bytes)

isa_state pc[15:0];
var instr[7:0];
isa_state A[7:0];
isa_state mainmem[7:0][15:0];

var zp_direct_addr[7:0];

instr = mainmem[pc];
assume instr == 0x85;
pc = pc + 1;

zp_direct_addr = mainmem[pc];
pc = pc + 1;

mainmem[zp_direct_addr] = A;
