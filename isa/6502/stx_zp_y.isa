// SPDX-License-Identifier: BSD-3-Clause
// 6502 STX Zero Page,Y (0x96) - Store X Register Zero Page Indexed
// Stores X register to zero page + Y address
// Does not affect any flags
// Instruction format: STX $nn,Y (2 bytes)

isa_state pc[15:0];
var instr[7:0];
isa_state X[7:0];
isa_state Y[7:0];
isa_state mainmem[7:0][15:0];

var zp_base[7:0];
var zp_y_addr[7:0];

instr = mainmem[pc];
assume instr == 0x96;
pc = pc + 1;

zp_base = mainmem[pc];
pc = pc + 1;

zp_y_addr = zp_base + Y;
mainmem[zp_y_addr] = X;
