// SPDX-License-Identifier: BSD-3-Clause
// 65C02 EOR Zero Page Indirect (0x52) - XOR Zero Page Indirect
// XORs accumulator with value at address stored in zero page
// Address = mainmem[zp] + mainmem[zp+1] * 256
// Sets N flag if bit 7 is set, sets Z flag if result is zero
// Instruction format: EOR ($nn) (2 bytes)
// NOTE: This is a 65C02-only instruction

#ifdef CPU_65C02

isa_state pc[15:0];
var instr[7:0];
isa_state A[7:0];
isa_state flag_N[0:0];
isa_state flag_Z[0:0];
isa_state mainmem[7:0][15:0];

var zp_addr[7:0];
var addr_lo[7:0];
var addr_hi[7:0];
var target_addr[15:0];
var data[7:0];
var result[7:0];

instr = mainmem[pc];
assume instr == 0x52;
pc = pc + 1;

// Read zero page pointer address
zp_addr = mainmem[pc];
pc = pc + 1;

// Read target address from zero page
addr_lo = mainmem[zp_addr];
addr_hi = mainmem[zp_addr + 1];
target_addr = {addr_hi, addr_lo};

// Load from target address and XOR
data = mainmem[target_addr];
result = A ^ data;

A = result;
flag_N = result[7];
flag_Z = result == 0 ? 1'b1 : 1'b0;

#endif
