// SPDX-License-Identifier: BSD-3-Clause
// 6502 RTI (0x40) - Return from Interrupt
// Pulls processor status and return address from stack
// Stack pointer (S) is incremented 3 times
// Restores all flags and jumps to return address
// Instruction format: RTI (1 byte)
//
// Stack layout (pushed by interrupt):
//   [S+1]: Status register (N V 1 B D I Z C)
//   [S+2]: PC low byte
//   [S+3]: PC high byte

isa_state pc[15:0];
var instr[7:0];
isa_state S[7:0];  // Stack pointer
isa_state flag_N[0:0];
isa_state flag_V[0:0];
isa_state flag_D[0:0];
isa_state flag_I[0:0];
isa_state flag_Z[0:0];
isa_state flag_C[0:0];
isa_state mainmem[7:0][15:0];

var rti_status_stack_addr[15:0];
var rti_pcl_stack_addr[15:0];
var rti_pch_stack_addr[15:0];
var status[7:0];
var addr_lo[7:0];
var addr_hi[7:0];
var return_addr[15:0];
var new_S1[7:0];
var new_S2[7:0];
var new_S3[7:0];

instr = mainmem[pc];
assume instr == 0x40;
pc = pc + 1;

// Calculate all three stack addresses upfront
// S+1: status, S+2: PC low, S+3: PC high
new_S1 = S + 1;
new_S2 = new_S1 + 1;
new_S3 = new_S2 + 1;

// Set up addresses for each read
rti_status_stack_addr = {8'h01, new_S1[7:0]};
rti_pcl_stack_addr = {8'h01, new_S2[7:0]};
rti_pch_stack_addr = {8'h01, new_S3[7:0]};

// Read from stack
status = mainmem[rti_status_stack_addr];
addr_lo = mainmem[rti_pcl_stack_addr];
addr_hi = mainmem[rti_pch_stack_addr];

// Update S only once at the end (incremented by 3)
S = new_S3;

// Restore flags (bits 4 and 5 are ignored)
flag_C = status[0];
flag_Z = status[1];
flag_I = status[2];
flag_D = status[3];
flag_V = status[6];
flag_N = status[7];

// Build return address
return_addr = {addr_hi, addr_lo};

// Jump to return address (no +1 like RTS)
pc = return_addr;
