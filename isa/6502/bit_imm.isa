// SPDX-License-Identifier: BSD-3-Clause
// 65C02 BIT Immediate (0x89) - Bit Test Immediate
// Tests bits in immediate value with accumulator (A AND immediate)
// NOTE: Unlike other BIT modes, immediate does NOT affect N or V flags
// Sets Z flag if (A AND immediate) == 0
// Does not affect A register
// Instruction format: BIT #$nn (2 bytes)
// NOTE: This is a 65C02-only instruction

#ifdef CPU_65C02

isa_state pc[15:0];
var instr[7:0];
isa_state A[7:0];
isa_state flag_Z[0:0];
isa_state mainmem[7:0][15:0];

var imm_data[7:0];
var result[7:0];

instr = mainmem[pc];
assume instr == 0x89;
pc = pc + 1;

// Read immediate value
imm_data = mainmem[pc];
pc = pc + 1;

// Test bits
result = A & imm_data;

// Update Z flag only (N and V are NOT affected in immediate mode)
flag_Z = result == 0 ? 1'b1 : 1'b0;

#endif
