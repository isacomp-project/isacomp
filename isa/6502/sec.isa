// SPDX-License-Identifier: BSD-3-Clause
// 6502 SEC (0x38) - Set Carry Flag
// Sets the carry flag to 1
// Does not affect any other flags
// Instruction format: SEC (1 byte)

isa_state pc[15:0];
var instr[7:0];
isa_state flag_C[0:0];
isa_state mainmem[7:0][15:0];

instr = mainmem[pc];
assume instr == 0x38;
pc = pc + 1;

flag_C = 1'b1;
