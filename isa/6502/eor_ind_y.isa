// 6502 EOR (zp),Y (0x51)
// A = A ^ mainmem

isa_state pc[15:0];
var instr[7:0];
isa_state A[7:0];
isa_state X[7:0];
isa_state Y[7:0];
isa_state flag_N[0:0];
isa_state flag_Z[0:0];
isa_state mainmem[7:0][15:0];

var zp_direct_addr[7:0];
var zp_base[7:0];
var addr_lo[7:0];
var addr_hi[7:0];
var target_lo[7:0];
var target_hi[7:0];
var base_lo[7:0];
var base_hi[7:0];
var data[7:0];
var result[15:0];

instr = mainmem[pc];
assume instr == 0x51;
pc = pc + 1;

zp_direct_addr = mainmem[pc];
pc = pc + 1;
base_lo = mainmem[zp_direct_addr];
base_hi = mainmem[zp_direct_addr + 1];
data = mainmem[{base_hi, base_lo} + Y];

result = A ^ data;

flag_N = result[7];
flag_Z = result == 0 ? 1'b1 : 1'b0;

A = result;
