// SPDX-License-Identifier: BSD-3-Clause
// 6502 ASL A (0x0A) - Arithmetic Shift Left (Accumulator)
// Shifts the accumulator left by 1 bit
// Bit 0 is set to 0, bit 7 is shifted into Carry
// Sets N flag if bit 7 of result is set
// Sets Z flag if result is zero
// Sets C flag to old bit 7
// Instruction format: ASL A (1 byte)

isa_state pc[15:0];
var instr[7:0];
isa_state A[7:0];
isa_state flag_N[0:0];
isa_state flag_Z[0:0];
isa_state flag_C[0:0];
isa_state mainmem[7:0][15:0];

var result[15:0];

instr = mainmem[pc];
assume instr == 0x0A;
pc = pc + 1;

// Shift left: bit 7 -> Carry, bits 6-0 -> bits 7-1, 0 -> bit 0
result = A << 1;

// Update flags
flag_C = A[7];           // Old bit 7 goes to Carry
flag_N = result[7];      // Bit 7 of result
flag_Z = result == 0 ? 1'b1 : 1'b0;

// Update accumulator
A = result[7:0];
