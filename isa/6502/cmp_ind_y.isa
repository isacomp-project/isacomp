// SPDX-License-Identifier: BSD-3-Clause
// 6502 CMP IND,Y (0xd1)
// Compare A with memory

isa_state pc[15:0];
var instr[7:0];
isa_state A[7:0];
isa_state X[7:0];
isa_state Y[7:0];
isa_state flag_N[0:0];
isa_state flag_Z[0:0];
isa_state flag_C[0:0];
isa_state mainmem[7:0][15:0];

var result[15:0];
var zp_direct_addr[7:0];
var base_lo[7:0];
var base_hi[7:0];
var base_addr[15:0];
var ind_y_target_addr[15:0];
var data[7:0];

instr = mainmem[pc];
assume instr == 0xd1;
pc = pc + 1;

zp_direct_addr = mainmem[pc];
pc = pc + 1;

base_lo = mainmem[zp_direct_addr];
base_hi = mainmem[zp_direct_addr + 1];
base_addr = {base_hi, base_lo};
ind_y_target_addr = base_addr + Y;
data = mainmem[ind_y_target_addr];

result = A - data;

flag_N = result[7];
flag_Z = result[7:0] == 0 ? 1'b1 : 1'b0;
flag_C = result[8] ^ 1'b1;
