// SPDX-License-Identifier: BSD-3-Clause
// 6502 ROR A (0x6A) - Rotate Right through Carry (Accumulator)
// Rotates the accumulator right by 1 bit through carry
// Old Carry goes to bit 7, bit 0 goes to new Carry
// Sets N flag if bit 7 of result is set (same as old Carry)
// Sets Z flag if result is zero
// Sets C flag to old bit 0
// Instruction format: ROR A (1 byte)

isa_state pc[15:0];
var instr[7:0];
isa_state A[7:0];
isa_state flag_N[0:0];
isa_state flag_Z[0:0];
isa_state flag_C[0:0];
isa_state mainmem[7:0][15:0];

var result[15:0];
var ror_acc_old_carry[0:0];

instr = mainmem[pc];
assume instr == 0x6A;
pc = pc + 1;

// Save old carry
ror_acc_old_carry = flag_C;

// Rotate right: bit 0 -> Carry, bits 7-1 -> bits 6-0, old Carry -> bit 7
result = {ror_acc_old_carry, A[7:1]};

// Update flags
flag_C = A[0];           // Old bit 0 goes to new Carry
flag_N = result[7];      // Bit 7 of result (same as old carry)
flag_Z = result == 0 ? 1'b1 : 1'b0;

// Update accumulator
A = result;
