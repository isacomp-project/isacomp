isa_state pc[15:0];
var instr[7:0];
isa_state A[7:0];
isa_state mainmem[7:0][15:0];
isa_state flag_N[0:0];
isa_state flag_Z[0:0];

var imm[7:0];

instr = mainmem[pc];
assume instr == 0xA9;
pc = pc + 1;
imm = mainmem[pc];
pc = pc + 1;

A = imm;

flag_N = imm[7];
flag_Z = imm == 0 ? 1'b1 : 1'b0;