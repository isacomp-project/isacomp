// SPDX-License-Identifier: BSD-3-Clause
// 6502 TSX (0xBA) - Transfer Stack Pointer to X
// Copies the stack pointer to the X register
// Sets N flag if bit 7 of result is set
// Sets Z flag if result is zero
// Instruction format: TSX (1 byte)

isa_state pc[15:0];
var instr[7:0];
isa_state S[7:0];
isa_state X[7:0];
isa_state flag_N[0:0];
isa_state flag_Z[0:0];
isa_state mainmem[7:0][15:0];

instr = mainmem[pc];
assume instr == 0xBA;
pc = pc + 1;

// Transfer S to X
X = S;

// Update flags
flag_N = S[7];
flag_Z = S == 0 ? 1'b1 : 1'b0;
