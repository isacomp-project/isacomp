// SPDX-License-Identifier: BSD-3-Clause
// 65C02 PHY (0x5A) - Push Y Register
// Pushes the Y register onto the stack
// Stack pointer (S) is decremented
// Does not affect any flags
// Instruction format: PHY (1 byte)
// NOTE: This is a 65C02-only instruction

#ifdef CPU_65C02

isa_state pc[15:0];
var instr[7:0];
isa_state Y[7:0];
isa_state S[7:0];  // Stack pointer
isa_state mainmem[7:0][15:0];

var stack_addr[15:0];
var new_S[7:0];

instr = mainmem[pc];
assume instr == 0x5A;
pc = pc + 1;

// Push Y to stack (stack is at 0x0100-0x01FF)
stack_addr = {8'h01, S};
mainmem[stack_addr] = Y;

// Decrement stack pointer
new_S = S - 1;
S = new_S;

#endif
