// SPDX-License-Identifier: BSD-3-Clause
// 6502 LDA Indexed Indirect (0xA1) - Load Accumulator Indexed Indirect
// Loads from address stored at (zp + X)
// Address = mainmem[(zp + X)] + mainmem[(zp + X + 1)] * 256
// Sets N flag if bit 7 is set, sets Z flag if value is zero
// Instruction format: LDA ($nn,X) (2 bytes)

isa_state pc[15:0];
var instr[7:0];
isa_state A[7:0];
isa_state X[7:0];
isa_state flag_N[0:0];
isa_state flag_Z[0:0];
isa_state mainmem[7:0][15:0];

var zp_base[7:0];
var ind_x_zp_addr[7:0];
var target_lo[7:0];
var target_hi[7:0];
var ind_x_target_addr[15:0];
var data[7:0];

instr = mainmem[pc];
assume instr == 0xA1;
pc = pc + 1;

zp_base = mainmem[pc];
pc = pc + 1;

// Add X to zero page base (wraps in zero page)
ind_x_zp_addr = zp_base + X;

// Read target address from zero page
target_lo = mainmem[ind_x_zp_addr];
target_hi = mainmem[ind_x_zp_addr + 1];
ind_x_target_addr = {target_hi, target_lo};

// Load from target address
data = mainmem[ind_x_target_addr];

A = data;
flag_N = data[7];
flag_Z = data == 0 ? 1'b1 : 1'b0;
