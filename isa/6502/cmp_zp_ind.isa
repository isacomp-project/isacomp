// SPDX-License-Identifier: BSD-3-Clause
// 65C02 CMP Zero Page Indirect (0xD2) - Compare Zero Page Indirect
// Compares accumulator with value at address stored in zero page
// Address = mainmem[zp] + mainmem[zp+1] * 256
// Sets flags based on A - memory:
//   N = bit 7 of result
//   Z = 1 if A == memory
//   C = 1 if A >= memory (no borrow)
// Does not affect A register
// Instruction format: CMP ($nn) (2 bytes)
// NOTE: This is a 65C02-only instruction

#ifdef CPU_65C02

isa_state pc[15:0];
var instr[7:0];
isa_state A[7:0];
isa_state flag_N[0:0];
isa_state flag_Z[0:0];
isa_state flag_C[0:0];
isa_state mainmem[7:0][15:0];

var zp_addr[7:0];
var addr_lo[7:0];
var addr_hi[7:0];
var target_addr[15:0];
var data[7:0];
var result[8:0];

instr = mainmem[pc];
assume instr == 0xD2;
pc = pc + 1;

// Read zero page pointer address
zp_addr = mainmem[pc];
pc = pc + 1;

// Read target address from zero page
addr_lo = mainmem[zp_addr];
addr_hi = mainmem[zp_addr + 1];
target_addr = {addr_hi, addr_lo};

// Load from target address and compare
data = mainmem[target_addr];
result = A - data;

flag_N = result[7];
flag_Z = result[7:0] == 0 ? 1'b1 : 1'b0;
flag_C = A >= data ? 1'b1 : 1'b0;

#endif
