// SPDX-License-Identifier: BSD-3-Clause
// 6502 PHP (0x08) - Push Processor Status
// Pushes the processor status register onto the stack
// Stack pointer (S) is decremented
// The B flag is set to 1 in the pushed value
// Does not affect any flags
// Instruction format: PHP (1 byte)
//
// Status register layout (bits 7-0): N V 1 B D I Z C
// Bit 7: N (Negative)
// Bit 6: V (Overflow)
// Bit 5: - (unused, always 1)
// Bit 4: B (Break, set to 1 for PHP)
// Bit 3: D (Decimal)
// Bit 2: I (Interrupt Disable)
// Bit 1: Z (Zero)
// Bit 0: C (Carry)

isa_state pc[15:0];
var instr[7:0];
isa_state S[7:0];  // Stack pointer
isa_state flag_N[0:0];
isa_state flag_V[0:0];
isa_state flag_D[0:0];
isa_state flag_I[0:0];
isa_state flag_Z[0:0];
isa_state flag_C[0:0];
isa_state mainmem[7:0][15:0];

var stack_addr[15:0];
var status[7:0];
var new_S[7:0];

instr = mainmem[pc];
assume instr == 0x08;
pc = pc + 1;

// Build status register with B flag set to 1
status = {flag_N, flag_V, 1'b1, 1'b1, flag_D, flag_I, flag_Z, flag_C};

// Push status to stack (stack is at 0x0100-0x01FF)
stack_addr = {8'h01, S};
mainmem[stack_addr] = status;

// Decrement stack pointer
new_S = S - 1;
S = new_S;
