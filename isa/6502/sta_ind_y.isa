// SPDX-License-Identifier: BSD-3-Clause
// 6502 STA Indirect Indexed (0x91) - Store Accumulator Indirect Indexed
// Stores accumulator to (address stored at zp) + Y
// Address = (mainmem[zp] + mainmem[zp+1] * 256) + Y
// Does not affect any flags
// Instruction format: STA ($nn),Y (2 bytes)

isa_state pc[15:0];
var instr[7:0];
isa_state A[7:0];
isa_state Y[7:0];
isa_state mainmem[7:0][15:0];

var zp_direct_addr[7:0];
var base_lo[7:0];
var base_hi[7:0];
var base_addr[15:0];
var ind_y_target_addr[15:0];

instr = mainmem[pc];
assume instr == 0x91;
pc = pc + 1;

zp_direct_addr = mainmem[pc];
pc = pc + 1;

base_lo = mainmem[zp_direct_addr];
base_hi = mainmem[zp_direct_addr + 1];
base_addr = {base_hi, base_lo};

ind_y_target_addr = base_addr + Y;

mainmem[ind_y_target_addr] = A;
