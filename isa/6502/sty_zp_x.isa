// SPDX-License-Identifier: BSD-3-Clause
// 6502 STY Zero Page,X (0x94) - Store Y Register Zero Page Indexed
// Stores Y register to zero page + X address
// Does not affect any flags
// Instruction format: STY $nn,X (2 bytes)

isa_state pc[15:0];
var instr[7:0];
isa_state X[7:0];
isa_state Y[7:0];
isa_state mainmem[7:0][15:0];

var zp_base[7:0];
var zp_x_addr[7:0];

instr = mainmem[pc];
assume instr == 0x94;
pc = pc + 1;

zp_base = mainmem[pc];
pc = pc + 1;

zp_x_addr = zp_base + X;
mainmem[zp_x_addr] = Y;
