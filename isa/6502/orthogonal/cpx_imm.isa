// SPDX-License-Identifier: BSD-3-Clause
// 6502 CPX immediate (0xE0) - Compare X with Memory
// Compares X register with an immediate value
// Affects flags: N, Z, C
// Sets C if X >= immediate value
// Instruction format: CPX #$nn (2 bytes)

isa_state pc[15:0];
var instr[7:0];
isa_state X[7:0];
isa_state flag_N[0:0];
isa_state flag_Z[0:0];
isa_state flag_C[0:0];
isa_state mainmem[7:0][15:0];

var imm[7:0];
var result[8:0];
var no_borrow[0:0];

instr = mainmem[pc];
assume instr == 0xe0;
pc = pc + 1;
imm = mainmem[pc];
pc = pc + 1;

// Compute result (subtract for comparison)
result = X - imm;

// Set flags
flag_N = result[7];
flag_Z = result[7:0] == 0 ? 1'b1 : 1'b0;

// Set carry flag: C=1 if X >= imm (no borrow), C=0 if X < imm (borrow occurred)
no_borrow = result[8] == 0 ? 1'b1 : 1'b0;
flag_C = no_borrow;
