// SPDX-License-Identifier: BSD-3-Clause
// 65C02 STZ Zero Page,X (0x74) - Store Zero to Zero Page Indexed
// Stores the value $00 to zero page + X address
// Does not affect any flags
// Instruction format: STZ $nn,X (2 bytes)
// NOTE: This is a 65C02-only instruction

#ifdef CPU_65C02

isa_state pc[15:0];
var instr[7:0];
isa_state X[7:0];
isa_state mainmem[7:0][15:0];

var zp_base[7:0];
var zp_x_addr[7:0];

instr = mainmem[pc];
assume instr == 0x74;
pc = pc + 1;

zp_base = mainmem[pc];
pc = pc + 1;

zp_x_addr = zp_base + X;
mainmem[zp_x_addr] = 8'h00;

#endif
