// SPDX-License-Identifier: BSD-3-Clause
// 6502 PLP (0x28) - Pull Processor Status
// Pulls the processor status register from the stack
// Stack pointer (S) is incremented
// Restores all flags from stack (except B and unused bit 5)
// Instruction format: PLP (1 byte)
//
// Status register layout (bits 7-0): N V 1 B D I Z C
// Bit 7: N (Negative)
// Bit 6: V (Overflow)
// Bit 5: - (unused, ignored)
// Bit 4: B (Break, ignored on restore)
// Bit 3: D (Decimal)
// Bit 2: I (Interrupt Disable)
// Bit 1: Z (Zero)
// Bit 0: C (Carry)

isa_state pc[15:0];
var instr[7:0];
isa_state S[7:0];  // Stack pointer
isa_state flag_N[0:0];
isa_state flag_V[0:0];
isa_state flag_D[0:0];
isa_state flag_I[0:0];
isa_state flag_Z[0:0];
isa_state flag_C[0:0];
isa_state mainmem[7:0][15:0];

var stack_addr[15:0];
var status[7:0];
var new_S[7:0];

instr = mainmem[pc];
assume instr == 0x28;
pc = pc + 1;

// Pull from stack (stack is at 0x0100-0x01FF)
new_S = S + 1;
stack_addr = {8'h01, new_S[7:0]};
S = new_S;

// Read status from stack
status = mainmem[stack_addr];

// Restore flags (bits 4 and 5 are ignored)
flag_C = status[0];
flag_Z = status[1];
flag_I = status[2];
flag_D = status[3];
flag_V = status[6];
flag_N = status[7];
