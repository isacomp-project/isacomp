// SPDX-License-Identifier: BSD-3-Clause
// 6502 SEI (0x78) - Set Interrupt Disable Flag
// Sets the interrupt disable flag to 1 (disables interrupts)
// Does not affect any other flags
// Instruction format: SEI (1 byte)

isa_state pc[15:0];
var instr[7:0];
isa_state flag_I[0:0];
isa_state mainmem[7:0][15:0];

instr = mainmem[pc];
assume instr == 0x78;
pc = pc + 1;

flag_I = 1'b1;
