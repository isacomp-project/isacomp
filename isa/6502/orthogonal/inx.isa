// SPDX-License-Identifier: BSD-3-Clause
// 6502 INX (0xE8) - Increment X Register
// Increments the X register by one
// Sets N flag if bit 7 of result is set (negative)
// Sets Z flag if result is zero
// Instruction format: INX (1 byte)

isa_state pc[15:0];
var instr[7:0];
isa_state X[7:0];
isa_state mainmem[7:0][15:0];
isa_state flag_N[0:0];
isa_state flag_Z[0:0];

var result[15:0];

instr = mainmem[pc];
assume instr == 0xE8;
pc = pc + 1;

result = X + 1;
X = result[7:0];

flag_N = result[7];
flag_Z = result[7:0] == 0 ? 1'b1 : 1'b0;
