// SPDX-License-Identifier: BSD-3-Clause
// 6502 TAX (0xAA) - Transfer Accumulator to X
// Copies the value in Accumulator (A) to the X register
// Sets N flag if bit 7 of result is set (negative)
// Sets Z flag if result is zero
// Instruction format: TAX (1 byte)

isa_state pc[15:0];
var instr[7:0];
isa_state A[7:0];
isa_state X[7:0];
isa_state flag_N[0:0];
isa_state flag_Z[0:0];
isa_state mainmem[7:0][15:0];

instr = mainmem[pc];
assume instr == 0xAA;
pc = pc + 1;

X = A;
flag_N = A[7];
flag_Z = A == 0 ? 1'b1 : 1'b0;
