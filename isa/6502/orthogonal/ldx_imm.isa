// SPDX-License-Identifier: BSD-3-Clause
// 6502 LDX #imm (0xA2) - Load X Register with Immediate
// Loads the X register with an 8-bit immediate value
// Sets N flag if bit 7 of result is set (negative)
// Sets Z flag if result is zero
// Instruction format: LDX #$nn (2 bytes)

isa_state pc[15:0];
var instr[7:0];
isa_state X[7:0];
isa_state mainmem[7:0][15:0];
isa_state flag_N[0:0];
isa_state flag_Z[0:0];

var imm[7:0];

instr = mainmem[pc];
assume instr == 0xA2;
pc = pc + 1;
imm = mainmem[pc];
pc = pc + 1;

X = imm;

flag_N = imm[7];
flag_Z = imm == 0 ? 1'b1 : 1'b0;
