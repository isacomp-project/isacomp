// SPDX-License-Identifier: BSD-3-Clause
// 6502 BIT Zero Page (0x24) - Bit Test Zero Page
// Tests bits in memory with accumulator (A AND memory)
// Sets N flag to bit 7 of memory value
// Sets V flag to bit 6 of memory value
// Sets Z flag if (A AND memory) == 0
// Does not affect A register
// Instruction format: BIT $nn (2 bytes)

isa_state pc[15:0];
var instr[7:0];
isa_state A[7:0];
isa_state flag_N[0:0];
isa_state flag_V[0:0];
isa_state flag_Z[0:0];
isa_state mainmem[7:0][15:0];

var zp_direct_addr[7:0];
var data[7:0];
var result[15:0];

instr = mainmem[pc];
assume instr == 0x24;
pc = pc + 1;

zp_direct_addr = mainmem[pc];
pc = pc + 1;

data = mainmem[zp_direct_addr];
result = A & data;

// Update flags
flag_N = data[7];      // Bit 7 of memory
flag_V = data[6];      // Bit 6 of memory
flag_Z = result == 0 ? 1'b1 : 1'b0;
