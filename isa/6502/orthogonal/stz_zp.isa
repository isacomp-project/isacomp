// SPDX-License-Identifier: BSD-3-Clause
// 65C02 STZ Zero Page (0x64) - Store Zero to Zero Page
// Stores the value $00 to zero page address
// Does not affect any flags
// Instruction format: STZ $nn (2 bytes)
// NOTE: This is a 65C02-only instruction

#ifdef CPU_65C02

isa_state pc[15:0];
var instr[7:0];
isa_state mainmem[7:0][15:0];

var zp_addr[7:0];

instr = mainmem[pc];
assume instr == 0x64;
pc = pc + 1;

zp_addr = mainmem[pc];
pc = pc + 1;

mainmem[zp_addr] = 8'h00;

#endif
