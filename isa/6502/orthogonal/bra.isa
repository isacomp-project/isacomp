// SPDX-License-Identifier: BSD-3-Clause
// 65C02 BRA (0x80) - Branch Always
// Unconditional relative branch
// Offset is signed 8-bit value relative to PC+2 (after fetching offset byte)
// Does not affect any flags
// Instruction format: BRA offset (2 bytes)
// NOTE: This is a 65C02-only instruction

#ifdef CPU_65C02

isa_state pc[15:0];
var instr[7:0];
isa_state mainmem[7:0][15:0];

var offset[7:0];
var sign_ext_offset[15:0];
var pc_plus_1[15:0];
var pc_plus_2[15:0];
var branch_dest[15:0];

instr = mainmem[pc];
assume instr == 0x80;
pc_plus_1 = pc + 1;
offset = mainmem[pc_plus_1];

sign_ext_offset = {{8{offset[7]}}, offset};
pc_plus_2 = pc_plus_1 + 1;
branch_dest = pc_plus_2 + sign_ext_offset;

// Always branch (unconditional)
pc = branch_dest;

#endif
