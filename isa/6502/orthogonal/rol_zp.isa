// 6502 ROL zp (0x26)
// Rotate Left through Carry memory

isa_state pc[15:0];
var instr[7:0];
isa_state X[7:0];
isa_state flag_N[0:0];
isa_state flag_Z[0:0];
isa_state flag_C[0:0];
isa_state mainmem[7:0][15:0];

var zp_direct_addr[7:0];
var zp_base[7:0];
var addr_lo[7:0];
var addr_hi[7:0];
var addr[15:0];
var base_addr[15:0];
var data[7:0];
var result[15:0];
var rol_zp_old_carry[0:0];

instr = mainmem[pc];
assume instr == 0x26;
pc = pc + 1;

zp_direct_addr = mainmem[pc];
pc = pc + 1;

data = mainmem[zp_direct_addr];
rol_zp_old_carry = flag_C;
result = {data[6:0], rol_zp_old_carry};

flag_C = data[7];
flag_N = result[7];
flag_Z = result == 0 ? 1'b1 : 1'b0;

mainmem[zp_direct_addr] = result[7:0];
