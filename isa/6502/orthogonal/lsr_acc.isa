// SPDX-License-Identifier: BSD-3-Clause
// 6502 LSR A (0x4A) - Logical Shift Right (Accumulator)
// Shifts the accumulator right by 1 bit
// Bit 7 is set to 0, bit 0 is shifted into Carry
// Sets N flag to 0 (always)
// Sets Z flag if result is zero
// Sets C flag to old bit 0
// Instruction format: LSR A (1 byte)

isa_state pc[15:0];
var instr[7:0];
isa_state A[7:0];
isa_state flag_N[0:0];
isa_state flag_Z[0:0];
isa_state flag_C[0:0];
isa_state mainmem[7:0][15:0];

var result[15:0];

instr = mainmem[pc];
assume instr == 0x4A;
pc = pc + 1;

// Shift right: bit 0 -> Carry, bits 7-1 -> bits 6-0, 0 -> bit 7
result = A >> 1;

// Update flags
flag_C = A[0];           // Old bit 0 goes to Carry
flag_N = 1'b0;           // Always 0 for LSR
flag_Z = result == 0 ? 1'b1 : 1'b0;

// Update accumulator
A = result[7:0];
