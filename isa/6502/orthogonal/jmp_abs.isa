// SPDX-License-Identifier: BSD-3-Clause
// 6502 JMP Absolute (0x4C) - Jump to Absolute Address
// Sets PC to the address specified by the operand
// Does not affect any flags
// Instruction format: JMP $nnnn (3 bytes: opcode, addr_lo, addr_hi)

isa_state pc[15:0];
var instr[7:0];
isa_state mainmem[7:0][15:0];

var pc_plus_1[15:0];
var pc_plus_2[15:0];
var addr_lo[7:0];
var addr_hi[7:0];
var target_addr[15:0];

instr = mainmem[pc];
assume instr == 0x4C;

pc_plus_1 = pc + 1;
pc_plus_2 = pc_plus_1 + 1;

addr_lo = mainmem[pc_plus_1];
addr_hi = mainmem[pc_plus_2];

target_addr = {addr_hi, addr_lo};
pc = target_addr;
