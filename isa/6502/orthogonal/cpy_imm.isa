// SPDX-License-Identifier: BSD-3-Clause
// 6502 CPY Immediate (0xC0) - Compare Y Register Immediate
// Compares Y register with immediate value by subtraction
// Sets N flag if bit 7 of result is set
// Sets Z flag if Y equals immediate value
// Sets C flag if Y >= immediate (no borrow)
// Instruction format: CPY #$nn (2 bytes)

isa_state pc[15:0];
var instr[7:0];
isa_state Y[7:0];
isa_state flag_N[0:0];
isa_state flag_Z[0:0];
isa_state flag_C[0:0];
isa_state mainmem[7:0][15:0];

var imm[7:0];
var result[15:0];

instr = mainmem[pc];
assume instr == 0xC0;
pc = pc + 1;

imm = mainmem[pc];
pc = pc + 1;

// Compare Y with immediate (Y - imm)
result = Y - imm;

// Update flags
flag_N = result[7];
flag_Z = result[7:0] == 0 ? 1'b1 : 1'b0;
flag_C = result[8] ^ 1'b1;  // No borrow means C=1
