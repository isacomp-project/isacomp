// SPDX-License-Identifier: BSD-3-Clause
// 6502 STY Zero Page (0x84) - Store Y Register Zero Page
// Stores Y register value to zero page address
// Does not affect any flags
// Instruction format: STY $nn (2 bytes)

isa_state pc[15:0];
var instr[7:0];
isa_state Y[7:0];
isa_state mainmem[7:0][15:0];

var zp_direct_addr[7:0];

instr = mainmem[pc];
assume instr == 0x84;
pc = pc + 1;

zp_direct_addr = mainmem[pc];
pc = pc + 1;

mainmem[zp_direct_addr] = Y;
