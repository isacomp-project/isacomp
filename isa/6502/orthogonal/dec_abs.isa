// SPDX-License-Identifier: BSD-3-Clause
// 6502 DEC Absolute (0xCE) - Decrement Memory (Absolute)
// Decrements an 8-bit value at 16-bit absolute address
// Sets N flag if bit 7 of result is set
// Sets Z flag if result is zero
// Does not affect Carry flag
// Instruction format: DEC $hhll (3 bytes, little-endian address)

isa_state pc[15:0];
var instr[7:0];
isa_state flag_N[0:0];
isa_state flag_Z[0:0];
isa_state mainmem[7:0][15:0];

var addr_lo[7:0];
var addr_hi[7:0];

var data[7:0];
var result[15:0];

instr = mainmem[pc];
assume instr == 0xCE;
pc = pc + 1;

// Read address (little-endian)
addr_lo = mainmem[pc];
pc = pc + 1;
addr_hi = mainmem[pc];
pc = pc + 1;



// Read, decrement, write back
data = mainmem[{addr_hi, addr_lo}];
result = data - 1;

// Update flags
flag_N = result[7];
flag_Z = result[7:0] == 0 ? 1'b1 : 1'b0;

// Write back
mainmem[{addr_hi, addr_lo}] = result[7:0];
