// SPDX-License-Identifier: BSD-3-Clause
// Rockwell 65C02 BBR1 - Branch if Bit 1 Reset
// Branches if bit 1 in zero page location is 0
// Instruction format: BBR1 zp, rel (3 bytes)
// NOTE: This is a Rockwell/WDC 65C02 extension

#ifdef CPU_65C02
#ifdef CPU_65C02_ROCKWELL

isa_state pc[15:0];
var instr[7:0];
isa_state mainmem[7:0][15:0];

var pc_plus_1[15:0];
var pc_plus_2[15:0];
var pc_plus_3[15:0];
var zp_addr[7:0];
var zp_addr_16[15:0];
var mem_val[7:0];
var rel_offset[7:0];
var rel_offset_sext[15:0];
var target_addr[15:0];
var bit_val[0:0];
var mask[7:0];

instr = mainmem[pc];
assume instr == 0x1F;

pc_plus_1 = pc + 1;
pc_plus_2 = pc_plus_1 + 1;
pc_plus_3 = pc_plus_2 + 1;

// Get zero page address and relative offset
zp_addr = mainmem[pc_plus_1];
zp_addr_16 = {8'b0, zp_addr};
rel_offset = mainmem[pc_plus_2];

// Sign-extend relative offset
rel_offset_sext = {{8{rel_offset[7]}}, rel_offset};

// Read memory value and test bit 1
mem_val = mainmem[zp_addr_16];
mask = 8'b00000010;
bit_val = (mem_val & mask) != 0;

// Calculate target address (from PC+3)
target_addr = pc_plus_3 + rel_offset_sext;

// Branch if bit is 0 (reset)
pc = bit_val ? pc_plus_3 : target_addr;

#endif
#endif
