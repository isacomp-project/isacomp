// SPDX-License-Identifier: BSD-3-Clause
// 6502 STX Absolute (0x8E) - Store X Register Absolute
// Stores X register to absolute address
// Does not affect any flags
// Instruction format: STX $hhll (3 bytes)

isa_state pc[15:0];
var instr[7:0];
isa_state X[7:0];
isa_state mainmem[7:0][15:0];

var addr_lo[7:0];
var addr_hi[7:0];


instr = mainmem[pc];
assume instr == 0x8E;
pc = pc + 1;

addr_lo = mainmem[pc];
pc = pc + 1;
addr_hi = mainmem[pc];
pc = pc + 1;


mainmem[{addr_hi, addr_lo}] = X;
