// SPDX-License-Identifier: BSD-3-Clause
// 6502 BIT Absolute (0x2C) - Bit Test Absolute
// Tests bits in memory with accumulator (A AND memory)
// Sets N flag to bit 7 of memory value
// Sets V flag to bit 6 of memory value
// Sets Z flag if (A AND memory) == 0
// Does not affect A register
// Instruction format: BIT $hhll (3 bytes)

isa_state pc[15:0];
var instr[7:0];
isa_state A[7:0];
isa_state flag_N[0:0];
isa_state flag_V[0:0];
isa_state flag_Z[0:0];
isa_state mainmem[7:0][15:0];

var addr_lo[7:0];
var addr_hi[7:0];

var data[7:0];
var result[15:0];

instr = mainmem[pc];
assume instr == 0x2C;
pc = pc + 1;

addr_lo = mainmem[pc];
pc = pc + 1;
addr_hi = mainmem[pc];
pc = pc + 1;


data = mainmem[{addr_hi, addr_lo}];
result = A & data;

// Update flags
flag_N = data[7];
flag_V = data[6];
flag_Z = result == 0 ? 1'b1 : 1'b0;
