// SPDX-License-Identifier: BSD-3-Clause
// 6502 LSR zp,X (0x56)
// Logical Shift Right memory

isa_state pc[15:0];
var instr[7:0];
isa_state X[7:0];
isa_state flag_N[0:0];
isa_state flag_Z[0:0];
isa_state flag_C[0:0];
isa_state mainmem[7:0][15:0];

var zp_x_addr[7:0];
var zp_base[7:0];
var addr_lo[7:0];
var addr_hi[7:0];
var addr[15:0];
var base_addr[15:0];
var data[7:0];
var result[15:0];

instr = mainmem[pc];
assume instr == 0x56;
pc = pc + 1;

zp_base = mainmem[pc];
pc = pc + 1;
zp_x_addr = zp_base + X;

data = mainmem[zp_x_addr];
result = data >> 1;

flag_C = data[0];
flag_N = 1'b0;
flag_Z = result == 0 ? 1'b1 : 1'b0;

mainmem[zp_x_addr] = result[7:0];
