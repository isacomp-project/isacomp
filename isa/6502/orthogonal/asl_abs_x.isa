// SPDX-License-Identifier: BSD-3-Clause
// 6502 ASL abs,X (0x1e)
// Arithmetic Shift Left memory

isa_state pc[15:0];
var instr[7:0];
isa_state X[7:0];
isa_state flag_N[0:0];
isa_state flag_Z[0:0];
isa_state flag_C[0:0];
isa_state mainmem[7:0][15:0];

var zp_addr[7:0];
var zp_base[7:0];
var addr_lo[7:0];
var addr_hi[7:0];
var abs_x_addr[15:0];
var base_addr[15:0];
var data[7:0];
var result[15:0];

instr = mainmem[pc];
assume instr == 0x1e;
pc = pc + 1;

addr_lo = mainmem[pc];
pc = pc + 1;
addr_hi = mainmem[pc];
pc = pc + 1;
base_addr = {addr_hi, addr_lo};
abs_x_addr = base_addr + X;

data = mainmem[abs_x_addr];
result = data << 1;

flag_C = data[7];
flag_N = result[7];
flag_Z = result == 0 ? 1'b1 : 1'b0;

mainmem[abs_x_addr] = result[7:0];
