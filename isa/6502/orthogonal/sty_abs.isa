// SPDX-License-Identifier: BSD-3-Clause
// 6502 STY Absolute (0x8C) - Store Y Register Absolute
// Stores Y register to absolute address
// Does not affect any flags
// Instruction format: STY $hhll (3 bytes)

isa_state pc[15:0];
var instr[7:0];
isa_state Y[7:0];
isa_state mainmem[7:0][15:0];

var addr_lo[7:0];
var addr_hi[7:0];


instr = mainmem[pc];
assume instr == 0x8C;
pc = pc + 1;

addr_lo = mainmem[pc];
pc = pc + 1;
addr_hi = mainmem[pc];
pc = pc + 1;


mainmem[{addr_hi, addr_lo}] = Y;
