// SPDX-License-Identifier: BSD-3-Clause
// 6502 SBC — Subtract with Carry (all addressing modes via orthogon)
//
// Opcodes covered:
//   0xE9 (imm), 0xE5 (zp), 0xF5 (zp,x), 0xED (abs), 0xFD (abs,x),
//   0xF9 (abs,y), 0xE1 (ind,x), 0xF1 (ind,y), 0xF2 (zp_ind)

isa_state pc[15:0];
var instr[7:0];
isa_state A[7:0];
isa_state X[7:0];
isa_state Y[7:0];
isa_state flag_C[0:0];
isa_state flag_V[0:0];
isa_state flag_N[0:0];
isa_state flag_Z[0:0];
#ifdef CPU_6502_BCD
isa_state flag_D[0:0];
#endif
isa_state mainmem[7:0][15:0];

var result[15:0];
var not_carry[0:0];
var bin_result[8:0];  // 9-bit for borrow detection

#ifdef CPU_6502_BCD
// BCD variables
var AL[15:0];
var AL_adj[15:0];
var high_sub[15:0];
var bcd_result[15:0];
#endif

// Fetch and decode
instr = mainmem[pc];
assume instr == 0xE9 | instr == 0xE5 | instr == 0xF5 |
       instr == 0xED | instr == 0xFD | instr == 0xF9 |
       instr == 0xE1 | instr == 0xF1 | instr == 0xF2;
pc = pc + 1;

// Map opcode to addressing mode selector.
// For 6502 group 1 (cc=01), bits [4:2] encode addressing mode:
//   000 -> (ind,x)  = sel 6
//   001 -> zp       = sel 1
//   010 -> imm      = sel 0
//   011 -> abs      = sel 2
//   100 -> (ind),y  = sel 7  (or zp_ind = sel 8 for 0xF2)
//   101 -> zp,x     = sel 3
//   110 -> abs,y    = sel 5
//   111 -> abs,x    = sel 4
var addr_sel[3:0];
addr_sel = instr[4:2] == 3'b000 ? 4'd6 :
           instr[4:2] == 3'b001 ? 4'd1 :
           instr[4:2] == 3'b010 ? 4'd0 :
           instr[4:2] == 3'b011 ? 4'd2 :
           instr[4:2] == 3'b100 ? (instr == 0xF2 ? 4'd8 : 4'd7) :
           instr[4:2] == 3'b101 ? 4'd3 :
           instr[4:2] == 3'b110 ? 4'd5 :
                                  4'd4 ;

// Invoke addressing mode orthogon — data[7:0] and eff_addr[15:0] now in scope
use addr_mode(addr_sel);

// === SBC computation ===
not_carry = flag_C ^ 1'b1;

#ifdef CPU_6502_BCD
// Binary subtraction (used for flags in both modes)
bin_result = A - data - not_carry;

// BCD subtraction algorithm (NMOS style):
// AL = (A & 0x0F) - (data & 0x0F) + C - 1
// if (AL < 0) AL = ((AL - 0x06) & 0x0F) - 0x10
// result = (A & 0xF0) - (data & 0xF0) + AL
// if (result < 0) result = result - 0x60

// Zero-extend nibble/byte operands to 16-bit so subtraction underflow
// correctly sets bit 15 for sign detection
var a_lo_ext[15:0];
var d_lo_ext[15:0];
var a_hi_ext[15:0];
var d_hi_ext[15:0];
a_lo_ext = A[3:0];
d_lo_ext = data[3:0];
a_hi_ext = A & 8'hF0;
d_hi_ext = data & 8'hF0;

// Step 1: Low nibble subtraction
AL = a_lo_ext - d_lo_ext + flag_C - 1;

// Step 2: Adjust if low nibble borrowed (AL negative = bit 15 set)
AL_adj = AL[15] ? ((AL - 6) & 16'h000F) - 16'h0010 : AL;

// Step 3: High nibble subtraction
high_sub = a_hi_ext - d_hi_ext + AL_adj;

// Step 4: Adjust if high result is negative
bcd_result = high_sub[15] ? high_sub - 16'h0060 : high_sub;

// Select result based on decimal mode
result = flag_D ? bcd_result : bin_result;

// Flags are always set from BINARY result (NMOS behavior)
flag_N = bin_result[7];
flag_Z = bin_result[7:0] == 0 ? 1'b1 : 1'b0;
flag_C = bin_result[8] ^ 1'b1;
flag_V = (A[7] ^ bin_result[7]) & (A[7] ^ data[7]);

// Store result
A = result[7:0];
#else
// 2A03/2A07 mode: No BCD support, binary arithmetic only
bin_result = A - data - not_carry;

flag_N = bin_result[7];
flag_Z = bin_result[7:0] == 0 ? 1'b1 : 1'b0;
flag_C = bin_result[8] ^ 1'b1;
flag_V = (A[7] ^ bin_result[7]) & (A[7] ^ data[7]);

A = bin_result[7:0];
#endif
