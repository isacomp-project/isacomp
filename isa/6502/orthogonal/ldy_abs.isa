// SPDX-License-Identifier: BSD-3-Clause
// 6502 LDY Absolute (0xAC) - Load Y Register Absolute
// Loads a value from absolute address into Y register
// Sets N flag if bit 7 is set, sets Z flag if value is zero
// Instruction format: LDY $hhll (3 bytes)

isa_state pc[15:0];
var instr[7:0];
isa_state Y[7:0];
isa_state flag_N[0:0];
isa_state flag_Z[0:0];
isa_state mainmem[7:0][15:0];

var addr_lo[7:0];
var addr_hi[7:0];

var data[7:0];

instr = mainmem[pc];
assume instr == 0xAC;
pc = pc + 1;

addr_lo = mainmem[pc];
pc = pc + 1;
addr_hi = mainmem[pc];
pc = pc + 1;


data = mainmem[{addr_hi, addr_lo}];

Y = data;
flag_N = data[7];
flag_Z = data == 0 ? 1'b1 : 1'b0;
