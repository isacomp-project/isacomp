// SPDX-License-Identifier: BSD-3-Clause
// 65C02 DEC A (0x3A) - Decrement Accumulator
// Decrements the accumulator by one
// Sets N flag if bit 7 of result is set
// Sets Z flag if result is zero
// Does not affect Carry flag
// Instruction format: DEC A or DEA (1 byte)
// NOTE: This is a 65C02-only instruction

#ifdef CPU_65C02

isa_state pc[15:0];
var instr[7:0];
isa_state A[7:0];
isa_state flag_N[0:0];
isa_state flag_Z[0:0];
isa_state mainmem[7:0][15:0];

var result[7:0];

instr = mainmem[pc];
assume instr == 0x3A;
pc = pc + 1;

// Decrement accumulator
result = A - 1;

// Update flags
flag_N = result[7];
flag_Z = result == 0 ? 1'b1 : 1'b0;

// Store result
A = result;

#endif
