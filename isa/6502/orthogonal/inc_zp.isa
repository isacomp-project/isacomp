// SPDX-License-Identifier: BSD-3-Clause
// 6502 INC Zero Page (0xE6) - Increment Memory (Zero Page)
// Increments an 8-bit value at zero page address
// Sets N flag if bit 7 of result is set
// Sets Z flag if result is zero
// Does not affect Carry flag
// Instruction format: INC $ll (2 bytes)

isa_state pc[15:0];
var instr[7:0];
isa_state flag_N[0:0];
isa_state flag_Z[0:0];
isa_state mainmem[7:0][15:0];

var zp_direct_addr[7:0];
var data[7:0];
var result[15:0];

instr = mainmem[pc];
assume instr == 0xE6;
pc = pc + 1;

// Read zero page address
zp_direct_addr = mainmem[pc];
pc = pc + 1;

// Read, increment, write back
data = mainmem[zp_direct_addr];
result = data + 1;

// Update flags
flag_N = result[7];
flag_Z = result[7:0] == 0 ? 1'b1 : 1'b0;

// Write back
mainmem[zp_direct_addr] = result[7:0];
