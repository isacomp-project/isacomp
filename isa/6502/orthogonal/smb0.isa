// SPDX-License-Identifier: BSD-3-Clause
// Rockwell 65C02 SMB0 - Set Memory Bit 0
// Sets bit 0 in zero page location
// Instruction format: SMB0 zp (2 bytes)
// NOTE: This is a Rockwell/WDC 65C02 extension

#ifdef CPU_65C02
#ifdef CPU_65C02_ROCKWELL

isa_state pc[15:0];
var instr[7:0];
isa_state mainmem[7:0][15:0];

var pc_plus_1[15:0];
var zp_addr[7:0];
var zp_addr_16[15:0];
var mem_val[7:0];
var result[7:0];
var mask[7:0];

instr = mainmem[pc];
assume instr == 0x87;

pc_plus_1 = pc + 1;
zp_addr = mainmem[pc_plus_1];
zp_addr_16 = {8'b0, zp_addr};

// Read memory value
mem_val = mainmem[zp_addr_16];

// Set bit 0 (OR with mask)
mask = 8'b00000001;
result = mem_val | mask;

// Write back
mainmem[zp_addr_16] = result;

// Advance PC
pc = pc + 2;

#endif
#endif
