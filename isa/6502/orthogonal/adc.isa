// SPDX-License-Identifier: BSD-3-Clause
// 6502 ADC — Add with Carry (all addressing modes via orthogon)
//
// Opcodes covered:
//   0x69 (imm), 0x65 (zp), 0x75 (zp,x), 0x6D (abs), 0x7D (abs,x),
//   0x79 (abs,y), 0x61 (ind,x), 0x71 (ind,y), 0x72 (zp_ind)

isa_state pc[15:0];
var instr[7:0];
isa_state A[7:0];
isa_state X[7:0];
isa_state Y[7:0];
isa_state flag_C[0:0];
isa_state flag_V[0:0];
isa_state flag_N[0:0];
isa_state flag_Z[0:0];
#ifdef CPU_6502_BCD
isa_state flag_D[0:0];
#endif
isa_state mainmem[7:0][15:0];

var carry_in[0:0];
var result[15:0];

#ifdef CPU_6502_BCD
// BCD variables
var bin_result[8:0];
var low_nibble_sum[4:0];
var low_adjust[7:0];
var after_low_adj[15:0];
var high_adjust[7:0];
var bcd_result[15:0];
var bcd_carry[0:0];
#endif

// Fetch and decode
instr = mainmem[pc];
assume instr == 0x69 | instr == 0x65 | instr == 0x75 |
       instr == 0x6D | instr == 0x7D | instr == 0x79 |
       instr == 0x61 | instr == 0x71 | instr == 0x72;
pc = pc + 1;

// Map opcode to addressing mode selector.
// For 6502 group 1 (cc=01), bits [4:2] encode addressing mode:
//   000 -> (ind,x)  = sel 6
//   001 -> zp       = sel 1
//   010 -> imm      = sel 0
//   011 -> abs      = sel 2
//   100 -> (ind),y  = sel 7  (or zp_ind = sel 8 for 0x72)
//   101 -> zp,x     = sel 3
//   110 -> abs,y    = sel 5
//   111 -> abs,x    = sel 4
var addr_sel[3:0];
addr_sel = instr[4:2] == 3'b000 ? 4'd6 :
           instr[4:2] == 3'b001 ? 4'd1 :
           instr[4:2] == 3'b010 ? 4'd0 :
           instr[4:2] == 3'b011 ? 4'd2 :
           instr[4:2] == 3'b100 ? (instr == 0x72 ? 4'd8 : 4'd7) :
           instr[4:2] == 3'b101 ? 4'd3 :
           instr[4:2] == 3'b110 ? 4'd5 :
                                  4'd4 ;

// Invoke addressing mode orthogon — data[7:0] and eff_addr[15:0] now in scope
use addr_mode(addr_sel);

// === ADC computation ===
carry_in = flag_C;

#ifdef CPU_6502_BCD
// Binary addition
bin_result = A + data + carry_in;

// BCD: Step 1 - adjust low nibble if sum > 9
low_nibble_sum = A[3:0] + data[3:0] + carry_in;
low_adjust = low_nibble_sum > 9 ? 6 : 0;
after_low_adj = bin_result + low_adjust;

// BCD: Step 2 - adjust high nibble if result > 0x99
high_adjust = after_low_adj > 0x99 ? 0x60 : 0;
bcd_result = after_low_adj + high_adjust;
bcd_carry = after_low_adj > 0x99 ? 1 : 0;

// Select result based on decimal mode
result = flag_D ? bcd_result : bin_result;

// Flags - In decimal mode, fake6502 sets N from intermediate result (after low adj, before high adj)
// In binary mode, N comes from binary result
var bcd_n[0:0];
var bin_n[0:0];
bcd_n = after_low_adj[7];
bin_n = bin_result[7];
flag_N = (flag_D & bcd_n) | ((flag_D ^ 1'b1) & bin_n);
// Z always comes from binary result (NMOS behavior)
flag_Z = bin_result[7:0] == 0 ? 1'b1 : 1'b0;
// Carry flag - use masking to avoid ternary code generation bug
flag_C = (flag_D & bcd_carry) | ((flag_D ^ 1'b1) & bin_result[8]);
// V flag: In decimal mode, fake6502 sets V if BCD result >= 0x80 (bits 7-15 set)
// In binary mode, use standard overflow formula
var bcd_overflow[0:0];
var bin_overflow[0:0];
bcd_overflow = bcd_result[15:7] != 0 ? 1'b1 : 1'b0;
bin_overflow = (bin_result[7] ^ A[7]) & (bin_result[7] ^ data[7]);
flag_V = (flag_D & bcd_overflow) | ((flag_D ^ 1'b1) & bin_overflow);

A = result[7:0];
#else
// 2A03/2A07 mode: No BCD support, binary arithmetic only
result = A + data + carry_in;

flag_N = result[7];
flag_Z = result[7:0] == 0 ? 1'b1 : 1'b0;
flag_C = result[8];
flag_V = (result[7] ^ A[7]) & (result[7] ^ data[7]);

A = result[7:0];
#endif
