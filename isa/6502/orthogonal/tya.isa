// SPDX-License-Identifier: BSD-3-Clause
// 6502 TYA (0x98) - Transfer Y to Accumulator
// Copies the value in Y register to the Accumulator (A)
// Sets N flag if bit 7 of result is set (negative)
// Sets Z flag if result is zero
// Instruction format: TYA (1 byte)

isa_state pc[15:0];
var instr[7:0];
isa_state Y[7:0];
isa_state A[7:0];
isa_state flag_N[0:0];
isa_state flag_Z[0:0];
isa_state mainmem[7:0][15:0];

instr = mainmem[pc];
assume instr == 0x98;
pc = pc + 1;

A = Y;
flag_N = Y[7];
flag_Z = Y == 0 ? 1'b1 : 1'b0;
