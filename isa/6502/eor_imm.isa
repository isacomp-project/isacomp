isa_state pc[15:0];
var instr[7:0];
isa_state A[7:0];
isa_state mainmem[7:0][15:0];
isa_state flag_N[0:0];
isa_state flag_Z[0:0];

var imm[7:0];
var result[7:0];

instr = mainmem[pc];
assume instr == 0x49;
pc = pc + 1;
imm = mainmem[pc];
pc = pc + 1;

result = A ^ imm;

A = result;

flag_N = result[7];
flag_Z = result == 0 ? 1'b1 : 1'b0;
