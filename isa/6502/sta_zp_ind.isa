// SPDX-License-Identifier: BSD-3-Clause
// 65C02 STA Zero Page Indirect (0x92) - Store Accumulator Zero Page Indirect
// Stores to address stored at zero page location (no index)
// Address = mainmem[zp] + mainmem[zp+1] * 256
// Does not affect any flags
// Instruction format: STA ($nn) (2 bytes)
// NOTE: This is a 65C02-only instruction

#ifdef CPU_65C02

isa_state pc[15:0];
var instr[7:0];
isa_state A[7:0];
isa_state mainmem[7:0][15:0];

var zp_addr[7:0];
var addr_lo[7:0];
var addr_hi[7:0];
var target_addr[15:0];

instr = mainmem[pc];
assume instr == 0x92;
pc = pc + 1;

// Read zero page pointer address
zp_addr = mainmem[pc];
pc = pc + 1;

// Read target address from zero page
addr_lo = mainmem[zp_addr];
addr_hi = mainmem[zp_addr + 1];
target_addr = {addr_hi, addr_lo};

// Store to target address
mainmem[target_addr] = A;

#endif
