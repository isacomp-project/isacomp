// SPDX-License-Identifier: BSD-3-Clause
isa_state pc[31:0];
var instr[15:0];
isa_state rf[31:0][3:0];
isa_state rf_bank[31:0][2:0];
isa_state sr[31:0];
mem umem[23:0];
isa_state gbr[31:0];

var rn[3:0];
var Rn[31:0];
var lds_gbr_rb[0:0];
var lds_gbr_rn_lo[2:0];
var lds_gbr_rn_bk[0:0];

// Branch delay slot state
isa_state delay_slot[0:0];
isa_state branch_target[31:0];

// Include delay slot aspect - handles PC override if we're in a delay slot
aspect delay_slot.isa gates pc, delay_slot;

// Include exception aspect - handles stack push, SR update, PC redirect
aspect exception.isa gates pc, sr, vbr, rf, umem;

// Include interrupt aspect - checks for external interrupts
aspect interrupt.isa gates sr;

instr = umem[pc];
assume instr[15:12] == 0x4;
assume instr[7:0] == 0x1E;
rn = instr[11:8];

lds_gbr_rn_lo = rn[2:0];
lds_gbr_rb = sr[28];
lds_gbr_rn_bk = (rn[3] == 1'b0) & lds_gbr_rb;

Rn = lds_gbr_rn_bk ? rf_bank[lds_gbr_rn_lo] : rf[rn];

// LDS Rm, GBR: copy Rm to GBR (Rm is in bits 11:8, we use rn for consistency)
gbr when (exc_taken == 0) = Rn;
pc = pc + 2;
