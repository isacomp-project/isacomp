// SPDX-License-Identifier: BSD-3-Clause
isa_state pc[31:0];
var instr[15:0];
isa_state rf[31:0][3:0];
isa_state rf_bank[31:0][2:0];  // Banked R0-R7 for RB=1
isa_state sr[31:0];
mem umem[23:0];

var rn[3:0];
var disp[7:0];
var pc_val[31:0];
var mova_addr[31:0];

// Register banking variables (unique to mova instruction)
var mova_r0_lo[2:0];
var mova_rb[0:0];

// Branch delay slot state
isa_state delay_slot[0:0];
isa_state branch_target[31:0];

// Include delay slot aspect - handles PC override if we're in a delay slot
aspect delay_slot.isa gates pc, delay_slot;

// Include exception aspect - handles stack push, SR update, PC redirect
aspect exception.isa gates pc, sr, vbr, rf, umem;

// Include interrupt aspect - checks for external interrupts
aspect interrupt.isa gates sr;

instr = umem[pc];
assume instr[15:12] == 0xC;
assume instr[11:8] == 0x7;
disp = instr[7:0];

pc_val = (pc + 4) & 32'hFFFFFFFC;
mova_addr = pc_val + {22'b0, disp, 2'b0};

// Register banking for R0
mova_r0_lo = 3'b000;
mova_rb = sr[28];

rf[0] when (mova_rb == 0) = mova_addr;
rf_bank[mova_r0_lo] when (mova_rb) = mova_addr;
pc = pc + 2;
