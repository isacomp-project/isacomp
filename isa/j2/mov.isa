// SPDX-License-Identifier: BSD-3-Clause
isa_state pc[31:0];
var instr[15:0];
isa_state rf[31:0][3:0];
isa_state rf_bank[31:0][2:0];
isa_state sr[31:0];
mem umem[23:0];

var rn[3:0];
var rm[3:0];
var Rm[31:0];
var mov_rb[0:0];
var mov_rn_lo[2:0];
var mov_rm_lo[2:0];
var mov_rn_bk[0:0];
var mov_rm_bk[0:0];

// Branch delay slot state
isa_state delay_slot[0:0];
isa_state branch_target[31:0];

// Include delay slot aspect - handles PC override if we're in a delay slot
aspect delay_slot.isa gates pc, delay_slot;

// Include exception aspect - handles stack push, SR update, PC redirect
aspect exception.isa gates pc, sr, vbr, rf, umem;

// Include interrupt aspect - checks for external interrupts
aspect interrupt.isa gates sr;

instr = umem[pc];
assume instr[15:12] == 0x6;
assume instr[3:0] == 0x3;
rn = instr[11:8];
rm = instr[7:4];

mov_rn_lo = rn[2:0];
mov_rm_lo = rm[2:0];
mov_rb = sr[28];
mov_rn_bk = (rn[3] == 1'b0) & mov_rb;
mov_rm_bk = (rm[3] == 1'b0) & mov_rb;

Rm = mov_rm_bk ? rf_bank[mov_rm_lo] : rf[rm];

rf[rn] when (mov_rn_bk == 0) = Rm;
rf_bank[mov_rn_lo] when (mov_rn_bk) = Rm;
pc = pc + 2;
