// SPDX-License-Identifier: BSD-3-Clause
isa_state pc[31:0];
var instr[15:0];
isa_state rf[31:0][3:0];
isa_state rf_bank[31:0][2:0];  // Banked R0-R7 for RB=1
isa_state sr[31:0];
isa_state t[0:0];
mem umem[23:0];

var rn[3:0];
var shlr_rn_lo[2:0];
var Rn[31:0];
var res[31:0];

// Register banking variables (unique to shlr instruction)
var shlr_rb[0:0];
var shlr_rn_bk[0:0];

// Branch delay slot state
isa_state delay_slot[0:0];
isa_state branch_target[31:0];

// Include delay slot aspect - handles PC override if we're in a delay slot
aspect delay_slot.isa gates pc, delay_slot;

// Include exception aspect - handles stack push, SR update, PC redirect
aspect exception.isa gates pc, sr, vbr, rf, umem;

// Include interrupt aspect - checks for external interrupts
aspect interrupt.isa gates sr;

instr = umem[pc];
assume instr[15:12] == 0x4;
assume instr[7:0] == 0x01;
rn = instr[11:8];
shlr_rn_lo = rn[2:0];

// Banking: R0-R7 use rf_bank when SR.RB=1
shlr_rb = sr[28];
shlr_rn_bk = (rn[3] == 1'b0) & shlr_rb;

Rn = shlr_rn_bk ? rf_bank[shlr_rn_lo] : rf[rn];

// SHLR: Shift Logical Right by 1
// T = Rn[0] (bit shifted out), Rn = Rn >> 1
t when (exc_taken == 0) = Rn[0];
res = {1'b0, Rn[31:1]};

rf[rn] when (shlr_rn_bk == 0) = res;
rf_bank[shlr_rn_lo] when (shlr_rn_bk) = res;
pc = pc + 2;
