// SPDX-License-Identifier: BSD-3-Clause
isa_state pc[31:0];
var instr[15:0];
isa_state rf[31:0][3:0];
isa_state rf_bank[31:0][2:0];  // Banked R0-R7 for RB=1
isa_state sr[31:0];
mem umem[23:0];

var rn[3:0];
var rm[3:0];
var shad_rn_lo[2:0];
var shad_rm_lo[2:0];
var Rn[31:0];
var Rm[31:0];
var shad_amt[4:0];
var shad_neg_amt[4:0];
var shad_left_res[31:0];
var shad_right_res[31:0];
var shad_sign_fill[31:0];
var shad_out[31:0];

// Register banking variables (unique to shad instruction)
var shad_rb[0:0];
var shad_rn_bk[0:0];
var shad_rm_bk[0:0];

isa_state delay_slot[0:0];
isa_state branch_target[31:0];

aspect delay_slot.isa gates pc, delay_slot;

// Include exception aspect - handles stack push, SR update, PC redirect
aspect exception.isa gates pc, sr, vbr, rf, umem;

// Include interrupt aspect - checks for external interrupts
aspect interrupt.isa gates sr;

instr = umem[pc];
assume instr[15:12] == 0x4;
assume instr[3:0] == 0xC;
rn = instr[11:8];
rm = instr[7:4];
shad_rn_lo = rn[2:0];
shad_rm_lo = rm[2:0];

// Banking: R0-R7 use rf_bank when SR.RB=1
shad_rb = sr[28];
shad_rn_bk = (rn[3] == 1'b0) & shad_rb;
shad_rm_bk = (rm[3] == 1'b0) & shad_rb;

Rn = shad_rn_bk ? rf_bank[shad_rn_lo] : rf[rn];
Rm = shad_rm_bk ? rf_bank[shad_rm_lo] : rf[rm];

// SHAD - Shift Arithmetic Dynamic
// If Rm >= 0: shift left by Rm[4:0]
// If Rm < 0: shift right arithmetic by (0 - Rm[4:0])
shad_amt = Rm[4:0];
shad_neg_amt = 5'b0 - shad_amt;

// Left shift for positive Rm
shad_left_res = Rn << shad_amt;

// Right arithmetic shift for negative Rm
// When shift amount is 0 and Rm<0, result is all sign bits
// For arithmetic shift, we need to fill with sign bit from the left
shad_sign_fill = {32{Rn[31]}};
// Logical shift right, then OR with sign extension mask
// The mask is: sign_bit replicated for the top 'shad_neg_amt' bits
shad_right_res = (shad_amt == 5'b0) ? shad_sign_fill : ((Rn >> shad_neg_amt) | (shad_sign_fill << (6'b100000 - {1'b0, shad_neg_amt})));

// Select based on Rm sign
shad_out = (Rm[31] == 1'b0) ? shad_left_res : shad_right_res;

rf[rn] when (shad_rn_bk == 0) = shad_out;
rf_bank[shad_rn_lo] when (shad_rn_bk) = shad_out;
pc = pc + 2;
