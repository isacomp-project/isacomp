// SPDX-License-Identifier: BSD-3-Clause
isa_state pc[31:0];
var instr[15:0];
isa_state rf[31:0][3:0];
isa_state rf_bank[31:0][2:0];  // Banked R0-R7 for RB=1
isa_state sr[31:0];
mem umem[23:0];

var rn[3:0];
var movw_pcrel_disp[7:0];
var movw_pcrel_pc_val[31:0];
var movw_pcrel_addr[31:0];
var movw_pcrel_data16[15:0];
var movw_pcrel_sign_ext[31:0];

// Register banking variables (unique to movw_pcrel)
var movw_pcrel_rn_lo[2:0];
var movw_pcrel_rb[0:0];
var movw_pcrel_rn_bk[0:0];

// Branch delay slot state
isa_state delay_slot[0:0];
isa_state branch_target[31:0];

// Include delay slot aspect - handles PC override if we're in a delay slot
aspect delay_slot.isa gates pc, delay_slot;

// Include exception aspect - handles stack push, SR update, PC redirect
aspect exception.isa gates pc, sr, vbr, rf, umem;

// Include interrupt aspect - checks for external interrupts
aspect interrupt.isa gates sr;

instr = umem[pc];
assume instr[15:12] == 0x9;
rn = instr[11:8];
movw_pcrel_disp = instr[7:0];

// Register banking setup
movw_pcrel_rn_lo = rn[2:0];
movw_pcrel_rb = sr[28];
movw_pcrel_rn_bk = (rn[3] == 1'b0) & movw_pcrel_rb;

// MOV.W @(disp,PC),Rn
// addr = (PC + 4) + disp*2 (no alignment mask for word access)
movw_pcrel_pc_val = pc + 4;
movw_pcrel_addr = movw_pcrel_pc_val + {23'b0, movw_pcrel_disp, 1'b0};

movw_pcrel_data16 = umem[movw_pcrel_addr];
movw_pcrel_sign_ext = {{16{movw_pcrel_data16[15]}}, movw_pcrel_data16};

// Update register with banking (only if no exception)
rf[rn] when ((movw_pcrel_rn_bk == 0) & (exc_taken == 0)) = movw_pcrel_sign_ext;
rf_bank[movw_pcrel_rn_lo] when (movw_pcrel_rn_bk & (exc_taken == 0)) = movw_pcrel_sign_ext;

pc = pc + 2;
