// SPDX-License-Identifier: BSD-3-Clause
isa_state pc[31:0];
var instr[15:0];
isa_state rf[31:0][3:0];
isa_state rf_bank[31:0][2:0];  // Banked R0-R7 for RB=1
isa_state sr[31:0];
mem umem[23:0];
isa_state gbr[31:0];

var imm[7:0];
var xorb_gbr_addr[31:0];
var xorb_gbr_r0_lo[2:0];
var R0[31:0];
var data8[7:0];
var result[7:0];

// Register banking (unique to xorb_gbr instruction)
var xorb_gbr_rb[0:0];

// Branch delay slot state
isa_state delay_slot[0:0];
isa_state branch_target[31:0];

// Include delay slot aspect - handles PC override if we're in a delay slot
aspect delay_slot.isa gates pc, delay_slot;

// Include exception aspect - handles stack push, SR update, PC redirect
aspect exception.isa gates pc, sr, vbr, rf, umem;

// Include interrupt aspect - checks for external interrupts
aspect interrupt.isa gates sr;

instr = umem[pc];
assume instr[15:8] == 0xCE;
imm = instr[7:0];

// Banking: R0 uses rf_bank when SR.RB=1
xorb_gbr_r0_lo = 3'b000;
xorb_gbr_rb = sr[28];

// XOR.B #imm,@(R0,GBR): xorb_gbr_addr = GBR + R0
R0 = xorb_gbr_rb ? rf_bank[xorb_gbr_r0_lo] : rf[0];
xorb_gbr_addr = gbr + R0;

// Read-modify-write
data8 = umem[xorb_gbr_addr];
result = data8 ^ imm;
umem[xorb_gbr_addr] = result;

pc = pc + 2;
