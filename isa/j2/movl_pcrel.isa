// SPDX-License-Identifier: BSD-3-Clause
isa_state pc[31:0];
var instr[15:0];
isa_state rf[31:0][3:0];
isa_state rf_bank[31:0][2:0];  // Banked R0-R7 for RB=1
isa_state sr[31:0];
mem umem[23:0];

var rn[3:0];
var disp[7:0];
var Rn[31:0];
var pc_val[31:0];
var movl_pcrel_addr[31:0];
var data32[31:0];

// Register banking variables (unique to movl_pcrel)
var movl_pcrel_rn_lo[2:0];
var movl_pcrel_rb[0:0];
var movl_pcrel_rn_bk[0:0];

// Branch delay slot state
isa_state delay_slot[0:0];
isa_state branch_target[31:0];

// Include delay slot aspect - handles PC override if we're in a delay slot
aspect delay_slot.isa gates pc, delay_slot;

// Include exception aspect - handles stack push, SR update, PC redirect
aspect exception.isa gates pc, sr, vbr, rf, umem;

// Include interrupt aspect - checks for external interrupts
aspect interrupt.isa gates sr;

instr = umem[pc];
assume instr[15:12] == 0xD;
rn = instr[11:8];
disp = instr[7:0];

// Register banking setup
movl_pcrel_rn_lo = rn[2:0];
movl_pcrel_rb = sr[28];
movl_pcrel_rn_bk = (rn[3] == 1'b0) & movl_pcrel_rb;

pc_val = (pc + 4) & 32'hFFFFFFFC;
movl_pcrel_addr = pc_val + {22'b0, disp, 2'b0};

data32 = umem[movl_pcrel_addr];

// Update register with banking (only if no exception)
rf[rn] when ((movl_pcrel_rn_bk == 0) & (exc_taken == 0)) = data32;
rf_bank[movl_pcrel_rn_lo] when (movl_pcrel_rn_bk & (exc_taken == 0)) = data32;

pc = pc + 2;
