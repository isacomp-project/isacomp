// SPDX-License-Identifier: BSD-3-Clause
// STS.L MACL, @-Rn - Store System Register to Memory with Pre-decrement
// Decrements Rn by 4, then stores MACL to @Rn
// Opcode: 0100nnnn00010010 (0x4n12)

isa_state pc[31:0];
var instr[15:0];
isa_state rf[31:0][3:0];
isa_state rf_bank[31:0][2:0];  // Banked R0-R7 for RB=1
mem umem[23:0];
isa_state t[0:0];

// System registers (needed for exception handling)
isa_state sr[31:0];
isa_state vbr[31:0];
isa_state macl[31:0];

var rn[3:0];
var Rn[31:0];
var stsl_macl_addr[31:0];

// Address error checking variables
var store_addr[31:0];
var store_size[1:0];
var stsl_macl_no_error[0:0];

// Register banking variables (unique to stsl_macl)
var stsl_macl_rn_lo[2:0];
var stsl_macl_rb[0:0];
var stsl_macl_rn_bk[0:0];

// Branch delay slot state
isa_state delay_slot[0:0];
isa_state branch_target[31:0];

// Include delay slot aspect - handles PC override if we're in a delay slot
aspect delay_slot.isa gates pc, delay_slot;

// Include interrupt aspect - checks for external interrupts
aspect interrupt.isa gates sr, exc_taken:1, exc_vector:1;

// Include exception handling aspect
aspect exception.isa gates pc, sr, vbr, rf, umem;

// Include address error detection for stores
aspect addr_error_store.isa gates pc, sr, vbr, rf, umem, exc_taken:2, exc_vector:2;

instr = umem[pc];
assume instr[15:12] == 0x4;
assume instr[7:0] == 0x12;
rn = instr[11:8];

// Register banking setup
stsl_macl_rn_lo = rn[2:0];
stsl_macl_rb = sr[28];
stsl_macl_rn_bk = (rn[3] == 1'b0) & stsl_macl_rb;

Rn = stsl_macl_rn_bk ? rf_bank[stsl_macl_rn_lo] : rf[rn];
// STS.L MACL, @-Rn: decrement Rn by 4, store MACL to @Rn
stsl_macl_addr = Rn - 4;

// Set up address error checking
store_addr = stsl_macl_addr;
store_size = 2'b11;  // Long access (32-bit)

// Compute the no-error condition (bits 1:0 must be 00)
stsl_macl_no_error = (stsl_macl_addr[1:0] == 2'b00);

// Only update register and store if no address error (combined with banking)
rf[rn] when (stsl_macl_no_error & (stsl_macl_rn_bk == 0)) = stsl_macl_addr;
rf_bank[stsl_macl_rn_lo] when (stsl_macl_no_error & stsl_macl_rn_bk) = stsl_macl_addr;
umem[stsl_macl_addr] when (stsl_macl_no_error) = macl;

// Only advance PC if no address error
pc when (stsl_macl_no_error) = pc + 2;
