// SPDX-License-Identifier: BSD-3-Clause
isa_state pc[31:0];
var instr[15:0];
isa_state rf[31:0][3:0];
isa_state rf_bank[31:0][2:0];  // Banked R0-R7 for RB=1
isa_state sr[31:0];
mem umem[23:0];
isa_state t[0:0];

var rn[3:0];
var rm[3:0];
var tst_rn_lo[2:0];
var tst_rm_lo[2:0];
var Rn[31:0];
var Rm[31:0];
var res[31:0];

// Register banking flags (unique to tst instruction)
var tst_rb[0:0];
var tst_rn_bk[0:0];
var tst_rm_bk[0:0];

// Branch delay slot state
isa_state delay_slot[0:0];
isa_state branch_target[31:0];

// Include delay slot aspect - handles PC override if we're in a delay slot
aspect delay_slot.isa gates pc, delay_slot;

// Include exception aspect - handles stack push, SR update, PC redirect
aspect exception.isa gates pc, sr, vbr, rf, umem;

// Include interrupt aspect - checks for external interrupts
aspect interrupt.isa gates sr;

instr = umem[pc];
assume instr[15:12] == 0x2;
assume instr[3:0] == 0x8;
rn = instr[11:8];
rm = instr[7:4];
tst_rn_lo = rn[2:0];
tst_rm_lo = rm[2:0];

// Banking: R0-R7 use rf_bank when SR.RB=1
tst_rb = sr[28];
tst_rn_bk = (rn[3] == 1'b0) & tst_rb;
tst_rm_bk = (rm[3] == 1'b0) & tst_rb;

Rn = tst_rn_bk ? rf_bank[tst_rn_lo] : rf[rn];
Rm = tst_rm_bk ? rf_bank[tst_rm_lo] : rf[rm];

res = Rn & Rm;
t when (exc_taken == 0) = (res == 32'b0) ? 1'b1 : 1'b0;
pc = pc + 2;
