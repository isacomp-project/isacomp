// SPDX-License-Identifier: BSD-3-Clause
isa_state pc[31:0];
var instr[15:0];
isa_state rf[31:0][3:0];
isa_state rf_bank[31:0][2:0];  // Banked R0-R7 for RB=1
isa_state sr[31:0];
mem umem[23:0];

var rm[3:0];
var disp[3:0];
var Rm[31:0];
var movb_disp_load_addr[31:0];
var data8[7:0];
var sign_ext_data[31:0];

// Register banking variables (unique to movb_disp_load instruction)
var movb_disp_load_r0_lo[2:0];
var movb_disp_load_rm_lo[2:0];
var movb_disp_load_rb[0:0];
var movb_disp_load_rm_bk[0:0];

// Branch delay slot state
isa_state delay_slot[0:0];
isa_state branch_target[31:0];

// Include delay slot aspect - handles PC override if we're in a delay slot
aspect delay_slot.isa gates pc, delay_slot;

// Include exception aspect - handles stack push, SR update, PC redirect
aspect exception.isa gates pc, sr, vbr, rf, umem;

// Include interrupt aspect - checks for external interrupts
aspect interrupt.isa gates sr;

instr = umem[pc];
assume instr[15:8] == 0x84;
rm = instr[7:4];
disp = instr[3:0];

// Register banking setup
movb_disp_load_r0_lo = 3'b000;
movb_disp_load_rm_lo = rm[2:0];
movb_disp_load_rb = sr[28];
movb_disp_load_rm_bk = (rm[3] == 1'b0) & movb_disp_load_rb;

Rm = movb_disp_load_rm_bk ? rf_bank[movb_disp_load_rm_lo] : rf[rm];

// MOV.B @(disp,Rm),R0: addr = Rm + disp
movb_disp_load_addr = Rm + {28'b0, disp};

data8 = umem[movb_disp_load_addr];
sign_ext_data = {{24{data8[7]}}, data8};

// Only update register if no exception
rf[0] when ((movb_disp_load_rb == 0) & (exc_taken == 0)) = sign_ext_data;
rf_bank[movb_disp_load_r0_lo] when (movb_disp_load_rb & (exc_taken == 0)) = sign_ext_data;
pc = pc + 2;
