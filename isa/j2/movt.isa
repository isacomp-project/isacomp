// SPDX-License-Identifier: BSD-3-Clause
isa_state pc[31:0];
var instr[15:0];
isa_state rf[31:0][3:0];
isa_state rf_bank[31:0][2:0];  // Banked R0-R7 for RB=1
isa_state sr[31:0];
mem umem[23:0];
isa_state t[0:0];

var rn[3:0];

// Register banking variables (unique to movt)
var movt_rn_lo[2:0];
var movt_rb[0:0];
var movt_rn_bk[0:0];

// Branch delay slot state
isa_state delay_slot[0:0];
isa_state branch_target[31:0];

// Include delay slot aspect - handles PC override if we're in a delay slot
aspect delay_slot.isa gates pc, delay_slot;

// Include exception aspect - handles stack push, SR update, PC redirect
aspect exception.isa gates pc, sr, vbr, rf, umem;

// Include interrupt aspect - checks for external interrupts
aspect interrupt.isa gates sr;

instr = umem[pc];
assume instr[15:12] == 0x0;
assume instr[7:0] == 0x29;
rn = instr[11:8];

// Register banking setup
movt_rn_lo = rn[2:0];
movt_rb = sr[28];
movt_rn_bk = (rn[3] == 1'b0) & movt_rb;

// Update register with banking
rf[rn] when (movt_rn_bk == 0) = {31'b0, t};
rf_bank[movt_rn_lo] when (movt_rn_bk) = {31'b0, t};

pc = pc + 2;
