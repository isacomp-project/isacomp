// SPDX-License-Identifier: BSD-3-Clause
// SLEEP - Sleep (Power-Down Mode)
// Halts the CPU until an interrupt occurs
// This is a privileged instruction - causes illegal instruction exception in user mode
//
// Behavior:
// - If in user mode: illegal instruction exception
// - If in privileged mode: wait until irq_i is asserted, then continue
// - When irq_i arrives, PC advances and interrupt handling can begin
//
// Opcode: 0000000000011011 (0x001B)

isa_state pc[31:0];
var instr[15:0];
isa_state rf[31:0][3:0];
mem umem[23:0];
isa_state t[0:0];

// System registers
isa_state sr[31:0];
isa_state vbr[31:0];

// External interrupt request signal (input from outside)
ext isa_state irq_i[0:0];

var sleep_is_privileged[0:0];
var sleep_wake[0:0];

// Branch delay slot state
isa_state delay_slot[0:0];
isa_state branch_target[31:0];

// Include delay slot aspect
aspect delay_slot.isa gates pc, delay_slot;

// Include interrupt aspect - checks for external interrupts
// Must include exc_taken and exc_vector with priority for proper merging
aspect interrupt.isa gates sr, exc_taken:1, exc_vector:1;

// Include exception aspect for privilege violation
aspect exception.isa gates pc, sr, vbr, rf, umem;

instr = umem[pc];
assume instr[15:0] == 0x001B;

// Note: SH-2 does not have privilege mode checking for SLEEP
// (MD bit and privilege mode are SH-2A extensions)
// On J2/SH-2, this instruction always succeeds
// Interrupt handling is controlled by interrupt.isa aspect

// Wake condition: IRQ pending
// Note: Interrupt masking (SR[4:7]) is checked by interrupt hardware
sleep_wake = irq_i;

// Only advance PC when waking up from sleep (IRQ pending)
// If no IRQ, PC stays at current value (re-execute SLEEP next cycle)
pc when (sleep_wake) = pc + 2;
