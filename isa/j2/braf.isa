// SPDX-License-Identifier: BSD-3-Clause
isa_state pc[31:0];
var instr[15:0];
isa_state rf[31:0][3:0];
isa_state rf_bank[31:0][2:0];  // Banked R0-R7 for RB=1
isa_state sr[31:0];
mem umem[23:0];

// Branch delay slot state
isa_state delay_slot[0:0];
isa_state branch_target[31:0];

var rn[3:0];
var Rn[31:0];
var branch_dest[31:0];

// Register banking variables
var braf_rn_lo[2:0];
var braf_rb[0:0];
var braf_rn_bk[0:0];

// Include delay slot aspect - handles PC override if we're in a delay slot
aspect delay_slot.isa gates pc, delay_slot;

// Include exception aspect - handles stack push, SR update, PC redirect
aspect exception.isa gates pc, sr, vbr, rf, umem;

// Include interrupt aspect - checks for external interrupts
aspect interrupt.isa gates sr;

instr = umem[pc];
assume instr[15:12] == 0x0;
assume instr[7:0] == 0x23;
rn = instr[11:8];

// Register banking logic
braf_rn_lo = rn[2:0];
braf_rb = sr[28];
braf_rn_bk = (rn[3] == 1'b0) & braf_rb;

// BRAF Rn: branch to PC + Rn + 4
Rn = braf_rn_bk ? rf_bank[braf_rn_lo] : rf[rn];
branch_dest = pc + Rn + 4;

// BRAF always branches - set up delay slot for next instruction
// If an exception/interrupt is being taken, don't set up delay slot - exception takes priority
delay_slot when ((in_delay_slot == 0) & (exc_taken == 0)) = 1;
branch_target when ((in_delay_slot == 0) & (exc_taken == 0)) = branch_dest;

// Advance to delay slot instruction
pc = pc + 2;
