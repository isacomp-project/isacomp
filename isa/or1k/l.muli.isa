// SPDX-License-Identifier: BSD-3-Clause
// OpenRISC l.muli - Multiply Immediate Signed
// Format: l.muli rD, rA, I

isa_state pc[31:0];
var instr[31:0];
isa_state rf[31:0][4:0];
isa_state imem[31:0][9:0];
isa_state dmem[31:0][9:0];

var rD[4:0];
var rA[4:0];
var imm[15:0];
var sign_ext_imm[31:0];
var r1[31:0];
var res[31:0];

instr = imem[pc];
assume instr[31:26] == 0x2C;
pc = pc + 4;
rD = instr[25:21];
rA = instr[20:16];
imm = instr[15:0];

r1 = rf[rA];
sign_ext_imm = {{16{imm[15]}}, imm};

res = r1 * sign_ext_imm;

rf[rD] = res;
