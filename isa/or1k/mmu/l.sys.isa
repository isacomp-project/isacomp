// SPDX-License-Identifier: BSD-3-Clause
// OpenRISC l.sys with MMU - System Call
// Format: l.sys K
// Triggers system call exception (vector 0xC00)
//
// Exception flow:
// 1. EPCR[0] <- PC of l.sys instruction
// 2. ESR[0] <- SR
// 3. SR[SM] = 1 (enter supervisor mode)
// 4. SR[TEE] = 0 (disable tick timer exception)
// 5. SR[IEE] = 0 (disable external interrupts)
// 6. SR[DME] = 0 (disable data MMU)
// 7. SR[IME] = 0 (disable instruction MMU)
// 8. PC <- exception vector (0xC00)

isa_state pc[31:0];
var instr[31:0];
isa_state rf[31:0][4:0];
mem umem[23:0];
isa_state spr[31:0][15:0];
isa_state cam itlb_tag[19:0]@[6:0][];
isa_state itlb_tr_cam[31:0][6:0];
isa_state cam dtlb_tag[19:0]@[6:0][];
isa_state dtlb_tr_cam[31:0][6:0];
isa_state sr[31:0];
isa_state epcr0[31:0];
isa_state esr0[31:0];
isa_state eear0[31:0];
isa_state flag[0:0];
isa_state delay_slot[0:0];
isa_state branch_target[31:0];
isa_state ttmr[31:0];
isa_state ttcr[31:0];


var imm[15:0];
var new_sr[31:0];

// Instruction fetch MMU translation
aspect delay_slot.isa gates delay_slot;
aspect mmu.isa gates pc, sr, epcr0, esr0, eear0;

instr = umem[pc_pa];
assume instr[31:26] == 0x08;
assume instr[25] == 0x0;
imm = instr[15:0];

// Save exception state (only when no ITLB exception)
// Save PC+4 so l.rfe returns to the instruction after l.sys
epcr0 when (~exception_taken) = pc + 4;
esr0 when (~exception_taken) = sr;

// Enter supervisor mode, disable interrupts and MMU
new_sr = sr;
new_sr[0] = 1;     // SM = 1 (supervisor mode)
new_sr[1] = 0;     // TEE = 0 (disable tick timer exception)
new_sr[2] = 0;     // IEE = 0 (disable external interrupt exception)
new_sr[5] = 0;     // DME = 0 (disable data MMU)
new_sr[6] = 0;     // IME = 0 (disable instruction MMU)
sr when (~exception_taken) = new_sr;

// Jump to system call exception vector
pc when (~exception_taken) = 32'h00000C00;

// Tick timer: counter increment and IP flag management
var tt_mode[1:0];
tt_mode = ttmr[31:30];
var tt_en[0:0];
tt_en = (tt_mode != 2'b00);
var tt_match[0:0];
tt_match = tt_en & (ttcr[27:0] == ttmr[27:0]);
var tt_new_count[27:0];
tt_new_count = tt_match ?
    ((tt_mode == 2'b01) ? 28'b0 :
     (tt_mode == 2'b10) ? ttcr[27:0] :
     ttcr[27:0] + 1) :
    ttcr[27:0] + 1;
ttcr = tt_en ? {ttcr[31:28], tt_new_count} : ttcr;
ttmr = tt_match ? (ttmr | 32'h10000000) : ttmr;
