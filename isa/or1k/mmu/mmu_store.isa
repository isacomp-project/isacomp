// SPDX-License-Identifier: BSD-3-Clause
// OpenRISC OR1K MMU Translation Aspect for Data Store Operations
// Implements DTLB-based translation for store instructions using CAM
//
// Checks write permission instead of read permission
// DTLB Translate Register:
//   PPN[31:13] | SWE(9) | SRE(8) | UWE(7) | URE(6) | D(5) | A(4) | ...

// DTLB CAM arrays (128 entries, fully associative)
isa_state cam dtlb_tag[19:0]@[6:0][];
isa_state dtlb_tr_cam[31:0][6:0];

// Physical address for data store (output of this aspect)
var store_addr_pa[31:0];

// Exception handling for stores
var store_exception_taken[0:0];
var store_exception_vector[31:0];

// DTLB CAM lookup variables
var store_dme_enabled[0:0];
var store_vpn[18:0];
var store_offset[12:0];
var store_is_supervisor[0:0];

// DTLB CAM lookup results
var store_dtlb_search_key[19:0];
var store_dtlb_cam_matches[127:0];
var store_dtlb_hit_idx[7:0];
var store_dtlb_idx[6:0];

// Matched entry fields
var store_matched_dtlb_tr[31:0];
var store_dtlb_tr_ppn[18:0];
var store_dtlb_tr_swe[0:0];  // Supervisor write enable
var store_dtlb_tr_uwe[0:0];  // User write enable

var store_dtlb_hit[0:0];
var store_perm_ok[0:0];

// Check if DME is enabled
store_dme_enabled = sr[5];
store_is_supervisor = sr[0];

// Extract VPN and offset from store address
store_vpn = store_addr[31:13];
store_offset = store_addr[12:0];

// DTLB CAM lookup: search for {valid=1, VPN}
store_dtlb_search_key = {1'b1, store_vpn};
store_dtlb_cam_matches = dtlb_tag@[store_dtlb_search_key];

// Check for hit (gated by DME)
store_dtlb_hit = store_dme_enabled & (|store_dtlb_cam_matches);

// Get index of matching entry
store_dtlb_hit_idx = ctz(store_dtlb_cam_matches);
store_dtlb_idx = store_dtlb_hit_idx[6:0];

// Read translate register from matched entry
store_matched_dtlb_tr = dtlb_tr_cam[store_dtlb_idx];

// Extract PPN and write permissions
// DTLB TR:
//   URE=bit 6, UWE=bit 7, SRE=bit 8, SWE=bit 9
store_dtlb_tr_ppn = store_matched_dtlb_tr[31:13];
store_dtlb_tr_swe = store_matched_dtlb_tr[9];
store_dtlb_tr_uwe = store_matched_dtlb_tr[7];

// Check write permission based on mode
store_perm_ok = store_is_supervisor ? store_dtlb_tr_swe : store_dtlb_tr_uwe;

// Exception detection:
// 1. DTLB miss: vector 0x900
// 2. Data page fault (write): vector 0x300
var store_dtlb_miss[0:0];
var store_dpf[0:0];

store_dtlb_miss = store_dme_enabled & ~store_dtlb_hit;
store_dpf = store_dme_enabled & store_dtlb_hit & ~store_perm_ok;

// Gate by ~exception_taken: ITLB miss/interrupt means instruction was not
// properly fetched, so data exceptions must not fire (garbage instruction decode)
store_exception_taken = ~exception_taken & (store_dtlb_miss | store_dpf);
store_exception_vector = store_dtlb_miss ? 32'h00000900 : 32'h00000300;

// On store exception: save state and redirect
var store_exc_new_sr[31:0];
store_exc_new_sr = (sr & 32'hFFFFFF98) | 32'h00000001;

var store_saved_pc[31:0];
store_saved_pc = pc;

// Compose SR with current flag value for save (flag is tracked separately from sr[9])
var store_sr_with_flag[31:0];
store_sr_with_flag = (sr & 32'hFFFFFDFF) | {22'b0, flag, 9'b0};

// When data exception occurs during delay slot, save PC of the branch instruction
// (PC-4) so the branch re-executes on return from exception via l.rfe.
var store_epcr_save_pc[31:0];
store_epcr_save_pc = in_delay_slot ? (store_saved_pc - 4) : store_saved_pc;
epcr0 when (store_exception_taken) = store_epcr_save_pc;
esr0 when (store_exception_taken) = store_sr_with_flag;
eear0 when (store_exception_taken) = store_addr;
sr when (store_exception_taken) = store_exc_new_sr;
pc when (store_exception_taken) = store_exception_vector;

// Compute physical address
var store_translated[31:0];
store_translated = {store_dtlb_tr_ppn, store_offset};

store_addr_pa = store_dme_enabled ? (store_dtlb_hit ? store_translated : store_addr) : store_addr;
