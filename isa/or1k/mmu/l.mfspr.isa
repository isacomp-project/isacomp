// SPDX-License-Identifier: BSD-3-Clause
// OpenRISC l.mfspr with MMU - Move From Special Purpose Register
// Format: l.mfspr rD, rA, K
// rD <- SPR[rA|K]

isa_state pc[31:0];
var instr[31:0];
isa_state rf[31:0][4:0];
mem umem[23:0];
isa_state spr[31:0][15:0];
isa_state cam itlb_tag[19:0]@[6:0][];
isa_state itlb_tr_cam[31:0][6:0];
isa_state cam dtlb_tag[19:0]@[6:0][];
isa_state dtlb_tr_cam[31:0][6:0];
isa_state sr[31:0];
isa_state epcr0[31:0];
isa_state esr0[31:0];
isa_state eear0[31:0];
isa_state flag[0:0];
isa_state delay_slot[0:0];
isa_state branch_target[31:0];
isa_state ttmr[31:0];
isa_state ttcr[31:0];
isa_state picmr[31:0];
isa_state picsr[31:0];
ext isa_state irq_pending[31:0];


var rD[4:0];
var rA[4:0];
var imm[15:0];
var spr_addr[15:0];
var base[31:0];
var data[31:0];

// Instruction fetch MMU translation
aspect delay_slot.isa gates delay_slot;
aspect mmu.isa gates pc, sr, epcr0, esr0, eear0;

instr = umem[pc_pa];
assume instr[31:26] == 0x2D;
pc = (in_delay_slot & ~exception_taken) ? branch_target : pc + 4;
rD = instr[25:21];
rA = instr[20:16];
imm = instr[15:0];

base = rf[rA];
spr_addr = base[15:0] | imm;

// Key SPRs are isa_state registers - read from them directly
var spr_data[31:0];
spr_data = spr[spr_addr];

// SR = SPR 0x0011: compose from sr isa_state + flag (bit 9)
var sr_with_flag[31:0];
sr_with_flag = (sr & 32'hFFFFFDFF) | {22'b0, flag, 9'b0};

var is_sr[0:0];
var is_epcr0[0:0];
var is_eear0[0:0];
var is_esr0[0:0];
var is_immucfgr[0:0];
var is_dmmucfgr[0:0];
var reading_ttmr[0:0];
var reading_ttcr[0:0];
is_sr = (spr_addr == 16'h0011);
is_epcr0 = (spr_addr == 16'h0020);
is_eear0 = (spr_addr == 16'h0030);
is_esr0 = (spr_addr == 16'h0040);
// IMMUCFGR = SPR 0x1004 (IMMU group 2, index 4)
// DMMUCFGR = SPR 0x0804 (DMMU group 1, index 4)
// Report NTW=0 (1 way), NTS=7 (128 sets) = 0x38
is_immucfgr = (spr_addr == 16'h1004);
is_dmmucfgr = (spr_addr == 16'h0804);
// TTMR = SPR 0x5000 (Group 10, index 0)
// TTCR = SPR 0x5001 (Group 10, index 1)
reading_ttmr = (spr_addr == 16'h5000);
reading_ttcr = (spr_addr == 16'h5001);
// PICMR = SPR 0x4800 (Group 9, index 0)
// PICSR = SPR 0x4802 (Group 9, index 2)
var reading_picmr[0:0];
var reading_picsr[0:0];
reading_picmr = (spr_addr == 16'h4800);
reading_picsr = (spr_addr == 16'h4802);

// PICSR reflects live interrupt sources OR'd with stored status
var live_picsr[31:0];
live_picsr = (picsr | irq_pending) & picmr;

data = is_sr ? sr_with_flag :
       is_epcr0 ? epcr0 :
       is_eear0 ? eear0 :
       is_esr0 ? esr0 :
       is_immucfgr ? 32'h00000038 :
       is_dmmucfgr ? 32'h00000038 :
       reading_ttmr ? ttmr :
       reading_ttcr ? ttcr :
       reading_picmr ? picmr :
       reading_picsr ? live_picsr :
       spr_data;

rf[rD] when (~exception_taken) = data;

// Tick timer: counter increment and IP flag management
var tt_mode[1:0];
tt_mode = ttmr[31:30];
var tt_en[0:0];
tt_en = (tt_mode != 2'b00);
var tt_match[0:0];
tt_match = tt_en & (ttcr[27:0] == ttmr[27:0]);
var tt_new_count[27:0];
tt_new_count = tt_match ?
    ((tt_mode == 2'b01) ? 28'b0 :
     (tt_mode == 2'b10) ? ttcr[27:0] :
     ttcr[27:0] + 1) :
    ttcr[27:0] + 1;
ttcr = tt_en ? {ttcr[31:28], tt_new_count} : ttcr;
ttmr = tt_match ? (ttmr | 32'h10000000) : ttmr;
