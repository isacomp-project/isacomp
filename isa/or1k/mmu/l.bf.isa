// SPDX-License-Identifier: BSD-3-Clause
// OpenRISC l.bf with MMU - Branch if Flag Set
// Format: l.bf N
// if (flag) PC <- PC + sext(N << 2) else PC <- PC + 4

isa_state pc[31:0];
var instr[31:0];
isa_state rf[31:0][4:0];
mem umem[23:0];
isa_state spr[31:0][15:0];
isa_state cam itlb_tag[19:0]@[6:0][];
isa_state itlb_tr_cam[31:0][6:0];
isa_state cam dtlb_tag[19:0]@[6:0][];
isa_state dtlb_tr_cam[31:0][6:0];
isa_state sr[31:0];
isa_state epcr0[31:0];
isa_state esr0[31:0];
isa_state eear0[31:0];
isa_state flag[0:0];
isa_state delay_slot[0:0];
isa_state branch_target[31:0];
isa_state ttmr[31:0];
isa_state ttcr[31:0];


var imm[27:0];
var sign_ext_imm[31:0];
var branch_offset[31:0];
var pc_plus_4[31:0];
var branch_dest[31:0];

// Instruction fetch MMU translation
aspect delay_slot.isa gates delay_slot;
aspect mmu.isa gates pc, sr, epcr0, esr0, eear0;

instr = umem[pc_pa];
assume instr[31:26] == 0x04;
imm = {instr[25:0], 2'b0};

sign_ext_imm = {{4{imm[27]}}, imm};
branch_offset = sign_ext_imm;

pc_plus_4 = pc + 4;
branch_dest = pc + branch_offset;

// Set up delay slot only when branch is taken (flag == 1)
delay_slot when ((in_delay_slot == 0) & ~exception_taken & flag) = 1;
branch_target when ((in_delay_slot == 0) & ~exception_taken & flag) = branch_dest;
// Always advance to delay slot instruction
pc = (in_delay_slot & ~exception_taken) ? branch_target : pc + 4;

// Tick timer: counter increment and IP flag management
var tt_mode[1:0];
tt_mode = ttmr[31:30];
var tt_en[0:0];
tt_en = (tt_mode != 2'b00);
var tt_match[0:0];
tt_match = tt_en & (ttcr[27:0] == ttmr[27:0]);
var tt_new_count[27:0];
tt_new_count = tt_match ?
    ((tt_mode == 2'b01) ? 28'b0 :
     (tt_mode == 2'b10) ? ttcr[27:0] :
     ttcr[27:0] + 1) :
    ttcr[27:0] + 1;
ttcr = tt_en ? {ttcr[31:28], tt_new_count} : ttcr;
ttmr = tt_match ? (ttmr | 32'h10000000) : ttmr;
