// SPDX-License-Identifier: BSD-3-Clause
// OpenRISC l.csync - Context Synchronization
// Format: l.csync
// Context synchronization barrier - NOP in single-cycle implementation

isa_state pc[31:0];
var instr[31:0];
isa_state rf[31:0][4:0];
isa_state imem[31:0][9:0];
isa_state dmem[31:0][9:0];

instr = imem[pc];
assume instr[31:26] == 0x08;
assume instr[25:0] == 26'h3000000;
pc = pc + 4;
