// OpenRISC l.msync - Memory Synchronization
// Format: l.msync
// Memory barrier - ensures all memory operations complete
// NOP in single-cycle implementation

isa_state pc[31:0];
var instr[31:0];
isa_state rf[31:0][4:0];
isa_state imem[31:0][9:0];
isa_state dmem[31:0][9:0];

instr = imem[pc];
assume instr[31:26] == 0x08;
assume instr[25:0] == 26'h2000000;
pc = pc + 4;
