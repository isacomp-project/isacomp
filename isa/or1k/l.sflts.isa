// SPDX-License-Identifier: BSD-3-Clause
// OpenRISC l.sflts - Set Flag if Less Than Signed
// Format: l.sflts rA, rB

isa_state pc[31:0];
var instr[31:0];
isa_state rf[31:0][4:0];
isa_state imem[31:0][9:0];
isa_state dmem[31:0][9:0];
isa_state flag[0:0];

var rA[4:0];
var rB[4:0];
var r1[31:0];
var r2[31:0];

instr = imem[pc];
assume instr[31:26] == 0x39;
assume instr[25:21] == 0x0C;
pc = pc + 4;
rA = instr[20:16];
rB = instr[15:11];

r1 = rf[rA];
r2 = rf[rB];

flag = (r1 <s r2);
