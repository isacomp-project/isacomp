// SPDX-License-Identifier: BSD-3-Clause
// PDP-11 CMP instruction - Autodecrement Deferred to Index Deferred
// Source: mode 5, Dest: mode 7

isa_state pc[15:0];
var instr[15:0];
isa_state rf[15:0][2:0];  // 8 registers, R7 is PC
isa_state umem[7:0][15:0];      // Byte-addressable memory
isa_state flag_N[0:0];
isa_state flag_Z[0:0];
isa_state flag_V[0:0];
isa_state flag_C[0:0];

var src_reg[2:0];
var dst_reg[2:0];
var src_val[15:0];
var dst_val[15:0];
var result[15:0];
var ptr_addr[15:0];
var src_addr[15:0];
var ptr_lo[7:0];
var ptr_hi[7:0];
var src_lo[7:0];
var src_hi[7:0];
var dst_offset[15:0];
var dst_base[15:0];
var dptr_addr[15:0];
var dst_addr[15:0];
var doff_lo[7:0];
var doff_hi[7:0];
var dptr_lo[7:0];
var dptr_hi[7:0];
var dst_lo[7:0];
var dst_hi[7:0];


// Fetch instruction (little-endian)
var instr_lo[7:0];
var instr_hi[7:0];
instr_lo = umem[pc];
instr_hi = umem[pc + 1];
instr = {instr_hi, instr_lo};


assume instr[15:12] == 0b0010;  // CMP opcode
assume instr[11:9] == 0b101;    // Source mode 5 (autodecrement deferred)
assume instr[5:3] == 0b111;     // Dest mode 7 (index deferred)

src_reg = instr[8:6];
dst_reg = instr[2:0];

pc = pc + 2;

// Fetch source operand
// Decrement by 2 (always word for pointer), get pointer address
ptr_addr = rf[src_reg] - 2;
rf[src_reg] when (src_reg != 7) = ptr_addr;
// Fetch actual address from pointer
ptr_lo = umem[ptr_addr];
ptr_hi = umem[ptr_addr + 1];
src_addr = {ptr_hi, ptr_lo};
src_lo = umem[src_addr];
src_hi = umem[src_addr + 1];
src_val = {src_hi, src_lo};

// Fetch destination operand
// Fetch destination offset
doff_lo = umem[pc];
doff_hi = umem[pc + 1];
dst_offset = {doff_hi, doff_lo};
pc = pc + 2;
dst_base = dst_reg == 7 ? pc : rf[dst_reg];
dptr_addr = dst_base + dst_offset;
// Fetch actual address from pointer
dptr_lo = umem[dptr_addr];
dptr_hi = umem[dptr_addr + 1];
dst_addr = {dptr_hi, dptr_lo};
dst_lo = umem[dst_addr];
dst_hi = umem[dst_addr + 1];
dst_val = {dst_hi, dst_lo};

var diff[16:0];
diff = {1'b0, src_val} - {1'b0, dst_val};
result = diff[15:0];

// Write result

flag_N = result[15];
flag_Z = result == 0 ? 1'b1 : 1'b0;
flag_V = (src_val[15] != dst_val[15]) && (result[15] != src_val[15]) ? 1'b1 : 1'b0;
flag_C = diff[16];
