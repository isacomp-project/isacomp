// SPDX-License-Identifier: BSD-3-Clause
// PDP-11 SBCBB instruction - Register Deferred mode
// Dest: mode 1

isa_state pc[15:0];
var instr[15:0];
isa_state rf[15:0][2:0];  // 8 registers, R7 is PC
isa_state umem[7:0][15:0];      // Byte-addressable memory
isa_state flag_N[0:0];
isa_state flag_Z[0:0];
isa_state flag_V[0:0];
isa_state flag_C[0:0];

var dst_reg[2:0];
var dst_val[7:0];
var result[7:0];
var dst_addr[15:0];


// Fetch instruction (little-endian)
var instr_lo[7:0];
var instr_hi[7:0];
instr_lo = umem[pc];
instr_hi = umem[pc + 1];
instr = {instr_hi, instr_lo};


assume instr[15:6] == 0b1000101110;  // SBCBB opcode
assume instr[5:3] == 0b001;     // Dest mode 1 (register deferred)

dst_reg = instr[2:0];

pc = pc + 2;

// Fetch destination operand
dst_addr = dst_reg == 7 ? pc : rf[dst_reg];
dst_val = umem[dst_addr];

var diff[8:0];
diff = {1'b0, dst_val} - {8'b0, flag_C};
result = diff[7:0];

// Write result
umem[dst_addr] = result;

flag_N = result[7];
flag_Z = result == 0 ? 1'b1 : 1'b0;
flag_V = dst_val == 8'h80 && flag_C ? 1'b1 : 1'b0;
flag_C = diff[8];