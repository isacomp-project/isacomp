// SPDX-License-Identifier: BSD-3-Clause
// PDP-11 BIT instruction - Autoincrement Deferred to Indexed
// Source: mode 3, Dest: mode 6

isa_state pc[15:0];
var instr[15:0];
isa_state rf[15:0][2:0];  // 8 registers, R7 is PC
isa_state umem[7:0][15:0];      // Byte-addressable memory
isa_state flag_N[0:0];
isa_state flag_Z[0:0];
isa_state flag_V[0:0];
isa_state flag_C[0:0];

var src_reg[2:0];
var dst_reg[2:0];
var src_val[15:0];
var dst_val[15:0];
var result[15:0];
var ptr_addr[15:0];
var src_addr[15:0];
var ptr_lo[7:0];
var ptr_hi[7:0];
var src_lo[7:0];
var src_hi[7:0];
var dst_offset[15:0];
var dst_base[15:0];
var dst_addr[15:0];
var doff_lo[7:0];
var doff_hi[7:0];
var dst_lo[7:0];
var dst_hi[7:0];


// Fetch instruction (little-endian)
var instr_lo[7:0];
var instr_hi[7:0];
instr_lo = umem[pc];
instr_hi = umem[pc + 1];
instr = {instr_hi, instr_lo};


assume instr[15:12] == 0b0011;  // BIT opcode
assume instr[11:9] == 0b011;    // Source mode 3 (autoincrement deferred)
assume instr[5:3] == 0b110;     // Dest mode 6 (indexed)

src_reg = instr[8:6];
dst_reg = instr[2:0];

pc = pc + 2;

// Fetch source operand
// Get pointer address, increment by 2 (always word for pointer)
ptr_addr = rf[src_reg];
rf[src_reg] when (src_reg != 7) = rf[src_reg] + 2;
// Fetch actual address from pointer
ptr_lo = umem[ptr_addr];
ptr_hi = umem[ptr_addr + 1];
src_addr = {ptr_hi, ptr_lo};
src_lo = umem[src_addr];
src_hi = umem[src_addr + 1];
src_val = {src_hi, src_lo};

// Fetch destination operand
// Fetch destination offset
doff_lo = umem[pc];
doff_hi = umem[pc + 1];
dst_offset = {doff_hi, doff_lo};
pc = pc + 2;
dst_base = dst_reg == 7 ? pc : rf[dst_reg];
dst_addr = dst_base + dst_offset;
dst_lo = umem[dst_addr];
dst_hi = umem[dst_addr + 1];
dst_val = {dst_hi, dst_lo};

result = src_val & dst_val;

// Write result

flag_N = result[15];
flag_Z = result == 0 ? 1'b1 : 1'b0;
flag_V = 0;
