// SPDX-License-Identifier: BSD-3-Clause
// PDP-11 MARK instruction

isa_state pc[15:0];
var instr[15:0];
isa_state rf[15:0][2:0];  // 8 registers, R7 is PC
isa_state umem[7:0][15:0];      // Byte-addressable memory
isa_state flag_N[0:0];
isa_state flag_Z[0:0];
isa_state flag_V[0:0];
isa_state flag_C[0:0];

var n[5:0];
var sp[15:0];
var r5_lo[7:0];
var r5_hi[7:0];
var r5_val[15:0];


// Fetch instruction (little-endian)
var instr_lo[7:0];
var instr_hi[7:0];
instr_lo = umem[pc];
instr_hi = umem[pc + 1];
instr = {instr_hi, instr_lo};


assume instr[15:6] == 0b0000110100;  // MARK opcode

n = instr[5:0];
pc = pc + 2;

sp = pc + ({10'b0, n} << 1);
rf[6] = sp;

pc = rf[5];

r5_lo = umem[sp];
r5_hi = umem[sp + 1];
r5_val = {r5_hi, r5_lo};
rf[5] = r5_val;
rf[6] = sp + 2;
