// SPDX-License-Identifier: BSD-3-Clause
// PDP-11 CMPB instruction - Register Deferred to Index Deferred
// Source: mode 1, Dest: mode 7

isa_state pc[15:0];
var instr[15:0];
isa_state rf[15:0][2:0];  // 8 registers, R7 is PC
isa_state umem[7:0][15:0];      // Byte-addressable memory
isa_state flag_N[0:0];
isa_state flag_Z[0:0];
isa_state flag_V[0:0];
isa_state flag_C[0:0];

var src_reg[2:0];
var dst_reg[2:0];
var src_val[7:0];
var dst_val[7:0];
var result[7:0];
var src_addr[15:0];
var dst_offset[15:0];
var dst_base[15:0];
var dptr_addr[15:0];
var dst_addr[15:0];
var doff_lo[7:0];
var doff_hi[7:0];
var dptr_lo[7:0];
var dptr_hi[7:0];


// Fetch instruction (little-endian)
var instr_lo[7:0];
var instr_hi[7:0];
instr_lo = umem[pc];
instr_hi = umem[pc + 1];
instr = {instr_hi, instr_lo};


assume instr[15:12] == 0b1010;  // CMPB opcode
assume instr[11:9] == 0b001;    // Source mode 1 (register deferred)
assume instr[5:3] == 0b111;     // Dest mode 7 (index deferred)

src_reg = instr[8:6];
dst_reg = instr[2:0];

pc = pc + 2;

// Fetch source operand
src_addr = src_reg == 7 ? pc : rf[src_reg];
src_val = umem[src_addr];

// Fetch destination operand
// Fetch destination offset
doff_lo = umem[pc];
doff_hi = umem[pc + 1];
dst_offset = {doff_hi, doff_lo};
pc = pc + 2;
dst_base = dst_reg == 7 ? pc : rf[dst_reg];
dptr_addr = dst_base + dst_offset;
// Fetch actual address from pointer
dptr_lo = umem[dptr_addr];
dptr_hi = umem[dptr_addr + 1];
dst_addr = {dptr_hi, dptr_lo};
dst_val = umem[dst_addr];

var diff[8:0];
diff = {1'b0, src_val} - {1'b0, dst_val};
result = diff[7:0];

// Write result

flag_N = result[7];
flag_Z = result == 0 ? 1'b1 : 1'b0;
flag_V = (src_val[7] != dst_val[7]) && (result[7] != src_val[7]) ? 1'b1 : 1'b0;
flag_C = diff[8];
