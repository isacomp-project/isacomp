// SPDX-License-Identifier: BSD-3-Clause
// PDP-11 MOVB instruction - Indexed to Register
// Source: mode 6, Dest: mode 0

isa_state pc[15:0];
var instr[15:0];
isa_state rf[15:0][2:0];  // 8 registers, R7 is PC
isa_state umem[7:0][15:0];      // Byte-addressable memory
isa_state flag_N[0:0];
isa_state flag_Z[0:0];
isa_state flag_V[0:0];
isa_state flag_C[0:0];

var src_reg[2:0];
var dst_reg[2:0];
var src_val[7:0];
var dst_val[7:0];
var result[7:0];
var src_offset[15:0];
var base_addr[15:0];
var src_addr[15:0];
var soff_lo[7:0];
var soff_hi[7:0];


// Fetch instruction (little-endian)
var instr_lo[7:0];
var instr_hi[7:0];
instr_lo = umem[pc];
instr_hi = umem[pc + 1];
instr = {instr_hi, instr_lo};


assume instr[15:12] == 0b1001;  // MOVB opcode
assume instr[11:9] == 0b110;    // Source mode 6 (indexed)
assume instr[5:3] == 0b000;     // Dest mode 0 (register)

src_reg = instr[8:6];
dst_reg = instr[2:0];

pc = pc + 2;

// Fetch source operand
// Fetch source offset
soff_lo = umem[pc];
soff_hi = umem[pc + 1];
src_offset = {soff_hi, soff_lo};
pc = pc + 2;
base_addr = src_reg == 7 ? pc : rf[src_reg];
src_addr = base_addr + src_offset;
src_val = umem[src_addr];

// Fetch destination operand
dst_val = rf[dst_reg][7:0];

result = src_val;

// Write result
var extended[15:0];
extended = result[7] ? {8'hFF, result} : {8'h00, result};
rf[dst_reg] when (dst_reg != 7) = extended;

flag_N = result[7];
flag_Z = result == 0 ? 1'b1 : 1'b0;
flag_V = 0;
