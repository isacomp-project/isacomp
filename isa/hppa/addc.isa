// SPDX-License-Identifier: BSD-3-Clause
// HPPA ADDC instruction
// ADDC r1,r2,t - Add with Carry: t = r1 + r2 + PSW.C
// Opcode: 0x02 (bits 31:26), sub-op: 0x38 (bits 11:5)

isa_state pc[31:0];
isa_state psw[31:0];
isa_state rf[31:0][4:0];
mem umem[25:0];

// Branch delay slot state
isa_state delay_slot[0:0];
isa_state branch_target[31:0];

// === Aspects (order matters: nullify -> interruption -> delay_slot) ===
aspect mmu/nullify.isa gates pc:3, psw:3;
aspect mmu/interruption.isa gates pc:1, psw:1, cr17, cr17_back, cr18, cr18_back, cr19, cr20, cr21, cr22, priv_level, shadow_r1, shadow_r8, shadow_r9, shadow_r16, shadow_r17, shadow_r24, shadow_r25, code_iasq:1;
aspect mmu/delay_slot.isa gates pc:2, delay_slot, code_iasq:2, branch_target_space;


var instr[31:0];
var r1[4:0];
var r2[4:0];
var t[4:0];
var src1[31:0];
var src2[31:0];
var carry_in[0:0];
var res33[32:0];
var res[31:0];
var new_carry[0:0];
var cond_eq[0:0];
var cond_lt[0:0];
var cond_od[0:0];
var cond_le[0:0];
var overflow[0:0];
var cond_nuv[0:0];
var cond_znv[0:0];
var cond_base[0:0];
var cond_met[0:0];
var psw_c[31:0];
var psw_cn[31:0];

instr = umem[pc_pa];

assume instr[31:26] == 0b000010;
assume instr[11:5] == 0b0111000;

r2 = instr[25:21];
r1 = instr[20:16];
t = instr[4:0];

src1 = (r1 == 0) ? 32'h0 : rf[r1];
src2 = (r2 == 0) ? 32'h0 : rf[r2];

// Read carry from PSW.C (bit 15)
carry_in = psw[15];

// 33-bit addition with carry to capture carry out
res33 = {1'b0, src1} + {1'b0, src2} + {32'h0, carry_in};
res = res33[31:0];
new_carry = res33[32];

// Arithmetic conditional nullification (c=instr[15:13], f=instr[12])
cond_eq = (res == 0);
cond_lt = res[31];
cond_od = res[0];
cond_le = cond_lt | cond_eq;
// Signed overflow: both operands same sign, result different sign
overflow = (~(src1[31] ^ src2[31])) & (src1[31] ^ res[31]);
// ADD,C: NUV = no carry out, ZNV = zero and no carry
cond_nuv = ~new_carry;
cond_znv = cond_eq & ~new_carry;
cond_base = (instr[13] & ~instr[14] & ~instr[15] & cond_eq) |
            (~instr[13] & instr[14] & ~instr[15] & cond_lt) |
            (instr[13] & instr[14] & ~instr[15] & cond_le) |
            (~instr[13] & ~instr[14] & instr[15] & cond_nuv) |
            (instr[13] & ~instr[14] & instr[15] & cond_znv) |
            (~instr[13] & instr[14] & instr[15] & overflow) |
            (instr[13] & instr[14] & instr[15] & cond_od);
cond_met = cond_base ^ instr[12];

// Update PSW.C (bit 15) with new carry, conditionally set PSW.N (bit 21)
psw_c = new_carry ? (psw | 32'h00008000) : (psw & 32'hFFFF7FFF);
psw_cn = cond_met ? (psw_c | 32'h00200000) : psw_c;
psw when (~instr_trap_taken & ~in_nullified) = psw_cn;

rf[t] when (t != 0 & ~instr_trap_taken & ~in_nullified) = res;
pc = pc + 4;
