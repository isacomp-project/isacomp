// SPDX-License-Identifier: BSD-3-Clause
// HPPA ADDITO instruction
// ADDITO r1,r2,t - Add and trap on overflow
// Opcode: 0x02 (bits 31:26)

isa_state pc[31:0];
isa_state psw[31:0];
isa_state rf[31:0][4:0];
mem umem[25:0];

// Branch delay slot state
isa_state delay_slot[0:0];
isa_state branch_target[31:0];

// === Aspects (order matters: nullify -> interruption -> delay_slot) ===
aspect mmu/nullify.isa gates pc:3, psw:3;
aspect mmu/interruption.isa gates pc:1, psw:1, cr17, cr17_back, cr18, cr18_back, cr19, cr20, cr21, cr22, priv_level, shadow_r1, shadow_r8, shadow_r9, shadow_r16, shadow_r17, shadow_r24, shadow_r25, code_iasq:1;
aspect mmu/delay_slot.isa gates pc:2, delay_slot, code_iasq:2, branch_target_space;


var instr[31:0];
var r1[4:0];
var r2[4:0];
var t[4:0];
var src1[31:0];
var src2[31:0];
var res[31:0];
var carry[0:0];
var overflow[0:0];
var psw_c[31:0];

instr = umem[pc_pa];

assume instr[31:26] == 0b000010;
assume instr[11:6] == 0b111000;  // ADDITO encoding

r2 = instr[25:21];
r1 = instr[20:16];
t = instr[4:0];

src1 = (r1 == 0) ? 32'h0 : rf[r1];
src2 = (r2 == 0) ? 32'h0 : rf[r2];

res = src1 + src2;

// Carry out of addition (unsigned overflow)
carry = (src1[31] & src2[31]) | ((src1[31] ^ src2[31]) & ~res[31]);
// Detect signed overflow (both inputs same sign, result different sign)
overflow = (~(src1[31] ^ src2[31])) & (src1[31] ^ res[31]);

rf[t] when (t != 0 & ~instr_trap_taken & ~in_nullified) = res;

// Update PSW: bit 15 = carry, bit 24 = overflow
psw_c = carry ? (psw | 32'h00008000) : (psw & 32'hFFFF7FFF);
psw when (~instr_trap_taken & ~in_nullified) = overflow ? (psw_c | 32'h01000000) : (psw_c & 32'hFEFFFFFF);

pc = pc + 4;
