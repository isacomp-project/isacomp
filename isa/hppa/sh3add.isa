// SPDX-License-Identifier: BSD-3-Clause
// HPPA SH3ADD instruction
// SH3ADD r1,r2,t - Shift 3 and add: t = (r1 << 3) + r2
// Opcode: 0x02 (bits 31:26), Sub-opcode: 0x36 (bits 11:5)

isa_state pc[31:0];
isa_state psw[31:0];
isa_state rf[31:0][4:0];
mem umem[25:0];

// Branch delay slot state
isa_state delay_slot[0:0];
isa_state branch_target[31:0];

// === Aspects (order matters: nullify -> interruption -> delay_slot) ===
aspect mmu/nullify.isa gates pc:3, psw:3;
aspect mmu/interruption.isa gates pc:1, psw:1, cr17, cr17_back, cr18, cr18_back, cr19, cr20, cr21, cr22, priv_level, shadow_r1, shadow_r8, shadow_r9, shadow_r16, shadow_r17, shadow_r24, shadow_r25, code_iasq:1;
aspect mmu/delay_slot.isa gates pc:2, delay_slot, code_iasq:2, branch_target_space;


var instr[31:0];
var r1[4:0];
var r2[4:0];
var t[4:0];
var src1[31:0];
var src2[31:0];
var shifted[31:0];
var res[31:0];

instr = umem[pc_pa];

// SH3ADD encoding: opcode=0x02 (bits 31:26), sub-opcode=0x36 (bits 11:5)
assume instr[31:26] == 0b000010;
assume instr[11:5] == 0b0110110;

// Extract register fields
r2 = instr[25:21];
r1 = instr[20:16];
t = instr[4:0];

// Read source registers (r0 always reads as 0)
src1 = (r1 == 0) ? 32'h0 : rf[r1];
src2 = (r2 == 0) ? 32'h0 : rf[r2];

// Shift left by 3 and add
shifted = src1 << 3;
res = shifted + src2;

// Write result to target (r0 writes are discarded)
rf[t] when (t != 0 & ~instr_trap_taken & ~in_nullified) = res;

// Advance PC by 4
pc = pc + 4;
