// SPDX-License-Identifier: BSD-3-Clause
// HPPA FCPY,DBL instruction
// FCPY,DBL fr,ft - Double-precision floating-point copy
// Opcode: 0x0C (bits 31:26) for coprocessor

isa_state pc[31:0];
isa_state psw[31:0];
isa_state rf[31:0][4:0];
isa_state frf[63:0][4:0];
mem umem[25:0];

// Branch delay slot state
isa_state delay_slot[0:0];
isa_state branch_target[31:0];

// === Aspects (order matters: nullify -> interruption -> delay_slot) ===
aspect mmu/nullify.isa gates pc:3, psw:3;
aspect mmu/interruption.isa gates pc:1, psw:1, cr17, cr17_back, cr18, cr18_back, cr19, cr20, cr21, cr22, priv_level, shadow_r1, shadow_r8, shadow_r9, shadow_r16, shadow_r17, shadow_r24, shadow_r25, code_iasq:1;
aspect mmu/delay_slot.isa gates pc:2, delay_slot, code_iasq:2, branch_target_space;


var instr[31:0];
var r[4:0];
var t[4:0];
var src_lo[31:0];
var src_hi[31:0];

instr = umem[pc_pa];

// HPPA FP opcode 0x0C (coprocessor)
assume instr[31:26] == 0b001100;

// Sub-opcode for FCPY (bits 12:9 = 0010, bits 5:4 = 01 for double)
assume instr[12:9] == 0b0010;
assume instr[5:4] == 0b01;

r = instr[25:21];
t = instr[4:0];

// Read and copy double (even/odd register pair)
src_lo = frf[r];
src_hi = frf[r | 5'b00001];
frf[t] = src_lo;
frf[t | 5'b00001] = src_hi;

pc = pc + 4;
