// SPDX-License-Identifier: BSD-3-Clause
// HPPA BE instruction
// BE wd(sr,b) - Branch External
// Opcode: 0x38 (bits 31:26)

isa_state pc[31:0];
isa_state psw[31:0];
isa_state rf[31:0][4:0];
isa_state sr0[31:0];
isa_state sr1[31:0];
isa_state sr2[31:0];
isa_state sr3[31:0];
isa_state sr4[31:0];
isa_state sr5[31:0];
isa_state sr6[31:0];
isa_state sr7[31:0];
mem umem[25:0];

// Branch delay slot state
isa_state delay_slot[0:0];
isa_state branch_target[31:0];
isa_state branch_target_space[31:0];

// === Aspects (order matters: nullify -> interruption -> delay_slot) ===
aspect mmu/nullify.isa gates pc:3, psw:3;
aspect mmu/interruption.isa gates pc:1, psw:1, cr17, cr17_back, cr18, cr18_back, cr19, cr20, cr21, cr22, priv_level, shadow_r1, shadow_r8, shadow_r9, shadow_r16, shadow_r17, shadow_r24, shadow_r25, code_iasq:1;
aspect mmu/delay_slot.isa gates pc:2, delay_slot, code_iasq:2, branch_target_space;


var instr[31:0];
var b[4:0];
var sr[2:0];
var w[16:0];
var w1[10:0];
var w2[1:0];
var base[31:0];
var offset[31:0];
var target[31:0];

instr = umem[pc_pa];

// BE encoding
assume instr[31:26] == 0b111000;

b = instr[25:21];
// Space register: 3-bit SCRAMBLED field at bits[15:13]
// SR = {s3[0], s3[2], s3[1]} = {instr[13], instr[15], instr[14]}
sr = {instr[13], instr[15], instr[14]};

// Assemble 17-bit word displacement
// w = assemble_17(instr)
w1 = instr[20:16];
w2 = instr[12:11];
w = {instr[0], w1, instr[2], w2, instr[10:3]};

// Sign extend and shift
offset = {{13{w[16]}}, w, 2'b00};

base = (b == 0) ? 32'h0 : rf[b];
target = base + offset;

// In real HPPA, this would also change space register
// For simulation, just branch to target
// Set up delay slot: next instruction executes, then branch takes effect
// ,n: set PSW.N=1 so the delay slot instruction is nullified
psw when (instr[1] & ~in_delay_slot & ~instr_trap_taken & ~in_nullified) = psw | 32'h00200000;

// Select target space register from sr field (instr[15:13])
var target_space[31:0];
target_space = (sr == 0) ? sr0 :
               (sr == 1) ? sr1 :
               (sr == 2) ? sr2 :
               (sr == 3) ? sr3 :
               (sr == 4) ? sr4 :
               (sr == 5) ? sr5 :
               (sr == 6) ? sr6 : sr7;

delay_slot when (~in_delay_slot & ~instr_trap_taken & ~in_nullified) = 1;
branch_target when (~in_delay_slot & ~instr_trap_taken & ~in_nullified) = target;
branch_target_space when (~in_delay_slot & ~instr_trap_taken & ~in_nullified) = target_space;
pc = pc + 4;
