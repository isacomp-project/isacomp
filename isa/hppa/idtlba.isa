// SPDX-License-Identifier: BSD-3-Clause
// HPPA IDTLBA instruction
// IDTLBA r,(sr,b) - Insert Data TLB Address (stage translation)
// Opcode: 0x01 (bits 31:26), ext=0b0000010 (bits 11:5), bit[12]=1 (data TLB)
//
// Two-step TLB insert: IDTLBA stages VPN+space+PPN, IDTLBP completes with
// protection word and commits to the DTLB.
//
// GR[r] contains the physical page address (PPN in bits[31:12])
// GR[b] contains the virtual address (VPN from bits[31:12])
// SR[s] (bits[15:14]) selects the space register for the space ID

isa_state pc[31:0];
isa_state psw[31:0];
isa_state rf[31:0][4:0];
mem umem[25:0];

// Branch delay slot state
isa_state delay_slot[0:0];
isa_state branch_target[31:0];

// Space registers (for space ID lookup)
isa_state sr0[31:0];
isa_state sr1[31:0];
isa_state sr2[31:0];
isa_state sr3[31:0];

// DTLB insertion staging registers
isa_state dtlb_ins_vpn[19:0];
isa_state dtlb_ins_space[31:0];
isa_state dtlb_ins_ppn[19:0];
isa_state dtlb_ins_pending[0:0];

// Round-robin replacement pointer (shared with IDTLBP, declared here so merger
// creates proper mux — single-instruction-only states lose their _wr assignment)
isa_state dtlb_next[3:0];

// === Aspects (order matters: nullify -> interruption -> delay_slot) ===
aspect mmu/nullify.isa gates pc:3, psw:3;
aspect mmu/interruption.isa gates pc:1, psw:1, cr17, cr17_back, cr18, cr18_back, cr19, cr20, cr21, cr22, priv_level, shadow_r1, shadow_r8, shadow_r9, shadow_r16, shadow_r17, shadow_r24, shadow_r25, code_iasq:1;
aspect mmu/delay_slot.isa gates pc:2, delay_slot, code_iasq:2, branch_target_space;


var instr[31:0];
var r[4:0];
var b[4:0];

instr = umem[pc_pa];

// IDTLBA encoding: opcode=0x01, bits[11:5]=0b0000010, bit[12]=1 (data TLB, associate)
assume instr[31:26] == 0b000001;
assume instr[11:5] == 0b0000010;
assume instr[12] == 1'b1;
assume instr[13] == 1'b0;

// PA-RISC encoding: b=instr[25:21] (base=virtual address), r=instr[20:16] (source=PTE)
b = instr[25:21];
r = instr[20:16];

// Source register values
var pte_value[31:0];
var base[31:0];
pte_value = (r == 0) ? 32'h0 : rf[r];
base = (b == 0) ? 32'h0 : rf[b];

// Space register selection — DTLB uses 2-bit: instr[15:14] → SR0-SR3
var sr_sel[1:0];
sr_sel = instr[15:14];
var space_id[31:0];
space_id = (sr_sel == 2'b00) ? sr0 :
           (sr_sel == 2'b01) ? sr1 :
           (sr_sel == 2'b10) ? sr2 : sr3;

// Stage the translation for the subsequent IDTLBP
var active[0:0];
active = ~instr_trap_taken & ~in_nullified;

dtlb_ins_vpn when (active) = base[31:12];
dtlb_ins_space when (active) = space_id;
// Linux make_insert_tlb_11: clears PTE[11:0], shifts right by 7
// Result: PPN at bits[24:5], page_size at bits[4:0] (0 for 4K)
dtlb_ins_ppn when (active) = pte_value[24:5];
dtlb_ins_pending when (active) = 1'b1;

pc = pc + 4;
