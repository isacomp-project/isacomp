// SPDX-License-Identifier: BSD-3-Clause
// HPPA STW indexed instruction
// STW[,s] r,x(s,b) - Store Word Indexed
// Opcode: 0x03 (bits 31:26), bit[12]=0 (indexed form)
// bits[25:21]=b (base), bits[20:16]=x (index), bits[4:0]=r (source)
// bit[13]=u: when 1, shift index left by 2 (the ,s completer for word access)
// bits[9:6]=1010 (STW sub-opcode)

isa_state pc[31:0];
isa_state psw[31:0];
isa_state rf[31:0][4:0];
mem umem[25:0];

// Branch delay slot state
isa_state delay_slot[0:0];
isa_state branch_target[31:0];

// === Aspects (order matters: nullify -> interruption -> delay_slot) ===
aspect mmu/nullify.isa gates pc:4, psw:4;
aspect mmu/interruption.isa gates pc:2, psw:2, cr17:2, cr17_back:2, cr18:2, cr18_back:2, cr19:2, cr20:2, cr21:2, cr22:2, priv_level:2, shadow_r1:2, shadow_r8:2, shadow_r9:2, shadow_r16:2, shadow_r17:2, shadow_r24:2, shadow_r25:2, code_iasq:2;
aspect mmu/delay_slot.isa gates pc:3, delay_slot:2, code_iasq:3, branch_target_space;
aspect mmu/data_trap_store.isa gates pc:1, psw:1, cr17:1, cr17_back:1, cr18:1, cr18_back:1, cr19:1, cr20:1, cr21:1, cr22:1, priv_level:1, shadow_r1:1, shadow_r8:1, shadow_r9:1, shadow_r16:1, shadow_r17:1, shadow_r24:1, shadow_r25:1, delay_slot:1, code_iasq:1;

var instr[31:0];
var b[4:0];
var x[4:0];
var r[4:0];
var base[31:0];
var index[31:0];
var shifted_index[31:0];
var addr[31:0];
var data[31:0];

instr = umem[pc_pa];

// Indexed store format opcode
assume instr[31:26] == 0b000011;
assume instr[12] == 1'b0;

// Sub-opcode bits for STW (bits 9:6 = 1010)
assume instr[9:6] == 0b1010;

b = instr[25:21];
x = instr[20:16];
r = instr[4:0];

base = (b == 0) ? 32'h0 : rf[b];
index = (x == 0) ? 32'h0 : rf[x];
data = (r == 0) ? 32'h0 : rf[r];

// bit[13] = shift completer: shift index left by 2 for word access
shifted_index = instr[13] ? {index[29:0], 2'b00} : index;
addr = base + shifted_index;

umem[da_pa] when (~instr_trap_taken & ~data_trap_taken & ~in_nullified) = data;

pc = pc + 4;
