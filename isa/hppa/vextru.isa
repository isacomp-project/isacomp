// SPDX-License-Identifier: BSD-3-Clause
// HPPA VEXTRU instruction
// VEXTRU r,len,t - Variable Extract Right Unsigned
// Extracts len bits from r using SAR for position, zero extends result
// Opcode: 0x34 (bits 31:26)

isa_state pc[31:0];
isa_state psw[31:0];
isa_state rf[31:0][4:0];
isa_state sar[4:0];
mem umem[25:0];

// Branch delay slot state
isa_state delay_slot[0:0];
isa_state branch_target[31:0];

// === Aspects (order matters: nullify -> interruption -> delay_slot) ===
aspect mmu/nullify.isa gates pc:3, psw:3;
aspect mmu/interruption.isa gates pc:1, psw:1, cr17, cr17_back, cr18, cr18_back, cr19, cr20, cr21, cr22, priv_level, shadow_r1, shadow_r8, shadow_r9, shadow_r16, shadow_r17, shadow_r24, shadow_r25, code_iasq:1;
aspect mmu/delay_slot.isa gates pc:2, delay_slot, code_iasq:2, branch_target_space;


var instr[31:0];
var r[4:0];
var t[4:0];
var len[5:0];
var src[31:0];
var shift_amt[4:0];
var shifted[31:0];
var mask[31:0];
var res[31:0];
var cond_eq[0:0];
var cond_lt[0:0];
var cond_od[0:0];
var cond_base[0:0];
var cond_met[0:0];

instr = umem[pc_pa];

assume instr[31:26] == 0b110100;
assume instr[12:10] == 0b100;  // VEXTRU sub-opcode

r = instr[25:21];
t = instr[20:16];
len = 32 - instr[4:0];  // clen5 field at bits[4:0]

src = (r == 0) ? 32'h0 : rf[r];

// PA-RISC VEXTRU: same as EXTRU but pos comes from SAR register.
// shift = 31 - sar
shift_amt = 31 - sar;

// Shift right and mask to len bits (zero-extend)
shifted = src >> shift_amt;
mask = (1 << len) - 1;
res = shifted & mask;

// Conditional nullification (3-bit condition in bits[15:13])
cond_eq = (res == 0);
cond_lt = res[31];
cond_od = res[0];
cond_base = (instr[13] & ~instr[14] & cond_eq) | (~instr[13] & instr[14] & cond_lt) | (instr[13] & instr[14] & cond_od);
cond_met = cond_base ^ instr[15];
psw when (cond_met & ~instr_trap_taken & ~in_nullified) = psw | 32'h00200000;

rf[t] when (t != 0 & ~instr_trap_taken & ~in_nullified) = res;
pc = pc + 4;
