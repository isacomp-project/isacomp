// SPDX-License-Identifier: BSD-3-Clause
// HPPA STW short modify-before instruction (IM5 format)
// STW,MB r,d(b) — Store Word Modify Before:
//   b += low_sign5(d);  then mem[b] = r
// Opcode: 0x03 (bits 31:26), bit12=1 (short), bit9=1 (store),
//         bits7:6=10 (word), bit5=1 (modify), bit13=1 (before)

isa_state pc[31:0];
isa_state psw[31:0];
isa_state rf[31:0][4:0];
mem umem[25:0];

// Branch delay slot state
isa_state delay_slot[0:0];
isa_state branch_target[31:0];

// === Aspects (order matters: nullify -> interruption -> delay_slot) ===
aspect mmu/nullify.isa gates pc:4, psw:4;
aspect mmu/interruption.isa gates pc:2, psw:2, cr17:2, cr17_back:2, cr18:2, cr18_back:2, cr19:2, cr20:2, cr21:2, cr22:2, priv_level:2, shadow_r1:2, shadow_r8:2, shadow_r9:2, shadow_r16:2, shadow_r17:2, shadow_r24:2, shadow_r25:2, code_iasq:2;
aspect mmu/delay_slot.isa gates pc:3, delay_slot:2, code_iasq:3, branch_target_space;
aspect mmu/data_trap_store.isa gates pc:1, psw:1, cr17:1, cr17_back:1, cr18:1, cr18_back:1, cr19:1, cr20:1, cr21:1, cr22:1, priv_level:1, shadow_r1:1, shadow_r8:1, shadow_r9:1, shadow_r16:1, shadow_r17:1, shadow_r24:1, shadow_r25:1, delay_slot:1, code_iasq:1;

var instr[31:0];
var b[4:0];
var r[4:0];
var disp_sign[0:0];
var disp_mag[3:0];
var sign_ext_disp[31:0];
var base[31:0];
var new_base[31:0];

instr = umem[pc_pa];

// STW short MB encoding: opcode=0x03, bit12=1, bit9=1, bits7:6=10, bit5=1, bit13=1
assume instr[31:26] == 0b000011;
assume instr[12] == 1'b1;
assume instr[9] == 1'b1;
assume instr[7:6] == 2'b10;
assume instr[5] == 1'b1;
assume instr[13] == 1'b1;

// Extract register fields
b = instr[25:21];
r = instr[20:16];

// 5-bit low_sign displacement: bit[0]=sign, bits[4:1]=magnitude
disp_sign = instr[0];
disp_mag = instr[4:1];

// Sign-extend: 28 copies of sign + 4-bit magnitude = 32 bits
sign_ext_disp = {{28{disp_sign}}, disp_mag};

// MB: new_base = base + disp (modify before), then store at new_base
base = (b == 0) ? 32'h0 : rf[b];
new_base = base + sign_ext_disp;
var addr[31:0];
addr = new_base;

// Store data to memory at new (modified) base address
var data[31:0];
data = (r == 0) ? 32'h0 : rf[r];

umem[da_pa] when (~instr_trap_taken & ~data_trap_taken & ~in_nullified) = data;

// Write back: base register = new_base
rf[b] when (~instr_trap_taken & ~data_trap_taken & ~in_nullified & (b != 0)) = new_base;

// Advance PC by 4
pc = pc + 4;
