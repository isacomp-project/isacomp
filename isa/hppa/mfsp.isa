// SPDX-License-Identifier: BSD-3-Clause
// HPPA MFSP instruction
// MFSP sr,t - Move From Space Register
// Opcode: 0x00 (bits 31:26), function=0x25 (bits 12:5)
//
// Correct PA-RISC 1.1 encoding (verified from cross-assembler output):
//   000000 00000 00000 000 s1s0 00100 101 s2 ttttt
//   bits[25:21] = 00000 (fixed)
//   bits[20:16] = 00000 (fixed)
//   Space register = {instr[13], instr[15], instr[14]} (bit-swapped 3-bit field)
//   bits[12:5] = 0x25 (function code)
//   bits[4:0] = t (target general register)

isa_state pc[31:0];
isa_state psw[31:0];
isa_state rf[31:0][4:0];
isa_state sr0[31:0];
isa_state sr1[31:0];
isa_state sr2[31:0];
isa_state sr3[31:0];
isa_state sr4[31:0];
isa_state sr5[31:0];
isa_state sr6[31:0];
isa_state sr7[31:0];
mem umem[25:0];

// Branch delay slot state
isa_state delay_slot[0:0];
isa_state branch_target[31:0];

// === Aspects (order matters: nullify -> interruption -> delay_slot) ===
aspect mmu/nullify.isa gates pc:3, psw:3;
aspect mmu/interruption.isa gates pc:1, psw:1, cr17, cr17_back, cr18, cr18_back, cr19, cr20, cr21, cr22, priv_level, shadow_r1, shadow_r8, shadow_r9, shadow_r16, shadow_r17, shadow_r24, shadow_r25, code_iasq:1;
aspect mmu/delay_slot.isa gates pc:2, delay_slot, code_iasq:2, branch_target_space;


var instr[31:0];
var sr[2:0];
var t[4:0];
var value[31:0];

instr = umem[pc_pa];

// MFSP encoding: bits[31:26]=0x00, bits[25:16]=0, bits[12:5]=0x25
assume instr[31:26] == 0b000000;
assume instr[25:21] == 0b00000;
assume instr[20:16] == 0b00000;
assume instr[12:5] == 0b00100101;

// Space register = {instr[13], instr[15], instr[14]} (PA-RISC bit-swapped encoding)
sr = {instr[13], instr[15], instr[14]};
t = instr[4:0];

// Read space register
value = (sr == 0) ? sr0 :
        (sr == 1) ? sr1 :
        (sr == 2) ? sr2 :
        (sr == 3) ? sr3 :
        (sr == 4) ? sr4 :
        (sr == 5) ? sr5 :
        (sr == 6) ? sr6 :
        sr7;

rf[t] when (t != 0 & ~instr_trap_taken & ~in_nullified) = value;
pc = pc + 4;
