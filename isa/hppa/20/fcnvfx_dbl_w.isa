// SPDX-License-Identifier: BSD-3-Clause
// HPPA PA-RISC 2.0 FCNVFX,DBL,W instruction
// FCNVFX,DBL,W fr,ft - Convert double-precision FP to 32-bit integer (with rounding)
// ft(w) = int(fr(dbl)) using current rounding mode
// Opcode: 0x0C (bits 31:26), sub-bits[12:9]=1101, src_fmt[5:4]=01 (double), dst_fmt[7:6]=00 (word)

isa_state pc[63:0];
isa_state psw[63:0];
isa_state rf[63:0][4:0];
isa_state frf[63:0][4:0];
mem umem[25:0];

// Branch delay slot state
isa_state delay_slot[0:0];
isa_state branch_target[63:0];

// === Aspects ===
aspect mmu/nullify.isa gates pc:4, psw:4;
aspect mmu/interruption.isa gates pc:2, psw:2, cr17, cr17_back, cr18, cr18_back, cr19, cr20, cr21, cr22, priv_level, shadow_r1, shadow_r8, shadow_r9, shadow_r16, shadow_r17, shadow_r24, shadow_r25, code_iasq:2;
aspect mmu/delay_slot.isa gates pc:3, delay_slot:2, code_iasq:3, branch_target_space;


var instr[31:0];
var fr[4:0];
var ft[4:0];

instr = umem[pc_pa];

// FCNVFX,DBL,W encoding: opcode=0x0C, sub[12:9]=1101, src_fmt[5:4]=01, dst_fmt[7:6]=00
assume instr[31:26] == 0b001100;
assume instr[12:9] == 0b1101;   // FCNVFX sub-opcode
assume instr[5:4] == 0b01;      // Source: DBL
assume instr[7:6] == 0b00;      // Dest: W (word)

// Extract register fields
fr = instr[25:21];
ft = instr[4:0];

// Read source FP register (full 64-bit for double-precision)
var src[63:0]; src = frf[fr];

// Convert double-precision FP to 32-bit signed integer (with current rounding mode)
var res[31:0]; res = fp_cvt_w_d(src, 3'b000);

// Write result to target FP register (integer in lower 32 bits, upper zeroed)
frf[ft] when (~instr_trap_taken & ~in_nullified) = {32'h0, res};

// Advance PC by 4
pc = pc + 4;
