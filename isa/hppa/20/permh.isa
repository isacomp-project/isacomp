// SPDX-License-Identifier: BSD-3-Clause
// HPPA PA-RISC 2.0 PERMH instruction (MAX SIMD)
// PERMH r,t - Halfword Permute
// Rearranges 4 halfwords in a register according to 2-bit selectors
// c3=instr[7:6], c2=instr[5:4], c1=instr[3:2], c0=instr[1:0]
// Each ci selects which source halfword goes to destination position i
// Opcode: 0x0E (bits 31:26), Sub: 0x00 (bits 12:8), with bits[15:13]=110

isa_state pc[63:0];
isa_state psw[63:0];
isa_state rf[63:0][4:0];
mem umem[25:0];

// Branch delay slot state
isa_state delay_slot[0:0];
isa_state branch_target[63:0];

// === Aspects ===
aspect mmu/nullify.isa gates pc:4, psw:4;
aspect mmu/interruption.isa gates pc:2, psw:2, cr17, cr17_back, cr18, cr18_back, cr19, cr20, cr21, cr22, priv_level, shadow_r1, shadow_r8, shadow_r9, shadow_r16, shadow_r17, shadow_r24, shadow_r25, code_iasq:2;
aspect mmu/delay_slot.isa gates pc:3, delay_slot:2, code_iasq:3, branch_target_space;


var instr[31:0];
var r[4:0];
var t[4:0];
var src[63:0];
var res[63:0];

instr = umem[pc_pa];

// PERMH encoding: opcode=0x0E, bits[15:13]=110, bits[12:8]=00000
assume instr[31:26] == 0b001110;
assume instr[15:13] == 0b110;
assume instr[12:8] == 0b00000;

// Extract register fields
r = instr[25:21];
t = instr[20:16];

// Read source register (r0 always reads as 0)
src = (r == 0) ? 64'h0 : rf[r];

// Extract halfwords from source
var hw0[15:0]; hw0 = src[15:0];
var hw1[15:0]; hw1 = src[31:16];
var hw2[15:0]; hw2 = src[47:32];
var hw3[15:0]; hw3 = src[63:48];

// Extract 2-bit selectors from instruction
var c0[1:0]; c0 = instr[1:0];
var c1[1:0]; c1 = instr[3:2];
var c2[1:0]; c2 = instr[5:4];
var c3[1:0]; c3 = instr[7:6];

// Select halfwords based on selectors
var sel0[15:0]; sel0 = (c0 == 2'b00) ? hw0 : (c0 == 2'b01) ? hw1 : (c0 == 2'b10) ? hw2 : hw3;
var sel1[15:0]; sel1 = (c1 == 2'b00) ? hw0 : (c1 == 2'b01) ? hw1 : (c1 == 2'b10) ? hw2 : hw3;
var sel2[15:0]; sel2 = (c2 == 2'b00) ? hw0 : (c2 == 2'b01) ? hw1 : (c2 == 2'b10) ? hw2 : hw3;
var sel3[15:0]; sel3 = (c3 == 2'b00) ? hw0 : (c3 == 2'b01) ? hw1 : (c3 == 2'b10) ? hw2 : hw3;

// Compose result: {sel3, sel2, sel1, sel0}
res = {sel3, sel2, sel1, sel0};

// Write result to target (r0 writes are discarded)
rf[t] when (t != 0 & ~instr_trap_taken & ~in_nullified) = res;

// Advance PC by 4
pc = pc + 4;
