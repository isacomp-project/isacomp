// SPDX-License-Identifier: BSD-3-Clause
// =============================================================================
// LDCD - Load and Clear Doubleword (PA-RISC 2.0, 64-bit)
// Format: LDCD d(s,b),t
// Opcode: 0x03 (000011), sub-opcode for LDCD
// =============================================================================
//
// Atomically loads a 64-bit doubleword from memory and clears (zeroes)
// the location. Used for 64-bit spinlock/semaphore operations.
// This is the 64-bit counterpart of LDCW.
//
// Field encoding:
//   instr[31:26] = 000011 (opcode 0x03)
//   instr[25:21] = b (base register)
//   instr[20:16] = t (target register)
//   instr[15:14] = space (space register select)
//   instr[12:9]  = 0101 (sub-opcode for LDCD)
//   instr[4:0]   = im5 (5-bit immediate displacement)
//
// =============================================================================

isa_state pc[63:0];
isa_state psw[63:0];
isa_state rf[63:0][4:0];
mem umem[25:0];

// Branch delay slot state
isa_state delay_slot[0:0];
isa_state branch_target[63:0];

// === Aspects ===
aspect mmu/nullify.isa gates pc:4, psw:4;
aspect mmu/interruption.isa gates pc:2, psw:2, cr17:2, cr17_back:2, cr18:2, cr18_back:2, cr19:2, cr20:2, cr21:2, cr22:2, priv_level:2, shadow_r1:2, shadow_r8:2, shadow_r9:2, shadow_r16:2, shadow_r17:2, shadow_r24:2, shadow_r25:2, code_iasq:2;
aspect mmu/delay_slot.isa gates pc:3, delay_slot:2, code_iasq:3, branch_target_space;
aspect mmu/data_trap_load.isa gates pc:1, psw:1, cr17:1, cr17_back:1, cr18:1, cr18_back:1, cr19:1, cr20:1, cr21:1, cr22:1, priv_level:1, shadow_r1:1, shadow_r8:1, shadow_r9:1, shadow_r16:1, shadow_r17:1, shadow_r24:1, shadow_r25:1, delay_slot:1, code_iasq:1;

// =========================================================================
// Fetch and decode instruction
// =========================================================================
var instr[31:0];
instr = umem[pc_pa];

assume instr[31:26] == 0b000011;
assume instr[12:9] == 0b0101;

// =========================================================================
// Decode instruction fields
// =========================================================================
var b[4:0];
var x[4:0];
var t[4:0];
b = instr[25:21];
x = instr[20:16];
t = instr[4:0];

// =========================================================================
// Address computation (indexed)
// =========================================================================
var base[63:0];
base = (b == 0) ? 64'h0 : rf[b];

var index[63:0];
index = (x == 0) ? 64'h0 : rf[x];

var addr[63:0];
addr = base + index;

// =========================================================================
// Memory load (full 64-bit doubleword) - atomic read
// =========================================================================
var data[63:0];
data = umem[da_pa];

// =========================================================================
// Register writeback (loaded value)
// =========================================================================
rf[t] when (t != 0 & ~instr_trap_taken & ~data_trap_taken & ~in_nullified) = data;

// =========================================================================
// Memory clear (write zero to the same address) - atomic write
// =========================================================================
umem[da_pa] when (~instr_trap_taken & ~data_trap_taken & ~in_nullified) = 64'h0;

// =========================================================================
// PC update
// =========================================================================
pc = pc + 4;
