// SPDX-License-Identifier: BSD-3-Clause
// =============================================================================
// STD - Store Doubleword (PA-RISC 2.0, 64-bit) -- NEW in PA2.0
// Format: STD r,d(b)
// Opcode: 0x1C (011100)
// =============================================================================
//
// Stores a full 64-bit doubleword from a register to memory.
// Uses 14-bit low-sign-extended displacement.
//
// Field encoding:
//   instr[31:26] = 011100 (opcode 0x1C)
//   instr[25:21] = b (base register)
//   instr[20:16] = r (source register)
//   instr[13:0]  = d (14-bit displacement, low-sign format)
//
// =============================================================================

isa_state pc[63:0];
isa_state psw[63:0];
isa_state rf[63:0][4:0];
mem umem[25:0];

// Branch delay slot state
isa_state delay_slot[0:0];
isa_state branch_target[63:0];

// === Aspects ===
aspect mmu/nullify.isa gates pc:4, psw:4;
aspect mmu/interruption.isa gates pc:2, psw:2, cr17:2, cr17_back:2, cr18:2, cr18_back:2, cr19:2, cr20:2, cr21:2, cr22:2, priv_level:2, shadow_r1:2, shadow_r8:2, shadow_r9:2, shadow_r16:2, shadow_r17:2, shadow_r24:2, shadow_r25:2, code_iasq:2;
aspect mmu/delay_slot.isa gates pc:3, delay_slot:2, code_iasq:3, branch_target_space;
aspect mmu/data_trap_store.isa gates pc:1, psw:1, cr17:1, cr17_back:1, cr18:1, cr18_back:1, cr19:1, cr20:1, cr21:1, cr22:1, priv_level:1, shadow_r1:1, shadow_r8:1, shadow_r9:1, shadow_r16:1, shadow_r17:1, shadow_r24:1, shadow_r25:1, delay_slot:1, code_iasq:1;

var instr[31:0];
instr = umem[pc_pa];

assume instr[31:26] == 0b011100;
assume instr[3] == 1'b0;  // bit[3]=0 for plain STD (vs STD,MA/MB which have bit[3]=1)
assume instr[1] == 1'b0;  // bit[1]=0 for GR store (bit[1]=1 is FSTD from FR)

// =========================================================================
// Decode instruction fields
// =========================================================================
var b[4:0];
var r[4:0];
b = instr[25:21];
r = instr[20:16];

// =========================================================================
// 14-bit low-sign displacement extraction
// =========================================================================
var disp_sign[0:0];
var disp_mag[12:0];
var sign_ext_disp[63:0];
disp_sign = instr[0];
disp_mag = instr[13:1];
sign_ext_disp = {{51{disp_sign}}, disp_mag};

// =========================================================================
// Address computation
// =========================================================================
var base[63:0];
base = (b == 0) ? 64'h0 : rf[b];

var addr[63:0];
addr = base + sign_ext_disp;

// =========================================================================
// Source data (full 64-bit doubleword)
// =========================================================================
var data[63:0];
data = (r == 0) ? 64'h0 : rf[r];

// =========================================================================
// Memory store (64-bit doubleword)
// =========================================================================
umem[da_pa] when (~instr_trap_taken & ~data_trap_taken & ~in_nullified) = data;

// =========================================================================
// PC update
// =========================================================================
pc = pc + 4;
