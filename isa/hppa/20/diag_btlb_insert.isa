// SPDX-License-Identifier: BSD-3-Clause
// HPPA PA-RISC 2.0 DIAG BTLB Insert instruction (64-bit)
// DIAG for BTLB insert - Diagnostic instruction for Block TLB insertion
// Opcode: 0x05 (bits 31:26), sub-function 0x01 (bits 5:0)
//
// Encoding: opcode(6) | r1(5) | r2(5) | r3(5) | r4(5) | 000001(6)
//   r1 = VA base register
//   r2 = PA base register
//   r3 = page mask register
//   r4 = params register: space[31:16], slot[4:2], type[1:0]
//       type: 00=none, 01=I-only, 10=D-only, 11=I+D
//
// Privileged, implementation-dependent instruction.

isa_state pc[63:0];
isa_state psw[63:0];
isa_state rf[63:0][4:0];
mem umem[25:0];

// Branch delay slot state
isa_state delay_slot[0:0];
isa_state branch_target[63:0];

// BTLB state (8 entries indexed [2:0])
isa_state btlb_valid[0:0][2:0];
isa_state btlb_va_base[63:0][2:0];
isa_state btlb_pa_base[63:0][2:0];
isa_state btlb_page_mask[63:0][2:0];
isa_state btlb_space[63:0][2:0];
isa_state btlb_type_i[0:0][2:0];
isa_state btlb_type_d[0:0][2:0];

// === Aspects ===
aspect mmu/nullify.isa gates pc:4, psw:4;
aspect mmu/interruption.isa gates pc:2, psw:2, cr17, cr17_back, cr18, cr18_back, cr19, cr20, cr21, cr22, priv_level, shadow_r1, shadow_r8, shadow_r9, shadow_r16, shadow_r17, shadow_r24, shadow_r25, code_iasq:2;
aspect mmu/delay_slot.isa gates pc:3, delay_slot:2, code_iasq:3, branch_target_space;


var instr[31:0];

instr = umem[pc_pa];

// DIAG BTLB Insert encoding: opcode=0x05, sub=0x01
assume instr[31:26] == 0b000101;
assume instr[5:0] == 6'b000001;

// Decode register fields
var r1[4:0];
var r2[4:0];
var r3[4:0];
var r4[4:0];
r1 = instr[25:21];
r2 = instr[20:16];
r3 = instr[15:11];
r4 = instr[10:6];

// Read register values
var va_base[63:0];
var pa_base[63:0];
var page_mask[63:0];
var params[63:0];
va_base   = (r1 == 0) ? 64'h0 : rf[r1];
pa_base   = (r2 == 0) ? 64'h0 : rf[r2];
page_mask = (r3 == 0) ? 64'h0 : rf[r3];
params    = (r4 == 0) ? 64'h0 : rf[r4];

// Extract fields from params register
var slot[2:0];
var type_i[0:0];
var type_d[0:0];
var space_id[63:0];
slot    = params[4:2];
type_i  = params[0];
type_d  = params[1];
space_id = {32'h0, params[31:16], 16'h0};

// Write BTLB entry (gated on not being trapped/nullified)
var active[0:0];
active = ~instr_trap_taken & ~in_nullified;

btlb_valid[slot]     when (active) = 1'b1;
btlb_va_base[slot]   when (active) = va_base;
btlb_pa_base[slot]   when (active) = pa_base;
btlb_page_mask[slot] when (active) = page_mask;
btlb_space[slot]     when (active) = space_id;
btlb_type_i[slot]    when (active) = type_i;
btlb_type_d[slot]    when (active) = type_d;

pc = pc + 4;
