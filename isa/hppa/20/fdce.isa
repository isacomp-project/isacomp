// SPDX-License-Identifier: BSD-3-Clause
// HPPA PA-RISC 2.0 FDCE instruction (64-bit)
// FDCE - Flush Data Cache Entry
// Opcode: 0x01 (bits 31:26), sub=0x48 (bits 12:5)
// Flushes a data cache entry. Cache effects not modeled.
// b = instr[25:21], x = instr[20:16]

isa_state pc[63:0];
isa_state psw[63:0];
isa_state rf[63:0][4:0];
mem umem[25:0];

// Branch delay slot state
isa_state delay_slot[0:0];
isa_state branch_target[63:0];

// === Aspects ===
aspect mmu/nullify.isa gates pc:4, psw:4;
aspect mmu/interruption.isa gates pc:2, psw:2, cr17, cr17_back, cr18, cr18_back, cr19, cr20, cr21, cr22, priv_level, shadow_r1, shadow_r8, shadow_r9, shadow_r16, shadow_r17, shadow_r24, shadow_r25, code_iasq:2;
aspect mmu/delay_slot.isa gates pc:3, delay_slot:2, code_iasq:3, branch_target_space;


var instr[31:0];

instr = umem[pc_pa];

// FDCE encoding: opcode=0x01, sub=0x48
assume instr[31:26] == 0b000001;
assume instr[11:6] == 0b001011;
assume instr[12] == 1'b1;
assume instr[5] == 1'b0;

// FDCE: flush d-cache entry - no modeled side effects, just advance PC
pc = pc + 4;
