// SPDX-License-Identifier: BSD-3-Clause
// =============================================================================
// FSTD,MA - FP Store Double with Modify After (PA-RISC 2.0, 64-bit)
// Format: FSTD,MA fr,d(s,b)
// Opcode: 0x0B (001011)
// =============================================================================
//
// Stores a 64-bit FP register to memory, then modifies the base register.
// The store uses the original base address, and the base register is updated
// to base + disp after the store.
//
// Operation: mem[base] = fr; base = base + disp
//
// Field encoding:
//   instr[31:26] = 001011 (opcode 0x0B)
//   instr[25:21] = b (base register)
//   instr[20:16] = im5 (5-bit displacement, low_sign_ext)
//   instr[15:14] = space (space register select)
//   instr[12]    = 1 (displacement mode)
//   instr[9]     = 1 (store)
//   instr[6]     = 1 (address modify)
//   instr[5]     = 0 (modify after)
//   instr[4:0]   = fr (source FP register)
//
// =============================================================================

isa_state pc[63:0];
isa_state psw[63:0];
isa_state rf[63:0][4:0];
isa_state frf[63:0][4:0];
mem umem[25:0];

// Branch delay slot state
isa_state delay_slot[0:0];
isa_state branch_target[63:0];

// === Aspects ===
aspect mmu/nullify.isa gates pc:4, psw:4;
aspect mmu/interruption.isa gates pc:2, psw:2, cr17:2, cr17_back:2, cr18:2, cr18_back:2, cr19:2, cr20:2, cr21:2, cr22:2, priv_level:2, shadow_r1:2, shadow_r8:2, shadow_r9:2, shadow_r16:2, shadow_r17:2, shadow_r24:2, shadow_r25:2, code_iasq:2;
aspect mmu/delay_slot.isa gates pc:3, delay_slot:2, code_iasq:3, branch_target_space;
aspect mmu/data_trap_store.isa gates pc:1, psw:1, cr17:1, cr17_back:1, cr18:1, cr18_back:1, cr19:1, cr20:1, cr21:1, cr22:1, priv_level:1, shadow_r1:1, shadow_r8:1, shadow_r9:1, shadow_r16:1, shadow_r17:1, shadow_r24:1, shadow_r25:1, delay_slot:1, code_iasq:1;

var instr[31:0];
instr = umem[pc_pa];

assume instr[31:26] == 0b001011;
assume instr[12] == 1'b1;   // displacement mode (not indexed)
assume instr[9] == 1'b1;    // store (not load)
assume instr[6] == 1'b1;    // address modify
assume instr[5] == 1'b0;    // modify after

// =========================================================================
// Decode instruction fields
// =========================================================================
var b[4:0];
var fr[4:0];
b = instr[25:21];
fr = instr[4:0];

// =========================================================================
// 5-bit displacement extraction (low_sign_ext)
// =========================================================================
var disp[4:0];
disp = instr[20:16];
var sign_ext_disp[63:0];
sign_ext_disp = {{60{disp[0]}}, disp[4:1]};

// =========================================================================
// Address computation (modify after: store to original base, then modify)
// =========================================================================
var base[63:0];
base = (b == 0) ? 64'h0 : rf[b];

// The store address is the original base (before modification)
var addr[63:0];
addr = base;

// The new base value (computed after the store)
var new_base[63:0];
new_base = base + sign_ext_disp;

// =========================================================================
// Read FP source register (full 64-bit)
// =========================================================================
var data[63:0];
data = frf[fr];

// =========================================================================
// Memory store (64-bit doubleword) to original base address
// =========================================================================
umem[da_pa] when (~instr_trap_taken & ~data_trap_taken & ~in_nullified) = data;

// =========================================================================
// Base register modify (write new address back to base register)
// On trap, modification must NOT be applied (guarded by ~data_trap_taken)
// =========================================================================
rf[b] when (b != 0 & ~instr_trap_taken & ~data_trap_taken & ~in_nullified) = new_base;

// =========================================================================
// PC update
// =========================================================================
pc = pc + 4;
