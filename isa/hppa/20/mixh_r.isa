// SPDX-License-Identifier: BSD-3-Clause
// HPPA PA-RISC 2.0 MIXH,R instruction (MAX SIMD)
// MIXH,R r1,r2,t - Mix Halfwords Right
// Interleaves lower halfwords from each word:
// t = {r1[47:32], r2[47:32], r1[15:0], r2[15:0]}
// Opcode: 0x0E (bits 31:26), bits[15:13]=100, bits[12:8]=00000

isa_state pc[63:0];
isa_state psw[63:0];
isa_state rf[63:0][4:0];
mem umem[25:0];

// Branch delay slot state
isa_state delay_slot[0:0];
isa_state branch_target[63:0];

// === Aspects ===
aspect mmu/nullify.isa gates pc:4, psw:4;
aspect mmu/interruption.isa gates pc:2, psw:2, cr17, cr17_back, cr18, cr18_back, cr19, cr20, cr21, cr22, priv_level, shadow_r1, shadow_r8, shadow_r9, shadow_r16, shadow_r17, shadow_r24, shadow_r25, code_iasq:2;
aspect mmu/delay_slot.isa gates pc:3, delay_slot:2, code_iasq:3, branch_target_space;


var instr[31:0];
var r1[4:0];
var r2[4:0];
var t[4:0];
var src1[63:0];
var src2[63:0];
var res[63:0];

instr = umem[pc_pa];

// MIXH,R encoding: opcode=0x0E, bits[15:13]=100, bits[12:8]=00000
assume instr[31:26] == 0b001110;
assume instr[15:13] == 0b100;
assume instr[12:8] == 0b00000;
assume instr[7:5] == 0b110;

// Extract register fields
r2 = instr[25:21];
r1 = instr[20:16];
t = instr[4:0];

// Read source registers (r0 always reads as 0)
src1 = (r1 == 0) ? 64'h0 : rf[r1];
src2 = (r2 == 0) ? 64'h0 : rf[r2];

// Mix halfwords right: interleave lower halfwords from each word
// t = {r1[47:32], r2[47:32], r1[15:0], r2[15:0]}
res = {src1[47:32], src2[47:32], src1[15:0], src2[15:0]};

// Write result to target (r0 writes are discarded)
rf[t] when (t != 0 & ~instr_trap_taken & ~in_nullified) = res;

// Advance PC by 4
pc = pc + 4;
