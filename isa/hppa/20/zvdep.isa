// SPDX-License-Identifier: BSD-3-Clause
// HPPA PA-RISC 2.0 ZVDEP instruction (32-bit zero and variable deposit)
// ZVDEP r,len,t - Zero and Variable Deposit: deposits 'len' low-order bits
// of r into t at the position specified by SAR, zeros all other bits.
// Opcode: 0x35 (bits 31:26), sub: bits[12:10]=000

isa_state pc[63:0];
isa_state psw[63:0];
isa_state rf[63:0][4:0];
isa_state sar[5:0];
mem umem[25:0];

// Branch delay slot state
isa_state delay_slot[0:0];
isa_state branch_target[63:0];

// === Aspects ===
aspect mmu/nullify.isa gates pc:4, psw:4;
aspect mmu/interruption.isa gates pc:2, psw:2, cr17, cr17_back, cr18, cr18_back, cr19, cr20, cr21, cr22, priv_level, shadow_r1, shadow_r8, shadow_r9, shadow_r16, shadow_r17, shadow_r24, shadow_r25, code_iasq:2;
aspect mmu/delay_slot.isa gates pc:3, delay_slot:2, code_iasq:3, branch_target_space;


var instr[31:0];
var r[4:0];
var t[4:0];
var clen[4:0];
var len[5:0];
var pos[4:0];
var shift_amt[4:0];
var src[63:0];
var mask[63:0];
var deposited[63:0];
var res[63:0];
var cond_eq[0:0];
var cond_lt[0:0];
var cond_od[0:0];
var cond_base[0:0];
var cond_met[0:0];

instr = umem[pc_pa];

// ZVDEP encoding: opcode=0x35, bits[12:10]=000, bit[9]=0 (32-bit word)
// bit[9]=1 would be the 64-bit doubleword variant (zvdepd.isa)
assume instr[31:26] == 0b110101;
assume instr[12:10] == 0b000;
assume instr[9] == 0;

// Extract fields
r = instr[20:16];
t = instr[25:21];
clen = instr[4:0];

// len = 32 - clen
len = 6'b100000 - {1'b0, clen};

// Position from SAR (low 5 bits for 32-bit operation)
pos = sar[4:0];

// shift_amt = 31 - pos (convert PA-RISC position to shift amount)
shift_amt = 5'b11111 - pos;

// Read source register
src = (r == 0) ? 64'h0 : rf[r];

// Mask the low 'len' bits of source
mask = (64'h1 << len) - 64'h1;
deposited = (src & mask) << shift_amt;

// Zero and deposit: result is just the deposited bits, zero-extended
res = {32'h0, deposited[31:0]};

// 3-bit conditional nullification (c=instr[15:13])
cond_eq = (res == 0);
cond_lt = res[63];
cond_od = res[0];
cond_base = (instr[13] & ~instr[14] & cond_eq) | (~instr[13] & instr[14] & cond_lt) | (instr[13] & instr[14] & cond_od);
cond_met = cond_base ^ instr[15];
psw when (cond_met & ~instr_trap_taken & ~in_nullified) = psw | 64'h0000000000200000;

// Write result to target
rf[t] when (t != 0 & ~instr_trap_taken & ~in_nullified) = res;

// Advance PC
pc = pc + 4;
