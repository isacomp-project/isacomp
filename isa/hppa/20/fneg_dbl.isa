// SPDX-License-Identifier: BSD-3-Clause
// HPPA PA-RISC 2.0 FNEG,DBL instruction
// FNEG,DBL fr,ft - Double-precision floating-point negate
// ft = -fr (flip sign bit)
// Opcode: 0x0C (bits 31:26), sub-bits[12:9]=1000, fmt bits[5:4]=01 (double)

isa_state pc[63:0];
isa_state psw[63:0];
isa_state rf[63:0][4:0];
isa_state frf[63:0][4:0];
mem umem[25:0];

// Branch delay slot state
isa_state delay_slot[0:0];
isa_state branch_target[63:0];

// === Aspects ===
aspect mmu/nullify.isa gates pc:4, psw:4;
aspect mmu/interruption.isa gates pc:2, psw:2, cr17, cr17_back, cr18, cr18_back, cr19, cr20, cr21, cr22, priv_level, shadow_r1, shadow_r8, shadow_r9, shadow_r16, shadow_r17, shadow_r24, shadow_r25, code_iasq:2;
aspect mmu/delay_slot.isa gates pc:3, delay_slot:2, code_iasq:3, branch_target_space;


var instr[31:0];
var fr[4:0];
var ft[4:0];

instr = umem[pc_pa];

// FNEG,DBL encoding: opcode=0x0C, sub[12:9]=1000, fmt[5:4]=01
assume instr[31:26] == 0b001100;
assume instr[12:9] == 0b1000;
assume instr[5:4] == 0b01;

// Extract register fields
fr = instr[25:21];
ft = instr[4:0];

// Read source FP register (full 64-bit for double-precision)
var src[63:0]; src = frf[fr];

// Flip sign bit (bit 63) to negate
var res[63:0]; res = {~src[63], src[62:0]};

// Write result to target FP register
frf[ft] when (~instr_trap_taken & ~in_nullified) = res;

// Advance PC by 4
pc = pc + 4;
