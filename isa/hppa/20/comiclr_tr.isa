// SPDX-License-Identifier: BSD-3-Clause
// HPPA PA-RISC 2.0 COMICLR,TR instruction (64-bit)
// COMICLR (always true) im11,r,t - Compare Immediate and Clear (always clears)
// Opcode: 0x24 (bits 31:26)
// r=instr[25:21], t=instr[20:16], im11=instr[10:0]
// TR condition (c=000, f=0): always true, always clears t to 0

isa_state pc[63:0];
isa_state psw[63:0];
isa_state rf[63:0][4:0];
mem umem[25:0];

// Branch delay slot state
isa_state delay_slot[0:0];
isa_state branch_target[63:0];

// === Aspects (order matters: nullify -> interruption -> delay_slot) ===
aspect mmu/nullify.isa gates pc:4, psw:4;
aspect mmu/interruption.isa gates pc:2, psw:2, cr17, cr17_back, cr18, cr18_back, cr19, cr20, cr21, cr22, priv_level, shadow_r1, shadow_r8, shadow_r9, shadow_r16, shadow_r17, shadow_r24, shadow_r25, code_iasq:2;
aspect mmu/delay_slot.isa gates pc:3, delay_slot:2, code_iasq:3, branch_target_space;


var instr[31:0];
var r[4:0];
var t[4:0];
var im11[10:0];
var imm[63:0];
var ci_src[63:0];
var ci_res[63:0];

instr = umem[pc_pa];

// COMICLR encoding: opcode=0x24
assume instr[31:26] == 0b100100;
assume instr[15:12] == 4'b0001;

// Extract fields
r = instr[25:21];
t = instr[20:16];
im11 = instr[10:0];

// Low-sign-extend 11-bit immediate: bit[0]=sign, bits[10:1]=value
imm = {{53{im11[0]}}, im11[0], im11[10:1]};

// Read source register (r0 reads as 0)
var psw_W[0:0];
psw_W = psw[27];
var ci_use_wide[0:0];
ci_use_wide = 1'b0;  // COMICLR has no d-bit: always 32-bit sign-extended comparison
ci_src = (r == 0) ? 64'h0 : (ci_use_wide ? rf[r] : {{32{rf[r][31]}}, rf[r][31:0]});

// Compute subtraction
ci_res = imm - ci_src;

// TR condition: always true, always write 0 to t and nullify next instruction
rf[t] when (t != 0 & ~instr_trap_taken & ~in_nullified) = 64'h0;

// Always nullify next instruction (TR condition always met)
psw when (~instr_trap_taken & ~in_nullified) = psw | 64'h0000000000200000;

// Advance PC
pc = pc + 4;
