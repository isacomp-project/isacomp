// SPDX-License-Identifier: BSD-3-Clause
// HPPA PA-RISC 2.0 FICE,M instruction (64-bit)
// FICE,M - Flush Instruction Cache Entry with Modify
// Opcode: 0x01 (bits 31:26), sub=0x09 (bits 12:5)
// Flushes an instruction cache entry with base register modification.
// Cache effects not modeled; base register modification is modeled.
// b = instr[25:21], x = instr[20:16]

isa_state pc[63:0];
isa_state psw[63:0];
isa_state rf[63:0][4:0];
mem umem[25:0];

// Branch delay slot state
isa_state delay_slot[0:0];
isa_state branch_target[63:0];

// === Aspects ===
aspect mmu/nullify.isa gates pc:4, psw:4;
aspect mmu/interruption.isa gates pc:2, psw:2, cr17, cr17_back, cr18, cr18_back, cr19, cr20, cr21, cr22, priv_level, shadow_r1, shadow_r8, shadow_r9, shadow_r16, shadow_r17, shadow_r24, shadow_r25, code_iasq:2;
aspect mmu/delay_slot.isa gates pc:3, delay_slot:2, code_iasq:3, branch_target_space;


var instr[31:0];
var b[4:0];
var x[4:0];
var base[63:0];
var index[63:0];

instr = umem[pc_pa];

// FICE,M encoding: opcode=0x01, sub=0x09
assume instr[31:26] == 0b000001;
assume instr[11:6] == 0b001011;
assume instr[12] == 1'b0;
assume instr[5] == 1'b1;

// Extract fields
b = instr[25:21];
x = instr[20:16];

// Compute base register modification
base = (b == 0) ? 64'h0 : rf[b];
index = (x == 0) ? 64'h0 : rf[x];

// Modify base register: b = b + x
rf[b] when (b != 0 & ~instr_trap_taken & ~in_nullified) = base + index;

// FICE,M: flush i-cache entry with modify - advance PC
pc = pc + 4;
