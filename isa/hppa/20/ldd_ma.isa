// SPDX-License-Identifier: BSD-3-Clause
// =============================================================================
// LDD,MA - Load Doubleword with Modify After (PA-RISC 2.0, 64-bit)
// Format: LDD,MA d(b),t
// Opcode: 0x14 (010100), bit[3]=1, bit[0]=0
// =============================================================================
//
// Loads a full 64-bit doubleword from memory, then modifies the base register
// after the load. Uses 10-bit signed displacement << 3.
//
// Operation: t = mem[base]; base = base + disp
//
// Field encoding:
//   instr[31:26] = 010100 (opcode 0x14)
//   instr[25:21] = b (base register)
//   instr[20:16] = t (target register)
//   instr[15:14] = space (space register select)
//   instr[13:4]  = 10-bit signed displacement (before <<3)
//   instr[3]     = 1 (modify flag)
//   instr[0]     = 0 (modify after)
//
// =============================================================================

isa_state pc[63:0];
isa_state psw[63:0];
isa_state rf[63:0][4:0];
mem umem[25:0];

// Branch delay slot state
isa_state delay_slot[0:0];
isa_state branch_target[63:0];

// === Aspects ===
aspect mmu/nullify.isa gates pc:4, psw:4;
aspect mmu/interruption.isa gates pc:2, psw:2, cr17:2, cr17_back:2, cr18:2, cr18_back:2, cr19:2, cr20:2, cr21:2, cr22:2, priv_level:2, shadow_r1:2, shadow_r8:2, shadow_r9:2, shadow_r16:2, shadow_r17:2, shadow_r24:2, shadow_r25:2, code_iasq:2;
aspect mmu/delay_slot.isa gates pc:3, delay_slot:2, code_iasq:3, branch_target_space;
aspect mmu/data_trap_load.isa gates pc:1, psw:1, cr17:1, cr17_back:1, cr18:1, cr18_back:1, cr19:1, cr20:1, cr21:1, cr22:1, priv_level:1, shadow_r1:1, shadow_r8:1, shadow_r9:1, shadow_r16:1, shadow_r17:1, shadow_r24:1, shadow_r25:1, delay_slot:1, code_iasq:1;

var instr[31:0];
instr = umem[pc_pa];

assume instr[31:26] == 0b010100;
assume instr[3] == 1'b1;
assume instr[1] == 1'b0;  // bit[1]=0 for GR load (bit[1]=1 is FLDD to FR)
assume instr[0] == 1'b0;

// =========================================================================
// Decode instruction fields
// =========================================================================
var b[4:0];
var t[4:0];
b = instr[25:21];
t = instr[20:16];

// =========================================================================
// 10-bit signed displacement << 3 (doubleword-aligned)
// =========================================================================
var disp10[9:0];
var sign_ext_disp[63:0];
disp10 = instr[13:4];
sign_ext_disp = {{54{disp10[9]}}, disp10};
var disp_shifted[63:0];
disp_shifted = {sign_ext_disp[60:0], 3'b000};

// =========================================================================
// Address computation (modify after: load from base, then base = base + disp)
// =========================================================================
var base[63:0];
base = (b == 0) ? 64'h0 : rf[b];

var addr[63:0];
addr = base;

var new_base[63:0];
new_base = base + disp_shifted;

// =========================================================================
// Memory load (full 64-bit doubleword)
// =========================================================================
var data[63:0];
data = umem[da_pa];

// =========================================================================
// Register writeback (loaded data)
// =========================================================================
rf[t] when (t != 0 & t != b & ~instr_trap_taken & ~data_trap_taken & ~in_nullified) = data;

// =========================================================================
// Base register modify (update base after load)
// =========================================================================
rf[b] when (b != 0 & ~instr_trap_taken & ~data_trap_taken & ~in_nullified) = new_base;

// =========================================================================
// PC update
// =========================================================================
pc = pc + 4;
