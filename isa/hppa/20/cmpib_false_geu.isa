// SPDX-License-Identifier: BSD-3-Clause
// HPPA PA-RISC 2.0 CMPIB,*GEU instruction (64-bit wide compare-immediate-and-branch)
// Compare Immediate and Branch False - always 64-bit comparison
// Opcode: 0x3B (bits 31:26), condition c=100

isa_state pc[63:0];
isa_state psw[63:0];
isa_state rf[63:0][4:0];
mem umem[25:0];

// Branch delay slot state
isa_state delay_slot[0:0];
isa_state branch_target[63:0];

// === Aspects (order matters: nullify -> interruption -> delay_slot) ===
aspect mmu/nullify.isa gates pc:4, psw:4;
aspect mmu/interruption.isa gates pc:2, psw:2, cr17, cr17_back, cr18, cr18_back, cr19, cr20, cr21, cr22, priv_level, shadow_r1, shadow_r8, shadow_r9, shadow_r16, shadow_r17, shadow_r24, shadow_r25, code_iasq:2;
aspect mmu/delay_slot.isa gates pc:3, delay_slot:2, code_iasq:3, branch_target_space;


var instr[31:0];
var ci_r[4:0];
var ci_im5[4:0];
var src1[63:0];
var src2[63:0];
var w[11:0];
var target_offset[63:0];
var target[63:0];
var taken[0:0];

instr = umem[pc_pa];

// Encoding: opcode=0x3B, c=100
assume instr[31:26] == 0b111011;
assume instr[15:13] == 0b100;

// Field ordering: r=[25:21], im5=[20:16] (same as narrow COMIBT/COMIBF)
ci_r = instr[25:21];
ci_im5 = instr[20:16];

// Sign-extend 5-bit immediate (low-sign-extend: bit[0]=sign, bits[4:1]=value)
src1 = {{60{ci_im5[0]}}, ci_im5[0], ci_im5[4:1]};

// Read source register (r0 reads as 0) - always full 64-bit
src2 = (ci_r == 0) ? 64'h0 : rf[ci_r];

// Displacement: narrow format for CMPIB (same as COMIBT)
w = {instr[0], instr[2], instr[12:4], instr[3]};

// Sign-extend and word-align
target_offset = {{50{w[11]}}, w, 2'b00};
target = pc + 8 + target_offset;

// Condition evaluation (always 64-bit, remapped encoding)
taken = (src1 >= src2);

// If condition met, set up branch via delay slot
delay_slot when (taken & ~in_delay_slot & ~instr_trap_taken & ~in_nullified) = 1;
branch_target when (taken & ~in_delay_slot & ~instr_trap_taken & ~in_nullified) = target;

// Nullification: n-bit with forward/backward direction check
var n_nullify[0:0];
n_nullify = instr[1] & (taken ^ w[11]);
psw when (n_nullify & ~in_delay_slot & ~instr_trap_taken & ~in_nullified) = psw | 64'h0000000000200000;

pc = pc + 4;
