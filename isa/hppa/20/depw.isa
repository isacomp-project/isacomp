// SPDX-License-Identifier: BSD-3-Clause
// HPPA PA-RISC 2.0 DEPW instruction (32-bit deposit word, fixed position, preserve)
// DEPW r,pos,len,t - Deposit Word: deposits 'len' low-order bits of r at
// fixed position 'pos', preserving bits outside the deposited field.
// Opcode: 0x35 (bits 31:26), sub: bits[12:10]=011
// t=instr[25:21], r=instr[20:16], cp=instr[9:5], clen=instr[4:0]
// cp = 31 - pos (PA-RISC encoding)

isa_state pc[63:0];
isa_state psw[63:0];
isa_state rf[63:0][4:0];
isa_state sar[5:0];
mem umem[25:0];

// Branch delay slot state
isa_state delay_slot[0:0];
isa_state branch_target[63:0];

// === Aspects ===
aspect mmu/nullify.isa gates pc:4, psw:4;
aspect mmu/interruption.isa gates pc:2, psw:2, cr17, cr17_back, cr18, cr18_back, cr19, cr20, cr21, cr22, priv_level, shadow_r1, shadow_r8, shadow_r9, shadow_r16, shadow_r17, shadow_r24, shadow_r25, code_iasq:2;
aspect mmu/delay_slot.isa gates pc:3, delay_slot:2, code_iasq:3, branch_target_space;


var instr[31:0];
var t[4:0];
var r[4:0];
var cp[4:0];
var clen[4:0];
var len[5:0];
var src[63:0];
var dst[63:0];
var mask[63:0];
var field_mask[63:0];
var deposited[63:0];
var preserved[63:0];
var res[63:0];
var cond_eq[0:0];
var cond_lt[0:0];
var cond_od[0:0];
var cond_base[0:0];
var cond_met[0:0];

instr = umem[pc_pa];

// DEPW encoding: opcode=0x35, bits[12:10]=011
assume instr[31:26] == 0b110101;
assume instr[12:10] == 0b011;

// Extract fields
t = instr[25:21];
r = instr[20:16];
cp = instr[9:5];
clen = instr[4:0];

// Read source and destination registers
src = (r == 0) ? 64'h0 : rf[r];
dst = (t == 0) ? 64'h0 : rf[t];

// len = 32 - clen
len = 6'b100000 - {1'b0, clen};

// cp encodes the shift amount directly (cp = 31 - pos in PA-RISC bit numbering)
// Mask of 'len' bits
mask = (64'h1 << len) - 64'h1;
field_mask = mask << cp;

// Deposit: place low 'len' bits of src at position, preserve rest from dst
deposited = (src & mask) << cp;
preserved = dst & ~field_mask;
res = {32'h0, (deposited[31:0] | preserved[31:0])};

// 3-bit conditional nullification (c=instr[15:13])
cond_eq = (res == 0);
cond_lt = res[63];
cond_od = res[0];
cond_base = (instr[13] & ~instr[14] & cond_eq) | (~instr[13] & instr[14] & cond_lt) | (instr[13] & instr[14] & cond_od);
cond_met = cond_base ^ instr[15];
psw when (cond_met & ~instr_trap_taken & ~in_nullified) = psw | 64'h0000000000200000;

// Write result to target
rf[t] when (t != 0 & ~instr_trap_taken & ~in_nullified) = res;

// Advance PC
pc = pc + 4;
