// SPDX-License-Identifier: BSD-3-Clause
// =============================================================================
// FSTD (long displacement) - FP Store Double (PA-RISC 2.0, 64-bit)
// Format: FSTD fr,d(b)
// Opcode: 0x1C (011100), bit[1]=1 (FR source), bit[3]=0 (no modify)
// =============================================================================
//
// Stores a full 64-bit FP register to memory.
// Uses 14-bit low-sign-extended displacement (with bit[1] as FR indicator).
// PA-RISC 2.0 shares opcode 0x1C between STD (bit[1]=0) and FSTD (bit[1]=1).
//
// Field encoding:
//   instr[31:26] = 011100 (opcode 0x1C)
//   instr[25:21] = b (base register)
//   instr[20:16] = fr (source FP register)
//   instr[13:2]  = displacement high bits
//   instr[1]     = 1 (identifies FSTD vs STD)
//   instr[0]     = sign bit (low-sign format)
//
// Displacement: low_sign_ext({instr[13:2], 0, instr[0]}, 14)
//   (bit[1] position is forced to 0 in displacement computation)
//
// =============================================================================

isa_state pc[63:0];
isa_state psw[63:0];
isa_state rf[63:0][4:0];
isa_state frf[63:0][4:0];
mem umem[25:0];

// Branch delay slot state
isa_state delay_slot[0:0];
isa_state branch_target[63:0];

// === Aspects ===
aspect mmu/nullify.isa gates pc:4, psw:4;
aspect mmu/interruption.isa gates pc:2, psw:2, cr17:2, cr17_back:2, cr18:2, cr18_back:2, cr19:2, cr20:2, cr21:2, cr22:2, priv_level:2, shadow_r1:2, shadow_r8:2, shadow_r9:2, shadow_r16:2, shadow_r17:2, shadow_r24:2, shadow_r25:2, code_iasq:2;
aspect mmu/delay_slot.isa gates pc:3, delay_slot:2, code_iasq:3, branch_target_space;
aspect mmu/data_trap_store.isa gates pc:1, psw:1, cr17:1, cr17_back:1, cr18:1, cr18_back:1, cr19:1, cr20:1, cr21:1, cr22:1, priv_level:1, shadow_r1:1, shadow_r8:1, shadow_r9:1, shadow_r16:1, shadow_r17:1, shadow_r24:1, shadow_r25:1, delay_slot:1, code_iasq:1;

var instr[31:0];
instr = umem[pc_pa];

assume instr[31:26] == 0b011100;
assume instr[3] == 1'b0;  // no modify (plain FSTD)
assume instr[1] == 1'b1;  // bit[1]=1 identifies FSTD (vs STD bit[1]=0)

// =========================================================================
// Decode instruction fields
// =========================================================================
var b[4:0];
var fr[4:0];
b = instr[25:21];
fr = instr[20:16];

// =========================================================================
// 14-bit low-sign displacement extraction
// bit[1] is the FR indicator, not part of displacement
// Reconstruct displacement as if bit[1]=0: {bits[13:2], 0, bit[0]}
// =========================================================================
var disp_sign[0:0];
var disp_mag[12:0];
var sign_ext_disp[63:0];
disp_sign = instr[0];
disp_mag = {instr[13:2], 1'b0};
sign_ext_disp = {{51{disp_sign}}, disp_mag};

// =========================================================================
// Address computation
// =========================================================================
var base[63:0];
base = (b == 0) ? 64'h0 : rf[b];

var addr[63:0];
addr = base + sign_ext_disp;

// =========================================================================
// Read FP source register (full 64-bit)
// =========================================================================
var data[63:0];
data = frf[fr];

// =========================================================================
// Memory store (64-bit doubleword)
// =========================================================================
umem[da_pa] when (~instr_trap_taken & ~data_trap_taken & ~in_nullified) = data;

// =========================================================================
// PC update
// =========================================================================
pc = pc + 4;
