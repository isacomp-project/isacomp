// SPDX-License-Identifier: BSD-3-Clause
// HPPA PA-RISC 2.0 SPOP3 instruction (64-bit)
// SPOP3 - Special Function Unit Operation (3 operands)
// Opcode: 0x04 (bits 31:26), sub=0b011 (bits 12:10)
// Special function unit operation with three operands. NOP-like stub.

isa_state pc[63:0];
isa_state psw[63:0];
isa_state rf[63:0][4:0];
mem umem[25:0];

// Branch delay slot state
isa_state delay_slot[0:0];
isa_state branch_target[63:0];

// === Aspects ===
aspect mmu/nullify.isa gates pc:4, psw:4;
aspect mmu/interruption.isa gates pc:2, psw:2, cr17, cr17_back, cr18, cr18_back, cr19, cr20, cr21, cr22, priv_level, shadow_r1, shadow_r8, shadow_r9, shadow_r16, shadow_r17, shadow_r24, shadow_r25, code_iasq:2;
aspect mmu/delay_slot.isa gates pc:3, delay_slot:2, code_iasq:3, branch_target_space;


var instr[31:0];

instr = umem[pc_pa];

// SPOP3 encoding: opcode=0x04, sub=0b011
assume instr[31:26] == 0b000100;
assume instr[12:10] == 0b011;  // SPOP3 variant

// SPOP3: special function unit op - not modeled, just advance PC
pc = pc + 4;
