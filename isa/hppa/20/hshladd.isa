// SPDX-License-Identifier: BSD-3-Clause
// HPPA PA-RISC 2.0 HSHLADD instruction (MAX SIMD)
// HSHLADD r1,sa,r2,t - Halfword Shift Left and Add
// For each of 4 halfwords: t.hw[i] = r2.hw[i] + (r1.hw[i] << sa)
// sa = 1, 2, or 3 encoded in instr[7:6]
// Opcode: 0x0E (bits 31:26), Sub: 0x19 (bits 12:6)

isa_state pc[63:0];
isa_state psw[63:0];
isa_state rf[63:0][4:0];
mem umem[25:0];

// Branch delay slot state
isa_state delay_slot[0:0];
isa_state branch_target[63:0];

// === Aspects ===
aspect mmu/nullify.isa gates pc:4, psw:4;
aspect mmu/interruption.isa gates pc:2, psw:2, cr17, cr17_back, cr18, cr18_back, cr19, cr20, cr21, cr22, priv_level, shadow_r1, shadow_r8, shadow_r9, shadow_r16, shadow_r17, shadow_r24, shadow_r25, code_iasq:2;
aspect mmu/delay_slot.isa gates pc:3, delay_slot:2, code_iasq:3, branch_target_space;


var instr[31:0];
var r1[4:0];
var r2[4:0];
var t[4:0];
var src1[63:0];
var src2[63:0];
var res[63:0];

instr = umem[pc_pa];

// HSHLADD encoding: opcode=0x0E, sub=0x19 (bits 12:8)
assume instr[31:26] == 0b001110;
assume instr[12:8] == 0b11001;

// Extract register fields
r2 = instr[25:21];
r1 = instr[20:16];
t = instr[4:0];

// Shift amount: sa = instr[7:6] + 1 (encodes 1, 2, 3)
// instr[7:6] = 00 -> sa=1, 01 -> sa=2, 10 -> sa=3
var sa_enc[1:0]; sa_enc = instr[7:6];

// Read source registers (r0 always reads as 0)
src1 = (r1 == 0) ? 64'h0 : rf[r1];
src2 = (r2 == 0) ? 64'h0 : rf[r2];

// Extract halfwords from src1
var s1_0[15:0]; s1_0 = src1[15:0];
var s1_1[15:0]; s1_1 = src1[31:16];
var s1_2[15:0]; s1_2 = src1[47:32];
var s1_3[15:0]; s1_3 = src1[63:48];

// Extract halfwords from src2
var s2_0[15:0]; s2_0 = src2[15:0];
var s2_1[15:0]; s2_1 = src2[31:16];
var s2_2[15:0]; s2_2 = src2[47:32];
var s2_3[15:0]; s2_3 = src2[63:48];

// Shift left r1 halfwords by sa, then add to r2 halfwords
// sa_enc=00 -> shift by 1, sa_enc=01 -> shift by 2, sa_enc=10 -> shift by 3
var sh_0[15:0]; sh_0 = (sa_enc == 2'b00) ? (s1_0 << 1) : (sa_enc == 2'b01) ? (s1_0 << 2) : (s1_0 << 3);
var sh_1[15:0]; sh_1 = (sa_enc == 2'b00) ? (s1_1 << 1) : (sa_enc == 2'b01) ? (s1_1 << 2) : (s1_1 << 3);
var sh_2[15:0]; sh_2 = (sa_enc == 2'b00) ? (s1_2 << 1) : (sa_enc == 2'b01) ? (s1_2 << 2) : (s1_2 << 3);
var sh_3[15:0]; sh_3 = (sa_enc == 2'b00) ? (s1_3 << 1) : (sa_enc == 2'b01) ? (s1_3 << 2) : (s1_3 << 3);

var r_0[15:0]; r_0 = s2_0 + sh_0;
var r_1[15:0]; r_1 = s2_1 + sh_1;
var r_2[15:0]; r_2 = s2_2 + sh_2;
var r_3[15:0]; r_3 = s2_3 + sh_3;

// Compose result
res = {r_3, r_2, r_1, r_0};

// Write result to target (r0 writes are discarded)
rf[t] when (t != 0 & ~instr_trap_taken & ~in_nullified) = res;

// Advance PC by 4
pc = pc + 4;
