// SPDX-License-Identifier: BSD-3-Clause
// =============================================================================
// FLDW - FP Load Word (PA-RISC 2.0, 64-bit)
// Format: FLDW d(s,b),ft
// Opcode: 0x09 (001001)
// =============================================================================
//
// Loads a 32-bit word from memory into the lower 32 bits of a FP register.
// Uses displacement addressing with 5-bit short displacement.
//
// Field encoding:
//   instr[31:26] = 001001 (opcode 0x09)
//   instr[25:21] = b (base register)
//   instr[20:16] = d (5-bit displacement)
//   instr[15:14] = space (space register select)
//   instr[13]    = 0 (displacement mode)
//   instr[12]    = 1 (FP load, not coprocessor index)
//   instr[4:0]   = ft (target FP register)
//
// =============================================================================

isa_state pc[63:0];
isa_state psw[63:0];
isa_state rf[63:0][4:0];
isa_state frf[63:0][4:0];
mem umem[25:0];

// Branch delay slot state
isa_state delay_slot[0:0];
isa_state branch_target[63:0];

// === Aspects ===
aspect mmu/nullify.isa gates pc:4, psw:4;
aspect mmu/interruption.isa gates pc:2, psw:2, cr17:2, cr17_back:2, cr18:2, cr18_back:2, cr19:2, cr20:2, cr21:2, cr22:2, priv_level:2, shadow_r1:2, shadow_r8:2, shadow_r9:2, shadow_r16:2, shadow_r17:2, shadow_r24:2, shadow_r25:2, code_iasq:2;
aspect mmu/delay_slot.isa gates pc:3, delay_slot:2, code_iasq:3, branch_target_space;
aspect mmu/data_trap_load.isa gates pc:1, psw:1, cr17:1, cr17_back:1, cr18:1, cr18_back:1, cr19:1, cr20:1, cr21:1, cr22:1, priv_level:1, shadow_r1:1, shadow_r8:1, shadow_r9:1, shadow_r16:1, shadow_r17:1, shadow_r24:1, shadow_r25:1, delay_slot:1, code_iasq:1;

var instr[31:0];
instr = umem[pc_pa];

assume instr[31:26] == 0b001001;
assume instr[9] == 1'b0;
assume instr[6] == 1'b0;

// =========================================================================
// Decode instruction fields
// =========================================================================
var b[4:0];
var ft[4:0];
b = instr[25:21];
ft = instr[4:0];

// =========================================================================
// 5-bit displacement extraction (low_sign_ext)
// =========================================================================
var disp[4:0];
disp = instr[20:16];
var sign_ext_disp[63:0];
sign_ext_disp = {{60{disp[0]}}, disp[4:1]};

// =========================================================================
// Address computation
// =========================================================================
var base[63:0];
base = (b == 0) ? 64'h0 : rf[b];

var addr[63:0];
addr = base + sign_ext_disp;

// =========================================================================
// Memory load (32-bit word)
// =========================================================================
var data[31:0];
data = umem[da_pa];

// =========================================================================
// FP register writeback (lower 32 bits, upper 32 bits zeroed)
// =========================================================================
frf[ft] when (~instr_trap_taken & ~data_trap_taken & ~in_nullified) = {32'h0, data};

// =========================================================================
// PC update
// =========================================================================
pc = pc + 4;
