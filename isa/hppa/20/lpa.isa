// SPDX-License-Identifier: BSD-3-Clause
// HPPA PA-RISC 2.0 LPA instruction (64-bit)
// LPA x(b),t - Load Physical Address
// Opcode: 0x01 (bits 31:26), sub=0x4D (bits 12:5)
// Does DTLB lookup and returns physical address to t.
// x = instr[20:16], b = instr[25:21], t = instr[4:0]
// Privileged instruction.

isa_state pc[63:0];
isa_state psw[63:0];
isa_state rf[63:0][4:0];
mem umem[25:0];

// Branch delay slot state
isa_state delay_slot[0:0];
isa_state branch_target[63:0];

// === Aspects ===
aspect mmu/nullify.isa gates pc:4, psw:4;
aspect mmu/interruption.isa gates pc:2, psw:2, cr17:2, cr17_back:2, cr18:2, cr18_back:2, cr19:2, cr20:2, cr21:2, cr22:2, priv_level:2, shadow_r1:2, shadow_r8:2, shadow_r9:2, shadow_r16:2, shadow_r17:2, shadow_r24:2, shadow_r25:2, code_iasq:2;
aspect mmu/delay_slot.isa gates pc:3, delay_slot:2, code_iasq:3, branch_target_space;
aspect mmu/data_trap_load.isa gates pc:1, psw:1, cr17:1, cr17_back:1, cr18:1, cr18_back:1, cr19:1, cr20:1, cr21:1, cr22:1, priv_level:1, shadow_r1:1, shadow_r8:1, shadow_r9:1, shadow_r16:1, shadow_r17:1, shadow_r24:1, shadow_r25:1, delay_slot:1, code_iasq:1;


var instr[31:0];
var b[4:0];
var x[4:0];
var t[4:0];
var base[63:0];
var index[63:0];
var addr[63:0];

instr = umem[pc_pa];

// LPA encoding: opcode=0x01, sub=0x4D
assume instr[31:26] == 0b000001;
assume instr[12:5] == 0b01001101;

// Extract fields
b = instr[25:21];
x = instr[20:16];
t = instr[4:0];

// Compute virtual address: base + index
base = (b == 0) ? 64'h0 : rf[b];
index = (x == 0) ? 64'h0 : rf[x];
addr = base + index;

// The physical address is returned via the data_trap_load aspect's
// address translation. Write the translated physical address to t.
// da_pa is the physical address produced by the TLB lookup.
rf[t] when (t != 0 & ~instr_trap_taken & ~data_trap_taken & ~in_nullified) = {38'h0, da_pa};

// Advance PC
pc = pc + 4;
