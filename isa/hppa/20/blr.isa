// SPDX-License-Identifier: BSD-3-Clause
// HPPA PA-RISC 2.0 BLR instruction (64-bit)
// BLR x,t - Branch and Link Register: target = pc + 8 + (x << 3), saves pc+8 to t
// Opcode: 0x3A (bits 31:26), bits[15:13]=010
// t=instr[25:21], x=instr[20:16]

isa_state pc[63:0];
isa_state psw[63:0];
isa_state rf[63:0][4:0];
mem umem[25:0];

// Branch delay slot state
isa_state delay_slot[0:0];
isa_state branch_target[63:0];

// === Aspects (order matters: nullify -> interruption -> delay_slot) ===
aspect mmu/nullify.isa gates pc:4, psw:4;
aspect mmu/interruption.isa gates pc:2, psw:2, cr17, cr17_back, cr18, cr18_back, cr19, cr20, cr21, cr22, priv_level, shadow_r1, shadow_r8, shadow_r9, shadow_r16, shadow_r17, shadow_r24, shadow_r25, code_iasq:2;
aspect mmu/delay_slot.isa gates pc:3, delay_slot:2, code_iasq:3, branch_target_space;


var instr[31:0];
var t[4:0];
var x[4:0];
var index[63:0];
var target[63:0];

instr = umem[pc_pa];

// BLR encoding: opcode=0x3A, bits[15:13]=010
assume instr[31:26] == 0b111010;
assume instr[15:13] == 0b010;

// Extract register fields
t = instr[25:21];
x = instr[20:16];

// Read index register (r0 reads as 0)
index = (x == 0) ? 64'h0 : rf[x];

// Compute target: pc + 8 + (x << 3)
target = pc + 8 + (index << 3);

// Save return address (pc+8) to target register t
rf[t] when (t != 0 & ~in_delay_slot & ~instr_trap_taken & ~in_nullified) = pc + 8;

// Nullification: BLR,N sets PSW.N to nullify delay slot
psw when (instr[1] & ~in_delay_slot & ~instr_trap_taken & ~in_nullified) = psw | 64'h0000000000200000;

// Set up delay slot
delay_slot when (~in_delay_slot & ~instr_trap_taken & ~in_nullified) = 1;
branch_target when (~in_delay_slot & ~instr_trap_taken & ~in_nullified) = target;

// Advance PC to delay slot instruction
pc = pc + 4;
