// SPDX-License-Identifier: BSD-3-Clause
// HPPA PA-RISC 2.0 RFIR instruction (64-bit)
// RFIR - Return From Interruption and Restore shadow registers
// Opcode: 0x00 (bits 31:26), function=0x65 (bits 12:5)
//
// Same as RFI but also restores shadow registers to GRs.
// Restores: PSW <- CR22, PC <- CR18, priv <- CR18[1:0]
// Plus: GR1,8,9,16,17,24,25 <- shadow registers

// === ISA State ===
isa_state pc[63:0];
isa_state psw[63:0];
isa_state rf[63:0][4:0];
isa_state priv_level[1:0];

// Branch delay slot state
isa_state delay_slot[0:0];
isa_state branch_target[63:0];

// Interruption shadow registers
isa_state cr18[63:0];       // IIAOQ front
isa_state cr18_back[63:0];  // IIAOQ back
isa_state cr22[63:0];       // IPSW

// Additional CRs needed by interruption aspect
isa_state cr14[63:0];       // IVA
isa_state cr15[63:0];       // EIEM
ext isa_state cr16[63:0];   // ITMR (free-running, driven by testbench)
isa_state cr17[63:0];       // IIASQ
isa_state cr17_back[63:0];
isa_state cr19[63:0];       // IIR
isa_state cr20[63:0];       // ISR
isa_state cr21[63:0];       // IOR
ext isa_state cr23[63:0];   // EIRR
isa_state cr24[63:0];       // TR0
isa_state cr25[63:0];       // TR1
isa_state cr26[63:0];       // TR2
isa_state cr27[63:0];       // TR3
isa_state cr28[63:0];       // TR4
isa_state cr29[63:0];       // TR5
isa_state cr30[63:0];       // TR6
isa_state cr31[63:0];       // TR7

// Shadow registers (64-bit in PA-RISC 2.0)
isa_state shadow_r1[63:0];
isa_state shadow_r8[63:0];
isa_state shadow_r9[63:0];
isa_state shadow_r16[63:0];
isa_state shadow_r17[63:0];
isa_state shadow_r24[63:0];
isa_state shadow_r25[63:0];

ext isa_state timer_irq_pending[0:0];
ext isa_state ext_irq_lines[63:0];
mem umem[25:0];

// === Aspects ===
aspect mmu/nullify.isa gates pc:4, psw:4;
aspect mmu/interruption.isa gates pc:2, psw:2, cr17, cr17_back, cr18, cr18_back, cr19, cr20, cr21, cr22, priv_level, shadow_r1, shadow_r8, shadow_r9, shadow_r16, shadow_r17, shadow_r24, shadow_r25, code_iasq:2;
aspect mmu/delay_slot.isa gates pc:3, delay_slot:2, code_iasq:3, branch_target_space;

// === Instruction decode ===
var instr[31:0];

instr = umem[pc_pa];

// RFIR encoding: bits[12:5] = 0b01100101 = 0x65
assume instr[31:26] == 0b000000;
assume instr[12:5] == 0b01100101;

// === Restore state (gated on no prior trap and not nullified) ===
var rfi_active[0:0];
rfi_active = ~instr_trap_taken & ~in_nullified;

// Restore PSW from IPSW
psw when (rfi_active) = cr22;

// Restore privilege level from IAOQ front low 2 bits
priv_level when (rfi_active) = cr18[1:0];

// Restore PC from IAOQ front with privilege bits cleared
var restored_pc[63:0];
restored_pc = {cr18[63:2], 2'b00};
pc when (rfi_active) = restored_pc;

// === IAOQ queue restoration ===
var rfi_back_pc[63:0];
var rfi_next_sequential[63:0];
var rfi_resuming_delay_slot[0:0];

rfi_back_pc = {cr18_back[63:2], 2'b00};
rfi_next_sequential = restored_pc + 4;
rfi_resuming_delay_slot = (rfi_back_pc != rfi_next_sequential);

delay_slot when (rfi_active & rfi_resuming_delay_slot) = 1;
branch_target when (rfi_active & rfi_resuming_delay_slot) = rfi_back_pc;

// === Restore instruction address space from IIASQ ===
isa_state code_iasq[63:0];
code_iasq when (rfi_active) = cr17;

// === Restore shadow registers ===
// PA-RISC: RFIR restores GR1, GR8, GR9, GR16, GR17, GR24, GR25
// from hardware shadow registers saved on interruption.
rf[1] when (rfi_active) = shadow_r1;
rf[8] when (rfi_active) = shadow_r8;
rf[9] when (rfi_active) = shadow_r9;
rf[16] when (rfi_active) = shadow_r16;
rf[17] when (rfi_active) = shadow_r17;
rf[24] when (rfi_active) = shadow_r24;
rf[25] when (rfi_active) = shadow_r25;
