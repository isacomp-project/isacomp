// SPDX-License-Identifier: BSD-3-Clause
// HPPA PA-RISC 2.0 COMCLR,<<= instruction (64-bit)
// COMCLR,<<= r1,r2,t - Compare and Clear if r1 <= r2 (unsigned)
// Opcode: 0x02 (bits 31:26), Sub-opcode: 0x44 (bits 12:6)
// r2=instr[25:21], r1=instr[20:16], t=instr[4:0]
// If condition true: t = 0. If false: t = r1 - r2, nullify next instruction.

isa_state pc[63:0];
isa_state psw[63:0];
isa_state rf[63:0][4:0];
mem umem[25:0];

// Branch delay slot state
isa_state delay_slot[0:0];
isa_state branch_target[63:0];

// === Aspects (order matters: nullify -> interruption -> delay_slot) ===
aspect mmu/nullify.isa gates pc:4, psw:4;
aspect mmu/interruption.isa gates pc:2, psw:2, cr17, cr17_back, cr18, cr18_back, cr19, cr20, cr21, cr22, priv_level, shadow_r1, shadow_r8, shadow_r9, shadow_r16, shadow_r17, shadow_r24, shadow_r25, code_iasq:2;
aspect mmu/delay_slot.isa gates pc:3, delay_slot:2, code_iasq:3, branch_target_space;


var instr[31:0];
var r1[4:0];
var r2[4:0];
var t[4:0];
var cl_cond_met[0:0];

instr = umem[pc_pa];

// COMCLR encoding: opcode=0x02, sub-opcode=0x44 (bits 12:6)
assume instr[31:26] == 0b000010;
assume instr[11:6] == 0b100010;
assume instr[15:12] == 4'b1010;

// Extract register fields
r2 = instr[25:21];
r1 = instr[20:16];
t = instr[4:0];

// Read full 64-bit registers (r0 reads as 0)
var cl_rf1[63:0];
var cl_rf2[63:0];
cl_rf1 = (r1 == 0) ? 64'h0 : rf[r1];
cl_rf2 = (r2 == 0) ? 64'h0 : rf[r2];

// d-bit (instr[5]): 0=32-bit comparison, 1=64-bit comparison
var cl_d_bit[0:0];
cl_d_bit = psw[27] & instr[5];

// Compute condition: unsigned less than or equal
var cl_cond_wide[0:0];
var cl_cond_narrow[0:0];
cl_cond_wide = (cl_rf1 < cl_rf2) | (cl_rf1 == cl_rf2);
cl_cond_narrow = (cl_rf1[31:0] < cl_rf2[31:0]) | (cl_rf1[31:0] == cl_rf2[31:0]);
cl_cond_met = cl_d_bit ? cl_cond_wide : cl_cond_narrow;

// CMPCLR always clears target to 0 (per PA-RISC 2.0 spec, confirmed by QEMU)
rf[t] when (t != 0 & ~instr_trap_taken & ~in_nullified) = 64'h0;

// Nullify next instruction when condition IS met
psw when (cl_cond_met & ~instr_trap_taken & ~in_nullified) = psw | 64'h0000000000200000;

// Advance PC
pc = pc + 4;
