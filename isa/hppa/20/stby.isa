// SPDX-License-Identifier: BSD-3-Clause
// =============================================================================
// STBY - Store Bytes (PA-RISC 2.0, 64-bit)
// Format: STBY,B/E r,d(s,b)
// Opcode: 0x03 (000011), sub instr[12:9]=1100
// =============================================================================
//
// Stores selected bytes based on the low address bits (boundary alignment).
// STBY,B (begin, instr[13]=0): stores bytes from the start of the word up to
//   the byte address
// STBY,E (end, instr[13]=1): stores bytes from the byte address to end of the
//   word
// Used for unaligned memory access and optimized memcpy/memset.
//
// Field encoding:
//   instr[31:26] = 000011 (opcode 0x03)
//   instr[25:21] = b (base register)
//   instr[20:16] = r (source register)
//   instr[15:14] = space (space register select)
//   instr[13]    = a (0=begin, 1=end)
//   instr[12:9]  = 1100 (STBY sub-opcode)
//   instr[4:0]   = im5 (5-bit displacement)
//
// =============================================================================

isa_state pc[63:0];
isa_state psw[63:0];
isa_state rf[63:0][4:0];
mem umem[25:0];

// Branch delay slot state
isa_state delay_slot[0:0];
isa_state branch_target[63:0];

// === Aspects ===
aspect mmu/nullify.isa gates pc:4, psw:4;
aspect mmu/interruption.isa gates pc:2, psw:2, cr17:2, cr17_back:2, cr18:2, cr18_back:2, cr19:2, cr20:2, cr21:2, cr22:2, priv_level:2, shadow_r1:2, shadow_r8:2, shadow_r9:2, shadow_r16:2, shadow_r17:2, shadow_r24:2, shadow_r25:2, code_iasq:2;
aspect mmu/delay_slot.isa gates pc:3, delay_slot:2, code_iasq:3, branch_target_space;
aspect mmu/data_trap_store.isa gates pc:1, psw:1, cr17:1, cr17_back:1, cr18:1, cr18_back:1, cr19:1, cr20:1, cr21:1, cr22:1, priv_level:1, shadow_r1:1, shadow_r8:1, shadow_r9:1, shadow_r16:1, shadow_r17:1, shadow_r24:1, shadow_r25:1, delay_slot:1, code_iasq:1;

// =========================================================================
// Instruction fetch
// =========================================================================
var instr[31:0];
instr = umem[pc_pa];

// =========================================================================
// Encoding constraints
// =========================================================================
assume instr[31:26] == 0b000011;
assume instr[12:9] == 0b1100;

// =========================================================================
// Decode instruction fields
// =========================================================================
var b[4:0];
var r[4:0];
var im5[4:0];
b = instr[25:21];
r = instr[20:16];
im5 = instr[4:0];

// =========================================================================
// 5-bit sign-extended displacement
// =========================================================================
var sign_ext_im5[63:0];
sign_ext_im5 = {{60{im5[0]}}, im5[4:1]};

// =========================================================================
// Address computation
// =========================================================================
var base[63:0];
base = (b == 0) ? 64'h0 : rf[b];

var addr[63:0];
addr = base + sign_ext_im5;

// =========================================================================
// Source data (lower 32 bits of register for word-level store bytes)
// For STBY,B (begin mode, instr[13]=0): store bytes 0..addr_low
// For STBY,E (end mode, instr[13]=1): store bytes addr_low..3
// Model as a full 32-bit word store (byte enables not modeled)
// =========================================================================
var data[31:0];
data = (r == 0) ? 32'h0 : rf[r][31:0];

// =========================================================================
// Memory store (32-bit word)
// =========================================================================
umem[da_pa] when (~instr_trap_taken & ~data_trap_taken & ~in_nullified) = data;

// =========================================================================
// PC update
// =========================================================================
pc = pc + 4;
