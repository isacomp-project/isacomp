// SPDX-License-Identifier: BSD-3-Clause
// =============================================================================
// LDB,MB - Load Byte with Modify Before (PA-RISC 2.0, 64-bit)
// Format: LDB,MB d(s,b),t
// Opcode: 0x03 (000011), sub-opcode for LDB,MB short
// =============================================================================
//
// Loads an 8-bit byte with base register modification before the load.
// The base register is updated to base + displacement, then the byte is
// loaded from the new address. Zero-extends to 64 bits.
// Uses 5-bit sign-extended immediate displacement.
//
// Operation: base = base + disp; t = zero_ext(mem[base])
//
// Field encoding:
//   instr[31:26] = 000011 (opcode 0x03)
//   instr[25:21] = b (base register)
//   instr[20:16] = t (target register)
//   instr[15:14] = space (space register select)
//   instr[4:0]   = im5 (5-bit immediate)
//
// =============================================================================

isa_state pc[63:0];
isa_state psw[63:0];
isa_state rf[63:0][4:0];
mem umem[25:0];

// Branch delay slot state
isa_state delay_slot[0:0];
isa_state branch_target[63:0];

// === Aspects ===
aspect mmu/nullify.isa gates pc:4, psw:4;
aspect mmu/interruption.isa gates pc:2, psw:2, cr17:2, cr17_back:2, cr18:2, cr18_back:2, cr19:2, cr20:2, cr21:2, cr22:2, priv_level:2, shadow_r1:2, shadow_r8:2, shadow_r9:2, shadow_r16:2, shadow_r17:2, shadow_r24:2, shadow_r25:2, code_iasq:2;
aspect mmu/delay_slot.isa gates pc:3, delay_slot:2, code_iasq:3, branch_target_space;
aspect mmu/data_trap_load.isa gates pc:1, psw:1, cr17:1, cr17_back:1, cr18:1, cr18_back:1, cr19:1, cr20:1, cr21:1, cr22:1, priv_level:1, shadow_r1:1, shadow_r8:1, shadow_r9:1, shadow_r16:1, shadow_r17:1, shadow_r24:1, shadow_r25:1, delay_slot:1, code_iasq:1;

var instr[31:0];
instr = umem[pc_pa];

assume instr[31:26] == 0b000011;
assume instr[12] == 1'b1;
assume instr[9] == 1'b0;
assume instr[7:6] == 2'b00;
assume instr[5] == 1'b1;
assume instr[13] == 1'b1;

// =========================================================================
// Decode instruction fields
// =========================================================================
var b[4:0];
var t[4:0];
var im5[4:0];
b = instr[25:21];
t = instr[4:0];
im5 = instr[20:16];

// =========================================================================
// 5-bit sign-extended displacement
// =========================================================================
var sign_ext_im5[63:0];
sign_ext_im5 = {{60{im5[0]}}, im5[4:1]};

// =========================================================================
// Address computation (modify before: base = base + disp, load from new base)
// =========================================================================
var base[63:0];
base = (b == 0) ? 64'h0 : rf[b];

var addr[63:0];
addr = base + sign_ext_im5;

// =========================================================================
// Memory load (read 32-bit word, then select byte by addr[1:0])
// =========================================================================
var word_data[31:0];
word_data = umem[da_pa];

// Big-endian byte selection: 00->bits[31:24], 01->bits[23:16], 10->bits[15:8], 11->bits[7:0]
var byte_sel[1:0];
byte_sel = addr[1:0];
var byte_val[7:0];
byte_val = (byte_sel == 2'b00) ? word_data[31:24] : (byte_sel == 2'b01) ? word_data[23:16] : (byte_sel == 2'b10) ? word_data[15:8] : word_data[7:0];

// =========================================================================
// Base register modify (write new address back to base)
// =========================================================================
rf[b] when (b != 0 & ~instr_trap_taken & ~data_trap_taken & ~in_nullified) = addr;

// =========================================================================
// Register writeback (loaded data)
// =========================================================================
rf[t] when (t != 0 & t != b & ~instr_trap_taken & ~data_trap_taken & ~in_nullified) = {56'h0, byte_val};

// =========================================================================
// PC update
// =========================================================================
pc = pc + 4;
