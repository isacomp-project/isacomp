// SPDX-License-Identifier: BSD-3-Clause
// HPPA 2.0 DCOR instruction
// DCOR r,t - Decimal Correct
// Adjusts result for BCD arithmetic
// Opcode: 0x02 (bits 31:26), Sub-opcode: 0x5C (bits 11:5)

isa_state pc[63:0];
isa_state psw[63:0];
isa_state rf[63:0][4:0];
mem umem[25:0];

// Branch delay slot state
isa_state delay_slot[0:0];
isa_state branch_target[63:0];

// === Aspects (order matters: nullify -> interruption -> delay_slot) ===
aspect mmu/nullify.isa gates pc:4, psw:4;
aspect mmu/interruption.isa gates pc:2, psw:2, cr17, cr17_back, cr18, cr18_back, cr19, cr20, cr21, cr22, priv_level, shadow_r1, shadow_r8, shadow_r9, shadow_r16, shadow_r17, shadow_r24, shadow_r25, code_iasq:2;
aspect mmu/delay_slot.isa gates pc:3, delay_slot:2, code_iasq:3, branch_target_space;


var instr[31:0];
var r[4:0];
var t[4:0];
var src[63:0];
var nibble0[3:0];
var nibble1[3:0];
var nibble2[3:0];
var nibble3[3:0];
var nibble4[3:0];
var nibble5[3:0];
var nibble6[3:0];
var nibble7[3:0];
var nibble8[3:0];
var nibble9[3:0];
var nibble10[3:0];
var nibble11[3:0];
var nibble12[3:0];
var nibble13[3:0];
var nibble14[3:0];
var nibble15[3:0];
var adj0[3:0];
var adj1[3:0];
var adj2[3:0];
var adj3[3:0];
var adj4[3:0];
var adj5[3:0];
var adj6[3:0];
var adj7[3:0];
var adj8[3:0];
var adj9[3:0];
var adj10[3:0];
var adj11[3:0];
var adj12[3:0];
var adj13[3:0];
var adj14[3:0];
var adj15[3:0];
var res[63:0];

instr = umem[pc_pa];

assume instr[31:26] == 0b000010;
assume instr[11:6] == 0b101110;

r = instr[25:21];
t = instr[4:0];

src = (r == 0) ? 64'h0 : rf[r];

// Extract each BCD nibble (64-bit = 16 nibbles)
nibble0 = src[3:0];
nibble1 = src[7:4];
nibble2 = src[11:8];
nibble3 = src[15:12];
nibble4 = src[19:16];
nibble5 = src[23:20];
nibble6 = src[27:24];
nibble7 = src[31:28];
nibble8 = src[35:32];
nibble9 = src[39:36];
nibble10 = src[43:40];
nibble11 = src[47:44];
nibble12 = src[51:48];
nibble13 = src[55:52];
nibble14 = src[59:56];
nibble15 = src[63:60];

// Adjust each nibble if > 9
adj0 = (nibble0 > 9) ? (nibble0 + 6) : nibble0;
adj1 = (nibble1 > 9) ? (nibble1 + 6) : nibble1;
adj2 = (nibble2 > 9) ? (nibble2 + 6) : nibble2;
adj3 = (nibble3 > 9) ? (nibble3 + 6) : nibble3;
adj4 = (nibble4 > 9) ? (nibble4 + 6) : nibble4;
adj5 = (nibble5 > 9) ? (nibble5 + 6) : nibble5;
adj6 = (nibble6 > 9) ? (nibble6 + 6) : nibble6;
adj7 = (nibble7 > 9) ? (nibble7 + 6) : nibble7;
adj8 = (nibble8 > 9) ? (nibble8 + 6) : nibble8;
adj9 = (nibble9 > 9) ? (nibble9 + 6) : nibble9;
adj10 = (nibble10 > 9) ? (nibble10 + 6) : nibble10;
adj11 = (nibble11 > 9) ? (nibble11 + 6) : nibble11;
adj12 = (nibble12 > 9) ? (nibble12 + 6) : nibble12;
adj13 = (nibble13 > 9) ? (nibble13 + 6) : nibble13;
adj14 = (nibble14 > 9) ? (nibble14 + 6) : nibble14;
adj15 = (nibble15 > 9) ? (nibble15 + 6) : nibble15;

res = {adj15, adj14, adj13, adj12, adj11, adj10, adj9, adj8, adj7, adj6, adj5, adj4, adj3, adj2, adj1, adj0};

rf[t] when (t != 0 & ~instr_trap_taken & ~in_nullified) = res;
pc = pc + 4;
