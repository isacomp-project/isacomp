// SPDX-License-Identifier: BSD-3-Clause
// =============================================================================
// STD,MA (short) - Store Doubleword with Modify After (PA-RISC 2.0, 64-bit)
// Format: STD,MA r,d(s,b)
// Opcode: 0x03 (000011), sub-opcode for STD,MA short
// =============================================================================
//
// Stores a full 64-bit doubleword from a register to memory, then modifies
// the base register after the store. The base register is updated to
// base + displacement.
// Uses 5-bit sign-extended immediate displacement.
//
// Operation: mem[base] = r; base = base + disp
//
// Field encoding:
//   instr[31:26] = 000011 (opcode 0x03)
//   instr[25:21] = b (base register)
//   instr[20:16] = r (source register)
//   instr[15:14] = space (space register select)
//   instr[12]    = 1 (short displacement marker)
//   instr[10]    = 0 (disambiguate from STDX which has ext4=1011)
//   instr[9]     = 1 (store)
//   instr[7:6]   = 11 (doubleword size)
//   instr[5]     = 1 (modify enable)
//   instr[13]    = 0 (modify after)
//   instr[4:0]   = im5 (5-bit immediate)
//
// =============================================================================

isa_state pc[63:0];
isa_state psw[63:0];
isa_state rf[63:0][4:0];
mem umem[25:0];

// Branch delay slot state
isa_state delay_slot[0:0];
isa_state branch_target[63:0];

// === Aspects ===
aspect mmu/nullify.isa gates pc:4, psw:4;
aspect mmu/interruption.isa gates pc:2, psw:2, cr17:2, cr17_back:2, cr18:2, cr18_back:2, cr19:2, cr20:2, cr21:2, cr22:2, priv_level:2, shadow_r1:2, shadow_r8:2, shadow_r9:2, shadow_r16:2, shadow_r17:2, shadow_r24:2, shadow_r25:2, code_iasq:2;
aspect mmu/delay_slot.isa gates pc:3, delay_slot:2, code_iasq:3, branch_target_space;
aspect mmu/data_trap_store.isa gates pc:1, psw:1, cr17:1, cr17_back:1, cr18:1, cr18_back:1, cr19:1, cr20:1, cr21:1, cr22:1, priv_level:1, shadow_r1:1, shadow_r8:1, shadow_r9:1, shadow_r16:1, shadow_r17:1, shadow_r24:1, shadow_r25:1, delay_slot:1, code_iasq:1;

// =========================================================================
// Instruction fetch and decode
// =========================================================================
var instr[31:0];
instr = umem[pc_pa];

assume instr[31:26] == 0b000011;
assume instr[12] == 1'b1;
assume instr[10] == 1'b0;
assume instr[9] == 1'b1;
assume instr[7:6] == 2'b11;
assume instr[5] == 1'b1;
assume instr[13] == 1'b0;

// =========================================================================
// Decode instruction fields
// =========================================================================
var b[4:0];
var r[4:0];
var im5[4:0];
b = instr[25:21];
r = instr[20:16];
im5 = instr[4:0];

// =========================================================================
// 5-bit sign-extended displacement
// =========================================================================
var sign_ext_im5[63:0];
sign_ext_im5 = {{60{im5[0]}}, im5[4:1]};

// =========================================================================
// Address computation (modify after: store to base, then base = base + disp)
// =========================================================================
var base[63:0];
base = (b == 0) ? 64'h0 : rf[b];

var addr[63:0];
addr = base;

var new_base[63:0];
new_base = base + sign_ext_im5;

// =========================================================================
// Source data (full 64-bit doubleword)
// =========================================================================
var data[63:0];
data = (r == 0) ? 64'h0 : rf[r];

// =========================================================================
// Memory store (64-bit doubleword)
// =========================================================================
umem[da_pa] when (~instr_trap_taken & ~data_trap_taken & ~in_nullified) = data;

// =========================================================================
// Base register modify (update base after store)
// =========================================================================
rf[b] when (b != 0 & ~instr_trap_taken & ~data_trap_taken & ~in_nullified) = new_base;

// =========================================================================
// PC update
// =========================================================================
pc = pc + 4;
