// SPDX-License-Identifier: BSD-3-Clause
// HPPA PA-RISC 2.0 FMPYADD,DBL instruction (64-bit)
// FMPYADD,DBL fm1,fm2,tm,fa,ta - Double-precision FP multiply-add (dual result)
// ta = fa + (fm1 * fm2) and tm = fm1 * fm2
// Opcode: 0x06 (bits 31:26)
// PA-RISC 1.1 instruction retained in 2.0 for backwards compatibility.

isa_state pc[63:0];
isa_state psw[63:0];
isa_state rf[63:0][4:0];
isa_state frf[63:0][4:0];
mem umem[25:0];

// Branch delay slot state
isa_state delay_slot[0:0];
isa_state branch_target[63:0];

// === Aspects ===
aspect mmu/nullify.isa gates pc:4, psw:4;
aspect mmu/interruption.isa gates pc:2, psw:2, cr17, cr17_back, cr18, cr18_back, cr19, cr20, cr21, cr22, priv_level, shadow_r1, shadow_r8, shadow_r9, shadow_r16, shadow_r17, shadow_r24, shadow_r25, code_iasq:2;
aspect mmu/delay_slot.isa gates pc:3, delay_slot:2, code_iasq:3, branch_target_space;


var instr[31:0];
var fm1[4:0];
var fm2[4:0];
var tm[4:0];
var fa[4:0];
var ta[4:0];
var f1[63:0];
var f2[63:0];
var f3[63:0];
var mul_result[63:0];
var add_result[63:0];

instr = umem[pc_pa];

assume instr[31:26] == 0b000110;
assume instr[5:4] == 0b01;  // Double precision

fm1 = instr[25:21];
fm2 = instr[20:16];
fa = instr[15:11];
ta = instr[10:6];
tm = instr[4:0];

f1 = frf[fm1];
f2 = frf[fm2];
f3 = frf[fa];

mul_result = fp_mul(f1, f2, 3'b001);
add_result = fp_add(f3, mul_result, 3'b001);

// Dual result: tm gets multiply result, ta gets add result
frf[tm] when (~instr_trap_taken & ~in_nullified) = mul_result;
frf[ta] when (~instr_trap_taken & ~in_nullified) = add_result;
pc = pc + 4;
