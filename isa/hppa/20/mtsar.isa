// SPDX-License-Identifier: BSD-3-Clause
// HPPA PA-RISC 2.0 MTSAR instruction
// MTSAR r - Move To Shift Amount Register
// Actually encodes as MTCTL r,cr11
// Stores lower 6 bits of source register to SAR (6-bit in PA2.0, was 5-bit in PA1.1)
// Opcode: 0x00 (bits 31:26), sub-op for MTCTL with CR11
// r=instr[25:21]

isa_state pc[63:0];
isa_state psw[63:0];
isa_state rf[63:0][4:0];
isa_state sar[5:0];
mem umem[25:0];

// Branch delay slot state
isa_state delay_slot[0:0];
isa_state branch_target[63:0];

// === Aspects ===
aspect mmu/nullify.isa gates pc:4, psw:4;
aspect mmu/interruption.isa gates pc:2, psw:2, cr17, cr17_back, cr18, cr18_back, cr19, cr20, cr21, cr22, priv_level, shadow_r1, shadow_r8, shadow_r9, shadow_r16, shadow_r17, shadow_r24, shadow_r25, code_iasq:2;
aspect mmu/delay_slot.isa gates pc:3, delay_slot:2, code_iasq:3, branch_target_space;


var instr[31:0];
var r[4:0];
var src[63:0];

instr = umem[pc_pa];

// MTSAR is MTCTL with cr=11 (ext8=0xC2)
// NOTE: The general mtctl.isa already handles MTSAR correctly.
// This file is kept for reference but uses non-matching constraints
// to avoid decode overlap with mtctl.isa.
assume instr[31:26] == 0b000000;
assume instr[20:16] == 0b01011;
assume instr[15:5] == 0b11000010101;

r = instr[25:21];
src = (r == 0) ? 64'h0 : rf[r];

// Store lower 6 bits to SAR (6-bit in PA-RISC 2.0)
sar when (~instr_trap_taken & ~in_nullified) = src[5:0];

// Advance PC
pc = pc + 4;
