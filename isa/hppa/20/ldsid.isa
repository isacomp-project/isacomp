// SPDX-License-Identifier: BSD-3-Clause
// HPPA PA-RISC 2.0 LDSID instruction (64-bit)
// LDSID (s,b),t - Load Space Identifier
// Opcode: 0x00 (bits 31:26), sub=0x85 (bits 12:5)
//
// Loads the space identifier associated with the space register selected
// by the s field. Result placed in GR[t].
// Used by kernel for protection domain management and space register queries.

isa_state pc[63:0];
isa_state psw[63:0];
isa_state rf[63:0][4:0];
mem umem[25:0];

// Branch delay slot state
isa_state delay_slot[0:0];
isa_state branch_target[63:0];

// Space registers (64-bit in PA2.0)
isa_state sr0[63:0];
isa_state sr1[63:0];
isa_state sr2[63:0];
isa_state sr3[63:0];

// === Aspects ===
aspect mmu/nullify.isa gates pc:4, psw:4;
aspect mmu/interruption.isa gates pc:2, psw:2, cr17, cr17_back, cr18, cr18_back, cr19, cr20, cr21, cr22, priv_level, shadow_r1, shadow_r8, shadow_r9, shadow_r16, shadow_r17, shadow_r24, shadow_r25, code_iasq:2;
aspect mmu/delay_slot.isa gates pc:3, delay_slot:2, code_iasq:3, branch_target_space;


var instr[31:0];
var b[4:0];
var s[1:0];
var t[4:0];

instr = umem[pc_pa];

// LDSID encoding: opcode=0x00, sub=0x85
assume instr[31:26] == 0b000000;
assume instr[12:5] == 0b10000101;

b = instr[25:21];
s = instr[15:14];
t = instr[4:0];

// Select space register based on s field
var sr_val[63:0];
sr_val = (s == 2'b00) ? sr0 :
         (s == 2'b01) ? sr1 :
         (s == 2'b10) ? sr2 : sr3;

// Write space ID to target register
rf[t] when (t != 0 & ~instr_trap_taken & ~in_nullified) = sr_val;

// Advance PC
pc = pc + 4;
