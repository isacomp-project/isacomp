// SPDX-License-Identifier: BSD-3-Clause
// HPPA PA-RISC 2.0 HAVG instruction (MAX SIMD)
// HAVG r1,r2,t - Halfword Average
// For each of 4 halfwords: t.hw[i] = (r1.hw[i] + r2.hw[i] + 1) >> 1
// Unsigned average with rounding
// Opcode: 0x0E (bits 31:26), Sub: 0x0B (bits 12:6)

isa_state pc[63:0];
isa_state psw[63:0];
isa_state rf[63:0][4:0];
mem umem[25:0];

// Branch delay slot state
isa_state delay_slot[0:0];
isa_state branch_target[63:0];

// === Aspects ===
aspect mmu/nullify.isa gates pc:4, psw:4;
aspect mmu/interruption.isa gates pc:2, psw:2, cr17, cr17_back, cr18, cr18_back, cr19, cr20, cr21, cr22, priv_level, shadow_r1, shadow_r8, shadow_r9, shadow_r16, shadow_r17, shadow_r24, shadow_r25, code_iasq:2;
aspect mmu/delay_slot.isa gates pc:3, delay_slot:2, code_iasq:3, branch_target_space;


var instr[31:0];
var r1[4:0];
var r2[4:0];
var t[4:0];
var src1[63:0];
var src2[63:0];
var res[63:0];

instr = umem[pc_pa];

// HAVG encoding: opcode=0x0E, sub=0x0B (bits 12:6)
assume instr[31:26] == 0b001110;
assume instr[12:6] == 0b0001011;

// Extract register fields
r2 = instr[25:21];
r1 = instr[20:16];
t = instr[4:0];

// Read source registers (r0 always reads as 0)
src1 = (r1 == 0) ? 64'h0 : rf[r1];
src2 = (r2 == 0) ? 64'h0 : rf[r2];

// Extract halfwords from src1
var s1_0[15:0]; s1_0 = src1[15:0];
var s1_1[15:0]; s1_1 = src1[31:16];
var s1_2[15:0]; s1_2 = src1[47:32];
var s1_3[15:0]; s1_3 = src1[63:48];

// Extract halfwords from src2
var s2_0[15:0]; s2_0 = src2[15:0];
var s2_1[15:0]; s2_1 = src2[31:16];
var s2_2[15:0]; s2_2 = src2[47:32];
var s2_3[15:0]; s2_3 = src2[63:48];

// Unsigned average with rounding: (a + b + 1) >> 1
// Zero-extend to 17 bits, add with +1, shift right by 1
var sum_0[16:0]; sum_0 = {1'b0, s1_0} + {1'b0, s2_0} + 17'h1;
var sum_1[16:0]; sum_1 = {1'b0, s1_1} + {1'b0, s2_1} + 17'h1;
var sum_2[16:0]; sum_2 = {1'b0, s1_2} + {1'b0, s2_2} + 17'h1;
var sum_3[16:0]; sum_3 = {1'b0, s1_3} + {1'b0, s2_3} + 17'h1;

var avg_0[15:0]; avg_0 = sum_0[16:1];
var avg_1[15:0]; avg_1 = sum_1[16:1];
var avg_2[15:0]; avg_2 = sum_2[16:1];
var avg_3[15:0]; avg_3 = sum_3[16:1];

// Compose result
res = {avg_3, avg_2, avg_1, avg_0};

// Write result to target (r0 writes are discarded)
rf[t] when (t != 0 & ~instr_trap_taken & ~in_nullified) = res;

// Advance PC by 4
pc = pc + 4;
