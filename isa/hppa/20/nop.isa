// SPDX-License-Identifier: BSD-3-Clause
// HPPA PA-RISC 2.0 NOP instruction (64-bit)
// NOP - No Operation
// Pseudo-instruction: OR r0,r0,r0 (all register fields = 0, no side effects)
// Opcode: 0x02 (bits 31:26), Sub-opcode: 0x12 (bits 11:5 = 0b0001001)

isa_state pc[63:0];
isa_state psw[63:0];
isa_state rf[63:0][4:0];
mem umem[25:0];

// Branch delay slot state
isa_state delay_slot[0:0];
isa_state branch_target[63:0];

// === Aspects (order matters: nullify -> interruption -> delay_slot) ===
aspect mmu/nullify.isa gates pc:4, psw:4;
aspect mmu/interruption.isa gates pc:2, psw:2, cr17, cr17_back, cr18, cr18_back, cr19, cr20, cr21, cr22, priv_level, shadow_r1, shadow_r8, shadow_r9, shadow_r16, shadow_r17, shadow_r24, shadow_r25, code_iasq:2;
aspect mmu/delay_slot.isa gates pc:3, delay_slot:2, code_iasq:3, branch_target_space;


var instr[31:0];

instr = umem[pc_pa];

// NOP encoding: OR r0,r0,r0 - opcode=0x02, sub-opcode=0x12
assume instr[31:26] == 0b000010;
assume instr[25:21] == 0b00000;
assume instr[20:16] == 0b00000;
assume instr[11:6] == 0b001001;
assume instr[4:0] == 0b00000;

// NOP: no register writes, no condition updates, just advance PC

// Advance PC by 4
pc = pc + 4;
