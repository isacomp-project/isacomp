// SPDX-License-Identifier: BSD-3-Clause
// =============================================================================
// STD,X - Store Doubleword Indexed (PA-RISC 2.0, 64-bit)
// Format: STD,X r,x(s,b)
// Opcode: 0x03 (000011), sub-opcode for indexed doubleword stores
// =============================================================================
//
// Stores a full 64-bit doubleword to memory using indexed addressing.
// Address = base + shifted_index.
// When the shift completer (instr[13]) is set, the index register is
// scaled by 8 (doubleword size) via a left shift of 3 bits.
//
// Field encoding:
//   instr[31:26] = 000011 (opcode 0x03)
//   instr[25:21] = b (base register)
//   instr[20:16] = x (index register)
//   instr[15:14] = space (space register select)
//   instr[13]    = sh (shift completer: 1 = scale index by 8)
//   instr[12:9]  = 1011 (sub-opcode for STD)
//   instr[8:6]   = 011 (indexed mode)
//   instr[4:0]   = r (source register)
//
// =============================================================================

isa_state pc[63:0];
isa_state psw[63:0];
isa_state rf[63:0][4:0];
mem umem[25:0];

// Branch delay slot state
isa_state delay_slot[0:0];
isa_state branch_target[63:0];

// === Aspects ===
aspect mmu/nullify.isa gates pc:4, psw:4;
aspect mmu/interruption.isa gates pc:2, psw:2, cr17:2, cr17_back:2, cr18:2, cr18_back:2, cr19:2, cr20:2, cr21:2, cr22:2, priv_level:2, shadow_r1:2, shadow_r8:2, shadow_r9:2, shadow_r16:2, shadow_r17:2, shadow_r24:2, shadow_r25:2, code_iasq:2;
aspect mmu/delay_slot.isa gates pc:3, delay_slot:2, code_iasq:3, branch_target_space;
aspect mmu/data_trap_store.isa gates pc:1, psw:1, cr17:1, cr17_back:1, cr18:1, cr18_back:1, cr19:1, cr20:1, cr21:1, cr22:1, priv_level:1, shadow_r1:1, shadow_r8:1, shadow_r9:1, shadow_r16:1, shadow_r17:1, shadow_r24:1, shadow_r25:1, delay_slot:1, code_iasq:1;

// =========================================================================
// Instruction fetch and decode
// =========================================================================
var instr[31:0];
instr = umem[pc_pa];

assume instr[31:26] == 0b000011;
assume instr[12] == 0b0;
assume instr[9:6] == 0b1011;

// =========================================================================
// Decode instruction fields
// =========================================================================
var b[4:0];
var x[4:0];
var r[4:0];
b = instr[25:21];
x = instr[20:16];
r = instr[4:0];

// =========================================================================
// Address computation (indexed: base + shifted_index)
// =========================================================================
var base[63:0];
base = (b == 0) ? 64'h0 : rf[b];

var index[63:0];
index = (x == 0) ? 64'h0 : rf[x];

// Shift completer: instr[13]=1 means scale index by access size (doubleword=8)
var shifted_index[63:0];
shifted_index = instr[13] ? {index[60:0], 3'b000} : index;

var addr[63:0];
addr = base + shifted_index;

// =========================================================================
// Source data (full 64-bit doubleword)
// =========================================================================
var data[63:0];
data = (r == 0) ? 64'h0 : rf[r];

// =========================================================================
// Memory store (64-bit doubleword)
// =========================================================================
umem[da_pa] when (~instr_trap_taken & ~data_trap_taken & ~in_nullified) = data;

// =========================================================================
// PC update
// =========================================================================
pc = pc + 4;
