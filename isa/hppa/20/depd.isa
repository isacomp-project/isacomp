// SPDX-License-Identifier: BSD-3-Clause
// HPPA PA-RISC 2.0 DEPD instruction (64-bit deposit doubleword, preserve)
// DEPD r,pos,len,t - Deposit Doubleword: deposits 'len' low-order bits of r
// at instruction-encoded position in full 64-bit register, preserves bits outside field.
// NEW in PA-RISC 2.0: operates on full 64-bit register width.
// Opcode: 0x3C (bits 31:26), bit[10]=1 (preserve)
// bit[12]: 0=len(1-32), 1=len(33-64)
// Position complement: cp = {instr[11], instr[9:5]}, shift_amt = cp = 63 - pos
// t=instr[25:21], r=instr[20:16] (same layout as opcode 0x35 legacy deposits)

isa_state pc[63:0];
isa_state psw[63:0];
isa_state rf[63:0][4:0];
mem umem[25:0];

// Branch delay slot state
isa_state delay_slot[0:0];
isa_state branch_target[63:0];

// === Aspects ===
aspect mmu/nullify.isa gates pc:4, psw:4;
aspect mmu/interruption.isa gates pc:2, psw:2, cr17, cr17_back, cr18, cr18_back, cr19, cr20, cr21, cr22, priv_level, shadow_r1, shadow_r8, shadow_r9, shadow_r16, shadow_r17, shadow_r24, shadow_r25, code_iasq:2;
aspect mmu/delay_slot.isa gates pc:3, delay_slot:2, code_iasq:3, branch_target_space;


var instr[31:0];
var t[4:0];
var r[4:0];
var len_base[6:0];
var len[6:0];
var cp[5:0];
var shift_amt[5:0];
var src[63:0];
var dst[63:0];
var mask[63:0];
var field_mask[63:0];
var deposited[63:0];
var preserved[63:0];
var res[63:0];
var cond_eq[0:0];
var cond_lt[0:0];
var cond_od[0:0];
var cond_base[0:0];
var cond_met[0:0];

instr = umem[pc_pa];

// DEPD encoding: opcode=0x3C, bit[10]=1 (preserve)
// bit[11] is pos[5], bit[12] selects length mode
assume instr[31:26] == 0b111100;
assume instr[10] == 0b1;

// Extract fields (opcode 0x3C: t at [25:21], r at [20:16])
t = instr[25:21];
r = instr[20:16];
// Length: bit[12]=0 → len=32-instr[4:0], bit[12]=1 → len=64-instr[4:0]
len_base = instr[12] ? 7'b1000000 : 7'b0100000;
len = len_base - {2'b0, instr[4:0]};

// Position complement from instruction: cp = {bit[11], bits[9:5]}
// cp = 63 - pos, so shift_amt = cp
cp = {instr[11], instr[9:5]};
shift_amt = cp;

// Read source and destination registers
src = (r == 0) ? 64'h0 : rf[r];
dst = (t == 0) ? 64'h0 : rf[t];

// Create field mask: 'len' bits shifted to position
mask = (64'h1 << len) - 64'h1;
field_mask = mask << shift_amt;

// Deposit: place low 'len' bits of src at position, preserve rest from dst
deposited = (src & mask) << shift_amt;
preserved = dst & ~field_mask;
res = deposited | preserved;

// 3-bit conditional nullification (c=instr[15:13])
cond_eq = (res == 0);
cond_lt = res[63];
cond_od = res[0];
cond_base = (instr[13] & ~instr[14] & cond_eq) | (~instr[13] & instr[14] & cond_lt) | (instr[13] & instr[14] & cond_od);
cond_met = cond_base ^ instr[15];
psw when (cond_met & ~instr_trap_taken & ~in_nullified) = psw | 64'h0000000000200000;

// Write result to target
rf[t] when (t != 0 & ~instr_trap_taken & ~in_nullified) = res;

// Advance PC
pc = pc + 4;
