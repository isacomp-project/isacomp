// SPDX-License-Identifier: BSD-3-Clause
// HPPA FDC instruction
// FDC x(s,b) - Flush Data Cache
// Opcode: 0x01 (bits 31:26), ext=0x4A (bits 8:5)

isa_state pc[31:0];
isa_state psw[31:0];
isa_state rf[31:0][4:0];
mem umem[25:0];

// Branch delay slot state
isa_state delay_slot[0:0];
isa_state branch_target[31:0];

// === Aspects (order matters: nullify -> interruption -> delay_slot) ===
aspect mmu/nullify.isa gates pc:3, psw:3;
aspect mmu/interruption.isa gates pc:1, psw:1, cr17, cr17_back, cr18, cr18_back, cr19, cr20, cr21, cr22, priv_level, shadow_r1, shadow_r8, shadow_r9, shadow_r16, shadow_r17, shadow_r24, shadow_r25, code_iasq:1;
aspect mmu/delay_slot.isa gates pc:2, delay_slot, code_iasq:2, branch_target_space;


var instr[31:0];
var b[4:0];
var x[4:0];
var base[31:0];
var index[31:0];
var addr[31:0];

instr = umem[pc_pa];

// FDC encoding: opcode=0x01, bits[11:5]=0b0010100, bit[12]=1 (data cache)
assume instr[31:26] == 0b000001;
assume instr[11:5] == 0b0010100;
assume instr[12] == 1'b1;

b = instr[25:21];
x = instr[20:16];

base = (b == 0) ? 32'h0 : rf[b];
index = (x == 0) ? 32'h0 : rf[x];
addr = base + index;

// In simulation, FDC is a NOP (no cache to flush)
pc = pc + 4;
