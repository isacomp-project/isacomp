// SPDX-License-Identifier: BSD-3-Clause
// HPPA ADDI,TC instruction (Add Immediate, Trap on Condition)
// ADDI,TC im11,r1,t - Add immediate and trap if condition (bits 15:13) is met
// Opcode: 0x2C (bits 31:26)
// Format: r1=source (bits 25:21), t=dest (bits 20:16), imm=11-bit (bits 10:0)
// Condition field (bits 15:13): trap is taken if condition on result is true.
// NOTE: Trap signaling not implemented; instruction performs arithmetic only.

isa_state pc[31:0];
isa_state psw[31:0];
isa_state rf[31:0][4:0];
mem umem[25:0];

// Branch delay slot state
isa_state delay_slot[0:0];
isa_state branch_target[31:0];

// === Aspects (order matters: nullify -> interruption -> delay_slot) ===
aspect mmu/nullify.isa gates pc:3, psw:3;
aspect mmu/interruption.isa gates pc:1, psw:1, cr17, cr17_back, cr18, cr18_back, cr19, cr20, cr21, cr22, priv_level, shadow_r1, shadow_r8, shadow_r9, shadow_r16, shadow_r17, shadow_r24, shadow_r25, code_iasq:1;
aspect mmu/delay_slot.isa gates pc:2, delay_slot, code_iasq:2, branch_target_space;


var instr[31:0];
var r[4:0];
var t[4:0];
var imm[10:0];
var sign_ext_imm[31:0];
var src[31:0];
var res[31:0];
var carry[0:0];
var psw_c[31:0];

instr = umem[pc_pa];

// ADDI,TC encoding: opcode=0x2C (bits 31:26)
assume instr[31:26] == 0b101100;

// Extract register fields
// Format: bits 25:21 = r (source), bits 20:16 = t (target)
// bits 10:0 = 11-bit immediate
r = instr[25:21];
t = instr[20:16];
imm = instr[10:0];

// Low-sign-extend 11-bit immediate: bit[0]=sign, bits[10:1]=value
sign_ext_imm = {{21{imm[0]}}, imm[0], imm[10:1]};

// Read source register (r0 always reads as 0)
src = (r == 0) ? 32'h0 : rf[r];

// Perform addition
res = src + sign_ext_imm;

// Carry out of addition (unsigned overflow)
carry = (src[31] & sign_ext_imm[31]) | ((src[31] ^ sign_ext_imm[31]) & ~res[31]);

// Update PSW.C (bit 15) with carry
psw_c = carry ? (psw | 32'h00008000) : (psw & 32'hFFFF7FFF);
psw when (~instr_trap_taken & ~in_nullified) = psw_c;

// Write result to target (r0 writes are discarded)
// Trap signaling omitted; side effects gated on no prior trap/nullify
rf[t] when (t != 0 & ~instr_trap_taken & ~in_nullified) = res;

// Advance PC by 4
pc = pc + 4;
