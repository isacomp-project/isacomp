// SPDX-License-Identifier: BSD-3-Clause
// HPPA STHX instruction
// STHX[,s] r,x(b) - Store Halfword Indexed: mem[b + x] = r[15:0]
// Opcode: 0x03 (bits 31:26), sub-op for indexed halfword store
// bit[13]=u: when 1, shift index left by 1 (the ,s completer for halfword access)

isa_state pc[31:0];
isa_state psw[31:0];
isa_state rf[31:0][4:0];
mem umem[25:0];

// Branch delay slot state
isa_state delay_slot[0:0];
isa_state branch_target[31:0];

// === Aspects (order matters: nullify -> interruption -> delay_slot) ===
aspect mmu/nullify.isa gates pc:4, psw:4;
aspect mmu/interruption.isa gates pc:2, psw:2, cr17:2, cr17_back:2, cr18:2, cr18_back:2, cr19:2, cr20:2, cr21:2, cr22:2, priv_level:2, shadow_r1:2, shadow_r8:2, shadow_r9:2, shadow_r16:2, shadow_r17:2, shadow_r24:2, shadow_r25:2, code_iasq:2;
aspect mmu/delay_slot.isa gates pc:3, delay_slot:2, code_iasq:3, branch_target_space;
aspect mmu/data_trap_store.isa gates pc:1, psw:1, cr17:1, cr17_back:1, cr18:1, cr18_back:1, cr19:1, cr20:1, cr21:1, cr22:1, priv_level:1, shadow_r1:1, shadow_r8:1, shadow_r9:1, shadow_r16:1, shadow_r17:1, shadow_r24:1, shadow_r25:1, delay_slot:1, code_iasq:1;

var instr[31:0];
var r[4:0];
var b[4:0];
var x[4:0];
var src[31:0];
var base[31:0];
var index[31:0];
var addr[31:0];
var word_addr[31:0];
var half_offset[0:0];
var word_data[31:0];
var new_word[31:0];

instr = umem[pc_pa];

// Indexed store format opcode
assume instr[31:26] == 0b000011;
assume instr[12] == 1'b0;
// Sub-opcode for STHX (bits 9:6 = 1001)
assume instr[9:6] == 0b1001;

b = instr[25:21];
x = instr[20:16];
r = instr[4:0];

src = (r == 0) ? 32'h0 : rf[r];
base = (b == 0) ? 32'h0 : rf[b];
index = (x == 0) ? 32'h0 : rf[x];

// bit[13] = shift completer: shift index left by 1 for halfword access
var shifted_index[31:0];
shifted_index = instr[13] ? {index[30:0], 1'b0} : index;
addr = base + shifted_index;

// Calculate word-aligned address and half offset
word_addr = {addr[31:2], 2'b00};
half_offset = addr[1];

// Read existing word

word_data = umem[da_pa];

// Insert halfword at appropriate position (big-endian)
new_word = half_offset ? {word_data[31:16], src[15:0]} : {src[15:0], word_data[15:0]};

umem[da_pa] when (~instr_trap_taken & ~data_trap_taken & ~in_nullified) = new_word;
pc = pc + 4;
