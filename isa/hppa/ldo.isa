// SPDX-License-Identifier: BSD-3-Clause
// HPPA LDO instruction
// LDO d(b),t - Load Offset: t = b + sign_ext(d)
// This is used for loading immediate values (LDI i,r = LDO i(r0),r)
// Opcode: 0x0d (bits 31:26)

isa_state pc[31:0];
isa_state psw[31:0];
isa_state rf[31:0][4:0];
mem umem[25:0];

// Branch delay slot state
isa_state delay_slot[0:0];
isa_state branch_target[31:0];

// === Aspects (order matters: nullify -> interruption -> delay_slot) ===
aspect mmu/nullify.isa gates pc:3, psw:3;
aspect mmu/interruption.isa gates pc:1, psw:1, cr17, cr17_back, cr18, cr18_back, cr19, cr20, cr21, cr22, priv_level, shadow_r1, shadow_r8, shadow_r9, shadow_r16, shadow_r17, shadow_r24, shadow_r25, code_iasq:1;
aspect mmu/delay_slot.isa gates pc:2, delay_slot, code_iasq:2, branch_target_space;


var instr[31:0];
var b[4:0];
var t[4:0];
var disp_raw[13:0];
var disp_sign[0:0];
var disp_mag[12:0];
var sign_ext_disp[31:0];
var base[31:0];
var res[31:0];

instr = umem[pc_pa];

// LDO encoding: opcode=0x0d (bits 31:26)
assume instr[31:26] == 0b001101;

// Extract register fields
b = instr[25:21];
t = instr[20:16];
disp_raw = instr[13:0];

// HPPA uses "low-sign-extended" format:
// - bit 0 is the sign bit (1=negative)
// - bits 13:1 are the 13-bit value field
// The assembler encodes negative values by rotating the sign bit to position 0
// So for -5: sign=1, bits 13:1 = 0x1FFB (8187), and when we sign-extend with
// 19 ones we get: 0xFFFF_FFFB = -5
disp_sign = disp_raw[0];
disp_mag = disp_raw[13:1];

// Sign-extend: concatenate 19 copies of sign bit with the 13-bit magnitude
sign_ext_disp = {{19{disp_sign}}, disp_mag};

// Calculate effective address (but store address, not memory contents)
base = (b == 0) ? 32'h0 : rf[b];
res = base + sign_ext_disp;

// Write result to target (r0 writes are discarded)
rf[t] when (t != 0 & ~instr_trap_taken & ~in_nullified) = res;

// Advance PC by 4
pc = pc + 4;
