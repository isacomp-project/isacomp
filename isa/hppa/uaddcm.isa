// SPDX-License-Identifier: BSD-3-Clause
// HPPA UADDCM instruction
// UADDCM r1,r2,t - Unsigned Add Complement
// Computes r1 + ~r2 (ones complement of r2)
// Opcode: 0x02 (bits 31:26), ext=0x4C (bits 8:4)

isa_state pc[31:0];
isa_state psw[31:0];
isa_state rf[31:0][4:0];
mem umem[25:0];

// Branch delay slot state
isa_state delay_slot[0:0];
isa_state branch_target[31:0];

// === Aspects (order matters: nullify -> interruption -> delay_slot) ===
aspect mmu/nullify.isa gates pc:3, psw:3;
aspect mmu/interruption.isa gates pc:1, psw:1, cr17, cr17_back, cr18, cr18_back, cr19, cr20, cr21, cr22, priv_level, shadow_r1, shadow_r8, shadow_r9, shadow_r16, shadow_r17, shadow_r24, shadow_r25, code_iasq:1;
aspect mmu/delay_slot.isa gates pc:2, delay_slot, code_iasq:2, branch_target_space;


var instr[31:0];
var r1[4:0];
var r2[4:0];
var t[4:0];
var src1[31:0];
var src2[31:0];
var res33[32:0];
var result[31:0];
var carry_out[0:0];
var psw_c[31:0];

instr = umem[pc_pa];

// UADDCM encoding: opcode=0x02, bits[11:5]=0b1001100
assume instr[31:26] == 0b000010;
assume instr[11:5] == 0b1001100;

// PA-RISC opcode 0x02 convention: bits[25:21]=r2, bits[20:16]=r1
r2 = instr[25:21];
r1 = instr[20:16];
t = instr[4:0];

src1 = (r1 == 0) ? 32'h0 : rf[r1];
src2 = (r2 == 0) ? 32'h0 : rf[r2];

// UADDCM: result = r1 + ones_complement(r2), 33-bit to capture carry
res33 = {1'b0, src1} + {1'b0, ~src2};
result = res33[31:0];
carry_out = res33[32];

// Update PSW.C (bit 15) with carry out
psw_c = carry_out ? (psw | 32'h00008000) : (psw & 32'hFFFF7FFF);
psw when (~instr_trap_taken & ~in_nullified) = psw_c;

rf[t] when (t != 0 & ~instr_trap_taken & ~in_nullified) = result;
pc = pc + 4;
