// SPDX-License-Identifier: BSD-3-Clause
// HPPA LPA instruction  
// LPA x(s,b),t - Load Physical Address
// Opcode: 0x01 (bits 31:26), ext=0xD (bits 8:5)

isa_state pc[31:0];
isa_state psw[31:0];
isa_state rf[31:0][4:0];
mem umem[25:0];

// Branch delay slot state
isa_state delay_slot[0:0];
isa_state branch_target[31:0];

// === Aspects (order matters: nullify -> interruption -> delay_slot) ===
aspect mmu/nullify.isa gates pc:3, psw:3;
aspect mmu/interruption.isa gates pc:1, psw:1, cr17, cr17_back, cr18, cr18_back, cr19, cr20, cr21, cr22, priv_level, shadow_r1, shadow_r8, shadow_r9, shadow_r16, shadow_r17, shadow_r24, shadow_r25, code_iasq:1;
aspect mmu/delay_slot.isa gates pc:2, delay_slot, code_iasq:2, branch_target_space;


var instr[31:0];
var b[4:0];
var x[4:0];
var t[4:0];
var base[31:0];
var index[31:0];
var vaddr[31:0];
var paddr[31:0];

instr = umem[pc_pa];

// LPA encoding: opcode=0x01, bits[11:5]=0b0011010
assume instr[31:26] == 0b000001;
assume instr[11:5] == 0b0011010;

b = instr[25:21];
x = instr[20:16];
t = instr[4:0];

base = (b == 0) ? 32'h0 : rf[b];
index = (x == 0) ? 32'h0 : rf[x];
vaddr = base + index;

// In simulation without TLB, physical = virtual
paddr = vaddr;

rf[t] when (t != 0 & ~instr_trap_taken & ~in_nullified) = paddr;
pc = pc + 4;
