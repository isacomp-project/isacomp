// SPDX-License-Identifier: BSD-3-Clause
// =============================================================================
// HPPA Delay Slot Aspect
// =============================================================================
//
// All PA-RISC branches have architectural delay slots: the instruction
// immediately after a branch always executes before the branch takes effect.
//
// Follows the proven J2/J4 delay_slot.isa pattern.
//
// Branch instructions set delay_slot=1 and branch_target=<target>, then
// advance PC to the delay slot instruction (pc = pc + 4). This aspect
// runs on the NEXT instruction (the delay slot), and after that instruction
// executes, redirects PC to the branch target.
//
// Nullification interaction (PA-RISC specific):
//   When PSW.N=1, the delay slot instruction is nullified (no side effects)
//   by the interruption.isa aspect. The branch still completes — PC goes
//   to branch_target regardless of nullification. This implements the ,N
//   suffix on branch instructions.
//
// Exception interaction:
//   If an exception occurs during the delay slot instruction (e.g., ITLB
//   miss), the exception takes priority. PC goes to the trap vector, and
//   the branch is effectively lost. The OS must re-execute from the
//   branch instruction after handling the exception.
//
// USAGE: Every instruction includes this aspect:
//   aspect mmu/delay_slot.isa gates pc, delay_slot;
//
// =============================================================================

isa_state delay_slot[0:0];
isa_state branch_target[31:0];
isa_state branch_target_space[31:0];
isa_state code_iasq[31:0];

var in_delay_slot[0:0];
in_delay_slot = delay_slot;

// Clear delay slot flag after processing
delay_slot when (in_delay_slot == 1) = 0;

// After delay slot instruction executes (or is nullified),
// redirect PC to the branch target.
// Gated on ~instr_trap_taken: if an exception occurred during the
// delay slot, the exception takes priority over the branch.
// NOT gated on ~instr_nullified: branch completes even when delay
// slot is nullified (this is the ,N semantics).
pc when (in_delay_slot == 1 & ~instr_trap_taken) = branch_target;

// Track the instruction address space queue.
// BLE/BE set branch_target_space to the target space register.
// After the delay slot consumes branch_target_space, clear it so that
// subsequent non-BE/BLE branches (BL, B, BLR, BV) don't inherit
// a stale space value from a prior BLE.
code_iasq when (in_delay_slot == 1 & ~instr_trap_taken) = branch_target_space;
branch_target_space when (in_delay_slot == 1) = 32'h0;
