// SPDX-License-Identifier: BSD-3-Clause
// HPPA FLDW instruction - Left half (single-precision, LEFT register)
// FLDW d(b),frT - Floating-point Load Word into LEFT half of FP register pair
// Opcode: 0x09 (001001), bit[9]=0 (load), bit[6]=0 (left/high half)
// FP register in bits[4:0], 5-bit LSE displacement in bits[20:16]
// Encoding verified: fldw -10(sp),fr22 = 0x27c11016 (bit[6]=0, bits[4:0]=22)
//
// PA-RISC FRF convention (in simulator): frf[N][31:0] = frN (left half), frf[N][63:32] = frNR (right half)
// This instruction loads into the LEFT half: frf[t][31:0]

isa_state pc[31:0];
isa_state psw[31:0];
isa_state rf[31:0][4:0];
isa_state frf[63:0][4:0];
mem umem[25:0];

// Branch delay slot state
isa_state delay_slot[0:0];
isa_state branch_target[31:0];

// === Aspects (order matters: nullify -> interruption -> delay_slot) ===
aspect mmu/nullify.isa gates pc:4, psw:4;
aspect mmu/interruption.isa gates pc:2, psw:2, cr17:2, cr17_back:2, cr18:2, cr18_back:2, cr19:2, cr20:2, cr21:2, cr22:2, priv_level:2, shadow_r1:2, shadow_r8:2, shadow_r9:2, shadow_r16:2, shadow_r17:2, shadow_r24:2, shadow_r25:2, code_iasq:2;
aspect mmu/delay_slot.isa gates pc:3, delay_slot:2, code_iasq:3, branch_target_space;
aspect mmu/data_trap_load.isa gates pc:1, psw:1, cr17:1, cr17_back:1, cr18:1, cr18_back:1, cr19:1, cr20:1, cr21:1, cr22:1, priv_level:1, shadow_r1:1, shadow_r8:1, shadow_r9:1, shadow_r16:1, shadow_r17:1, shadow_r24:1, shadow_r25:1, delay_slot:1, code_iasq:1;


var instr[31:0];
var b[4:0];
var t[4:0];
var disp_sign[0:0];
var disp_mag[3:0];
var sign_ext_disp[31:0];
var base[31:0];
var addr[31:0];
var data[31:0];
var old_frf[63:0];

instr = umem[pc_pa];

// FLDW-left encoding: opcode=0x09 (bits 31:26), bit[9]=0 (load), bit[6]=0 (left half)
assume instr[31:26] == 0b001001;
assume instr[9] == 1'b0;
assume instr[6] == 1'b0;

// FP register is in bits[4:0] (NOT bits[20:16])
b = instr[25:21];
t = instr[4:0];

// 5-bit low_sign displacement in bits[20:16]: bit[16]=sign, bits[20:17]=magnitude
disp_sign = instr[16];
disp_mag = instr[20:17];

// Sign-extend: 28 copies of sign + 4-bit magnitude = 32 bits
sign_ext_disp = {{28{disp_sign}}, disp_mag};

// Calculate effective address
base = (b == 0) ? 32'h0 : rf[b];
addr = base + sign_ext_disp;

// Load word from memory

data = umem[da_pa];

// Read existing frf[t] to preserve the right (high) half
old_frf = frf[t];

// Store into LEFT half: frf[t][31:0] = data, preserve frf[t][63:32]
// Convention: frf[N][31:0] = frN (left), frf[N][63:32] = frNR (right)
frf[t] when (~instr_trap_taken & ~data_trap_taken & ~in_nullified) = {old_frf[63:32], data};

// Advance PC by 4
pc = pc + 4;
