// SPDX-License-Identifier: BSD-3-Clause
// HPPA SHRPW instruction
// SHRPW r1,r2,sa,t - Shift Right Pair Word
// Concatenates r1:r2, shifts right by sa, takes low 32 bits
// Opcode: 0x34 (bits 31:26)

isa_state pc[31:0];
isa_state psw[31:0];
isa_state rf[31:0][4:0];
isa_state sar[4:0];
mem umem[25:0];

// Branch delay slot state
isa_state delay_slot[0:0];
isa_state branch_target[31:0];

// === Aspects (order matters: nullify -> interruption -> delay_slot) ===
aspect mmu/nullify.isa gates pc:3, psw:3;
aspect mmu/interruption.isa gates pc:1, psw:1, cr17, cr17_back, cr18, cr18_back, cr19, cr20, cr21, cr22, priv_level, shadow_r1, shadow_r8, shadow_r9, shadow_r16, shadow_r17, shadow_r24, shadow_r25, code_iasq:1;
aspect mmu/delay_slot.isa gates pc:2, delay_slot, code_iasq:2, branch_target_space;


var instr[31:0];
var r1[4:0];
var r2[4:0];
var t[4:0];
var cpos[4:0];
var src1[31:0];
var src2[31:0];
var pair[63:0];
var shift_amt[5:0];
var result[31:0];

instr = umem[pc_pa];

// SHRPW encoding: opcode 0x34, bit[12]=0 (prevents overlap with EXTRU/EXTRS which have bit[12]=1)
// bits[10:9]=00 combined with bit[12]=0 matches SHD (010) and VSHD (000) sub-opcodes
assume instr[31:26] == 0b110100;
assume instr[12] == 1'b0;
assume instr[10:9] == 0b00;

r1 = instr[20:16];
r2 = instr[25:21];
t = instr[4:0];
cpos = instr[15:11];

src1 = (r1 == 0) ? 32'h0 : rf[r1];
src2 = (r2 == 0) ? 32'h0 : rf[r2];

// Concatenate r1:r2
pair = {src1, src2};

// Shift amount from cpos (or SAR if cpos == 0)
shift_amt = (cpos == 0) ? {1'b0, sar} : {1'b0, cpos};

// Shift right and take low 32 bits
result = pair >> shift_amt;

rf[t] when (t != 0 & ~instr_trap_taken & ~in_nullified) = result;
pc = pc + 4;
