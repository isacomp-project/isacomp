// SPDX-License-Identifier: BSD-3-Clause
// HPPA SH3ADDO instruction (Shift 3 and Add with Overflow)
// SH3ADDO r1,r2,t - Shift r1 left by 3 and add r2 with overflow trap: t = (r1 << 3) + r2
// Opcode: 0x02 (bits 31:26), Sub-opcode: 0x70 (bits 11:5) with different encoding

isa_state pc[31:0];
isa_state rf[31:0][4:0];
isa_state psw[31:0];    // Processor Status Word
mem umem[25:0];

// Branch delay slot state
isa_state delay_slot[0:0];
isa_state branch_target[31:0];

// === Aspects (order matters: nullify -> interruption -> delay_slot) ===
aspect mmu/nullify.isa gates pc:3, psw:3;
aspect mmu/interruption.isa gates pc:1, psw:1, cr17, cr17_back, cr18, cr18_back, cr19, cr20, cr21, cr22, priv_level, shadow_r1, shadow_r8, shadow_r9, shadow_r16, shadow_r17, shadow_r24, shadow_r25, code_iasq:1;
aspect mmu/delay_slot.isa gates pc:2, delay_slot, code_iasq:2, branch_target_space;


var instr[31:0];
var r1[4:0];
var r2[4:0];
var t[4:0];
var src1[31:0];
var src2[31:0];
var shifted[31:0];
var res[31:0];
var overflow[0:0];

instr = umem[pc_pa];

// SH3ADDO encoding: opcode=0x02 (bits 31:26), sub-opcode=0x74 (bits 11:5)
assume instr[31:26] == 0b000010;
assume instr[11:5] == 0b1110100;

// Extract register fields
r2 = instr[25:21];
r1 = instr[20:16];
t = instr[4:0];

// Read source registers
src1 = (r1 == 0) ? 32'h0 : rf[r1];
src2 = (r2 == 0) ? 32'h0 : rf[r2];

// Shift and add
shifted = src1 << 3;
res = shifted + src2;

// Detect signed overflow
overflow = ((shifted[31] == src2[31]) && (res[31] != shifted[31]));

// Write result
rf[t] when (t != 0 & ~instr_trap_taken & ~in_nullified) = res;

// Update overflow flag
psw when (~instr_trap_taken & ~in_nullified) = overflow ? (psw | 32'h01000000) : (psw & 32'hFEFFFFFF);

pc = pc + 4;
