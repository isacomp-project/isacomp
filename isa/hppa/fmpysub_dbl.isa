// SPDX-License-Identifier: BSD-3-Clause
// HPPA FMPYSUB,DBL instruction
// FMPYSUB,DBL fm1,fm2,tm,fa,ta - Double-precision fused multiply-subtract
// ta = fa - (fm1 * fm2) and tm = fm1 * fm2
// Opcode: 0x26 (bits 31:26)

isa_state pc[31:0];
isa_state psw[31:0];
isa_state rf[31:0][4:0];
isa_state frf[63:0][4:0];
mem umem[25:0];

// Branch delay slot state
isa_state delay_slot[0:0];
isa_state branch_target[31:0];

// === Aspects (order matters: nullify -> interruption -> delay_slot) ===
aspect mmu/nullify.isa gates pc:3, psw:3;
aspect mmu/interruption.isa gates pc:1, psw:1, cr17, cr17_back, cr18, cr18_back, cr19, cr20, cr21, cr22, priv_level, shadow_r1, shadow_r8, shadow_r9, shadow_r16, shadow_r17, shadow_r24, shadow_r25, code_iasq:1;
aspect mmu/delay_slot.isa gates pc:2, delay_slot, code_iasq:2, branch_target_space;


var instr[31:0];
var fm1[4:0];
var fm2[4:0];
var tm[4:0];
var fa[4:0];
var ta[4:0];
var f1[63:0];
var f2[63:0];
var f3[63:0];
var mul_result[63:0];
var sub_result[63:0];

instr = umem[pc_pa];

assume instr[31:26] == 0b100110;
assume instr[5:4] == 0b01;  // Double precision

fm1 = instr[25:21];
fm2 = instr[20:16];
fa = instr[15:11];
ta = instr[10:6];
tm = instr[4:0];

f1 = {frf[fm1], frf[fm1 | 1]};
f2 = {frf[fm2], frf[fm2 | 1]};
f3 = {frf[fa], frf[fa | 1]};

mul_result = fp_mul(f1, f2, 3'b001);
sub_result = fp_sub(f3, mul_result, 3'b001);

frf[tm] = mul_result[63:32];
frf[tm | 1] = mul_result[31:0];
frf[ta] = sub_result[63:32];
frf[ta | 1] = sub_result[31:0];
pc = pc + 4;
