// SPDX-License-Identifier: BSD-3-Clause
// HPPA DCOR instruction
// DCOR r,t - Decimal Correct
// Adjusts result for BCD arithmetic
// Opcode: 0x02 (bits 31:26)

isa_state pc[31:0];
isa_state psw[31:0];
isa_state rf[31:0][4:0];
mem umem[25:0];

// Branch delay slot state
isa_state delay_slot[0:0];
isa_state branch_target[31:0];

// === Aspects (order matters: nullify -> interruption -> delay_slot) ===
aspect mmu/nullify.isa gates pc:3, psw:3;
aspect mmu/interruption.isa gates pc:1, psw:1, cr17, cr17_back, cr18, cr18_back, cr19, cr20, cr21, cr22, priv_level, shadow_r1, shadow_r8, shadow_r9, shadow_r16, shadow_r17, shadow_r24, shadow_r25, code_iasq:1;
aspect mmu/delay_slot.isa gates pc:2, delay_slot, code_iasq:2, branch_target_space;


var instr[31:0];
var r[4:0];
var t[4:0];
var src[31:0];
var nibble0[3:0];
var nibble1[3:0];
var nibble2[3:0];
var nibble3[3:0];
var nibble4[3:0];
var nibble5[3:0];
var nibble6[3:0];
var nibble7[3:0];
var adj0[3:0];
var adj1[3:0];
var adj2[3:0];
var adj3[3:0];
var adj4[3:0];
var adj5[3:0];
var adj6[3:0];
var adj7[3:0];
var res[31:0];

instr = umem[pc_pa];

assume instr[31:26] == 0b000010;
// DCOR encoding
assume instr[11:6] == 0b101110;

r = instr[25:21];
t = instr[4:0];

src = (r == 0) ? 32'h0 : rf[r];

// Extract each BCD nibble
nibble0 = src[3:0];
nibble1 = src[7:4];
nibble2 = src[11:8];
nibble3 = src[15:12];
nibble4 = src[19:16];
nibble5 = src[23:20];
nibble6 = src[27:24];
nibble7 = src[31:28];

// Adjust each nibble if > 9
adj0 = (nibble0 > 9) ? (nibble0 + 6) : nibble0;
adj1 = (nibble1 > 9) ? (nibble1 + 6) : nibble1;
adj2 = (nibble2 > 9) ? (nibble2 + 6) : nibble2;
adj3 = (nibble3 > 9) ? (nibble3 + 6) : nibble3;
adj4 = (nibble4 > 9) ? (nibble4 + 6) : nibble4;
adj5 = (nibble5 > 9) ? (nibble5 + 6) : nibble5;
adj6 = (nibble6 > 9) ? (nibble6 + 6) : nibble6;
adj7 = (nibble7 > 9) ? (nibble7 + 6) : nibble7;

res = {adj7, adj6, adj5, adj4, adj3, adj2, adj1, adj0};

rf[t] when (t != 0 & ~instr_trap_taken & ~in_nullified) = res;
pc = pc + 4;
