// SPDX-License-Identifier: BSD-3-Clause
// HPPA COMCLR,< instruction (Compare and Clear if Less Than, signed)
// COMCLR,< r1,r2,t - if (r1 < r2, signed): t=0; else: skip next instruction
// Opcode: 0x02, sub-opcode bits[11:5]=0b1000100, condition bits[15:12]=0b0100

isa_state pc[31:0];
isa_state psw[31:0];
isa_state rf[31:0][4:0];
mem umem[25:0];

isa_state delay_slot[0:0];
isa_state branch_target[31:0];

aspect mmu/nullify.isa gates pc:3, psw:3;
aspect mmu/interruption.isa gates pc:1, psw:1, cr17, cr17_back, cr18, cr18_back, cr19, cr20, cr21, cr22, priv_level, shadow_r1, shadow_r8, shadow_r9, shadow_r16, shadow_r17, shadow_r24, shadow_r25, code_iasq:1;
aspect mmu/delay_slot.isa gates pc:2, delay_slot, code_iasq:2, branch_target_space;

var instr[31:0];
var r1[4:0];
var r2[4:0];
var t[4:0];
var src1[31:0];
var src2[31:0];
var cond_met[0:0];
var sign1[0:0];
var sign2[0:0];

instr = umem[pc_pa];

assume instr[31:26] == 0b000010;
assume instr[11:5] == 0b1000100;
assume instr[15:12] == 4'b0100;

r2 = instr[25:21];
r1 = instr[20:16];
t = instr[4:0];

src1 = (r1 == 0) ? 32'h0 : rf[r1];
src2 = (r2 == 0) ? 32'h0 : rf[r2];

// Signed less than: src1 < src2
sign1 = src1[31];
sign2 = src2[31];
cond_met = (sign1 & ~sign2) | ((sign1 == sign2) & (src1 < src2));

rf[t] when (t != 0 & ~instr_trap_taken & ~in_nullified) = 32'h0;
psw when (cond_met & ~instr_trap_taken & ~in_nullified) = psw | 32'h00200000;

pc = pc + 4;
