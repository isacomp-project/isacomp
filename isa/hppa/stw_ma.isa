// SPDX-License-Identifier: BSD-3-Clause
// HPPA STWM instruction - Store Word with Modification (long form, 14-bit displacement)
// STW,MA r,d(b) - Store Word Modify After:
//   mem[b] = r;  b += low_sign14(d)
// Opcode: 0x1B (bits 31:26)
// The long-form STWM always uses modify-after (MA) semantics.

isa_state pc[31:0];
isa_state psw[31:0];
isa_state rf[31:0][4:0];
mem umem[25:0];

// Branch delay slot state
isa_state delay_slot[0:0];
isa_state branch_target[31:0];

// === Aspects (order matters: nullify -> interruption -> delay_slot) ===
aspect mmu/nullify.isa gates pc:4, psw:4;
aspect mmu/interruption.isa gates pc:2, psw:2, cr17:2, cr17_back:2, cr18:2, cr18_back:2, cr19:2, cr20:2, cr21:2, cr22:2, priv_level:2, shadow_r1:2, shadow_r8:2, shadow_r9:2, shadow_r16:2, shadow_r17:2, shadow_r24:2, shadow_r25:2, code_iasq:2;
aspect mmu/delay_slot.isa gates pc:3, delay_slot:2, code_iasq:3, branch_target_space;
aspect mmu/data_trap_store.isa gates pc:1, psw:1, cr17:1, cr17_back:1, cr18:1, cr18_back:1, cr19:1, cr20:1, cr21:1, cr22:1, priv_level:1, shadow_r1:1, shadow_r8:1, shadow_r9:1, shadow_r16:1, shadow_r17:1, shadow_r24:1, shadow_r25:1, delay_slot:1, code_iasq:1;

var instr[31:0];
var b[4:0];
var r[4:0];
var disp_sign[0:0];
var disp_mag[12:0];
var sign_ext_disp[31:0];
var base[31:0];
var addr[31:0];
var data[31:0];

instr = umem[pc_pa];

// STWM encoding: opcode=0x1B (bits 31:26), 14-bit low_sign displacement
assume instr[31:26] == 0b011011;

// Extract register fields
// Format: STWM r,d(b) where b is base, r is source data
b = instr[25:21];
r = instr[20:16];

// 14-bit low_sign displacement: bit[0]=sign, bits[13:1]=magnitude
disp_sign = instr[0];
disp_mag = instr[13:1];

// Sign-extend: 19 copies of sign + 13-bit magnitude = 32 bits
sign_ext_disp = {{19{disp_sign}}, disp_mag};

// Get base register value (r0 always 0 but base update still happens for r0 in theory)
base = (b == 0) ? 32'h0 : rf[b];
addr = base;

// Get data from source register
data = (r == 0) ? 32'h0 : rf[r];

// Store word to memory at current base (MA: store at base, then update)

umem[da_pa] when (~instr_trap_taken & ~data_trap_taken & ~in_nullified) = data;

// Update base register with new value (modify after)
rf[b] when (~instr_trap_taken & ~data_trap_taken & ~in_nullified & (b != 0)) = base + sign_ext_disp;

// Advance PC by 4
pc = pc + 4;
