// SPDX-License-Identifier: BSD-3-Clause
// HPPA ZDEPWI instruction (depwi,z - fixed position, immediate source, zero-fill)
// DEPWI,Z imm5,pos,len,t - Deposit immediate with zero-fill at fixed position
// opcode 0x35 (bits 31:26), bits[12:10]=110 (bit12=imm, bit11=fixed, bit10=Z)
// t=bits[25:21], imm5=bits[20:16], cp=bits[9:5], clen=bits[4:0]
// cp = 31 - p_hppa = normal bit position of LSB of deposited field
// clen = 32 - len

isa_state pc[31:0];
isa_state psw[31:0];
isa_state rf[31:0][4:0];
mem umem[25:0];

// Branch delay slot state
isa_state delay_slot[0:0];
isa_state branch_target[31:0];

// === Aspects (order matters: nullify -> interruption -> delay_slot) ===
aspect mmu/nullify.isa gates pc:3, psw:3;
aspect mmu/interruption.isa gates pc:1, psw:1, cr17, cr17_back, cr18, cr18_back, cr19, cr20, cr21, cr22, priv_level, shadow_r1, shadow_r8, shadow_r9, shadow_r16, shadow_r17, shadow_r24, shadow_r25, code_iasq:1;
aspect mmu/delay_slot.isa gates pc:2, delay_slot, code_iasq:2, branch_target_space;


var instr[31:0];
var t[4:0];
var imm[4:0];
var cp[4:0];
var clen[4:0];
var len[5:0];
var sign_ext_imm[31:0];
var mask[31:0];
var result[31:0];
var cond_eq[0:0];
var cond_lt[0:0];
var cond_od[0:0];
var cond_base[0:0];
var cond_met[0:0];

instr = umem[pc_pa];

// ZDEPWI encoding: fixed position (bit11=1), immediate (bit12=1), Z-fill (bit10=0)
assume instr[31:26] == 0b110101;
assume instr[12:10] == 0b110;

// Extract fields: t=dest at [25:21], imm5 at [20:16]
t = instr[25:21];
imm = instr[20:16];
cp = instr[9:5];
clen = instr[4:0];

// Low-sign-extend 5-bit immediate: PA-RISC puts sign bit in im5[0], value in im5[4:1]
sign_ext_imm = imm[0] ? {28'hFFFFFFF, imm[4:1]} : {28'h0, imm[4:1]};

// Compute mask: len bits starting from bit 0
// cp = 31 - hppa_pos = Verilog shift amount (left-shift by cp)
len = 32 - clen;
mask = (len == 0) ? 32'hFFFFFFFF : ((32'h1 << len) - 32'h1);

// Z-fill: destination is zeroed, then immediate field is deposited
result = (sign_ext_imm & mask) << cp;

// Conditional nullification (3-bit condition in bits[15:13])
cond_eq = (result == 0);
cond_lt = result[31];
cond_od = result[0];
cond_base = (instr[13] & ~instr[14] & cond_eq) | (~instr[13] & instr[14] & cond_lt) | (instr[13] & instr[14] & cond_od);
cond_met = cond_base ^ instr[15];
psw when (cond_met & ~instr_trap_taken & ~in_nullified) = psw | 32'h00200000;

rf[t] when (t != 0 & ~instr_trap_taken & ~in_nullified) = result;
pc = pc + 4;
