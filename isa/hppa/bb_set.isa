// SPDX-License-Identifier: BSD-3-Clause
// HPPA BB instruction (Branch on Bit - bit set)
// BB,< r,p,target - Branch if bit at position p is set (1)
// Opcode: 0x31 (bits 31:26)
// c=0 (bit 15): condition "<" = branch if bit SET

isa_state pc[31:0];
isa_state psw[31:0];
isa_state rf[31:0][4:0];
mem umem[25:0];

// Branch delay slot state
isa_state delay_slot[0:0];
isa_state branch_target[31:0];

// === Aspects (order matters: nullify -> interruption -> delay_slot) ===
aspect mmu/nullify.isa gates pc:3, psw:3;
aspect mmu/interruption.isa gates pc:1, psw:1, cr17, cr17_back, cr18, cr18_back, cr19, cr20, cr21, cr22, priv_level, shadow_r1, shadow_r8, shadow_r9, shadow_r16, shadow_r17, shadow_r24, shadow_r25, code_iasq:1;
aspect mmu/delay_slot.isa gates pc:2, delay_slot, code_iasq:2, branch_target_space;


var instr[31:0];
var r[4:0];
var p[4:0];
var src[31:0];
var bit_val[0:0];
var shift_amt[4:0];
var shifted[31:0];
var w[11:0];
var target_offset[31:0];
var target[31:0];
var taken[0:0];

instr = umem[pc_pa];

// BB encoding: opcode=0x31 (bits 31:26)
assume instr[31:26] == 0b110001;

// Condition bit (bit 15) = 0 for branch if bit set ("<")
assume instr[15] == 1'b0;

// Extract bit position (bits[25:21]) and register (bits[20:16])
p = instr[25:21];
r = instr[20:16];

// Read source register
src = (r == 0) ? 32'h0 : rf[r];

// Extract bit at position p (HPPA numbers bits 0=MSB, 31=LSB)
// Use shift to extract the bit dynamically
shift_amt = 5'd31 - p;
shifted = src >> shift_amt;
bit_val = shifted[0];

// HPPA branch displacement encoding:
// w[10] (sign) = instr[0]
// w[9:1] = instr[12:4]
// w[0] = instr[3]
w = {instr[0], instr[2], instr[12:4], instr[3]};

// Sign-extend the 12-bit w to 32 bits and multiply by 4 (shift left 2)
target_offset = {{18{w[11]}}, w, 2'b00};

// Calculate target (relative to PC+8 due to delay slot)
target = pc + 8 + target_offset;

// Check condition (bit is set)
taken = (bit_val == 1'b1);

// ,n flag: forward (instr[0]=0) nullifies when taken; backward (instr[0]=1) nullifies when not taken
var n_nullify[0:0];
n_nullify = instr[1] & (taken ^ instr[0]);
psw when (n_nullify & ~instr_trap_taken & ~in_nullified) = psw | 32'h00200000;

delay_slot when (~in_delay_slot & taken & ~instr_trap_taken & ~in_nullified) = 1;
branch_target when (~in_delay_slot & taken & ~instr_trap_taken & ~in_nullified) = target;
pc = pc + 4;
