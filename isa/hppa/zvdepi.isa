// SPDX-License-Identifier: BSD-3-Clause
// HPPA ZVDEPI instruction (DEPWI,Z with SAR position, immediate source, Z-fill)
// DEPWI,Z im5,sar,len,t - Deposit immediate into target, zero-fill outside field
// Opcode: 0x35 (bits 31:26), bits[12:10]=100 (immediate, SAR, Z-fill)
// t=bits[25:21], im5=bits[20:16] (low_sign_ext), clen=bits[4:0]

isa_state pc[31:0];
isa_state psw[31:0];
isa_state rf[31:0][4:0];
isa_state sar[4:0];  // Shift Amount Register (CR11)
mem umem[25:0];

// Branch delay slot state
isa_state delay_slot[0:0];
isa_state branch_target[31:0];

// === Aspects (order matters: nullify -> interruption -> delay_slot) ===
aspect mmu/nullify.isa gates pc:3, psw:3;
aspect mmu/interruption.isa gates pc:1, psw:1, cr17, cr17_back, cr18, cr18_back, cr19, cr20, cr21, cr22, priv_level, shadow_r1, shadow_r8, shadow_r9, shadow_r16, shadow_r17, shadow_r24, shadow_r25, code_iasq:1;
aspect mmu/delay_slot.isa gates pc:2, delay_slot, code_iasq:2, branch_target_space;


var instr[31:0];
var t[4:0];
var im5[4:0];
var clen[4:0];
var sign_ext_imm[31:0];
var len[5:0];
var pos[5:0];
var mask[31:0];
var result[31:0];
var cond_eq[0:0];
var cond_lt[0:0];
var cond_od[0:0];
var cond_base[0:0];
var cond_met[0:0];

instr = umem[pc_pa];

// ZVDEPI encoding: SAR-based position, immediate source, Z-fill
assume instr[31:26] == 0b110101;
assume instr[12:10] == 0b100;

// Extract fields (PA-RISC 1.1 format: t at [25:21], im5 at [20:16])
t = instr[25:21];
im5 = instr[20:16];
clen = instr[4:0];

// Low-sign-extend 5-bit immediate: sign bit is im5[0], value is im5[4:1]
sign_ext_imm = im5[0] ? {28'hFFFFFFF, im5[4:1]} : {28'h0, im5[4:1]};

// Position comes from SAR (PA-RISC bit numbering: 0=MSB, 31=LSB)
// Shift amount = 31 - SAR (converts PA-RISC position to Verilog left-shift)
pos = {1'b0, 31 - sar};
len = 32 - clen;

// Create mask of len bits
mask = (len == 0) ? 32'hFFFFFFFF : ((32'h1 << len) - 1);

// Z-fill: zero-extended deposit
result = (sign_ext_imm & mask) << pos;

// Conditional nullification (3-bit condition in bits[15:13])
cond_eq = (result == 0);
cond_lt = result[31];
cond_od = result[0];
cond_base = (instr[13] & ~instr[14] & cond_eq) | (~instr[13] & instr[14] & cond_lt) | (instr[13] & instr[14] & cond_od);
cond_met = cond_base ^ instr[15];
psw when (cond_met & ~instr_trap_taken & ~in_nullified) = psw | 32'h00200000;

rf[t] when (t != 0 & ~instr_trap_taken & ~in_nullified) = result;
pc = pc + 4;
