// SPDX-License-Identifier: BSD-3-Clause
// HPPA XMPYU instruction
// XMPYU fr1[R],fr2[R],ft - Fixed-point multiply unsigned (uses FP registers)
// Multiplies two 32-bit unsigned integers in FP regs, produces 64-bit result
// Opcode: 0x0E (001110), class=01, sub-op lower 2 bits = 11, xb=01
//
// Encoding verified from actual instructions:
//   xmpyu fr22,fr23R,fr23  = 0x3ad75717: sub=1011, fmt=100 -> sub[3]=1(src2=R), fmt[1]=0(src1=L)
//   xmpyu fr24R,fr23,fr24  = 0x3b174798: sub=0011, fmt=110 -> sub[3]=0(src2=L), fmt[1]=1(src1=R)
//   xmpyu fr22,fr23,fr24   = 0x3ad74718: sub=0011, fmt=100 -> sub[3]=0(src2=L), fmt[1]=0(src1=L)
//
// PA-RISC FRF convention (in simulator): frf[N][31:0] = frN (left half), frf[N][63:32] = frNR (right half)
// Halfword selection:
//   fmt[1] = bit[7]: 0=src1 from LEFT half frf[r1][31:0], 1=src1 from RIGHT half frf[r1][63:32]
//   sub[3] = bit[12]: 0=src2 from LEFT half frf[r2][31:0], 1=src2 from RIGHT half frf[r2][63:32]
//
// Result storage: frf[t] = result directly (no swap)
// frf[t][63:32] = HIGH → FSTD → umem[63:32] → LDW at lower addr (big-endian MSW)
// frf[t][31:0] = LOW → FSTD → umem[31:0] → LDW at higher addr (big-endian LSW)

isa_state pc[31:0];
isa_state psw[31:0];
isa_state rf[31:0][4:0];
isa_state frf[63:0][4:0];
mem umem[25:0];

// Branch delay slot state
isa_state delay_slot[0:0];
isa_state branch_target[31:0];

// === Aspects (order matters: nullify -> interruption -> delay_slot) ===
aspect mmu/nullify.isa gates pc:3, psw:3;
aspect mmu/interruption.isa gates pc:1, psw:1, cr17, cr17_back, cr18, cr18_back, cr19, cr20, cr21, cr22, priv_level, shadow_r1, shadow_r8, shadow_r9, shadow_r16, shadow_r17, shadow_r24, shadow_r25, code_iasq:1;
aspect mmu/delay_slot.isa gates pc:2, delay_slot, code_iasq:2, branch_target_space;


var instr[31:0];
var r1[4:0];
var r2[4:0];
var t[4:0];
var frf_r1[63:0];
var frf_r2[63:0];
var src1[31:0];
var src2[31:0];
var result[63:0];

instr = umem[pc_pa];

// XMPYU general encoding:
// opcode = 0x0E (001110)
// class = 01 (bits[15:14])
// sub lower 2 bits = 11 (bits[10:9]) -- sub[3] at bit[12] is the src2-R selector
// xb = 01 (bits[5:4])
assume instr[31:26] == 0b001110;
assume instr[15:14] == 0b01;
assume instr[10:9] == 0b11;    // lower 2 bits of sub-opcode (bit12 = sub[3] is variable)
assume instr[5:4] == 0b01;     // xb field

r1 = instr[25:21];
r2 = instr[20:16];
t = instr[4:0];

// Read full 64-bit FP register values
frf_r1 = frf[r1];
frf_r2 = frf[r2];

// Select 32-bit operand based on halfword bits:
//   fmt[1] = bit[7]: 0=LEFT (frf[r1][31:0] = frR1), 1=RIGHT (frf[r1][63:32] = frR1R)
//   sub[3] = bit[12]: 0=LEFT (frf[r2][31:0] = frR2), 1=RIGHT (frf[r2][63:32] = frR2R)
src1 = (instr[7]) ? frf_r1[63:32] : frf_r1[31:0];
src2 = (instr[12]) ? frf_r2[63:32] : frf_r2[31:0];

// Unsigned 32x32 -> 64-bit multiply
result = {32'h0, src1} * {32'h0, src2};

// Store result in FP double register (big-endian, no swap needed):
// frf[t][63:32] = result[63:32] = HIGH 32 bits → FSTD → umem[63:32] → LDW at lower addr
// frf[t][31:0] = result[31:0] = LOW 32 bits → FSTD → umem[31:0] → LDW at higher addr
frf[t] when (~instr_trap_taken & ~in_nullified) = result;

pc = pc + 4;
