// SPDX-License-Identifier: BSD-3-Clause
// HPPA BLR instruction (Branch and Link Register)
// BLR x,r2 - Indirect branch: r2 = pc+8, pc = rf[x]
// Opcode: 0x3a (bits 31:26), bits[15:13]=010
// x = index/base register (bits 20:16), r2 = link register (bits 25:21)
// Delay slot: next instruction executes before branch takes effect.
// N bit (bit 1): if set, nullify the delay slot instruction.

isa_state pc[31:0];
isa_state psw[31:0];
isa_state rf[31:0][4:0];
mem umem[25:0];

// Branch delay slot state
isa_state delay_slot[0:0];
isa_state branch_target[31:0];

// === Aspects (order matters: nullify -> interruption -> delay_slot) ===
aspect mmu/nullify.isa gates pc:3, psw:3;
aspect mmu/interruption.isa gates pc:1, psw:1, cr17, cr17_back, cr18, cr18_back, cr19, cr20, cr21, cr22, priv_level, shadow_r1, shadow_r8, shadow_r9, shadow_r16, shadow_r17, shadow_r24, shadow_r25, code_iasq:1;
aspect mmu/delay_slot.isa gates pc:2, delay_slot, code_iasq:2, branch_target_space;


var instr[31:0];
var link[4:0];
var x[4:0];
var n_bit[0:0];
var target[31:0];
var return_addr[31:0];
var xval[31:0];

instr = umem[pc_pa];

// BLR encoding: opcode=0x3a (bits 31:26), bits[15:13]=010
assume instr[31:26] == 0b111010;
assume instr[15:13] == 0b010;

// Extract register fields
link = instr[25:21];    // link register (saved with return address)
x = instr[20:16];      // index register (jump table offset)

n_bit = instr[1];      // N bit: nullify delay slot

// Return address = PC + 8 (after delay slot instruction)
return_addr = pc + 8;

// Branch target = PC + 8 + GR[x]*8  (PA-RISC: relative to instruction after delay slot)
xval = (x == 0) ? 32'h0 : rf[x];
target = pc + 8 + (xval << 3);

// Save return address to link register (r0 writes are discarded)
rf[link] when (link != 0 & ~instr_trap_taken & ~in_nullified) = return_addr;

// BLR,N: set PSW.N=1 to nullify the delay slot instruction
psw when (n_bit == 1 & ~in_delay_slot & ~instr_trap_taken & ~in_nullified) = psw | 32'h00200000;

// Set up delay slot: next instruction executes, then branch takes effect
delay_slot when (~in_delay_slot & ~instr_trap_taken & ~in_nullified) = 1;
branch_target when (~in_delay_slot & ~instr_trap_taken & ~in_nullified) = target;
pc = pc + 4;
