// SPDX-License-Identifier: BSD-3-Clause
// HPPA DIAG BTLB Purge All instruction
// Implementation-specific DIAG sub-operation to purge all Block TLB entries.
// Opcode: 0x05 (bits 31:26), bits[5:0]=6'b000010 (BTLB_PURGE_ALL)
//
// No register operands — clears all 8 BTLB valid bits.
// Used by firmware PDC_BTLB PURGE_ALL handler.

isa_state pc[31:0];
isa_state psw[31:0];
isa_state rf[31:0][4:0];
mem umem[25:0];

// Branch delay slot state
isa_state delay_slot[0:0];
isa_state branch_target[31:0];

// Block TLB state - 8 entries
isa_state btlb_valid[0:0][2:0];

// === Aspects (order matters: nullify -> interruption -> delay_slot) ===
aspect mmu/nullify.isa gates pc:3, psw:3;
aspect mmu/interruption.isa gates pc:1, psw:1, cr17, cr17_back, cr18, cr18_back, cr19, cr20, cr21, cr22, priv_level, shadow_r1, shadow_r8, shadow_r9, shadow_r16, shadow_r17, shadow_r24, shadow_r25, code_iasq:1;
aspect mmu/delay_slot.isa gates pc:2, delay_slot, code_iasq:2, branch_target_space;


var instr[31:0];
instr = umem[pc_pa];

// DIAG BTLB PURGE ALL encoding
assume instr[31:26] == 0b000101;
assume instr[5:0] == 6'b000010;

// Purge all BTLB entries (gated on not trapped/nullified)
var active[0:0];
active = ~instr_trap_taken & ~in_nullified;

btlb_valid[0] when (active) = 1'b0;
btlb_valid[1] when (active) = 1'b0;
btlb_valid[2] when (active) = 1'b0;
btlb_valid[3] when (active) = 1'b0;
btlb_valid[4] when (active) = 1'b0;
btlb_valid[5] when (active) = 1'b0;
btlb_valid[6] when (active) = 1'b0;
btlb_valid[7] when (active) = 1'b0;

pc = pc + 4;
