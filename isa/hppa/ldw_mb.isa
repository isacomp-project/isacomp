// SPDX-License-Identifier: BSD-3-Clause
// HPPA LDWM instruction - Load Word with Modification (long form, 14-bit displacement)
// LDW,MB d(b),t - Load Word Modify Before:
//   b += low_sign14(d);  t = mem[b]
// Opcode: 0x13 (bits 31:26)
// The long-form LDWM always uses modify-before (MB) semantics.

isa_state pc[31:0];
isa_state psw[31:0];
isa_state rf[31:0][4:0];
mem umem[25:0];

// Branch delay slot state
isa_state delay_slot[0:0];
isa_state branch_target[31:0];

// === Aspects (order matters: nullify -> interruption -> delay_slot) ===
aspect mmu/nullify.isa gates pc:4, psw:4;
aspect mmu/interruption.isa gates pc:2, psw:2, cr17:2, cr17_back:2, cr18:2, cr18_back:2, cr19:2, cr20:2, cr21:2, cr22:2, priv_level:2, shadow_r1:2, shadow_r8:2, shadow_r9:2, shadow_r16:2, shadow_r17:2, shadow_r24:2, shadow_r25:2, code_iasq:2;
aspect mmu/delay_slot.isa gates pc:3, delay_slot:2, code_iasq:3, branch_target_space;
aspect mmu/data_trap_load.isa gates pc:1, psw:1, cr17:1, cr17_back:1, cr18:1, cr18_back:1, cr19:1, cr20:1, cr21:1, cr22:1, priv_level:1, shadow_r1:1, shadow_r8:1, shadow_r9:1, shadow_r16:1, shadow_r17:1, shadow_r24:1, shadow_r25:1, delay_slot:1, code_iasq:1;

var instr[31:0];
var b[4:0];
var t[4:0];
var disp_sign[0:0];
var disp_mag[12:0];
var sign_ext_disp[31:0];
var base[31:0];
var new_base[31:0];
var data[31:0];

instr = umem[pc_pa];

// LDWM encoding: opcode=0x13 (bits 31:26), 14-bit low_sign displacement
assume instr[31:26] == 0b010011;

// Extract register fields
// Format: LDWM d(b),t where b is base, t is target
b = instr[25:21];
t = instr[20:16];

// 14-bit low_sign displacement: bit[0]=sign, bits[13:1]=magnitude
disp_sign = instr[0];
disp_mag = instr[13:1];

// Sign-extend: 19 copies of sign + 13-bit magnitude = 32 bits
sign_ext_disp = {{19{disp_sign}}, disp_mag};

// Get original base register value
base = (b == 0) ? 32'h0 : rf[b];

// Compute new base (modify before: update first)
new_base = base + sign_ext_disp;
var addr[31:0];
addr = new_base;

// Load word from memory at new_base (MB: modify base first, then load)

data = umem[da_pa];

// Write loaded data to target register (r0 writes are discarded)
rf[t] when (t != 0 & ~instr_trap_taken & ~data_trap_taken & ~in_nullified) = data;

// Update base register (write back new_base)
rf[b] when (~instr_trap_taken & ~data_trap_taken & ~in_nullified & (b != 0)) = new_base;

// Advance PC by 4
pc = pc + 4;
