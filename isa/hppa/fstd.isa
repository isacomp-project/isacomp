// SPDX-License-Identifier: BSD-3-Clause
// HPPA FSTD instruction
// FSTD r,d(b) - Floating-point Store Double
// Opcode: 0x0b (001011), bit[9]=1 distinguishes FSTD from FLDD (bit[9]=0)
// FP register in bits[4:0], 5-bit LSE displacement in bits[20:16]
// Encoding verified: fstd fr23,-10(sp) = 0x2fc11217 (opcode=0x0b, bit[9]=1, r=bits[4:0]=23)

isa_state pc[31:0];
isa_state psw[31:0];
isa_state rf[31:0][4:0];
isa_state frf[63:0][4:0];
mem umem[25:0];

// Branch delay slot state
isa_state delay_slot[0:0];
isa_state branch_target[31:0];

// === Aspects (order matters: nullify -> interruption -> delay_slot) ===
aspect mmu/nullify.isa gates pc:4, psw:4;
aspect mmu/interruption.isa gates pc:2, psw:2, cr17:2, cr17_back:2, cr18:2, cr18_back:2, cr19:2, cr20:2, cr21:2, cr22:2, priv_level:2, shadow_r1:2, shadow_r8:2, shadow_r9:2, shadow_r16:2, shadow_r17:2, shadow_r24:2, shadow_r25:2, code_iasq:2;
aspect mmu/delay_slot.isa gates pc:3, delay_slot:2, code_iasq:3, branch_target_space;
aspect mmu/data_trap_store.isa gates pc:1, psw:1, cr17:1, cr17_back:1, cr18:1, cr18_back:1, cr19:1, cr20:1, cr21:1, cr22:1, priv_level:1, shadow_r1:1, shadow_r8:1, shadow_r9:1, shadow_r16:1, shadow_r17:1, shadow_r24:1, shadow_r25:1, delay_slot:1, code_iasq:1;


var instr[31:0];
var b[4:0];
var r[4:0];
var disp_sign[0:0];
var disp_mag[3:0];
var sign_ext_disp[31:0];
var base[31:0];
var addr[31:0];
var data[63:0];

instr = umem[pc_pa];

// FSTD encoding: opcode=0x0b (bits 31:26), bit[9]=1 (store, not load)
assume instr[31:26] == 0b001011;
assume instr[9] == 1'b1;

// FP register is in bits[4:0] (NOT bits[20:16])
b = instr[25:21];
r = instr[4:0];

// 5-bit low_sign displacement in bits[20:16]: bit[16]=sign, bits[20:17]=magnitude
disp_sign = instr[16];
disp_mag = instr[20:17];

// Sign-extend: 28 copies of sign + 4-bit magnitude = 32 bits
sign_ext_disp = {{28{disp_sign}}, disp_mag};

// Calculate effective address
base = (b == 0) ? 32'h0 : rf[b];
addr = base + sign_ext_disp;

// Read from FP register (full 64-bit double)
data = frf[r];

// Store doubleword to memory

umem[da_pa] when (~instr_trap_taken & ~data_trap_taken & ~in_nullified) = data;

// Advance PC by 4
pc = pc + 4;
