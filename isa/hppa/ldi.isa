// SPDX-License-Identifier: BSD-3-Clause
// HPPA LDI instruction
// LDI i,t - Load Immediate (pseudo-instruction for LDO i(%r0),t)
// Loads a 14-bit signed immediate into register t
// Opcode: 0x0D (same as LDO)

isa_state pc[31:0];
isa_state psw[31:0];
isa_state rf[31:0][4:0];
mem umem[25:0];

// Branch delay slot state
isa_state delay_slot[0:0];
isa_state branch_target[31:0];

// === Aspects (order matters: nullify -> interruption -> delay_slot) ===
aspect mmu/nullify.isa gates pc:3, psw:3;
aspect mmu/interruption.isa gates pc:1, psw:1, cr17, cr17_back, cr18, cr18_back, cr19, cr20, cr21, cr22, priv_level, shadow_r1, shadow_r8, shadow_r9, shadow_r16, shadow_r17, shadow_r24, shadow_r25, code_iasq:1;
aspect mmu/delay_slot.isa gates pc:2, delay_slot, code_iasq:2, branch_target_space;


var instr[31:0];
var t[4:0];
var disp_raw[13:0];
var disp_sign[0:0];
var disp_mag[12:0];
var imm[31:0];

instr = umem[pc_pa];

assume instr[31:26] == 0b001101;
// LDI is LDO with base = r0
assume instr[25:21] == 0b00000;

t = instr[20:16];
disp_raw = instr[13:0];

// HPPA uses "low-sign-extended" format
disp_sign = disp_raw[0];
disp_mag = disp_raw[13:1];
imm = {{19{disp_sign}}, disp_mag};

rf[t] when (t != 0 & ~instr_trap_taken & ~in_nullified) = imm;
pc = pc + 4;
