// SPDX-License-Identifier: BSD-3-Clause
// HPPA FCMP,SGL instruction
// FCMP,SGL,cond fr1,fr2 - Single-precision floating-point compare
// Sets condition bits in FP status register

isa_state pc[31:0];
isa_state psw[31:0];
isa_state rf[31:0][4:0];
isa_state frf[63:0][4:0];
isa_state fpsr[31:0];     // FP status register
mem umem[25:0];

// Branch delay slot state
isa_state delay_slot[0:0];
isa_state branch_target[31:0];

// === Aspects (order matters: nullify -> interruption -> delay_slot) ===
aspect mmu/nullify.isa gates pc:3, psw:3;
aspect mmu/interruption.isa gates pc:1, psw:1, cr17, cr17_back, cr18, cr18_back, cr19, cr20, cr21, cr22, priv_level, shadow_r1, shadow_r8, shadow_r9, shadow_r16, shadow_r17, shadow_r24, shadow_r25, code_iasq:1;
aspect mmu/delay_slot.isa gates pc:2, delay_slot, code_iasq:2, branch_target_space;


var instr[31:0];
var r1[4:0];
var r2[4:0];
var f1[31:0];
var f2[31:0];
var lt_result[0:0];
var eq_result[0:0];
var gt_result[0:0];

instr = umem[pc_pa];

// FCMP encoding: opcode=0x0C (001100), sub-opcode in bits 12:9 = 0b0000 for FCMP
assume instr[31:26] == 0b001100;
assume instr[12:9] == 0b0000;
assume instr[5:4] == 0b00;     // SGL format

r1 = instr[25:21];
r2 = instr[20:16];

f1 = frf[r1];
f2 = frf[r2];

// FP comparisons
lt_result = fp_lt(f1, f2);
eq_result = fp_eq(f1, f2);
gt_result = ~lt_result & ~eq_result;

// Update FP status register with comparison results
// Bits 5:3 typically hold comparison result in HPPA
fpsr = {fpsr[31:6], gt_result, eq_result, lt_result, fpsr[2:0]};

pc = pc + 4;
