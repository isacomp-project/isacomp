// SPDX-License-Identifier: BSD-3-Clause
// HPPA VSHD instruction
// VSHD r1,r2,t - Variable Shift Double: t = (r1:r2) >> SAR
// Uses the SAR control register for shift amount
// Opcode: 0x34 (bits 31:26)

isa_state pc[31:0];
isa_state psw[31:0];
isa_state rf[31:0][4:0];
isa_state sar[4:0];
mem umem[25:0];

// Branch delay slot state
isa_state delay_slot[0:0];
isa_state branch_target[31:0];

// === Aspects (order matters: nullify -> interruption -> delay_slot) ===
aspect mmu/nullify.isa gates pc:3, psw:3;
aspect mmu/interruption.isa gates pc:1, psw:1, cr17, cr17_back, cr18, cr18_back, cr19, cr20, cr21, cr22, priv_level, shadow_r1, shadow_r8, shadow_r9, shadow_r16, shadow_r17, shadow_r24, shadow_r25, code_iasq:1;
aspect mmu/delay_slot.isa gates pc:2, delay_slot, code_iasq:2, branch_target_space;


var instr[31:0];
var r1[4:0];
var r2[4:0];
var t[4:0];
var src1[31:0];
var src2[31:0];
var concat[63:0];
var shifted[63:0];
var res[31:0];

instr = umem[pc_pa];

assume instr[31:26] == 0b110100;
assume instr[12:10] == 0b000;
assume instr[9:5] == 0b00000;

r2 = instr[25:21];
r1 = instr[20:16];
t = instr[4:0];

src1 = (r1 == 0) ? 32'h0 : rf[r1];
src2 = (r2 == 0) ? 32'h0 : rf[r2];

concat = {src1, src2};
shifted = concat >> sar;
res = shifted[31:0];

rf[t] when (t != 0 & ~instr_trap_taken & ~in_nullified) = res;
pc = pc + 4;
