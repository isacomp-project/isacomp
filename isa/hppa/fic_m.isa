// SPDX-License-Identifier: BSD-3-Clause
// HPPA FIC,M instruction (modify variant)
// FIC,M x(s,b) - Flush Instruction Cache with Modify
// Opcode: 0x01 (bits 31:26), sub-opcode bits[11:6]=001010, bit[12]=0, m=1
// Cache flush is a NOP — no caches in single-cycle implementation
// But the modify MUST still update rf[b] = rf[b] + rf[x]

isa_state pc[31:0];
isa_state psw[31:0];
isa_state rf[31:0][4:0];
mem umem[25:0];

// Branch delay slot state
isa_state delay_slot[0:0];
isa_state branch_target[31:0];

// === Aspects (order matters: nullify -> interruption -> delay_slot) ===
aspect mmu/nullify.isa gates pc:3, psw:3;
aspect mmu/interruption.isa gates pc:1, psw:1, cr17, cr17_back, cr18, cr18_back, cr19, cr20, cr21, cr22, priv_level, shadow_r1, shadow_r8, shadow_r9, shadow_r16, shadow_r17, shadow_r24, shadow_r25, code_iasq:1;
aspect mmu/delay_slot.isa gates pc:2, delay_slot, code_iasq:2, branch_target_space;


var instr[31:0];
var b[4:0];
var x[4:0];
var in_nullified[0:0];
var trap[0:0];

instr = umem[pc_pa];

// FIC,M encoding: opcode=0x01, bits[11:6]=001010, bit[12]=0 (I-cache), bit[5]=1 (modify)
assume instr[31:26] == 0b000001;
assume instr[11:6] == 0b001010;
assume instr[12] == 1'b0;
assume instr[5] == 1'b1;

b = instr[25:21];
x = instr[20:16];

in_nullified = psw[21];
trap = 1'b0;

// Auto-increment base register: rf[b] = rf[b] + rf[x]
rf[b] when (b != 0 & ~trap & ~in_nullified) = rf[b] + rf[x];

pc = pc + 4;
