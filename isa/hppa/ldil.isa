// SPDX-License-Identifier: BSD-3-Clause
// HPPA LDIL instruction
// LDIL im21,t - Load Immediate Left: t = im21 << 11
// Opcode: 0x08 (bits 31:26)
// Used with LDO to construct 32-bit constants

isa_state pc[31:0];
isa_state psw[31:0];
isa_state rf[31:0][4:0];
mem umem[25:0];

// Branch delay slot state
isa_state delay_slot[0:0];
isa_state branch_target[31:0];

// === Aspects (order matters: nullify -> interruption -> delay_slot) ===
aspect mmu/nullify.isa gates pc:3, psw:3;
aspect mmu/interruption.isa gates pc:1, psw:1, cr17, cr17_back, cr18, cr18_back, cr19, cr20, cr21, cr22, priv_level, shadow_r1, shadow_r8, shadow_r9, shadow_r16, shadow_r17, shadow_r24, shadow_r25, code_iasq:1;
aspect mmu/delay_slot.isa gates pc:2, delay_slot, code_iasq:2, branch_target_space;


var instr[31:0];
var t[4:0];
var im21[20:0];
var result[31:0];

instr = umem[pc_pa];

// LDIL encoding: opcode=0x08 (bits 31:26)
assume instr[31:26] == 0b001000;

// Extract target register (bits 25:21)
t = instr[25:21];

// Extract 21-bit immediate (bits 20:0)
// The immediate is assembled in a specific order for HPPA
im21 = instr[20:0];

// Load immediate into upper 21 bits (shifted left by 11)
// PA-RISC uses assemble_21() to encode the immediate in the instruction word.
// We must apply the inverse (extract_21) to decode it back to the actual value.
// assemble_21 mapping: opcode[0]=x[20], opcode[11:1]=x[19:9], opcode[13:12]=x[1:0],
//                      opcode[14]=x[7], opcode[15]=x[8], opcode[20:16]=x[6:2]
// So extract_21: x = {im21[0], im21[11:1], im21[15], im21[14], im21[20:16], im21[13:12]}
result = {im21[0], im21[11:1], im21[15], im21[14], im21[20:16], im21[13:12], 11'b0};

// Write result to target register
rf[t] when (t != 0 & ~instr_trap_taken & ~in_nullified) = result;

// Advance PC
pc = pc + 4;
