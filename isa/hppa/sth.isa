// SPDX-License-Identifier: BSD-3-Clause
// HPPA STH instruction
// STH r,d(b) - Store Halfword: mem[b + sign_ext(d)] = r[15:0]
// Opcode: 0x19 (bits 31:26), short displacement format

isa_state pc[31:0];
isa_state psw[31:0];
isa_state rf[31:0][4:0];
mem umem[25:0];

// Branch delay slot state
isa_state delay_slot[0:0];
isa_state branch_target[31:0];

// === Aspects (order matters: nullify -> interruption -> delay_slot) ===
aspect mmu/nullify.isa gates pc:4, psw:4;
aspect mmu/interruption.isa gates pc:2, psw:2, cr17:2, cr17_back:2, cr18:2, cr18_back:2, cr19:2, cr20:2, cr21:2, cr22:2, priv_level:2, shadow_r1:2, shadow_r8:2, shadow_r9:2, shadow_r16:2, shadow_r17:2, shadow_r24:2, shadow_r25:2, code_iasq:2;
aspect mmu/delay_slot.isa gates pc:3, delay_slot:2, code_iasq:3, branch_target_space;
aspect mmu/data_trap_store.isa gates pc:1, psw:1, cr17:1, cr17_back:1, cr18:1, cr18_back:1, cr19:1, cr20:1, cr21:1, cr22:1, priv_level:1, shadow_r1:1, shadow_r8:1, shadow_r9:1, shadow_r16:1, shadow_r17:1, shadow_r24:1, shadow_r25:1, delay_slot:1, code_iasq:1;

var instr[31:0];
var b[4:0];
var r[4:0];
var disp_sign[0:0];
var disp_mag[12:0];
var sign_ext_disp[31:0];
var base[31:0];
var addr[31:0];
var data[31:0];
var word_data[31:0];
var half_offset[0:0];
var new_word[31:0];

instr = umem[pc_pa];

// STH encoding: opcode=0x19 (bits 31:26), 14-bit low_sign displacement
assume instr[31:26] == 0b011001;

// Extract register fields
b = instr[25:21];
r = instr[20:16];

// 14-bit low_sign displacement: bit[0]=sign, bits[13:1]=magnitude
disp_sign = instr[0];
disp_mag = instr[13:1];

// Sign-extend: 19 copies of sign + 13-bit magnitude = 32 bits
sign_ext_disp = {{19{disp_sign}}, disp_mag};

// Calculate effective address
base = (b == 0) ? 32'h0 : rf[b];
addr = base + sign_ext_disp;

// Get data from source register
data = (r == 0) ? 32'h0 : rf[r];

// Read existing word, modify halfword, write back

word_data = umem[da_pa];
half_offset = addr[1];

// Merge halfword into word (big-endian: offset 0 = upper [31:16])
new_word = half_offset ? {word_data[31:16], data[15:0]} :
                         {data[15:0], word_data[15:0]};

// Store modified word to memory
umem[da_pa] when (~instr_trap_taken & ~data_trap_taken & ~in_nullified) = new_word;

// Advance PC by 4
pc = pc + 4;
