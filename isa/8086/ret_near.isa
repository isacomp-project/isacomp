// SPDX-License-Identifier: BSD-3-Clause
// 8086 RET (0xC3) - WITH PROPER SEGMENTATION
// Return from near procedure
// Pops return address from SS:[SP] and jumps to it

isa_state ip[15:0];
var instr[7:0];
isa_state imem[7:0][15:0];
isa_state dmem[7:0][19:0];     // 1MB memory (20-bit addressing)
isa_state SS[15:0];            // Stack segment register
isa_state xregs[15:0][7:0];    // General purpose registers (xregs[4] is SP)

var return_addr_lo[7:0];
var return_addr_hi[7:0];
var return_addr[15:0];
var stack_offset_lo[15:0];
var stack_offset_hi[15:0];
var physical_addr_lo[19:0];
var physical_addr_hi[19:0];

instr = imem[ip];
assume instr == 0xC3;
ip = ip + 1;

// Calculate stack offsets for return address
stack_offset_lo = xregs[4];
stack_offset_hi = xregs[4] + 16'h0001;  // Wraps at 16-bit boundary

// Calculate physical addresses: SS:offset (20-bit)
physical_addr_lo = {SS, 4'b0} + {4'b0, stack_offset_lo};
physical_addr_hi = {SS, 4'b0} + {4'b0, stack_offset_hi};

// Pop return address from stack (little-endian)
return_addr_lo = dmem[physical_addr_lo];
return_addr_hi = dmem[physical_addr_hi];
return_addr = {return_addr_hi, return_addr_lo};

// Increment SP by 2
xregs[4] = xregs[4] + 16'h0002;

// Jump to return address
ip = return_addr;
