// 8086 CLI (0xFA)
// Clear interrupt flag

isa_state ip[15:0];
var instr[7:0];
isa_state imem[7:0][15:0];
isa_state dmem[7:0][19:0];     // 1MB memory (20-bit addressing)
isa_state DS[15:0];            // Data segment register
isa_state flag_IF[0:0];

instr = imem[ip];
assume instr == 0xFA;
ip = ip + 1;

// Clear interrupt flag (disable interrupts)
flag_IF = 1'b0;
