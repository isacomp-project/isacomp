// SPDX-License-Identifier: BSD-3-Clause
// 8086 SAR AL, 1 (0xD0 with modrm 0xF8)
// Shift arithmetic right by 1 (preserves sign bit)

isa_state ip[15:0];
var instr[7:0];
isa_state modrm[7:0];
isa_state AX[15:0];
isa_state AL[7:0] of AX[7:0];
isa_state imem[7:0][15:0];
isa_state dmem[7:0][19:0];     // 1MB memory (20-bit addressing)
isa_state DS[15:0];            // Data segment register
isa_state flag_CF[0:0];
isa_state flag_SF[0:0];
isa_state flag_ZF[0:0];
isa_state flag_PF[0:0];
isa_state flag_OF[0:0];

var result[8:0];

instr = imem[ip];
assume instr == 0xD0;
ip = ip + 1;

modrm = imem[ip];
assume modrm == 0xF8;
ip = ip + 1;

// Arithmetic shift right: sign bit is preserved
result = {{1{AL[7]}}, AL[7:1]};

// Set flags
flag_CF = AL[0];  // Last bit shifted out
AL = result[7:0];
flag_SF = AL[7];
flag_ZF = AL == 8'h00 ? 1'b1 : 1'b0;
flag_PF = AL[0];
flag_OF = 1'b0;  // Always 0 for single-bit shift
