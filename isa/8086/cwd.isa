// 8086 CWD (0x99)
// Convert word to doubleword - sign-extend AX into DX

isa_state ip[15:0];
var instr[7:0];
isa_state imem[7:0][15:0];
isa_state dmem[7:0][19:0];     // 1MB memory (20-bit addressing)
isa_state DS[15:0];            // Data segment register
isa_state AX[15:0];
isa_state DX[15:0];

instr = imem[ip];
assume instr == 0x99;
ip = ip + 1;

// Sign-extend AX into DX
// If AX[15] is 1, DX becomes 0xFFFF, otherwise 0x0000
DX = AX[15] ? 16'hFFFF : 16'h0000;
