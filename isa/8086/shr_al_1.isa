// SPDX-License-Identifier: BSD-3-Clause
// 8086 SHR AL,1 (0xD0 with modrm 0xE8)
// Shift Logical Right by 1 bit
// Shifts out LSB into CF, shifts in 0 to MSB

isa_state ip[15:0];
var instr[7:0];
isa_state modrm[7:0];
isa_state AX[15:0];
isa_state AL[7:0] of AX[7:0];
isa_state imem[7:0][15:0];
isa_state dmem[7:0][19:0];     // 1MB memory (20-bit addressing)
isa_state DS[15:0];            // Data segment register
isa_state flag_CF[0:0];
isa_state flag_PF[0:0];
isa_state flag_ZF[0:0];
isa_state flag_SF[0:0];
isa_state flag_OF[0:0];

var result[8:0];

instr = imem[ip];
assume instr == 0xD0;
ip = ip + 1;

modrm = imem[ip];
assume modrm == 0xE8;
ip = ip + 1;

// CF gets the bit that will be shifted out (LSB of AL)
flag_CF = AL[0];

// Shift right by 1
result = AL >> 1;

// Update AL
AL = result[7:0];

// Update flags
flag_ZF = AL == 0 ? 1'b1 : 1'b0;
flag_SF = AL[7];  // Always 0 after logical right shift by 1
flag_PF = AL[0];
// OF is set to MSB of original value (for 1-bit shift)
flag_OF = AL[7];
