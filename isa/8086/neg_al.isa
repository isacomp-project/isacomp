// SPDX-License-Identifier: BSD-3-Clause
// 8086 NEG AL (0xF6 with modrm 0xD8)
// Two's complement negation (0 - AL)
// Updates CF, OF, SF, ZF, AF, PF flags

isa_state ip[15:0];
var instr[7:0];
isa_state modrm[7:0];
isa_state AX[15:0];
isa_state AL[7:0] of AX[7:0];
isa_state imem[7:0][15:0];
isa_state dmem[7:0][19:0];     // 1MB memory (20-bit addressing)
isa_state DS[15:0];            // Data segment register
isa_state flag_CF[0:0];
isa_state flag_OF[0:0];
isa_state flag_SF[0:0];
isa_state flag_ZF[0:0];
isa_state flag_AF[0:0];
isa_state flag_PF[0:0];

var result[8:0];
var original_al[7:0];

instr = imem[ip];
assume instr == 0xF6;
ip = ip + 1;

modrm = imem[ip];
assume modrm == 0xD8;
ip = ip + 1;

// Save original value
original_al = AL;

// NEG: result = 0 - AL
result = 0 - AL;

// Update AL
AL = result[7:0];

// CF is set if source was not zero
flag_CF = original_al != 0 ? 1'b1 : 1'b0;

// OF is set if original AL was 0x80 (most negative value)
flag_OF = original_al == 8'h80 ? 1'b1 : 1'b0;

// ZF is set if result is zero
flag_ZF = result[7:0] == 0 ? 1'b1 : 1'b0;

// SF is sign bit of result
flag_SF = result[7];

// PF is parity of low byte
flag_PF = result[0];

// AF is set if there's borrow from bit 3
flag_AF = original_al[3];
