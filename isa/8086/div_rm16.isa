// SPDX-License-Identifier: BSD-3-Clause
// 8086 DIV r/m16 (0xF7 /6) - CONSOLIDATED ALL ADDRESSING MODES
// Unsigned divide: DX:AX / rm16 -> AX (quotient), DX (remainder)

isa_state xregs[15:0][7:0];
isa_state ip[15:0];
var instr[7:0];
isa_state modrm[7:0];
var mod_bits[1:0];
var reg_bits[2:0];
var rm_bits[2:0];
isa_state imem[7:0][15:0];
isa_state dmem[7:0][19:0];
isa_state DS[15:0];

var src_reg_idx[2:0];
var addr_reg_idx[2:0];
var base_offset[15:0];
var disp8[7:0];
var disp16_lo[7:0];
var disp16_hi[7:0];
var disp16[15:0];
var signed_disp8[15:0];
var offset[15:0];
var physical_addr_lo[19:0];
var physical_addr_hi[19:0];
var src_mem_val[15:0];
var src_reg_val[15:0];
var src_val[15:0];
var dividend[31:0];
var quotient[31:0];
var remainder[31:0];
var is_mem_src[0:0];

instr = imem[ip];
assume instr == 0xF7;
ip = ip + 1;

modrm = imem[ip];
ip = ip + 1;

mod_bits = modrm[7:6];
reg_bits = modrm[5:3];
rm_bits = modrm[2:0];

assume reg_bits == 0b110;  // DIV

src_reg_idx = rm_bits;

case (rm_bits) {
  0b100: addr_reg_idx = 3'b110;
  0b101: addr_reg_idx = 3'b111;
  0b111: addr_reg_idx = 3'b011;
}

base_offset = xregs[addr_reg_idx];

disp8 = imem[ip];
disp16_lo = imem[ip];
disp16_hi = imem[ip + 1];
disp16 = {disp16_hi, disp16_lo};
signed_disp8 = {{8{disp8[7]}}, disp8};

case (mod_bits) {
  0b00: offset = base_offset;
  0b01: offset = base_offset + signed_disp8;
  0b10: offset = base_offset + disp16;
  0b11: offset = 16'h0000;
}

case (mod_bits) {
  0b00: is_mem_src = 1'b1;
  0b01: is_mem_src = 1'b1;
  0b10: is_mem_src = 1'b1;
  0b11: is_mem_src = 1'b0;
}

case (mod_bits) {
  0b00: ip = ip;
  0b01: ip = ip + 1;
  0b10: ip = ip + 2;
  0b11: ip = ip;
}

physical_addr_lo = (DS << 4) + offset;
physical_addr_hi = (DS << 4) + offset + 16'h0001;

var src_mem_val_lo[7:0];
var src_mem_val_hi[7:0];
src_mem_val_lo = dmem[physical_addr_lo];
src_mem_val_hi = dmem[physical_addr_hi];
src_mem_val = {src_mem_val_hi, src_mem_val_lo};
src_reg_val = xregs[src_reg_idx];

case (is_mem_src) {
  1'b1: src_val = src_mem_val;
  1'b0: src_val = src_reg_val;
}

// Form 32-bit dividend from DX:AX
dividend = {xregs[2], xregs[0]};  // {DX, AX}

quotient = dividend / src_val;
remainder = dividend - (quotient * src_val);

// Write quotient to AX and remainder to DX
xregs[0] = quotient[15:0];   // AX
xregs[2] = remainder[15:0];  // DX
// Flags are undefined after DIV
