// SPDX-License-Identifier: BSD-3-Clause
// 8086 SUB r16, r16 - Parameterized with wildcard ** syntax
// Opcode: 0x29 + ModR/M byte
// Handles all word register combinations: AX,CX,DX,BX,SP,BP,SI,DI

isa_state ip[15:0];
var instr[7:0];
isa_state modrm[7:0];

isa_state xregs[15:0][2:0];

isa_state imem[7:0][15:0];
isa_state dmem[7:0][19:0];     // 1MB memory (20-bit addressing)
isa_state DS[15:0];            // Data segment register

isa_state flag_CF[0:0];
isa_state flag_PF[0:0];
isa_state flag_AF[0:0];
isa_state flag_ZF[0:0];
isa_state flag_SF[0:0];
isa_state flag_OF[0:0];

var reg_idx[2:0];
var rm_idx[2:0];
var mod_bits[1:0];

var src_val[15:0];
var dst_val[15:0];
var result[16:0];

instr = imem[ip];
assume instr == 0x29;  // SUB r/m16, r16 opcode
ip = ip + 1;

modrm = imem[ip];
ip = ip + 1;

mod_bits = modrm[7:6];
reg_idx = modrm[5:3];
rm_idx = modrm[2:0];

assume mod_bits == 0b11;

src_val = xregs[reg_idx];
dst_val = xregs[rm_idx];

result = dst_val - src_val;

xregs[rm_idx] = result[15:0];

flag_CF = result[16];
flag_ZF = result[15:0] == 0 ? 1'b1 : 1'b0;
flag_SF = result[15];
flag_OF = dst_val[15] & ~src_val[15] & ~result[15] | ~dst_val[15] & src_val[15] & result[15];
flag_PF = result[0];
flag_AF = ~dst_val[3] & src_val[3] | src_val[3] & result[3] | result[3] & ~dst_val[3];
