// SPDX-License-Identifier: BSD-3-Clause
// 8086 MOV r8h, imm8 - Parameterized with wildcard ** syntax
// Opcodes: 0xB4-0xB7 (MOV AH/CH/DH/BH, imm8)
// Replaces 4 separate files: mov_ah_imm, mov_ch_imm, mov_dh_imm, mov_bh_imm
// Opcode encoding: 0xB4 + register_index (bits [1:0] of opcode = register index)

isa_state ip[15:0];
var instr[7:0];

// Word register file
isa_state xregs[15:0][2:0];

// High byte register array using wildcard ** syntax
// 0b1** means bit[2]=1 (high byte), bits[1:0]=variable (array index)
isa_state hregs[7:0][1:0] of xregs[0b1**][15:8];  // AH, CH, DH, BH

isa_state imem[7:0][15:0];
isa_state dmem[7:0][19:0];     // 1MB memory (20-bit addressing)
isa_state DS[15:0];            // Data segment register

var reg_idx[1:0];
var imm[7:0];

// Fetch instruction
instr = imem[ip];

// Check this is a MOV r8h, imm8 instruction (0xB4-0xB7)
assume instr[7:2] == 0b101101;  // Upper 6 bits must be 101101

ip = ip + 1;

// Extract register index from lower 2 bits of opcode
reg_idx = instr[1:0];

// Read immediate byte
imm = imem[ip];
ip = ip + 1;

// Move immediate to high byte register using indexed access
hregs[reg_idx] = imm[7:0];
