// SPDX-License-Identifier: BSD-3-Clause
// 8086 CMPSB (0xA6) - WITH PROPER SEGMENTATION
// Compare byte at DS:[SI] with ES:[DI]
// Uses DS segment for source, ES segment for destination

isa_state ip[15:0];
var instr[7:0];
isa_state imem[7:0][15:0];
isa_state dmem[7:0][19:0];     // 1MB memory (20-bit addressing)
isa_state DS[15:0];            // Data segment (source)
isa_state ES[15:0];            // Extra segment (destination)
isa_state SI[15:0];
isa_state DI[15:0];
isa_state flag_DF[0:0];
isa_state flag_CF[0:0];
isa_state flag_ZF[0:0];
isa_state flag_SF[0:0];
isa_state flag_OF[0:0];
isa_state flag_PF[0:0];

var physical_addr_src[19:0];
var physical_addr_dst[19:0];
var byte1[7:0];
var byte2[7:0];
var result[8:0];

instr = imem[ip];
assume instr == 0xA6;
ip = ip + 1;

// Calculate physical addresses using both segments
physical_addr_src = (DS << 4) + SI;  // Source from DS:SI
physical_addr_dst = (ES << 4) + DI;  // Destination from ES:DI

// Compare byte at DS:[SI] with ES:[DI] (subtraction)
byte1 = dmem[physical_addr_src];
byte2 = dmem[physical_addr_dst];
result = byte1 - byte2;

// Set flags based on result
flag_CF = byte1 < byte2 ? 1'b1 : 1'b0;
flag_ZF = result[7:0] == 8'h00 ? 1'b1 : 1'b0;
flag_SF = result[7];
flag_PF = result[0];
flag_OF = ((byte1[7] != byte2[7]) & (result[7] != byte1[7])) ? 1'b1 : 1'b0;

// Increment or decrement SI and DI based on direction flag
SI = flag_DF == 1'b0 ? (SI + 16'h0001) : (SI - 16'h0001);
DI = flag_DF == 1'b0 ? (DI + 16'h0001) : (DI - 16'h0001);
