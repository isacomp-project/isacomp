// SPDX-License-Identifier: BSD-3-Clause
// 8086 JMP short (0xEB) - WITH PROPER SEGMENTATION
// Unconditional short jump
// Uses signed byte displacement relative to IP
// No memory access - jumps don't need segmentation

isa_state ip[15:0];
var instr[7:0];
isa_state imem[7:0][15:0];
isa_state dmem[7:0][19:0];     // 1MB memory (20-bit addressing)

var offset[7:0];
var signed_offset[15:0];
var target_addr[15:0];

instr = imem[ip];
assume instr == 0xEB;
ip = ip + 1;

// Read signed byte displacement
offset = imem[ip];
ip = ip + 1;

// Sign-extend 8-bit offset to 16 bits
signed_offset = {{8{offset[7]}}, offset};

// Calculate target address
target_addr = ip + signed_offset;

// Unconditional jump
ip = target_addr;
