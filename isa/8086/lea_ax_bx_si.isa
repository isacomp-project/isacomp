// SPDX-License-Identifier: BSD-3-Clause
// 8086 LEA AX, [BX+SI] (0x8D with modrm 0x00) - WITH PROPER SEGMENTATION
// Load Effective Address - computes offset [BX+SI] and stores in AX
// Does NOT access memory, just calculates the offset portion of the address
// Note: LEA never applies segment registers - it only calculates offsets

isa_state ip[15:0];
var instr[7:0];
isa_state modrm[7:0];
isa_state xregs[15:0][2:0];
isa_state imem[7:0][15:0];
isa_state dmem[7:0][19:0];     // 1MB memory (20-bit addressing)

var bx_val[15:0];
var si_val[15:0];
var effective_addr[15:0];

instr = imem[ip];
assume instr == 0x8D;
ip = ip + 1;

modrm = imem[ip];
assume modrm == 0x00;  // mod=00, reg=000 (AX), rm=000 (BX+SI)
ip = ip + 1;

// Read BX (xregs[3]) and SI (xregs[6])
bx_val = xregs[3];
si_val = xregs[6];

// Calculate effective address (just the 16-bit offset, not accessing memory)
effective_addr = bx_val + si_val;

// Store offset in AX (xregs[0])
xregs[0] = effective_addr;
