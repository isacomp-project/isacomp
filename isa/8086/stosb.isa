// SPDX-License-Identifier: BSD-3-Clause
// 8086 STOSB (0xAA) - WITH PROPER SEGMENTATION
// Store byte string - store AL to ES:[DI]
// Uses ES segment for destination

isa_state ip[15:0];
var instr[7:0];
isa_state imem[7:0][15:0];
isa_state dmem[7:0][19:0];     // 1MB memory (20-bit addressing)
isa_state ES[15:0];            // Extra segment register
isa_state AX[15:0];
isa_state AL[7:0] of AX[7:0];
isa_state DI[15:0];
isa_state flag_DF[0:0];

var physical_addr[19:0];

instr = imem[ip];
assume instr == 0xAA;
ip = ip + 1;

// Calculate physical address using ES segment
physical_addr = (ES << 4) + DI;

// Store AL to ES:[DI]
dmem[physical_addr] = AL;

// Increment or decrement DI based on direction flag
DI = flag_DF == 1'b0 ? (DI + 16'h0001) : (DI - 16'h0001);
