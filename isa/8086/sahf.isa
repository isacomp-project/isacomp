// SPDX-License-Identifier: BSD-3-Clause
// 8086 SAHF - Store AH into Flags
// Opcode: 0x9E
// Stores AH into low byte of FLAGS (SF ZF 0 AF 0 PF 1 CF)

isa_state ip[15:0];
var instr[7:0];
isa_state xregs[15:0][2:0];
isa_state imem[7:0][15:0];
isa_state dmem[7:0][19:0];     // 1MB memory (20-bit addressing)
isa_state DS[15:0];            // Data segment register

isa_state flag_SF[0:0];
isa_state flag_ZF[0:0];
isa_state flag_AF[0:0];
isa_state flag_PF[0:0];
isa_state flag_CF[0:0];

var ah_value[7:0];

// Fetch instruction
instr = imem[ip];
assume instr == 0x9E;
ip = ip + 1;

// Read AH (high byte of AX, which is xregs[0])
ah_value = xregs[0][15:8];

// Extract flags from AH: SF ZF 0 AF 0 PF 1 CF
flag_SF = ah_value[7];
flag_ZF = ah_value[6];
// bit 5 is undefined
flag_AF = ah_value[4];
// bit 3 is undefined
flag_PF = ah_value[2];
// bit 1 is always 1
flag_CF = ah_value[0];
