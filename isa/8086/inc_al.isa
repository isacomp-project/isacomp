// SPDX-License-Identifier: BSD-3-Clause
// 8086 INC AL (0xFE with modrm 0xC0)
// Increment AL register by 1
// Affects: OF, SF, ZF, AF, PF (NOT CF)

isa_state ip[15:0];
var instr[7:0];
isa_state modrm[7:0];
isa_state AX[15:0];
isa_state AL[7:0] of AX[7:0];
isa_state imem[7:0][15:0];
isa_state dmem[7:0][19:0];     // 1MB memory (20-bit addressing)
isa_state DS[15:0];            // Data segment register
isa_state flag_PF[0:0];
isa_state flag_AF[0:0];
isa_state flag_ZF[0:0];
isa_state flag_SF[0:0];
isa_state flag_OF[0:0];

var result[8:0];

instr = imem[ip];
assume instr == 0xFE;
ip = ip + 1;

modrm = imem[ip];
assume modrm == 0xC0;
ip = ip + 1;

result = AL + 1;

// Update AL
AL = result[7:0];

// Update flags (CF is NOT affected by INC)
flag_ZF = result[7:0] == 0 ? 1'b1 : 1'b0;
flag_SF = result[7];
flag_OF = (AL[7] == 1'b0) & (result[7] == 1'b1);  // Overflow if 0x7F + 1 = 0x80
flag_PF = result[0];
flag_AF = AL[3];
