// SPDX-License-Identifier: BSD-3-Clause
// 8086 MOV r8l, r/m8 (0x8A) - CONSOLIDATED ALL ADDRESSING MODES
// Uses multiple case statements for parser compatibility
// Move r/m8 to low byte register (register destination, r/m source)
// Supports all addressing modes via ModR/M byte:
//   mod=00: [SI], [DI], [BX] - indirect
//   mod=01: [SI+disp8], [DI+disp8], [BX+disp8] - indirect + 8-bit displacement
//   mod=10: [SI+disp16], [DI+disp16], [BX+disp16] - indirect + 16-bit displacement
//   mod=11: AL, CL, DL, BL - register direct

isa_state lregs[7:0][1:0] of xregs[0b0**][7:0];   // AL,CL,DL,BL
isa_state xregs[15:0][7:0];    // 16-bit registers array
isa_state ip[15:0];
var instr[7:0];
isa_state modrm[7:0];
var mod_bits[1:0];
var reg_idx[2:0];
var rm_bits[2:0];
isa_state imem[7:0][15:0];
isa_state dmem[7:0][19:0];     // 1MB memory (20-bit addressing)
isa_state DS[15:0];            // Data segment register

var dst_idx[1:0];
var src_reg_idx[2:0];
var addr_reg_idx[2:0];
var base_offset[15:0];
var disp8[7:0];
var disp16_lo[7:0];
var disp16_hi[7:0];
var disp16[15:0];
var signed_disp8[15:0];
var offset[15:0];
var physical_addr[19:0];
var src_mem_val[7:0];
var src_reg_val[7:0];
var src_val[7:0];
var is_mem_src[0:0];

// Fetch instruction
instr = imem[ip];
assume instr == 0x8A;
ip = ip + 1;

// Fetch ModR/M byte
modrm = imem[ip];
ip = ip + 1;

// Decode ModR/M
mod_bits = modrm[7:6];
reg_idx = modrm[5:3];
rm_bits = modrm[2:0];

assume reg_idx[2] == 0;    // Destination is low byte register
dst_idx = reg_idx[1:0];
src_reg_idx = rm_bits[1:0];

// Pre-calculate address register index for memory modes
case (rm_bits) {
  0b100: addr_reg_idx = 3'b110;
  0b101: addr_reg_idx = 3'b111;
  0b111: addr_reg_idx = 3'b011;
}

// Read base offset from address register
base_offset = xregs[addr_reg_idx];

// Read potential displacement bytes
disp8 = imem[ip];
disp16_lo = imem[ip];
disp16_hi = imem[ip + 1];
disp16 = {disp16_hi, disp16_lo};
signed_disp8 = {{8{disp8[7]}}, disp8};

// Calculate offset based on addressing mode
case (mod_bits) {
  0b00: offset = base_offset;
  0b01: offset = base_offset + signed_disp8;
  0b10: offset = base_offset + disp16;
  0b11: offset = 16'h0000;
}

// Set source type flag
case (mod_bits) {
  0b00: is_mem_src = 1'b1;
  0b01: is_mem_src = 1'b1;
  0b10: is_mem_src = 1'b1;
  0b11: is_mem_src = 1'b0;
}

// Advance IP based on displacement bytes consumed
case (mod_bits) {
  0b00: ip = ip;
  0b01: ip = ip + 1;
  0b10: ip = ip + 2;
  0b11: ip = ip;
}

// Calculate physical address for memory modes
physical_addr = (DS << 4) + offset;

// Read source values (both memory and register)
src_mem_val = dmem[physical_addr];
src_reg_val = lregs[src_reg_idx];

// Select actual source value based on mode
case (is_mem_src) {
  1'b1: src_val = src_mem_val;
  1'b0: src_val = src_reg_val;
}

// Write to destination register
lregs[dst_idx] = src_val;
