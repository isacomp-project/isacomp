// SPDX-License-Identifier: BSD-3-Clause
// 8086 LODSB (0xAC) - WITH PROPER SEGMENTATION
// Load byte string - load byte from DS:[SI] into AL
// Uses DS segment for source

isa_state ip[15:0];
var instr[7:0];
isa_state imem[7:0][15:0];
isa_state dmem[7:0][19:0];     // 1MB memory (20-bit addressing)
isa_state DS[15:0];            // Data segment register
isa_state AX[15:0];
isa_state AL[7:0] of AX[7:0];
isa_state SI[15:0];
isa_state flag_DF[0:0];

var physical_addr[19:0];

instr = imem[ip];
assume instr == 0xAC;
ip = ip + 1;

// Calculate physical address using DS segment
physical_addr = (DS << 4) + SI;

// Load byte from DS:[SI] into AL
AL = dmem[physical_addr];

// Increment or decrement SI based on direction flag
SI = flag_DF == 1'b0 ? (SI + 16'h0001) : (SI - 16'h0001);
