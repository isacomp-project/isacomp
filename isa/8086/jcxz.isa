// SPDX-License-Identifier: BSD-3-Clause
// 8086 JCXZ rel8 (0xE3) - WITH PROPER SEGMENTATION
// Jump short if CX is zero
// Uses signed byte displacement relative to IP
// No memory access - jumps don't need segmentation

isa_state ip[15:0];
var instr[7:0];
isa_state imem[7:0][15:0];
isa_state dmem[7:0][19:0];     // 1MB memory (20-bit addressing)
isa_state CX[15:0];

var offset[7:0];
var signed_offset[15:0];
var target_addr[15:0];

instr = imem[ip];
assume instr == 0xE3;
ip = ip + 1;

// Read 8-bit signed offset
offset = imem[ip];
ip = ip + 1;

// Sign-extend offset to 16 bits
signed_offset = {{8{offset[7]}}, offset};

// Calculate target address
target_addr = ip + signed_offset;

// Conditional jump: if CX == 0, jump to target
ip = CX == 16'h0000 ? target_addr : ip;
