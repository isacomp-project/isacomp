// 8086 WAIT (0x9B)
// Wait for coprocessor

isa_state ip[15:0];
var instr[7:0];
isa_state imem[7:0][15:0];

instr = imem[ip];
assume instr == 0x9B;
ip = ip + 1;

// WAIT is essentially a NOP in this simple model
// In a real implementation, it would wait for the coprocessor
