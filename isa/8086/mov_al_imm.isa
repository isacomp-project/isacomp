// SPDX-License-Identifier: BSD-3-Clause
// 8086 MOV AL, imm8 (0xB0)
// Move immediate byte to AL register

isa_state ip[15:0];
var instr[7:0];
isa_state AX[15:0];
isa_state AL[7:0] of AX[7:0];
isa_state imem[7:0][15:0];
isa_state dmem[7:0][19:0];     // 1MB memory (20-bit addressing)
isa_state DS[15:0];            // Data segment register

var imm[7:0];

// Fetch instruction
instr = imem[ip];
assume instr == 0xB0;
ip = ip + 1;

// Read immediate byte
imm = imem[ip];
ip = ip + 1;

// Move immediate to AL
AL = imm;
