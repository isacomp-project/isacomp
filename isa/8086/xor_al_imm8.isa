// SPDX-License-Identifier: BSD-3-Clause
// 8086 XOR AL, imm8 (0x34)
// Direct accumulator addressing - no ModR/M byte

isa_state AL[7:0] of xregs[0][7:0];
isa_state xregs[15:0][7:0];
isa_state ip[15:0];
var instr[7:0];
isa_state imem[7:0][15:0];
isa_state flag_CF[0:0];
isa_state flag_OF[0:0];
isa_state flag_SF[0:0];
isa_state flag_ZF[0:0];
isa_state flag_AF[0:0];
isa_state flag_PF[0:0];

var imm_val[7:0];
var result[8:0];

// Fetch instruction
instr = imem[ip];
assume instr == 0x34;
ip = ip + 1;

// Fetch immediate value
imm_val = imem[ip];
ip = ip + 1;

// Perform XOR operation
result = AL ^ imm_val;

// Set flags
flag_CF = 1'b0;
flag_OF = 1'b0;
flag_SF = result[7];
flag_ZF = result[7:0] == 8'h00;
flag_AF = 1'b0;
flag_PF = ~(result[0] ^ result[1] ^ result[2] ^ result[3] ^ result[4] ^ result[5] ^ result[6] ^ result[7]);

// Write result
AL = result[7:0];
