// SPDX-License-Identifier: BSD-3-Clause
// 8086 SAR AL, CL (0xD2 with modrm 0xF8)
// Shift arithmetic right by CL count

isa_state ip[15:0];
var instr[7:0];
isa_state modrm[7:0];
isa_state AX[15:0];
isa_state AL[7:0] of AX[7:0];
isa_state CX[15:0];
isa_state CL[7:0] of CX[7:0];
isa_state imem[7:0][15:0];
isa_state dmem[7:0][19:0];     // 1MB memory (20-bit addressing)
isa_state DS[15:0];            // Data segment register
isa_state flag_CF[0:0];
isa_state flag_SF[0:0];
isa_state flag_ZF[0:0];
isa_state flag_PF[0:0];

var count[7:0];
var result[8:0];

instr = imem[ip];
assume instr == 0xD2;
ip = ip + 1;

modrm = imem[ip];
assume modrm == 0xF8;
ip = ip + 1;

// Mask count to 0-31
count = CL & 8'h1F;

// Arithmetic shift right: sign bit is preserved
// For count > 0, shift right and replicate sign bit
result = count > 0 ? (AL >>> count) : AL;

AL = result[7:0];
flag_SF = AL[7];
flag_ZF = AL == 8'h00 ? 1'b1 : 1'b0;
flag_PF = AL[0];
// CF gets the last bit shifted out (would need to track, simplified here)
flag_CF = count > 0 ? 1'b0 : flag_CF;
