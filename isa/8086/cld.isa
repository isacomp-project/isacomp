// 8086 CLD (0xFC)
// Clear direction flag

isa_state ip[15:0];
var instr[7:0];
isa_state imem[7:0][15:0];
isa_state dmem[7:0][19:0];     // 1MB memory (20-bit addressing)
isa_state DS[15:0];            // Data segment register
isa_state flag_DF[0:0];

instr = imem[ip];
assume instr == 0xFC;
ip = ip + 1;

// Clear direction flag (string operations increment)
flag_DF = 1'b0;
