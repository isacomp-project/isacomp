// SPDX-License-Identifier: BSD-3-Clause
// 8086 INC AX (0x40)
// Increment AX register by 1
// Affects: OF, SF, ZF, AF, PF (NOT CF)

isa_state ip[15:0];
var instr[7:0];
isa_state AX[15:0];
isa_state imem[7:0][15:0];
isa_state dmem[7:0][19:0];     // 1MB memory (20-bit addressing)
isa_state DS[15:0];            // Data segment register
isa_state flag_PF[0:0];
isa_state flag_AF[0:0];
isa_state flag_ZF[0:0];
isa_state flag_SF[0:0];
isa_state flag_OF[0:0];

var old_val[15:0];
var result[16:0];

// Fetch instruction
instr = imem[ip];
assume instr == 0x40;
ip = ip + 1;

// Read old value
old_val = AX;

// Increment by 1
result = old_val + 1;

// Write back
AX = result[15:0];

// Update flags (CF is NOT affected by INC)
flag_ZF = result[15:0] == 0 ? 1'b1 : 1'b0;
flag_SF = result[15];
flag_OF = (old_val[15] == 1'b0) & (result[15] == 1'b1);  // Overflow if 0x7FFF + 1 = 0x8000
flag_PF = result[0];
flag_AF = old_val[3];  // AF set if low nibble overflowed
