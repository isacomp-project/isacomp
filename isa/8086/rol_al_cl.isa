// SPDX-License-Identifier: BSD-3-Clause
// 8086 ROL AL, CL (0xD2 with modrm 0xC0)
// Rotate left by CL count

isa_state ip[15:0];
var instr[7:0];
isa_state modrm[7:0];
isa_state AX[15:0];
isa_state AL[7:0] of AX[7:0];
isa_state CX[15:0];
isa_state CL[7:0] of CX[7:0];
isa_state imem[7:0][15:0];
isa_state dmem[7:0][19:0];     // 1MB memory (20-bit addressing)
isa_state DS[15:0];            // Data segment register
isa_state flag_CF[0:0];

var count[7:0];
var result[8:0];

instr = imem[ip];
assume instr == 0xD2;
ip = ip + 1;

modrm = imem[ip];
assume modrm == 0xC0;
ip = ip + 1;

// Mask count to 0-31 (for 8-bit, effective is mod 8)
count = CL & 8'h07;

// Rotate left: high bits wrap to low bits
result = (AL << count) | (AL >> (8 - count));

AL = result[7:0];
flag_CF = AL[0];  // Bit that was rotated into position 0
