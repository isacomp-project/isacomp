// SPDX-License-Identifier: BSD-3-Clause
// 8086 REP LODSW (0xF3 0xAD) - WITH PROPER SEGMENTATION
// Repeat while CX != 0: Load word from DS:[SI] into AX
// IP stays constant until CX reaches 0
// Uses DS segment for source

isa_state ip[15:0];
var prefix[7:0];
var instr[7:0];
isa_state imem[7:0][15:0];
isa_state dmem[7:0][19:0];     // 1MB memory (20-bit addressing)
isa_state DS[15:0];            // Data segment register
isa_state AX[15:0];
isa_state SI[15:0];
isa_state CX[15:0];
isa_state flag_DF[0:0];

var si_offset_lo[7:0];
var si_offset_hi[7:0];
var physical_addr_lo[19:0];
var physical_addr_hi[19:0];
var low_byte[7:0];
var high_byte[7:0];
var word_value[15:0];
var cx_is_zero[0:0];
var cx_not_zero[0:0];
var new_si_inc[15:0];
var new_si_dec[15:0];
var new_ip[15:0];

// Fetch REP prefix
prefix = imem[ip];
assume prefix == 0xF3;

// Fetch LODSW instruction (at IP+1)
instr = imem[ip + 1];
assume instr == 0xAD;

// Check counter
cx_is_zero = CX == 16'h0000;
cx_not_zero = CX != 16'h0000;

// Calculate source offsets with wraparound
si_offset_lo = SI;
si_offset_hi = SI + 16'h0001;  // Wraps at 16-bit boundary

// Calculate physical addresses using DS segment
physical_addr_lo = (DS << 4) + si_offset_lo;  // DS:SI
physical_addr_hi = (DS << 4) + si_offset_hi;  // DS:(SI+1)

// Load word from DS:[SI] (little-endian)
low_byte = dmem[physical_addr_lo];
high_byte = dmem[physical_addr_hi];
word_value = {high_byte, low_byte};

// Calculate new SI (increment or decrement by 2)
new_si_inc = SI + 16'h0002;
new_si_dec = SI - 16'h0002;

// Calculate new IP (advance past instruction)
new_ip = ip + 16'h0002;

// When CX != 0: Execute one iteration
AX when(cx_not_zero) = word_value;
SI when(cx_not_zero) = flag_DF == 1'b0 ? new_si_inc : new_si_dec;
CX when(cx_not_zero) = CX - 16'h0001;
ip when(cx_not_zero) = ip;  // Stay at same IP (loop continues)

// When CX == 0: Advance IP and exit
ip when(cx_is_zero) = new_ip;
