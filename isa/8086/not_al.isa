// 8086 NOT AL (0xF6 with modrm 0xD0)
// One's complement (bitwise NOT)
// Does not affect flags

isa_state ip[15:0];
var instr[7:0];
isa_state modrm[7:0];
isa_state AX[15:0];
isa_state AL[7:0] of AX[7:0];
isa_state imem[7:0][15:0];
isa_state dmem[7:0][19:0];     // 1MB memory (20-bit addressing)
isa_state DS[15:0];            // Data segment register

var result[7:0];

instr = imem[ip];
assume instr == 0xF6;
ip = ip + 1;

modrm = imem[ip];
assume modrm == 0xD0;
ip = ip + 1;

// NOT: flip all bits (using XOR with 0xFF)
result = AL ^ 0xFF;

// Update AL
AL = result[7:0];
