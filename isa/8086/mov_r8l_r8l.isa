// SPDX-License-Identifier: BSD-3-Clause
// 8086 MOV r8_low, r8_low - Parameterized with wildcard ** syntax
// Opcode: 0x88 + ModR/M byte
// MOV does not affect flags

isa_state ip[15:0];
var instr[7:0];
isa_state modrm[7:0];

isa_state xregs[15:0][2:0];

isa_state lregs[7:0][1:0] of xregs[0b0**][7:0];

isa_state imem[7:0][15:0];
isa_state dmem[7:0][19:0];     // 1MB memory (20-bit addressing)
isa_state DS[15:0];            // Data segment register

var reg_idx[2:0];
var rm_idx[2:0];
var mod_bits[1:0];

var src_val[7:0];

instr = imem[ip];
assume instr == 0x88;  // MOV r/m8, r8 opcode
ip = ip + 1;

modrm = imem[ip];
ip = ip + 1;

mod_bits = modrm[7:6];
reg_idx = modrm[5:3];
rm_idx = modrm[2:0];

assume mod_bits == 0b11;
assume reg_idx[2] == 0;
assume rm_idx[2] == 0;

var src_idx[1:0];
var dst_idx[1:0];
src_idx = reg_idx[1:0];
dst_idx = rm_idx[1:0];

src_val = lregs[src_idx];

lregs[dst_idx] = src_val;
