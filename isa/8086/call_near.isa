// SPDX-License-Identifier: BSD-3-Clause
// 8086 CALL rel16 (0xE8) - WITH PROPER SEGMENTATION
// Call near procedure (relative offset)
// Pushes return address onto SS:[SP] and jumps to target

isa_state ip[15:0];
var instr[7:0];
isa_state imem[7:0][15:0];
isa_state dmem[7:0][19:0];     // 1MB memory (20-bit addressing)
isa_state SS[15:0];            // Stack segment register
isa_state xregs[15:0][7:0];    // General purpose registers (xregs[4] is SP)

var offset_lo[7:0];
var offset_hi[7:0];
var offset[15:0];
var target_addr[15:0];
var return_addr[15:0];
var stack_offset_lo[15:0];
var stack_offset_hi[15:0];
var physical_addr_lo[19:0];
var physical_addr_hi[19:0];

instr = imem[ip];
assume instr == 0xE8;
ip = ip + 1;

// Read 16-bit signed offset (little-endian)
offset_lo = imem[ip];
ip = ip + 1;
offset_hi = imem[ip];
ip = ip + 1;

offset = {offset_hi, offset_lo};

// Calculate return address (current IP after reading offset)
return_addr = ip;

// Calculate target address (IP + signed offset)
target_addr = ip + offset;

// Decrement SP by 2
xregs[4] = xregs[4] - 16'h0002;

// Calculate stack offsets for return address
stack_offset_lo = xregs[4];
stack_offset_hi = xregs[4] + 16'h0001;  // Wraps at 16-bit boundary

// Calculate physical addresses: SS:offset
physical_addr_lo = (SS << 4) + stack_offset_lo;
physical_addr_hi = (SS << 4) + stack_offset_hi;

// Push return address onto stack (little-endian)
dmem[physical_addr_lo] = return_addr[7:0];
dmem[physical_addr_hi] = return_addr[15:8];

// Jump to target
ip = target_addr;
