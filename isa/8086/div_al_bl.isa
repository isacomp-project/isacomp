// SPDX-License-Identifier: BSD-3-Clause
// 8086 DIV BL (0xF6 with modrm 0xF3)
// Unsigned divide AX by BL: AL = quotient, AH = remainder
// Flags are undefined after DIV

isa_state ip[15:0];
var instr[7:0];
isa_state modrm[7:0];
isa_state AX[15:0];
isa_state AL[7:0] of AX[7:0];
isa_state AH[7:0] of AX[15:8];
isa_state BX[15:0];
isa_state BL[7:0] of BX[7:0];
isa_state imem[7:0][15:0];
isa_state dmem[7:0][19:0];     // 1MB memory (20-bit addressing)
isa_state DS[15:0];            // Data segment register

var quotient[15:0];
var remainder[15:0];

instr = imem[ip];
assume instr == 0xF6;
ip = ip + 1;

modrm = imem[ip];
assume modrm == 0xF3;
ip = ip + 1;

// DIV: unsigned divide AX by BL
// AL = AX / BL (quotient)
// AH = AX % BL (remainder)
quotient = AX / BL;
remainder = AX - (quotient * BL);

// Update AX with quotient in AL and remainder in AH
AL = quotient[7:0];
AH = remainder[7:0];
