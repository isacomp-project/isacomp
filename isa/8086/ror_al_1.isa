// SPDX-License-Identifier: BSD-3-Clause
// 8086 ROR AL,1 (0xD0 with modrm 0xC8)
// Rotate Right by 1 bit
// LSB rotates to MSB and CF

isa_state ip[15:0];
var instr[7:0];
isa_state modrm[7:0];
isa_state AX[15:0];
isa_state AL[7:0] of AX[7:0];
isa_state imem[7:0][15:0];
isa_state dmem[7:0][19:0];     // 1MB memory (20-bit addressing)
isa_state DS[15:0];            // Data segment register
isa_state flag_CF[0:0];
isa_state flag_OF[0:0];

var result[8:0];
var lsb[7:0];

instr = imem[ip];
assume instr == 0xD0;
ip = ip + 1;

modrm = imem[ip];
assume modrm == 0xC8;
ip = ip + 1;

// Save LSB
lsb = AL[0];

// Rotate right: shift right and move LSB to MSB
result = (AL >> 1) | (lsb << 7);

// Update AL
AL = result[7:0];

// CF gets the rotated bit (original LSB)
flag_CF = lsb;

// OF is XOR of two most significant bits after rotation
flag_OF = AL[7] ^ AL[6];
