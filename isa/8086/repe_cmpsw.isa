// SPDX-License-Identifier: BSD-3-Clause
// 8086 REPE CMPSW (0xF3 0xA7) - WITH PROPER SEGMENTATION
// Repeat while CX != 0 AND ZF == 1: Compare word at DS:[SI] with ES:[DI]
// Exit when CX == 0 OR ZF == 0 (not equal)
// IP stays constant until loop exits
// Uses DS segment for source, ES segment for destination

isa_state ip[15:0];
var prefix[7:0];
var instr[7:0];
isa_state imem[7:0][15:0];
isa_state dmem[7:0][19:0];     // 1MB memory (20-bit addressing)
isa_state DS[15:0];            // Data segment (source)
isa_state ES[15:0];            // Extra segment (destination)
isa_state SI[15:0];
isa_state DI[15:0];
isa_state CX[15:0];
isa_state flag_DF[0:0];
isa_state flag_CF[0:0];
isa_state flag_ZF[0:0];
isa_state flag_SF[0:0];
isa_state flag_OF[0:0];
isa_state flag_PF[0:0];

var si_offset_lo[7:0];
var si_offset_hi[7:0];
var di_offset_lo[7:0];
var di_offset_hi[7:0];
var physical_addr_src_lo[19:0];
var physical_addr_src_hi[19:0];
var physical_addr_dst_lo[19:0];
var physical_addr_dst_hi[19:0];
var word1_low[7:0];
var word1_high[7:0];
var word2_low[7:0];
var word2_high[7:0];
var word1[7:0];
var word2[7:0];
var result[16:0];
var new_zf[15:0];
var cx_is_zero[0:0];
var cx_not_zero_and_equal[0:0];
var cx_not_zero_and_not_equal[0:0];
var new_si_inc[15:0];
var new_si_dec[15:0];
var new_di_inc[15:0];
var new_di_dec[15:0];
var new_ip[15:0];

// Fetch REPE prefix
prefix = imem[ip];
assume prefix == 0xF3;

// Fetch CMPSW instruction (at IP+1)
instr = imem[ip + 1];
assume instr == 0xA7;

// Check counter
cx_is_zero = CX == 16'h0000;

// Calculate source offsets with wraparound
si_offset_lo = SI;
si_offset_hi = SI + 16'h0001;  // Wraps at 16-bit boundary

// Calculate destination offsets with wraparound
di_offset_lo = DI;
di_offset_hi = DI + 16'h0001;  // Wraps at 16-bit boundary

// Calculate physical addresses using both segments
physical_addr_src_lo = (DS << 4) + si_offset_lo;  // DS:SI
physical_addr_src_hi = (DS << 4) + si_offset_hi;  // DS:(SI+1)
physical_addr_dst_lo = (ES << 4) + di_offset_lo;  // ES:DI
physical_addr_dst_hi = (ES << 4) + di_offset_hi;  // ES:(DI+1)

// Compare word at DS:[SI] with ES:[DI] (little-endian)
word1_low = dmem[physical_addr_src_lo];
word1_high = dmem[physical_addr_src_hi];
word2_low = dmem[physical_addr_dst_lo];
word2_high = dmem[physical_addr_dst_hi];
word1 = {word1_high, word1_low};
word2 = {word2_high, word2_low};
result = word1 - word2;

// Calculate new flags based on result
new_zf = result[15:0] == 16'h0000 ? 1'b1 : 1'b0;

// Three mutually exclusive conditions
cx_not_zero_and_equal = (CX != 16'h0000) & (new_zf == 1'b1);
cx_not_zero_and_not_equal = (CX != 16'h0000) & (new_zf == 1'b0);

// Calculate new SI and DI (increment or decrement by 2)
new_si_inc = SI + 16'h0002;
new_si_dec = SI - 16'h0002;
new_di_inc = DI + 16'h0002;
new_di_dec = DI - 16'h0002;

// Calculate new IP (advance past instruction)
new_ip = ip + 16'h0002;

// When CX == 0: Just advance IP (don't execute)
ip when(cx_is_zero) = new_ip;

// When CX != 0 AND equal: Execute and continue (keep IP)
flag_CF when(cx_not_zero_and_equal) = word1 < word2 ? 1'b1 : 1'b0;
flag_ZF when(cx_not_zero_and_equal) = new_zf;
flag_SF when(cx_not_zero_and_equal) = result[15];
flag_PF when(cx_not_zero_and_equal) = result[0];
flag_OF when(cx_not_zero_and_equal) = ((word1[15] != word2[15]) & (result[15] != word1[15])) ? 1'b1 : 1'b0;
SI when(cx_not_zero_and_equal) = flag_DF == 1'b0 ? new_si_inc : new_si_dec;
DI when(cx_not_zero_and_equal) = flag_DF == 1'b0 ? new_di_inc : new_di_dec;
CX when(cx_not_zero_and_equal) = CX - 16'h0001;
ip when(cx_not_zero_and_equal) = ip;  // Stay at same IP (loop continues)

// When CX != 0 AND not equal: Execute and exit (advance IP)
flag_CF when(cx_not_zero_and_not_equal) = word1 < word2 ? 1'b1 : 1'b0;
flag_ZF when(cx_not_zero_and_not_equal) = new_zf;
flag_SF when(cx_not_zero_and_not_equal) = result[15];
flag_PF when(cx_not_zero_and_not_equal) = result[0];
flag_OF when(cx_not_zero_and_not_equal) = ((word1[15] != word2[15]) & (result[15] != word1[15])) ? 1'b1 : 1'b0;
SI when(cx_not_zero_and_not_equal) = flag_DF == 1'b0 ? new_si_inc : new_si_dec;
DI when(cx_not_zero_and_not_equal) = flag_DF == 1'b0 ? new_di_inc : new_di_dec;
CX when(cx_not_zero_and_not_equal) = CX - 16'h0001;
ip when(cx_not_zero_and_not_equal) = new_ip;
