// 8086 CBW (0x98)
// Convert byte to word - sign-extend AL into AH

isa_state ip[15:0];
var instr[7:0];
isa_state imem[7:0][15:0];
isa_state dmem[7:0][19:0];     // 1MB memory (20-bit addressing)
isa_state DS[15:0];            // Data segment register
isa_state AX[15:0];
isa_state AL[7:0] of AX[7:0];
isa_state AH[7:0] of AX[15:8];

instr = imem[ip];
assume instr == 0x98;
ip = ip + 1;

// Sign-extend AL into AH
// If AL[7] is 1, AH becomes 0xFF, otherwise 0x00
AH = AL[7] ? 8'hFF : 8'h00;
