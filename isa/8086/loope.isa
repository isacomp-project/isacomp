// SPDX-License-Identifier: BSD-3-Clause
// 8086 LOOPE/LOOPZ rel8 (0xE1) - WITH PROPER SEGMENTATION
// Decrement CX and jump if CX != 0 and ZF = 1
// No memory access - loops don't need segmentation

isa_state ip[15:0];
var instr[7:0];
isa_state CX[15:0];
isa_state flag_ZF[0:0];
isa_state imem[7:0][15:0];
isa_state dmem[7:0][19:0];     // 1MB memory (20-bit addressing)

var offset[7:0];
var signed_offset[15:0];
var target_addr[15:0];

instr = imem[ip];
assume instr == 0xE1;
ip = ip + 1;

// Read 8-bit signed offset
offset = imem[ip];
ip = ip + 1;

// Decrement CX
CX = CX - 1;

// Sign-extend offset to 16 bits
signed_offset = {{8{offset[7]}}, offset};

// Calculate target address
target_addr = ip + signed_offset;

// Conditional jump: if CX != 0 AND ZF = 1 after decrement, jump to target
ip = ((CX != 0) & (flag_ZF == 1'b1)) ? target_addr : ip;
