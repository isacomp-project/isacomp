// SPDX-License-Identifier: BSD-3-Clause
// 8086 PUSHF (0x9C) - WITH PROPER SEGMENTATION
// Push flags register onto stack
// Uses SS segment for stack access

isa_state ip[15:0];
var instr[7:0];
isa_state imem[7:0][15:0];
isa_state dmem[7:0][19:0];     // 1MB memory (20-bit addressing)
isa_state SS[15:0];            // Stack segment register
isa_state xregs[15:0][2:0];    // SP is xregs[4]
isa_state flag_CF[0:0];
isa_state flag_PF[0:0];
isa_state flag_AF[0:0];
isa_state flag_ZF[0:0];
isa_state flag_SF[0:0];
isa_state flag_TF[0:0];
isa_state flag_IF[0:0];
isa_state flag_DF[0:0];
isa_state flag_OF[0:0];

var flags[15:0];
var offset_lo[15:0];              // 16-bit stack offset (after decrement)
var offset_hi[15:0];              // 16-bit stack offset + 1
var physical_addr_lo[19:0];       // 20-bit physical address
var physical_addr_hi[19:0];       // 20-bit physical address

instr = imem[ip];
assume instr == 0x9C;
ip = ip + 1;

// Build FLAGS register (8086 format)
// Bit 0: CF, Bit 2: PF, Bit 4: AF, Bit 6: ZF, Bit 7: SF
// Bit 8: TF, Bit 9: IF, Bit 10: DF, Bit 11: OF
// Bit 1 is always 1, bits 12-15 are 0
flags = {4'b0000, flag_OF, flag_DF, flag_IF, flag_TF, flag_SF, flag_ZF, 1'b0, flag_AF, 1'b0, flag_PF, 1'b1, flag_CF};

// Decrement SP by 2
xregs[4] = xregs[4] - 16'h0002;

// Calculate stack offsets
offset_lo = xregs[4];
offset_hi = xregs[4] + 16'h0001;  // Wraps at 16-bit boundary

// Calculate physical addresses: SS:offset
physical_addr_lo = (SS << 4) + offset_lo;
physical_addr_hi = (SS << 4) + offset_hi;

// Push FLAGS onto stack (little-endian)
dmem[physical_addr_lo] = flags[7:0];
dmem[physical_addr_hi] = flags[15:8];
