// 8086 TEST AX, imm16 (0xA9)

isa_state AX[15:0] of xregs[0];
isa_state xregs[15:0][7:0];
isa_state ip[15:0];
var instr[7:0];
isa_state imem[7:0][15:0];
isa_state flag_CF[0:0];
isa_state flag_OF[0:0];
isa_state flag_SF[0:0];
isa_state flag_ZF[0:0];
isa_state flag_AF[0:0];
isa_state flag_PF[0:0];

var imm_lo[7:0];
var imm_hi[7:0];
var imm_val[15:0];
var result[16:0];

instr = imem[ip];
assume instr == 0xA9;
ip = ip + 1;

imm_lo = imem[ip];
ip = ip + 1;
imm_hi = imem[ip];
ip = ip + 1;
imm_val = {imm_hi, imm_lo};

result = AX & imm_val;

flag_CF = 1'b0;
flag_OF = 1'b0;
flag_SF = result[15];
flag_ZF = result[15:0] == 16'h0000;
flag_AF = 1'b0;
flag_PF = ~(result[0] ^ result[1] ^ result[2] ^ result[3] ^ result[4] ^ result[5] ^ result[6] ^ result[7]);

// TEST does not write result
