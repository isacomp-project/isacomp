// SPDX-License-Identifier: BSD-3-Clause
// 8086 MOV CS, AX (0x8E /r)
// Move AX to CS segment register
// WARNING: This is rarely used and dangerous - modifying CS affects code execution

isa_state ip[15:0];
var instr[7:0];
isa_state imem[7:0][15:0];
isa_state dmem[7:0][19:0];     // 1MB memory (20-bit addressing)
isa_state CS[15:0];            // Code segment register
isa_state xregs[15:0][7:0];    // General purpose registers (xregs[0] is AX)

var modrm[7:0];
var mod_bits[1:0];
var reg_bits[2:0];
var rm_bits[2:0];

instr = imem[ip];
assume instr == 0x8E;
ip = ip + 1;

// Fetch ModR/M byte
modrm = imem[ip];
ip = ip + 1;

// Decode ModR/M
mod_bits = modrm[7:6];
reg_bits = modrm[5:3];
rm_bits = modrm[2:0];

// Assume register mode (mod=11), CS (reg=001), AX (rm=000)
assume mod_bits == 0b11;
assume reg_bits == 0b001;  // CS
assume rm_bits == 0b000;   // AX

// Copy AX to CS
CS = xregs[0];
