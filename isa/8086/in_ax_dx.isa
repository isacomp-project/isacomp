// SPDX-License-Identifier: BSD-3-Clause
// 8086 IN AX, DX (0xED)
// Input word from port in DX

isa_state ip[15:0];
var instr[7:0];
isa_state imem[7:0][15:0];
isa_state AX[15:0];
isa_state DX[15:0];
isa_state io_ports[7:0][7:0];

var port_num[7:0];
var low_byte[7:0];
var high_byte[7:0];

instr = imem[ip];
assume instr == 0xED;
ip = ip + 1;

// Use DX as port number (only lower 8 bits for simplified model)
port_num = DX[7:0];

// Read word from I/O port (little-endian)
low_byte = io_ports[port_num];
high_byte = io_ports[port_num + 1];
AX = {high_byte, low_byte};
