// 8086 DAA (0x27)
// Decimal adjust AL after addition

isa_state ip[15:0];
var instr[7:0];
isa_state AX[15:0];
isa_state AL[7:0] of AX[7:0];
isa_state imem[7:0][15:0];
isa_state dmem[7:0][19:0];     // 1MB memory (20-bit addressing)
isa_state DS[15:0];            // Data segment register
isa_state flag_CF[0:0];
isa_state flag_AF[0:0];

var old_al[7:0];
var old_cf[0:0];

instr = imem[ip];
assume instr == 0x27;
ip = ip + 1;

// Save old values
old_al = AL;
old_cf = flag_CF;

// If low nibble > 9 or AF=1, add 6 to AL
AL = ((old_al[3:0] > 4'h9) | (flag_AF == 1'b1)) ? (old_al + 8'h06) : old_al;

// Set AF if low nibble needed adjustment
flag_AF = ((old_al[3:0] > 4'h9) | (flag_AF == 1'b1)) ? 1'b1 : 1'b0;

// If high nibble > 9 or CF=1, add 0x60 to AL
AL = ((old_al > 8'h99) | (old_cf == 1'b1)) ? (AL + 8'h60) : AL;

// Set CF if high nibble needed adjustment
flag_CF = ((old_al > 8'h99) | (old_cf == 1'b1)) ? 1'b1 : 1'b0;
