// SPDX-License-Identifier: BSD-3-Clause
// 8086 TEST AX,BX (0x85 with modrm 0xD8)
// Logical AND - affects flags only, does not store result
// Clears CF and OF, affects SF, ZF, PF

isa_state ip[15:0];
var instr[7:0];
isa_state modrm[7:0];
isa_state AX[15:0];
isa_state BX[15:0];
isa_state imem[7:0][15:0];
isa_state dmem[7:0][19:0];     // 1MB memory (20-bit addressing)
isa_state DS[15:0];            // Data segment register
isa_state flag_CF[0:0];
isa_state flag_PF[0:0];
isa_state flag_ZF[0:0];
isa_state flag_SF[0:0];
isa_state flag_OF[0:0];

var result[16:0];

instr = imem[ip];
assume instr == 0x85;
ip = ip + 1;

modrm = imem[ip];
assume modrm == 0xD8;
ip = ip + 1;

// Perform AND operation
result = AX & BX;

// Update flags (result is NOT stored)
flag_CF = 1'b0;  // TEST clears CF
flag_OF = 1'b0;  // TEST clears OF
flag_ZF = result == 0 ? 1'b1 : 1'b0;
flag_SF = result[15];
flag_PF = result[0];
