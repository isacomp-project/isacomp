// SPDX-License-Identifier: BSD-3-Clause
// 8086 MOV AX, ES (0x8C /r)
// Move ES segment register to AX

isa_state ip[15:0];
var instr[7:0];
isa_state imem[7:0][15:0];
isa_state dmem[7:0][19:0];     // 1MB memory (20-bit addressing)
isa_state ES[15:0];            // Extra segment register
isa_state xregs[15:0][7:0];    // General purpose registers (xregs[0] is AX)

var modrm[7:0];
var mod_bits[1:0];
var reg_bits[2:0];
var rm_bits[2:0];

instr = imem[ip];
assume instr == 0x8C;
ip = ip + 1;

// Fetch ModR/M byte
modrm = imem[ip];
ip = ip + 1;

// Decode ModR/M
mod_bits = modrm[7:6];
reg_bits = modrm[5:3];
rm_bits = modrm[2:0];

// Assume register mode (mod=11), ES (reg=000), AX (rm=000)
assume mod_bits == 0b11;
assume reg_bits == 0b000;  // ES
assume rm_bits == 0b000;   // AX

// Copy ES to AX
xregs[0] = ES;
