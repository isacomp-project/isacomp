// SPDX-License-Identifier: BSD-3-Clause
// 8086 XCHG r16, r16 - Exchange two word registers
// Opcode: 0x87 + ModR/M byte

isa_state ip[15:0];
var instr[7:0];
isa_state modrm[7:0];

isa_state xregs[15:0][7:0];

isa_state imem[7:0][15:0];
isa_state dmem[7:0][19:0];     // 1MB memory (20-bit addressing)
isa_state DS[15:0];            // Data segment register

var reg_idx[2:0];
var rm_idx[2:0];
var mod_bits[1:0];

// Fetch instruction
instr = imem[ip];
assume instr == 0x87;
ip = ip + 1;

// Fetch ModR/M byte
modrm = imem[ip];
ip = ip + 1;

// Decode ModR/M
mod_bits = modrm[7:6];
reg_idx = modrm[5:3];
rm_idx = modrm[2:0];

// Register-to-register mode only
assume mod_bits == 0b11;

var reg1_idx[15:0];
var reg2_idx[15:0];
var temp[15:0];

reg1_idx = reg_idx;
reg2_idx = rm_idx;

temp = xregs[reg1_idx];
xregs[reg1_idx] = xregs[reg2_idx];
xregs[reg2_idx] = temp;
