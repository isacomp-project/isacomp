// SPDX-License-Identifier: BSD-3-Clause
// ATT92010 Hobbit: LDRAA dst (load relative address into accumulator)
// Three-parcel encoding: opcode 0x00, subcode 0xA, 6 bytes
// Acc = &dst (PC-relative address calculation stored in accumulator)

isa_state pc[31:0];
isa_state sp[31:0];
mem umem[31:0];

var parcel0[15:0];
var parcel1[15:0];
var parcel2[15:0];
var opcode6[5:0];
var smode[3:0];
var subcode[3:0];
var operand[15:0];
var acc_addr[31:0];
var target_addr[31:0];

parcel0 = umem[pc];
parcel1 = umem[pc + 2];
parcel2 = umem[pc + 4];

assume parcel0[15:14] == 0b10;
opcode6 = parcel0[13:8];
assume opcode6 == 0x00;

smode = parcel0[7:4];
subcode = parcel0[3:0];
assume subcode == 0xA;

operand = parcel1;

// PC-relative mode: address = PC + sign_extend(operand)
assume smode == 0xE;
target_addr = pc + {{16{operand[15]}}, operand};

acc_addr = sp + 4;

// Store computed address in accumulator
umem[acc_addr] = target_addr;

pc = pc + 6;
