// SPDX-License-Identifier: BSD-3-Clause
// ATT92010 Hobbit: JMPTY dst (jump if flag true, predict taken)
// One-parcel encoding: opcode 0x07, 2 bytes
// if (PSW.F) PC = PC + sign_extend(offset10) * 2

isa_state pc[31:0];
isa_state psw[31:0];
mem umem[31:0];

var instr[15:0];
var opcode[4:0];
var offset[9:0];
var sign_ext_offset[31:0];
var flag[0:0];

instr = umem[pc];
assume instr[15] == 0;
opcode = instr[14:10];
assume opcode == 0x07;

offset = instr[9:0];
sign_ext_offset = {{21{offset[9]}}, offset, 1'b0};

flag = psw[4];

pc = (flag == 1) ? (pc + sign_ext_offset) : (pc + 2);
