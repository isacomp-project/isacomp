// SPDX-License-Identifier: BSD-3-Clause
// ATT92010 Hobbit: ADD src, dst (stack offset, stack offset)
// One-parcel encoding: opcode 0x16, 2 bytes
// dst += src; sets PSW carry and overflow bits

isa_state pc[31:0];
isa_state sp[31:0];
isa_state psw[31:0];
mem umem[31:0];

var instr[15:0];
var opcode[4:0];
var src_off[4:0];
var dst_off[4:0];
var src_addr[31:0];
var dst_addr[31:0];
var src_val[31:0];
var dst_val[31:0];
var result[32:0];

// Fetch one-parcel instruction
instr = umem[pc];
assume instr[15] == 0;
opcode = instr[14:10];
assume opcode == 0x16;

src_off = instr[9:5];
dst_off = instr[4:0];

// Stack offset addressing: address = SP + (offset * 4)
src_addr = sp + {25'b0, src_off, 2'b00};
dst_addr = sp + {25'b0, dst_off, 2'b00};

// Load operands
src_val = umem[src_addr];
dst_val = umem[dst_addr];

// Perform addition
result = {1'b0, dst_val} + {1'b0, src_val};

// Store result in destination
umem[dst_addr] = result[31:0];

// Update PSW carry bit (bit 5): unsigned overflow
psw[5] = result[32];

// Update PSW overflow bit (bit 6): signed overflow
psw[6] = (dst_val[31] == src_val[31]) & (dst_val[31] != result[31]);

// Advance PC by one parcel (2 bytes)
pc = pc + 2;
