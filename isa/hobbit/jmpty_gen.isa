// SPDX-License-Identifier: BSD-3-Clause
// ATT92010 Hobbit: JMPTY dst (three-parcel, absolute mode)
// Three-parcel monadic: opcode 0x00, subcode 0x7, 6 bytes
// if (PSW.F) PC = target; predict taken

isa_state pc[31:0];
isa_state psw[31:0];
mem umem[31:0];

var parcel0[15:0];
var parcel1[15:0];
var parcel2[15:0];
var opcode6[5:0];
var smode[3:0];
var subcode[3:0];
var operand[15:0];
var target[31:0];
var flag[0:0];

parcel0 = umem[pc];
parcel1 = umem[pc + 2];
parcel2 = umem[pc + 4];

assume parcel0[15:14] == 0b10;
opcode6 = parcel0[13:8];
assume opcode6 == 0x00;

smode = parcel0[7:4];
subcode = parcel0[3:0];
assume subcode == 0x7;

operand = parcel1;

assume smode == 0xE;
target = pc + {{16{operand[15]}}, operand};

flag = psw[4];

pc = (flag == 1) ? target : (pc + 6);
