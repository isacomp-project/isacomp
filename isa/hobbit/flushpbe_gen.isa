// SPDX-License-Identifier: BSD-3-Clause
// ATT92010 Hobbit: FLUSHPBE src (flush prefetch buffer entry)
// Three-parcel monadic: opcode 0x00, subcode 0xC, 6 bytes
// The quad-word at src is marked invalid in the prefetch buffer.
// No other caches are affected.

isa_state pc[31:0];
isa_state sp[31:0];
mem umem[31:0];

var parcel0[15:0];
var parcel1[15:0];
var parcel2[15:0];
var opcode6[5:0];
var smode[3:0];
var subcode[3:0];

parcel0 = umem[pc];
parcel1 = umem[pc + 2];
parcel2 = umem[pc + 4];

assume parcel0[15:14] == 0b10;
opcode6 = parcel0[13:8];
assume opcode6 == 0x00;

smode = parcel0[7:4];
subcode = parcel0[3:0];
assume subcode == 0xC;

// Prefetch buffer flush is microarchitectural; no ISA-visible state change
pc = pc + 6;
