// SPDX-License-Identifier: BSD-3-Clause
// ATT92010 Hobbit: POPN src (stack offset, one-parcel)
// One-parcel encoding: opcode 0x02, subcode 0x3, 2 bytes
// CSP += src; free entries from stack
// The 8-bit offset is zero-extended and multiplied by 16

isa_state pc[31:0];
isa_state sp[31:0];
isa_state msp[31:0];
isa_state shad[31:0];
mem umem[31:0];

var instr[15:0];
var opcode[4:0];
var subcode[1:0];
var offset[7:0];
var byte_offset[31:0];
var new_sp[31:0];

instr = umem[pc];
assume instr[15] == 0;
opcode = instr[14:10];
assume opcode == 0x02;
subcode = instr[9:8];
assume subcode == 0b11;

offset = instr[7:0];

// Zero-extend and multiply by 16
byte_offset = {20'b0, offset, 4'b0000};

new_sp = sp + byte_offset;
sp = new_sp;
shad = new_sp;

// If new SP > MSP, update MSP
msp = (new_sp > msp) ? new_sp : msp;

pc = pc + 2;
