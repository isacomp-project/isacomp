// SPDX-License-Identifier: BSD-3-Clause
// ATT92010 Hobbit: FLUSHPTE src (flush page table entry from TLBs)
// Three-parcel monadic: opcode 0x00, subcode 0xB, 6 bytes
// If there is a page table entry for the address defined by src
// in either the text or data TLBs, the entry is marked invalid.
// Both text and data nonpaged segment registers are invalidated.

isa_state pc[31:0];
isa_state sp[31:0];
mem umem[31:0];

var parcel0[15:0];
var parcel1[15:0];
var parcel2[15:0];
var opcode6[5:0];
var smode[3:0];
var subcode[3:0];
var operand[15:0];
var addr[31:0];

parcel0 = umem[pc];
parcel1 = umem[pc + 2];
parcel2 = umem[pc + 4];

assume parcel0[15:14] == 0b10;
opcode6 = parcel0[13:8];
assume opcode6 == 0x00;

smode = parcel0[7:4];
subcode = parcel0[3:0];
assume subcode == 0xB;

operand = parcel1;

// Normally uses stack offset indirect mode
// The operand is an address to flush from TLBs
// TLB flush is microarchitectural; no ISA-visible state change
// beyond invalidating cached translations

pc = pc + 6;
