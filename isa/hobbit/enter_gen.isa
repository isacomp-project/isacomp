// SPDX-License-Identifier: BSD-3-Clause
// ATT92010 Hobbit: ENTER src (three-parcel, general addressing)
// Three-parcel monadic: opcode 0x00, subcode 0x9, 6 bytes
// Allocate stack frame using full 16/32-bit operand
// For non-stack-offset modes, the stack cache is flushed unconditionally
// and SP is set to the target value (MSP = SP = target)

isa_state pc[31:0];
isa_state sp[31:0];
isa_state msp[31:0];
isa_state shad[31:0];
isa_state psw[31:0];
mem umem[31:0];

var parcel0[15:0];
var parcel1[15:0];
var parcel2[15:0];
var opcode6[5:0];
var smode[3:0];
var subcode[3:0];
var operand[15:0];
var byte_offset[31:0];
var new_sp[31:0];

parcel0 = umem[pc];
parcel1 = umem[pc + 2];
parcel2 = umem[pc + 4];

assume parcel0[15:14] == 0b10;
opcode6 = parcel0[13:8];
assume opcode6 == 0x00;

smode = parcel0[7:4];
subcode = parcel0[3:0];
assume subcode == 0x9;

operand = parcel1;

// Stack offset mode: SP += sign_extend(offset)
// For stack offset mode, bounds of stack cache encompass the full ENTER
assume smode == 0xD;
byte_offset = {{16{operand[15]}}, operand};

new_sp = sp + byte_offset;
sp = new_sp;
shad = new_sp;

// Set PSW enter guard bit (bit 11)
psw[11] = 1;

pc = pc + 6;
