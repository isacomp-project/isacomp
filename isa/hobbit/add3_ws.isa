// SPDX-License-Identifier: BSD-3-Clause
// ATT92010 Hobbit: ADD3 src, dst (word-aligned immediate, stack offset)
// One-parcel encoding: opcode 0x0D, 2 bytes
// Acc = dst + zero_extend(wai5) * 4; result in accumulator (SP+4)
// Sets PSW carry and overflow bits

isa_state pc[31:0];
isa_state sp[31:0];
isa_state psw[31:0];
mem umem[31:0];

var instr[15:0];
var opcode[4:0];
var wai[4:0];
var dst_off[4:0];
var dst_addr[31:0];
var acc_addr[31:0];
var src_val[31:0];
var dst_val[31:0];
var result[32:0];

instr = umem[pc];
assume instr[15] == 0;
opcode = instr[14:10];
assume opcode == 0x0D;

wai = instr[9:5];
dst_off = instr[4:0];

// Word-aligned immediate: zero-extend and multiply by 4
src_val = {25'b0, wai, 2'b00};

dst_addr = sp + {25'b0, dst_off, 2'b00};
acc_addr = sp + 4;

dst_val = umem[dst_addr];

result = {1'b0, dst_val} + {1'b0, src_val};

umem[acc_addr] = result[31:0];

psw[5] = result[32];
psw[6] = (dst_val[31] == src_val[31]) & (dst_val[31] != result[31]);

pc = pc + 2;
