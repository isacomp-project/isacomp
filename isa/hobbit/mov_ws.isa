// SPDX-License-Identifier: BSD-3-Clause
// ATT92010 Hobbit: MOV src, dst (word-aligned immediate, stack offset)
// One-parcel encoding: opcode 0x0A, 2 bytes
// dst = src (word-aligned 5-bit immediate * 4)

isa_state pc[31:0];
isa_state sp[31:0];
mem umem[31:0];

var instr[15:0];
var opcode[4:0];
var wai[4:0];
var dst_off[4:0];
var dst_addr[31:0];
var src_val[31:0];

instr = umem[pc];
assume instr[15] == 0;
opcode = instr[14:10];
assume opcode == 0x0A;

wai = instr[9:5];
dst_off = instr[4:0];

// Word-aligned immediate: zero-extend and multiply by 4
src_val = {25'b0, wai, 2'b00};

dst_addr = sp + {25'b0, dst_off, 2'b00};

umem[dst_addr] = src_val;

pc = pc + 2;
