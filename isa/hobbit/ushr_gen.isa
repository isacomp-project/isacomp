// SPDX-License-Identifier: BSD-3-Clause
// ATT92010 Hobbit: USHR src, dst (logical shift right, three-parcel)
// Three-parcel encoding: opcode 0x2D, 6 bytes
// dst >>= unsigned(src[4:0]) (zeros fill vacated bits)

isa_state pc[31:0];
isa_state sp[31:0];
mem umem[31:0];

var parcel0[15:0];
var parcel1[15:0];
var parcel2[15:0];
var opcode6[5:0];
var smode[3:0];
var dmode[3:0];
var src_field[15:0];
var dst_field[15:0];

var src_val[31:0];
var dst_val[31:0];
var src_addr[31:0];
var dst_addr[31:0];
var shift_amt[4:0];

parcel0 = umem[pc];
parcel1 = umem[pc + 2];
parcel2 = umem[pc + 4];

assume parcel0[15:14] == 0b10;
opcode6 = parcel0[13:8];
assume opcode6 == 0x2D;

smode = parcel0[7:4];
dmode = parcel0[3:0];
src_field = parcel1;
dst_field = parcel2;

assume smode == 0xD;
src_addr = sp + {{16{src_field[15]}}, src_field};
src_val = umem[src_addr];

assume dmode == 0xD;
dst_addr = sp + {{16{dst_field[15]}}, dst_field};
dst_val = umem[dst_addr];

shift_amt = src_val[4:0];
umem[dst_addr] = dst_val >> shift_amt;

pc = pc + 6;
