// SPDX-License-Identifier: BSD-3-Clause
// ATT92010 Hobbit: DQM src, dst (double-word move, three-parcel)
// Three-parcel encoding: opcode 0x07, 6 bytes
// Moves two contiguous words from src to dst (double-word)
// dst[0] = src[0]; dst[4] = src[4]

isa_state pc[31:0];
isa_state sp[31:0];
mem umem[31:0];

var parcel0[15:0];
var parcel1[15:0];
var parcel2[15:0];
var opcode6[5:0];
var smode[3:0];
var dmode[3:0];
var src_field[15:0];
var dst_field[15:0];

var src_addr[31:0];
var dst_addr[31:0];
var word0[31:0];
var word1[31:0];

parcel0 = umem[pc];
parcel1 = umem[pc + 2];
parcel2 = umem[pc + 4];

assume parcel0[15:14] == 0b10;
opcode6 = parcel0[13:8];
assume opcode6 == 0x07;

smode = parcel0[7:4];
dmode = parcel0[3:0];
src_field = parcel1;
dst_field = parcel2;

// Source: word absolute or stack offset
assume smode == 0xD;
src_addr = sp + {{16{src_field[15]}}, src_field};

// Destination mode 0x0 = double-word
assume dmode == 0x0;
dst_addr = sp + {{16{dst_field[15]}}, dst_field};

// Move two contiguous words
word0 = umem[src_addr];
word1 = umem[src_addr + 4];

umem[dst_addr] = word0;
umem[dst_addr + 4] = word1;

pc = pc + 6;
