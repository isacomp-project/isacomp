// SPDX-License-Identifier: BSD-3-Clause
// ATT92010 Hobbit: MOV src, dst (stack offset, indirect stack offset)
// One-parcel encoding: opcode 0x1A, 2 bytes
// *(SP + dst_off*4) = src  -- store through pointer on stack
// S=5-bit word-aligned stack offset, I=5-bit indirect stack offset

isa_state pc[31:0];
isa_state sp[31:0];
mem umem[31:0];

var instr[15:0];
var opcode[4:0];
var src_off[4:0];
var dst_off[4:0];
var src_addr[31:0];
var src_val[31:0];
var dst_ptr_addr[31:0];
var dst_ptr[31:0];

instr = umem[pc];
assume instr[15] == 0;
opcode = instr[14:10];
assume opcode == 0x1A;

src_off = instr[9:5];
dst_off = instr[4:0];

// Load source value from stack
src_addr = sp + {25'b0, src_off, 2'b00};
src_val = umem[src_addr];

// Indirect stack offset: fetch pointer from stack, then store through it
dst_ptr_addr = sp + {25'b0, dst_off, 2'b00};
dst_ptr = umem[dst_ptr_addr];

// Store source value to address pointed to by stack entry
umem[dst_ptr] = src_val;

pc = pc + 2;
