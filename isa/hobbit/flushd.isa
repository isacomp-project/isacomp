// SPDX-License-Identifier: BSD-3-Clause
// ATT92010 Hobbit: FLUSHD (flush data cache)
// One-parcel encoding: opcode 0x0B, subcode 0x6, 2 bytes
// NOTE: The ATT92010 has no data cache, so FLUSHD is unimplemented
// in hardware and triggers an unimplemented instruction exception.
// Modeled here as a NOP for architectural completeness.

isa_state pc[31:0];
mem umem[31:0];

var instr[15:0];

instr = umem[pc];
assume instr[15] == 0;
assume instr[14:10] == 0x0B;
assume instr[9:7] == 0b110;

// No architectural state change (data cache flush is microarchitectural)
pc = pc + 2;
