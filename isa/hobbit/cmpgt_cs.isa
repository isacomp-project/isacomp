// SPDX-License-Identifier: BSD-3-Clause
// ATT92010 Hobbit: CMPGT src1, src2 (immediate, stack offset)
// One-parcel encoding: opcode 0x12, 2 bytes
// PSW.F = (sign_extend(imm5) >s stk_val) ? 1 : 0

isa_state pc[31:0];
isa_state sp[31:0];
isa_state psw[31:0];
mem umem[31:0];

var instr[15:0];
var opcode[4:0];
var imm[4:0];
var dst_off[4:0];
var src_val[31:0];
var dst_addr[31:0];
var dst_val[31:0];

instr = umem[pc];
assume instr[15] == 0;
opcode = instr[14:10];
assume opcode == 0x12;

imm = instr[9:5];
dst_off = instr[4:0];

// Sign-extend 5-bit immediate
src_val = {{27{imm[4]}}, imm};

dst_addr = sp + {25'b0, dst_off, 2'b00};
dst_val = umem[dst_addr];

// Signed greater than: src1 (immediate) >s src2 (stack)
psw[4] = (src_val >s dst_val);

pc = pc + 2;
