// SPDX-License-Identifier: BSD-3-Clause
// ATT92010 Hobbit: POPN src (three-parcel, stack offset with full 16-bit offset)
// Three-parcel monadic: opcode 0x00, subcode 0xF, 6 bytes
// CSP += src; free entries from stack (full 16-bit offset)

isa_state pc[31:0];
isa_state sp[31:0];
isa_state msp[31:0];
isa_state shad[31:0];
mem umem[31:0];

var parcel0[15:0];
var parcel1[15:0];
var parcel2[15:0];
var opcode6[5:0];
var smode[3:0];
var subcode[3:0];
var operand[15:0];
var byte_offset[31:0];
var new_sp[31:0];

parcel0 = umem[pc];
parcel1 = umem[pc + 2];
parcel2 = umem[pc + 4];

assume parcel0[15:14] == 0b10;
opcode6 = parcel0[13:8];
assume opcode6 == 0x00;

smode = parcel0[7:4];
subcode = parcel0[3:0];
assume subcode == 0xF;

operand = parcel1;

// Only stack offset mode is legal for POPN
assume smode == 0xD;
byte_offset = {{16{operand[15]}}, operand};

new_sp = sp + byte_offset;
sp = new_sp;
shad = new_sp;

msp = (new_sp > msp) ? new_sp : msp;

pc = pc + 6;
