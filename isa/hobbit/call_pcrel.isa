// SPDX-License-Identifier: BSD-3-Clause
// ATT92010 Hobbit: CALL src (PC-relative)
// One-parcel encoding: opcode 0x01, 2 bytes
// *(CSP) = next_PC; PC = PC + sign_extend(offset10) * 2
// Saves return address at current stack pointer, then jumps

isa_state pc[31:0];
isa_state sp[31:0];
mem umem[31:0];

var instr[15:0];
var opcode[4:0];
var offset[9:0];
var sign_ext_offset[31:0];
var return_pc[31:0];
var target[31:0];

instr = umem[pc];
assume instr[15] == 0;
opcode = instr[14:10];
assume opcode == 0x01;

offset = instr[9:0];
sign_ext_offset = {{21{offset[9]}}, offset, 1'b0};

// Return address is the next instruction
return_pc = pc + 2;

// Target address
target = pc + sign_ext_offset;

// Save return PC at CSP (current stack pointer)
umem[sp] = return_pc;

// Jump to target
pc = target;
