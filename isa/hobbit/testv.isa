// SPDX-License-Identifier: BSD-3-Clause
// ATT92010 Hobbit: TESTV (test PSW overflow)
// One-parcel encoding: opcode 0x0B, subcode 0x1, 2 bytes
// PSW.F = PSW.V; PSW.V = 0

isa_state pc[31:0];
isa_state psw[31:0];
mem umem[31:0];

var instr[15:0];
var overflow[0:0];

instr = umem[pc];
assume instr[15] == 0;
assume instr[14:10] == 0x0B;
assume instr[9:7] == 0b001;
assume instr[6:3] == 0b0000;

// Copy overflow to flag, then clear overflow
overflow = psw[6];
psw[4] = overflow;
psw[6] = 0;

pc = pc + 2;
