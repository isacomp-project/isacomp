// SPDX-License-Identifier: BSD-3-Clause
// ATT92010 Hobbit: CATCH src (three-parcel, general addressing)
// Three-parcel monadic: opcode 0x00, subcode 0x8, 6 bytes
// Fill stack cache to extent indicated by src (full 16-bit offset)

isa_state pc[31:0];
isa_state sp[31:0];
isa_state msp[31:0];
mem umem[31:0];

var parcel0[15:0];
var parcel1[15:0];
var parcel2[15:0];
var opcode6[5:0];
var smode[3:0];
var subcode[3:0];
var operand[15:0];
var target_msp[31:0];

parcel0 = umem[pc];
parcel1 = umem[pc + 2];
parcel2 = umem[pc + 4];

assume parcel0[15:14] == 0b10;
opcode6 = parcel0[13:8];
assume opcode6 == 0x00;

smode = parcel0[7:4];
subcode = parcel0[3:0];
assume subcode == 0x8;

operand = parcel1;

// Stack offset mode: target MSP = SP + sign_extend(offset)
assume smode == 0xD;
target_msp = sp + {{16{operand[15]}}, operand};

// Fill stack cache (quad-word blocks) up to target, capped at SP+256
msp = target_msp;

pc = pc + 6;
