// SPDX-License-Identifier: BSD-3-Clause
// ATT92010 Hobbit: CALL src (three-parcel, absolute mode)
// Three-parcel monadic: opcode 0x00, subcode 0x1, 6 bytes
// *(CSP) = next PC; PC = *(operand)   [absolute address in operand]

isa_state pc[31:0];
isa_state sp[31:0];
mem umem[31:0];

var parcel0[15:0];
var parcel1[15:0];
var parcel2[15:0];
var opcode6[5:0];
var smode[3:0];
var subcode[3:0];
var operand[15:0];
var return_pc[31:0];
var target[31:0];

parcel0 = umem[pc];
parcel1 = umem[pc + 2];
parcel2 = umem[pc + 4];

assume parcel0[15:14] == 0b10;
opcode6 = parcel0[13:8];
assume opcode6 == 0x00;

smode = parcel0[7:4];
subcode = parcel0[3:0];
assume subcode == 0x1;

operand = parcel1;

// Absolute mode (0xF): target = operand (sign-extended to 32 bits)
assume smode == 0xF;
target = {{16{operand[15]}}, operand};

return_pc = pc + 6;

umem[sp] = return_pc;

pc = target;
