// SPDX-License-Identifier: BSD-3-Clause
// ATT92010 Hobbit: ENTER src (stack offset, one-parcel)
// One-parcel encoding: opcode 0x02, subcode 0x0, 2 bytes
// Allocate stack frame by adjusting SP downward
// The 8-bit offset is left-padded with ones and multiplied by 16
// giving effective range -16 to -4096 in quad-aligned decrements

isa_state pc[31:0];
isa_state sp[31:0];
isa_state msp[31:0];
isa_state shad[31:0];
isa_state psw[31:0];
mem umem[31:0];

var instr[15:0];
var opcode[4:0];
var subcode[1:0];
var offset[7:0];
var byte_offset[31:0];
var new_sp[31:0];

instr = umem[pc];
assume instr[15] == 0;
opcode = instr[14:10];
assume opcode == 0x02;
subcode = instr[9:8];
assume subcode == 0b00;

offset = instr[7:0];

// Left-pad with ones and multiply by 16 (negative offset)
byte_offset = {20'hFFFFF, offset, 4'b0000};

// New SP = SP + negative offset (grows downward)
new_sp = sp + byte_offset;

// Update SP and SHAD
sp = new_sp;
shad = new_sp;

// Set PSW enter guard bit (bit 11)
psw[11] = 1;

pc = pc + 2;
