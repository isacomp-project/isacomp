// SPDX-License-Identifier: BSD-3-Clause
// ATT92010 Hobbit: TADD src, dst (tagged addition, three-parcel)
// Three-parcel encoding: opcode 0x0C, 6 bytes
// If low 2 bits of either operand are non-zero, PSW.F = 1 and no store.
// Otherwise: dst = dst + src; PSW.F = PSW.V

isa_state pc[31:0];
isa_state sp[31:0];
isa_state psw[31:0];
mem umem[31:0];

var parcel0[15:0];
var parcel1[15:0];
var parcel2[15:0];
var opcode6[5:0];
var smode[3:0];
var dmode[3:0];
var src_field[15:0];
var dst_field[15:0];

var src_val[31:0];
var dst_val[31:0];
var src_addr[31:0];
var dst_addr[31:0];
var result[32:0];
var tags_ok[0:0];

parcel0 = umem[pc];
parcel1 = umem[pc + 2];
parcel2 = umem[pc + 4];

assume parcel0[15:14] == 0b10;
opcode6 = parcel0[13:8];
assume opcode6 == 0x0C;

smode = parcel0[7:4];
dmode = parcel0[3:0];
src_field = parcel1;
dst_field = parcel2;

assume smode == 0xD;
src_addr = sp + {{16{src_field[15]}}, src_field};
src_val = umem[src_addr];

assume dmode == 0xD;
dst_addr = sp + {{16{dst_field[15]}}, dst_field};
dst_val = umem[dst_addr];

// Check tags: low 2 bits must be zero
tags_ok = (src_val[1:0] == 0) & (dst_val[1:0] == 0);

result = {1'b0, dst_val} + {1'b0, src_val};

// Unsigned overflow
psw[5] = tags_ok ? result[32] : psw[5];

// Signed overflow
psw[6] = tags_ok ? ((dst_val[31] == src_val[31]) & (dst_val[31] != result[31])) : psw[6];

// Flag: set to 1 if tags bad, or overflow if tags ok
psw[4] = tags_ok ? ((dst_val[31] == src_val[31]) & (dst_val[31] != result[31])) : 1;

// Only store result if flag is 0 (tags ok and no overflow)
umem[dst_addr] when (psw[4] == 0) = result[31:0];

pc = pc + 6;
