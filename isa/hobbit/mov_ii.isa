// SPDX-License-Identifier: BSD-3-Clause
// ATT92010 Hobbit: MOV src, dst (indirect stack offset, indirect stack offset)
// One-parcel encoding: opcode 0x1B, 2 bytes
// *(SP + dst_off*4) = *(SP + src_off*4)  -- load and store through pointers
// I=5-bit indirect stack offset for both operands

isa_state pc[31:0];
isa_state sp[31:0];
mem umem[31:0];

var instr[15:0];
var opcode[4:0];
var src_off[4:0];
var dst_off[4:0];
var src_ptr_addr[31:0];
var src_ptr[31:0];
var src_val[31:0];
var dst_ptr_addr[31:0];
var dst_ptr[31:0];

instr = umem[pc];
assume instr[15] == 0;
opcode = instr[14:10];
assume opcode == 0x1B;

src_off = instr[9:5];
dst_off = instr[4:0];

// Source: indirect stack offset - fetch pointer, then dereference
src_ptr_addr = sp + {25'b0, src_off, 2'b00};
src_ptr = umem[src_ptr_addr];
src_val = umem[src_ptr];

// Destination: indirect stack offset - fetch pointer, then store through it
dst_ptr_addr = sp + {25'b0, dst_off, 2'b00};
dst_ptr = umem[dst_ptr_addr];

umem[dst_ptr] = src_val;

pc = pc + 2;
