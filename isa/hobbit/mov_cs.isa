// SPDX-License-Identifier: BSD-3-Clause
// ATT92010 Hobbit: MOV src, dst (immediate, stack offset)
// One-parcel encoding: opcode 0x1C, 2 bytes
// dst = sign_extend(imm5)

isa_state pc[31:0];
isa_state sp[31:0];
mem umem[31:0];

var instr[15:0];
var opcode[4:0];
var imm[4:0];
var dst_off[4:0];
var dst_addr[31:0];
var src_val[31:0];

instr = umem[pc];
assume instr[15] == 0;
opcode = instr[14:10];
assume opcode == 0x1C;

imm = instr[9:5];
dst_off = instr[4:0];

// Sign-extend 5-bit immediate
src_val = {{27{imm[4]}}, imm};

dst_addr = sp + {25'b0, dst_off, 2'b00};

umem[dst_addr] = src_val;

pc = pc + 2;
