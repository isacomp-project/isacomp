// SPDX-License-Identifier: BSD-3-Clause
// ATT92010 Hobbit: RETURN src (three-parcel, stack offset with 32-bit offset)
// Three-parcel monadic: opcode 0x00, subcode 0x2, 6 bytes
// PC = *(CSP + src); CSP += src (deallocate stack frame)
// Full 16-bit stack offset (sign-extended) for larger frames

isa_state pc[31:0];
isa_state sp[31:0];
isa_state msp[31:0];
isa_state shad[31:0];
mem umem[31:0];

var parcel0[15:0];
var parcel1[15:0];
var parcel2[15:0];
var opcode6[5:0];
var smode[3:0];
var subcode[3:0];
var operand[15:0];
var byte_offset[31:0];
var return_addr[31:0];
var new_sp[31:0];

parcel0 = umem[pc];
parcel1 = umem[pc + 2];
parcel2 = umem[pc + 4];

assume parcel0[15:14] == 0b10;
opcode6 = parcel0[13:8];
assume opcode6 == 0x00;

smode = parcel0[7:4];
subcode = parcel0[3:0];
assume subcode == 0x2;

operand = parcel1;

// Stack offset mode (0xD): offset = sign_extend(operand)
assume smode == 0xD;
byte_offset = {{16{operand[15]}}, operand};

// Load return address from stack
return_addr = umem[sp + byte_offset];

// Update SP (deallocate frame) - lower 4 bits masked to 0
new_sp = (sp + byte_offset) & 0xFFFFFFF0;
sp = new_sp;
shad = new_sp;

msp = (new_sp > msp) ? new_sp : msp;

pc = return_addr;
