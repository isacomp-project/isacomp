// SPDX-License-Identifier: BSD-3-Clause
// OpenPOWER stwbrx - Store Word Byte-Reverse Indexed (X-Form)
// stwbrx RS,RA,RB
// Primary opcode 31, XO=662
// if RA = 0 then b <- 0 else b <- (RA)
// EA <- b + (RB)
// Take low 32 bits of RS, reverse bytes, store
// MEM(EA, 4) <- BYTE_REVERSE((RS)[32:63])

isa_state pc[63:0];
var instr[31:0];
isa_state rf[63:0][4:0];
mem umem[14:0];

var rs[4:0];
var ra[4:0];
var rb[4:0];
var rs_val[63:0];
var ra_val[63:0];
var rb_val[63:0];
var ra_or_zero[63:0];
var ea[63:0];
var word_data[31:0];
var reversed[31:0];

#ifdef VM
aspect mmu.isa gates pc, msr, srr0, srr1;
instr = umem[pc_pa];
#else
instr = umem[pc];
#endif
// Primary opcode 31
assume instr[31:26] == 31;
// XO field = 662
assume instr[10:1] == 662;

// Extract register fields
rs = instr[25:21];
ra = instr[20:16];
rb = instr[15:11];

ra_val = rf[ra];
rb_val = rf[rb];

// If RA=0, use 0; otherwise use (RA)
ra_or_zero = ra == 0 ? 64'h0 : ra_val;

// Calculate effective address
ea = ra_or_zero + rb_val;

// Get word to store (low 32 bits)
rs_val = rf[rs];
word_data = rs_val[31:0];

// Reverse bytes: [b0, b1, b2, b3] -> [b3, b2, b1, b0]
reversed = {word_data[7:0], word_data[15:8], word_data[23:16], word_data[31:24]};

// Store reversed word to memory
#ifdef VM
aspect mmu_store.isa gates pc, msr, srr0, srr1, dar, dsisr;
umem[ea_pa] when (~store_exception_taken & ~instr_trap_taken) = reversed;
#else
umem[ea] = reversed;
#endif
pc = pc + 4;
