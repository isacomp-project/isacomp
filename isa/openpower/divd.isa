// SPDX-License-Identifier: BSD-3-Clause
// OpenPOWER divd - Divide Doubleword (XO-Form)
// divd RT,RA,RB
// Primary opcode 31, XO=489
// RT <- (RA) / (RB) (signed 64-bit division)

isa_state pc[63:0];
var instr[31:0];
isa_state rf[63:0][4:0];
mem umem[14:0];

var rt[4:0];
var ra[4:0];
var rb[4:0];
var ra_val[63:0];
var rb_val[63:0];
var result[63:0];

#ifdef VM
aspect mmu.isa gates pc, msr, srr0, srr1;
instr = umem[pc_pa];
#else
instr = umem[pc];
#endif
// Primary opcode 31
assume instr[31:26] == 31;
// XO field = 489
assume instr[9:1] == 489;
// Rc bit = 0
assume instr[0] == 0;
// OE bit = 0
assume instr[10] == 0;

// Extract register fields
rt = instr[25:21];
ra = instr[20:16];
rb = instr[15:11];

ra_val = rf[ra];
rb_val = rf[rb];

// Signed divide: compute sign, divide absolute values, apply sign
var ra_sign[0:0];
var rb_sign[0:0];
var result_sign[0:0];
var ra_abs[63:0];
var rb_abs[63:0];
var quotient_abs[63:0];

ra_sign = ra_val[63];
rb_sign = rb_val[63];
result_sign = ra_sign ^ rb_sign;

// Absolute values: negate if negative
ra_abs = ra_sign ? (~ra_val + 64'h1) : ra_val;
rb_abs = rb_sign ? (~rb_val + 64'h1) : rb_val;

// Unsigned divide of absolute values
quotient_abs = ra_abs / rb_abs;

// Apply sign to result
result = result_sign ? (~quotient_abs + 64'h1) : quotient_abs;

#ifdef VM
rf[rt] when (~instr_trap_taken) = result;
#else
rf[rt] = result;
#endif
pc = pc + 4;
