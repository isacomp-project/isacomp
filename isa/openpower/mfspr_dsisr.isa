// SPDX-License-Identifier: BSD-3-Clause
// OpenPOWER mfspr DSISR - Move From Data Storage Interrupt Status Register
// mfspr RT,18 (SPR 18 = DSISR)
// Primary opcode 31, XO=339

isa_state pc[63:0];
var instr[31:0];
isa_state rf[63:0][4:0];
mem umem[14:0];
isa_state dsisr[31:0];

var rt[4:0];
var mfspr_dsisr_result[63:0];

#ifdef VM
aspect mmu.isa gates pc, msr, srr0, srr1;
instr = umem[pc_pa];
#else
instr = umem[pc];
#endif
assume instr[31:26] == 31;
assume instr[10:1] == 339;
// SPR field for DSISR (SPR 18): spr_hi=0, spr_lo=18
assume instr[15:11] == 0;
assume instr[20:16] == 18;

rt = instr[25:21];
mfspr_dsisr_result = {32'h0, dsisr};
#ifdef VM
rf[rt] when (~instr_trap_taken) = mfspr_dsisr_result;
#else
rf[rt] = mfspr_dsisr_result;
#endif

pc = pc + 4;
