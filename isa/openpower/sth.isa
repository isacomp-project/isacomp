// SPDX-License-Identifier: BSD-3-Clause
// OpenPOWER sth - Store Halfword (D-Form)
// sth RS,D(RA)
// Primary opcode 44
// if RA = 0 then b <- 0 else b <- (RA)
// EA <- b + EXTS(D)
// MEM(EA, 2) <- (RS)[48:63]

isa_state pc[63:0];
var instr[31:0];
isa_state rf[63:0][4:0];
mem umem[14:0];

var rs[4:0];
var ra[4:0];
var d[15:0];
var rs_val[63:0];
var ra_val[63:0];
var ra_or_zero[63:0];
var sign_ext_d[63:0];
var ea[63:0];
var half_data[15:0];

#ifdef VM
aspect mmu.isa gates pc, msr, srr0, srr1;
instr = umem[pc_pa];
#else
instr = umem[pc];
#endif
// Primary opcode 44
assume instr[31:26] == 44;

// Extract fields
rs = instr[25:21];
ra = instr[20:16];
d = instr[15:0];

// Sign-extend displacement
sign_ext_d = {{48{d[15]}}, d};

// If RA=0, use 0; otherwise use (RA)
ra_val = rf[ra];
ra_or_zero = ra == 0 ? 64'h0 : ra_val;

// Calculate effective address
ea = ra_or_zero + sign_ext_d;

// Get halfword to store (low 16 bits of RS)
rs_val = rf[rs];
half_data = rs_val[15:0];

// Store halfword to memory
#ifdef VM
aspect mmu_store.isa gates pc, msr, srr0, srr1, dar, dsisr;
umem[ea_pa] when (~store_exception_taken & ~instr_trap_taken) = half_data;
#else
umem[ea] = half_data;
#endif
pc = pc + 4;
