// SPDX-License-Identifier: BSD-3-Clause
// OpenPOWER bcctr - Branch Conditional to Count Register (XL-Form)
// bcctr BO,BI
// Primary opcode 19, XO=528, LK=0
// Branch to address in CTR based on BO and BI conditions
// Note: CTR is NOT decremented for this instruction

isa_state pc[63:0];
var instr[31:0];
isa_state rf[63:0][4:0];
mem umem[14:0];
isa_state ctr[63:0];
isa_state cr[31:0];

var bo[4:0];
var bi[4:0];
var cond_ok[0:0];
var take_branch[0:0];
var cr_bit[0:0];
var target[63:0];

#ifdef VM
aspect mmu.isa gates pc, msr, srr0, srr1;
instr = umem[pc_pa];
#else
instr = umem[pc];
#endif
// Primary opcode 19
assume instr[31:26] == 19;
// XO field = 528
assume instr[10:1] == 528;
// LK = 0
assume instr[0] == 0;
// BO[2] must be 1 (don't use CTR for condition when branching to CTR)
assume instr[23] == 1;

// Extract fields
bo = instr[25:21];
bi = instr[20:16];

// Get CR bit
cr_bit = cr[31 - bi];

// Condition test only (no CTR test for bcctr)
// BO bit 0 (bo[4]) controls CR ignore, BO bit 1 (bo[3]) controls CR sense
cond_ok = bo[4] | (cr_bit == bo[3]);

take_branch = cond_ok;

// Target from CTR (with bits 62:63 cleared)
target = {ctr[63:2], 2'b00};

pc = take_branch ? target : pc + 4;
