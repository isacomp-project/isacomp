// SPDX-License-Identifier: BSD-3-Clause
// OpenPOWER cmplw - Compare Logical Word (X-Form)
// cmplw BF,RA,RB  (L=0 for word compare)
// Primary opcode 31, XO=32
// Compares (RA)[32:63] with (RB)[32:63] as unsigned integers

isa_state pc[63:0];
var instr[31:0];
isa_state rf[63:0][4:0];
mem umem[14:0];
isa_state cr[31:0];

var bf[2:0];
var ra[4:0];
var rb[4:0];
var ra_val[31:0];
var rb_val[31:0];
var lt[0:0];
var gt[0:0];
var eq[0:0];
var cr_field[3:0];
var cr_shift[4:0];
var cr_mask[31:0];
var new_cr[31:0];

#ifdef VM
aspect mmu.isa gates pc, msr, srr0, srr1;
instr = umem[pc_pa];
#else
instr = umem[pc];
#endif
// Primary opcode 31
assume instr[31:26] == 31;
// XO field = 32
assume instr[10:1] == 32;
// L = 0 (word compare)
assume instr[21] == 0;

// Extract fields
bf = instr[25:23];
ra = instr[20:16];
rb = instr[15:11];

// Get word values (low 32 bits)
ra_val = rf[ra][31:0];
rb_val = rf[rb][31:0];

// Unsigned comparison
lt = ra_val < rb_val;
gt = ra_val > rb_val;
eq = ra_val == rb_val;

// Build CR field: LT, GT, EQ, SO (SO=0 for now)
cr_field = {lt, gt, eq, 1'b0};

// Calculate shift amount and mask for CR field
cr_shift = (7 - bf) << 2;
cr_mask = ~(32'hF << cr_shift);

// Update CR field (widen cr_field to 32 bits before shift)
new_cr = (cr & cr_mask) | ({28'b0, cr_field} << cr_shift);
cr = new_cr;

pc = pc + 4;
