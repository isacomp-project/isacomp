// OpenPOWER b - Branch (I-Form)
// b target
// Primary opcode 18, AA=0, LK=0
// NIA <- CIA + EXTS(LI || 0b00)

isa_state pc[63:0];
var instr[31:0];
isa_state rf[63:0][4:0];
mem umem[14:0];

var li[23:0];
var sign_ext_li[63:0];
var target[63:0];

#ifdef VM
aspect mmu.isa gates pc, msr, srr0, srr1;
instr = umem[pc_pa];
#else
instr = umem[pc];
#endif
// Primary opcode 18
assume instr[31:26] == 18;
// AA = 0 (relative addressing)
assume instr[1] == 0;
// LK = 0 (don't update link register)
assume instr[0] == 0;

// Extract LI field (24 bits)
li = instr[25:2];

// Sign-extend and multiply by 4 (LI || 00)
sign_ext_li = {{38{li[23]}}, li, 2'b00};

// Calculate target address (relative to current PC)
target = pc + sign_ext_li;

pc = target;
