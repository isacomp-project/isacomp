// SPDX-License-Identifier: BSD-3-Clause
// OpenPOWER tlbiel - TLB Invalidate Entry Local (X-Form)
// tlbiel RB,RS,RIC,PRS,R
// Primary opcode 31, XO=274
// Invalidates TLB entry for the local processor only (no broadcast)
//
// For single-core implementation without TLB cache, this is a no-op.
// Page table entries are read directly from memory on each access.
//
// Encoding (Power ISA v3.0B):
//   Bits 6-10: RS (contains LPID for R=1)
//   Bits 11-15: Reserved
//   Bits 16-20: RB (contains virtual address/selector info)
//   Bits 21-22: RIC (Radix Invalidation Control)
//               00 = TLB, 01 = PWC, 10 = all TLB of process, 11 = all TLB+PWC
//   Bit 23: PRS (Process Scoped)
//   Bit 24: R (Radix/HPT selector, 1=Radix)
//   Bits 25-30: XO[5:10] = 274
//   Bit 31: Reserved
//
// Microwatt note: Single-core implementation, no broadcast TLBIE needed.
// Software IPI shootdown would be used for SMP if implemented.

isa_state pc[63:0];
var instr[31:0];
isa_state rf[63:0][4:0];
mem umem[14:0];

var rs[4:0];
var rb[4:0];
var ric[1:0];
var prs[0:0];
var r_bit[0:0];

#ifdef VM
aspect mmu.isa gates pc, msr, srr0, srr1;
instr = umem[pc_pa];
#else
instr = umem[pc];
#endif
// Primary opcode 31
assume instr[31:26] == 31;
// XO field = 274 (bits 21:30 in Power = bits 10:1 in our encoding)
assume instr[10:1] == 274;

// Extract fields (for documentation/debugging, not functionally used)
rs = instr[25:21];      // RS field (LPID for hypervisor mode)
rb = instr[20:16];      // RB field (VA/selector)
ric = instr[13:12];     // RIC - Radix Invalidation Control
prs = instr[11];        // PRS - Process Scoped
r_bit = instr[10];      // R - Radix mode (should be 1 for Radix MMU)

// No-op for implementation without TLB cache
// In a real implementation, this would invalidate the TLB entry
// matching the virtual address in RB with the specified scope

pc = pc + 4;
