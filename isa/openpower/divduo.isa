// SPDX-License-Identifier: BSD-3-Clause
// OpenPOWER divduo - Divide Doubleword Unsigned with Overflow (XO-Form)
// divduo RT,RA,RB
// Primary opcode 31, XO=457, OE=1
// RT <- (RA) / (RB) (unsigned 64-bit)
// Overflow on divide by zero

isa_state pc[63:0];
var instr[31:0];
isa_state rf[63:0][4:0];
isa_state xer[63:0];
// XER bits:
// XER[32] = SO (Summary Overflow) - sticky
// XER[33] = OV (Overflow)
mem umem[14:0];

var rt[4:0];
var ra[4:0];
var rb[4:0];
var ra_val[63:0];
var rb_val[63:0];
var result[63:0];
var overflow[0:0];

#ifdef VM
aspect mmu.isa gates pc, msr, srr0, srr1;
instr = umem[pc_pa];
#else
instr = umem[pc];
#endif
// Primary opcode 31
assume instr[31:26] == 31;
// XO field = 457
assume instr[9:1] == 457;
// OE bit = 1 (overflow enable)
assume instr[10] == 1;
// Rc bit = 0
assume instr[0] == 0;

// Extract register fields
rt = instr[25:21];
ra = instr[20:16];
rb = instr[15:11];

ra_val = rf[ra];
rb_val = rf[rb];

// Overflow condition: divide by zero
overflow = (rb_val == 64'h0);

// Perform unsigned division (result undefined on overflow)
result = ra_val / rb_val;

// Update XER overflow bits
xer[33] = overflow;           // OV
xer[32] = xer[32] | overflow; // SO (sticky)

#ifdef VM
rf[rt] when (~instr_trap_taken) = result;
#else
rf[rt] = result;
#endif
pc = pc + 4;
