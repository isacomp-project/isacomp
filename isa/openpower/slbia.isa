// SPDX-License-Identifier: BSD-3-Clause
// OpenPOWER slbia - SLB Invalidate All (X-Form)
// slbia IH
// Primary opcode 31, XO=498
// Invalidates all Segment Lookaside Buffer entries
//
// For Radix MMU implementation, this is a no-op.
// SLB is only used with Hash Page Table (HPT) mode, not Radix.
// Microwatt implements Radix-only, so SLB instructions are no-ops.
//
// Encoding:
//   Bits 6-8: IH (Invalidation Handle, specifies scope)
//   Bits 9-20: Reserved
//   Bits 21-30: XO = 498
//   Bit 31: Reserved
//
// IH values:
//   000 = All SLB entries except SLB[0]
//   001 = All SLB entries
//   010 = Only entries where C=0
//   011 = All entries where C=0, including SLB[0]
//   1xx = Reserved

isa_state pc[63:0];
var instr[31:0];
isa_state rf[63:0][4:0];
mem umem[14:0];

var ih[2:0];

#ifdef VM
aspect mmu.isa gates pc, msr, srr0, srr1;
instr = umem[pc_pa];
#else
instr = umem[pc];
#endif
// Primary opcode 31
assume instr[31:26] == 31;
// XO field = 498
assume instr[10:1] == 498;

// Extract IH field (bits 6-8 in Power = bits 25:23 in our encoding)
ih = instr[25:23];

// No-op for Radix MMU implementation (SLB not used)
// In HPT mode: would invalidate all SLB entries per IH scope

pc = pc + 4;
