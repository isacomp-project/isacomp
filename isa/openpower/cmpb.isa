// SPDX-License-Identifier: BSD-3-Clause
// OpenPOWER cmpb - Compare Bytes (X-Form)
// cmpb RA,RS,RB (assembly syntax: destination first)
// Primary opcode 31, XO=508
// Each byte of RS is compared with corresponding byte of RB
// If equal, corresponding byte of RA is 0xFF, else 0x00

isa_state pc[63:0];
var instr[31:0];
isa_state rf[63:0][4:0];
mem umem[14:0];

var rs[4:0];
var ra[4:0];
var rb[4:0];
var rs_val[63:0];
var rb_val[63:0];
var result[63:0];
var byte0_eq[0:0];
var byte1_eq[0:0];
var byte2_eq[0:0];
var byte3_eq[0:0];
var byte4_eq[0:0];
var byte5_eq[0:0];
var byte6_eq[0:0];
var byte7_eq[0:0];

#ifdef VM
aspect mmu.isa gates pc, msr, srr0, srr1;
instr = umem[pc_pa];
#else
instr = umem[pc];
#endif
// Primary opcode 31
assume instr[31:26] == 31;
// XO field = 508
assume instr[10:1] == 508;

// Extract register fields (note: RS is in RT position for X-form stores)
rs = instr[25:21];
ra = instr[20:16];
rb = instr[15:11];

rs_val = rf[rs];
rb_val = rf[rb];

// Compare each byte of RS with RB
byte0_eq = rs_val[7:0] == rb_val[7:0];
byte1_eq = rs_val[15:8] == rb_val[15:8];
byte2_eq = rs_val[23:16] == rb_val[23:16];
byte3_eq = rs_val[31:24] == rb_val[31:24];
byte4_eq = rs_val[39:32] == rb_val[39:32];
byte5_eq = rs_val[47:40] == rb_val[47:40];
byte6_eq = rs_val[55:48] == rb_val[55:48];
byte7_eq = rs_val[63:56] == rb_val[63:56];

// Build result: 0xFF for equal bytes, 0x00 for unequal
result = {
    byte7_eq ? 8'hFF : 8'h00,
    byte6_eq ? 8'hFF : 8'h00,
    byte5_eq ? 8'hFF : 8'h00,
    byte4_eq ? 8'hFF : 8'h00,
    byte3_eq ? 8'hFF : 8'h00,
    byte2_eq ? 8'hFF : 8'h00,
    byte1_eq ? 8'hFF : 8'h00,
    byte0_eq ? 8'hFF : 8'h00
};

#ifdef VM
rf[ra] when (~instr_trap_taken) = result;
#else
rf[ra] = result;
#endif
pc = pc + 4;
