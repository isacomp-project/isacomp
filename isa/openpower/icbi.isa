// SPDX-License-Identifier: BSD-3-Clause
// OpenPOWER icbi - Instruction Cache Block Invalidate (X-Form)
// icbi RA,RB
// Primary opcode 31, XO=982
// Invalidates the instruction cache block containing EA.
// Required after writing code to memory (self-modifying code)
// to ensure instruction fetch sees the updated instructions.
// if RA = 0 then b <- 0 else b <- (RA)
// EA <- b + (RB)
// Invalidate instruction cache block containing EA
//
// For RTL implementations without cache: This is a no-op but must
// still decode correctly for program correctness. Many operating
// systems (including Linux) use icbi during dynamic loading and
// JIT compilation.

isa_state pc[63:0];
var instr[31:0];
isa_state rf[63:0][4:0];
mem umem[14:0];

var ra[4:0];
var rb[4:0];
var ra_val[63:0];
var rb_val[63:0];
var ra_or_zero[63:0];
var ea[63:0];

#ifdef VM
aspect mmu.isa gates pc, msr, srr0, srr1;
instr = umem[pc_pa];
#else
instr = umem[pc];
#endif
// Primary opcode 31
assume instr[31:26] == 31;
// XO field = 982
assume instr[10:1] == 982;

// Extract register fields
ra = instr[20:16];
rb = instr[15:11];

ra_val = rf[ra];
rb_val = rf[rb];

// If RA=0, use 0; otherwise use (RA)
ra_or_zero = ra == 0 ? 64'h0 : ra_val;

// Calculate effective address
ea = ra_or_zero + rb_val;

// No-op for implementations without cache
// Just advance PC
pc = pc + 4;
