// SPDX-License-Identifier: BSD-3-Clause
// OpenPOWER nego - Negate with Overflow (XO-Form)
// nego RT,RA
// Primary opcode 31, XO=104, OE=1
// RT <- ~(RA) + 1, updates XER[OV,SO]
// Overflow only when RA = 0x8000000000000000 (most negative value)

isa_state pc[63:0];
var instr[31:0];
isa_state rf[63:0][4:0];
isa_state xer[63:0];
// XER bits:
// XER[32] = SO (Summary Overflow) - sticky
// XER[33] = OV (Overflow)
mem umem[14:0];

var rt[4:0];
var ra[4:0];
var ra_val[63:0];
var result[63:0];
var overflow[0:0];

#ifdef VM
aspect mmu.isa gates pc, msr, srr0, srr1;
instr = umem[pc_pa];
#else
instr = umem[pc];
#endif
// Primary opcode 31
assume instr[31:26] == 31;
// XO field = 104
assume instr[9:1] == 104;
// OE bit = 1 (overflow enable)
assume instr[10] == 1;
// Rc bit = 0 (no record)
assume instr[0] == 0;

// Extract register fields
rt = instr[25:21];
ra = instr[20:16];

ra_val = rf[ra];

// Negate: ~(RA) + 1
result = ~ra_val + 64'h1;

// Overflow only when negating most negative value (0x8000000000000000)
// because -(-2^63) = 2^63 which doesn't fit in signed 64-bit
overflow = (ra_val == 64'h8000000000000000);

// Update XER overflow bits
xer[33] = overflow;           // OV
xer[32] = xer[32] | overflow; // SO (sticky)

#ifdef VM
rf[rt] when (~instr_trap_taken) = result;
#else
rf[rt] = result;
#endif
pc = pc + 4;
