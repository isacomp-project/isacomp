// SPDX-License-Identifier: BSD-3-Clause
// OpenPOWER mtcrf - Move To Condition Register Fields (XFX-Form)
// mtcrf FXM,RS
// Primary opcode 31, XO=144
// Moves fields from RS to CR based on FXM mask

isa_state pc[63:0];
var instr[31:0];
isa_state rf[63:0][4:0];
mem umem[14:0];
isa_state cr[31:0];

var rs[4:0];
var fxm[7:0];
var rs_val[63:0];
var mask[31:0];
var new_cr[31:0];

#ifdef VM
aspect mmu.isa gates pc, msr, srr0, srr1;
instr = umem[pc_pa];
#else
instr = umem[pc];
#endif
// Primary opcode 31
assume instr[31:26] == 31;
// XO field = 144
assume instr[10:1] == 144;

// Extract fields
rs = instr[25:21];
fxm = instr[19:12];

rs_val = rf[rs];

// Build mask from FXM (each bit selects a 4-bit CR field)
// In PowerPC, FXM bit 0 (MSB in the encoding) selects CR0
// fxm[7] is the MSB in Verilog, so fxm[7] selects CR0
mask = {
    fxm[7] ? 4'hF : 4'h0,
    fxm[6] ? 4'hF : 4'h0,
    fxm[5] ? 4'hF : 4'h0,
    fxm[4] ? 4'hF : 4'h0,
    fxm[3] ? 4'hF : 4'h0,
    fxm[2] ? 4'hF : 4'h0,
    fxm[1] ? 4'hF : 4'h0,
    fxm[0] ? 4'hF : 4'h0
};

// Update CR fields selected by mask
new_cr = (cr & ~mask) | (rs_val[31:0] & mask);
cr = new_cr;

pc = pc + 4;
