// SPDX-License-Identifier: BSD-3-Clause
// OpenPOWER rldic - Rotate Left Doubleword Immediate then Clear (MD-Form)
// rldic rA, rS, sh, mb
// Primary opcode 30, MD-form (XO bits 2:1 = 10 = 2)
// n <- sh; r <- ROTL64(rS, n); b <- mb; m <- MASK(b, 63-n); rA <- r & m
// Clears bits outside the range [mb, 63-sh]

isa_state pc[63:0];
var instr[31:0];
isa_state rf[63:0][4:0];
mem umem[14:0];

var rs[4:0];
var ra[4:0];
var sh[5:0];
var mb[5:0];
var rs_val[63:0];
var rotated[63:0];
var mask_end[5:0];
var result[63:0];

#ifdef VM
aspect mmu.isa gates pc, msr, srr0, srr1;
instr = umem[pc_pa];
#else
instr = umem[pc];
#endif
// Primary opcode 30
assume instr[31:26] == 30;
// MD-form with XO bits 4:2 = 010 (2) for rldic
assume instr[4:2] == 2;
// Rc = 0 (non-recording form)
assume instr[0] == 0;

// Extract fields
rs = instr[25:21];
ra = instr[20:16];
// sh = sh5 (bit 1) || sh0:4 (bits 15:11)
sh = {instr[1], instr[15:11]};
// mb = mb5 (bit 5) || mb0:4 (bits 10:6)
mb = {instr[5], instr[10:6]};

// Read register
rs_val = rf[rs];

// Rotate left by sh
rotated = sh[5:0] == 0 ? rs_val : ((rs_val << sh) | (rs_val >> (64 - sh)));

// MASK(mb, 63-sh) - mask from mb to (63-sh)
// mask_end = 63 - sh
mask_end = 63 - sh;

// Generate mask: bits from mb to mask_end are 1
// Since mb <= mask_end in typical usage (otherwise result would be 0 or wrapped)
result = mask_end >= mb ?
    (rotated & ((64'hFFFFFFFFFFFFFFFF >> mb) & ~(64'hFFFFFFFFFFFFFFFF >> (mask_end + 1)))) :
    (rotated & ((64'hFFFFFFFFFFFFFFFF >> mb) | ~(64'hFFFFFFFFFFFFFFFF >> (mask_end + 1))));

// Write result
#ifdef VM
rf[ra] when (~instr_trap_taken) = result;
#else
rf[ra] = result;
#endif

pc = pc + 4;
