// SPDX-License-Identifier: BSD-3-Clause
// OpenPOWER lhax - Load Halfword Algebraic Indexed (X-Form)
// lhax RT,RA,RB
// Primary opcode 31, XO=343
// if RA = 0 then b <- 0 else b <- (RA)
// EA <- b + (RB)
// RT <- EXTS(MEM(EA, 2))

isa_state pc[63:0];
var instr[31:0];
isa_state rf[63:0][4:0];
mem umem[14:0];

var rt[4:0];
var ra[4:0];
var rb[4:0];
var ra_val[63:0];
var rb_val[63:0];
var ra_or_zero[63:0];
var ea[63:0];
var hword_data[15:0];
var result[63:0];

#ifdef VM
aspect mmu.isa gates pc, msr, srr0, srr1;
instr = umem[pc_pa];
#else
instr = umem[pc];
#endif
// Primary opcode 31
assume instr[31:26] == 31;
// XO field = 343
assume instr[10:1] == 343;

// Extract register fields
rt = instr[25:21];
ra = instr[20:16];
rb = instr[15:11];

ra_val = rf[ra];
rb_val = rf[rb];

// If RA=0, use 0; otherwise use (RA)
ra_or_zero = ra == 0 ? 64'h0 : ra_val;

// Calculate effective address
ea = ra_or_zero + rb_val;

// Load halfword from memory
#ifdef VM
aspect mmu_load.isa gates pc, msr, srr0, srr1, dar, dsisr;
hword_data = umem[ea_pa];
#else
hword_data = umem[ea];
#endif

// Sign-extend to 64 bits
result = {{48{hword_data[15]}}, hword_data};

#ifdef VM
rf[rt] when (~load_exception_taken & ~instr_trap_taken) = result;
#else
rf[rt] = result;
#endif
pc = pc + 4;
