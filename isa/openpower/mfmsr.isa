// SPDX-License-Identifier: BSD-3-Clause
// OpenPOWER mfmsr - Move From Machine State Register (X-Form)
// mfmsr RT
// Primary opcode 31, XO=83
// RT <- MSR
// Privileged instruction - reads current Machine State Register
// Note: Power ISA uses MSB-first bit numbering (bit 0 is leftmost)
// Verilog uses LSB-first (bit 31 is leftmost for 32-bit word)

isa_state pc[63:0];
var instr[31:0];
isa_state rf[63:0][4:0];
mem umem[14:0];
isa_state msr[63:0];

var rt[4:0];

#ifdef VM
aspect mmu.isa gates pc, msr, srr0, srr1;
instr = umem[pc_pa];
#else
instr = umem[pc];
#endif
// Primary opcode 31
assume instr[31:26] == 31;
// XO field = 83
assume instr[10:1] == 83;

// Extract RT field
rt = instr[25:21];  // Power bits 6:10

// Move MSR to RT
#ifdef VM
rf[rt] when (~instr_trap_taken) = msr;
#else
rf[rt] = msr;
#endif

pc = pc + 4;
