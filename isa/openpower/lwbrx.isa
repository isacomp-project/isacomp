// SPDX-License-Identifier: BSD-3-Clause
// OpenPOWER lwbrx - Load Word Byte-Reverse Indexed (X-Form)
// lwbrx RT,RA,RB
// Primary opcode 31, XO=534
// if RA = 0 then b <- 0 else b <- (RA)
// EA <- b + (RB)
// Load 4 bytes, reverse byte order, zero-extend to 64 bits
// RT <- 0x0000_0000 || BYTE_REVERSE(MEM(EA, 4))

isa_state pc[63:0];
var instr[31:0];
isa_state rf[63:0][4:0];
mem umem[14:0];

var rt[4:0];
var ra[4:0];
var rb[4:0];
var ra_val[63:0];
var rb_val[63:0];
var ra_or_zero[63:0];
var ea[63:0];
var word_data[31:0];
var reversed[31:0];
var result[63:0];

#ifdef VM
aspect mmu.isa gates pc, msr, srr0, srr1;
instr = umem[pc_pa];
#else
instr = umem[pc];
#endif
// Primary opcode 31
assume instr[31:26] == 31;
// XO field = 534
assume instr[10:1] == 534;

// Extract register fields
rt = instr[25:21];
ra = instr[20:16];
rb = instr[15:11];

ra_val = rf[ra];
rb_val = rf[rb];

// If RA=0, use 0; otherwise use (RA)
ra_or_zero = ra == 0 ? 64'h0 : ra_val;

// Calculate effective address
ea = ra_or_zero + rb_val;

// Load word from memory
#ifdef VM
aspect mmu_load.isa gates pc, msr, srr0, srr1, dar, dsisr;
word_data = umem[ea_pa];
#else
word_data = umem[ea];
#endif

// Reverse bytes: [b0, b1, b2, b3] -> [b3, b2, b1, b0]
reversed = {word_data[7:0], word_data[15:8], word_data[23:16], word_data[31:24]};

// Zero-extend to 64 bits
result = {32'h0, reversed};

#ifdef VM
rf[rt] when (~load_exception_taken & ~instr_trap_taken) = result;
#else
rf[rt] = result;
#endif
pc = pc + 4;
