// SPDX-License-Identifier: BSD-3-Clause
// OpenPOWER mtspr SPRG1 - Move To SPR General 1
// mtspr 273,RS (SPR 273 = SPRG1)
// Primary opcode 31, XO=467

isa_state pc[63:0];
var instr[31:0];
isa_state rf[63:0][4:0];
mem umem[14:0];
isa_state sprg1[63:0];

var rs[4:0];
var rs_val[63:0];

#ifdef VM
aspect mmu.isa gates pc, msr, srr0, srr1;
instr = umem[pc_pa];
#else
instr = umem[pc];
#endif
assume instr[31:26] == 31;
assume instr[10:1] == 467;
// SPR field for SPRG1 (SPR 273): spr_hi=8, spr_lo=17
assume instr[15:11] == 8;
assume instr[20:16] == 17;

rs = instr[25:21];
rs_val = rf[rs];
sprg1 = rs_val;

pc = pc + 4;
