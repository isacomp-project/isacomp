// SPDX-License-Identifier: BSD-3-Clause
// OpenPOWER cntlzd. - Count Leading Zeros Doubleword and Record (X-Form)
// cntlzd. RA,RS
// Primary opcode 31, XO=58, Rc=1
// RA <- count of leading zeros in (RS)[0:63]
// Updates CR0

isa_state pc[63:0];
var instr[31:0];
isa_state rf[63:0][4:0];
mem umem[14:0];
isa_state cr[31:0];

var rs[4:0];
var ra[4:0];
var rs_val[63:0];
var count[7:0];
var result[63:0];
var new_cr[31:0];

#ifdef VM
aspect mmu.isa gates pc, msr, srr0, srr1;
instr = umem[pc_pa];
#else
instr = umem[pc];
#endif
// Primary opcode 31
assume instr[31:26] == 31;
// XO field = 58
assume instr[10:1] == 58;
// Rc bit = 1
assume instr[0] == 1;

// Extract register fields
rs = instr[25:21];
ra = instr[20:16];

rs_val = rf[rs];

// Count leading zeros using cascaded conditionals
count = rs_val[63] ? 8'd0 :
        rs_val[62] ? 8'd1 :
        rs_val[61] ? 8'd2 :
        rs_val[60] ? 8'd3 :
        rs_val[59] ? 8'd4 :
        rs_val[58] ? 8'd5 :
        rs_val[57] ? 8'd6 :
        rs_val[56] ? 8'd7 :
        rs_val[55] ? 8'd8 :
        rs_val[54] ? 8'd9 :
        rs_val[53] ? 8'd10 :
        rs_val[52] ? 8'd11 :
        rs_val[51] ? 8'd12 :
        rs_val[50] ? 8'd13 :
        rs_val[49] ? 8'd14 :
        rs_val[48] ? 8'd15 :
        rs_val[47] ? 8'd16 :
        rs_val[46] ? 8'd17 :
        rs_val[45] ? 8'd18 :
        rs_val[44] ? 8'd19 :
        rs_val[43] ? 8'd20 :
        rs_val[42] ? 8'd21 :
        rs_val[41] ? 8'd22 :
        rs_val[40] ? 8'd23 :
        rs_val[39] ? 8'd24 :
        rs_val[38] ? 8'd25 :
        rs_val[37] ? 8'd26 :
        rs_val[36] ? 8'd27 :
        rs_val[35] ? 8'd28 :
        rs_val[34] ? 8'd29 :
        rs_val[33] ? 8'd30 :
        rs_val[32] ? 8'd31 :
        rs_val[31] ? 8'd32 :
        rs_val[30] ? 8'd33 :
        rs_val[29] ? 8'd34 :
        rs_val[28] ? 8'd35 :
        rs_val[27] ? 8'd36 :
        rs_val[26] ? 8'd37 :
        rs_val[25] ? 8'd38 :
        rs_val[24] ? 8'd39 :
        rs_val[23] ? 8'd40 :
        rs_val[22] ? 8'd41 :
        rs_val[21] ? 8'd42 :
        rs_val[20] ? 8'd43 :
        rs_val[19] ? 8'd44 :
        rs_val[18] ? 8'd45 :
        rs_val[17] ? 8'd46 :
        rs_val[16] ? 8'd47 :
        rs_val[15] ? 8'd48 :
        rs_val[14] ? 8'd49 :
        rs_val[13] ? 8'd50 :
        rs_val[12] ? 8'd51 :
        rs_val[11] ? 8'd52 :
        rs_val[10] ? 8'd53 :
        rs_val[9] ? 8'd54 :
        rs_val[8] ? 8'd55 :
        rs_val[7] ? 8'd56 :
        rs_val[6] ? 8'd57 :
        rs_val[5] ? 8'd58 :
        rs_val[4] ? 8'd59 :
        rs_val[3] ? 8'd60 :
        rs_val[2] ? 8'd61 :
        rs_val[1] ? 8'd62 :
        rs_val[0] ? 8'd63 : 8'd64;

// Zero-extend to 64 bits
result = {56'h0, count};

// Update CR0: LT=0 (result is always positive), GT=(count<64), EQ=(count==64), SO=0
var cr0[3:0];
cr0[3] = 1'b0;  // LT
cr0[2] = (count == 64) ? 1'b0 : 1'b1;  // GT
cr0[1] = (count == 64) ? 1'b1 : 1'b0;  // EQ
cr0[0] = cr[0];  // SO (copy from XER, simplified to keep existing CR[SO])

new_cr = {cr0, cr[27:0]};
cr = new_cr;

#ifdef VM
rf[ra] when (~instr_trap_taken) = result;
#else
rf[ra] = result;
#endif
pc = pc + 4;
