// SPDX-License-Identifier: BSD-3-Clause
// OpenPOWER addic - Add Immediate Carrying (D-Form)
// addic RT,RA,SI
// Primary opcode 12
// RT <- (RA) + EXTS(SI)
// CA <- carry out

isa_state pc[63:0];
var instr[31:0];
isa_state rf[63:0][4:0];
mem umem[14:0];
isa_state xer[63:0];
// XER bits:
// XER[32] = SO (Summary Overflow)
// XER[33] = OV (Overflow)
// XER[34] = CA (Carry)
// XER[44] = OV32 (32-bit overflow, Power ISA 3.0)
// XER[45] = CA32 (32-bit carry, Power ISA 3.0)

var rt[4:0];
var ra[4:0];
var si[15:0];
var ra_val[63:0];
var sign_ext_si[63:0];
var sum[64:0];
var result[63:0];
var carry[0:0];

#ifdef VM
aspect mmu.isa gates pc, msr, srr0, srr1;
instr = umem[pc_pa];
#else
instr = umem[pc];
#endif
// Primary opcode 12 in bits 31:26
assume instr[31:26] == 12;

// Extract fields
rt = instr[25:21];
ra = instr[20:16];
si = instr[15:0];

// Sign-extend SI to 64 bits
sign_ext_si = {{48{si[15]}}, si};
ra_val = rf[ra];

// 65-bit addition to capture carry
sum = {1'b0, ra_val} + {1'b0, sign_ext_si};
result = sum[63:0];
carry = sum[64];

#ifdef VM
rf[rt] when (~instr_trap_taken) = result;
#else
rf[rt] = result;
#endif
xer[34] = carry;  // CA bit
pc = pc + 4;
