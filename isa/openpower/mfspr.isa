// SPDX-License-Identifier: BSD-3-Clause
// OpenPOWER mfspr - Move From Special Purpose Register (XFX-Form)
// mfspr RT,SPR
// Primary opcode 31, XO=339
// RT <- SPR
// Note: This is a simplified version handling LR and CTR

isa_state pc[63:0];
var instr[31:0];
isa_state rf[63:0][4:0];
mem umem[14:0];
isa_state lr[63:0];
isa_state ctr[63:0];

var rt[4:0];
var spr[9:0];
var spr_lo[4:0];
var spr_hi[4:0];
var result[63:0];

#ifdef VM
aspect mmu.isa gates pc, msr, srr0, srr1;
instr = umem[pc_pa];
#else
instr = umem[pc];
#endif
// Primary opcode 31
assume instr[31:26] == 31;
// XO field = 339
assume instr[10:1] == 339;

// Extract fields
rt = instr[25:21];
// SPR field is split: spr[4:0] in bits 20:16, spr[9:5] in bits 15:11
spr_lo = instr[20:16];
spr_hi = instr[15:11];
spr = {spr_hi, spr_lo};

// Read SPR based on SPR number
// SPR 8 = LR, SPR 9 = CTR
result = spr == 10'h8 ? lr : (spr == 10'h9 ? ctr : 64'h0);

#ifdef VM
rf[rt] when (~instr_trap_taken) = result;
#else
rf[rt] = result;
#endif
pc = pc + 4;
