// SPDX-License-Identifier: BSD-3-Clause
// OpenPOWER mtspr LR - Move To Link Register
// mtlr RS  (mtspr 8,RS)
// Primary opcode 31, XO=467, SPR=8
// LR <- (RS)

isa_state pc[63:0];
var instr[31:0];
isa_state rf[63:0][4:0];
mem umem[14:0];
isa_state lr[63:0];

var rs[4:0];

#ifdef VM
aspect mmu.isa gates pc, msr, srr0, srr1;
instr = umem[pc_pa];
#else
instr = umem[pc];
#endif
assume instr[31:26] == 31;
assume instr[10:1] == 467;
// SPR field for LR (SPR 8): spr_hi=0, spr_lo=8
assume instr[15:11] == 0;
assume instr[20:16] == 8;

rs = instr[25:21];
lr = rf[rs];

pc = pc + 4;
