// SPDX-License-Identifier: BSD-3-Clause
// OpenPOWER rldicr - Rotate Left Doubleword Immediate then Clear Right (MD-Form)
// rldicr rA, rS, sh, me
// Extended mnemonic: sldi rA, rS, n = rldicr rA, rS, n, 63-n
// Primary opcode 30, MD-form (XO bits 2:4 = 001)
// Pseudo-code: n <- sh; r <- ROTL64(RS, n); m <- MASK(0, me); RA <- r & m

isa_state pc[63:0];
var instr[31:0];
isa_state rf[63:0][4:0];
mem umem[14:0];

var rs[4:0];
var ra[4:0];
var sh[5:0];
var me[5:0];
var rs_val[63:0];
var rotated[63:0];
var clear_bits[5:0];
var result[63:0];

#ifdef VM
aspect mmu.isa gates pc, msr, srr0, srr1;
instr = umem[pc_pa];
#else
instr = umem[pc];
#endif
// Primary opcode 30
assume instr[31:26] == 30;
// MD-form with XO bits 2:4 = 001 (rldicr)
assume instr[4:2] == 1;
// Rc = 0 (non-recording form)
assume instr[0] == 0;

// Extract fields
rs = instr[25:21];
ra = instr[20:16];
// sh = sh5 (bit 1) || sh0:4 (bits 15:11) - 6 bit shift amount
sh = {instr[1], instr[15:11]};
// me = me5 (bit 5) || me0:4 (bits 10:6) - mask end position
me = {instr[5], instr[10:6]};

// Read source register
rs_val = rf[rs];

// Rotate left by sh bits
rotated = (rs_val << sh) | (rs_val >> (64 - sh));

// MASK(0, me) clears bits (me+1) through 63
// Number of bits to clear on the right = 63 - me
clear_bits = 63 - me;

// Clear the rightmost (63-me) bits by shifting right then left
result = (rotated >> clear_bits) << clear_bits;

#ifdef VM
rf[ra] when (~instr_trap_taken) = result;
#else
rf[ra] = result;
#endif
pc = pc + 4;
