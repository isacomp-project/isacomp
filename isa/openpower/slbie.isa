// SPDX-License-Identifier: BSD-3-Clause
// OpenPOWER slbie - SLB Invalidate Entry (X-Form)
// slbie RB
// Primary opcode 31, XO=434
// Invalidates a single Segment Lookaside Buffer entry
//
// For Radix MMU implementation, this is a no-op.
// SLB is only used with Hash Page Table (HPT) mode, not Radix.
// Microwatt implements Radix-only, so SLB instructions are no-ops.
//
// Encoding:
//   Bits 6-10: Reserved (should be 0)
//   Bits 11-15: Reserved (should be 0)
//   Bits 16-20: RB (contains ESID to invalidate)
//   Bits 21-30: XO = 434
//   Bit 31: Reserved
//
// The entry to invalidate is selected by matching the ESID
// (Effective Segment ID) in RB against SLB entries.

isa_state pc[63:0];
var instr[31:0];
isa_state rf[63:0][4:0];
mem umem[14:0];

var rb[4:0];
var rb_val[63:0];

#ifdef VM
aspect mmu.isa gates pc, msr, srr0, srr1;
instr = umem[pc_pa];
#else
instr = umem[pc];
#endif
// Primary opcode 31
assume instr[31:26] == 31;
// XO field = 434
assume instr[10:1] == 434;

// Extract RB field
rb = instr[20:16];
rb_val = rf[rb];

// No-op for Radix MMU implementation (SLB not used)
// In HPT mode: would invalidate SLB entry matching ESID in RB

pc = pc + 4;
