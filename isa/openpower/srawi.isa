// SPDX-License-Identifier: BSD-3-Clause
// OpenPOWER srawi - Shift Right Algebraic Word Immediate (X-Form)
// srawi RA,RS,SH
// Primary opcode 31, XO=824
// n <- SH
// r <- ROTL32((RS)[32:63], 64-n)
// m <- MASK(n+32, 63)
// s <- (RS)[32]
// RA <- r & m | ~m & s*64
// CA <- s & ((r & ~m) != 0)

isa_state pc[63:0];
var instr[31:0];
isa_state rf[63:0][4:0];
mem umem[14:0];
isa_state xer[63:0];

var rs[4:0];
var ra[4:0];
var sh[4:0];
var rs_val[63:0];
var word_val[31:0];
var sign_bit[0:0];
var shifted[31:0];
var result[63:0];

#ifdef VM
aspect mmu.isa gates pc, msr, srr0, srr1;
instr = umem[pc_pa];
#else
instr = umem[pc];
#endif
// Primary opcode 31
assume instr[31:26] == 31;
// XO field = 824
assume instr[10:1] == 824;
// Rc bit = 0
assume instr[0] == 0;

// Extract register fields
rs = instr[25:21];
ra = instr[20:16];
sh = instr[15:11];

rs_val = rf[rs];

// Get low 32 bits of RS
word_val = rs_val[31:0];
sign_bit = word_val[31];

// Arithmetic shift right by immediate amount
shifted = word_val >>> sh;

// Sign-extend result to 64 bits
result = {{32{shifted[31]}}, shifted};

// CA is set if negative and any 1-bits were shifted out
xer[34] = sign_bit & ((word_val << (32 - sh)) != 0);

#ifdef VM
rf[ra] when (~instr_trap_taken) = result;
#else
rf[ra] = result;
#endif
pc = pc + 4;
