// SPDX-License-Identifier: BSD-3-Clause
// OpenPOWER lbzu - Load Byte and Zero with Update (D-Form)
// lbzu RT,D(RA)
// Primary opcode 35
// EA <- (RA) + EXTS(D)
// RT <- 0x00_0000_0000_0000 || MEM(EA, 1)
// RA <- EA
// Note: RA cannot be 0 or RT

isa_state pc[63:0];
var instr[31:0];
isa_state rf[63:0][4:0];
mem umem[14:0];

var rt[4:0];
var ra[4:0];
var d[15:0];
var ra_val[63:0];
var sign_ext_d[63:0];
var ea[63:0];
var byte_data[7:0];
var result[63:0];

#ifdef VM
aspect mmu.isa gates pc, msr, srr0, srr1;
instr = umem[pc_pa];
#else
instr = umem[pc];
#endif
// Primary opcode 35
assume instr[31:26] == 35;

// Extract fields
rt = instr[25:21];
ra = instr[20:16];
d = instr[15:0];

// RA cannot be 0 for update forms
assume ra != 0;
// RA cannot equal RT (would overwrite source)

// Sign-extend displacement
sign_ext_d = {{48{d[15]}}, d};

// Get RA value (no special case for 0 in update forms)
ra_val = rf[ra];

// Calculate effective address
ea = ra_val + sign_ext_d;

// Load byte from memory
#ifdef VM
aspect mmu_load.isa gates pc, msr, srr0, srr1, dar, dsisr;
byte_data = umem[ea_pa];
#else
byte_data = umem[ea];
#endif

// Zero-extend to 64 bits
result = {56'h0, byte_data};

// Update RT and RA
#ifdef VM
rf[rt] when (~load_exception_taken & ~instr_trap_taken) = result;
#else
rf[rt] = result;
#endif
#ifdef VM
rf[ra] when (~load_exception_taken & ~instr_trap_taken) = ea;
#else
rf[ra] = ea;
#endif
pc = pc + 4;
