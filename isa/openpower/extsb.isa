// SPDX-License-Identifier: BSD-3-Clause
// OpenPOWER extsb - Extend Sign Byte (X-Form)
// extsb RA,RS
// Primary opcode 31, XO=954
// RA <- EXTS(RS[56:63])

isa_state pc[63:0];
var instr[31:0];
isa_state rf[63:0][4:0];
mem umem[14:0];

var rs[4:0];
var ra[4:0];
var rs_val[63:0];
var byte_val[7:0];
var result[63:0];

#ifdef VM
aspect mmu.isa gates pc, msr, srr0, srr1;
instr = umem[pc_pa];
#else
instr = umem[pc];
#endif
// Primary opcode 31
assume instr[31:26] == 31;
// XO field = 954
assume instr[10:1] == 954;
// Rc bit = 0
assume instr[0] == 0;

// Extract register fields
rs = instr[25:21];
ra = instr[20:16];

rs_val = rf[rs];
byte_val = rs_val[7:0];

// Sign-extend byte to 64 bits
result = {{56{byte_val[7]}}, byte_val};

#ifdef VM
rf[ra] when (~instr_trap_taken) = result;
#else
rf[ra] = result;
#endif
pc = pc + 4;
