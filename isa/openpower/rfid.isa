// SPDX-License-Identifier: BSD-3-Clause
// OpenPOWER rfid - Return From Interrupt Doubleword (XL-Form)
// rfid
// Primary opcode 19, XO=18
// Restores execution state after interrupt
// MSR <- SRR1; NIA <- SRR0
// Note: Power ISA uses MSB-first bit numbering (bit 0 is leftmost)
// Verilog uses LSB-first (bit 31 is leftmost for 32-bit word)

isa_state pc[63:0];
var instr[31:0];
isa_state rf[63:0][4:0];
mem umem[14:0];
isa_state srr0[63:0];
isa_state srr1[63:0];
isa_state msr[63:0];

#ifdef VM
aspect mmu.isa gates pc, msr, srr0, srr1;
instr = umem[pc_pa];
#else
instr = umem[pc];
#endif
// Primary opcode 19 in bits 31:26 (Power bits 0:5)
assume instr[31:26] == 19;
// XO field (Power bits 21:30 = Verilog bits 10:1) = 18
assume instr[10:1] == 18;

// Restore MSR from SRR1 and PC from SRR0
msr = srr1;
pc = srr0;
