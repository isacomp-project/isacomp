// SPDX-License-Identifier: BSD-3-Clause
// OpenPOWER mtmsrd - Move To Machine State Register Doubleword (X-Form)
// mtmsrd RS,L
// Primary opcode 31, XO=178
// MSR <- (RS)
// Privileged instruction - updates 64-bit Machine State Register
// L bit controls partial update: L=1 updates only MSR[48,62] (EE,RI)
// Power ISA MSR bit 48 = EE (External Enable) = Verilog bit 15
// Power ISA MSR bit 62 = RI (Recoverable Interrupt) = Verilog bit 1

isa_state pc[63:0];
var instr[31:0];
isa_state rf[63:0][4:0];
mem umem[14:0];
isa_state msr[63:0];

var rs[4:0];
var l_bit[0:0];
var rs_val[63:0];
var msr_current[63:0];
var partial_msr[63:0];

#ifdef VM
aspect mmu.isa gates pc, msr, srr0, srr1;
instr = umem[pc_pa];
#else
instr = umem[pc];
#endif
// Primary opcode 31
assume instr[31:26] == 31;
// XO field = 178
assume instr[10:1] == 178;

// Extract fields
rs = instr[25:21];    // Power bits 6:10
l_bit = instr[16];    // Power bit 15 (L field)

rs_val = rf[rs];

// Read current MSR for partial update
msr_current = msr;

// L=1: only update EE (bit 15) and RI (bit 1), preserve all other bits
// L=0: full 64-bit update
partial_msr = {msr_current[63:16], rs_val[15], msr_current[14:2], rs_val[1], msr_current[0]};
msr = l_bit ? partial_msr : rs_val;

pc = pc + 4;
