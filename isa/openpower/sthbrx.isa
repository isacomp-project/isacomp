// SPDX-License-Identifier: BSD-3-Clause
// OpenPOWER sthbrx - Store Halfword Byte-Reverse Indexed (X-Form)
// sthbrx RS,RA,RB
// Primary opcode 31, XO=918
// if RA = 0 then b <- 0 else b <- (RA)
// EA <- b + (RB)
// Take low 16 bits of RS, reverse bytes, store
// MEM(EA, 2) <- BYTE_REVERSE((RS)[48:63])

isa_state pc[63:0];
var instr[31:0];
isa_state rf[63:0][4:0];
mem umem[14:0];

var rs[4:0];
var ra[4:0];
var rb[4:0];
var rs_val[63:0];
var ra_val[63:0];
var rb_val[63:0];
var ra_or_zero[63:0];
var ea[63:0];
var half_data[15:0];
var reversed[15:0];

#ifdef VM
aspect mmu.isa gates pc, msr, srr0, srr1;
instr = umem[pc_pa];
#else
instr = umem[pc];
#endif
// Primary opcode 31
assume instr[31:26] == 31;
// XO field = 918
assume instr[10:1] == 918;

// Extract register fields
rs = instr[25:21];
ra = instr[20:16];
rb = instr[15:11];

ra_val = rf[ra];
rb_val = rf[rb];

// If RA=0, use 0; otherwise use (RA)
ra_or_zero = ra == 0 ? 64'h0 : ra_val;

// Calculate effective address
ea = ra_or_zero + rb_val;

// Get halfword to store (low 16 bits)
rs_val = rf[rs];
half_data = rs_val[15:0];

// Reverse bytes: [byte0, byte1] -> [byte1, byte0]
reversed = {half_data[7:0], half_data[15:8]};

// Store reversed halfword to memory
#ifdef VM
aspect mmu_store.isa gates pc, msr, srr0, srr1, dar, dsisr;
umem[ea_pa] when (~store_exception_taken & ~instr_trap_taken) = reversed;
#else
umem[ea] = reversed;
#endif
pc = pc + 4;
