// SPDX-License-Identifier: BSD-3-Clause
// OpenPOWER stbx - Store Byte Indexed (X-Form)
// stbx RS,RA,RB
// Primary opcode 31, XO=215
// if RA = 0 then b <- 0 else b <- (RA)
// EA <- b + (RB)
// MEM(EA, 1) <- (RS)[56:63]

isa_state pc[63:0];
var instr[31:0];
isa_state rf[63:0][4:0];
mem umem[14:0];

var rs[4:0];
var ra[4:0];
var rb[4:0];
var rs_val[63:0];
var ra_val[63:0];
var rb_val[63:0];
var ra_or_zero[63:0];
var ea[63:0];
var byte_data[7:0];

#ifdef VM
aspect mmu.isa gates pc, msr, srr0, srr1;
instr = umem[pc_pa];
#else
instr = umem[pc];
#endif
// Primary opcode 31
assume instr[31:26] == 31;
// XO field = 215
assume instr[10:1] == 215;

// Extract register fields
rs = instr[25:21];
ra = instr[20:16];
rb = instr[15:11];

ra_val = rf[ra];
rb_val = rf[rb];

// If RA=0, use 0; otherwise use (RA)
ra_or_zero = ra == 0 ? 64'h0 : ra_val;

// Calculate effective address
ea = ra_or_zero + rb_val;

// Get byte to store
rs_val = rf[rs];
byte_data = rs_val[7:0];

// Store byte to memory
#ifdef VM
aspect mmu_store.isa gates pc, msr, srr0, srr1, dar, dsisr;
umem[ea_pa] when (~store_exception_taken & ~instr_trap_taken) = byte_data;
#else
umem[ea] = byte_data;
#endif
pc = pc + 4;
