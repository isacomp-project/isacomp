// SPDX-License-Identifier: BSD-3-Clause
// OpenPOWER mfspr SPRG1 - Move From SPR General 1
// mfspr RT,273 (SPR 273 = SPRG1)
// Primary opcode 31, XO=339

isa_state pc[63:0];
var instr[31:0];
isa_state rf[63:0][4:0];
mem umem[14:0];
isa_state sprg1[63:0];

var rt[4:0];
var mfspr_sprg1_result[63:0];

#ifdef VM
aspect mmu.isa gates pc, msr, srr0, srr1;
instr = umem[pc_pa];
#else
instr = umem[pc];
#endif
assume instr[31:26] == 31;
assume instr[10:1] == 339;
// SPR field for SPRG1 (SPR 273): spr_hi=8, spr_lo=17
assume instr[15:11] == 8;
assume instr[20:16] == 17;

rt = instr[25:21];
mfspr_sprg1_result = sprg1;
#ifdef VM
rf[rt] when (~instr_trap_taken) = mfspr_sprg1_result;
#else
rf[rt] = mfspr_sprg1_result;
#endif

pc = pc + 4;
