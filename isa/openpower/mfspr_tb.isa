// SPDX-License-Identifier: BSD-3-Clause
// OpenPOWER mfspr TB - Move From Time Base
// mfspr RT,268 (SPR 268 = TB)
// Primary opcode 31, XO=339

isa_state pc[63:0];
var instr[31:0];
isa_state rf[63:0][4:0];
mem umem[14:0];
isa_state tb[63:0];

var rt[4:0];
var mfspr_tb_result[63:0];

#ifdef VM
aspect mmu.isa gates pc, msr, srr0, srr1;
instr = umem[pc_pa];
#else
instr = umem[pc];
#endif
assume instr[31:26] == 31;
assume instr[10:1] == 339;
// SPR field for TB (SPR 268): spr_hi=8, spr_lo=12
assume instr[15:11] == 8;
assume instr[20:16] == 12;

rt = instr[25:21];
mfspr_tb_result = tb;
#ifdef VM
rf[rt] when (~instr_trap_taken) = mfspr_tb_result;
#else
rf[rt] = mfspr_tb_result;
#endif

pc = pc + 4;
