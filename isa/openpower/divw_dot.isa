// SPDX-License-Identifier: BSD-3-Clause
// OpenPOWER divw. - Divide Word and Record (XO-Form)
// divw. RT,RA,RB
// Primary opcode 31, XO=491, Rc=1
// RT <- (RA)[32:63] / (RB)[32:63] (signed, sign-extended), update CR0

isa_state pc[63:0];
var instr[31:0];
isa_state rf[63:0][4:0];
isa_state cr[31:0];
mem umem[14:0];

var rt[4:0];
var ra[4:0];
var rb[4:0];
var ra_val[31:0];
var rb_val[31:0];
var quotient[31:0];
var result[63:0];
var lt[0:0];
var gt[0:0];
var eq[0:0];

#ifdef VM
aspect mmu.isa gates pc, msr, srr0, srr1;
instr = umem[pc_pa];
#else
instr = umem[pc];
#endif
// Primary opcode 31
assume instr[31:26] == 31;
// XO field = 491
assume instr[9:1] == 491;
// Rc bit = 1 (record form)
assume instr[0] == 1;
// OE bit = 0
assume instr[10] == 0;

// Extract register fields
rt = instr[25:21];
ra = instr[20:16];
rb = instr[15:11];

// Get low 32 bits of each register (sign-extended)
ra_val = rf[ra][31:0];
rb_val = rf[rb][31:0];

// Divide (assuming no divide-by-zero for now)
quotient = ra_val / rb_val;

// Sign-extend quotient to 64 bits
result = {{32{quotient[31]}}, quotient};

// Update CR0 based on result
lt = result[63];
gt = ~result[63] & (result != 0);
eq = (result == 0);
cr = {lt, gt, eq, 1'b0, cr[27:0]};  // SO=0 simplified

#ifdef VM
rf[rt] when (~instr_trap_taken) = result;
#else
rf[rt] = result;
#endif
pc = pc + 4;
