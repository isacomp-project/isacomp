// SPDX-License-Identifier: BSD-3-Clause
// OpenPOWER stdux - Store Doubleword with Update Indexed (X-Form)
// stdux RS,RA,RB
// Primary opcode 31, XO=181
// EA <- (RA) + (RB)
// MEM(EA, 8) <- (RS)
// RA <- EA
// Note: RA cannot be 0

isa_state pc[63:0];
var instr[31:0];
isa_state rf[63:0][4:0];
mem umem[14:0];

var rs[4:0];
var ra[4:0];
var rb[4:0];
var rs_val[63:0];
var ra_val[63:0];
var rb_val[63:0];
var ea[63:0];

#ifdef VM
aspect mmu.isa gates pc, msr, srr0, srr1;
instr = umem[pc_pa];
#else
instr = umem[pc];
#endif
// Primary opcode 31
assume instr[31:26] == 31;
// XO field = 181
assume instr[10:1] == 181;

// Extract register fields
rs = instr[25:21];
ra = instr[20:16];
rb = instr[15:11];

// RA cannot be 0 for update forms
assume ra != 0;

ra_val = rf[ra];
rb_val = rf[rb];

// Calculate effective address
ea = ra_val + rb_val;

// Get doubleword to store
rs_val = rf[rs];

// Store doubleword to memory and update RA
#ifdef VM
aspect mmu_store.isa gates pc, msr, srr0, srr1, dar, dsisr;
umem[ea_pa] when (~store_exception_taken & ~instr_trap_taken) = rs_val;
#else
umem[ea] = rs_val;
#endif
#ifdef VM
rf[ra] when (~store_exception_taken & ~instr_trap_taken) = ea;
#else
rf[ra] = ea;
#endif
pc = pc + 4;
