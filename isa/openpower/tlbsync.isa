// SPDX-License-Identifier: BSD-3-Clause
// OpenPOWER tlbsync - TLB Synchronize (X-Form)
// tlbsync
// Primary opcode 31, XO=566
// Ensures all preceding tlbie instructions have completed on all processors
//
// For single-core implementation without TLB cache, this is a no-op.
// Acts as a barrier to ensure tlbie operations have propagated.
//
// Encoding:
//   Bits 6-10: Reserved (should be 0)
//   Bits 11-15: Reserved (should be 0)
//   Bits 16-20: Reserved (should be 0)
//   Bits 21-30: XO = 566
//   Bit 31: Reserved
//
// Usage pattern in Linux kernel:
//   tlbie ...
//   eieio        ; order stores
//   tlbsync      ; wait for tlbie to complete
//   ptesync      ; wait for all to complete

isa_state pc[63:0];
var instr[31:0];
isa_state rf[63:0][4:0];
mem umem[14:0];

#ifdef VM
aspect mmu.isa gates pc, msr, srr0, srr1;
instr = umem[pc_pa];
#else
instr = umem[pc];
#endif
// Primary opcode 31
assume instr[31:26] == 31;
// XO field = 566
assume instr[10:1] == 566;

// No-op for single-core implementation
// In SMP: would wait for all pending tlbie operations to complete
// on all processors before allowing subsequent memory operations

pc = pc + 4;
