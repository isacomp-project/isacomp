// SPDX-License-Identifier: BSD-3-Clause
// OpenPOWER mfspr SPRG3 - Move From SPR General 3
// mfspr RT,275 (SPR 275 = SPRG3)
// Primary opcode 31, XO=339

isa_state pc[63:0];
var instr[31:0];
isa_state rf[63:0][4:0];
mem umem[14:0];
isa_state sprg3[63:0];

var rt[4:0];
var mfspr_sprg3_result[63:0];

#ifdef VM
aspect mmu.isa gates pc, msr, srr0, srr1;
instr = umem[pc_pa];
#else
instr = umem[pc];
#endif
assume instr[31:26] == 31;
assume instr[10:1] == 339;
// SPR field for SPRG3 (SPR 275): spr_hi=8, spr_lo=19
assume instr[15:11] == 8;
assume instr[20:16] == 19;

rt = instr[25:21];
mfspr_sprg3_result = sprg3;
#ifdef VM
rf[rt] when (~instr_trap_taken) = mfspr_sprg3_result;
#else
rf[rt] = mfspr_sprg3_result;
#endif

pc = pc + 4;
