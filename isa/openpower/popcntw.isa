// SPDX-License-Identifier: BSD-3-Clause
// OpenPOWER popcntw - Population Count Word (X-Form)
// popcntw RA,RS
// Primary opcode 31, XO=378
// RA <- count of 1-bits in (RS)[32:63]

isa_state pc[63:0];
var instr[31:0];
isa_state rf[63:0][4:0];
mem umem[14:0];

var rs[4:0];
var ra[4:0];
var rs_val[63:0];
var word_val[31:0];
var count[6:0];
var result[63:0];

#ifdef VM
aspect mmu.isa gates pc, msr, srr0, srr1;
instr = umem[pc_pa];
#else
instr = umem[pc];
#endif
// Primary opcode 31
assume instr[31:26] == 31;
// XO field = 378
assume instr[10:1] == 378;
// Rc bit = 0
assume instr[0] == 0;

// Extract register fields
rs = instr[25:21];
ra = instr[20:16];

rs_val = rf[rs];
word_val = rs_val[31:0];

// Count 1-bits by summing all bits
count = {6'd0, word_val[0]} + {6'd0, word_val[1]} + {6'd0, word_val[2]} +
        {6'd0, word_val[3]} + {6'd0, word_val[4]} + {6'd0, word_val[5]} +
        {6'd0, word_val[6]} + {6'd0, word_val[7]} + {6'd0, word_val[8]} +
        {6'd0, word_val[9]} + {6'd0, word_val[10]} + {6'd0, word_val[11]} +
        {6'd0, word_val[12]} + {6'd0, word_val[13]} + {6'd0, word_val[14]} +
        {6'd0, word_val[15]} + {6'd0, word_val[16]} + {6'd0, word_val[17]} +
        {6'd0, word_val[18]} + {6'd0, word_val[19]} + {6'd0, word_val[20]} +
        {6'd0, word_val[21]} + {6'd0, word_val[22]} + {6'd0, word_val[23]} +
        {6'd0, word_val[24]} + {6'd0, word_val[25]} + {6'd0, word_val[26]} +
        {6'd0, word_val[27]} + {6'd0, word_val[28]} + {6'd0, word_val[29]} +
        {6'd0, word_val[30]} + {6'd0, word_val[31]};

// Zero-extend to 64 bits
result = {57'h0, count};

#ifdef VM
rf[ra] when (~instr_trap_taken) = result;
#else
rf[ra] = result;
#endif
pc = pc + 4;
