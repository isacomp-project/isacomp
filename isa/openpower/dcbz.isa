// SPDX-License-Identifier: BSD-3-Clause
// OpenPOWER dcbz - Data Cache Block Zero (X-Form)
// dcbz RA,RB
// Primary opcode 31, XO=1014
// Zeros an entire cache block (64 bytes).
// if RA = 0 then b <- 0 else b <- (RA)
// EA <- b + (RB)
// Zero entire cache block containing EA
//
// Implementation: writes zero to the cache-line-aligned EA via the store
// path (with full address translation). The testbench intercepts dcbz_enable
// and zeroes the full 8-doubleword (64-byte) cache line.

isa_state pc[63:0];
var instr[31:0];
isa_state rf[63:0][4:0];
mem umem[14:0];

var ra[4:0];
var rb[4:0];
var ra_val[63:0];
var rb_val[63:0];
var ra_or_zero[63:0];
var ea[63:0];

#ifdef VM
aspect mmu.isa gates pc, msr, srr0, srr1;
instr = umem[pc_pa];
#else
instr = umem[pc];
#endif
// Primary opcode 31
assume instr[31:26] == 31;
// XO field = 1014
assume instr[10:1] == 1014;

// Extract register fields
ra = instr[20:16];
rb = instr[15:11];

ra_val = rf[ra];
rb_val = rf[rb];

// If RA=0, use 0; otherwise use (RA)
ra_or_zero = ra == 0 ? 64'h0 : ra_val;

// Calculate effective address, aligned to 64-byte cache line
ea = (ra_or_zero + rb_val) & (~64'h3F);

// Store zero doubleword to the aligned address
// (testbench will zero the full 64-byte cache line on dcbz_enable)
#ifdef VM
aspect mmu_store.isa gates pc, msr, srr0, srr1, dar, dsisr;
umem[ea_pa] when (~store_exception_taken & ~instr_trap_taken) = 64'h0;
#else
umem[ea] = 64'h0;
#endif
pc = pc + 4;
