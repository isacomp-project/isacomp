// SPDX-License-Identifier: BSD-3-Clause
// OpenPOWER subfe - Subtract From Extended (XO-Form)
// subfe RT,RA,RB
// Primary opcode 31, XO=136
// RT <- ~(RA) + (RB) + CA
// CA <- new carry out

isa_state pc[63:0];
var instr[31:0];
isa_state rf[63:0][4:0];
mem umem[14:0];
isa_state xer[63:0];
// XER bits:
// XER[32] = SO (Summary Overflow)
// XER[33] = OV (Overflow)
// XER[34] = CA (Carry)
// XER[44] = OV32 (32-bit overflow, Power ISA 3.0)
// XER[45] = CA32 (32-bit carry, Power ISA 3.0)

var rt[4:0];
var ra[4:0];
var rb[4:0];
var ra_val[63:0];
var rb_val[63:0];
var ca[0:0];
var sum[64:0];
var result[63:0];
var carry[0:0];

#ifdef VM
aspect mmu.isa gates pc, msr, srr0, srr1;
instr = umem[pc_pa];
#else
instr = umem[pc];
#endif
// Primary opcode 31 in bits 31:26
assume instr[31:26] == 31;
// XO field (bits 10:1) = 136
assume instr[10:1] == 136;
// Rc bit = 0 (no record)
assume instr[0] == 0;
// OE bit = 0 (no overflow)
assume instr[10] == 0;

// Extract register fields
rt = instr[25:21];
ra = instr[20:16];
rb = instr[15:11];

ra_val = rf[ra];
rb_val = rf[rb];
ca = xer[34];  // Read CA bit

// Compute ~(RA) + (RB) + CA with carry
sum = {1'b0, ~ra_val} + {1'b0, rb_val} + {64'h0, ca};
result = sum[63:0];
carry = sum[64];

#ifdef VM
rf[rt] when (~instr_trap_taken) = result;
#else
rf[rt] = result;
#endif
xer[34] = carry;  // Update CA bit
pc = pc + 4;
