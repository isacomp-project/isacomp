// SPDX-License-Identifier: BSD-3-Clause
// OpenPOWER lwarx - Load Word And Reserve Indexed (X-Form)
// lwarx RT,RA,RB
// Primary opcode 31, XO=20
// if RA = 0 then b <- 0 else b <- (RA)
// EA <- b + (RB)
// RT <- sign_extend(MEM(EA, 4))
// Set reservation on EA

isa_state pc[63:0];
var instr[31:0];
isa_state rf[63:0][4:0];
mem umem[14:0];
isa_state resv_addr[63:0];
isa_state resv_valid[0:0];

var rt[4:0];
var ra[4:0];
var rb[4:0];
var ra_val[63:0];
var rb_val[63:0];
var ra_or_zero[63:0];
var ea[63:0];
var word_data[31:0];
var sign_ext_data[63:0];

#ifdef VM
aspect mmu.isa gates pc, msr, srr0, srr1;
instr = umem[pc_pa];
#else
instr = umem[pc];
#endif
// Primary opcode 31
assume instr[31:26] == 31;
// XO field = 20
assume instr[10:1] == 20;

// Extract register fields
rt = instr[25:21];
ra = instr[20:16];
rb = instr[15:11];

ra_val = rf[ra];
rb_val = rf[rb];

// If RA=0, use 0; otherwise use (RA)
ra_or_zero = ra == 0 ? 64'h0 : ra_val;

// Calculate effective address
ea = ra_or_zero + rb_val;

// Load word from memory and zero-extend (not sign-extend)
#ifdef VM
aspect mmu_load.isa gates pc, msr, srr0, srr1, dar, dsisr;
word_data = umem[ea_pa];
#else
word_data = umem[ea];
#endif
sign_ext_data = {32'h0, word_data};

#ifdef VM
rf[rt] when (~load_exception_taken & ~instr_trap_taken) = sign_ext_data;
#else
rf[rt] = sign_ext_data;
#endif

// Set reservation
resv_addr = ea;
resv_valid = 1'b1;

pc = pc + 4;
