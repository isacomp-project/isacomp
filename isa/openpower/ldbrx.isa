// SPDX-License-Identifier: BSD-3-Clause
// OpenPOWER ldbrx - Load Doubleword Byte-Reverse Indexed (X-Form)
// ldbrx RT,RA,RB
// Primary opcode 31, XO=532
// if RA = 0 then b <- 0 else b <- (RA)
// EA <- b + (RB)
// Load 8 bytes and reverse byte order
// RT <- BYTE_REVERSE(MEM(EA, 8))

isa_state pc[63:0];
var instr[31:0];
isa_state rf[63:0][4:0];
mem umem[14:0];

var rt[4:0];
var ra[4:0];
var rb[4:0];
var ra_val[63:0];
var rb_val[63:0];
var ra_or_zero[63:0];
var ea[63:0];
var dword_data[63:0];
var reversed[63:0];

#ifdef VM
aspect mmu.isa gates pc, msr, srr0, srr1;
instr = umem[pc_pa];
#else
instr = umem[pc];
#endif
// Primary opcode 31
assume instr[31:26] == 31;
// XO field = 532
assume instr[10:1] == 532;

// Extract register fields
rt = instr[25:21];
ra = instr[20:16];
rb = instr[15:11];

ra_val = rf[ra];
rb_val = rf[rb];

// If RA=0, use 0; otherwise use (RA)
ra_or_zero = ra == 0 ? 64'h0 : ra_val;

// Calculate effective address
ea = ra_or_zero + rb_val;

// Load doubleword from memory
#ifdef VM
aspect mmu_load.isa gates pc, msr, srr0, srr1, dar, dsisr;
dword_data = umem[ea_pa];
#else
dword_data = umem[ea];
#endif

// Reverse bytes: [b0, b1, b2, b3, b4, b5, b6, b7] -> [b7, b6, b5, b4, b3, b2, b1, b0]
reversed = {dword_data[7:0], dword_data[15:8], dword_data[23:16], dword_data[31:24],
            dword_data[39:32], dword_data[47:40], dword_data[55:48], dword_data[63:56]};

#ifdef VM
rf[rt] when (~load_exception_taken & ~instr_trap_taken) = reversed;
#else
rf[rt] = reversed;
#endif
pc = pc + 4;
