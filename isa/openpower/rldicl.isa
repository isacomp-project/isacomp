// SPDX-License-Identifier: BSD-3-Clause
// OpenPOWER rldicl - Rotate Left Doubleword Immediate then Clear Left (MD-Form)
// rldicl rA, rS, sh, mb  (includes srdi extended mnemonic: srdi rA, rS, n = rldicl rA, rS, 64-n, n)
// Primary opcode 30, MD-form (XO bits 2:4 = 000 = 0)
// rA = ROTL64(rS, sh) & MASK(mb, 63)

isa_state pc[63:0];
var instr[31:0];
isa_state rf[63:0][4:0];
mem umem[14:0];

var rs[4:0];
var ra[4:0];
var sh[5:0];
var mb[5:0];
var rs_val[63:0];
var rotated[63:0];
var result[63:0];

#ifdef VM
aspect mmu.isa gates pc, msr, srr0, srr1;
instr = umem[pc_pa];
#else
instr = umem[pc];
#endif
// Primary opcode 30
assume instr[31:26] == 30;
// MD-form with XO bits 2:4 = 000 (rldicl)
assume instr[4:2] == 0;
// Rc = 0 (non-recording form)
assume instr[0] == 0;

// Extract fields
rs = instr[25:21];
ra = instr[20:16];
// sh = sh5 (bit 1) || sh0:4 (bits 15:11)
sh = {instr[1], instr[15:11]};
// mb = mb5 (bit 5) || mb0:4 (bits 10:6)
mb = {instr[5], instr[10:6]};

// Read register
rs_val = rf[rs];

// Rotate left by sh (handles 0 shift case)
rotated = sh[5:0] == 0 ? rs_val : ((rs_val << sh) | (rs_val >> (64 - sh)));

// MASK(mb, 63) clears bits 0 through (mb-1), keeping bits mb through 63
// In PowerPC bit numbering: bit 0 = MSB, bit 63 = LSB
// The mask is: (2^(64-mb) - 1) = 0xFFFFFFFFFFFFFFFF >> mb
result = rotated & (64'hFFFFFFFFFFFFFFFF >> mb);

// Write result
#ifdef VM
rf[ra] when (~instr_trap_taken) = result;
#else
rf[ra] = result;
#endif

pc = pc + 4;
