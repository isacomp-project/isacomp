// SPDX-License-Identifier: BSD-3-Clause
// OpenPOWER mulhw - Multiply High Word (XO-Form)
// mulhw RT,RA,RB
// Primary opcode 31, XO=75
// Returns high 32 bits of 32x32->64 signed multiply
// RT <- high32((RA)[32:63] * signed (RB)[32:63])

isa_state pc[63:0];
var instr[31:0];
isa_state rf[63:0][4:0];
mem umem[14:0];

var rt[4:0];
var ra[4:0];
var rb[4:0];
var a_signed[31:0];
var b_signed[31:0];
var a_ext[63:0];
var b_ext[63:0];
var product[63:0];
var result[63:0];

#ifdef VM
aspect mmu.isa gates pc, msr, srr0, srr1;
instr = umem[pc_pa];
#else
instr = umem[pc];
#endif
// Primary opcode 31
assume instr[31:26] == 31;
// XO field = 75
assume instr[9:1] == 75;
// Rc bit = 0
assume instr[0] == 0;
// OE bit = 0
assume instr[10] == 0;

// Extract register fields
rt = instr[25:21];
ra = instr[20:16];
rb = instr[15:11];

// Get low 32 bits (word)
a_signed = rf[ra][31:0];
b_signed = rf[rb][31:0];

// Sign-extend to 64 bits
a_ext = {{32{a_signed[31]}}, a_signed};
b_ext = {{32{b_signed[31]}}, b_signed};

// Multiply (64-bit result)
product = a_ext * b_ext;

// Take high 32 bits, sign-extend to 64 bits
result = {{32{product[63]}}, product[63:32]};

#ifdef VM
rf[rt] when (~instr_trap_taken) = result;
#else
rf[rt] = result;
#endif
pc = pc + 4;
