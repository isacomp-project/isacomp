// SPDX-License-Identifier: BSD-3-Clause
// OpenPOWER modud - Modulo Unsigned Doubleword (X-Form)
// modud RT,RA,RB
// Primary opcode 31, XO=265
// RT <- (RA) mod (RB) (unsigned 64-bit)

isa_state pc[63:0];
var instr[31:0];
isa_state rf[63:0][4:0];
mem umem[14:0];

var rt[4:0];
var ra[4:0];
var rb[4:0];
var ra_val[63:0];
var rb_val[63:0];
var result[63:0];

#ifdef VM
aspect mmu.isa gates pc, msr, srr0, srr1;
instr = umem[pc_pa];
#else
instr = umem[pc];
#endif
// Primary opcode 31
assume instr[31:26] == 31;
// XO field = 265
assume instr[10:1] == 265;

// Extract register fields
rt = instr[25:21];
ra = instr[20:16];
rb = instr[15:11];

ra_val = rf[ra];
rb_val = rf[rb];

// Unsigned modulo
result = ra_val % rb_val;

#ifdef VM
rf[rt] when (~instr_trap_taken) = result;
#else
rf[rt] = result;
#endif
pc = pc + 4;
