// SPDX-License-Identifier: BSD-3-Clause
// OpenPOWER modsd - Modulo Signed Doubleword (X-Form)
// modsd RT,RA,RB
// Primary opcode 31, XO=777
// RT <- (RA) mod (RB) (signed 64-bit)

isa_state pc[63:0];
var instr[31:0];
isa_state rf[63:0][4:0];
mem umem[14:0];

var rt[4:0];
var ra[4:0];
var rb[4:0];
var ra_val[63:0];
var rb_val[63:0];
var ra_sign[0:0];
var rb_sign[0:0];
var ra_abs[63:0];
var rb_abs[63:0];
var remainder_abs[63:0];
var result[63:0];

#ifdef VM
aspect mmu.isa gates pc, msr, srr0, srr1;
instr = umem[pc_pa];
#else
instr = umem[pc];
#endif
// Primary opcode 31
assume instr[31:26] == 31;
// XO field = 777
assume instr[10:1] == 777;

// Extract register fields
rt = instr[25:21];
ra = instr[20:16];
rb = instr[15:11];

ra_val = rf[ra];
rb_val = rf[rb];

// Signed modulo: result has sign of dividend (RA)
ra_sign = ra_val[63];
rb_sign = rb_val[63];

// Absolute values
ra_abs = ra_sign ? (~ra_val + 64'h1) : ra_val;
rb_abs = rb_sign ? (~rb_val + 64'h1) : rb_val;

// Unsigned modulo of absolute values
remainder_abs = ra_abs % rb_abs;

// Apply sign of dividend to remainder
result = ra_sign ? (~remainder_abs + 64'h1) : remainder_abs;

#ifdef VM
rf[rt] when (~instr_trap_taken) = result;
#else
rf[rt] = result;
#endif
pc = pc + 4;
