// SPDX-License-Identifier: BSD-3-Clause
// OpenPOWER sraw - Shift Right Algebraic Word (X-Form)
// sraw RA,RS,RB
// Primary opcode 31, XO=792
// n <- (RB)[59:63]
// r <- ROTL32((RS)[32:63], 64-n)
// m <- MASK(n+32, 63)
// s <- (RS)[32]
// RA <- r & m | ~m & s*64
// CA <- s & ((r & ~m) != 0)

isa_state pc[63:0];
var instr[31:0];
isa_state rf[63:0][4:0];
mem umem[14:0];
isa_state xer[63:0];

var rs[4:0];
var ra[4:0];
var rb[4:0];
var rs_val[63:0];
var rb_val[63:0];
var word_val[31:0];
var shift_amt[5:0];
var sign_bit[0:0];
var shifted[31:0];
var result[63:0];

#ifdef VM
aspect mmu.isa gates pc, msr, srr0, srr1;
instr = umem[pc_pa];
#else
instr = umem[pc];
#endif
// Primary opcode 31
assume instr[31:26] == 31;
// XO field = 792
assume instr[10:1] == 792;
// Rc bit = 0
assume instr[0] == 0;

// Extract register fields
rs = instr[25:21];
ra = instr[20:16];
rb = instr[15:11];

rs_val = rf[rs];
rb_val = rf[rb];

// Get low 32 bits of RS
word_val = rs_val[31:0];
sign_bit = word_val[31];
// Shift amount from low 6 bits of RB
shift_amt = rb_val[5:0];

// Arithmetic shift right (sign-extend)
shifted = shift_amt[5] ? (sign_bit ? 32'hFFFFFFFF : 32'h0) : (word_val >>> shift_amt[4:0]);

// Sign-extend result to 64 bits
result = {{32{shifted[31]}}, shifted};

// CA is set if negative and any 1-bits were shifted out
xer[34] = sign_bit & ((word_val << (32 - shift_amt[4:0])) != 0);

#ifdef VM
rf[ra] when (~instr_trap_taken) = result;
#else
rf[ra] = result;
#endif
pc = pc + 4;
