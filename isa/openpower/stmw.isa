// SPDX-License-Identifier: BSD-3-Clause
// OpenPOWER stmw - Store Multiple Word (D-Form)
// stmw RS,D(RA)
// Primary opcode 47
// Stores RS through r31 to consecutive memory locations
// Simplified implementation: stores only RS

isa_state pc[63:0];
var instr[31:0];
isa_state rf[63:0][4:0];
mem umem[14:0];

var rs[4:0];
var ra[4:0];
var d[15:0];
var ra_val[63:0];
var ra_or_zero[63:0];
var sign_ext_d[63:0];
var ea[63:0];
var rs_val[63:0];

#ifdef VM
aspect mmu.isa gates pc, msr, srr0, srr1;
instr = umem[pc_pa];
#else
instr = umem[pc];
#endif
// Primary opcode 47
assume instr[31:26] == 47;

// Extract fields
rs = instr[25:21];
ra = instr[20:16];
d = instr[15:0];

// Sign-extend displacement
sign_ext_d = {{48{d[15]}}, d};

// If RA=0, use 0; otherwise use (RA)
ra_val = rf[ra];
ra_or_zero = ra == 0 ? 64'h0 : ra_val;

// Calculate effective address
ea = ra_or_zero + sign_ext_d;

// Store word to memory (simplified: only store RS)
rs_val = rf[rs];
#ifdef VM
aspect mmu_store.isa gates pc, msr, srr0, srr1, dar, dsisr;
umem[ea_pa] when (~store_exception_taken & ~instr_trap_taken) = rs_val[31:0];
#else
umem[ea] = rs_val[31:0];
#endif

pc = pc + 4;
