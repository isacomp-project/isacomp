// SPDX-License-Identifier: BSD-3-Clause
// OpenPOWER mfspr SPRG2 - Move From SPR General 2
// mfspr RT,274 (SPR 274 = SPRG2)
// Primary opcode 31, XO=339

isa_state pc[63:0];
var instr[31:0];
isa_state rf[63:0][4:0];
mem umem[14:0];
isa_state sprg2[63:0];

var rt[4:0];
var mfspr_sprg2_result[63:0];

#ifdef VM
aspect mmu.isa gates pc, msr, srr0, srr1;
instr = umem[pc_pa];
#else
instr = umem[pc];
#endif
assume instr[31:26] == 31;
assume instr[10:1] == 339;
// SPR field for SPRG2 (SPR 274): spr_hi=8, spr_lo=18
assume instr[15:11] == 8;
assume instr[20:16] == 18;

rt = instr[25:21];
mfspr_sprg2_result = sprg2;
#ifdef VM
rf[rt] when (~instr_trap_taken) = mfspr_sprg2_result;
#else
rf[rt] = mfspr_sprg2_result;
#endif

pc = pc + 4;
