// SPDX-License-Identifier: BSD-3-Clause
// OpenPOWER mfcr - Move From Condition Register (XFX-Form)
// mfcr RT
// Primary opcode 31, XO=19
// RT <- CR

isa_state pc[63:0];
var instr[31:0];
isa_state rf[63:0][4:0];
mem umem[14:0];
isa_state cr[31:0];

var rt[4:0];
var result[63:0];

#ifdef VM
aspect mmu.isa gates pc, msr, srr0, srr1;
instr = umem[pc_pa];
#else
instr = umem[pc];
#endif
// Primary opcode 31
assume instr[31:26] == 31;
// XO field = 19
assume instr[10:1] == 19;
// FXM field should be 0 for mfcr
assume instr[19:12] == 0;

// Extract RT field
rt = instr[25:21];

// Zero-extend CR to 64 bits
result = {32'h0, cr};

#ifdef VM
rf[rt] when (~instr_trap_taken) = result;
#else
rf[rt] = result;
#endif
pc = pc + 4;
