// SPDX-License-Identifier: BSD-3-Clause
// OpenPOWER mtspr DSISR - Move To Data Storage Interrupt Status Register
// mtspr 18,RS (SPR 18 = DSISR)
// Primary opcode 31, XO=467

isa_state pc[63:0];
var instr[31:0];
isa_state rf[63:0][4:0];
mem umem[14:0];
isa_state dsisr[31:0];

var rs[4:0];
var rs_val[63:0];

#ifdef VM
aspect mmu.isa gates pc, msr, srr0, srr1;
instr = umem[pc_pa];
#else
instr = umem[pc];
#endif
assume instr[31:26] == 31;
assume instr[10:1] == 467;
// SPR field for DSISR (SPR 18): spr_hi=0, spr_lo=18
assume instr[15:11] == 0;
assume instr[20:16] == 18;

rs = instr[25:21];
rs_val = rf[rs];
dsisr = rs_val[31:0];

pc = pc + 4;
