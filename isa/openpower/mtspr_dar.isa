// SPDX-License-Identifier: BSD-3-Clause
// OpenPOWER mtspr DAR - Move To Data Address Register
// mtspr 19,RS (SPR 19 = DAR)
// Primary opcode 31, XO=467

isa_state pc[63:0];
var instr[31:0];
isa_state rf[63:0][4:0];
mem umem[14:0];
isa_state dar[63:0];

var rs[4:0];
var rs_val[63:0];

#ifdef VM
aspect mmu.isa gates pc, msr, srr0, srr1;
instr = umem[pc_pa];
#else
instr = umem[pc];
#endif
assume instr[31:26] == 31;
assume instr[10:1] == 467;
// SPR field for DAR (SPR 19): spr_hi=0, spr_lo=19
assume instr[15:11] == 0;
assume instr[20:16] == 19;

rs = instr[25:21];
rs_val = rf[rs];
dar = rs_val;

pc = pc + 4;
