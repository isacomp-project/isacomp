// SPDX-License-Identifier: BSD-3-Clause
// OpenPOWER mfspr TBU - Move From Time Base Upper
// mftbu RT  (mfspr RT,269)
// Primary opcode 31, XO=339, SPR=269
// RT <- TBU (upper 32 bits of time base, zero-extended)

isa_state pc[63:0];
var instr[31:0];
isa_state rf[63:0][4:0];
mem umem[14:0];
isa_state tb[63:0];

var rt[4:0];

#ifdef VM
aspect mmu.isa gates pc, msr, srr0, srr1;
instr = umem[pc_pa];
#else
instr = umem[pc];
#endif
assume instr[31:26] == 31;
assume instr[10:1] == 339;
// SPR field for TBU (SPR 269): spr_hi=8, spr_lo=13
// SPR = {spr_hi, spr_lo} = {8, 13} = 269
assume instr[15:11] == 8;
assume instr[20:16] == 13;

rt = instr[25:21];
// Return upper 32 bits of TB, zero-extended to 64 bits
#ifdef VM
rf[rt] when (~instr_trap_taken) = {32'h00000000, tb[63:32]};
#else
rf[rt] = {32'h00000000, tb[63:32]};
#endif
pc = pc + 4;
