// SPDX-License-Identifier: BSD-3-Clause
// OpenPOWER fmul - Floating Multiply Double (A-Form)
// fmul FRT,FRA,FRC (Rc=0)
// Primary opcode 63, XO=25
// FRT <- (FRA) * (FRC) as double precision
// Note: fmul uses FRC (bits 10:6), not FRB

isa_state pc[63:0];
var instr[31:0];
isa_state rf[63:0][4:0];       // Integer register file
isa_state frf[63:0][4:0];      // FP register file (64-bit)
isa_state fpscr[31:0];         // FP status and control register
mem umem[14:0];

var frt[4:0];
var fra[4:0];
var frc[4:0];
var f1[63:0];
var f2[63:0];
var mul_result[63:0];
var rm[2:0];  // Rounding mode in canonical IEEE 754 encoding

#ifdef VM
aspect mmu.isa gates pc, msr, srr0, srr1;
instr = umem[pc_pa];
#else
instr = umem[pc];
#endif
assume instr[31:26] == 63;     // Primary opcode 63
assume instr[5:1] == 25;       // XO = 25 (fmul)
assume instr[0] == 0;          // Rc = 0

pc = pc + 4;

frt = instr[25:21];
fra = instr[20:16];
frc = instr[10:6];             // FRC field, not FRB

// Read FP operands (full 64 bits for double precision)
f1 = frf[fra];
f2 = frf[frc];

// Map OpenPOWER FPSCR[RN] to canonical IEEE 754 rounding mode
rm = {1'b0, fpscr[1], fpscr[1] ^ fpscr[0]};

// Perform double-precision multiplication with rounding mode
mul_result = fp_mul_d(f1, f2, rm);

// Write result
frf[frt] when (~instr_trap_taken) = mul_result;
