// SPDX-License-Identifier: BSD-3-Clause
// OpenPOWER fmuls - Floating Multiply Single (A-Form)
// fmuls FRT,FRA,FRC (Rc=0)
// Primary opcode 59, XO=25
// FRT <- (FRA) * (FRC) as single precision
// Note: Uses FRC (bits 10:6), not FRB

isa_state pc[63:0];
var instr[31:0];
isa_state rf[63:0][4:0];
isa_state frf[63:0][4:0];
isa_state fpscr[31:0];
mem umem[14:0];

var frt[4:0];
var fra[4:0];
var frc[4:0];
var f1[31:0];
var f2[31:0];
var mul_result[31:0];
var rm[2:0];  // Rounding mode in canonical IEEE 754 encoding

#ifdef VM
aspect mmu.isa gates pc, msr, srr0, srr1;
instr = umem[pc_pa];
#else
instr = umem[pc];
#endif
assume instr[31:26] == 59;     // Primary opcode 59
assume instr[5:1] == 25;       // XO = 25 (fmuls)
assume instr[0] == 0;          // Rc = 0

pc = pc + 4;

frt = instr[25:21];
fra = instr[20:16];
frc = instr[10:6];

f1 = frf[fra][31:0];
f2 = frf[frc][31:0];

// Map OpenPOWER FPSCR[RN] to canonical IEEE 754 rounding mode
rm = {1'b0, fpscr[1], fpscr[1] ^ fpscr[0]};

mul_result = fp_mul(f1, f2, rm);

frf[frt] when (~instr_trap_taken) = {32'b0, mul_result};
