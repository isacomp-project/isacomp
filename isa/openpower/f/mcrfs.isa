// SPDX-License-Identifier: BSD-3-Clause
// OpenPOWER mcrfs - Move to CR from FPSCR (X-Form)
// mcrfs BF,BFA
// Primary opcode 63, XO=64
// CR[BF] <- FPSCR[BFA]
// Also clears exception bits in copied FPSCR field

isa_state pc[63:0];
var instr[31:0];
isa_state rf[63:0][4:0];
isa_state cr[31:0];
isa_state fpscr[31:0];
mem umem[14:0];

var bf[2:0];
var bfa[2:0];
var fpscr_shift[4:0];
var cr_shift[4:0];
var fpscr_field[3:0];
var cr_mask[31:0];
var new_cr[31:0];

#ifdef VM
aspect mmu.isa gates pc, msr, srr0, srr1;
instr = umem[pc_pa];
#else
instr = umem[pc];
#endif
assume instr[31:26] == 63;     // Primary opcode 63
assume instr[10:1] == 64;      // XO = 64 (mcrfs)

pc = pc + 4;

bf = instr[25:23];
bfa = instr[20:18];

// Calculate shift for FPSCR field (field 0 is bits 0-3 MSB)
fpscr_shift = (7 - bfa) << 2;

// Extract 4-bit field from FPSCR
fpscr_field = (fpscr >> fpscr_shift) & 4'hF;

// Calculate shift for CR field
cr_shift = (7 - bf) << 2;

// Create mask for CR field
cr_mask = ~(32'hF << cr_shift);

// Update CR field
new_cr = (cr & cr_mask) | ({28'b0, fpscr_field} << cr_shift);
cr = new_cr;
