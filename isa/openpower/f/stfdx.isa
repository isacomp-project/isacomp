// SPDX-License-Identifier: BSD-3-Clause
// OpenPOWER stfdx - Store Floating-Point Double Indexed (X-Form)
// stfdx FRS,RA,RB
// Primary opcode 31, XO=727
// MEM(RA + RB, 8) <- (FRS)

isa_state pc[63:0];
var instr[31:0];
isa_state rf[63:0][4:0];
isa_state frf[63:0][4:0];
mem umem[14:0];

var frs[4:0];
var ra[4:0];
var rb[4:0];
var ra_val[63:0];
var rb_val[63:0];
var addr[63:0];
var data[63:0];

#ifdef VM
aspect mmu.isa gates pc, msr, srr0, srr1;
instr = umem[pc_pa];
#else
instr = umem[pc];
#endif
assume instr[31:26] == 31;     // Primary opcode 31
assume instr[10:1] == 727;     // XO = 727 (stfdx)

pc = pc + 4;

frs = instr[25:21];
ra = instr[20:16];
rb = instr[15:11];

ra_val = rf[ra];
rb_val = rf[rb];
addr = ra_val + rb_val;

// Get full 64 bits (double-precision value)
data = frf[frs];

// Store to memory
#ifdef VM
aspect mmu_store.isa gates pc, msr, srr0, srr1, dar, dsisr;
umem[ea_pa] when (~store_exception_taken & ~instr_trap_taken) = data;
#else
umem[ea] = data;
#endif
