// SPDX-License-Identifier: BSD-3-Clause
// OpenPOWER fctiw - Floating Convert To Integer Word (X-Form)
// fctiw FRT,FRB (Rc=0)
// Primary opcode 63, XO=14
// FRT <- Convert double-precision in FRB to signed int32 (FPSCR rounding)

isa_state pc[63:0];
var instr[31:0];
isa_state rf[63:0][4:0];
isa_state frf[63:0][4:0];
isa_state fpscr[31:0];
mem umem[14:0];

var frt[4:0];
var frb[4:0];
var fp_val[63:0];
var int_result[31:0];
var rm[2:0];

#ifdef VM
aspect mmu.isa gates pc, msr, srr0, srr1;
instr = umem[pc_pa];
#else
instr = umem[pc];
#endif
assume instr[31:26] == 63;     // Primary opcode 63
assume instr[10:1] == 14;      // XO = 14 (fctiw)
assume instr[0] == 0;          // Rc = 0

pc = pc + 4;

frt = instr[25:21];
frb = instr[15:11];

fp_val = frf[frb];

// Map OpenPOWER FPSCR[RN] to canonical IEEE 754 rounding mode
rm = {1'b0, fpscr[1], fpscr[1] ^ fpscr[0]};

// Convert double to signed int32
int_result = fp_cvt_w_d(fp_val, rm);

// Result is sign-extended to 64 bits in the FP register
frf[frt] when (~instr_trap_taken) = {{32{int_result[31]}}, int_result};
