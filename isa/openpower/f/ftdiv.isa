// SPDX-License-Identifier: BSD-3-Clause
// OpenPOWER ftdiv - Floating Test for Software Divide (X-Form)
// ftdiv BF,FRA,FRB
// Primary opcode 63, XO=128
// Tests if divide can be performed without special handling
// Sets CR[BF] = {FE, FG, FE, FU} based on operand analysis

isa_state pc[63:0];
var instr[31:0];
isa_state rf[63:0][4:0];
isa_state frf[63:0][4:0];
isa_state cr[31:0];
mem umem[14:0];

var bf[2:0];
var fra[4:0];
var frb[4:0];
var fa[63:0];
var fb[63:0];
var fa_exp[10:0];
var fb_exp[10:0];
var fa_mant[51:0];
var fb_mant[51:0];
var fa_is_inf[0:0];
var fb_is_inf[0:0];
var fa_is_zero[0:0];
var fb_is_zero[0:0];
var fa_is_nan[0:0];
var fb_is_nan[0:0];
var fa_is_denorm[0:0];
var fb_is_denorm[0:0];
var fe[0:0];
var fg[0:0];
var fl[0:0];
var fu[0:0];
var cr_field[3:0];
var cr_shift[4:0];
var cr_mask[31:0];
var new_cr[31:0];

#ifdef VM
aspect mmu.isa gates pc, msr, srr0, srr1;
instr = umem[pc_pa];
#else
instr = umem[pc];
#endif
assume instr[31:26] == 63;     // Primary opcode 63
assume instr[10:1] == 128;     // XO = 128 (ftdiv)

pc = pc + 4;

bf = instr[25:23];
fra = instr[20:16];
frb = instr[15:11];

fa = frf[fra];
fb = frf[frb];

// Extract exponent and mantissa for double precision
fa_exp = fa[62:52];
fb_exp = fb[62:52];
fa_mant = fa[51:0];
fb_mant = fb[51:0];

// Check for special values
fa_is_inf = (fa_exp == 11'h7FF) && (fa_mant == 0);
fb_is_inf = (fb_exp == 11'h7FF) && (fb_mant == 0);
fa_is_zero = (fa_exp == 0) && (fa_mant == 0);
fb_is_zero = (fb_exp == 0) && (fb_mant == 0);
fa_is_nan = (fa_exp == 11'h7FF) && (fa_mant != 0);
fb_is_nan = (fb_exp == 11'h7FF) && (fb_mant != 0);
fa_is_denorm = (fa_exp == 0) && (fa_mant != 0);
fb_is_denorm = (fb_exp == 0) && (fb_mant != 0);

// FE (estimated bit) - set if result may overflow/underflow
fe = fa_is_inf || fb_is_zero || (fa_exp > fb_exp + 11'd1023);

// FG (greater) - set if result might be greater than normal
fg = fb_is_denorm || fa_is_denorm;

// FL (less) - same as FE for this encoding
fl = fe;

// FU (unordered) - set if NaN or other problem
fu = fa_is_nan || fb_is_nan || fa_is_inf || fb_is_zero;

// Build CR field
cr_field = {fe, fg, fl, fu};

// Update CR
cr_shift = (7 - bf) << 2;
cr_mask = ~(32'hF << cr_shift);
new_cr = (cr & cr_mask) | ({28'b0, cr_field} << cr_shift);
cr = new_cr;
