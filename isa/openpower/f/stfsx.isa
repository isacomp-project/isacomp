// SPDX-License-Identifier: BSD-3-Clause
// OpenPOWER stfsx - Store Floating-Point Single Indexed (X-Form)
// stfsx FRS,RA,RB
// Primary opcode 31, XO=663
// MEM(RA + RB, 4) <- (FRS)[32:63]

isa_state pc[63:0];
var instr[31:0];
isa_state rf[63:0][4:0];
isa_state frf[63:0][4:0];
mem umem[14:0];

var frs[4:0];
var ra[4:0];
var rb[4:0];
var ra_val[63:0];
var rb_val[63:0];
var addr[63:0];
var data[31:0];

#ifdef VM
aspect mmu.isa gates pc, msr, srr0, srr1;
instr = umem[pc_pa];
#else
instr = umem[pc];
#endif
assume instr[31:26] == 31;     // Primary opcode 31
assume instr[10:1] == 663;     // XO = 663 (stfsx)
assume instr[0] == 0;          // Reserved bit

pc = pc + 4;

frs = instr[25:21];
ra = instr[20:16];
rb = instr[15:11];

ra_val = rf[ra];
rb_val = rf[rb];
addr = ra_val + rb_val;

// Get lower 32 bits (single-precision value)
data = frf[frs][31:0];

// Store to memory
#ifdef VM
aspect mmu_store.isa gates pc, msr, srr0, srr1, dar, dsisr;
umem[ea_pa] when (~store_exception_taken & ~instr_trap_taken) = {32'b0, data};
#else
umem[ea] = {32'b0, data};
#endif
