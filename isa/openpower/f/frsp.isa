// SPDX-License-Identifier: BSD-3-Clause
// OpenPOWER frsp - Floating Round to Single-Precision (X-Form)
// frsp FRT,FRB (Rc=0)
// Primary opcode 63, XO=12
// FRT <- Round_Single(FRB)

isa_state pc[63:0];
var instr[31:0];
isa_state rf[63:0][4:0];
isa_state frf[63:0][4:0];
isa_state fpscr[31:0];
mem umem[14:0];

var frt[4:0];
var frb[4:0];
var f1[63:0];
var result[31:0];
var rm[2:0];  // Rounding mode in canonical IEEE 754 encoding

#ifdef VM
aspect mmu.isa gates pc, msr, srr0, srr1;
instr = umem[pc_pa];
#else
instr = umem[pc];
#endif
assume instr[31:26] == 63;     // Primary opcode 63
assume instr[20:16] == 0;      // FRA must be 0
assume instr[10:1] == 12;      // XO = 12 (frsp)
assume instr[0] == 0;          // Rc = 0

pc = pc + 4;

frt = instr[25:21];
frb = instr[15:11];

f1 = frf[frb];

// Map OpenPOWER FPSCR[RN] to canonical IEEE 754 rounding mode
rm = {1'b0, fpscr[1], fpscr[1] ^ fpscr[0]};

// Round double to single precision with rounding mode
result = fp_cvt_s_d(f1, rm);

// Store in FRT (zero-extended to 64 bits)
frf[frt] when (~instr_trap_taken) = {32'b0, result};
