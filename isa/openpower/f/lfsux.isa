// SPDX-License-Identifier: BSD-3-Clause
// OpenPOWER lfsux - Load Floating-Point Single with Update Indexed (X-Form)
// lfsux FRT,RA,RB
// Primary opcode 31, XO=567
// EA <- (RA) + (RB)
// FRT <- DOUBLE(MEM(EA, 4))
// RA <- EA

isa_state pc[63:0];
var instr[31:0];
isa_state rf[63:0][4:0];
isa_state frf[63:0][4:0];
mem umem[14:0];

var frt[4:0];
var ra[4:0];
var rb[4:0];
var ra_val[63:0];
var rb_val[63:0];
var ea[63:0];
var data[31:0];
var double_val[63:0];

#ifdef VM
aspect mmu.isa gates pc, msr, srr0, srr1;
instr = umem[pc_pa];
#else
instr = umem[pc];
#endif
assume instr[31:26] == 31;     // Primary opcode 31
assume instr[10:1] == 567;     // XO = 567 (lfsux)

pc = pc + 4;

frt = instr[25:21];
ra = instr[20:16];
rb = instr[15:11];

// RA cannot be 0 for update forms
assume ra != 0;

ra_val = rf[ra];
rb_val = rf[rb];
ea = ra_val + rb_val;

// Load 32-bit value from memory
#ifdef VM
aspect mmu_load.isa gates pc, msr, srr0, srr1, dar, dsisr;
data = umem[ea_pa];
#else
data = umem[ea];
#endif

// Convert single to double precision (RNE rounding mode = 3'b000)
double_val = fp_cvt_d_s(data, 3'b000);

// Store as double-precision and update RA
frf[frt] when (~load_exception_taken & ~instr_trap_taken) = double_val;
#ifdef VM
rf[ra] when (~load_exception_taken & ~instr_trap_taken) = ea;
#else
rf[ra] = ea;
#endif
