// SPDX-License-Identifier: BSD-3-Clause
// OpenPOWER stfsux - Store Floating-Point Single with Update Indexed (X-Form)
// stfsux FRS,RA,RB
// Primary opcode 31, XO=695
// EA <- (RA) + (RB)
// MEM(EA, 4) <- SINGLE(FRS)
// RA <- EA

isa_state pc[63:0];
var instr[31:0];
isa_state rf[63:0][4:0];
isa_state frf[63:0][4:0];
mem umem[14:0];

var frs[4:0];
var ra[4:0];
var rb[4:0];
var ra_val[63:0];
var rb_val[63:0];
var ea[63:0];
var double_val[63:0];
var single_val[31:0];

#ifdef VM
aspect mmu.isa gates pc, msr, srr0, srr1;
instr = umem[pc_pa];
#else
instr = umem[pc];
#endif
assume instr[31:26] == 31;     // Primary opcode 31
assume instr[10:1] == 695;     // XO = 695 (stfsux)

pc = pc + 4;

frs = instr[25:21];
ra = instr[20:16];
rb = instr[15:11];

// RA cannot be 0 for update forms
assume ra != 0;

ra_val = rf[ra];
rb_val = rf[rb];
ea = ra_val + rb_val;

// Get double-precision value and convert to single (RNE rounding mode = 3'b000)
double_val = frf[frs];
single_val = fp_cvt_s_d(double_val, 3'b000);

// Store 32-bit value to memory and update RA
#ifdef VM
aspect mmu_store.isa gates pc, msr, srr0, srr1, dar, dsisr;
umem[ea_pa] when (~store_exception_taken & ~instr_trap_taken) = {32'b0, single_val};
#else
umem[ea] = {32'b0, single_val};
#endif
#ifdef VM
rf[ra] when (~store_exception_taken & ~instr_trap_taken) = ea;
#else
rf[ra] = ea;
#endif
