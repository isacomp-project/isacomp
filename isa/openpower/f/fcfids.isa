// SPDX-License-Identifier: BSD-3-Clause
// OpenPOWER fcfids - Floating Convert from Integer Doubleword to Single (X-Form)
// fcfids FRT,FRB (Rc=0)
// Primary opcode 59, XO=846
// FRT <- Convert_from_Integer_Signed(FRB)

isa_state pc[63:0];
var instr[31:0];
isa_state rf[63:0][4:0];
isa_state frf[63:0][4:0];
isa_state fpscr[31:0];
mem umem[14:0];

var frt[4:0];
var frb[4:0];
var int_val[31:0];
var result[31:0];
var rm[2:0];  // Rounding mode in canonical IEEE 754 encoding

#ifdef VM
aspect mmu.isa gates pc, msr, srr0, srr1;
instr = umem[pc_pa];
#else
instr = umem[pc];
#endif
assume instr[31:26] == 59;     // Primary opcode 59
assume instr[20:16] == 0;      // FRA must be 0
assume instr[10:1] == 846;     // XO = 846 (fcfids)
assume instr[0] == 0;          // Rc = 0

pc = pc + 4;

frt = instr[25:21];
frb = instr[15:11];

// Get integer value from lower 32 bits of FRB
int_val = frf[frb][31:0];

// Map OpenPOWER FPSCR[RN] to canonical IEEE 754 rounding mode
rm = {1'b0, fpscr[1], fpscr[1] ^ fpscr[0]};

// Convert signed integer to single-precision float
result = fp_cvt_s_w(int_val, rm);

// Store result in FRT (zero-extended to 64 bits)
frf[frt] when (~instr_trap_taken) = {32'b0, result};
