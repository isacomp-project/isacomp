// SPDX-License-Identifier: BSD-3-Clause
// OpenPOWER stfiwx - Store Floating-Point as Integer Word Indexed (X-Form)
// stfiwx FRS,RA,RB
// Primary opcode 31, XO=983
// EA <- (RA|0) + (RB)
// MEM(EA, 4) <- (FRS)[32:63]
// Stores the low 32 bits of FP register to memory as integer

isa_state pc[63:0];
var instr[31:0];
isa_state rf[63:0][4:0];
isa_state frf[63:0][4:0];
mem umem[14:0];

var frs[4:0];
var ra[4:0];
var rb[4:0];
var ra_val[63:0];
var rb_val[63:0];
var ra_or_zero[63:0];
var ea[63:0];
var fp_val[63:0];
var word_data[31:0];

#ifdef VM
aspect mmu.isa gates pc, msr, srr0, srr1;
instr = umem[pc_pa];
#else
instr = umem[pc];
#endif
assume instr[31:26] == 31;     // Primary opcode 31
assume instr[10:1] == 983;     // XO = 983 (stfiwx)

pc = pc + 4;

frs = instr[25:21];
ra = instr[20:16];
rb = instr[15:11];

ra_val = rf[ra];
rb_val = rf[rb];

// If RA=0, use 0; otherwise use (RA)
ra_or_zero = ra == 0 ? 64'h0 : ra_val;
ea = ra_or_zero + rb_val;

// Get FP register value
fp_val = frf[frs];

// Extract low 32 bits
word_data = fp_val[31:0];

// Store 32-bit word to memory
#ifdef VM
aspect mmu_store.isa gates pc, msr, srr0, srr1, dar, dsisr;
umem[ea_pa] when (~store_exception_taken & ~instr_trap_taken) = {32'b0, word_data};
#else
umem[ea] = {32'b0, word_data};
#endif
