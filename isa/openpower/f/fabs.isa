// SPDX-License-Identifier: BSD-3-Clause
// OpenPOWER fabs - Floating Absolute Value (X-Form)
// fabs FRT,FRB (Rc=0)
// Primary opcode 63, XO=264
// FRT <- |FRB| (clear sign bit)

isa_state pc[63:0];
var instr[31:0];
isa_state rf[63:0][4:0];
isa_state frf[63:0][4:0];
mem umem[14:0];

var frt[4:0];
var frb[4:0];
var f1[63:0];
var result[63:0];

#ifdef VM
aspect mmu.isa gates pc, msr, srr0, srr1;
instr = umem[pc_pa];
#else
instr = umem[pc];
#endif
assume instr[31:26] == 63;     // Primary opcode 63
assume instr[20:16] == 0;      // FRA must be 0
assume instr[10:1] == 264;     // XO = 264 (fabs)
assume instr[0] == 0;          // Rc = 0

pc = pc + 4;

frt = instr[25:21];
frb = instr[15:11];

f1 = frf[frb];

// Absolute value: clear sign bit (bit 31 for single precision in lower 32 bits)
result = {32'b0, 1'b0, f1[30:0]};

frf[frt] when (~instr_trap_taken) = result;
