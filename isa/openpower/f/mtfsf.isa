// SPDX-License-Identifier: BSD-3-Clause
// OpenPOWER mtfsf - Move To FPSCR Fields (XFL-Form)
// mtfsf FLM,FRB (Rc=0)
// Primary opcode 63, XO=711
// For each field i where FLM[i]=1: FPSCR[field i] <- FRB[field i]

isa_state pc[63:0];
var instr[31:0];
isa_state rf[63:0][4:0];
isa_state frf[63:0][4:0];
isa_state fpscr[31:0];
mem umem[14:0];

var flm[7:0];
var frb[4:0];
var frb_val[63:0];
var mask[31:0];
var new_fpscr[31:0];

#ifdef VM
aspect mmu.isa gates pc, msr, srr0, srr1;
instr = umem[pc_pa];
#else
instr = umem[pc];
#endif
assume instr[31:26] == 63;     // Primary opcode 63
assume instr[10:1] == 711;     // XO = 711 (mtfsf)
assume instr[0] == 0;          // Rc = 0

pc = pc + 4;

flm = instr[24:17];
frb = instr[15:11];

frb_val = frf[frb];

// Build mask from FLM - each bit controls a 4-bit field
// FLM[0] controls FPSCR[0:3], FLM[1] controls FPSCR[4:7], etc.
mask = {
    flm[0] ? 4'hF : 4'h0,
    flm[1] ? 4'hF : 4'h0,
    flm[2] ? 4'hF : 4'h0,
    flm[3] ? 4'hF : 4'h0,
    flm[4] ? 4'hF : 4'h0,
    flm[5] ? 4'hF : 4'h0,
    flm[6] ? 4'hF : 4'h0,
    flm[7] ? 4'hF : 4'h0
};

// Update FPSCR with masked bits from FRB[32:63]
new_fpscr = (fpscr & ~mask) | (frb_val[31:0] & mask);
fpscr = new_fpscr;
