// SPDX-License-Identifier: BSD-3-Clause
// OpenPOWER lfs - Load Floating-Point Single (D-Form)
// lfs FRT,D(RA)
// Primary opcode 48
// FRT <- MEM(RA + EXTS(D), 4) as single precision

isa_state pc[63:0];
var instr[31:0];
isa_state rf[63:0][4:0];
isa_state frf[63:0][4:0];
mem umem[14:0];

var frt[4:0];
var ra[4:0];
var d[15:0];
var ra_val[63:0];
var offset[63:0];
var addr[63:0];
var data[31:0];

#ifdef VM
aspect mmu.isa gates pc, msr, srr0, srr1;
instr = umem[pc_pa];
#else
instr = umem[pc];
#endif
assume instr[31:26] == 48;     // Primary opcode 48 (lfs)

pc = pc + 4;

frt = instr[25:21];
ra = instr[20:16];
d = instr[15:0];

// RA=0 means use 0, else use rf[ra]
ra_val = rf[ra];
offset = {{48{d[15]}}, d};  // Sign-extend displacement
addr = ra_val + offset;

// Load 32-bit value from memory
#ifdef VM
aspect mmu_load.isa gates pc, msr, srr0, srr1, dar, dsisr;
data = umem[ea_pa][31:0];
#else
data = umem[ea][31:0];
#endif

// Store as single-precision (zero-extend to 64 bits)
frf[frt] when (~load_exception_taken & ~instr_trap_taken) = {32'b0, data};
