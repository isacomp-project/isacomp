// SPDX-License-Identifier: BSD-3-Clause
// OpenPOWER fsqrts - Floating Square Root Single (A-Form)
// fsqrts FRT,FRB (Rc=0)
// Primary opcode 59, XO=22
// FRT <- sqrt(FRB) as single precision

isa_state pc[63:0];
var instr[31:0];
isa_state rf[63:0][4:0];
isa_state frf[63:0][4:0];
isa_state fpscr[31:0];
mem umem[14:0];

var frt[4:0];
var frb[4:0];
var f1[31:0];
var sqrt_result[31:0];
var rm[2:0];  // Rounding mode in canonical IEEE 754 encoding

#ifdef VM
aspect mmu.isa gates pc, msr, srr0, srr1;
instr = umem[pc_pa];
#else
instr = umem[pc];
#endif
assume instr[31:26] == 59;     // Primary opcode 59
assume instr[20:16] == 0;      // FRA must be 0
assume instr[5:1] == 22;       // XO = 22 (fsqrts)
assume instr[0] == 0;          // Rc = 0

pc = pc + 4;

frt = instr[25:21];
frb = instr[15:11];

f1 = frf[frb][31:0];

// Map OpenPOWER FPSCR[RN] to canonical IEEE 754 rounding mode
rm = {1'b0, fpscr[1], fpscr[1] ^ fpscr[0]};

sqrt_result = fp_sqrt(f1, rm);

frf[frt] when (~instr_trap_taken) = {32'b0, sqrt_result};
