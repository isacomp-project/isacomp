// SPDX-License-Identifier: BSD-3-Clause
// OpenPOWER fsqrt - Floating Square Root Double (A-Form)
// fsqrt FRT,FRB (Rc=0)
// Primary opcode 63, XO=22
// FRT <- sqrt(FRB) as double precision

isa_state pc[63:0];
var instr[31:0];
isa_state rf[63:0][4:0];       // Integer register file
isa_state frf[63:0][4:0];      // FP register file (64-bit)
isa_state fpscr[31:0];         // FP status and control register
mem umem[14:0];

var frt[4:0];
var frb[4:0];
var f1[63:0];
var sqrt_result[63:0];
var rm[2:0];  // Rounding mode in canonical IEEE 754 encoding

#ifdef VM
aspect mmu.isa gates pc, msr, srr0, srr1;
instr = umem[pc_pa];
#else
instr = umem[pc];
#endif
assume instr[31:26] == 63;     // Primary opcode 63
assume instr[5:1] == 22;       // XO = 22 (fsqrt)
assume instr[0] == 0;          // Rc = 0

pc = pc + 4;

frt = instr[25:21];
frb = instr[15:11];

// Read FP operand (full 64 bits for double precision)
f1 = frf[frb];

// Map OpenPOWER FPSCR[RN] to canonical IEEE 754 rounding mode
rm = {1'b0, fpscr[1], fpscr[1] ^ fpscr[0]};

// Perform double-precision square root with rounding mode
sqrt_result = fp_sqrt_d(f1, rm);

// Write result
frf[frt] when (~instr_trap_taken) = sqrt_result;
