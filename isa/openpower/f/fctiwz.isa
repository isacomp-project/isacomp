// SPDX-License-Identifier: BSD-3-Clause
// OpenPOWER fctiwz - Floating Convert to Integer Word with Round toward Zero (X-Form)
// fctiwz FRT,FRB (Rc=0)
// Primary opcode 63, XO=15
// FRT <- Convert_to_Integer_Word_Truncate(FRB)

isa_state pc[63:0];
var instr[31:0];
isa_state rf[63:0][4:0];
isa_state frf[63:0][4:0];
isa_state fpscr[31:0];
mem umem[14:0];

var frt[4:0];
var frb[4:0];
var f1[31:0];
var result[31:0];
var rm[2:0];  // Rounding mode in canonical IEEE 754 encoding

#ifdef VM
aspect mmu.isa gates pc, msr, srr0, srr1;
instr = umem[pc_pa];
#else
instr = umem[pc];
#endif
assume instr[31:26] == 63;     // Primary opcode 63
assume instr[20:16] == 0;      // FRA must be 0
assume instr[10:1] == 15;      // XO = 15 (fctiwz)
assume instr[0] == 0;          // Rc = 0

pc = pc + 4;

frt = instr[25:21];
frb = instr[15:11];

// Get single-precision value from lower 32 bits
f1 = frf[frb][31:0];

// fctiwz uses Round toward Zero (RTZ = 001 in canonical encoding)
rm = 3'b001;

// Convert float to integer with truncation (round toward zero)
result = fp_cvt_w_s(f1, rm);

// Store result in FRT (sign-extended to 64 bits in upper, result in lower)
frf[frt] when (~instr_trap_taken) = {32'b0, result};
