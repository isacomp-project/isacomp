// SPDX-License-Identifier: BSD-3-Clause
// OpenPOWER fcfidus - Floating Convert From Integer Doubleword Unsigned Single (X-Form)
// fcfidus FRT,FRB (Rc=0)
// Primary opcode 59, XO=974
// FRT <- Convert unsigned int64 in FRB to single-precision

isa_state pc[63:0];
var instr[31:0];
isa_state rf[63:0][4:0];
isa_state frf[63:0][4:0];
isa_state fpscr[31:0];
mem umem[14:0];

var frt[4:0];
var frb[4:0];
var int_val[63:0];
var fp_result[63:0];
var rm[2:0];

#ifdef VM
aspect mmu.isa gates pc, msr, srr0, srr1;
instr = umem[pc_pa];
#else
instr = umem[pc];
#endif
assume instr[31:26] == 59;     // Primary opcode 59
assume instr[10:1] == 974;     // XO = 974 (fcfidus)
assume instr[0] == 0;          // Rc = 0

pc = pc + 4;

frt = instr[25:21];
frb = instr[15:11];

// Read unsigned integer value from FP register
int_val = frf[frb];

// Map OpenPOWER FPSCR[RN] to canonical IEEE 754 rounding mode
rm = {1'b0, fpscr[1], fpscr[1] ^ fpscr[0]};

// Convert unsigned int64 to single precision
fp_result = fp_cvt_s_lu(int_val, rm);

frf[frt] when (~instr_trap_taken) = fp_result;
