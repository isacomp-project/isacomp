// SPDX-License-Identifier: BSD-3-Clause
// OpenPOWER fctid - Floating Convert To Integer Doubleword (X-Form)
// fctid FRT,FRB (Rc=0)
// Primary opcode 63, XO=814
// FRT <- Convert double-precision in FRB to signed int64 (with rounding)

isa_state pc[63:0];
var instr[31:0];
isa_state rf[63:0][4:0];
isa_state frf[63:0][4:0];
isa_state fpscr[31:0];
mem umem[14:0];

var frt[4:0];
var frb[4:0];
var fp_val[63:0];
var int_result[63:0];
var rm[2:0];  // Rounding mode in canonical IEEE 754 encoding

#ifdef VM
aspect mmu.isa gates pc, msr, srr0, srr1;
instr = umem[pc_pa];
#else
instr = umem[pc];
#endif
assume instr[31:26] == 63;     // Primary opcode 63
assume instr[10:1] == 814;     // XO = 814 (fctid)
assume instr[0] == 0;          // Rc = 0

pc = pc + 4;

frt = instr[25:21];
frb = instr[15:11];

// Read double-precision value
fp_val = frf[frb];

// Map OpenPOWER FPSCR[RN] to canonical IEEE 754 rounding mode
rm = {1'b0, fpscr[1], fpscr[1] ^ fpscr[0]};

// Convert double to signed int64
int_result = fp_cvt_l_d(fp_val, rm);

// Write integer result to FP register
frf[frt] when (~instr_trap_taken) = int_result;
