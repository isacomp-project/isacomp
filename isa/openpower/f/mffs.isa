// SPDX-License-Identifier: BSD-3-Clause
// OpenPOWER mffs - Move From FPSCR (X-Form)
// mffs FRT (Rc=0)
// Primary opcode 63, XO=583
// FRT <- FPSCR

isa_state pc[63:0];
var instr[31:0];
isa_state rf[63:0][4:0];
isa_state frf[63:0][4:0];
isa_state fpscr[31:0];
mem umem[14:0];

var frt[4:0];
var result[63:0];

#ifdef VM
aspect mmu.isa gates pc, msr, srr0, srr1;
instr = umem[pc_pa];
#else
instr = umem[pc];
#endif
assume instr[31:26] == 63;     // Primary opcode 63
assume instr[10:1] == 583;     // XO = 583 (mffs)
assume instr[0] == 0;          // Rc = 0

pc = pc + 4;

frt = instr[25:21];

// FPSCR is 32 bits, placed in low 32 bits of 64-bit FP register
// Upper 32 bits are undefined (set to 0)
result = {32'b0, fpscr};

frf[frt] when (~instr_trap_taken) = result;
