// SPDX-License-Identifier: BSD-3-Clause
// OpenPOWER friz - Floating Round to Integer Toward Zero (X-Form)
// friz FRT,FRB
// Primary opcode 63, XO=424
// Rounds FRB toward zero to an integer, result remains FP format

isa_state pc[63:0];
var instr[31:0];
isa_state rf[63:0][4:0];
isa_state frf[63:0][4:0];
mem umem[14:0];

var frt[4:0];
var frb[4:0];
var fb[63:0];
var fb_sign[0:0];
var fb_exp[10:0];
var fb_mant[51:0];
var unbiased_exp[10:0];
var is_special[0:0];
var is_already_int[0:0];
var int_val[63:0];
var rounded_val[63:0];
var signed_val[63:0];
var result[63:0];

#ifdef VM
aspect mmu.isa gates pc, msr, srr0, srr1;
instr = umem[pc_pa];
#else
instr = umem[pc];
#endif
assume instr[31:26] == 63;     // Primary opcode 63
assume instr[10:1] == 424;     // XO = 424 (friz)

pc = pc + 4;

frt = instr[25:21];
frb = instr[15:11];

fb = frf[frb];

// Extract components
fb_sign = fb[63];
fb_exp = fb[62:52];
fb_mant = fb[51:0];

// Check for special cases
// Infinity or NaN (exp = 0x7FF)
is_special = (fb_exp == 11'h7FF);

// Already integral if exponent >= 1075 (bias 1023 + 52 mantissa bits)
// This means all mantissa bits represent integer part
unbiased_exp = fb_exp - 11'd1023;
is_already_int = (fb_exp >= 11'd1075) || (fb_exp == 0 && fb_mant == 0);

// Use F2I → I2F chain with round-toward-zero mode
// RTZ mode truncates toward zero
int_val = fp_cvt_l_d(fb, 1);   // 1 = RTZ (round toward zero)
rounded_val = fp_cvt_d_l(int_val, 0); // 0 = RNE (doesn't matter, exact)

// Preserve sign for -0.0 case
signed_val = {fb_sign, rounded_val[62:0]};

// If special or already integral, keep original
result = (is_special || is_already_int) ? fb : signed_val;

frf[frt] when (~instr_trap_taken) = result;
