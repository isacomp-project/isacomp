// SPDX-License-Identifier: BSD-3-Clause
// OpenPOWER lfiwax - Load Floating-Point as Integer Word Algebraic Indexed (X-Form)
// lfiwax FRT,RA,RB
// Primary opcode 31, XO=855
// EA <- (RA|0) + (RB)
// FRT <- EXTS(MEM(EA, 4))
// Loads a 32-bit word and sign-extends to 64 bits in FP register

isa_state pc[63:0];
var instr[31:0];
isa_state rf[63:0][4:0];
isa_state frf[63:0][4:0];
mem umem[14:0];

var frt[4:0];
var ra[4:0];
var rb[4:0];
var ra_val[63:0];
var rb_val[63:0];
var ra_or_zero[63:0];
var ea[63:0];
var word_data[31:0];
var result[63:0];

#ifdef VM
aspect mmu.isa gates pc, msr, srr0, srr1;
instr = umem[pc_pa];
#else
instr = umem[pc];
#endif
assume instr[31:26] == 31;     // Primary opcode 31
assume instr[10:1] == 855;     // XO = 855 (lfiwax)

pc = pc + 4;

frt = instr[25:21];
ra = instr[20:16];
rb = instr[15:11];

ra_val = rf[ra];
rb_val = rf[rb];

// If RA=0, use 0; otherwise use (RA)
ra_or_zero = ra == 0 ? 64'h0 : ra_val;
ea = ra_or_zero + rb_val;

// Load 32-bit word from memory
#ifdef VM
aspect mmu_load.isa gates pc, msr, srr0, srr1, dar, dsisr;
word_data = umem[ea_pa];
#else
word_data = umem[ea];
#endif

// Sign-extend to 64 bits
result = {{32{word_data[31]}}, word_data};

// Store in FP register (as integer bits)
frf[frt] when (~load_exception_taken & ~instr_trap_taken) = result;
