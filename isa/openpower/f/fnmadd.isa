// SPDX-License-Identifier: BSD-3-Clause
// OpenPOWER fnmadd - Floating Negative Multiply-Add Double (A-Form)
// fnmadd FRT,FRA,FRC,FRB (Rc=0)
// Primary opcode 63, XO=31
// FRT <- -((FRA * FRC) + FRB) as double precision

isa_state pc[63:0];
var instr[31:0];
isa_state rf[63:0][4:0];
isa_state frf[63:0][4:0];
isa_state fpscr[31:0];
mem umem[14:0];

var frt[4:0];
var fra[4:0];
var frb[4:0];
var frc[4:0];
var f1[63:0];
var f2[63:0];
var f3[63:0];
var fnma_result[63:0];
var rm[2:0];  // Rounding mode in canonical IEEE 754 encoding

#ifdef VM
aspect mmu.isa gates pc, msr, srr0, srr1;
instr = umem[pc_pa];
#else
instr = umem[pc];
#endif
assume instr[31:26] == 63;     // Primary opcode 63
assume instr[5:1] == 31;       // XO = 31 (fnmadd)
assume instr[0] == 0;          // Rc = 0

pc = pc + 4;

frt = instr[25:21];
fra = instr[20:16];
frb = instr[15:11];
frc = instr[10:6];

// Read FP operands
f1 = frf[fra];
f2 = frf[frc];
f3 = frf[frb];

// Map OpenPOWER FPSCR[RN] to canonical IEEE 754 rounding mode
rm = {1'b0, fpscr[1], fpscr[1] ^ fpscr[0]};

// Perform fused negative multiply-add: -((FRA * FRC) + FRB)
fnma_result = fp_fnmadd_d(f1, f2, f3, rm);

// Write result
frf[frt] when (~instr_trap_taken) = fnma_result;
