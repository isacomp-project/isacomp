// SPDX-License-Identifier: BSD-3-Clause
// OpenPOWER fadd - Floating Add Double (A-Form)
// fadd FRT,FRA,FRB (Rc=0)
// Primary opcode 63, XO=21
// FRT <- (FRA) + (FRB) as double precision

isa_state pc[63:0];
var instr[31:0];
isa_state rf[63:0][4:0];       // Integer register file
isa_state frf[63:0][4:0];      // FP register file (64-bit)
isa_state fpscr[31:0];         // FP status and control register
mem umem[14:0];

var frt[4:0];
var fra[4:0];
var frb[4:0];
var f1[63:0];
var f2[63:0];
var add_result[63:0];
var rm[2:0];  // Rounding mode in canonical IEEE 754 encoding

#ifdef VM
aspect mmu.isa gates pc, msr, srr0, srr1;
instr = umem[pc_pa];
#else
instr = umem[pc];
#endif
assume instr[31:26] == 63;     // Primary opcode 63
assume instr[5:1] == 21;       // XO = 21 (fadd)
assume instr[0] == 0;          // Rc = 0

pc = pc + 4;

frt = instr[25:21];
fra = instr[20:16];
frb = instr[15:11];

// Read FP operands (full 64 bits for double precision)
f1 = frf[fra];
f2 = frf[frb];

// Map OpenPOWER FPSCR[RN] to canonical IEEE 754 rounding mode
// OpenPOWER: 00=RNE, 01=RTZ, 10=RUP, 11=RDN
// Canonical: 000=RNE, 001=RTZ, 010=RDN, 011=RUP
rm = {1'b0, fpscr[1], fpscr[1] ^ fpscr[0]};

// Perform double-precision addition with rounding mode
add_result = fp_add_d(f1, f2, rm);

// Write result
frf[frt] when (~instr_trap_taken) = add_result;
