// SPDX-License-Identifier: BSD-3-Clause
// OpenPOWER stfs - Store Floating-Point Single (D-Form)
// stfs FRS,D(RA)
// Primary opcode 52
// MEM(RA + EXTS(D), 4) <- (FRS)[32:63]

isa_state pc[63:0];
var instr[31:0];
isa_state rf[63:0][4:0];
isa_state frf[63:0][4:0];
mem umem[14:0];

var frs[4:0];
var ra[4:0];
var d[15:0];
var ra_val[63:0];
var offset[63:0];
var addr[63:0];
var data[31:0];

#ifdef VM
aspect mmu.isa gates pc, msr, srr0, srr1;
instr = umem[pc_pa];
#else
instr = umem[pc];
#endif
assume instr[31:26] == 52;     // Primary opcode 52 (stfs)

pc = pc + 4;

frs = instr[25:21];
ra = instr[20:16];
d = instr[15:0];

ra_val = rf[ra];
offset = {{48{d[15]}}, d};
addr = ra_val + offset;

// Get lower 32 bits (single-precision value)
data = frf[frs][31:0];

// Store to memory
#ifdef VM
aspect mmu_store.isa gates pc, msr, srr0, srr1, dar, dsisr;
umem[ea_pa] when (~store_exception_taken & ~instr_trap_taken) = {32'b0, data};
#else
umem[ea] = {32'b0, data};
#endif
