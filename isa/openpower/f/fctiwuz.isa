// SPDX-License-Identifier: BSD-3-Clause
// OpenPOWER fctiwuz - Floating Convert To Integer Word Unsigned with Round toward Zero (X-Form)
// fctiwuz FRT,FRB (Rc=0)
// Primary opcode 63, XO=143
// FRT <- Convert double-precision in FRB to unsigned int32 (truncate toward zero)

isa_state pc[63:0];
var instr[31:0];
isa_state rf[63:0][4:0];
isa_state frf[63:0][4:0];
mem umem[14:0];

var frt[4:0];
var frb[4:0];
var fp_val[63:0];
var int_result[31:0];
var rm[2:0];

#ifdef VM
aspect mmu.isa gates pc, msr, srr0, srr1;
instr = umem[pc_pa];
#else
instr = umem[pc];
#endif
assume instr[31:26] == 63;     // Primary opcode 63
assume instr[10:1] == 143;     // XO = 143 (fctiwuz)
assume instr[0] == 0;          // Rc = 0

pc = pc + 4;

frt = instr[25:21];
frb = instr[15:11];

fp_val = frf[frb];

// Round toward Zero (RTZ = 001 in canonical encoding)
rm = 3'b001;

// Convert double to unsigned int32 (truncate toward zero)
int_result = fp_cvt_wu_d(fp_val, rm);

// Result is zero-extended to 64 bits in the FP register
frf[frt] when (~instr_trap_taken) = {32'b0, int_result};
