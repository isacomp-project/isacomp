// SPDX-License-Identifier: BSD-3-Clause
// OpenPOWER fmrgew - Floating Merge Even Word (X-Form)
// fmrgew FRT,FRA,FRB
// Primary opcode 63, XO=966
// FRT <- FRA[0:31] || FRB[0:31]
// Merges the even (high) words from FRA and FRB

isa_state pc[63:0];
var instr[31:0];
isa_state rf[63:0][4:0];
isa_state frf[63:0][4:0];
mem umem[14:0];

var frt[4:0];
var fra[4:0];
var frb[4:0];
var fa[63:0];
var fb[63:0];
var result[63:0];

#ifdef VM
aspect mmu.isa gates pc, msr, srr0, srr1;
instr = umem[pc_pa];
#else
instr = umem[pc];
#endif
assume instr[31:26] == 63;     // Primary opcode 63
assume instr[10:1] == 966;     // XO = 966 (fmrgew)

pc = pc + 4;

frt = instr[25:21];
fra = instr[20:16];
frb = instr[15:11];

fa = frf[fra];
fb = frf[frb];

// Merge even (high) words: FRA[0:31] || FRB[0:31]
result = {fa[63:32], fb[63:32]};

frf[frt] when (~instr_trap_taken) = result;
