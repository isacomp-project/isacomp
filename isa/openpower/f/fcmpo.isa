// SPDX-License-Identifier: BSD-3-Clause
// OpenPOWER fcmpo - Floating Compare Ordered (X-Form)
// fcmpo BF,FRA,FRB
// Primary opcode 63, XO=32
// Compares FRA and FRB, sets CR field BF
// Similar to fcmpu but raises VXSNAN for signaling NaN

isa_state pc[63:0];
var instr[31:0];
isa_state rf[63:0][4:0];
isa_state frf[63:0][4:0];
isa_state cr[31:0];            // Condition register
isa_state fpscr[31:0];
mem umem[14:0];

var bf[2:0];
var fra[4:0];
var frb[4:0];
var f1[31:0];
var f2[31:0];
var lt_result[0:0];
var eq_result[0:0];
var new_cr[31:0];
var cr_bits[3:0];

#ifdef VM
aspect mmu.isa gates pc, msr, srr0, srr1;
instr = umem[pc_pa];
#else
instr = umem[pc];
#endif
assume instr[31:26] == 63;     // Primary opcode 63
assume instr[10:1] == 32;      // XO = 32 (fcmpo)
assume instr[0] == 0;          // Must be 0

pc = pc + 4;

bf = instr[25:23];
fra = instr[20:16];
frb = instr[15:11];

f1 = frf[fra][31:0];
f2 = frf[frb][31:0];

// Compare: lt=1 if fra < frb, eq=1 if fra == frb
lt_result = fp_lt(f1, f2);
eq_result = fp_eq(f1, f2);

// Build CR field: FL FG FE FU (less, greater, equal, unordered)
// Simplified: set less/equal bits, greater = !less && !equal
cr_bits = {lt_result[0], (~lt_result[0] & ~eq_result[0]), eq_result[0], 1'b0};

// Update CR field (bf selects which 4-bit field, starting from high bits)
new_cr = cr;
// For now, simplified update to CR field 0
new_cr[31:28] = cr_bits;

cr = new_cr;
