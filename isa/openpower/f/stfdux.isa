// SPDX-License-Identifier: BSD-3-Clause
// OpenPOWER stfdux - Store Floating-Point Double with Update Indexed (X-Form)
// stfdux FRS,RA,RB
// Primary opcode 31, XO=759
// EA <- (RA) + (RB)
// MEM(EA, 8) <- (FRS)
// RA <- EA

isa_state pc[63:0];
var instr[31:0];
isa_state rf[63:0][4:0];
isa_state frf[63:0][4:0];
mem umem[14:0];

var frs[4:0];
var ra[4:0];
var rb[4:0];
var ra_val[63:0];
var rb_val[63:0];
var ea[63:0];
var data[63:0];

#ifdef VM
aspect mmu.isa gates pc, msr, srr0, srr1;
instr = umem[pc_pa];
#else
instr = umem[pc];
#endif
assume instr[31:26] == 31;     // Primary opcode 31
assume instr[10:1] == 759;     // XO = 759 (stfdux)

pc = pc + 4;

frs = instr[25:21];
ra = instr[20:16];
rb = instr[15:11];

// RA cannot be 0 for update forms
assume ra != 0;

ra_val = rf[ra];
rb_val = rf[rb];
ea = ra_val + rb_val;

// Get double-precision value
data = frf[frs];

// Store 64-bit value to memory and update RA
#ifdef VM
aspect mmu_store.isa gates pc, msr, srr0, srr1, dar, dsisr;
umem[ea_pa] when (~store_exception_taken & ~instr_trap_taken) = data;
#else
umem[ea] = data;
#endif
#ifdef VM
rf[ra] when (~store_exception_taken & ~instr_trap_taken) = ea;
#else
rf[ra] = ea;
#endif
