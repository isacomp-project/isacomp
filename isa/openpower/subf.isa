// SPDX-License-Identifier: BSD-3-Clause
// OpenPOWER subf - Subtract From (XO-Form)
// subf RT,RA,RB
// Primary opcode 31, XO=40
// RT <- (RB) - (RA)  (note: subtract FROM)

isa_state pc[63:0];
var instr[31:0];
isa_state rf[63:0][4:0];
mem umem[14:0];

var rt[4:0];
var ra[4:0];
var rb[4:0];
var ra_val[63:0];
var rb_val[63:0];
var result[63:0];

#ifdef VM
aspect mmu.isa gates pc, msr, srr0, srr1;
instr = umem[pc_pa];
#else
instr = umem[pc];
#endif
// Primary opcode 31
assume instr[31:26] == 31;
// XO field = 40 (bits 9:1 for XO-form)
assume instr[9:1] == 40;
// Rc bit = 0 (no record)
assume instr[0] == 0;
// OE bit = 0 (no overflow)
assume instr[10] == 0;

// Extract register fields
rt = instr[25:21];
ra = instr[20:16];
rb = instr[15:11];

ra_val = rf[ra];
rb_val = rf[rb];

// Note: subf computes RB - RA (subtract FROM)
result = rb_val - ra_val;

#ifdef VM
rf[rt] when (~instr_trap_taken) = result;
#else
rf[rt] = result;
#endif
pc = pc + 4;
