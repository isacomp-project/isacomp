// SPDX-License-Identifier: BSD-3-Clause
// OpenPOWER dcbtst - Data Cache Block Touch for Store (X-Form)
// dcbtst RA,RB,TH
// Primary opcode 31, XO=246
// Prefetch hint - requests that the cache block containing EA
// be brought into the data cache with exclusive access for writing.
// if RA = 0 then b <- 0 else b <- (RA)
// EA <- b + (RB)
// TH (Thread Hint) is in bits 25:21
// Prefetch cache block containing EA for store
//
// This is a performance hint only and is always treated as a no-op
// in simple implementations. The PC is advanced.

isa_state pc[63:0];
var instr[31:0];
isa_state rf[63:0][4:0];
mem umem[14:0];

var ra[4:0];
var rb[4:0];
var th[4:0];
var ra_val[63:0];
var rb_val[63:0];
var ra_or_zero[63:0];
var ea[63:0];

#ifdef VM
aspect mmu.isa gates pc, msr, srr0, srr1;
instr = umem[pc_pa];
#else
instr = umem[pc];
#endif
// Primary opcode 31
assume instr[31:26] == 31;
// XO field = 246
assume instr[10:1] == 246;

// Extract register fields and hint
th = instr[25:21];
ra = instr[20:16];
rb = instr[15:11];

ra_val = rf[ra];
rb_val = rf[rb];

// If RA=0, use 0; otherwise use (RA)
ra_or_zero = ra == 0 ? 64'h0 : ra_val;

// Calculate effective address
ea = ra_or_zero + rb_val;

// No-op - prefetch hints have no architectural effect
// Just advance PC
pc = pc + 4;
