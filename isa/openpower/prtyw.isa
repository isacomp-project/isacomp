// SPDX-License-Identifier: BSD-3-Clause
// OpenPOWER prtyw - Parity Word (X-Form)
// prtyw RA,RS
// Primary opcode 31, XO=154
// RA[32:62] <- 0
// RA[63] <- XOR of all bits in (RS)[32:63]

isa_state pc[63:0];
var instr[31:0];
isa_state rf[63:0][4:0];
mem umem[14:0];

var rs[4:0];
var ra[4:0];
var rs_val[63:0];
var word_val[31:0];
var parity[0:0];
var result[63:0];

#ifdef VM
aspect mmu.isa gates pc, msr, srr0, srr1;
instr = umem[pc_pa];
#else
instr = umem[pc];
#endif
// Primary opcode 31
assume instr[31:26] == 31;
// XO field = 154
assume instr[10:1] == 154;
// Rc bit = 0
assume instr[0] == 0;

// Extract register fields
rs = instr[25:21];
ra = instr[20:16];

rs_val = rf[rs];
word_val = rs_val[31:0];

// Compute parity by XORing all bits
parity = word_val[0] ^ word_val[1] ^ word_val[2] ^ word_val[3] ^
         word_val[4] ^ word_val[5] ^ word_val[6] ^ word_val[7] ^
         word_val[8] ^ word_val[9] ^ word_val[10] ^ word_val[11] ^
         word_val[12] ^ word_val[13] ^ word_val[14] ^ word_val[15] ^
         word_val[16] ^ word_val[17] ^ word_val[18] ^ word_val[19] ^
         word_val[20] ^ word_val[21] ^ word_val[22] ^ word_val[23] ^
         word_val[24] ^ word_val[25] ^ word_val[26] ^ word_val[27] ^
         word_val[28] ^ word_val[29] ^ word_val[30] ^ word_val[31];

// Result: upper 32 bits all zero, bits 32:62 zero, bit 63 = parity
result = {63'd0, parity};

#ifdef VM
rf[ra] when (~instr_trap_taken) = result;
#else
rf[ra] = result;
#endif
pc = pc + 4;
