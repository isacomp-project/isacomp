// SPDX-License-Identifier: BSD-3-Clause
// OpenPOWER subfic - Subtract From Immediate Carrying (D-Form)
// subfic RT,RA,SI
// Primary opcode 8
// RT <- EXTS(SI) - (RA)

isa_state pc[63:0];
var instr[31:0];
isa_state rf[63:0][4:0];
mem umem[14:0];
isa_state xer[63:0];

var rt[4:0];
var ra[4:0];
var si[15:0];
var ra_val[63:0];
var sign_ext_si[63:0];
var result[64:0];

#ifdef VM
aspect mmu.isa gates pc, msr, srr0, srr1;
instr = umem[pc_pa];
#else
instr = umem[pc];
#endif
// Primary opcode 8
assume instr[31:26] == 8;

// Extract fields
rt = instr[25:21];
ra = instr[20:16];
si = instr[15:0];

// Sign-extend SI to 64 bits
sign_ext_si = {{48{si[15]}}, si};
ra_val = rf[ra];

// Compute EXTS(SI) - (RA) using ~RA + SI + 1
result = {1'b0, sign_ext_si} + {1'b0, ~ra_val} + 65'h1;

#ifdef VM
rf[rt] when (~instr_trap_taken) = result[63:0];
#else
rf[rt] = result[63:0];
#endif
// CA = carry out
xer[34] = result[64];
pc = pc + 4;
