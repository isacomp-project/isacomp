// SPDX-License-Identifier: BSD-3-Clause
// OpenPOWER mcrxrx - Move XER to CR Extended (X-Form)
// mcrxrx BF
// Primary opcode 31, XO=576
// Copies XER[OV,OV32,CA,CA32] to CR field BF
// Power ISA 3.0

isa_state pc[63:0];
var instr[31:0];
isa_state rf[63:0][4:0];
mem umem[14:0];
isa_state cr[31:0];
isa_state xer[63:0];
// XER bits:
// XER[32] = SO (Summary Overflow)
// XER[33] = OV (Overflow)
// XER[34] = CA (Carry)
// XER[44] = OV32 (32-bit overflow)
// XER[45] = CA32 (32-bit carry)

var bf[2:0];
var cr_field[3:0];
var cr_field_bit[4:0];
var mask[31:0];
var new_cr[31:0];

#ifdef VM
aspect mmu.isa gates pc, msr, srr0, srr1;
instr = umem[pc_pa];
#else
instr = umem[pc];
#endif
// Primary opcode 31
assume instr[31:26] == 31;
// XO field = 576
assume instr[10:1] == 576;

// Extract BF field (CR field number, bits 25:23)
bf = instr[25:23];

// Build CR field from XER bits: OV, OV32, CA, CA32
cr_field[3] = xer[33];  // OV
cr_field[2] = xer[44];  // OV32
cr_field[1] = xer[34];  // CA
cr_field[0] = xer[45];  // CA32

// Calculate bit position for CR field (BF * 4)
cr_field_bit = {bf, 2'b00};

// Create mask and update CR
mask = 32'hF << (28 - cr_field_bit);
new_cr = (cr & ~mask) | ({28'h0, cr_field} << (28 - cr_field_bit));
cr = new_cr;

pc = pc + 4;
