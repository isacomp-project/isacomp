// SPDX-License-Identifier: BSD-3-Clause
// OpenPOWER rldimi - Rotate Left Doubleword Immediate then Mask Insert (MD-Form)
// rldimi rA, rS, sh, mb
// Primary opcode 30, MD-form (XO bits 2:1 = 11 = 3)
// n <- sh; r <- ROTL64(rS, n); b <- mb; m <- MASK(b, 63-n); rA <- (r & m) | (rA & ~m)
// Inserts rotated bits into rA (preserving non-masked bits)

isa_state pc[63:0];
var instr[31:0];
isa_state rf[63:0][4:0];
mem umem[14:0];

var rs[4:0];
var ra[4:0];
var sh[5:0];
var mb[5:0];
var rs_val[63:0];
var ra_val[63:0];
var rotated[63:0];
var mask_end[5:0];
var mask[63:0];
var masked_rotated[63:0];
var masked_ra[63:0];
var result[63:0];

#ifdef VM
aspect mmu.isa gates pc, msr, srr0, srr1;
instr = umem[pc_pa];
#else
instr = umem[pc];
#endif
// Primary opcode 30
assume instr[31:26] == 30;
// MD-form with XO bits 4:2 = 011 (3) for rldimi
assume instr[4:2] == 3;
// Rc = 0 (non-recording form)
assume instr[0] == 0;

// Extract fields
rs = instr[25:21];
ra = instr[20:16];
// sh = sh5 (bit 1) || sh0:4 (bits 15:11)
sh = {instr[1], instr[15:11]};
// mb = mb5 (bit 5) || mb0:4 (bits 10:6)
mb = {instr[5], instr[10:6]};

// Read registers
rs_val = rf[rs];
ra_val = rf[ra];

// Rotate left by sh
rotated = sh[5:0] == 0 ? rs_val : ((rs_val << sh) | (rs_val >> (64 - sh)));

// MASK(mb, 63-sh) - mask from mb to (63-sh)
mask_end = 63 - sh;

// Generate mask: bits from mb to mask_end are 1
mask = mask_end >= mb ?
    ((64'hFFFFFFFFFFFFFFFF >> mb) & ~(64'hFFFFFFFFFFFFFFFF >> (mask_end + 1))) :
    ((64'hFFFFFFFFFFFFFFFF >> mb) | ~(64'hFFFFFFFFFFFFFFFF >> (mask_end + 1)));

// Insert: (rotated & mask) | (ra & ~mask)
masked_rotated = rotated & mask;
masked_ra = ra_val & ~mask;
result = masked_rotated | masked_ra;

// Write result
#ifdef VM
rf[ra] when (~instr_trap_taken) = result;
#else
rf[ra] = result;
#endif

pc = pc + 4;
