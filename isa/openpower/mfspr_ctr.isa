// SPDX-License-Identifier: BSD-3-Clause
// OpenPOWER mfspr CTR - Move From Count Register
// mfctr RT  (mfspr RT,9)
// Primary opcode 31, XO=339, SPR=9
// RT <- CTR

isa_state pc[63:0];
var instr[31:0];
isa_state rf[63:0][4:0];
mem umem[14:0];
isa_state ctr[63:0];

var rt[4:0];

#ifdef VM
aspect mmu.isa gates pc, msr, srr0, srr1;
instr = umem[pc_pa];
#else
instr = umem[pc];
#endif
assume instr[31:26] == 31;
assume instr[10:1] == 339;
// SPR field for CTR (SPR 9): spr_hi=0, spr_lo=9
assume instr[15:11] == 0;
assume instr[20:16] == 9;

rt = instr[25:21];
#ifdef VM
rf[rt] when (~instr_trap_taken) = ctr;
#else
rf[rt] = ctr;
#endif

pc = pc + 4;
