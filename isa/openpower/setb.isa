// SPDX-License-Identifier: BSD-3-Clause
// OpenPOWER setb - Set Boolean (X-Form)
// setb RT,BFA
// Primary opcode 31, XO=128
// If CR[4*BFA] (LT bit) is 1: RT <- -1 (all 1s)
// Else if CR[4*BFA+1] (GT bit) is 1: RT <- 1
// Else: RT <- 0

isa_state pc[63:0];
var instr[31:0];
isa_state rf[63:0][4:0];
isa_state cr[31:0];
mem umem[14:0];

var rt[4:0];
var bfa[2:0];
var cr_shift[4:0];
var cr_field[3:0];
var lt_bit[0:0];
var gt_bit[0:0];
var result[63:0];

#ifdef VM
aspect mmu.isa gates pc, msr, srr0, srr1;
instr = umem[pc_pa];
#else
instr = umem[pc];
#endif
// Primary opcode 31
assume instr[31:26] == 31;
// XO field = 128
assume instr[10:1] == 128;

// Extract fields
rt = instr[25:21];
bfa = instr[20:18];

// Calculate shift to get CR field (CR0 is bits 31:28, CR7 is bits 3:0)
cr_shift = (7 - bfa) << 2;

// Extract the CR field
cr_field = (cr >> cr_shift) & 4'hF;

// Get LT and GT bits (LT is bit 3, GT is bit 2 of the field)
lt_bit = cr_field[3];
gt_bit = cr_field[2];

// Set result based on LT/GT
result = lt_bit ? 64'hFFFFFFFFFFFFFFFF : (gt_bit ? 64'h1 : 64'h0);

#ifdef VM
rf[rt] when (~instr_trap_taken) = result;
#else
rf[rt] = result;
#endif
pc = pc + 4;
