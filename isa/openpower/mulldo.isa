// SPDX-License-Identifier: BSD-3-Clause
// OpenPOWER mulldo - Multiply Low Doubleword with Overflow (XO-Form)
// mulldo RT,RA,RB
// Primary opcode 31, XO=233, OE=1
// RT <- (RA) * (RB) (low 64 bits)
// Overflow if result doesn't fit in signed 64 bits

isa_state pc[63:0];
var instr[31:0];
isa_state rf[63:0][4:0];
isa_state xer[63:0];
// XER bits:
// XER[32] = SO (Summary Overflow) - sticky
// XER[33] = OV (Overflow)
mem umem[14:0];

var rt[4:0];
var ra[4:0];
var rb[4:0];
var ra_val[63:0];
var rb_val[63:0];
var product[127:0];
var result[63:0];
var overflow[0:0];
var high_bits[63:0];

#ifdef VM
aspect mmu.isa gates pc, msr, srr0, srr1;
instr = umem[pc_pa];
#else
instr = umem[pc];
#endif
// Primary opcode 31
assume instr[31:26] == 31;
// XO field = 233
assume instr[9:1] == 233;
// OE bit = 1 (overflow enable)
assume instr[10] == 1;
// Rc bit = 0
assume instr[0] == 0;

// Extract register fields
rt = instr[25:21];
ra = instr[20:16];
rb = instr[15:11];

ra_val = rf[ra];
rb_val = rf[rb];

// 128-bit product of signed 64-bit values
product = ra_val * rb_val;

// Result is low 64 bits
result = product[63:0];

// High 64 bits
high_bits = product[127:64];

// Overflow if high bits are not sign extension of result[63]
// For signed multiplication, overflow if high != (result[63] ? -1 : 0)
overflow = (high_bits != {{64{result[63]}}});

// Update XER overflow bits
xer[33] = overflow;           // OV
xer[32] = xer[32] | overflow; // SO (sticky)

#ifdef VM
rf[rt] when (~instr_trap_taken) = result;
#else
rf[rt] = result;
#endif
pc = pc + 4;
