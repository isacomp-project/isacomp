// SPDX-License-Identifier: BSD-3-Clause
// OpenPOWER popcntd - Population Count Doubleword (X-Form)
// popcntd RA,RS
// Primary opcode 31, XO=506
// RA <- count of 1-bits in (RS)[0:63]

isa_state pc[63:0];
var instr[31:0];
isa_state rf[63:0][4:0];
mem umem[14:0];

var rs[4:0];
var ra[4:0];
var rs_val[63:0];
var count[7:0];
var result[63:0];

#ifdef VM
aspect mmu.isa gates pc, msr, srr0, srr1;
instr = umem[pc_pa];
#else
instr = umem[pc];
#endif
// Primary opcode 31
assume instr[31:26] == 31;
// XO field = 506
assume instr[10:1] == 506;
// Rc bit = 0
assume instr[0] == 0;

// Extract register fields
rs = instr[25:21];
ra = instr[20:16];

rs_val = rf[rs];

// Count 1-bits by summing all bits
count = {7'd0, rs_val[0]} + {7'd0, rs_val[1]} + {7'd0, rs_val[2]} +
        {7'd0, rs_val[3]} + {7'd0, rs_val[4]} + {7'd0, rs_val[5]} +
        {7'd0, rs_val[6]} + {7'd0, rs_val[7]} + {7'd0, rs_val[8]} +
        {7'd0, rs_val[9]} + {7'd0, rs_val[10]} + {7'd0, rs_val[11]} +
        {7'd0, rs_val[12]} + {7'd0, rs_val[13]} + {7'd0, rs_val[14]} +
        {7'd0, rs_val[15]} + {7'd0, rs_val[16]} + {7'd0, rs_val[17]} +
        {7'd0, rs_val[18]} + {7'd0, rs_val[19]} + {7'd0, rs_val[20]} +
        {7'd0, rs_val[21]} + {7'd0, rs_val[22]} + {7'd0, rs_val[23]} +
        {7'd0, rs_val[24]} + {7'd0, rs_val[25]} + {7'd0, rs_val[26]} +
        {7'd0, rs_val[27]} + {7'd0, rs_val[28]} + {7'd0, rs_val[29]} +
        {7'd0, rs_val[30]} + {7'd0, rs_val[31]} + {7'd0, rs_val[32]} +
        {7'd0, rs_val[33]} + {7'd0, rs_val[34]} + {7'd0, rs_val[35]} +
        {7'd0, rs_val[36]} + {7'd0, rs_val[37]} + {7'd0, rs_val[38]} +
        {7'd0, rs_val[39]} + {7'd0, rs_val[40]} + {7'd0, rs_val[41]} +
        {7'd0, rs_val[42]} + {7'd0, rs_val[43]} + {7'd0, rs_val[44]} +
        {7'd0, rs_val[45]} + {7'd0, rs_val[46]} + {7'd0, rs_val[47]} +
        {7'd0, rs_val[48]} + {7'd0, rs_val[49]} + {7'd0, rs_val[50]} +
        {7'd0, rs_val[51]} + {7'd0, rs_val[52]} + {7'd0, rs_val[53]} +
        {7'd0, rs_val[54]} + {7'd0, rs_val[55]} + {7'd0, rs_val[56]} +
        {7'd0, rs_val[57]} + {7'd0, rs_val[58]} + {7'd0, rs_val[59]} +
        {7'd0, rs_val[60]} + {7'd0, rs_val[61]} + {7'd0, rs_val[62]} +
        {7'd0, rs_val[63]};

// Zero-extend to 64 bits
result = {56'h0, count};

#ifdef VM
rf[ra] when (~instr_trap_taken) = result;
#else
rf[ra] = result;
#endif
pc = pc + 4;
