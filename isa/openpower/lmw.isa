// SPDX-License-Identifier: BSD-3-Clause
// OpenPOWER lmw - Load Multiple Word (D-Form)
// lmw RT,D(RA)
// Primary opcode 46
// Loads consecutive words starting at EA into RT through r31
// Simplified implementation: loads only into RT

isa_state pc[63:0];
var instr[31:0];
isa_state rf[63:0][4:0];
mem umem[14:0];

var rt[4:0];
var ra[4:0];
var d[15:0];
var ra_val[63:0];
var ra_or_zero[63:0];
var sign_ext_d[63:0];
var ea[63:0];
var word_data[31:0];
var result[63:0];

#ifdef VM
aspect mmu.isa gates pc, msr, srr0, srr1;
instr = umem[pc_pa];
#else
instr = umem[pc];
#endif
// Primary opcode 46
assume instr[31:26] == 46;

// Extract fields
rt = instr[25:21];
ra = instr[20:16];
d = instr[15:0];

// Sign-extend displacement
sign_ext_d = {{48{d[15]}}, d};

// If RA=0, use 0; otherwise use (RA)
ra_val = rf[ra];
ra_or_zero = ra == 0 ? 64'h0 : ra_val;

// Calculate effective address
ea = ra_or_zero + sign_ext_d;

// Load word from memory (simplified: only load into RT)
#ifdef VM
aspect mmu_load.isa gates pc, msr, srr0, srr1, dar, dsisr;
word_data = umem[ea_pa];
#else
word_data = umem[ea];
#endif

// Zero-extend to 64 bits (lwz-style, not sign-extend)
result = {32'h0, word_data};

#ifdef VM
rf[rt] when (~load_exception_taken & ~instr_trap_taken) = result;
#else
rf[rt] = result;
#endif
pc = pc + 4;
