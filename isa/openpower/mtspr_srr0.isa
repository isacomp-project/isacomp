// SPDX-License-Identifier: BSD-3-Clause
// OpenPOWER mtspr SRR0 - Move To Save/Restore Register 0
// mtspr 26,RS (SPR 26 = SRR0)
// Primary opcode 31, XO=467

isa_state pc[63:0];
var instr[31:0];
isa_state rf[63:0][4:0];
mem umem[14:0];
isa_state srr0[63:0];

var rs[4:0];
var rs_val[63:0];

#ifdef VM
aspect mmu.isa gates pc, msr, srr0, srr1;
instr = umem[pc_pa];
#else
instr = umem[pc];
#endif
assume instr[31:26] == 31;
assume instr[10:1] == 467;
// SPR field for SRR0 (SPR 26): spr_hi=0, spr_lo=26
assume instr[15:11] == 0;
assume instr[20:16] == 26;

rs = instr[25:21];
rs_val = rf[rs];
srr0 = rs_val;

pc = pc + 4;
