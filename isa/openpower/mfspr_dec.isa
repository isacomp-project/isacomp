// SPDX-License-Identifier: BSD-3-Clause
// OpenPOWER mfspr DEC - Move From Decrementer
// mfspr RT,22 (SPR 22 = DEC)
// Primary opcode 31, XO=339

isa_state pc[63:0];
var instr[31:0];
isa_state rf[63:0][4:0];
mem umem[14:0];
isa_state dec[63:0];

var rt[4:0];
var mfspr_dec_result[63:0];

#ifdef VM
aspect mmu.isa gates pc, msr, srr0, srr1;
instr = umem[pc_pa];
#else
instr = umem[pc];
#endif
assume instr[31:26] == 31;
assume instr[10:1] == 339;
// SPR field for DEC (SPR 22): spr_hi=0, spr_lo=22
assume instr[15:11] == 0;
assume instr[20:16] == 22;

rt = instr[25:21];
mfspr_dec_result = dec;
#ifdef VM
rf[rt] when (~instr_trap_taken) = mfspr_dec_result;
#else
rf[rt] = mfspr_dec_result;
#endif

pc = pc + 4;
