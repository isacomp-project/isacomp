// SPDX-License-Identifier: BSD-3-Clause
// OpenPOWER stdu - Store Doubleword with Update (DS-Form)
// stdu RS,DS(RA)
// Primary opcode 62, XO=1
// EA <- (RA) + EXTS(DS || 0b00)
// MEM(EA, 8) <- (RS)
// RA <- EA
// Note: RA cannot be 0

isa_state pc[63:0];
var instr[31:0];
isa_state rf[63:0][4:0];
mem umem[14:0];

var rs[4:0];
var ra[4:0];
var ds[13:0];
var rs_val[63:0];
var ra_val[63:0];
var sign_ext_ds[63:0];
var ea[63:0];

#ifdef VM
aspect mmu.isa gates pc, msr, srr0, srr1;
instr = umem[pc_pa];
#else
instr = umem[pc];
#endif
// Primary opcode 62
assume instr[31:26] == 62;
// XO field = 1 (bits 1:0)
assume instr[1:0] == 1;

// Extract fields
rs = instr[25:21];
ra = instr[20:16];
ds = instr[15:2];

// RA cannot be 0 for update forms
assume ra != 0;

// Sign-extend displacement (DS || 00)
sign_ext_ds = {{48{ds[13]}}, ds, 2'b00};

// Get RA value
ra_val = rf[ra];

// Calculate effective address
ea = ra_val + sign_ext_ds;

// Get doubleword to store
rs_val = rf[rs];

// Store doubleword to memory and update RA
#ifdef VM
aspect mmu_store.isa gates pc, msr, srr0, srr1, dar, dsisr;
umem[ea_pa] when (~store_exception_taken & ~instr_trap_taken) = rs_val;
#else
umem[ea] = rs_val;
#endif
#ifdef VM
rf[ra] when (~store_exception_taken & ~instr_trap_taken) = ea;
#else
rf[ra] = ea;
#endif
pc = pc + 4;
