// SPDX-License-Identifier: BSD-3-Clause
// OpenPOWER sthux - Store Halfword with Update Indexed (X-Form)
// sthux RS,RA,RB
// Primary opcode 31, XO=439
// EA <- (RA) + (RB)
// MEM(EA, 2) <- (RS)[48:63]
// RA <- EA
// Note: RA cannot be 0

isa_state pc[63:0];
var instr[31:0];
isa_state rf[63:0][4:0];
mem umem[14:0];

var rs[4:0];
var ra[4:0];
var rb[4:0];
var rs_val[63:0];
var ra_val[63:0];
var rb_val[63:0];
var ea[63:0];
var hword_data[15:0];

#ifdef VM
aspect mmu.isa gates pc, msr, srr0, srr1;
instr = umem[pc_pa];
#else
instr = umem[pc];
#endif
// Primary opcode 31
assume instr[31:26] == 31;
// XO field = 439
assume instr[10:1] == 439;

// Extract register fields
rs = instr[25:21];
ra = instr[20:16];
rb = instr[15:11];

// RA cannot be 0 for update forms
assume ra != 0;

ra_val = rf[ra];
rb_val = rf[rb];

// Calculate effective address
ea = ra_val + rb_val;

// Get halfword to store (low 16 bits of RS)
rs_val = rf[rs];
hword_data = rs_val[15:0];

// Store halfword to memory and update RA
#ifdef VM
aspect mmu_store.isa gates pc, msr, srr0, srr1, dar, dsisr;
umem[ea_pa] when (~store_exception_taken & ~instr_trap_taken) = hword_data;
#else
umem[ea] = hword_data;
#endif
#ifdef VM
rf[ra] when (~store_exception_taken & ~instr_trap_taken) = ea;
#else
rf[ra] = ea;
#endif
pc = pc + 4;
