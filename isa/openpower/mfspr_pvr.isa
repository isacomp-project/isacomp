// SPDX-License-Identifier: BSD-3-Clause
// OpenPOWER mfspr PVR - Move From Processor Version Register
// mfspr RT,287 (SPR 287 = PVR)
// Primary opcode 31, XO=339
// PVR is read-only

isa_state pc[63:0];
var instr[31:0];
isa_state rf[63:0][4:0];
mem umem[14:0];
isa_state pvr[31:0];

var rt[4:0];
var mfspr_pvr_result[63:0];

#ifdef VM
aspect mmu.isa gates pc, msr, srr0, srr1;
instr = umem[pc_pa];
#else
instr = umem[pc];
#endif
assume instr[31:26] == 31;
assume instr[10:1] == 339;
// SPR field for PVR (SPR 287): spr_hi=8, spr_lo=31
assume instr[15:11] == 8;
assume instr[20:16] == 31;

rt = instr[25:21];
mfspr_pvr_result = {32'h0, pvr};
#ifdef VM
rf[rt] when (~instr_trap_taken) = mfspr_pvr_result;
#else
rf[rt] = mfspr_pvr_result;
#endif

pc = pc + 4;
