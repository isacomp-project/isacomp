// SPDX-License-Identifier: BSD-3-Clause
// OpenPOWER mullw - Multiply Low Word (XO-Form)
// mullw RT,RA,RB
// Primary opcode 31, XO=235
// RT <- (RA)[32:63] * (RB)[32:63] (low 32 bits of product, sign-extended)

isa_state pc[63:0];
var instr[31:0];
isa_state rf[63:0][4:0];
mem umem[14:0];

var rt[4:0];
var ra[4:0];
var rb[4:0];
var ra_val[31:0];
var rb_val[31:0];
var product[63:0];
var result[63:0];

#ifdef VM
aspect mmu.isa gates pc, msr, srr0, srr1;
instr = umem[pc_pa];
#else
instr = umem[pc];
#endif
// Primary opcode 31
assume instr[31:26] == 31;
// XO field = 235
assume instr[9:1] == 235;
// Rc bit = 0
assume instr[0] == 0;
// OE bit = 0
assume instr[10] == 0;

// Extract register fields
rt = instr[25:21];
ra = instr[20:16];
rb = instr[15:11];

// Get low 32 bits of each register
ra_val = rf[ra][31:0];
rb_val = rf[rb][31:0];

// Multiply and take low 32 bits, sign-extended to 64 bits
product = ra_val * rb_val;
result = {{32{product[31]}}, product[31:0]};

#ifdef VM
rf[rt] when (~instr_trap_taken) = result;
#else
rf[rt] = result;
#endif
pc = pc + 4;
