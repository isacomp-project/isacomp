// SPDX-License-Identifier: BSD-3-Clause
// OpenPOWER mulhwu - Multiply High Word Unsigned (XO-Form)
// mulhwu RT,RA,RB
// Primary opcode 31, XO=11
// Returns high 32 bits of 32x32->64 unsigned multiply
// RT <- high32((RA)[32:63] * unsigned (RB)[32:63])

isa_state pc[63:0];
var instr[31:0];
isa_state rf[63:0][4:0];
mem umem[14:0];

var rt[4:0];
var ra[4:0];
var rb[4:0];
var a_unsigned[31:0];
var b_unsigned[31:0];
var a_ext[63:0];
var b_ext[63:0];
var product[63:0];
var result[63:0];

#ifdef VM
aspect mmu.isa gates pc, msr, srr0, srr1;
instr = umem[pc_pa];
#else
instr = umem[pc];
#endif
// Primary opcode 31
assume instr[31:26] == 31;
// XO field = 11
assume instr[9:1] == 11;
// Rc bit = 0
assume instr[0] == 0;
// OE bit = 0
assume instr[10] == 0;

// Extract register fields
rt = instr[25:21];
ra = instr[20:16];
rb = instr[15:11];

// Get low 32 bits (word)
a_unsigned = rf[ra][31:0];
b_unsigned = rf[rb][31:0];

// Zero-extend to 64 bits
a_ext = {32'h0, a_unsigned};
b_ext = {32'h0, b_unsigned};

// Multiply (64-bit result)
product = a_ext * b_ext;

// Take high 32 bits, sign-extend to 64 bits
result = {{32{product[63]}}, product[63:32]};

#ifdef VM
rf[rt] when (~instr_trap_taken) = result;
#else
rf[rt] = result;
#endif
pc = pc + 4;
