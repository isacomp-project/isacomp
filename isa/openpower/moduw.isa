// SPDX-License-Identifier: BSD-3-Clause
// OpenPOWER moduw - Modulo Unsigned Word (X-Form)
// moduw RT,RA,RB
// Primary opcode 31, XO=267
// RT <- (RA)[32:63] mod (RB)[32:63] (unsigned)

isa_state pc[63:0];
var instr[31:0];
isa_state rf[63:0][4:0];
mem umem[14:0];

var rt[4:0];
var ra[4:0];
var rb[4:0];
var ra_val[31:0];
var rb_val[31:0];
var remainder[31:0];
var result[63:0];

#ifdef VM
aspect mmu.isa gates pc, msr, srr0, srr1;
instr = umem[pc_pa];
#else
instr = umem[pc];
#endif
// Primary opcode 31
assume instr[31:26] == 31;
// XO field = 267
assume instr[10:1] == 267;

// Extract register fields
rt = instr[25:21];
ra = instr[20:16];
rb = instr[15:11];

// Get low 32 bits (word)
ra_val = rf[ra][31:0];
rb_val = rf[rb][31:0];

// Unsigned modulo
remainder = ra_val % rb_val;

// Sign-extend to 64 bits
result = {{32{remainder[31]}}, remainder};

#ifdef VM
rf[rt] when (~instr_trap_taken) = result;
#else
rf[rt] = result;
#endif
pc = pc + 4;
