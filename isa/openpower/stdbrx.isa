// SPDX-License-Identifier: BSD-3-Clause
// OpenPOWER stdbrx - Store Doubleword Byte-Reverse Indexed (X-Form)
// stdbrx RS,RA,RB
// Primary opcode 31, XO=660
// if RA = 0 then b <- 0 else b <- (RA)
// EA <- b + (RB)
// Take full 64 bits of RS, reverse bytes, store
// MEM(EA, 8) <- BYTE_REVERSE((RS))

isa_state pc[63:0];
var instr[31:0];
isa_state rf[63:0][4:0];
mem umem[14:0];

var rs[4:0];
var ra[4:0];
var rb[4:0];
var rs_val[63:0];
var ra_val[63:0];
var rb_val[63:0];
var ra_or_zero[63:0];
var ea[63:0];
var reversed[63:0];

#ifdef VM
aspect mmu.isa gates pc, msr, srr0, srr1;
instr = umem[pc_pa];
#else
instr = umem[pc];
#endif
// Primary opcode 31
assume instr[31:26] == 31;
// XO field = 660
assume instr[10:1] == 660;

// Extract register fields
rs = instr[25:21];
ra = instr[20:16];
rb = instr[15:11];

ra_val = rf[ra];
rb_val = rf[rb];

// If RA=0, use 0; otherwise use (RA)
ra_or_zero = ra == 0 ? 64'h0 : ra_val;

// Calculate effective address
ea = ra_or_zero + rb_val;

// Get doubleword to store
rs_val = rf[rs];

// Reverse bytes: [b0, b1, b2, b3, b4, b5, b6, b7] -> [b7, b6, b5, b4, b3, b2, b1, b0]
reversed = {rs_val[7:0], rs_val[15:8], rs_val[23:16], rs_val[31:24],
            rs_val[39:32], rs_val[47:40], rs_val[55:48], rs_val[63:56]};

// Store reversed doubleword to memory
#ifdef VM
aspect mmu_store.isa gates pc, msr, srr0, srr1, dar, dsisr;
umem[ea_pa] when (~store_exception_taken & ~instr_trap_taken) = reversed;
#else
umem[ea] = reversed;
#endif
pc = pc + 4;
