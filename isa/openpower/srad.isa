// SPDX-License-Identifier: BSD-3-Clause
// OpenPOWER srad - Shift Right Algebraic Doubleword (X-Form)
// srad RA,RS,RB
// Primary opcode 31, XO=794
// n <- (RB)[58:63]
// r <- ROTL64((RS), 64-n)
// m <- MASK(n, 63)
// s <- (RS)[0]
// RA <- r & m | ~m & s*64
// CA <- s & ((r & ~m) != 0)

isa_state pc[63:0];
var instr[31:0];
isa_state rf[63:0][4:0];
mem umem[14:0];
isa_state xer[63:0];

var rs[4:0];
var ra[4:0];
var rb[4:0];
var rs_val[63:0];
var rb_val[63:0];
var shift_amt[6:0];
var sign_bit[0:0];
var result[63:0];

#ifdef VM
aspect mmu.isa gates pc, msr, srr0, srr1;
instr = umem[pc_pa];
#else
instr = umem[pc];
#endif
// Primary opcode 31
assume instr[31:26] == 31;
// XO field = 794
assume instr[10:1] == 794;
// Rc bit = 0
assume instr[0] == 0;

// Extract register fields
rs = instr[25:21];
ra = instr[20:16];
rb = instr[15:11];

rs_val = rf[rs];
rb_val = rf[rb];

sign_bit = rs_val[63];
// Shift amount from low 7 bits of RB
shift_amt = rb_val[6:0];

// Arithmetic shift right
result = shift_amt[6] ? (sign_bit ? 64'hFFFFFFFFFFFFFFFF : 64'h0) : (rs_val >>> shift_amt[5:0]);

// CA is set if negative and any 1-bits were shifted out
xer[34] = sign_bit & ((rs_val << (64 - shift_amt[5:0])) != 0);

#ifdef VM
rf[ra] when (~instr_trap_taken) = result;
#else
rf[ra] = result;
#endif
pc = pc + 4;
