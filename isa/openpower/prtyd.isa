// SPDX-License-Identifier: BSD-3-Clause
// OpenPOWER prtyd - Parity Doubleword (X-Form)
// prtyd RA,RS
// Primary opcode 31, XO=186
// RA[0:62] <- 0
// RA[63] <- XOR of all bits in (RS)[0:63]

isa_state pc[63:0];
var instr[31:0];
isa_state rf[63:0][4:0];
mem umem[14:0];

var rs[4:0];
var ra[4:0];
var rs_val[63:0];
var parity[0:0];
var result[63:0];

#ifdef VM
aspect mmu.isa gates pc, msr, srr0, srr1;
instr = umem[pc_pa];
#else
instr = umem[pc];
#endif
// Primary opcode 31
assume instr[31:26] == 31;
// XO field = 186
assume instr[10:1] == 186;
// Rc bit = 0
assume instr[0] == 0;

// Extract register fields
rs = instr[25:21];
ra = instr[20:16];

rs_val = rf[rs];

// Compute parity by XORing all bits
parity = rs_val[0] ^ rs_val[1] ^ rs_val[2] ^ rs_val[3] ^
         rs_val[4] ^ rs_val[5] ^ rs_val[6] ^ rs_val[7] ^
         rs_val[8] ^ rs_val[9] ^ rs_val[10] ^ rs_val[11] ^
         rs_val[12] ^ rs_val[13] ^ rs_val[14] ^ rs_val[15] ^
         rs_val[16] ^ rs_val[17] ^ rs_val[18] ^ rs_val[19] ^
         rs_val[20] ^ rs_val[21] ^ rs_val[22] ^ rs_val[23] ^
         rs_val[24] ^ rs_val[25] ^ rs_val[26] ^ rs_val[27] ^
         rs_val[28] ^ rs_val[29] ^ rs_val[30] ^ rs_val[31] ^
         rs_val[32] ^ rs_val[33] ^ rs_val[34] ^ rs_val[35] ^
         rs_val[36] ^ rs_val[37] ^ rs_val[38] ^ rs_val[39] ^
         rs_val[40] ^ rs_val[41] ^ rs_val[42] ^ rs_val[43] ^
         rs_val[44] ^ rs_val[45] ^ rs_val[46] ^ rs_val[47] ^
         rs_val[48] ^ rs_val[49] ^ rs_val[50] ^ rs_val[51] ^
         rs_val[52] ^ rs_val[53] ^ rs_val[54] ^ rs_val[55] ^
         rs_val[56] ^ rs_val[57] ^ rs_val[58] ^ rs_val[59] ^
         rs_val[60] ^ rs_val[61] ^ rs_val[62] ^ rs_val[63];

// Result: bits 0:62 all zero, bit 63 = parity
result = {63'd0, parity};

#ifdef VM
rf[ra] when (~instr_trap_taken) = result;
#else
rf[ra] = result;
#endif
pc = pc + 4;
