// SPDX-License-Identifier: BSD-3-Clause
// OpenPOWER divwo - Divide Word with Overflow (XO-Form)
// divwo RT,RA,RB
// Primary opcode 31, XO=491, OE=1
// RT <- (RA)[32:63] / (RB)[32:63] (signed 32-bit, sign-extended)
// Overflow on divide by zero or INT_MIN / -1

isa_state pc[63:0];
var instr[31:0];
isa_state rf[63:0][4:0];
isa_state xer[63:0];
// XER bits:
// XER[32] = SO (Summary Overflow) - sticky
// XER[33] = OV (Overflow)
mem umem[14:0];

var rt[4:0];
var ra[4:0];
var rb[4:0];
var ra_val[31:0];
var rb_val[31:0];
var quotient[31:0];
var result[63:0];
var overflow[0:0];

#ifdef VM
aspect mmu.isa gates pc, msr, srr0, srr1;
instr = umem[pc_pa];
#else
instr = umem[pc];
#endif
// Primary opcode 31
assume instr[31:26] == 31;
// XO field = 491
assume instr[9:1] == 491;
// OE bit = 1 (overflow enable)
assume instr[10] == 1;
// Rc bit = 0
assume instr[0] == 0;

// Extract register fields
rt = instr[25:21];
ra = instr[20:16];
rb = instr[15:11];

// Get low 32 bits (signed)
ra_val = rf[ra][31:0];
rb_val = rf[rb][31:0];

// Overflow conditions:
// 1. Divide by zero
// 2. Most negative / -1 (0x80000000 / 0xFFFFFFFF)
overflow = (rb_val == 32'h0) | ((ra_val == 32'h80000000) & (rb_val == 32'hFFFFFFFF));

// Perform division (quotient undefined on overflow)
quotient = ra_val / rb_val;

// Sign-extend to 64 bits
result = {{32{quotient[31]}}, quotient};

// Update XER overflow bits
xer[33] = overflow;           // OV
xer[32] = xer[32] | overflow; // SO (sticky)

#ifdef VM
rf[rt] when (~instr_trap_taken) = result;
#else
rf[rt] = result;
#endif
pc = pc + 4;
