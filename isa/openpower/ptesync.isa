// SPDX-License-Identifier: BSD-3-Clause
// OpenPOWER ptesync - Page Table Entry Synchronize (X-Form)
// ptesync
// This is an alias for "sync 2" (sync with L=2)
// Primary opcode 31, XO=598, L=2
// Synchronizes page table entry updates
// Ensures all prior page table updates complete before subsequent operations
// Used after modifying page table entries to ensure TLB coherency
// Critical for virtual memory management and TLB invalidation sequences
// In single-core, in-order implementation: modeled as no-op

isa_state pc[63:0];
var instr[31:0];
mem umem[14:0];

var l_field[1:0];

#ifdef VM
aspect mmu.isa gates pc, msr, srr0, srr1;
instr = umem[pc_pa];
#else
instr = umem[pc];
#endif
// Primary opcode 31
assume instr[31:26] == 31;
// XO field = 598
assume instr[10:1] == 598;

// Extract L field and ensure it's 2 for ptesync
l_field = instr[10:9];
assume l_field == 2;

// Ptesync execution: page table entry synchronization
// For single-core implementation, this is a no-op
pc = pc + 4;
