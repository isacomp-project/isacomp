// SPDX-License-Identifier: BSD-3-Clause
// TDMI MRS (Move PSR to Register) - Read CPSR
// Encoding: cond|00010|0|00|1111|Rd|0000|00000000
// MRS{cond} Rd, CPSR

isa_state pc[31:0];
var instr[31:0];
isa_state rf[31:0][3:0];           // R0-R14 User/System mode
isa_state cpsr[31:0];

// Banked registers (declared for state consistency)
isa_state rf_fiq[31:0][2:0];
isa_state rf_irq_sp[31:0];
isa_state rf_irq_lr[31:0];
isa_state rf_svc_sp[31:0];
isa_state rf_svc_lr[31:0];
isa_state rf_abt_sp[31:0];
isa_state rf_abt_lr[31:0];
isa_state rf_und_sp[31:0];
isa_state rf_und_lr[31:0];

isa_state spsr_fiq[31:0];
isa_state spsr_irq[31:0];
isa_state spsr_svc[31:0];
isa_state spsr_abt[31:0];
isa_state spsr_und[31:0];

mem umem[21:0];

var cond[3:0];
var rd[3:0];
var cond_pass[0:0];

var n_flag[0:0];
var z_flag[0:0];
var c_flag[0:0];
var v_flag[0:0];

instr = umem[pc];

// MRS CPSR encoding
assume instr[27:23] == 0b00010;
assume instr[22] == 0b0;           // R=0 for CPSR
assume instr[21:16] == 0b001111;
assume instr[11:0] == 0b000000000000;

cond = instr[31:28];
rd = instr[15:12];

n_flag = cpsr[31];
z_flag = cpsr[30];
c_flag = cpsr[29];
v_flag = cpsr[28];

cond_pass = (cond == 0b1110) |
            ((cond == 0b0000) & z_flag) |
            ((cond == 0b0001) & ~z_flag) |
            ((cond == 0b0010) & c_flag) |
            ((cond == 0b0011) & ~c_flag) |
            ((cond == 0b0100) & n_flag) |
            ((cond == 0b0101) & ~n_flag) |
            ((cond == 0b0110) & v_flag) |
            ((cond == 0b0111) & ~v_flag) |
            ((cond == 0b1000) & c_flag & ~z_flag) |
            ((cond == 0b1001) & (~c_flag | z_flag)) |
            ((cond == 0b1010) & (n_flag == v_flag)) |
            ((cond == 0b1011) & (n_flag != v_flag)) |
            ((cond == 0b1100) & ~z_flag & (n_flag == v_flag)) |
            ((cond == 0b1101) & (z_flag | (n_flag != v_flag)));

// Write CPSR to Rd
rf[rd] when (cond_pass & (rd != 0b1111)) = cpsr;

pc = pc + 4;
