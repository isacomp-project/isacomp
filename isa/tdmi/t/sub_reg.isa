// SPDX-License-Identifier: BSD-3-Clause
// Thumb SUB (register) - Subtract two low registers
// Encoding: 000|11|0|1|Rm|Rn|Rd (Format 2)
// SUB Rd, Rn, Rm

isa_state pc[31:0];
var instr[15:0];
isa_state rf[31:0][3:0];
isa_state cpsr[31:0];
mem umem[13:0];

var rd[2:0];
var rn[2:0];
var rm[2:0];
var Rn_val[31:0];
var Rm_val[31:0];
var result[31:0];

var new_n[0:0];
var new_z[0:0];
var new_c[0:0];
var new_v[0:0];
var new_cpsr[31:0];

instr = umem[pc];

assume instr[15:9] == 0b0001101;

rd = instr[2:0];
rn = instr[5:3];
rm = instr[8:6];

Rn_val = rf[{1'b0, rn}];
Rm_val = rf[{1'b0, rm}];

result = Rn_val - Rm_val;

new_n = result[31];
new_z = (result == 0);
new_c = (Rn_val >= Rm_val);
new_v = ((Rn_val[31] != Rm_val[31]) & (result[31] != Rn_val[31]));

new_cpsr = {new_n, new_z, new_c, new_v, cpsr[27:0]};

rf[{1'b0, rd}] = result;
cpsr = new_cpsr;
pc = pc + 2;
