// SPDX-License-Identifier: BSD-3-Clause
// TDMI MSR (Move to PSR) - Write to SPSR from register
// Encoding: cond|00010|1|10|mask|1111|00000000|Rm
// MSR{cond} SPSR_<fields>, Rm
//
// Field mask bits (19:16):
//   bit 19 (f): flags field (bits 31:24)
//   bit 18 (s): status field (bits 23:16)
//   bit 17 (x): extension field (bits 15:8)
//   bit 16 (c): control field (bits 7:0)

isa_state pc[31:0];
var instr[31:0];
isa_state rf[31:0][3:0];           // R0-R14 User/System mode
isa_state cpsr[31:0];

// Banked registers
isa_state rf_fiq[31:0][2:0];
isa_state rf_irq_sp[31:0];
isa_state rf_irq_lr[31:0];
isa_state rf_svc_sp[31:0];
isa_state rf_svc_lr[31:0];
isa_state rf_abt_sp[31:0];
isa_state rf_abt_lr[31:0];
isa_state rf_und_sp[31:0];
isa_state rf_und_lr[31:0];

// Saved Program Status Registers
isa_state spsr_fiq[31:0];
isa_state spsr_irq[31:0];
isa_state spsr_svc[31:0];
isa_state spsr_abt[31:0];
isa_state spsr_und[31:0];

mem umem[21:0];

var cond[3:0];
var field_mask[3:0];
var rm[3:0];
var Rm_val[31:0];
var cond_pass[0:0];

var n_flag[0:0];
var z_flag[0:0];
var c_flag[0:0];
var v_flag[0:0];

// Mode detection
var mode[4:0];
var is_fiq[0:0];
var is_irq[0:0];
var is_svc[0:0];
var is_abt[0:0];
var is_und[0:0];

// Byte masks
var byte3_mask[7:0];
var byte2_mask[7:0];
var byte1_mask[7:0];
var byte0_mask[7:0];

// Current and new SPSR values
var current_spsr[31:0];
var new_spsr[31:0];

instr = umem[pc];

// MSR SPSR register encoding
assume instr[27:23] == 0b00010;
assume instr[22] == 0b1;           // R=1 for SPSR
assume instr[21:20] == 0b10;
assume instr[15:12] == 0b1111;
assume instr[11:4] == 0b00000000;

cond = instr[31:28];
field_mask = instr[19:16];
rm = instr[3:0];

n_flag = cpsr[31];
z_flag = cpsr[30];
c_flag = cpsr[29];
v_flag = cpsr[28];

cond_pass = (cond == 0b1110) |
            ((cond == 0b0000) & z_flag) |
            ((cond == 0b0001) & ~z_flag) |
            ((cond == 0b0010) & c_flag) |
            ((cond == 0b0011) & ~c_flag) |
            ((cond == 0b0100) & n_flag) |
            ((cond == 0b0101) & ~n_flag) |
            ((cond == 0b0110) & v_flag) |
            ((cond == 0b0111) & ~v_flag) |
            ((cond == 0b1000) & c_flag & ~z_flag) |
            ((cond == 0b1001) & (~c_flag | z_flag)) |
            ((cond == 0b1010) & (n_flag == v_flag)) |
            ((cond == 0b1011) & (n_flag != v_flag)) |
            ((cond == 0b1100) & ~z_flag & (n_flag == v_flag)) |
            ((cond == 0b1101) & (z_flag | (n_flag != v_flag)));

// Detect current processor mode
mode = cpsr[4:0];
is_fiq = (mode == 5'b10001);
is_irq = (mode == 5'b10010);
is_svc = (mode == 5'b10011);
is_abt = (mode == 5'b10111);
is_und = (mode == 5'b11011);

// Read source register
Rm_val = (rm == 0b1111) ? (pc + 8) : rf[rm];

// Get current SPSR for this mode
current_spsr = is_fiq ? spsr_fiq :
               is_irq ? spsr_irq :
               is_svc ? spsr_svc :
               is_abt ? spsr_abt :
               is_und ? spsr_und :
               32'b0;  // User/System - UNPREDICTABLE

// Compute byte masks
byte3_mask = field_mask[3] ? 8'hFF : 8'h00;
byte2_mask = field_mask[2] ? 8'hFF : 8'h00;
byte1_mask = field_mask[1] ? 8'hFF : 8'h00;
byte0_mask = field_mask[0] ? 8'hFF : 8'h00;

// Compute new SPSR by merging fields
new_spsr = {(Rm_val[31:24] & byte3_mask) | (current_spsr[31:24] & ~byte3_mask),
            (Rm_val[23:16] & byte2_mask) | (current_spsr[23:16] & ~byte2_mask),
            (Rm_val[15:8] & byte1_mask) | (current_spsr[15:8] & ~byte1_mask),
            (Rm_val[7:0] & byte0_mask) | (current_spsr[7:0] & ~byte0_mask)};

// Update the appropriate SPSR based on current mode
spsr_fiq when (cond_pass & is_fiq) = new_spsr;
spsr_irq when (cond_pass & is_irq) = new_spsr;
spsr_svc when (cond_pass & is_svc) = new_spsr;
spsr_abt when (cond_pass & is_abt) = new_spsr;
spsr_und when (cond_pass & is_und) = new_spsr;

pc = pc + 4;
