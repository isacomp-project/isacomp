// SPDX-License-Identifier: BSD-3-Clause
// TDMI SBC (immediate) - Subtract with Carry immediate
// Encoding: cond|00|1|0110|S|Rn|Rd|rotate|imm8
// SBC{S}{cond} Rd, Rn, #imm  (Rd = Rn - imm - !C)

isa_state pc[31:0];
var instr[31:0];
isa_state rf[31:0][3:0];
isa_state cpsr[31:0];

// Banked registers for FIQ mode (R8-R14)
isa_state rf_fiq[31:0][2:0];       // R8_fiq(0) - R14_fiq(6)

// Banked SP/LR for other privileged modes
isa_state rf_irq_sp[31:0];
isa_state rf_irq_lr[31:0];
isa_state rf_svc_sp[31:0];
isa_state rf_svc_lr[31:0];
isa_state rf_abt_sp[31:0];
isa_state rf_abt_lr[31:0];
isa_state rf_und_sp[31:0];
isa_state rf_und_lr[31:0];

// Saved Program Status Registers
isa_state spsr_fiq[31:0];
isa_state spsr_irq[31:0];
isa_state spsr_svc[31:0];
isa_state spsr_abt[31:0];
isa_state spsr_und[31:0];
mem umem[21:0];

var cond[3:0];
var rn[3:0];
var rd[3:0];
var s_bit[0:0];
var rotate[3:0];
var imm8[7:0];
var Rn_val[31:0];
var imm_val[31:0];
var result[31:0];
var cond_pass[0:0];

var shift_amt[4:0];
var imm_extended[31:0];
var not_c[0:0];

var n_flag[0:0];
var z_flag[0:0];
var c_flag[0:0];
var v_flag[0:0];

// Mode detection
var mode[4:0];
var is_fiq[0:0];
var is_irq[0:0];
var is_svc[0:0];
var is_abt[0:0];
var is_und[0:0];
var rn_fiq_idx[2:0];
var rd_fiq_idx[2:0];

var new_n[0:0];
var new_z[0:0];
var new_c[0:0];
var new_v[0:0];
var new_cpsr[31:0];

instr = umem[pc];

assume instr[27:26] == 0b00;
assume instr[25] == 0b1;
assume instr[24:21] == 0b0110;  // SBC opcode

cond = instr[31:28];
s_bit = instr[20];
rn = instr[19:16];
rd = instr[15:12];
rotate = instr[11:8];
imm8 = instr[7:0];

n_flag = cpsr[31];
z_flag = cpsr[30];
c_flag = cpsr[29];
v_flag = cpsr[28];

cond_pass = (cond == 0b1110) |
            ((cond == 0b0000) & z_flag) |
            ((cond == 0b0001) & ~z_flag) |
            ((cond == 0b0010) & c_flag) |
            ((cond == 0b0011) & ~c_flag) |
            ((cond == 0b0100) & n_flag) |
            ((cond == 0b0101) & ~n_flag) |
            ((cond == 0b0110) & v_flag) |
            ((cond == 0b0111) & ~v_flag) |
            ((cond == 0b1000) & c_flag & ~z_flag) |
            ((cond == 0b1001) & (~c_flag | z_flag)) |
            ((cond == 0b1010) & (n_flag == v_flag)) |
            ((cond == 0b1011) & (n_flag != v_flag)) |
            ((cond == 0b1100) & ~z_flag & (n_flag == v_flag)) |
            ((cond == 0b1101) & (z_flag | (n_flag != v_flag)));

// Detect current processor mode
mode = cpsr[4:0];
is_fiq = (mode == 5'b10001);
is_irq = (mode == 5'b10010);
is_svc = (mode == 5'b10011);
is_abt = (mode == 5'b10111);
is_und = (mode == 5'b11011);
rn_fiq_idx = rn[2:0];
rd_fiq_idx = rd[2:0];

shift_amt = {rotate, 1'b0};
imm_extended = {24'b0, imm8};
imm_val = (imm_extended >> shift_amt) | (imm_extended << (32 - shift_amt));

// Read Rn with mode-aware banking
Rn_val = (rn == 0b1111) ? (pc + 8) :
         (rn == 4'b1101) ? (is_fiq ? rf_fiq[5] :
                           is_irq ? rf_irq_sp :
                           is_svc ? rf_svc_sp :
                           is_abt ? rf_abt_sp :
                           is_und ? rf_und_sp :
                           rf[13]) :
         (rn == 4'b1110) ? (is_fiq ? rf_fiq[6] :
                           is_irq ? rf_irq_lr :
                           is_svc ? rf_svc_lr :
                           is_abt ? rf_abt_lr :
                           is_und ? rf_und_lr :
                           rf[14]) :
         ((rn[3] == 1'b1) & (rn != 4'b1111) & is_fiq) ? rf_fiq[rn_fiq_idx] :
         rf[rn];

// SBC: result = Rn - imm - !C = Rn + ~imm + C
not_c = ~c_flag;
result = Rn_val - imm_val - {31'b0, not_c};

new_n = result[31];
new_z = (result == 0);
// Carry (no borrow): Rn >= imm + !C
new_c = c_flag ? (Rn_val >= imm_val) : (Rn_val > imm_val);
// Overflow
new_v = ((Rn_val[31] != imm_val[31]) & (result[31] != Rn_val[31]));

new_cpsr = {new_n, new_z, new_c, new_v, cpsr[27:0]};

// Write to Rd with mode-aware banking
rf[rd] when (cond_pass & (rd != 4'b1111) & (rd != 4'b1101) & (rd != 4'b1110) & ~(is_fiq & rd[3])) = result;
rf_fiq[rd_fiq_idx] when (cond_pass & is_fiq & rd[3] & (rd != 4'b1101) & (rd != 4'b1110)) = result;
rf_fiq[5] when (cond_pass & is_fiq & (rd == 4'b1101)) = result;
rf_fiq[6] when (cond_pass & is_fiq & (rd == 4'b1110)) = result;
rf[13] when (cond_pass & ~is_fiq & ~is_irq & ~is_svc & ~is_abt & ~is_und & (rd == 4'b1101)) = result;
rf[14] when (cond_pass & ~is_fiq & ~is_irq & ~is_svc & ~is_abt & ~is_und & (rd == 4'b1110)) = result;
rf_irq_sp when (cond_pass & is_irq & (rd == 4'b1101)) = result;
rf_irq_lr when (cond_pass & is_irq & (rd == 4'b1110)) = result;
rf_svc_sp when (cond_pass & is_svc & (rd == 4'b1101)) = result;
rf_svc_lr when (cond_pass & is_svc & (rd == 4'b1110)) = result;
rf_abt_sp when (cond_pass & is_abt & (rd == 4'b1101)) = result;
rf_abt_lr when (cond_pass & is_abt & (rd == 4'b1110)) = result;
rf_und_sp when (cond_pass & is_und & (rd == 4'b1101)) = result;
rf_und_lr when (cond_pass & is_und & (rd == 4'b1110)) = result;
// Get current SPSR for Rd=15, S=1 case (restore CPSR from SPSR)
var current_spsr[31:0];
current_spsr = is_fiq ? spsr_fiq :
               is_irq ? spsr_irq :
               is_svc ? spsr_svc :
               is_abt ? spsr_abt :
               is_und ? spsr_und :
               cpsr;  // User/System mode has no SPSR

// When Rd=15, S=1 in privileged mode, CPSR is restored from SPSR
var is_privileged[0:0];
is_privileged = is_fiq | is_irq | is_svc | is_abt | is_und;
var final_cpsr_value[31:0];
final_cpsr_value = ((rd == 4'b1111) & s_bit & is_privileged) ? current_spsr : new_cpsr;

cpsr when (cond_pass & s_bit) = final_cpsr_value;
pc = (cond_pass & (rd == 0b1111)) ? result : (pc + 4);
