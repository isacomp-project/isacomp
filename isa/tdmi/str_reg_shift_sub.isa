// SPDX-License-Identifier: BSD-3-Clause
// TDMI STR (register, scaled, subtract) - Store with scaled negative register offset
// Pre-indexed, subtract, no writeback

isa_state pc[31:0];
var instr[31:0];
isa_state rf[31:0][3:0];
isa_state cpsr[31:0];

// Banked registers for FIQ mode (R8-R14)
isa_state rf_fiq[31:0][2:0];       // R8_fiq(0) - R14_fiq(6)

// Banked SP/LR for other privileged modes
isa_state rf_irq_sp[31:0];
isa_state rf_irq_lr[31:0];
isa_state rf_svc_sp[31:0];
isa_state rf_svc_lr[31:0];
isa_state rf_abt_sp[31:0];
isa_state rf_abt_lr[31:0];
isa_state rf_und_sp[31:0];
isa_state rf_und_lr[31:0];

// Saved Program Status Registers
isa_state spsr_fiq[31:0];
isa_state spsr_irq[31:0];
isa_state spsr_svc[31:0];
isa_state spsr_abt[31:0];
isa_state spsr_und[31:0];
mem umem[21:0];

var cond[3:0];
var rn[3:0];
var rd[3:0];
var rm[3:0];
var shift_imm[4:0];
var shift_type[1:0];
var Rn_val[31:0];
var Rm_val[31:0];
var Rd_val[31:0];
var offset[31:0];
var addr[31:0];
var cond_pass[0:0];

var n_flag[0:0];
var z_flag[0:0];
var c_flag[0:0];
var v_flag[0:0];

// Mode detection
var mode[4:0];
var is_fiq[0:0];
var is_irq[0:0];
var is_svc[0:0];
var is_abt[0:0];
var is_und[0:0];
var rn_fiq_idx[2:0];
var rm_fiq_idx[2:0];
var rd_fiq_idx[2:0];

var lsl_result[31:0];
var lsr_result[31:0];
var asr_result[31:0];
var ror_result[31:0];

instr = umem[pc];

assume instr[27:26] == 0b01;
assume instr[25] == 0b1;       // Register offset
assume instr[24] == 0b1;       // Pre-indexed
assume instr[23] == 0b0;       // Subtract offset (U=0)
assume instr[22] == 0b0;       // Word
assume instr[21] == 0b0;       // No writeback
assume instr[20] == 0b0;       // Store
assume instr[4] == 0b0;        // Scaled register

cond = instr[31:28];
rn = instr[19:16];
rd = instr[15:12];
shift_imm = instr[11:7];
shift_type = instr[6:5];
rm = instr[3:0];

n_flag = cpsr[31];
z_flag = cpsr[30];
c_flag = cpsr[29];
v_flag = cpsr[28];

cond_pass = (cond == 0b1110) |
            ((cond == 0b0000) & z_flag) |
            ((cond == 0b0001) & ~z_flag) |
            ((cond == 0b0010) & c_flag) |
            ((cond == 0b0011) & ~c_flag) |
            ((cond == 0b0100) & n_flag) |
            ((cond == 0b0101) & ~n_flag) |
            ((cond == 0b0110) & v_flag) |
            ((cond == 0b0111) & ~v_flag) |
            ((cond == 0b1000) & c_flag & ~z_flag) |
            ((cond == 0b1001) & (~c_flag | z_flag)) |
            ((cond == 0b1010) & (n_flag == v_flag)) |
            ((cond == 0b1011) & (n_flag != v_flag)) |
            ((cond == 0b1100) & ~z_flag & (n_flag == v_flag)) |
            ((cond == 0b1101) & (z_flag | (n_flag != v_flag)));

// Detect current processor mode
mode = cpsr[4:0];
is_fiq = (mode == 5'b10001);
is_irq = (mode == 5'b10010);
is_svc = (mode == 5'b10011);
is_abt = (mode == 5'b10111);
is_und = (mode == 5'b11011);
rn_fiq_idx = rn[2:0];
rm_fiq_idx = rm[2:0];
rd_fiq_idx = rd[2:0];

// Read Rn with mode-aware banking
Rn_val = (rn == 0b1111) ? (pc + 8) :
         (rn == 4'b1101) ? (is_fiq ? rf_fiq[5] :
                           is_irq ? rf_irq_sp :
                           is_svc ? rf_svc_sp :
                           is_abt ? rf_abt_sp :
                           is_und ? rf_und_sp :
                           rf[13]) :
         (rn == 4'b1110) ? (is_fiq ? rf_fiq[6] :
                           is_irq ? rf_irq_lr :
                           is_svc ? rf_svc_lr :
                           is_abt ? rf_abt_lr :
                           is_und ? rf_und_lr :
                           rf[14]) :
         ((rn[3] == 1'b1) & (rn != 4'b1111) & is_fiq) ? rf_fiq[rn_fiq_idx] :
         rf[rn];
// Read Rm with mode-aware banking
Rm_val = (rm == 0b1111) ? (pc + 8) :
         (rm == 4'b1101) ? (is_fiq ? rf_fiq[5] :
                           is_irq ? rf_irq_sp :
                           is_svc ? rf_svc_sp :
                           is_abt ? rf_abt_sp :
                           is_und ? rf_und_sp :
                           rf[13]) :
         (rm == 4'b1110) ? (is_fiq ? rf_fiq[6] :
                           is_irq ? rf_irq_lr :
                           is_svc ? rf_svc_lr :
                           is_abt ? rf_abt_lr :
                           is_und ? rf_und_lr :
                           rf[14]) :
         ((rm[3] == 1'b1) & (rm != 4'b1111) & is_fiq) ? rf_fiq[rm_fiq_idx] :
         rf[rm];
// Read Rd with mode-aware banking (for store)
Rd_val = (rd == 0b1111) ? (pc + 12) :
         (rd == 4'b1101) ? (is_fiq ? rf_fiq[5] :
                           is_irq ? rf_irq_sp :
                           is_svc ? rf_svc_sp :
                           is_abt ? rf_abt_sp :
                           is_und ? rf_und_sp :
                           rf[13]) :
         (rd == 4'b1110) ? (is_fiq ? rf_fiq[6] :
                           is_irq ? rf_irq_lr :
                           is_svc ? rf_svc_lr :
                           is_abt ? rf_abt_lr :
                           is_und ? rf_und_lr :
                           rf[14]) :
         ((rd[3] == 1'b1) & (rd != 4'b1111) & is_fiq) ? rf_fiq[rd_fiq_idx] :
         rf[rd];

lsl_result = Rm_val << shift_imm;
lsr_result = (shift_imm == 0) ? 32'b0 : (Rm_val >> shift_imm);
asr_result = (shift_imm == 0) ? {{32{Rm_val[31]}}} : ({{32{Rm_val[31]}}, Rm_val} >> shift_imm);
ror_result = (shift_imm == 0) ? {c_flag, Rm_val[31:1]} : ((Rm_val >> shift_imm) | (Rm_val << (32 - shift_imm)));

offset = (shift_type == 0b00) ? lsl_result : ((shift_type == 0b01) ? lsr_result : ((shift_type == 0b10) ? asr_result : ror_result));

addr = Rn_val - offset;

umem[addr] when (cond_pass) = Rd_val;

pc = pc + 4;
