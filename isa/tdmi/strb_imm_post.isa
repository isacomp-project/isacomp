// SPDX-License-Identifier: BSD-3-Clause
// TDMI STRB (immediate offset, post-indexed)
// Post-indexed, add (P=0, U=1, L=0)

isa_state pc[31:0];
var instr[31:0];
isa_state rf[31:0][3:0];
isa_state cpsr[31:0];

// Banked registers for FIQ mode (R8-R14)
isa_state rf_fiq[31:0][2:0];       // R8_fiq(0) - R14_fiq(6)

// Banked SP/LR for other privileged modes
isa_state rf_irq_sp[31:0];
isa_state rf_irq_lr[31:0];
isa_state rf_svc_sp[31:0];
isa_state rf_svc_lr[31:0];
isa_state rf_abt_sp[31:0];
isa_state rf_abt_lr[31:0];
isa_state rf_und_sp[31:0];
isa_state rf_und_lr[31:0];

// Saved Program Status Registers
isa_state spsr_fiq[31:0];
isa_state spsr_irq[31:0];
isa_state spsr_svc[31:0];
isa_state spsr_abt[31:0];
isa_state spsr_und[31:0];
mem umem[21:0];

var cond[3:0];
var rn[3:0];
var rd[3:0];
var offset[11:0];
var Rn_val[31:0];
var Rd_val[31:0];
var addr[31:0];
var new_base[31:0];
var byte_sel[1:0];
var mem_data[31:0];
var new_data[31:0];
var cond_pass[0:0];

var n_flag[0:0];
var z_flag[0:0];
var c_flag[0:0];
var v_flag[0:0];

// Mode detection
var mode[4:0];
var is_fiq[0:0];
var is_irq[0:0];
var is_svc[0:0];
var is_abt[0:0];
var is_und[0:0];
var rn_fiq_idx[2:0];
var rd_fiq_idx[2:0];

instr = umem[pc];

assume instr[27:26] == 0b01;
assume instr[25] == 0b0;       // Immediate offset
assume instr[24] == 0b0;       // Post-indexed
assume instr[23] == 0b1;       // Add offset (U=1)
assume instr[22] == 0b1;       // Byte (B=1)
assume instr[20] == 0b0;       // Store

cond = instr[31:28];
rn = instr[19:16];
rd = instr[15:12];
offset = instr[11:0];

n_flag = cpsr[31];
z_flag = cpsr[30];
c_flag = cpsr[29];
v_flag = cpsr[28];

cond_pass = (cond == 0b1110) |
            ((cond == 0b0000) & z_flag) |
            ((cond == 0b0001) & ~z_flag) |
            ((cond == 0b0010) & c_flag) |
            ((cond == 0b0011) & ~c_flag) |
            ((cond == 0b0100) & n_flag) |
            ((cond == 0b0101) & ~n_flag) |
            ((cond == 0b0110) & v_flag) |
            ((cond == 0b0111) & ~v_flag) |
            ((cond == 0b1000) & c_flag & ~z_flag) |
            ((cond == 0b1001) & (~c_flag | z_flag)) |
            ((cond == 0b1010) & (n_flag == v_flag)) |
            ((cond == 0b1011) & (n_flag != v_flag)) |
            ((cond == 0b1100) & ~z_flag & (n_flag == v_flag)) |
            ((cond == 0b1101) & (z_flag | (n_flag != v_flag)));

// Detect current processor mode
mode = cpsr[4:0];
is_fiq = (mode == 5'b10001);
is_irq = (mode == 5'b10010);
is_svc = (mode == 5'b10011);
is_abt = (mode == 5'b10111);
is_und = (mode == 5'b11011);
rn_fiq_idx = rn[2:0];
rd_fiq_idx = rd[2:0];

// Read Rn with mode-aware banking
Rn_val = (rn == 0b1111) ? (pc + 8) :
         (rn == 4'b1101) ? (is_fiq ? rf_fiq[5] :
                           is_irq ? rf_irq_sp :
                           is_svc ? rf_svc_sp :
                           is_abt ? rf_abt_sp :
                           is_und ? rf_und_sp :
                           rf[13]) :
         (rn == 4'b1110) ? (is_fiq ? rf_fiq[6] :
                           is_irq ? rf_irq_lr :
                           is_svc ? rf_svc_lr :
                           is_abt ? rf_abt_lr :
                           is_und ? rf_und_lr :
                           rf[14]) :
         ((rn[3] == 1'b1) & (rn != 4'b1111) & is_fiq) ? rf_fiq[rn_fiq_idx] :
         rf[rn];
// Read Rd with mode-aware banking (for store)
Rd_val = (rd == 0b1111) ? (pc + 12) :
         (rd == 4'b1101) ? (is_fiq ? rf_fiq[5] :
                           is_irq ? rf_irq_sp :
                           is_svc ? rf_svc_sp :
                           is_abt ? rf_abt_sp :
                           is_und ? rf_und_sp :
                           rf[13]) :
         (rd == 4'b1110) ? (is_fiq ? rf_fiq[6] :
                           is_irq ? rf_irq_lr :
                           is_svc ? rf_svc_lr :
                           is_abt ? rf_abt_lr :
                           is_und ? rf_und_lr :
                           rf[14]) :
         ((rd[3] == 1'b1) & (rd != 4'b1111) & is_fiq) ? rf_fiq[rd_fiq_idx] :
         rf[rd];

// Post-indexed: use base as address, then add offset for writeback
addr = Rn_val;
new_base = Rn_val + {20'b0, offset};

mem_data = umem[addr];
byte_sel = addr[1:0];

var data0[31:0];
var data1[31:0];
var data2[31:0];
var data3[31:0];

data0 = {mem_data[31:8], Rd_val[7:0]};
data1 = {mem_data[31:16], Rd_val[7:0], mem_data[7:0]};
data2 = {mem_data[31:24], Rd_val[7:0], mem_data[15:0]};
data3 = {Rd_val[7:0], mem_data[23:0]};

new_data = (byte_sel == 0b00) ? data0 : ((byte_sel == 0b01) ? data1 : ((byte_sel == 0b10) ? data2 : data3));

umem[addr] when (cond_pass) = new_data;
rf[rn] when (cond_pass & (rn != 0b1111)) = new_base;
// Also update banked registers when in privileged modes
// FIQ mode R8-R12 with explicit indices
rf_fiq[0] when (cond_pass & is_fiq & (rn == 4'b1000)) = new_base;
rf_fiq[1] when (cond_pass & is_fiq & (rn == 4'b1001)) = new_base;
rf_fiq[2] when (cond_pass & is_fiq & (rn == 4'b1010)) = new_base;
rf_fiq[3] when (cond_pass & is_fiq & (rn == 4'b1011)) = new_base;
rf_fiq[4] when (cond_pass & is_fiq & (rn == 4'b1100)) = new_base;
// R13 (SP) in privileged modes
rf_fiq[5] when (cond_pass & (rn == 4'b1101) & is_fiq) = new_base;
rf_irq_sp when (cond_pass & (rn == 4'b1101) & is_irq) = new_base;
rf_svc_sp when (cond_pass & (rn == 4'b1101) & is_svc) = new_base;
rf_abt_sp when (cond_pass & (rn == 4'b1101) & is_abt) = new_base;
rf_und_sp when (cond_pass & (rn == 4'b1101) & is_und) = new_base;
// R14 (LR) in privileged modes
rf_fiq[6] when (cond_pass & (rn == 4'b1110) & is_fiq) = new_base;
rf_irq_lr when (cond_pass & (rn == 4'b1110) & is_irq) = new_base;
rf_svc_lr when (cond_pass & (rn == 4'b1110) & is_svc) = new_base;
rf_abt_lr when (cond_pass & (rn == 4'b1110) & is_abt) = new_base;
rf_und_lr when (cond_pass & (rn == 4'b1110) & is_und) = new_base;

pc = pc + 4;
