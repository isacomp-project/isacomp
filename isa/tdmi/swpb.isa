// SPDX-License-Identifier: BSD-3-Clause
// TDMI SWPB (Swap Byte) - Atomic byte swap
// Encoding: cond|00010|1|00|Rn|Rd|0000|1001|Rm
// SWPB{cond} Rd, Rm, [Rn]
//
// Operation: temp = [Rn] (byte); [Rn] = Rm[7:0]; Rd = zero_extend(temp)
// Atomically swaps a byte between a register and memory

isa_state pc[31:0];
var instr[31:0];
isa_state rf[31:0][3:0];           // R0-R14 User/System mode
isa_state cpsr[31:0];

// Banked registers for FIQ mode (R8-R14)
isa_state rf_fiq[31:0][2:0];       // R8_fiq(0) - R14_fiq(6)

// Banked SP/LR for other privileged modes
isa_state rf_irq_sp[31:0];
isa_state rf_irq_lr[31:0];
isa_state rf_svc_sp[31:0];
isa_state rf_svc_lr[31:0];
isa_state rf_abt_sp[31:0];
isa_state rf_abt_lr[31:0];
isa_state rf_und_sp[31:0];
isa_state rf_und_lr[31:0];

// Saved Program Status Registers
isa_state spsr_fiq[31:0];
isa_state spsr_irq[31:0];
isa_state spsr_svc[31:0];
isa_state spsr_abt[31:0];
isa_state spsr_und[31:0];

mem umem[21:0];

var cond[3:0];
var rn[3:0];
var rd[3:0];
var rm[3:0];
var cond_pass[0:0];

var n_flag[0:0];
var z_flag[0:0];
var c_flag[0:0];
var v_flag[0:0];

// Mode detection
var mode[4:0];
var is_fiq[0:0];
var is_irq[0:0];
var is_svc[0:0];
var is_abt[0:0];
var is_und[0:0];
var rn_fiq_idx[2:0];
var rm_fiq_idx[2:0];
var rd_fiq_idx[2:0];

var Rn_val[31:0];
var Rm_val[31:0];
var mem_word[31:0];
var mem_byte[7:0];
var result[31:0];
var addr[31:0];
var aligned_addr[31:0];
var byte_offset[1:0];
var new_word[31:0];

instr = umem[pc];

// SWPB encoding: B=1
assume instr[27:23] == 0b00010;
assume instr[22] == 0b1;           // B=1 (byte)
assume instr[21:20] == 0b00;
assume instr[11:8] == 0b0000;
assume instr[7:4] == 0b1001;

cond = instr[31:28];
rn = instr[19:16];
rd = instr[15:12];
rm = instr[3:0];

n_flag = cpsr[31];
z_flag = cpsr[30];
c_flag = cpsr[29];
v_flag = cpsr[28];

cond_pass = (cond == 0b1110) |
            ((cond == 0b0000) & z_flag) |
            ((cond == 0b0001) & ~z_flag) |
            ((cond == 0b0010) & c_flag) |
            ((cond == 0b0011) & ~c_flag) |
            ((cond == 0b0100) & n_flag) |
            ((cond == 0b0101) & ~n_flag) |
            ((cond == 0b0110) & v_flag) |
            ((cond == 0b0111) & ~v_flag) |
            ((cond == 0b1000) & c_flag & ~z_flag) |
            ((cond == 0b1001) & (~c_flag | z_flag)) |
            ((cond == 0b1010) & (n_flag == v_flag)) |
            ((cond == 0b1011) & (n_flag != v_flag)) |
            ((cond == 0b1100) & ~z_flag & (n_flag == v_flag)) |
            ((cond == 0b1101) & (z_flag | (n_flag != v_flag)));

// Detect current processor mode
mode = cpsr[4:0];
is_fiq = (mode == 5'b10001);
is_irq = (mode == 5'b10010);
is_svc = (mode == 5'b10011);
is_abt = (mode == 5'b10111);
is_und = (mode == 5'b11011);
rn_fiq_idx = rn[2:0];
rm_fiq_idx = rm[2:0];
rd_fiq_idx = rd[2:0];

// Read Rn (address) with mode-aware banking
Rn_val = (rn == 0b1111) ? (pc + 8) :
         (rn == 4'b1101) ? (is_fiq ? rf_fiq[5] :
                           is_irq ? rf_irq_sp :
                           is_svc ? rf_svc_sp :
                           is_abt ? rf_abt_sp :
                           is_und ? rf_und_sp :
                           rf[13]) :
         (rn == 4'b1110) ? (is_fiq ? rf_fiq[6] :
                           is_irq ? rf_irq_lr :
                           is_svc ? rf_svc_lr :
                           is_abt ? rf_abt_lr :
                           is_und ? rf_und_lr :
                           rf[14]) :
         ((rn[3] == 1'b1) & (rn != 4'b1111) & is_fiq) ? rf_fiq[rn_fiq_idx] :
         rf[rn];

// Read Rm (value to store) with mode-aware banking
Rm_val = (rm == 0b1111) ? (pc + 8) :
         (rm == 4'b1101) ? (is_fiq ? rf_fiq[5] :
                           is_irq ? rf_irq_sp :
                           is_svc ? rf_svc_sp :
                           is_abt ? rf_abt_sp :
                           is_und ? rf_und_sp :
                           rf[13]) :
         (rm == 4'b1110) ? (is_fiq ? rf_fiq[6] :
                           is_irq ? rf_irq_lr :
                           is_svc ? rf_svc_lr :
                           is_abt ? rf_abt_lr :
                           is_und ? rf_und_lr :
                           rf[14]) :
         ((rm[3] == 1'b1) & (rm != 4'b1111) & is_fiq) ? rf_fiq[rm_fiq_idx] :
         rf[rm];

addr = Rn_val;
byte_offset = addr[1:0];
aligned_addr = {addr[31:2], 2'b00};

// Read word from aligned address
mem_word = umem[aligned_addr];

// Extract byte based on offset (little-endian)
mem_byte = (byte_offset == 2'b00) ? mem_word[7:0] :
           (byte_offset == 2'b01) ? mem_word[15:8] :
           (byte_offset == 2'b10) ? mem_word[23:16] :
           mem_word[31:24];

// Zero-extend byte to 32 bits
result = {24'b0, mem_byte};

// Create new word with Rm byte inserted at correct offset
new_word = (byte_offset == 2'b00) ? {mem_word[31:8], Rm_val[7:0]} :
           (byte_offset == 2'b01) ? {mem_word[31:16], Rm_val[7:0], mem_word[7:0]} :
           (byte_offset == 2'b10) ? {mem_word[31:24], Rm_val[7:0], mem_word[15:0]} :
           {Rm_val[7:0], mem_word[23:0]};

// Write updated word to memory
umem[aligned_addr] when (cond_pass) = new_word;

// Write zero-extended byte to Rd
rf[rd] when (cond_pass & (rd != 4'b1101) & (rd != 4'b1110) & ~(is_fiq & rd[3])) = result;
// FIQ mode R8-R12 with explicit indices (workaround for graph merger)
rf_fiq[0] when (cond_pass & is_fiq & (rd == 4'b1000)) = result;
rf_fiq[1] when (cond_pass & is_fiq & (rd == 4'b1001)) = result;
rf_fiq[2] when (cond_pass & is_fiq & (rd == 4'b1010)) = result;
rf_fiq[3] when (cond_pass & is_fiq & (rd == 4'b1011)) = result;
rf_fiq[4] when (cond_pass & is_fiq & (rd == 4'b1100)) = result;
rf_fiq[5] when (cond_pass & is_fiq & (rd == 4'b1101)) = result;
rf_fiq[6] when (cond_pass & is_fiq & (rd == 4'b1110)) = result;
rf[13] when (cond_pass & ~is_fiq & ~is_irq & ~is_svc & ~is_abt & ~is_und & (rd == 4'b1101)) = result;
rf[14] when (cond_pass & ~is_fiq & ~is_irq & ~is_svc & ~is_abt & ~is_und & (rd == 4'b1110)) = result;
rf_irq_sp when (cond_pass & is_irq & (rd == 4'b1101)) = result;
rf_irq_lr when (cond_pass & is_irq & (rd == 4'b1110)) = result;
rf_svc_sp when (cond_pass & is_svc & (rd == 4'b1101)) = result;
rf_svc_lr when (cond_pass & is_svc & (rd == 4'b1110)) = result;
rf_abt_sp when (cond_pass & is_abt & (rd == 4'b1101)) = result;
rf_abt_lr when (cond_pass & is_abt & (rd == 4'b1110)) = result;
rf_und_sp when (cond_pass & is_und & (rd == 4'b1101)) = result;
rf_und_lr when (cond_pass & is_und & (rd == 4'b1110)) = result;

pc = pc + 4;
