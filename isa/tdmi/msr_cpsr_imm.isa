// SPDX-License-Identifier: BSD-3-Clause
// TDMI MSR (Move to PSR) - Write to CPSR from immediate
// Encoding: cond|00110|0|10|mask|1111|rotate|imm8
// MSR{cond} CPSR_<fields>, #imm
//
// Field mask bits (19:16):
//   bit 19 (f): flags field (bits 31:24)
//   bit 18 (s): status field (bits 23:16)
//   bit 17 (x): extension field (bits 15:8)
//   bit 16 (c): control field (bits 7:0)

isa_state pc[31:0];
var instr[31:0];
isa_state rf[31:0][3:0];           // R0-R14 User/System mode
isa_state cpsr[31:0];

// Banked registers (declared for state consistency)
isa_state rf_fiq[31:0][2:0];
isa_state rf_irq_sp[31:0];
isa_state rf_irq_lr[31:0];
isa_state rf_svc_sp[31:0];
isa_state rf_svc_lr[31:0];
isa_state rf_abt_sp[31:0];
isa_state rf_abt_lr[31:0];
isa_state rf_und_sp[31:0];
isa_state rf_und_lr[31:0];

isa_state spsr_fiq[31:0];
isa_state spsr_irq[31:0];
isa_state spsr_svc[31:0];
isa_state spsr_abt[31:0];
isa_state spsr_und[31:0];

mem umem[21:0];

var cond[3:0];
var field_mask[3:0];
var rotate[3:0];
var imm8[7:0];
var cond_pass[0:0];

var n_flag[0:0];
var z_flag[0:0];
var c_flag[0:0];
var v_flag[0:0];

// Mode detection for privileged check
var mode[4:0];
var is_priv[0:0];

// Rotate amount and immediate value
var rotate_amt[4:0];
var imm32[31:0];

// Byte masks
var byte3_mask[7:0];
var byte2_mask[7:0];
var byte1_mask[7:0];
var byte0_mask[7:0];

var new_cpsr[31:0];

instr = umem[pc];

// MSR CPSR immediate encoding
assume instr[27:23] == 0b00110;
assume instr[22] == 0b0;           // R=0 for CPSR
assume instr[21:20] == 0b10;
assume instr[15:12] == 0b1111;

cond = instr[31:28];
field_mask = instr[19:16];
rotate = instr[11:8];
imm8 = instr[7:0];

n_flag = cpsr[31];
z_flag = cpsr[30];
c_flag = cpsr[29];
v_flag = cpsr[28];

cond_pass = (cond == 0b1110) |
            ((cond == 0b0000) & z_flag) |
            ((cond == 0b0001) & ~z_flag) |
            ((cond == 0b0010) & c_flag) |
            ((cond == 0b0011) & ~c_flag) |
            ((cond == 0b0100) & n_flag) |
            ((cond == 0b0101) & ~n_flag) |
            ((cond == 0b0110) & v_flag) |
            ((cond == 0b0111) & ~v_flag) |
            ((cond == 0b1000) & c_flag & ~z_flag) |
            ((cond == 0b1001) & (~c_flag | z_flag)) |
            ((cond == 0b1010) & (n_flag == v_flag)) |
            ((cond == 0b1011) & (n_flag != v_flag)) |
            ((cond == 0b1100) & ~z_flag & (n_flag == v_flag)) |
            ((cond == 0b1101) & (z_flag | (n_flag != v_flag)));

// Check if in privileged mode
mode = cpsr[4:0];
is_priv = (mode != 5'b10000);  // Not User mode

// Compute rotated immediate (rotate right by 2*rotate)
rotate_amt = {rotate, 1'b0};  // rotate * 2

// ROR by rotate_amt (simplified - handle common cases)
imm32 = (rotate == 0) ? {24'b0, imm8} :
        (rotate == 1) ? {imm8[1:0], 24'b0, imm8[7:2]} :
        (rotate == 2) ? {imm8[3:0], 24'b0, imm8[7:4]} :
        (rotate == 3) ? {imm8[5:0], 24'b0, imm8[7:6]} :
        (rotate == 4) ? {imm8, 24'b0} :
        (rotate == 5) ? {2'b0, imm8, 22'b0} :
        (rotate == 6) ? {4'b0, imm8, 20'b0} :
        (rotate == 7) ? {6'b0, imm8, 18'b0} :
        (rotate == 8) ? {8'b0, imm8, 16'b0} :
        (rotate == 9) ? {10'b0, imm8, 14'b0} :
        (rotate == 10) ? {12'b0, imm8, 12'b0} :
        (rotate == 11) ? {14'b0, imm8, 10'b0} :
        (rotate == 12) ? {16'b0, imm8, 8'b0} :
        (rotate == 13) ? {18'b0, imm8, 6'b0} :
        (rotate == 14) ? {20'b0, imm8, 4'b0} :
        {22'b0, imm8, 2'b0};

// Compute byte masks based on field_mask
byte3_mask = field_mask[3] ? 8'hFF : 8'h00;
byte2_mask = (field_mask[2] & is_priv) ? 8'hFF : 8'h00;
byte1_mask = (field_mask[1] & is_priv) ? 8'hFF : 8'h00;
byte0_mask = (field_mask[0] & is_priv) ? 8'hFF : 8'h00;

// Compute new CPSR by merging fields
new_cpsr = {(imm32[31:24] & byte3_mask) | (cpsr[31:24] & ~byte3_mask),
            (imm32[23:16] & byte2_mask) | (cpsr[23:16] & ~byte2_mask),
            (imm32[15:8] & byte1_mask) | (cpsr[15:8] & ~byte1_mask),
            (imm32[7:0] & byte0_mask) | (cpsr[7:0] & ~byte0_mask)};

// Update CPSR
cpsr when (cond_pass) = new_cpsr;

pc = pc + 4;
