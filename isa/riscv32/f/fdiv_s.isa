// SPDX-License-Identifier: BSD-3-Clause
// RISC-V RV32F - FDIV.S (Single-precision floating-point divide)
// Encoding: funct7=0001100, rs2, rs1, rm, rd, opcode=1010011

isa_state pc[31:0];
var instr[31:0];
isa_state rf[31:0][4:0];
isa_state frf[31:0][4:0];
isa_state fcsr[31:0];
mem umem[12:0];

var rs1[4:0];
var rs2[4:0];
var rd[4:0];
var rm[2:0];
var eff_rm[2:0];  // Effective rounding mode (canonical IEEE 754)
var f1[31:0];
var f2[31:0];
var result[31:0];

instr = umem[pc];
assume instr[6:0] == 0b1010011;
assume instr[31:27] == 0b00011;   // FDIV.S funct5
assume instr[26:25] == 0b00;

pc = pc + 4;

rs1 = instr[19:15];
rs2 = instr[24:20];
rd = instr[11:7];
rm = instr[14:12];

// Compute effective rounding mode (rm=111 means use fcsr[7:5])
eff_rm = (rm == 3'b111) ? fcsr[7:5] : rm;

f1 = frf[rs1];
f2 = frf[rs2];

result = fp_div(f1, f2, eff_rm);

frf[rd] = result;
