// SPDX-License-Identifier: BSD-3-Clause
// RISC-V EBREAK instruction
// Causes a breakpoint exception (cause 3)

isa_state pc[31:0];
var instr[31:0];
isa_state rf[31:0][4:0];
mem umem[23:0];
mem csr[11:0];

// Dedicated CSR registers as isa_state (for MMU aspect)
isa_state priv_mode[1:0];
isa_state satp[31:0];
isa_state mtvec[31:0];
isa_state mepc[31:0];
isa_state mcause[31:0];
isa_state mtval[31:0];
isa_state medeleg[31:0];
isa_state sepc[31:0];
isa_state stvec[31:0];
isa_state scause[31:0];
isa_state stval[31:0];
isa_state sscratch[31:0];
isa_state sstatus[31:0];       // Supervisor Status (0x100) - SPP is bit 8
isa_state mscratch[31:0];
isa_state mie[31:0];
isa_state mstatus[31:0];
ext isa_state timer_irq_pending[0:0];

// Virtual memory translation
aspect ../mmu.isa gates pc, priv_mode, mepc, mcause, mtval, sepc, scause, stval, mstatus, sstatus;

instr = umem[pc_vm_result];

// EBREAK instruction encoding: 0x00100073
// opcode: 0b1110011 (SYSTEM)
// funct3: 0b000
// rs1: 0b00000
// rd: 0b00000
// imm[11:0]: 0x001
assume instr[6:0] == 0b1110011;
assume instr[14:12] == 0b000;
assume instr[19:15] == 0b00000;
assume instr[11:7] == 0b00000;
assume instr[31:20] == 12'h001;

// Breakpoint exception handling
// Exception cause = 3 (Breakpoint)
var ebreak_cause[31:0];
ebreak_cause = 3;

// Check if exception should be delegated to S-mode
var ebreak_is_m_mode[0:0];
var ebreak_delegate_to_smode[0:0];
var ebreak_medeleg_bit[0:0];

ebreak_is_m_mode = priv_mode[1] & priv_mode[0];
ebreak_medeleg_bit = medeleg[3];
ebreak_delegate_to_smode = ebreak_medeleg_bit & (~ebreak_is_m_mode);

// Trap vector bases
var ebreak_mtvec_base[31:0];
var ebreak_stvec_base[31:0];
var ebreak_trap_target[31:0];

ebreak_mtvec_base = {mtvec[31:2], 2'b00};
ebreak_stvec_base = {stvec[31:2], 2'b00};
ebreak_trap_target = ebreak_delegate_to_smode ? ebreak_stvec_base : ebreak_mtvec_base;

// Write exception info to M-mode CSRs (when NOT delegating)
// Note: use intermediate variable for pc to prevent ISA compiler from
// merging this write with the mmu.isa aspect's mepc=pc write, which
// would incorrectly use only the aspect's condition (exception_taken)
var ebreak_saved_pc[31:0];
ebreak_saved_pc = pc;
mepc when (~ebreak_delegate_to_smode) = ebreak_saved_pc;
mcause when (~ebreak_delegate_to_smode) = ebreak_cause;
mtval when (~ebreak_delegate_to_smode) = 0;

// Save mstatus when trapping to M-mode: MPIE=MIE, MIE=0, MPP=priv_mode
var ebreak_new_mstatus[31:0];
ebreak_new_mstatus = (mstatus & 32'hFFFFE677) |           // Clear MPP(12:11), MPIE(7), MIE(3)
                     ({31'b0, mstatus[3]} << 7) |          // MPIE = old MIE
                     (priv_mode << 11);                    // MPP = old priv_mode
mstatus when (~ebreak_delegate_to_smode) = ebreak_new_mstatus;

// Write exception info to S-mode CSRs (when delegating)
// Same workaround: use ebreak_saved_pc instead of pc
sepc when (ebreak_delegate_to_smode) = ebreak_saved_pc;
scause when (ebreak_delegate_to_smode) = ebreak_cause;
stval when (ebreak_delegate_to_smode) = 0;

// Save sstatus when trapping to S-mode: SPIE=SIE, SIE=0, SPP=priv_mode[0]
var ebreak_new_sstatus[31:0];
ebreak_new_sstatus = (sstatus & 32'hFFFFFEDD) |            // Clear SPP(8), SPIE(5), SIE(1)
                     ({31'b0, sstatus[1]} << 5) |           // SPIE = old SIE
                     ({31'b0, priv_mode[0]} << 8);          // SPP = old priv_mode[0]
sstatus when (ebreak_delegate_to_smode) = ebreak_new_sstatus;

// Update privilege mode
priv_mode when (~ebreak_delegate_to_smode) = 3;  // Enter M-mode
priv_mode when (ebreak_delegate_to_smode) = 1;   // Enter S-mode

// Jump to trap handler
pc = ebreak_trap_target;
