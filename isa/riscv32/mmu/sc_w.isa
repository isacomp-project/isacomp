// SPDX-License-Identifier: BSD-3-Clause
isa_state pc[31:0];
var instr[31:0];
isa_state rf[31:0][4:0];
mem umem[23:0];

// Dedicated CSR registers as isa_state (for MMU aspect)
isa_state priv_mode[1:0];      // Privilege mode: 0=U-mode, 1=S-mode, 3=M-mode
isa_state satp[31:0];          // Supervisor Address Translation and Protection (0x180)
isa_state mtvec[31:0];         // Machine Trap-Vector Base-Address (0x305)
isa_state mepc[31:0];          // Machine Exception Program Counter (0x341)
isa_state mcause[31:0];        // Machine Cause (0x342)
isa_state mtval[31:0];         // Machine Trap Value (0x343)
isa_state medeleg[31:0];       // Machine Exception Delegation (0x302)
isa_state sepc[31:0];          // Supervisor Exception Program Counter (0x141)
isa_state stvec[31:0];          // Supervisor Trap-Vector Base-Address (0x105)
isa_state scause[31:0];        // Supervisor Cause (0x142)
isa_state stval[31:0];         // Supervisor Trap Value (0x143)
isa_state mie[31:0];           // Machine Interrupt Enable (0x304)
isa_state mstatus[31:0];       // Machine Status (0x300)
isa_state sstatus[31:0];       // Supervisor Status (0x100) - SPP is bit 8
ext isa_state timer_irq_pending[0:0]; // Timer interrupt pending from CLINT

// LR/SC reservation register - stores the reserved address
// Bit 31 = valid, bits 30:0 = address (word-aligned, so lower 2 bits ignored)
isa_state lr_reservation[31:0];

var rs1[4:0];
var rs2[4:0];
var rd[4:0];
var r1[31:0];
var r2[31:0];
var addr[31:0];
var reservation_valid[0:0];
var reservation_match[0:0];
var sc_success[0:0];

// Virtual memory translation for instruction fetch
aspect mmu.isa gates pc, priv_mode, mepc, mcause, mtval, sepc, scause, stval, mstatus, sstatus;

instr = umem[pc_vm_result];
// SC.W opcode: 0b0101111, funct3 = 010 (word), funct5 = 00011
assume instr[6:0] == 0b0101111;
assume instr[14:12] == 0b010;
assume instr[31:27] == 0b00011;

rs1 = instr[19:15];
rs2 = instr[24:20];
rd = instr[11:7];

r1 = rf[rs1];  // Address
r2 = rf[rs2];  // Value to store

addr = r1;

// Virtual memory translation for store address
aspect mmu_store.isa gates pc, priv_mode, mepc, mcause, mtval, sepc, scause, stval, mstatus, sstatus;

// Check if reservation is valid and matches the address
reservation_valid = lr_reservation[31];
reservation_match = (lr_reservation[30:0] == addr_pa[30:0]);
sc_success = reservation_valid & reservation_match;

// Store the value only if reservation is valid, matches, and no page fault
umem[addr_pa] when (sc_success & ~store_exception_taken & ~instr_trap_taken) = r2;

// Write result to rd: 0 = success, 1 = failure
// Skip register write on page fault (trap handler will retry)
rf[rd] when (rd != 0 & ~store_exception_taken & ~instr_trap_taken) = sc_success ? 0 : 1;

// Clear the reservation (but not on page fault - trap handler will retry)
lr_reservation when (~store_exception_taken & ~instr_trap_taken) = 0;

// PC update
pc = pc + 4;
