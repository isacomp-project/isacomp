// SPDX-License-Identifier: BSD-3-Clause
// RISC-V MUL instruction (RV32M extension)
// Multiply: rd = (rs1 * rs2)[31:0]

isa_state pc[31:0];
var instr[31:0];
isa_state rf[31:0][4:0];
mem umem[23:0];

// Dedicated CSR registers as isa_state (for MMU aspect)
isa_state priv_mode[1:0];
isa_state satp[31:0];
isa_state mtvec[31:0];
isa_state mepc[31:0];
isa_state mcause[31:0];
isa_state mtval[31:0];
isa_state medeleg[31:0];
isa_state sepc[31:0];
isa_state stvec[31:0];
isa_state scause[31:0];
isa_state stval[31:0];
isa_state mie[31:0];           // Machine Interrupt Enable (0x304)
isa_state mstatus[31:0];       // Machine Status (0x300)
ext isa_state timer_irq_pending[0:0]; // Timer interrupt pending from CLINT

var rs1[4:0];
var rs2[4:0];
var rd[4:0];
var r1[31:0];
var r2[31:0];
var product[63:0];

// Virtual memory translation
aspect mmu.isa gates pc, priv_mode, mepc, mcause, mtval, sepc, scause, stval, mstatus, sstatus;

instr = umem[pc_vm_result];
// R-type: opcode=0110011, funct3=000, funct7=0000001
assume instr[6:0] == 0b0110011;
assume instr[14:12] == 0b000;
assume instr[31:25] == 0b0000001;

rs1 = instr[19:15];
rs2 = instr[24:20];
rd = instr[11:7];

r1 = rf[rs1];
r2 = rf[rs2];

// Multiply (signed * signed, take lower 32 bits)
product = r1 * r2;

rf[rd] when (rd != 0 & ~instr_trap_taken) = product[31:0];
pc = pc + 4;
