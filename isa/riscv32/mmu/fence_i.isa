// SPDX-License-Identifier: BSD-3-Clause
// FENCE.I - Instruction Fence (Zifencei extension)
// Invalidates the instruction cache to ensure instruction memory coherence.
//
// When an icache is present, this instruction triggers a full cache invalidation.
// For single-cycle processors without icache, this is effectively a NOP.

isa_state pc[31:0];
var instr[31:0];
isa_state rf[31:0][4:0];
mem umem[23:0];

// Dedicated CSR registers as isa_state (for MMU aspect)
isa_state priv_mode[1:0];      // Privilege mode: 0=U-mode, 1=S-mode, 3=M-mode
isa_state satp[31:0];          // Supervisor Address Translation and Protection (0x180)
isa_state mtvec[31:0];         // Machine Trap-Vector Base-Address (0x305)
isa_state mepc[31:0];          // Machine Exception Program Counter (0x341)
isa_state mcause[31:0];        // Machine Cause (0x342)
isa_state mtval[31:0];         // Machine Trap Value (0x343)
isa_state medeleg[31:0];       // Machine Exception Delegation (0x302)
isa_state sepc[31:0];          // Supervisor Exception Program Counter (0x141)
isa_state stvec[31:0];          // Supervisor Trap-Vector Base-Address (0x105)
isa_state scause[31:0];        // Supervisor Cause (0x142)
isa_state stval[31:0];         // Supervisor Trap Value (0x143)
isa_state mie[31:0];           // Machine Interrupt Enable (0x304)
isa_state mstatus[31:0];       // Machine Status (0x300)
isa_state sstatus[31:0];       // Supervisor Status (0x100) - SPP is bit 8
ext isa_state timer_irq_pending[0:0]; // Timer interrupt pending from CLINT

// Virtual memory translation
aspect mmu.isa gates pc, priv_mode, mepc, mcause, mtval, sepc, scause, stval, mstatus, sstatus;

instr = umem[pc_pa];
// FENCE.I: opcode=0001111, funct3=001
assume instr[6:0] == 0b0001111;
assume instr[14:12] == 0b001;

// Flush instruction cache (if present)
// The cache optimization will wire this to the icache's flush input
flush icache;

// Advance PC
pc = pc + 4;
