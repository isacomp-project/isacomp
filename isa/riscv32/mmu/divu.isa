// SPDX-License-Identifier: BSD-3-Clause
// RISC-V DIVU instruction (RV32M extension)
// Unsigned Division: rd = rs1 / rs2

isa_state pc[31:0];
var instr[31:0];
isa_state rf[31:0][4:0];
mem umem[23:0];

isa_state priv_mode[1:0];
isa_state satp[31:0];
isa_state mtvec[31:0];
isa_state mepc[31:0];
isa_state mcause[31:0];
isa_state mtval[31:0];
isa_state medeleg[31:0];
isa_state sepc[31:0];
isa_state stvec[31:0];
isa_state scause[31:0];
isa_state stval[31:0];
isa_state mie[31:0];           // Machine Interrupt Enable (0x304)
isa_state mstatus[31:0];       // Machine Status (0x300)
ext isa_state timer_irq_pending[0:0]; // Timer interrupt pending from CLINT

var rs1[4:0];
var rs2[4:0];
var rd[4:0];
var r1[31:0];
var r2[31:0];
var quotient[31:0];
var div_by_zero[0:0];

aspect mmu.isa gates pc, priv_mode, mepc, mcause, mtval, sepc, scause, stval, mstatus, sstatus;

instr = umem[pc_vm_result];
assume instr[6:0] == 0b0110011;
assume instr[14:12] == 0b101;
assume instr[31:25] == 0b0000001;

rs1 = instr[19:15];
rs2 = instr[24:20];
rd = instr[11:7];

r1 = rf[rs1];
r2 = rf[rs2];

// Division by zero returns all ones (max unsigned)
div_by_zero = (r2 == 0);
quotient = div_by_zero ? 32'hFFFFFFFF : (r1 / r2);

rf[rd] when (rd != 0 & ~instr_trap_taken) = quotient;
pc = pc + 4;
