// FENCE instruction - memory ordering fence
// For single-cycle, single-core processor this is effectively a NOP
// FENCE fm, pred, succ: opcode=0001111, funct3=000
//
// Encoding: imm[11:0]=fm[3:0]|pred[3:0]|succ[3:0] | rs1=0 | funct3=000 | rd=0 | opcode=0001111

isa_state pc[31:0];
var instr[31:0];
isa_state rf[31:0][4:0];
mem umem[12:0];

instr = umem[pc];
assume instr[6:0] == 0b0001111;   // MISC-MEM opcode
assume instr[14:12] == 0b000;     // FENCE funct3

// FENCE is a NOP for single-core - just advance PC
pc = pc + 4;
