// SPDX-License-Identifier: BSD-3-Clause
isa_state pc[31:0];
var instr[31:0];
isa_state rf[31:0][4:0];
mem umem[12:0];

var rs1[4:0];
var rd[4:0];
var r1[31:0];
var imm[11:0];
var sign_ext_imm[31:0];
var jump_dest[31:0];
var ret_addr[31:0];

instr = umem[pc];
assume instr[6:0] == 0b1100111;
assume instr[14:12] == 0x0;
rd = instr[11:7];
rs1 = instr[19:15];

r1 = rf[rs1];

// I-type immediate
imm = instr[31:20];
sign_ext_imm = {{20{imm[11]}}, imm};

ret_addr = pc + 4;
jump_dest = (r1 + sign_ext_imm) & 32'hFFFFFFFE; // Clear bit 0

rf[rd] when (rd != 0) = ret_addr;
pc = jump_dest;
