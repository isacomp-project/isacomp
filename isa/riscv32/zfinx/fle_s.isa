// SPDX-License-Identifier: BSD-3-Clause
// RISC-V RV32 Zfinx - FLE.S (Floating-point less than or equal using integer registers)
// Encoding: funct7=1010000, rs2, rs1, funct3=000, rd, opcode=1010011
// Zfinx: Uses integer register file instead of dedicated FP registers
// Result written to integer register rd

isa_state pc[31:0];
var instr[31:0];
isa_state rf[31:0][4:0];       // Integer register file (holds FP values in Zfinx)
mem umem[12:0];

var rs1[4:0];
var rs2[4:0];
var rd[4:0];
var f1[31:0];
var f2[31:0];
var cmp_result[0:0];
var result[31:0];

instr = umem[pc];
assume instr[6:0] == 0b1010011;
assume instr[31:27] == 0b10100;
assume instr[26:25] == 0b00;
assume instr[14:12] == 0b000;     // FLE.S funct3

pc = pc + 4;

rs1 = instr[19:15];
rs2 = instr[24:20];
rd = instr[11:7];

// Read operands from integer register file
f1 = rf[rs1];
f2 = rf[rs2];

cmp_result = fp_le(f1, f2);
result = {{31{1'b0}}, cmp_result};

rf[rd] when (rd != 0) = result;
