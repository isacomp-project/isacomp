// SPDX-License-Identifier: BSD-3-Clause
// RISC-V RV32 Zfinx - FCVT.S.WU (Convert unsigned 32-bit integer to float using integer registers)
// Encoding: funct7=1101000, rs2=00001, rs1, rm, rd, opcode=1010011
// Zfinx: Uses integer register file instead of dedicated FP registers
// Result written to integer register rd

isa_state pc[31:0];
var instr[31:0];
isa_state rf[31:0][4:0];       // Integer register file (holds FP values in Zfinx)
isa_state fcsr[31:0];          // FP control/status register
mem umem[12:0];

var rs1[4:0];
var rd[4:0];
var rm[2:0];
var eff_rm[2:0];  // Effective rounding mode (canonical IEEE 754)
var r1[31:0];
var result[31:0];

instr = umem[pc];
assume instr[6:0] == 0b1010011;
assume instr[31:27] == 0b11010;   // FCVT.S.W/WU funct5
assume instr[26:25] == 0b00;
assume instr[24:20] == 0b00001;   // rs2 = 1 for FCVT.S.WU

pc = pc + 4;

rs1 = instr[19:15];
rd = instr[11:7];
rm = instr[14:12];

// Compute effective rounding mode (rm=111 means use fcsr[7:5])
eff_rm = (rm == 3'b111) ? fcsr[7:5] : rm;

// Read integer value from register file
r1 = rf[rs1];

result = fp_cvt_s_wu(r1, eff_rm);

// Write FP result to integer register file (skip x0)
rf[rd] when (rd != 0) = result;
