// SPDX-License-Identifier: BSD-3-Clause
isa_state pc[31:0];
var instr[31:0];
isa_state rf[31:0][4:0];
isa_state imem[31:0][9:0];
isa_state dmem[31:0][9:0];

var rs1[4:0];
var rd[4:0];
var r1[31:0];
var byte0[7:0];
var byte1[7:0];
var byte2[7:0];
var byte3[7:0];
var res[31:0];

instr = imem[pc];
assume instr[6:0] == 0b0010011;
assume instr[14:12] == 0b101;
assume instr[31:20] == 0b011010111000;
pc = pc + 4;
rs1 = instr[19:15];
rd = instr[11:7];

r1 = rf[rs1];

// REV8: Reverse byte order (endianness swap)
byte0 = r1[7:0];
byte1 = r1[15:8];
byte2 = r1[23:16];
byte3 = r1[31:24];

// Reverse the order: {byte3, byte2, byte1, byte0} -> {byte0, byte1, byte2, byte3}
res = {byte0, byte1, byte2, byte3};

rf[rd] when (rd != 0) = res;
