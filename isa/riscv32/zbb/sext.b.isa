// SPDX-License-Identifier: BSD-3-Clause
isa_state pc[31:0];
var instr[31:0];
isa_state rf[31:0][4:0];
isa_state imem[31:0][9:0];
isa_state dmem[31:0][9:0];

var rs1[4:0];
var rd[4:0];
var r1[31:0];
var sign_bit[0:0];
var byte_val[7:0];
var res[31:0];

instr = imem[pc];
assume instr[6:0] == 0b0010011;
assume instr[14:12] == 0b001;
assume instr[31:20] == 0b011000000100;
pc = pc + 4;
rs1 = instr[19:15];
rd = instr[11:7];

r1 = rf[rs1];

// SEXT.B: Sign-extend byte (bits [7:0]) to 32 bits
byte_val = r1[7:0];
sign_bit = r1[7:7];
res = {{24{sign_bit}}, byte_val};

rf[rd] when (rd != 0) = res;
