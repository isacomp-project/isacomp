// SPDX-License-Identifier: BSD-3-Clause
// RISC-V Zicsr - CSRRWI (Atomic Read/Write CSR Immediate) with F extension fcsr aliasing
// Encoding: csr[11:0], uimm[4:0], funct3=101, rd, opcode=1110011
// Uses 5-bit zero-extended immediate instead of register

isa_state pc[31:0];
var instr[31:0];
isa_state rf[31:0][4:0];
isa_state fcsr[31:0];
isa_state csr[31:0][11:0];
mem umem[12:0];

var rd[4:0];
var csr_addr[11:0];
var uimm[4:0];
var uimm_val[31:0];
var csr_val[31:0];

instr = umem[pc];
assume instr[6:0] == 0b1110011;
assume instr[14:12] == 0b101;
pc = pc + 4;

rd = instr[11:7];
csr_addr = instr[31:20];
uimm = instr[19:15];
uimm_val = {27'b0, uimm};

// CSR address matching
var csrwi_addr_is_fflags[0:0];
var csrwi_addr_is_frm[0:0];
var csrwi_addr_is_fcsr[0:0];
var csrwi_addr_is_f_csr[0:0];

csrwi_addr_is_fflags = (csr_addr == 12'h001);
csrwi_addr_is_frm = (csr_addr == 12'h002);
csrwi_addr_is_fcsr = (csr_addr == 12'h003);
csrwi_addr_is_f_csr = csrwi_addr_is_fflags | csrwi_addr_is_frm | csrwi_addr_is_fcsr;

// Read CSR value with aliasing - mux chain pattern
var csrwi_rd_base[31:0];
var csrwi_rd_s3[31:0];
var csrwi_rd_s2[31:0];
var csrwi_rd_s1[31:0];

csrwi_rd_base = csr[csr_addr];
csrwi_rd_s3 = csrwi_addr_is_fcsr ? fcsr : csrwi_rd_base;
csrwi_rd_s2 = csrwi_addr_is_frm ? {29'b0, fcsr[7:5]} : csrwi_rd_s3;
csrwi_rd_s1 = csrwi_addr_is_fflags ? {27'b0, fcsr[4:0]} : csrwi_rd_s2;
csr_val = csrwi_rd_s1;

// Compute new fcsr values with aliasing
var csrwi_wr_fflags[31:0];
var csrwi_wr_frm[31:0];
var csrwi_wr_full[31:0];
var csrwi_wr_val[31:0];

csrwi_wr_fflags = {fcsr[31:5], uimm_val[4:0]};
csrwi_wr_frm = {fcsr[31:8], uimm_val[2:0], fcsr[4:0]};
csrwi_wr_full = {24'b0, uimm_val[7:0]};  // fcsr is only 8 bits wide

// Build mux chain to select correct fcsr write value
csrwi_wr_val = csrwi_addr_is_fcsr ? csrwi_wr_full :
               (csrwi_addr_is_frm ? csrwi_wr_frm :
               (csrwi_addr_is_fflags ? csrwi_wr_fflags : fcsr));

// Write to fcsr with proper aliasing
fcsr when (csrwi_addr_is_f_csr) = csrwi_wr_val;

// Write to generic CSR array if not an F extension CSR
csr[csr_addr] when (csrwi_addr_is_f_csr == 0) = uimm_val;

// Write old CSR value to destination register (if rd != 0)
rf[rd] when (rd != 0) = csr_val;
