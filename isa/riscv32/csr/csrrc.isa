// SPDX-License-Identifier: BSD-3-Clause
// RISC-V Zicsr - CSRRC (Atomic Read and Clear CSR) with F extension fcsr aliasing
// Encoding: csr[11:0], rs1, funct3=011, rd, opcode=1110011
// Clears bits in CSR according to rs1 mask

isa_state pc[31:0];
var instr[31:0];
isa_state rf[31:0][4:0];
isa_state fcsr[31:0];
isa_state csr[31:0][11:0];
mem umem[12:0];

var rs1[4:0];
var rd[4:0];
var csr_addr[11:0];
var rs1_val[31:0];
var csr_val[31:0];
var new_csr_val[31:0];
var rs1_inv[31:0];

instr = umem[pc];
assume instr[6:0] == 0b1110011;
assume instr[14:12] == 0b011;
pc = pc + 4;

rs1 = instr[19:15];
rd = instr[11:7];
csr_addr = instr[31:20];
rs1_val = rf[rs1];
rs1_inv = rs1_val ^ 32'hFFFFFFFF;

// CSR address matching
var csrc_addr_is_fflags[0:0];
var csrc_addr_is_frm[0:0];
var csrc_addr_is_fcsr[0:0];
var csrc_addr_is_f_csr[0:0];

csrc_addr_is_fflags = (csr_addr == 12'h001);
csrc_addr_is_frm = (csr_addr == 12'h002);
csrc_addr_is_fcsr = (csr_addr == 12'h003);
csrc_addr_is_f_csr = csrc_addr_is_fflags | csrc_addr_is_frm | csrc_addr_is_fcsr;

// Read CSR value with aliasing - mux chain pattern
var csrc_rd_base[31:0];
var csrc_rd_s3[31:0];
var csrc_rd_s2[31:0];
var csrc_rd_s1[31:0];

csrc_rd_base = csr[csr_addr];
csrc_rd_s3 = csrc_addr_is_fcsr ? fcsr : csrc_rd_base;
csrc_rd_s2 = csrc_addr_is_frm ? {29'b0, fcsr[7:5]} : csrc_rd_s3;
csrc_rd_s1 = csrc_addr_is_fflags ? {27'b0, fcsr[4:0]} : csrc_rd_s2;
csr_val = csrc_rd_s1;

// Compute new value (clear bits according to mask)
new_csr_val = csr_val & rs1_inv;

// Compute new fcsr values with aliasing (clear bits)
var csrc_wr_fflags[31:0];
var csrc_wr_frm[31:0];
var csrc_wr_full[31:0];
var csrc_wr_val[31:0];

csrc_wr_fflags = {fcsr[31:5], fcsr[4:0] & rs1_inv[4:0]};
csrc_wr_frm = {fcsr[31:8], fcsr[7:5] & rs1_inv[2:0], fcsr[4:0]};
csrc_wr_full = {24'b0, fcsr[7:0] & rs1_inv[7:0]};  // fcsr is only 8 bits wide

// Build mux chain to select correct fcsr write value
csrc_wr_val = csrc_addr_is_fcsr ? csrc_wr_full :
              (csrc_addr_is_frm ? csrc_wr_frm :
              (csrc_addr_is_fflags ? csrc_wr_fflags : fcsr));

// Only write if rs1 != 0 (rs1=0 means read-only) and addressing F extension CSR
fcsr when (csrc_addr_is_f_csr & (rs1 != 0)) = csrc_wr_val;

csr[csr_addr] when ((csrc_addr_is_f_csr == 0) & (rs1 != 0)) = new_csr_val;

rf[rd] when (rd != 0) = csr_val;
