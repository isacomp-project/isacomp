// SPDX-License-Identifier: BSD-3-Clause
// RISC-V RV32D - FLD (Load double-precision float)
// Encoding: imm[11:0], rs1, funct3=011, rd, opcode=0000111

isa_state pc[31:0];
var instr[31:0];
isa_state rf[31:0][4:0];
isa_state frf[63:0][4:0];
mem umem[12:0];

var rs1[4:0];
var rd[4:0];
var imm[11:0];
var base[31:0];
var offset[31:0];
var addr[31:0];
var fld_data[63:0];

instr = umem[pc];
assume instr[6:0] == 0b0000111;   // LOAD-FP opcode
assume instr[14:12] == 0b011;     // FLD funct3

pc = pc + 4;

rs1 = instr[19:15];
rd = instr[11:7];
imm = instr[31:20];

base = rf[rs1];
offset = {{20{imm[11]}}, imm};  // Sign-extend to 32 bits
addr = base + offset;

// Load doubleword from memory
fld_data = umem[addr];

// Write to FP register
frf[rd] = fld_data;
