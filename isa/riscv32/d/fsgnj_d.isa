// SPDX-License-Identifier: BSD-3-Clause
// RISC-V RV32D - FSGNJ.D (Double-precision sign injection)
// Encoding: funct7=0010001, rs2, rs1, rm=000, rd, opcode=1010011

isa_state pc[31:0];
var instr[31:0];
isa_state rf[31:0][4:0];
isa_state frf[63:0][4:0];
mem umem[12:0];

var rs1[4:0];
var rs2[4:0];
var rd[4:0];
var f1[63:0];
var f2[63:0];
var sgnj_result[63:0];

instr = umem[pc];
assume instr[6:0] == 0b1010011;
assume instr[31:27] == 0b00100;   // FSGNJ funct5
assume instr[26:25] == 0b01;      // fmt = D
assume instr[14:12] == 0b000;     // FSGNJ

pc = pc + 4;

rs1 = instr[19:15];
rs2 = instr[24:20];
rd = instr[11:7];

f1 = frf[rs1];
f2 = frf[rs2];

// Sign of rs2, magnitude of rs1
sgnj_result = {f2[63], f1[62:0]};

frf[rd] = sgnj_result;
