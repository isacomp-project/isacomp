// SPDX-License-Identifier: BSD-3-Clause
// RISC-V RV32D - FMADD.D (Double-precision fused multiply-add)
// Encoding: rs3, fmt=01, rs2, rs1, rm, rd, opcode=1000011

isa_state pc[31:0];
var instr[31:0];
isa_state rf[31:0][4:0];
isa_state frf[63:0][4:0];
isa_state fcsr[31:0];
mem umem[12:0];

var rs1[4:0];
var rs2[4:0];
var rs3[4:0];
var rd[4:0];
var rm[2:0];
var eff_rm[2:0];  // Effective rounding mode (canonical IEEE 754)
var f1[63:0];
var f2[63:0];
var f3[63:0];
var fmadd_result[63:0];

instr = umem[pc];
assume instr[6:0] == 0b1000011;   // FMADD opcode
assume instr[26:25] == 0b01;      // fmt = D

pc = pc + 4;

rs1 = instr[19:15];
rs2 = instr[24:20];
rs3 = instr[31:27];
rd = instr[11:7];
rm = instr[14:12];

// Compute effective rounding mode (rm=111 means use fcsr[7:5])
eff_rm = (rm == 3'b111) ? fcsr[7:5] : rm;

f1 = frf[rs1];
f2 = frf[rs2];
f3 = frf[rs3];

fmadd_result = fp_fmadd_d(f1, f2, f3, eff_rm);

frf[rd] = fmadd_result;
