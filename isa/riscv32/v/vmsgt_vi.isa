// SPDX-License-Identifier: BSD-3-Clause
// RISC-V Vector Extension: vmsgt.vi - Set Mask if Greater Than Signed (immediate)
// Encoding: vmsgt.vi vd, vs2, imm, vm
// Operation: vd.mask[i] = (signed(vs2[i]) > sign_extend(imm))

isa_state pc[31:0];
isa_state vrf[127:0][4:0];
isa_state vl[31:0];
isa_state vtype[31:0];
mem umem[12:0];

var instr[31:0];
var imm[4:0];
var vs2[4:0];
var vd[4:0];
var vm[0:0];
var v2[127:0];
var res[127:0];
var imm_ext[31:0];

instr = umem[pc];
assume instr[6:0] == 0b1010111;
assume instr[14:12] == 0b011;
assume instr[31:26] == 0b011111;

pc = pc + 4;

imm = instr[19:15];
vs2 = instr[24:20];
vd = instr[11:7];
vm = instr[25:25];

v2 = vrf[vs2];
imm_ext = {{27{imm[4]}}, imm};

res = 128'b0;
res[0:0] = (v2[31:0] >s imm_ext) ? 1 : 0;
res[1:1] = (v2[63:32] >s imm_ext) ? 1 : 0;
res[2:2] = (v2[95:64] >s imm_ext) ? 1 : 0;
res[3:3] = (v2[127:96] >s imm_ext) ? 1 : 0;

vrf[vd] = res;
