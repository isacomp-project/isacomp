// SPDX-License-Identifier: BSD-3-Clause
// RISC-V Vector Extension: vzext.vf4 - Zero-extend by 4 (SEW/4 to SEW)
// Encoding: vzext.vf4 vd, vs2, vm
// Operation: vd[i] = zero_extend(vs2[i]) (8-bit to 32-bit)

isa_state pc[31:0];
isa_state vrf[127:0][4:0];
isa_state vl[31:0];
isa_state vtype[31:0];
mem umem[12:0];

var instr[31:0];
var vs2[4:0];
var vd[4:0];
var vm[0:0];
var v2[127:0];
var res[127:0];

instr = umem[pc];
assume instr[6:0] == 0b1010111;
assume instr[14:12] == 0b010;
assume instr[31:26] == 0b010010;
assume instr[19:15] == 0b00100;

pc = pc + 4;

vs2 = instr[24:20];
vd = instr[11:7];
vm = instr[25:25];

v2 = vrf[vs2];

// Zero-extend 8-bit to 32-bit
res[31:0] = {24'b0, v2[7:0]};
res[63:32] = {24'b0, v2[15:8]};
res[95:64] = {24'b0, v2[23:16]};
res[127:96] = {24'b0, v2[31:24]};

vrf[vd] = res;
