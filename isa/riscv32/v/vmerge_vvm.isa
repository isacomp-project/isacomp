// SPDX-License-Identifier: BSD-3-Clause
// RISC-V Vector Extension: vmerge.vvm - Vector Merge (vector-vector, masked)
// Encoding: vmerge.vvm vd, vs2, vs1, v0
// Operation: vd[i] = v0.mask[i] ? vs1[i] : vs2[i]

isa_state pc[31:0];
isa_state vrf[127:0][4:0];
isa_state vl[31:0];
isa_state vtype[31:0];
mem umem[12:0];

var instr[31:0];
var vs1[4:0];
var vs2[4:0];
var vd[4:0];
var v1[127:0];
var v2[127:0];
var v0[127:0];
var res[127:0];

instr = umem[pc];
assume instr[6:0] == 0b1010111;
assume instr[14:12] == 0b000;
assume instr[31:26] == 0b010111;
assume instr[25:25] == 0b0;

pc = pc + 4;

vs1 = instr[19:15];
vs2 = instr[24:20];
vd = instr[11:7];

v1 = vrf[vs1];
v2 = vrf[vs2];
v0 = vrf[0];

res[31:0] = v0[0] ? v1[31:0] : v2[31:0];
res[63:32] = v0[1] ? v1[63:32] : v2[63:32];
res[95:64] = v0[2] ? v1[95:64] : v2[95:64];
res[127:96] = v0[3] ? v1[127:96] : v2[127:96];

vrf[vd] = res;
