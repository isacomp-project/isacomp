// SPDX-License-Identifier: BSD-3-Clause
// RISC-V Vector Extension: vrsub.vx - Vector Reverse Subtract (scalar-vector)
// Encoding: vrsub.vx vd, vs2, rs1, vm
// Operation: vd[i] = x[rs1] - vs2[i]

isa_state pc[31:0];
isa_state rf[31:0][4:0];
isa_state vrf[127:0][4:0];
isa_state vl[31:0];
isa_state vtype[31:0];
mem umem[12:0];

var instr[31:0];
var rs1[4:0];
var vs2[4:0];
var vd[4:0];
var vm[0:0];
var scalar[31:0];
var v2[127:0];
var res[127:0];

instr = umem[pc];
// Opcode: 1010111 (OP-V)
assume instr[6:0] == 0b1010111;
// funct3 = 100 (OPIVX)
assume instr[14:12] == 0b100;
// funct6 = 000011 (vrsub)
assume instr[31:26] == 0b000011;

pc = pc + 4;

rs1 = instr[19:15];
vs2 = instr[24:20];
vd = instr[11:7];
vm = instr[25:25];

scalar = rf[rs1];
v2 = vrf[vs2];

res[31:0] = scalar - v2[31:0];
res[63:32] = scalar - v2[63:32];
res[95:64] = scalar - v2[95:64];
res[127:96] = scalar - v2[127:96];

vrf[vd] = res;
