// SPDX-License-Identifier: BSD-3-Clause
// RISC-V Vector Extension: vfmacc.vf - Vector FP Multiply-Accumulate (scalar)
// Encoding: vfmacc.vf vd, rs1, vs2, vm
// Operation: vd[i] = (f[rs1] * vs2[i]) + vd[i]

isa_state pc[31:0];
isa_state frf[31:0][4:0];
isa_state vrf[127:0][4:0];
isa_state vl[31:0];
isa_state vtype[31:0];
isa_state fcsr[31:0];
mem umem[12:0];

var instr[31:0];
var rs1[4:0];
var vs2[4:0];
var vd[4:0];
var vm[0:0];
var scalar[31:0];
var v2[127:0];
var vdest[127:0];
var res[127:0];
var rm[2:0];

instr = umem[pc];
assume instr[6:0] == 0b1010111;
assume instr[14:12] == 0b101;
// funct6 = 101100 (vfmacc)
assume instr[31:26] == 0b101100;

pc = pc + 4;

rs1 = instr[19:15];
vs2 = instr[24:20];
vd = instr[11:7];
vm = instr[25:25];
rm = fcsr[7:5];

scalar = frf[rs1];
v2 = vrf[vs2];
vdest = vrf[vd];

res[31:0] = fp_fmadd(scalar, v2[31:0], vdest[31:0], rm);
res[63:32] = fp_fmadd(scalar, v2[63:32], vdest[63:32], rm);
res[95:64] = fp_fmadd(scalar, v2[95:64], vdest[95:64], rm);
res[127:96] = fp_fmadd(scalar, v2[127:96], vdest[127:96], rm);

vrf[vd] = res;
