// SPDX-License-Identifier: BSD-3-Clause
// RISC-V Vector Extension: vasub.vv - Averaging Signed Subtract (vector-vector)
// Encoding: vasub.vv vd, vs2, vs1, vm
// Operation: vd[i] = (vs2[i] - vs1[i]) >> 1 (signed average)

isa_state pc[31:0];
isa_state vrf[127:0][4:0];
isa_state vl[31:0];
isa_state vtype[31:0];
mem umem[12:0];

var instr[31:0];
var vs1[4:0];
var vs2[4:0];
var vd[4:0];
var vm[0:0];
var v1[127:0];
var v2[127:0];
var res[127:0];
var diff0[32:0];
var diff1[32:0];
var diff2[32:0];
var diff3[32:0];

instr = umem[pc];
assume instr[6:0] == 0b1010111;
assume instr[14:12] == 0b010;
assume instr[31:26] == 0b001011;

pc = pc + 4;

vs1 = instr[19:15];
vs2 = instr[24:20];
vd = instr[11:7];
vm = instr[25:25];

v1 = vrf[vs1];
v2 = vrf[vs2];

diff0 = {v2[31], v2[31:0]} - {v1[31], v1[31:0]};
diff1 = {v2[63], v2[63:32]} - {v1[63], v1[63:32]};
diff2 = {v2[95], v2[95:64]} - {v1[95], v1[95:64]};
diff3 = {v2[127], v2[127:96]} - {v1[127], v1[127:96]};

res[31:0] = diff0[32:1];
res[63:32] = diff1[32:1];
res[95:64] = diff2[32:1];
res[127:96] = diff3[32:1];

vrf[vd] = res;
