// SPDX-License-Identifier: BSD-3-Clause
// RISC-V Vector Extension: vfadd.vv - Vector Floating-Point Add (vector-vector)
// Encoding: vfadd.vv vd, vs2, vs1, vm
// Operation: vd[i] = vs2[i] + vs1[i] (FP add)

isa_state pc[31:0];
isa_state vrf[127:0][4:0];   // Vector register file (holds FP values)
isa_state vl[31:0];
isa_state vtype[31:0];
isa_state fcsr[31:0];        // FP control/status register
mem umem[12:0];

var instr[31:0];
var vs1[4:0];
var vs2[4:0];
var vd[4:0];
var vm[0:0];
var v1[127:0];
var v2[127:0];
var res[127:0];
var rm[2:0];

instr = umem[pc];
assume instr[6:0] == 0b1010111;
// funct3 = 001 (OPFVV - FP vector-vector)
assume instr[14:12] == 0b001;
// funct6 = 000000 (vfadd)
assume instr[31:26] == 0b000000;

pc = pc + 4;

vs1 = instr[19:15];
vs2 = instr[24:20];
vd = instr[11:7];
vm = instr[25:25];
rm = fcsr[7:5];

v1 = vrf[vs1];
v2 = vrf[vs2];

// Element-wise FP addition (4 x 32-bit single-precision)
res[31:0] = fp_add(v2[31:0], v1[31:0], rm);
res[63:32] = fp_add(v2[63:32], v1[63:32], rm);
res[95:64] = fp_add(v2[95:64], v1[95:64], rm);
res[127:96] = fp_add(v2[127:96], v1[127:96], rm);

vrf[vd] = res;
