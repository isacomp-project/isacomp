// SPDX-License-Identifier: BSD-3-Clause
// RISC-V Vector Extension: vle32ff.v - Fault-Only-First Load (32-bit)
// Encoding: vle32ff.v vd, (rs1), vm
// Operation: Load elements, but only fault on first element

isa_state pc[31:0];
isa_state rf[31:0][4:0];
isa_state vrf[127:0][4:0];
isa_state vl[31:0];
isa_state vtype[31:0];
mem umem[12:0];

var instr[31:0];
var rs1[4:0];
var vd[4:0];
var vm[0:0];
var addr[31:0];
var res[127:0];

instr = umem[pc];
assume instr[6:0] == 0b0000111;
assume instr[14:12] == 0b110;
assume instr[31:29] == 0b000;
assume instr[28:26] == 0b000;
assume instr[24:20] == 0b10000;

pc = pc + 4;

rs1 = instr[19:15];
vd = instr[11:7];
vm = instr[25:25];

addr = rf[rs1];

// Load 4 x 32-bit elements (fault-only-first: only first element faults)
res[31:0] = umem[addr];
res[63:32] = umem[addr + 4];
res[95:64] = umem[addr + 8];
res[127:96] = umem[addr + 12];

vrf[vd] = res;
