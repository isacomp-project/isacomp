// SPDX-License-Identifier: BSD-3-Clause
// RISC-V Vector Extension: viota.m - Iota (prefix sum of mask bits)
// Encoding: viota.m vd, vs2, vm
// Operation: vd[i] = popcount(vs2[i-1:0])

isa_state pc[31:0];
isa_state vrf[127:0][4:0];
isa_state vl[31:0];
isa_state vtype[31:0];
mem umem[12:0];

var instr[31:0];
var vs2[4:0];
var vd[4:0];
var vm[0:0];
var v2[127:0];
var res[127:0];
var count[31:0];

instr = umem[pc];
assume instr[6:0] == 0b1010111;
assume instr[14:12] == 0b010;
assume instr[31:26] == 0b010100;
assume instr[19:15] == 0b10000;

pc = pc + 4;

vs2 = instr[24:20];
vd = instr[11:7];
vm = instr[25:25];

v2 = vrf[vs2];

// Count of 1 bits before each element position
// Element 0: count of bits before position 0 = 0
// Element 1: count of bits in positions 0
// Element 2: count of bits in positions 0-1
// Element 3: count of bits in positions 0-2

res[31:0] = 32'b0;  // No bits before element 0
res[63:32] = {31'b0, v2[0]};
res[95:64] = {31'b0, v2[0]} + {31'b0, v2[1]};
res[127:96] = {31'b0, v2[0]} + {31'b0, v2[1]} + {31'b0, v2[2]};

vrf[vd] = res;
