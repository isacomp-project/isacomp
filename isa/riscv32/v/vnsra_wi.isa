// SPDX-License-Identifier: BSD-3-Clause
// RISC-V Vector Extension: vnsra.wi - Narrowing Shift Right Arithmetic (vector-immediate)
// Encoding: vnsra.wi vd, vs2, uimm, vm
// Operation: vd[i] = (signed(vs2[i]) >> uimm)[SEW-1:0] (2*SEW to SEW)

isa_state pc[31:0];
isa_state vrf[127:0][4:0];
isa_state vl[31:0];
isa_state vtype[31:0];
mem umem[12:0];

var instr[31:0];
var uimm[4:0];
var vs2[4:0];
var vd[4:0];
var vm[0:0];
var v2[127:0];
var res[127:0];
var wide0[63:0];
var wide1[63:0];

instr = umem[pc];
assume instr[6:0] == 0b1010111;
assume instr[14:12] == 0b011;
assume instr[31:26] == 0b101101;

pc = pc + 4;

uimm = instr[19:15];
vs2 = instr[24:20];
vd = instr[11:7];
vm = instr[25:25];

v2 = vrf[vs2];

wide0 = v2[63:0];
wide1 = v2[127:64];

res[31:0] = (wide0 >>> uimm);
res[63:32] = (wide1 >>> uimm);
res[95:64] = 32'b0;
res[127:96] = 32'b0;

vrf[vd] = res;
