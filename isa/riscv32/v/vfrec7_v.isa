// SPDX-License-Identifier: BSD-3-Clause
// RISC-V Vector Extension: vfrec7.v - Reciprocal Estimate (7-bit precision)
// Encoding: vfrec7.v vd, vs2, vm
// Operation: vd[i] = 1/vs2[i] (approximate)

isa_state pc[31:0];
isa_state vrf[127:0][4:0];
isa_state vl[31:0];
isa_state vtype[31:0];
isa_state fcsr[31:0];
mem umem[12:0];

var instr[31:0];
var vs2[4:0];
var vd[4:0];
var vm[0:0];
var v2[127:0];
var res[127:0];
var rm[2:0];

instr = umem[pc];
assume instr[6:0] == 0b1010111;
assume instr[14:12] == 0b001;
assume instr[31:26] == 0b010011;
assume instr[19:15] == 0b00101;

pc = pc + 4;

vs2 = instr[24:20];
vd = instr[11:7];
vm = instr[25:25];
rm = fcsr[7:5];

v2 = vrf[vs2];

// Reciprocal estimate - using fp_div(1.0, x) as approximation
// Note: true vfrec7 has 7-bit precision lookup table behavior
res[31:0] = fp_div(32'h3f800000, v2[31:0], rm);
res[63:32] = fp_div(32'h3f800000, v2[63:32], rm);
res[95:64] = fp_div(32'h3f800000, v2[95:64], rm);
res[127:96] = fp_div(32'h3f800000, v2[127:96], rm);

vrf[vd] = res;
