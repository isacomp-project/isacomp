// SPDX-License-Identifier: BSD-3-Clause
// RISC-V Vector Extension: vsetvl - Set Vector Length
// Encoding: vsetvl rd, rs1, rs2
// Sets vl based on AVL in rs1 and vtype in rs2

isa_state pc[31:0];
isa_state rf[31:0][4:0];
isa_state vl[31:0];          // Vector length
isa_state vtype[31:0];       // Vector type register
mem umem[12:0];

var instr[31:0];
var rs1[4:0];
var rs2[4:0];
var rd[4:0];
var avl[31:0];
var new_vtype[31:0];
var new_vl[31:0];

instr = umem[pc];
// Opcode for vector config: 1010111 (OP-V)
assume instr[6:0] == 0b1010111;
// funct3 = 111 for vsetvl
assume instr[14:12] == 0b111;
// funct7 = 1000000 for vsetvl
assume instr[31:25] == 0b1000000;

pc = pc + 4;

rs1 = instr[19:15];
rs2 = instr[24:20];
rd = instr[11:7];

// Read AVL from rs1
avl = rf[rs1];

// Read new vtype from rs2
new_vtype = rf[rs2];

// Set vl based on AVL
new_vl = avl;

// Update vtype
vtype = new_vtype;

// Update vl
vl = new_vl;

// Write new vl to rd if rd != 0
rf[rd] when (rd != 0) = new_vl;
