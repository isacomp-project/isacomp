// SPDX-License-Identifier: BSD-3-Clause
// RISC-V Vector Extension: vredor.vs - Vector Reduce OR
// Encoding: vredor.vs vd, vs2, vs1, vm
// Operation: vd[0] = vs1[0] | (vs2[0] | vs2[1] | ... | vs2[vl-1])

isa_state pc[31:0];
isa_state vrf[127:0][4:0];
isa_state vl[31:0];
isa_state vtype[31:0];
mem umem[12:0];

var instr[31:0];
var vs1[4:0];
var vs2[4:0];
var vd[4:0];
var vm[0:0];
var v1[127:0];
var v2[127:0];
var res[127:0];
var or_val[31:0];

instr = umem[pc];
assume instr[6:0] == 0b1010111;
assume instr[14:12] == 0b010;
// funct6 = 000010 (vredor)
assume instr[31:26] == 0b000010;

pc = pc + 4;

vs1 = instr[19:15];
vs2 = instr[24:20];
vd = instr[11:7];
vm = instr[25:25];

v1 = vrf[vs1];
v2 = vrf[vs2];

// OR all elements
or_val = v1[31:0] | v2[31:0] | v2[63:32] | v2[95:64] | v2[127:96];

res[31:0] = or_val;
res[127:32] = 0;

vrf[vd] = res;
