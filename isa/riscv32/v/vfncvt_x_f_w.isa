// SPDX-License-Identifier: BSD-3-Clause
// RISC-V Vector Extension: vfncvt.x.f.w - Narrowing Convert FP to Signed Integer
// Encoding: vfncvt.x.f.w vd, vs2, vm
// Operation: vd[i] = convert_to_signed(vs2[i]) (2*SEW FP to SEW int)

isa_state pc[31:0];
isa_state vrf[127:0][4:0];
isa_state vl[31:0];
isa_state vtype[31:0];
isa_state fcsr[31:0];
mem umem[12:0];

var instr[31:0];
var vs2[4:0];
var vd[4:0];
var vm[0:0];
var v2[127:0];
var res[127:0];
var rm[2:0];

instr = umem[pc];
assume instr[6:0] == 0b1010111;
assume instr[14:12] == 0b001;
assume instr[31:26] == 0b010010;
assume instr[19:15] == 0b10001;

pc = pc + 4;

vs2 = instr[24:20];
vd = instr[11:7];
vm = instr[25:25];
rm = fcsr[7:5];

v2 = vrf[vs2];

// Convert 64-bit float to 32-bit signed integer
res[31:0] = fp_cvt_w_d(v2[63:0], rm);
res[63:32] = fp_cvt_w_d(v2[127:64], rm);
res[95:64] = 32'b0;
res[127:96] = 32'b0;

vrf[vd] = res;
