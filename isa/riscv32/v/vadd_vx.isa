// SPDX-License-Identifier: BSD-3-Clause
// RISC-V Vector Extension: vadd.vx - Vector Add (vector-scalar)
// Encoding: vadd.vx vd, vs2, rs1, vm
// Operation: vd[i] = vs2[i] + x[rs1]

isa_state pc[31:0];
isa_state rf[31:0][4:0];     // Scalar register file
isa_state vrf[127:0][4:0];   // Vector register file
isa_state vl[31:0];
isa_state vtype[31:0];
mem umem[12:0];

var instr[31:0];
var rs1[4:0];
var vs2[4:0];
var vd[4:0];
var vm[0:0];
var scalar[31:0];
var v2[127:0];
var res[127:0];

instr = umem[pc];
// Opcode: 1010111 (OP-V)
assume instr[6:0] == 0b1010111;
// funct3 = 100 (OPIVX - integer vector-scalar)
assume instr[14:12] == 0b100;
// funct6 = 000000 (vadd)
assume instr[31:26] == 0b000000;

pc = pc + 4;

rs1 = instr[19:15];
vs2 = instr[24:20];
vd = instr[11:7];
vm = instr[25:25];

scalar = rf[rs1];
v2 = vrf[vs2];

// Element-wise addition with scalar
res[31:0] = v2[31:0] + scalar;
res[63:32] = v2[63:32] + scalar;
res[95:64] = v2[95:64] + scalar;
res[127:96] = v2[127:96] + scalar;

vrf[vd] = res;
