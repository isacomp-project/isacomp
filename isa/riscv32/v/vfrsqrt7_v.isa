// SPDX-License-Identifier: BSD-3-Clause
// RISC-V Vector Extension: vfrsqrt7.v - Reciprocal Square Root Estimate (7-bit precision)
// Encoding: vfrsqrt7.v vd, vs2, vm
// Operation: vd[i] = 1/sqrt(vs2[i]) (approximate)

isa_state pc[31:0];
isa_state vrf[127:0][4:0];
isa_state vl[31:0];
isa_state vtype[31:0];
isa_state fcsr[31:0];
mem umem[12:0];

var instr[31:0];
var vs2[4:0];
var vd[4:0];
var vm[0:0];
var v2[127:0];
var res[127:0];
var rm[2:0];
var sqrt0[31:0];
var sqrt1[31:0];
var sqrt2[31:0];
var sqrt3[31:0];

instr = umem[pc];
assume instr[6:0] == 0b1010111;
assume instr[14:12] == 0b001;
assume instr[31:26] == 0b010011;
assume instr[19:15] == 0b00100;

pc = pc + 4;

vs2 = instr[24:20];
vd = instr[11:7];
vm = instr[25:25];
rm = fcsr[7:5];

v2 = vrf[vs2];

// Reciprocal square root - using 1/sqrt(x) as approximation
// Note: true vfrsqrt7 has 7-bit precision lookup table behavior
sqrt0 = fp_sqrt(v2[31:0], rm);
sqrt1 = fp_sqrt(v2[63:32], rm);
sqrt2 = fp_sqrt(v2[95:64], rm);
sqrt3 = fp_sqrt(v2[127:96], rm);
res[31:0] = fp_div(32'h3f800000, sqrt0, rm);
res[63:32] = fp_div(32'h3f800000, sqrt1, rm);
res[95:64] = fp_div(32'h3f800000, sqrt2, rm);
res[127:96] = fp_div(32'h3f800000, sqrt3, rm);

vrf[vd] = res;
