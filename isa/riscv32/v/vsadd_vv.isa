// SPDX-License-Identifier: BSD-3-Clause
// RISC-V Vector Extension: vsadd.vv - Saturating Signed Add (vector-vector)
// Encoding: vsadd.vv vd, vs2, vs1, vm
// Operation: vd[i] = sat_add_signed(vs2[i], vs1[i])

isa_state pc[31:0];
isa_state vrf[127:0][4:0];
isa_state vl[31:0];
isa_state vtype[31:0];
mem umem[12:0];

var instr[31:0];
var vs1[4:0];
var vs2[4:0];
var vd[4:0];
var vm[0:0];
var v1[127:0];
var v2[127:0];
var res[127:0];
var sum0[32:0];
var sum1[32:0];
var sum2[32:0];
var sum3[32:0];
var overflow0[0:0];
var overflow1[0:0];
var overflow2[0:0];
var overflow3[0:0];

instr = umem[pc];
assume instr[6:0] == 0b1010111;
assume instr[14:12] == 0b000;
assume instr[31:26] == 0b100001;

pc = pc + 4;

vs1 = instr[19:15];
vs2 = instr[24:20];
vd = instr[11:7];
vm = instr[25:25];

v1 = vrf[vs1];
v2 = vrf[vs2];

// Signed addition with overflow detection
sum0 = {v2[31], v2[31:0]} + {v1[31], v1[31:0]};
sum1 = {v2[63], v2[63:32]} + {v1[63], v1[63:32]};
sum2 = {v2[95], v2[95:64]} + {v1[95], v1[95:64]};
sum3 = {v2[127], v2[127:96]} + {v1[127], v1[127:96]};

// Overflow if sign of result differs from sign of both operands
overflow0 = (v2[31] == v1[31]) && (sum0[31] != v2[31]);
overflow1 = (v2[63] == v1[63]) && (sum1[31] != v2[63]);
overflow2 = (v2[95] == v1[95]) && (sum2[31] != v2[95]);
overflow3 = (v2[127] == v1[127]) && (sum3[31] != v2[127]);

// Saturate: positive overflow -> MAX, negative overflow -> MIN
res[31:0] = overflow0 ? (v2[31] ? 32'h80000000 : 32'h7FFFFFFF) : sum0[31:0];
res[63:32] = overflow1 ? (v2[63] ? 32'h80000000 : 32'h7FFFFFFF) : sum1[31:0];
res[95:64] = overflow2 ? (v2[95] ? 32'h80000000 : 32'h7FFFFFFF) : sum2[31:0];
res[127:96] = overflow3 ? (v2[127] ? 32'h80000000 : 32'h7FFFFFFF) : sum3[31:0];

vrf[vd] = res;
