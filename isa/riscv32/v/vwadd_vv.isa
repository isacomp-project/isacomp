// SPDX-License-Identifier: BSD-3-Clause
// RISC-V Vector Extension: vwadd.vv - Widening Signed Add (vector-vector)
// Encoding: vwadd.vv vd, vs2, vs1, vm
// Operation: vd[i] = sign_extend(vs2[i]) + sign_extend(vs1[i]) (2*SEW result)

isa_state pc[31:0];
isa_state vrf[127:0][4:0];
isa_state vl[31:0];
isa_state vtype[31:0];
mem umem[12:0];

var instr[31:0];
var vs1[4:0];
var vs2[4:0];
var vd[4:0];
var vm[0:0];
var v1[127:0];
var v2[127:0];
var res[127:0];
var op1_0[63:0];
var op1_1[63:0];
var op2_0[63:0];
var op2_1[63:0];

instr = umem[pc];
assume instr[6:0] == 0b1010111;
assume instr[14:12] == 0b010;
assume instr[31:26] == 0b110001;

pc = pc + 4;

vs1 = instr[19:15];
vs2 = instr[24:20];
vd = instr[11:7];
vm = instr[25:25];

v1 = vrf[vs1];
v2 = vrf[vs2];

// Sign-extend 32-bit to 64-bit and add
op1_0[63:0] = {{32{v1[31]}}, v1[31:0]};
op1_1[63:0] = {{32{v1[63]}}, v1[63:32]};
op2_0[63:0] = {{32{v2[31]}}, v2[31:0]};
op2_1[63:0] = {{32{v2[63]}}, v2[63:32]};

res[63:0] = op2_0 + op1_0;
res[127:64] = op2_1 + op1_1;

vrf[vd] = res;
