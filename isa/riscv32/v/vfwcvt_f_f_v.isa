// SPDX-License-Identifier: BSD-3-Clause
// RISC-V Vector Extension: vfwcvt.f.f.v - Widening Convert FP to FP
// Encoding: vfwcvt.f.f.v vd, vs2, vm
// Operation: vd[i] = widen(vs2[i]) (SEW FP to 2*SEW FP)

isa_state pc[31:0];
isa_state vrf[127:0][4:0];
isa_state vl[31:0];
isa_state vtype[31:0];
isa_state fcsr[31:0];
mem umem[12:0];

var instr[31:0];
var vs2[4:0];
var vd[4:0];
var vm[0:0];
var v2[127:0];
var res[127:0];

instr = umem[pc];
assume instr[6:0] == 0b1010111;
assume instr[14:12] == 0b001;
assume instr[31:26] == 0b010010;
assume instr[19:15] == 0b01100;

pc = pc + 4;

vs2 = instr[24:20];
vd = instr[11:7];
vm = instr[25:25];

v2 = vrf[vs2];

// Widen 32-bit float to 64-bit float
res[63:0] = fp_cvt_d_s(v2[31:0], rm);
res[127:64] = fp_cvt_d_s(v2[63:32], rm);

vrf[vd] = res;
