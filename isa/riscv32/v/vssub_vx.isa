// SPDX-License-Identifier: BSD-3-Clause
// RISC-V Vector Extension: vssub.vx - Saturating Signed Subtract (vector-scalar)
// Encoding: vssub.vx vd, vs2, rs1, vm
// Operation: vd[i] = sat_sub_signed(vs2[i], x[rs1])

isa_state pc[31:0];
isa_state rf[31:0][4:0];
isa_state vrf[127:0][4:0];
isa_state vl[31:0];
isa_state vtype[31:0];
mem umem[12:0];

var instr[31:0];
var rs1[4:0];
var vs2[4:0];
var vd[4:0];
var vm[0:0];
var scalar[31:0];
var v2[127:0];
var res[127:0];
var diff0[32:0];
var diff1[32:0];
var diff2[32:0];
var diff3[32:0];
var overflow0[0:0];
var overflow1[0:0];
var overflow2[0:0];
var overflow3[0:0];

instr = umem[pc];
assume instr[6:0] == 0b1010111;
assume instr[14:12] == 0b100;
assume instr[31:26] == 0b100011;

pc = pc + 4;

rs1 = instr[19:15];
vs2 = instr[24:20];
vd = instr[11:7];
vm = instr[25:25];

scalar = rf[rs1];
v2 = vrf[vs2];

diff0 = {v2[31], v2[31:0]} - {scalar[31], scalar};
diff1 = {v2[63], v2[63:32]} - {scalar[31], scalar};
diff2 = {v2[95], v2[95:64]} - {scalar[31], scalar};
diff3 = {v2[127], v2[127:96]} - {scalar[31], scalar};

overflow0 = (v2[31] != scalar[31]) && (diff0[31] != v2[31]);
overflow1 = (v2[63] != scalar[31]) && (diff1[31] != v2[63]);
overflow2 = (v2[95] != scalar[31]) && (diff2[31] != v2[95]);
overflow3 = (v2[127] != scalar[31]) && (diff3[31] != v2[127]);

res[31:0] = overflow0 ? (v2[31] ? 32'h80000000 : 32'h7FFFFFFF) : diff0[31:0];
res[63:32] = overflow1 ? (v2[63] ? 32'h80000000 : 32'h7FFFFFFF) : diff1[31:0];
res[95:64] = overflow2 ? (v2[95] ? 32'h80000000 : 32'h7FFFFFFF) : diff2[31:0];
res[127:96] = overflow3 ? (v2[127] ? 32'h80000000 : 32'h7FFFFFFF) : diff3[31:0];

vrf[vd] = res;
