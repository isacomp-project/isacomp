// SPDX-License-Identifier: BSD-3-Clause
// RISC-V Vector Extension: vcpop.m - Vector Count Population in Mask
// Encoding: vcpop.m rd, vs2, vm
// Operation: x[rd] = popcount(vs2.mask)

isa_state pc[31:0];
isa_state rf[31:0][4:0];
isa_state vrf[127:0][4:0];
isa_state vl[31:0];
isa_state vtype[31:0];
mem umem[12:0];

var instr[31:0];
var vs2[4:0];
var rd[4:0];
var vm[0:0];
var v2[127:0];
var count[31:0];

instr = umem[pc];
assume instr[6:0] == 0b1010111;
assume instr[14:12] == 0b010;
// funct6 = 010000 (vcpop)
assume instr[31:26] == 0b010000;
// vs1 = 10000 for vcpop
assume instr[19:15] == 0b10000;

pc = pc + 4;

vs2 = instr[24:20];
rd = instr[11:7];
vm = instr[25:25];

v2 = vrf[vs2];

// Count set bits in mask (first vl bits)
// Simplified: count first 4 bits for 4 elements
count = v2[0:0] + v2[1:1] + v2[2:2] + v2[3:3];

rf[rd] when (rd != 0) = count;
