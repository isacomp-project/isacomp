// SPDX-License-Identifier: BSD-3-Clause
// RISC-V Vector Extension: vsaddu.vx - Saturating Unsigned Add (vector-scalar)
// Encoding: vsaddu.vx vd, vs2, rs1, vm
// Operation: vd[i] = sat_add_unsigned(vs2[i], x[rs1])

isa_state pc[31:0];
isa_state rf[31:0][4:0];
isa_state vrf[127:0][4:0];
isa_state vl[31:0];
isa_state vtype[31:0];
mem umem[12:0];

var instr[31:0];
var rs1[4:0];
var vs2[4:0];
var vd[4:0];
var vm[0:0];
var scalar[31:0];
var v2[127:0];
var res[127:0];
var sum0[32:0];
var sum1[32:0];
var sum2[32:0];
var sum3[32:0];

instr = umem[pc];
assume instr[6:0] == 0b1010111;
assume instr[14:12] == 0b100;
assume instr[31:26] == 0b100000;

pc = pc + 4;

rs1 = instr[19:15];
vs2 = instr[24:20];
vd = instr[11:7];
vm = instr[25:25];

scalar = rf[rs1];
v2 = vrf[vs2];

sum0 = {1'b0, v2[31:0]} + {1'b0, scalar};
sum1 = {1'b0, v2[63:32]} + {1'b0, scalar};
sum2 = {1'b0, v2[95:64]} + {1'b0, scalar};
sum3 = {1'b0, v2[127:96]} + {1'b0, scalar};

res[31:0] = sum0[32] ? 32'hFFFFFFFF : sum0[31:0];
res[63:32] = sum1[32] ? 32'hFFFFFFFF : sum1[31:0];
res[95:64] = sum2[32] ? 32'hFFFFFFFF : sum2[31:0];
res[127:96] = sum3[32] ? 32'hFFFFFFFF : sum3[31:0];

vrf[vd] = res;
