// SPDX-License-Identifier: BSD-3-Clause
// RISC-V Vector Extension: vssrl.vx - Scaling Shift Right Logical (vector-scalar)
// Encoding: vssrl.vx vd, vs2, rs1, vm
// Operation: vd[i] = roundoff_unsigned(vs2[i], x[rs1])

isa_state pc[31:0];
isa_state rf[31:0][4:0];
isa_state vrf[127:0][4:0];
isa_state vl[31:0];
isa_state vtype[31:0];
isa_state vxrm[1:0];
mem umem[12:0];

var instr[31:0];
var rs1[4:0];
var vs2[4:0];
var vd[4:0];
var vm[0:0];
var scalar[31:0];
var v2[127:0];
var res[127:0];
var shift[4:0];

instr = umem[pc];
assume instr[6:0] == 0b1010111;
assume instr[14:12] == 0b100;
assume instr[31:26] == 0b101010;

pc = pc + 4;

rs1 = instr[19:15];
vs2 = instr[24:20];
vd = instr[11:7];
vm = instr[25:25];

scalar = rf[rs1];
v2 = vrf[vs2];
shift = scalar[4:0];

// Scaling shift right logical with rounding (guard for shift=0)
res[31:0]   = (shift == 0) ? v2[31:0]   : ((v2[31:0]   + (1 << (shift - 1))) >> shift);
res[63:32]  = (shift == 0) ? v2[63:32]  : ((v2[63:32]  + (1 << (shift - 1))) >> shift);
res[95:64]  = (shift == 0) ? v2[95:64]  : ((v2[95:64]  + (1 << (shift - 1))) >> shift);
res[127:96] = (shift == 0) ? v2[127:96] : ((v2[127:96] + (1 << (shift - 1))) >> shift);

vrf[vd] = res;
