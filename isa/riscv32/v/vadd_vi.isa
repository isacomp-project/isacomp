// SPDX-License-Identifier: BSD-3-Clause
// RISC-V Vector Extension: vadd.vi - Vector Add Immediate
// Encoding: vadd.vi vd, vs2, imm, vm
// Operation: vd[i] = vs2[i] + imm

isa_state pc[31:0];
isa_state vrf[127:0][4:0];   // Vector register file
isa_state vl[31:0];
isa_state vtype[31:0];
mem umem[12:0];

var instr[31:0];
var simm[4:0];
var vs2[4:0];
var vd[4:0];
var vm[0:0];
var imm[31:0];
var v2[127:0];
var res[127:0];

instr = umem[pc];
// Opcode: 1010111 (OP-V)
assume instr[6:0] == 0b1010111;
// funct3 = 011 (OPIVI - integer vector-immediate)
assume instr[14:12] == 0b011;
// funct6 = 000000 (vadd)
assume instr[31:26] == 0b000000;

pc = pc + 4;

simm = instr[19:15];
vs2 = instr[24:20];
vd = instr[11:7];
vm = instr[25:25];

// Sign-extend 5-bit immediate to 32 bits
imm = simm;

v2 = vrf[vs2];

// Element-wise addition with immediate
res[31:0] = v2[31:0] + imm;
res[63:32] = v2[63:32] + imm;
res[95:64] = v2[95:64] + imm;
res[127:96] = v2[127:96] + imm;

vrf[vd] = res;
