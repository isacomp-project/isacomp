// SPDX-License-Identifier: BSD-3-Clause
// RISC-V Vector Extension: vlse8.v - Vector Strided Load 8-bit Elements
// Encoding: vlse8.v vd, (rs1), rs2, vm
// Operation: Load 8-bit elements with stride from memory

isa_state pc[31:0];
isa_state xrf[31:0][4:0];
isa_state vrf[127:0][4:0];
isa_state vl[31:0];
isa_state vtype[31:0];
mem umem[12:0];

var instr[31:0];
var rs1[4:0];
var rs2[4:0];
var vd[4:0];
var vm[0:0];
var base[31:0];
var stride[31:0];
var res[127:0];

instr = umem[pc];
assume instr[6:0] == 0b0000111;
assume instr[14:12] == 0b000;
assume instr[28:26] == 0b010;
assume instr[31:29] == 0b000;

pc = pc + 4;

rs1 = instr[19:15];
rs2 = instr[24:20];
vd = instr[11:7];
vm = instr[25:25];

base = xrf[rs1];
stride = xrf[rs2];

res[7:0] = umem[base];
res[15:8] = umem[base + stride];
res[23:16] = umem[base + stride * 2];
res[31:24] = umem[base + stride * 3];
res[39:32] = umem[base + stride * 4];
res[47:40] = umem[base + stride * 5];
res[55:48] = umem[base + stride * 6];
res[63:56] = umem[base + stride * 7];
res[71:64] = umem[base + stride * 8];
res[79:72] = umem[base + stride * 9];
res[87:80] = umem[base + stride * 10];
res[95:88] = umem[base + stride * 11];
res[103:96] = umem[base + stride * 12];
res[111:104] = umem[base + stride * 13];
res[119:112] = umem[base + stride * 14];
res[127:120] = umem[base + stride * 15];

vrf[vd] = res;
