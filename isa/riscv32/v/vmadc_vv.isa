// SPDX-License-Identifier: BSD-3-Clause
// RISC-V Vector Extension: vmadc.vv - Carry-out of Add (vector-vector, no carry-in)
// Encoding: vmadc.vv vd, vs2, vs1
// Operation: vd.mask[i] = carry_out(vs2[i] + vs1[i])

isa_state pc[31:0];
isa_state vrf[127:0][4:0];
isa_state vl[31:0];
isa_state vtype[31:0];
mem umem[12:0];

var instr[31:0];
var vs1[4:0];
var vs2[4:0];
var vd[4:0];
var v1[127:0];
var v2[127:0];
var res[127:0];
var sum0[32:0];
var sum1[32:0];
var sum2[32:0];
var sum3[32:0];

instr = umem[pc];
assume instr[6:0] == 0b1010111;
assume instr[14:12] == 0b000;
assume instr[31:26] == 0b010001;
assume instr[25:25] == 0b1;  // vm=1 means no carry-in

pc = pc + 4;

vs1 = instr[19:15];
vs2 = instr[24:20];
vd = instr[11:7];

v1 = vrf[vs1];
v2 = vrf[vs2];

sum0 = {1'b0, v2[31:0]} + {1'b0, v1[31:0]};
sum1 = {1'b0, v2[63:32]} + {1'b0, v1[63:32]};
sum2 = {1'b0, v2[95:64]} + {1'b0, v1[95:64]};
sum3 = {1'b0, v2[127:96]} + {1'b0, v1[127:96]};

res = 128'b0;
res[0] = sum0[32];
res[1] = sum1[32];
res[2] = sum2[32];
res[3] = sum3[32];

vrf[vd] = res;
