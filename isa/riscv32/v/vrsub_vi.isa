// SPDX-License-Identifier: BSD-3-Clause
// RISC-V Vector Extension: vrsub.vi - Vector Reverse Subtract Immediate
// Encoding: vrsub.vi vd, vs2, imm, vm
// Operation: vd[i] = imm - vs2[i]

isa_state pc[31:0];
isa_state vrf[127:0][4:0];
isa_state vl[31:0];
isa_state vtype[31:0];
mem umem[12:0];

var instr[31:0];
var simm[4:0];
var vs2[4:0];
var vd[4:0];
var vm[0:0];
var imm[31:0];
var v2[127:0];
var res[127:0];

instr = umem[pc];
// Opcode: 1010111 (OP-V)
assume instr[6:0] == 0b1010111;
// funct3 = 011 (OPIVI)
assume instr[14:12] == 0b011;
// funct6 = 000011 (vrsub)
assume instr[31:26] == 0b000011;

pc = pc + 4;

simm = instr[19:15];
vs2 = instr[24:20];
vd = instr[11:7];
vm = instr[25:25];

imm = simm;
v2 = vrf[vs2];

res[31:0] = imm - v2[31:0];
res[63:32] = imm - v2[63:32];
res[95:64] = imm - v2[95:64];
res[127:96] = imm - v2[127:96];

vrf[vd] = res;
