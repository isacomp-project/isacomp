// SPDX-License-Identifier: BSD-3-Clause
// RISC-V Vector Extension: vssubu.vv - Saturating Unsigned Subtract (vector-vector)
// Encoding: vssubu.vv vd, vs2, vs1, vm
// Operation: vd[i] = sat_sub_unsigned(vs2[i], vs1[i])

isa_state pc[31:0];
isa_state vrf[127:0][4:0];
isa_state vl[31:0];
isa_state vtype[31:0];
mem umem[12:0];

var instr[31:0];
var vs1[4:0];
var vs2[4:0];
var vd[4:0];
var vm[0:0];
var v1[127:0];
var v2[127:0];
var res[127:0];
var borrow0[0:0];
var borrow1[0:0];
var borrow2[0:0];
var borrow3[0:0];

instr = umem[pc];
assume instr[6:0] == 0b1010111;
assume instr[14:12] == 0b000;
assume instr[31:26] == 0b100010;

pc = pc + 4;

vs1 = instr[19:15];
vs2 = instr[24:20];
vd = instr[11:7];
vm = instr[25:25];

v1 = vrf[vs1];
v2 = vrf[vs2];

// Unsigned subtraction saturates to 0 on underflow
borrow0 = v2[31:0] < v1[31:0];
borrow1 = v2[63:32] < v1[63:32];
borrow2 = v2[95:64] < v1[95:64];
borrow3 = v2[127:96] < v1[127:96];

res[31:0] = borrow0 ? 32'b0 : (v2[31:0] - v1[31:0]);
res[63:32] = borrow1 ? 32'b0 : (v2[63:32] - v1[63:32]);
res[95:64] = borrow2 ? 32'b0 : (v2[95:64] - v1[95:64]);
res[127:96] = borrow3 ? 32'b0 : (v2[127:96] - v1[127:96]);

vrf[vd] = res;
