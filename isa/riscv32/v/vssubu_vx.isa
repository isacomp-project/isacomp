// SPDX-License-Identifier: BSD-3-Clause
// RISC-V Vector Extension: vssubu.vx - Saturating Unsigned Subtract (vector-scalar)
// Encoding: vssubu.vx vd, vs2, rs1, vm
// Operation: vd[i] = sat_sub_unsigned(vs2[i], x[rs1])

isa_state pc[31:0];
isa_state rf[31:0][4:0];
isa_state vrf[127:0][4:0];
isa_state vl[31:0];
isa_state vtype[31:0];
mem umem[12:0];

var instr[31:0];
var rs1[4:0];
var vs2[4:0];
var vd[4:0];
var vm[0:0];
var scalar[31:0];
var v2[127:0];
var res[127:0];
var borrow0[0:0];
var borrow1[0:0];
var borrow2[0:0];
var borrow3[0:0];

instr = umem[pc];
assume instr[6:0] == 0b1010111;
assume instr[14:12] == 0b100;
assume instr[31:26] == 0b100010;

pc = pc + 4;

rs1 = instr[19:15];
vs2 = instr[24:20];
vd = instr[11:7];
vm = instr[25:25];

scalar = rf[rs1];
v2 = vrf[vs2];

borrow0 = v2[31:0] < scalar;
borrow1 = v2[63:32] < scalar;
borrow2 = v2[95:64] < scalar;
borrow3 = v2[127:96] < scalar;

res[31:0] = borrow0 ? 32'b0 : (v2[31:0] - scalar);
res[63:32] = borrow1 ? 32'b0 : (v2[63:32] - scalar);
res[95:64] = borrow2 ? 32'b0 : (v2[95:64] - scalar);
res[127:96] = borrow3 ? 32'b0 : (v2[127:96] - scalar);

vrf[vd] = res;
