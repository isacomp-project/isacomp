// SPDX-License-Identifier: BSD-3-Clause
// RISC-V Vector Extension: vlm.v - Load Mask Vector
// Encoding: vlm.v vd, (rs1)
// Operation: Load mask bits from memory

isa_state pc[31:0];
isa_state rf[31:0][4:0];
isa_state vrf[127:0][4:0];
isa_state vl[31:0];
isa_state vtype[31:0];
mem umem[12:0];

var instr[31:0];
var rs1[4:0];
var vd[4:0];
var addr[31:0];
var mask_data[31:0];
var res[127:0];

instr = umem[pc];
assume instr[6:0] == 0b0000111;
assume instr[14:12] == 0b000;
assume instr[31:26] == 0b000010;
assume instr[24:20] == 0b01011;

pc = pc + 4;

rs1 = instr[19:15];
vd = instr[11:7];

addr = rf[rs1];
mask_data = umem[addr];

// Load mask bits (1 bit per element, packed)
res = 128'b0;
res[31:0] = mask_data;

vrf[vd] = res;
