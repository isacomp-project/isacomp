// SPDX-License-Identifier: BSD-3-Clause
// RISC-V Vector Extension: vmerge.vxm - Vector Merge (vector-scalar, masked)
// Encoding: vmerge.vxm vd, vs2, rs1, v0
// Operation: vd[i] = v0.mask[i] ? x[rs1] : vs2[i]

isa_state pc[31:0];
isa_state rf[31:0][4:0];
isa_state vrf[127:0][4:0];
isa_state vl[31:0];
isa_state vtype[31:0];
mem umem[12:0];

var instr[31:0];
var rs1[4:0];
var vs2[4:0];
var vd[4:0];
var scalar[31:0];
var v2[127:0];
var v0[127:0];
var res[127:0];

instr = umem[pc];
assume instr[6:0] == 0b1010111;
assume instr[14:12] == 0b100;
assume instr[31:26] == 0b010111;
assume instr[25:25] == 0b0;

pc = pc + 4;

rs1 = instr[19:15];
vs2 = instr[24:20];
vd = instr[11:7];

scalar = rf[rs1];
v2 = vrf[vs2];
v0 = vrf[0];

res[31:0] = v0[0] ? scalar : v2[31:0];
res[63:32] = v0[1] ? scalar : v2[63:32];
res[95:64] = v0[2] ? scalar : v2[95:64];
res[127:96] = v0[3] ? scalar : v2[127:96];

vrf[vd] = res;
