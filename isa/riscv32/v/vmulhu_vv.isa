// SPDX-License-Identifier: BSD-3-Clause
// RISC-V Vector Extension: vmulhu.vv - Vector Multiply High Unsigned
// Encoding: vmulhu.vv vd, vs2, vs1, vm
// Operation: vd[i] = (vs2[i] * vs1[i]) >> SEW (unsigned)

isa_state pc[31:0];
isa_state vrf[127:0][4:0];
isa_state vl[31:0];
isa_state vtype[31:0];
mem umem[12:0];

var instr[31:0];
var vs1[4:0];
var vs2[4:0];
var vd[4:0];
var vm[0:0];
var v1[127:0];
var v2[127:0];
var res[127:0];
var prod0[63:0];
var prod1[63:0];
var prod2[63:0];
var prod3[63:0];

instr = umem[pc];
assume instr[6:0] == 0b1010111;
assume instr[14:12] == 0b010;
// funct6 = 100100 (vmulhu)
assume instr[31:26] == 0b100100;

pc = pc + 4;

vs1 = instr[19:15];
vs2 = instr[24:20];
vd = instr[11:7];
vm = instr[25:25];

v1 = vrf[vs1];
v2 = vrf[vs2];

// Unsigned multiply, return high 32 bits
prod0 = v2[31:0] * v1[31:0];
prod1 = v2[63:32] * v1[63:32];
prod2 = v2[95:64] * v1[95:64];
prod3 = v2[127:96] * v1[127:96];

res[31:0] = prod0[63:32];
res[63:32] = prod1[63:32];
res[95:64] = prod2[63:32];
res[127:96] = prod3[63:32];

vrf[vd] = res;
