// SPDX-License-Identifier: BSD-3-Clause
// RISC-V Vector Extension: vfredusum.vs - Vector FP Unordered Reduction Sum
// Encoding: vfredusum.vs vd, vs2, vs1, vm
// Operation: vd[0] = vs1[0] + sum(vs2[i]) (unordered)

isa_state pc[31:0];
isa_state vrf[127:0][4:0];
isa_state vl[31:0];
isa_state vtype[31:0];
isa_state fcsr[31:0];
mem umem[12:0];

var instr[31:0];
var vs1[4:0];
var vs2[4:0];
var vd[4:0];
var vm[0:0];
var v1[127:0];
var v2[127:0];
var res[127:0];
var sum[31:0];
var rm[2:0];

instr = umem[pc];
assume instr[6:0] == 0b1010111;
assume instr[14:12] == 0b001;
// funct6 = 000001 (vfredusum)
assume instr[31:26] == 0b000001;

pc = pc + 4;

vs1 = instr[19:15];
vs2 = instr[24:20];
vd = instr[11:7];
vm = instr[25:25];
rm = fcsr[7:5];

v1 = vrf[vs1];
v2 = vrf[vs2];

// Unordered sum (can be tree reduction)
sum = fp_add(v2[31:0], v2[63:32], rm);
sum = fp_add(sum, v2[95:64], rm);
sum = fp_add(sum, v2[127:96], rm);
sum = fp_add(sum, v1[31:0], rm);

res[31:0] = sum;
res[127:32] = 0;

vrf[vd] = res;
