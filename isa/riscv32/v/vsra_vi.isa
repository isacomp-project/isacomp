// SPDX-License-Identifier: BSD-3-Clause
// RISC-V Vector Extension: vsra.vi - Vector Shift Right Arithmetic Immediate
// Encoding: vsra.vi vd, vs2, uimm, vm
// Operation: vd[i] = vs2[i] >>> uimm (arithmetic)

isa_state pc[31:0];
isa_state vrf[127:0][4:0];
isa_state vl[31:0];
isa_state vtype[31:0];
mem umem[12:0];

var instr[31:0];
var uimm[4:0];
var vs2[4:0];
var vd[4:0];
var vm[0:0];
var v2[127:0];
var res[127:0];

instr = umem[pc];
assume instr[6:0] == 0b1010111;
assume instr[14:12] == 0b011;
// funct6 = 101001 (vsra)
assume instr[31:26] == 0b101001;

pc = pc + 4;

uimm = instr[19:15];
vs2 = instr[24:20];
vd = instr[11:7];
vm = instr[25:25];

v2 = vrf[vs2];

res[31:0] = v2[31:0] >>> uimm;
res[63:32] = v2[63:32] >>> uimm;
res[95:64] = v2[95:64] >>> uimm;
res[127:96] = v2[127:96] >>> uimm;

vrf[vd] = res;
