// SPDX-License-Identifier: BSD-3-Clause
// RISC-V Vector Extension: vadc.vvm - Add with Carry (vector-vector, masked)
// Encoding: vadc.vvm vd, vs2, vs1, v0
// Operation: vd[i] = vs2[i] + vs1[i] + v0.mask[i]

isa_state pc[31:0];
isa_state vrf[127:0][4:0];
isa_state vl[31:0];
isa_state vtype[31:0];
mem umem[12:0];

var instr[31:0];
var vs1[4:0];
var vs2[4:0];
var vd[4:0];
var v1[127:0];
var v2[127:0];
var v0[127:0];
var res[127:0];
var carry0[0:0];
var carry1[0:0];
var carry2[0:0];
var carry3[0:0];

instr = umem[pc];
assume instr[6:0] == 0b1010111;
assume instr[14:12] == 0b000;
assume instr[31:26] == 0b010000;
assume instr[25:25] == 0b0;  // vm=0 means uses v0 as carry-in

pc = pc + 4;

vs1 = instr[19:15];
vs2 = instr[24:20];
vd = instr[11:7];

v1 = vrf[vs1];
v2 = vrf[vs2];
v0 = vrf[0];  // Carry bits from v0

// Extract carry bits (1 bit per element)
carry0 = v0[0];
carry1 = v0[1];
carry2 = v0[2];
carry3 = v0[3];

res[31:0] = v2[31:0] + v1[31:0] + {31'b0, carry0};
res[63:32] = v2[63:32] + v1[63:32] + {31'b0, carry1};
res[95:64] = v2[95:64] + v1[95:64] + {31'b0, carry2};
res[127:96] = v2[127:96] + v1[127:96] + {31'b0, carry3};

vrf[vd] = res;
