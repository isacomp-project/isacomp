// SPDX-License-Identifier: BSD-3-Clause
// RISC-V Vector Extension: vmv4r.v - Whole Register Move (4 registers)
// Encoding: vmv4r.v vd, vs2
// Operation: vd..vd+3 = vs2..vs2+3 (move 4 registers)

isa_state pc[31:0];
isa_state vrf[127:0][4:0];
mem umem[12:0];

var instr[31:0];
var vs2[4:0];
var vd[4:0];
var v2_0[127:0];
var v2_1[127:0];
var v2_2[127:0];
var v2_3[127:0];

instr = umem[pc];
assume instr[6:0] == 0b1010111;
assume instr[14:12] == 0b011;
assume instr[31:26] == 0b100111;
assume instr[19:15] == 0b00011;

pc = pc + 4;

vs2 = instr[24:20];
vd = instr[11:7];

v2_0 = vrf[vs2];
v2_1 = vrf[vs2 + 1];
v2_2 = vrf[vs2 + 2];
v2_3 = vrf[vs2 + 3];

vrf[vd] = v2_0;
vrf[vd + 1] = v2_1;
vrf[vd + 2] = v2_2;
vrf[vd + 3] = v2_3;
