// SPDX-License-Identifier: BSD-3-Clause
// RISC-V Vector Extension: vcompress.vm - Compress elements based on mask
// Encoding: vcompress.vm vd, vs2, vs1
// Operation: Compress active elements from vs2 based on vs1 mask

isa_state pc[31:0];
isa_state vrf[127:0][4:0];
isa_state vl[31:0];
isa_state vtype[31:0];
mem umem[12:0];

var instr[31:0];
var vs1[4:0];
var vs2[4:0];
var vd[4:0];
var v1[127:0];
var v2[127:0];
var res[127:0];
var m0[0:0];
var m1[0:0];
var m2[0:0];
var m3[0:0];
var idx[2:0];
var e0[31:0];
var e1[31:0];
var e2[31:0];
var e3[31:0];

instr = umem[pc];
assume instr[6:0] == 0b1010111;
assume instr[14:12] == 0b010;
assume instr[31:26] == 0b010111;

pc = pc + 4;

vs1 = instr[19:15];
vs2 = instr[24:20];
vd = instr[11:7];

v1 = vrf[vs1];  // Mask
v2 = vrf[vs2];  // Source

m0 = v1[0];
m1 = v1[1];
m2 = v1[2];
m3 = v1[3];

// Initialize result to zero
res = 128'b0;

// Compress: write active elements consecutively
// This is a simplified implementation for 4 elements
e0 = m0 ? v2[31:0] : 32'b0;
e1 = m1 ? v2[63:32] : 32'b0;
e2 = m2 ? v2[95:64] : 32'b0;
e3 = m3 ? v2[127:96] : 32'b0;

// Pack active elements (simplified - actual compress logic)
res[31:0] = m0 ? v2[31:0] : (m1 ? v2[63:32] : (m2 ? v2[95:64] : (m3 ? v2[127:96] : 32'b0)));
res[63:32] = (m0 && m1) ? v2[63:32] : ((m0 || m1) && m2) ? v2[95:64] : ((m0 || m1 || m2) && m3) ? v2[127:96] : 32'b0;
res[95:64] = (m0 && m1 && m2) ? v2[95:64] : ((m0 && m1) || (m0 && m2) || (m1 && m2)) && m3 ? v2[127:96] : 32'b0;
res[127:96] = (m0 && m1 && m2 && m3) ? v2[127:96] : 32'b0;

vrf[vd] = res;
