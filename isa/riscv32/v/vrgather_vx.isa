// SPDX-License-Identifier: BSD-3-Clause
// RISC-V Vector Extension: vrgather.vx - Vector Register Gather (scalar index)
// Encoding: vrgather.vx vd, vs2, rs1, vm
// Operation: vd[i] = vs2[x[rs1]]

isa_state pc[31:0];
isa_state rf[31:0][4:0];
isa_state vrf[127:0][4:0];
isa_state vl[31:0];
isa_state vtype[31:0];
mem umem[12:0];

var instr[31:0];
var rs1[4:0];
var vs2[4:0];
var vd[4:0];
var vm[0:0];
var idx[31:0];
var v2[127:0];
var res[127:0];
var elem[31:0];

instr = umem[pc];
assume instr[6:0] == 0b1010111;
assume instr[14:12] == 0b100;
// funct6 = 001100 (vrgather)
assume instr[31:26] == 0b001100;

pc = pc + 4;

rs1 = instr[19:15];
vs2 = instr[24:20];
vd = instr[11:7];
vm = instr[25:25];

idx = rf[rs1];
v2 = vrf[vs2];

// Select element based on scalar index
elem = (idx == 0) ? v2[31:0] : ((idx == 1) ? v2[63:32] : ((idx == 2) ? v2[95:64] : ((idx == 3) ? v2[127:96] : 0)));

// Broadcast to all elements
res[31:0] = elem;
res[63:32] = elem;
res[95:64] = elem;
res[127:96] = elem;

vrf[vd] = res;
