// SPDX-License-Identifier: BSD-3-Clause
// RISC-V Vector Extension: vslideup.vx - Vector Slide Up
// Encoding: vslideup.vx vd, vs2, rs1, vm
// Operation: vd[i+offset] = vs2[i] for i >= 0

isa_state pc[31:0];
isa_state rf[31:0][4:0];
isa_state vrf[127:0][4:0];
isa_state vl[31:0];
isa_state vtype[31:0];
mem umem[12:0];

var instr[31:0];
var rs1[4:0];
var vs2[4:0];
var vd[4:0];
var vm[0:0];
var offset[31:0];
var v2[127:0];
var vdest[127:0];
var res[127:0];

instr = umem[pc];
assume instr[6:0] == 0b1010111;
assume instr[14:12] == 0b100;
// funct6 = 001110 (vslideup)
assume instr[31:26] == 0b001110;

pc = pc + 4;

rs1 = instr[19:15];
vs2 = instr[24:20];
vd = instr[11:7];
vm = instr[25:25];

offset = rf[rs1];
v2 = vrf[vs2];
vdest = vrf[vd];

// Slide up by offset (simplified for 4x32-bit elements)
res = vdest;
res[63:32] = (offset == 1) ? v2[31:0] : res[63:32];
res[95:64] = (offset == 1) ? v2[63:32] : ((offset == 2) ? v2[31:0] : res[95:64]);
res[127:96] = (offset == 1) ? v2[95:64] : ((offset == 2) ? v2[63:32] : ((offset == 3) ? v2[31:0] : res[127:96]));

vrf[vd] = res;
