// SPDX-License-Identifier: BSD-3-Clause
// RISC-V Vector Extension: vrgather.vv - Vector Register Gather
// Encoding: vrgather.vv vd, vs2, vs1, vm
// Operation: vd[i] = vs2[vs1[i]]

isa_state pc[31:0];
isa_state vrf[127:0][4:0];
isa_state vl[31:0];
isa_state vtype[31:0];
mem umem[12:0];

var instr[31:0];
var vs1[4:0];
var vs2[4:0];
var vd[4:0];
var vm[0:0];
var v1[127:0];
var v2[127:0];
var res[127:0];
var idx0[31:0];
var idx1[31:0];
var idx2[31:0];
var idx3[31:0];

instr = umem[pc];
assume instr[6:0] == 0b1010111;
assume instr[14:12] == 0b000;
// funct6 = 001100 (vrgather)
assume instr[31:26] == 0b001100;

pc = pc + 4;

vs1 = instr[19:15];
vs2 = instr[24:20];
vd = instr[11:7];
vm = instr[25:25];

v1 = vrf[vs1];
v2 = vrf[vs2];

// Get indices
idx0 = v1[31:0];
idx1 = v1[63:32];
idx2 = v1[95:64];
idx3 = v1[127:96];

// Gather based on indices (simplified)
res[31:0] = (idx0 == 0) ? v2[31:0] : ((idx0 == 1) ? v2[63:32] : ((idx0 == 2) ? v2[95:64] : ((idx0 == 3) ? v2[127:96] : 0)));
res[63:32] = (idx1 == 0) ? v2[31:0] : ((idx1 == 1) ? v2[63:32] : ((idx1 == 2) ? v2[95:64] : ((idx1 == 3) ? v2[127:96] : 0)));
res[95:64] = (idx2 == 0) ? v2[31:0] : ((idx2 == 1) ? v2[63:32] : ((idx2 == 2) ? v2[95:64] : ((idx2 == 3) ? v2[127:96] : 0)));
res[127:96] = (idx3 == 0) ? v2[31:0] : ((idx3 == 1) ? v2[63:32] : ((idx3 == 2) ? v2[95:64] : ((idx3 == 3) ? v2[127:96] : 0)));

vrf[vd] = res;
