// SPDX-License-Identifier: BSD-3-Clause
// RISC-V Vector Extension: vfmax.vf - Vector FP Maximum (scalar)
// Encoding: vfmax.vf vd, vs2, rs1, vm
// Operation: vd[i] = max(vs2[i], f[rs1])

isa_state pc[31:0];
isa_state frf[31:0][4:0];
isa_state vrf[127:0][4:0];
isa_state vl[31:0];
isa_state vtype[31:0];
isa_state fcsr[31:0];
mem umem[12:0];

var instr[31:0];
var rs1[4:0];
var vs2[4:0];
var vd[4:0];
var vm[0:0];
var scalar[31:0];
var v2[127:0];
var res[127:0];

instr = umem[pc];
assume instr[6:0] == 0b1010111;
assume instr[14:12] == 0b101;
// funct6 = 000110 (vfmax)
assume instr[31:26] == 0b000110;

pc = pc + 4;

rs1 = instr[19:15];
vs2 = instr[24:20];
vd = instr[11:7];
vm = instr[25:25];

scalar = frf[rs1];
v2 = vrf[vs2];

res[31:0] = fp_max(v2[31:0], scalar);
res[63:32] = fp_max(v2[63:32], scalar);
res[95:64] = fp_max(v2[95:64], scalar);
res[127:96] = fp_max(v2[127:96], scalar);

vrf[vd] = res;
