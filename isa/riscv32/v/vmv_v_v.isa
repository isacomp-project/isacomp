// SPDX-License-Identifier: BSD-3-Clause
// RISC-V Vector Extension: vmv.v.v - Vector Move (vector-vector)
// Encoding: vmv.v.v vd, vs1
// Operation: vd = vs1

isa_state pc[31:0];
isa_state vrf[127:0][4:0];
isa_state vl[31:0];
isa_state vtype[31:0];
mem umem[12:0];

var instr[31:0];
var vs1[4:0];
var vd[4:0];
var v1[127:0];

instr = umem[pc];
assume instr[6:0] == 0b1010111;
assume instr[14:12] == 0b000;
// funct6 = 010111 (vmv)
assume instr[31:26] == 0b010111;
// vs2 = 00000 (required for this encoding)
assume instr[24:20] == 0b00000;
// vm = 1 (unmasked)
assume instr[25:25] == 0b1;

pc = pc + 4;

vs1 = instr[19:15];
vd = instr[11:7];

v1 = vrf[vs1];

vrf[vd] = v1;
