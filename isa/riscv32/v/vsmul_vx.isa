// SPDX-License-Identifier: BSD-3-Clause
// RISC-V Vector Extension: vsmul.vx - Signed Saturating Fractional Multiply (vector-scalar)
// Encoding: vsmul.vx vd, vs2, rs1, vm
// Operation: vd[i] = clip((vs2[i] * x[rs1] + round) >> (SEW-1))

isa_state pc[31:0];
isa_state rf[31:0][4:0];
isa_state vrf[127:0][4:0];
isa_state vl[31:0];
isa_state vtype[31:0];
mem umem[12:0];

var instr[31:0];
var rs1[4:0];
var vs2[4:0];
var vd[4:0];
var vm[0:0];
var scalar[31:0];
var v2[127:0];
var res[127:0];
var scalar_ext[63:0];
var prod0[63:0];
var prod1[63:0];
var prod2[63:0];
var prod3[63:0];
var shifted0[31:0];
var shifted1[31:0];
var shifted2[31:0];
var shifted3[31:0];

instr = umem[pc];
assume instr[6:0] == 0b1010111;
assume instr[14:12] == 0b100;
assume instr[31:26] == 0b100111;

pc = pc + 4;

rs1 = instr[19:15];
vs2 = instr[24:20];
vd = instr[11:7];
vm = instr[25:25];

scalar = rf[rs1];
v2 = vrf[vs2];

scalar_ext = {{32{scalar[31]}}, scalar};

prod0 = {{32{v2[31]}}, v2[31:0]} * scalar_ext;
prod1 = {{32{v2[63]}}, v2[63:32]} * scalar_ext;
prod2 = {{32{v2[95]}}, v2[95:64]} * scalar_ext;
prod3 = {{32{v2[127]}}, v2[127:96]} * scalar_ext;

shifted0 = (prod0 + 64'h40000000) >>> 31;
shifted1 = (prod1 + 64'h40000000) >>> 31;
shifted2 = (prod2 + 64'h40000000) >>> 31;
shifted3 = (prod3 + 64'h40000000) >>> 31;

res[31:0] = shifted0;
res[63:32] = shifted1;
res[95:64] = shifted2;
res[127:96] = shifted3;

vrf[vd] = res;
