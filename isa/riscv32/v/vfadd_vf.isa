// SPDX-License-Identifier: BSD-3-Clause
// RISC-V Vector Extension: vfadd.vf - Vector Floating-Point Add (vector-scalar)
// Encoding: vfadd.vf vd, vs2, rs1, vm
// Operation: vd[i] = vs2[i] + f[rs1] (FP add)

isa_state pc[31:0];
isa_state frf[31:0][4:0];    // Scalar FP register file
isa_state vrf[127:0][4:0];   // Vector register file
isa_state vl[31:0];
isa_state vtype[31:0];
isa_state fcsr[31:0];
mem umem[12:0];

var instr[31:0];
var rs1[4:0];
var vs2[4:0];
var vd[4:0];
var vm[0:0];
var scalar[31:0];
var v2[127:0];
var res[127:0];
var rm[2:0];

instr = umem[pc];
assume instr[6:0] == 0b1010111;
// funct3 = 101 (OPFVF - FP vector-scalar)
assume instr[14:12] == 0b101;
// funct6 = 000000 (vfadd)
assume instr[31:26] == 0b000000;

pc = pc + 4;

rs1 = instr[19:15];
vs2 = instr[24:20];
vd = instr[11:7];
vm = instr[25:25];
rm = fcsr[7:5];

scalar = frf[rs1];
v2 = vrf[vs2];

// Element-wise FP addition with scalar
res[31:0] = fp_add(v2[31:0], scalar, rm);
res[63:32] = fp_add(v2[63:32], scalar, rm);
res[95:64] = fp_add(v2[95:64], scalar, rm);
res[127:96] = fp_add(v2[127:96], scalar, rm);

vrf[vd] = res;
