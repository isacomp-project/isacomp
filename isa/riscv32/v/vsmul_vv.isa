// SPDX-License-Identifier: BSD-3-Clause
// RISC-V Vector Extension: vsmul.vv - Signed Saturating Fractional Multiply (vector-vector)
// Encoding: vsmul.vv vd, vs2, vs1, vm
// Operation: vd[i] = clip((vs2[i] * vs1[i] + round) >> (SEW-1))

isa_state pc[31:0];
isa_state vrf[127:0][4:0];
isa_state vl[31:0];
isa_state vtype[31:0];
mem umem[12:0];

var instr[31:0];
var vs1[4:0];
var vs2[4:0];
var vd[4:0];
var vm[0:0];
var v1[127:0];
var v2[127:0];
var res[127:0];
var prod0[63:0];
var prod1[63:0];
var prod2[63:0];
var prod3[63:0];
var shifted0[31:0];
var shifted1[31:0];
var shifted2[31:0];
var shifted3[31:0];

instr = umem[pc];
assume instr[6:0] == 0b1010111;
assume instr[14:12] == 0b000;
assume instr[31:26] == 0b100111;

pc = pc + 4;

vs1 = instr[19:15];
vs2 = instr[24:20];
vd = instr[11:7];
vm = instr[25:25];

v1 = vrf[vs1];
v2 = vrf[vs2];

// Signed multiply, then shift right by 31 (SEW-1)
prod0 = {{32{v2[31]}}, v2[31:0]} * {{32{v1[31]}}, v1[31:0]};
prod1 = {{32{v2[63]}}, v2[63:32]} * {{32{v1[63]}}, v1[63:32]};
prod2 = {{32{v2[95]}}, v2[95:64]} * {{32{v1[95]}}, v1[95:64]};
prod3 = {{32{v2[127]}}, v2[127:96]} * {{32{v1[127]}}, v1[127:96]};

// Shift right by 31 with rounding
shifted0 = (prod0 + 64'h40000000) >>> 31;
shifted1 = (prod1 + 64'h40000000) >>> 31;
shifted2 = (prod2 + 64'h40000000) >>> 31;
shifted3 = (prod3 + 64'h40000000) >>> 31;

// Saturate (handle overflow case: -MIN * -MIN)
res[31:0] = shifted0;
res[63:32] = shifted1;
res[95:64] = shifted2;
res[127:96] = shifted3;

vrf[vd] = res;
