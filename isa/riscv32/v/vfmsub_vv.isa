// SPDX-License-Identifier: BSD-3-Clause
// RISC-V Vector Extension: vfmsub.vv - Vector FP Multiply-Subtract
// Encoding: vfmsub.vv vd, vs1, vs2, vm
// Operation: vd[i] = (vs1[i] * vd[i]) - vs2[i]

isa_state pc[31:0];
isa_state vrf[127:0][4:0];
isa_state vl[31:0];
isa_state vtype[31:0];
isa_state fcsr[31:0];
mem umem[12:0];

var instr[31:0];
var vs1[4:0];
var vs2[4:0];
var vd[4:0];
var vm[0:0];
var v1[127:0];
var v2[127:0];
var vdest[127:0];
var res[127:0];
var rm[2:0];

instr = umem[pc];
assume instr[6:0] == 0b1010111;
assume instr[14:12] == 0b001;
// funct6 = 101010 (vfmsub)
assume instr[31:26] == 0b101010;

pc = pc + 4;

vs1 = instr[19:15];
vs2 = instr[24:20];
vd = instr[11:7];
vm = instr[25:25];
rm = fcsr[7:5];

v1 = vrf[vs1];
v2 = vrf[vs2];
vdest = vrf[vd];

res[31:0] = fp_fmsub(v1[31:0], vdest[31:0], v2[31:0], rm);
res[63:32] = fp_fmsub(v1[63:32], vdest[63:32], v2[63:32], rm);
res[95:64] = fp_fmsub(v1[95:64], vdest[95:64], v2[95:64], rm);
res[127:96] = fp_fmsub(v1[127:96], vdest[127:96], v2[127:96], rm);

vrf[vd] = res;
