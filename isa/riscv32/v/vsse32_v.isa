// SPDX-License-Identifier: BSD-3-Clause
// RISC-V Vector Extension: vsse32.v - Vector Store Strided 32-bit Elements
// Encoding: vsse32.v vs3, (rs1), rs2, vm
// Operation: mem[rs1 + i*rs2] = vs3[i]

isa_state pc[31:0];
isa_state rf[31:0][4:0];
isa_state vrf[127:0][4:0];
isa_state vl[31:0];
isa_state vtype[31:0];
mem umem[12:0];
mem dmem[12:0];

var instr[31:0];
var rs1[4:0];
var rs2[4:0];
var vs3[4:0];
var vm[0:0];
var addr[31:0];
var stride[31:0];
var data[127:0];

instr = umem[pc];
// Opcode: 0100111 (STORE-FP, vector store)
assume instr[6:0] == 0b0100111;
// width = 110 (32-bit)
assume instr[14:12] == 0b110;
// mop = 10 (strided)
assume instr[27:26] == 0b10;
// nf = 000 (single field)
assume instr[31:29] == 0b000;

pc = pc + 4;

rs1 = instr[19:15];
rs2 = instr[24:20];
vs3 = instr[11:7];
vm = instr[25:25];

addr = rf[rs1];
stride = rf[rs2];
data = vrf[vs3];

// Store 4 words with stride
dmem[addr] = data[31:0];
dmem[addr + stride] = data[63:32];
dmem[addr + stride + stride] = data[95:64];
dmem[addr + stride + stride + stride] = data[127:96];
