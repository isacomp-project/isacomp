// SPDX-License-Identifier: BSD-3-Clause
// RISC-V Vector Extension: vmulhsu.vv - Vector Multiply High Signed-Unsigned
// Encoding: vmulhsu.vv vd, vs2, vs1, vm
// Operation: vd[i] = (signed(vs2[i]) * unsigned(vs1[i])) >> SEW

isa_state pc[31:0];
isa_state vrf[127:0][4:0];
isa_state vl[31:0];
isa_state vtype[31:0];
mem umem[12:0];

var instr[31:0];
var vs1[4:0];
var vs2[4:0];
var vd[4:0];
var vm[0:0];
var v1[127:0];
var v2[127:0];
var res[127:0];
var prod0[63:0];
var prod1[63:0];
var prod2[63:0];
var prod3[63:0];
var u1_0[63:0];
var u1_1[63:0];
var u1_2[63:0];
var u1_3[63:0];
var s2_0[63:0];
var s2_1[63:0];
var s2_2[63:0];
var s2_3[63:0];

instr = umem[pc];
assume instr[6:0] == 0b1010111;
assume instr[14:12] == 0b010;
// funct6 = 100110 (vmulhsu)
assume instr[31:26] == 0b100110;

pc = pc + 4;

vs1 = instr[19:15];
vs2 = instr[24:20];
vd = instr[11:7];
vm = instr[25:25];

v1 = vrf[vs1];
v2 = vrf[vs2];

// Sign extend vs2 (signed), zero extend vs1 (unsigned), then multiply
s2_0 = {{32{v2[31]}}, v2[31:0]};
s2_1 = {{32{v2[63]}}, v2[63:32]};
s2_2 = {{32{v2[95]}}, v2[95:64]};
s2_3 = {{32{v2[127]}}, v2[127:96]};
u1_0 = {32'b0, v1[31:0]};
u1_1 = {32'b0, v1[63:32]};
u1_2 = {32'b0, v1[95:64]};
u1_3 = {32'b0, v1[127:96]};
prod0 = s2_0 * u1_0;
prod1 = s2_1 * u1_1;
prod2 = s2_2 * u1_2;
prod3 = s2_3 * u1_3;

res[31:0] = prod0[63:32];
res[63:32] = prod1[63:32];
res[95:64] = prod2[63:32];
res[127:96] = prod3[63:32];

vrf[vd] = res;
