// SPDX-License-Identifier: BSD-3-Clause
// RISC-V Vector Extension: vfsgnj.vv - Vector FP Sign Injection
// Encoding: vfsgnj.vv vd, vs2, vs1, vm
// Operation: vd[i] = {sign(vs1[i]), exponent+mantissa(vs2[i])}

isa_state pc[31:0];
isa_state vrf[127:0][4:0];
isa_state vl[31:0];
isa_state vtype[31:0];
mem umem[12:0];

var instr[31:0];
var vs1[4:0];
var vs2[4:0];
var vd[4:0];
var vm[0:0];
var v1[127:0];
var v2[127:0];
var res[127:0];

instr = umem[pc];
assume instr[6:0] == 0b1010111;
assume instr[14:12] == 0b001;
// funct6 = 001000 (vfsgnj)
assume instr[31:26] == 0b001000;

pc = pc + 4;

vs1 = instr[19:15];
vs2 = instr[24:20];
vd = instr[11:7];
vm = instr[25:25];

v1 = vrf[vs1];
v2 = vrf[vs2];

// Copy sign from vs1, magnitude from vs2
res[31:0] = {v1[31:31], v2[30:0]};
res[63:32] = {v1[63:63], v2[62:32]};
res[95:64] = {v1[95:95], v2[94:64]};
res[127:96] = {v1[127:127], v2[126:96]};

vrf[vd] = res;
