// SPDX-License-Identifier: BSD-3-Clause
// RISC-V Vector Extension: vnsrl.wv - Narrowing Shift Right Logical (vector-vector)
// Encoding: vnsrl.wv vd, vs2, vs1, vm
// Operation: vd[i] = (vs2[i] >> vs1[i])[SEW-1:0] (2*SEW to SEW)

isa_state pc[31:0];
isa_state vrf[127:0][4:0];
isa_state vl[31:0];
isa_state vtype[31:0];
mem umem[12:0];

var instr[31:0];
var vs1[4:0];
var vs2[4:0];
var vd[4:0];
var vm[0:0];
var v1[127:0];
var v2[127:0];
var res[127:0];
var shift0[5:0];
var shift1[5:0];
var wide0[63:0];
var wide1[63:0];

instr = umem[pc];
assume instr[6:0] == 0b1010111;
assume instr[14:12] == 0b000;
assume instr[31:26] == 0b101100;

pc = pc + 4;

vs1 = instr[19:15];
vs2 = instr[24:20];
vd = instr[11:7];
vm = instr[25:25];

v1 = vrf[vs1];
v2 = vrf[vs2];

// vs2 has 2x64-bit elements, vs1 has 4x32-bit (use lower bits for shift)
wide0 = v2[63:0];
wide1 = v2[127:64];
shift0 = v1[5:0];
shift1 = v1[37:32];

// Shift and narrow to 32 bits
res[31:0] = (wide0 >> shift0);
res[63:32] = (wide1 >> shift1);
res[95:64] = 32'b0;
res[127:96] = 32'b0;

vrf[vd] = res;
