// SPDX-License-Identifier: BSD-3-Clause
// RISC-V Vector Extension: vfwsub.wv - Widening FP Subtract (wide - narrow, vector-vector)
// Encoding: vfwsub.wv vd, vs2, vs1, vm
// Operation: vd[i] = vs2[i] - fp_widen(vs1[i]) (vs2 is 2*SEW, vs1 is SEW)

isa_state pc[31:0];
isa_state vrf[127:0][4:0];
isa_state vl[31:0];
isa_state vtype[31:0];
isa_state fcsr[31:0];
mem umem[12:0];

var instr[31:0];
var vs1[4:0];
var vs2[4:0];
var vd[4:0];
var vm[0:0];
var v1[127:0];
var v2[127:0];
var res[127:0];
var rm[2:0];

instr = umem[pc];
assume instr[6:0] == 0b1010111;
assume instr[14:12] == 0b001;
assume instr[31:26] == 0b110110;

pc = pc + 4;

vs1 = instr[19:15];
vs2 = instr[24:20];
vd = instr[11:7];
vm = instr[25:25];
rm = fcsr[7:5];

v1 = vrf[vs1];
v2 = vrf[vs2];

res[63:0] = fp_sub_d(v2[63:0], fp_cvt_d_s(v1[31:0], rm), rm);
res[127:64] = fp_sub_d(v2[127:64], fp_cvt_d_s(v1[63:32], rm), rm);

vrf[vd] = res;
