// SPDX-License-Identifier: BSD-3-Clause
isa_state pc[31:0];
var instr[31:0];
isa_state rf[31:0][4:0];
mem umem[12:0];

var rs1[4:0];
var rs2[4:0];
var rd[4:0];
var r1[31:0];
var r2[31:0];
var r1_sign[0:0];
var r2_sign[0:0];
var r1_64[63:0];
var r2_64[63:0];
var product[63:0];
var res[31:0];

instr = umem[pc];
assume instr[6:0] == 0b0110011;
assume instr[14:12] == 0b001;
assume instr[31:25] == 0b0000001;
pc = pc + 4;
rs1 = instr[19:15];
rs2 = instr[24:20];
rd = instr[11:7];

r1 = rf[rs1];
r2 = rf[rs2];

// MULH: signed multiply, return upper 32 bits
// Sign extend both operands to 64 bits
r1_sign = r1[31];
r2_sign = r2[31];
r1_64 = {{32{r1_sign}}, r1};
r2_64 = {{32{r2_sign}}, r2};

// 64-bit multiply
product = r1_64 * r2_64;

// Extract upper 32 bits
res = product[63:32];

rf[rd] when (rd != 0) = res;
