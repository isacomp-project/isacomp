// SPDX-License-Identifier: BSD-3-Clause
isa_state pc[63:0];
var instr[31:0];
isa_state rf[63:0][4:0];
mem umem[23:0];
mem csr[11:0];

// Dedicated CSR registers as isa_state (for MMU aspect)
isa_state priv_mode[1:0];      // Privilege mode: 0=U-mode, 1=S-mode, 3=M-mode
isa_state satp[63:0];          // Supervisor Address Translation and Protection (0x180)
isa_state mtvec[63:0];         // Machine Trap-Vector Base-Address (0x305)
isa_state mepc[63:0];          // Machine Exception Program Counter (0x341)
isa_state mcause[63:0];        // Machine Cause (0x342)
isa_state mtval[63:0];         // Machine Trap Value (0x343)
isa_state medeleg[63:0];       // Machine Exception Delegation (0x302)
isa_state sepc[63:0];          // Supervisor Exception Program Counter (0x141)
isa_state stvec[63:0];         // Supervisor Trap-Vector Base-Address (0x105)
isa_state scause[63:0];        // Supervisor Cause (0x142)
isa_state stval[63:0];         // Supervisor Trap Value (0x143)
isa_state sscratch[63:0];      // Supervisor Scratch (0x140)
isa_state sstatus[63:0];       // Supervisor Status (0x100) - SPP is bit 8
isa_state mscratch[63:0];      // Machine Scratch (0x340)
isa_state mie[63:0];           // Machine Interrupt Enable (0x304)
isa_state mstatus[63:0];       // Machine Status (0x300)
isa_state stimecmp[63:0];      // Supervisor Time Compare (0x14D) - sstc extension

// External timer state from CLINT
ext isa_state mtime[63:0];            // Full 64-bit mtime from CLINT
ext isa_state timer_irq_pending[0:0]; // MTIP for mip derivation

var rd[4:0];
var csr_addr[11:0];
var zimm[4:0];
var zimm_ext[63:0];
var csr_val[63:0];
var new_csr_val[63:0];

// Address matching flags for dedicated CSR registers
var is_satp[0:0];
var is_mtvec[0:0];
var is_mepc[0:0];
var is_mcause[0:0];
var is_mtval[0:0];
var is_medeleg[0:0];
var is_sepc[0:0];
var is_stvec[0:0];
var is_scause[0:0];
var is_stval[0:0];
var is_sscratch[0:0];
var is_sstatus[0:0];
var is_mscratch[0:0];
var is_mie[0:0];
var is_mstatus[0:0];
var is_mip[0:0];
var is_time[0:0];
var is_mhartid[0:0];
var is_misa[0:0];
var is_stimecmp[0:0];
var is_sie[0:0];
var is_sip[0:0];
var is_dedicated_csr[0:0];

// Derived mip value (MTIP in bit 7)
var mip_val[63:0];

// sie/sip intermediate values
var sie_val[63:0];
var sip_val[63:0];
var sie_new_mie[63:0];

// Intermediate values for CSR read mux
var csr_val_sip[63:0];
var csr_val_sie[63:0];
var csr_val_mtval[63:0];
var csr_val_mcause[63:0];
var csr_val_mepc[63:0];
var csr_val_mtvec[63:0];
var csr_val_medeleg[63:0];
var csr_val_sepc[63:0];
var csr_val_stvec[63:0];
var csr_val_scause[63:0];
var csr_val_stval[63:0];
var csr_val_sscratch[63:0];
var csr_val_sstatus[63:0];
var csr_val_mscratch[63:0];
var csr_val_mie[63:0];
var csr_val_mstatus[63:0];
var csr_val_mip[63:0];
var csr_val_time[63:0];
var csr_val_mhartid[63:0];
var csr_val_misa[63:0];
var csr_val_stimecmp[63:0];

// Virtual memory translation
aspect ../mmu.isa gates pc, priv_mode, mepc, mcause, mtval, sepc, scause, stval, mstatus, sstatus;

instr = umem[pc_pa];
assume instr[6:0] == 0b1110011;
assume instr[14:12] == 0b110;
pc = pc + 4;
zimm = instr[19:15];
rd = instr[11:7];
csr_addr = instr[31:20];

// Check if CSR address matches a dedicated register
is_sscratch = (csr_addr == 12'h140);
is_sstatus = (csr_addr == 12'h100);
is_sepc = (csr_addr == 12'h141);
is_scause = (csr_addr == 12'h142);
is_stval = (csr_addr == 12'h143);
is_stvec = (csr_addr == 12'h105);
is_satp = (csr_addr == 12'h180);
is_medeleg = (csr_addr == 12'h302);
is_mtvec = (csr_addr == 12'h305);
is_mepc = (csr_addr == 12'h341);
is_mcause = (csr_addr == 12'h342);
is_mtval = (csr_addr == 12'h343);
is_mscratch = (csr_addr == 12'h340);
is_mstatus = (csr_addr == 12'h300);
is_mie = (csr_addr == 12'h304);
is_mip = (csr_addr == 12'h344);
is_time = (csr_addr == 12'hC01);
is_mhartid = (csr_addr == 12'hf14);
is_misa = (csr_addr == 12'h301);
is_stimecmp = (csr_addr == 12'h14D);
is_sie = (csr_addr == 12'h104);
is_sip = (csr_addr == 12'h144);
is_dedicated_csr = is_sscratch | is_sstatus | is_mscratch | is_mie | is_mstatus | is_sepc | is_scause | is_stval | is_stvec | is_satp | is_medeleg | is_mtvec | is_mepc | is_mcause | is_mtval | is_mip | is_time | is_mhartid | is_misa | is_stimecmp | is_sie | is_sip;

// Derive mip value: MTIP (bit 7) from timer_irq_pending, STIP (bit 5) from sstc
// STIP is set when mtime >= stimecmp
var stip[0:0];
stip = (mtime >= stimecmp) ? 1'b1 : 1'b0;
mip_val = {56'b0, timer_irq_pending, 1'b0, stip, 5'b0};

// sie (0x104) is a restricted view of mie: only bits 1 (SSIE), 5 (STIE), 9 (SEIE)
sie_val = mie & 64'h222;
// sip (0x144) is a restricted view of mip: only bits 1 (SSIP), 5 (STIP), 9 (SEIP)
sip_val = mip_val & 64'h222;

// Read CSR - build mux chain using intermediate variables
// mhartid (0xf14) is read-only and returns 0 for hart 0
csr_val_misa = is_misa ? 64'h8000000000041101 : csr[csr_addr];
csr_val_mhartid = is_mhartid ? 64'h0 : csr_val_misa;
csr_val_time = is_time ? mtime : csr_val_mhartid;
csr_val_mip = is_mip ? mip_val : csr_val_time;
csr_val_sip = is_sip ? sip_val : csr_val_mip;
csr_val_sie = is_sie ? sie_val : csr_val_sip;
csr_val_mtval = is_mtval ? mtval : csr_val_sie;
csr_val_mcause = is_mcause ? mcause : csr_val_mtval;
csr_val_mepc = is_mepc ? mepc : csr_val_mcause;
csr_val_mtvec = is_mtvec ? mtvec : csr_val_mepc;
csr_val_mie = is_mie ? mie : csr_val_mtvec;
csr_val_mstatus = is_mstatus ? mstatus : csr_val_mie;
csr_val_medeleg = is_medeleg ? medeleg : csr_val_mstatus;
csr_val_sepc = is_sepc ? sepc : csr_val_medeleg;
csr_val_stvec = is_stvec ? stvec : csr_val_sepc;
csr_val_scause = is_scause ? scause : csr_val_stvec;
csr_val_stval = is_stval ? stval : csr_val_scause;
csr_val_sscratch = is_sscratch ? sscratch : csr_val_stval;
csr_val_sstatus = is_sstatus ? sstatus : csr_val_sscratch;
csr_val_mscratch = is_mscratch ? mscratch : csr_val_sstatus;
csr_val_stimecmp = is_stimecmp ? stimecmp : csr_val_mscratch;
csr_val = is_satp ? satp : csr_val_stimecmp;

// Zero-extend immediate to 64 bits
zimm_ext = {{59{1'b0}}, zimm};

// Set bits in CSR (OR operation)
new_csr_val = csr_val | zimm_ext;

// Write new value to dedicated CSR if address matches (only if zimm != 0)
sscratch when (is_sscratch & (zimm != 0) & ~instr_trap_taken) = new_csr_val;
sstatus when (is_sstatus & (zimm != 0) & ~instr_trap_taken) = new_csr_val;
mscratch when (is_mscratch & (zimm != 0) & ~instr_trap_taken) = new_csr_val;
sepc when (is_sepc & (zimm != 0) & ~instr_trap_taken) = new_csr_val;
scause when (is_scause & (zimm != 0) & ~instr_trap_taken) = new_csr_val;
stval when (is_stval & (zimm != 0) & ~instr_trap_taken) = new_csr_val;
stvec when (is_stvec & (zimm != 0) & ~instr_trap_taken) = new_csr_val;
// Per RISC-V spec: writes to satp with unsupported MODE have no effect
// Mode validation in data path (not when-clause) to ensure compiler generates correct guard
var satp_valid_mode[0:0];
satp_valid_mode = (new_csr_val[63:60] == 4'd0 | new_csr_val[63:60] == 4'd8);
satp when (is_satp & (zimm != 0) & ~instr_trap_taken) = satp_valid_mode ? new_csr_val : satp;
medeleg when (is_medeleg & (zimm != 0) & ~instr_trap_taken) = new_csr_val;
mtvec when (is_mtvec & (zimm != 0) & ~instr_trap_taken) = new_csr_val;
mepc when (is_mepc & (zimm != 0) & ~instr_trap_taken) = new_csr_val;
mcause when (is_mcause & (zimm != 0) & ~instr_trap_taken) = new_csr_val;
mtval when (is_mtval & (zimm != 0) & ~instr_trap_taken) = new_csr_val;
// sie (0x104) maps to S-mode bits (1,5,9) of mie; combine both writes to avoid compiler merge bug
sie_new_mie = (mie & 64'hFFFFFFFFFFFFFDDD) | (new_csr_val & 64'h222);
var mie_combined_val[63:0];
mie_combined_val = is_mie ? new_csr_val : sie_new_mie;
mie when ((is_mie | is_sie) & (zimm != 0) & ~instr_trap_taken) = mie_combined_val;
mstatus when (is_mstatus & (zimm != 0) & ~instr_trap_taken) = new_csr_val;
stimecmp when (is_stimecmp & (zimm != 0) & ~instr_trap_taken) = new_csr_val;

// Write to generic csr[] array only if not a dedicated CSR (only if zimm != 0)
csr[csr_addr] when ((is_dedicated_csr == 0) & (zimm != 0) & ~instr_trap_taken) = new_csr_val;

// Write old CSR value to destination register (if rd != 0)
rf[rd] when (rd != 0 & ~instr_trap_taken) = csr_val;
