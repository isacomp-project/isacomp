// SPDX-License-Identifier: BSD-3-Clause
// RISC-V RV64D - FSQRT.D (Double-precision floating-point square root)
// Encoding: funct7=0101101, rs2=00000, rs1, rm, rd, opcode=1010011

isa_state pc[63:0];
var instr[31:0];
isa_state rf[63:0][4:0];
isa_state frf[63:0][4:0];
isa_state fcsr[31:0];
mem umem[12:0];

var rs1[4:0];
var rd[4:0];
var rm[2:0];
var eff_rm[2:0];  // Effective rounding mode (canonical IEEE 754)
var f1[63:0];
var sqrt_result[63:0];

instr = umem[pc];
assume instr[6:0] == 0b1010011;
assume instr[31:27] == 0b01011;   // FSQRT funct5
assume instr[26:25] == 0b01;      // fmt = D
assume instr[24:20] == 0b00000;   // rs2 must be 0

pc = pc + 4;

rs1 = instr[19:15];
rd = instr[11:7];
rm = instr[14:12];

// Compute effective rounding mode (rm=111 means use fcsr[7:5])
eff_rm = (rm == 3'b111) ? fcsr[7:5] : rm;

f1 = frf[rs1];

sqrt_result = fp_sqrt_d(f1, eff_rm);

frf[rd] = sqrt_result;
