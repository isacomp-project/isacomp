// SPDX-License-Identifier: BSD-3-Clause
// RISC-V RV64D - FLT.D (Double-precision floating-point less than)
// Encoding: funct7=1010001, rs2, rs1, rm=001, rd, opcode=1010011

isa_state pc[63:0];
var instr[31:0];
isa_state rf[63:0][4:0];
isa_state frf[63:0][4:0];
isa_state fcsr[31:0];
mem umem[12:0];

var rs1[4:0];
var rs2[4:0];
var rd[4:0];
var f1[63:0];
var f2[63:0];
var lt_cmp_result[0:0];           // Boolean result
var result[63:0];

instr = umem[pc];
assume instr[6:0] == 0b1010011;
assume instr[31:27] == 0b10100;   // FCMP funct5
assume instr[26:25] == 0b01;      // fmt = D
assume instr[14:12] == 0b001;     // FLT

pc = pc + 4;

rs1 = instr[19:15];
rs2 = instr[24:20];
rd = instr[11:7];

f1 = frf[rs1];
f2 = frf[rs2];

// FP less than comparison (extracts 1-bit result from packed {flags, value})
lt_cmp_result = fp_lt_d(f1, f2);

// Zero-extend boolean result to 64 bits
result = {{63{1'b0}}, lt_cmp_result};

rf[rd] when (rd != 0) = result;
