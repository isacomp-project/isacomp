// SPDX-License-Identifier: BSD-3-Clause
// RISC-V RV64D - FCVT.S.D (Convert double to single)
// Encoding: funct7=0100000, rs2=00001, rs1, rm, rd, opcode=1010011

isa_state pc[63:0];
var instr[31:0];
isa_state rf[63:0][4:0];
isa_state frf[63:0][4:0];
isa_state fcsr[31:0];
mem umem[12:0];

var rs1[4:0];
var rd[4:0];
var rm[2:0];
var eff_rm[2:0];  // Effective rounding mode (canonical IEEE 754)
var f1[63:0];
var cvt_result[31:0];
var nan_boxed[63:0];

instr = umem[pc];
assume instr[6:0] == 0b1010011;
assume instr[31:27] == 0b01000;   // FCVT.S/D funct5
assume instr[26:25] == 0b00;      // fmt = S (destination)
assume instr[24:20] == 0b00001;   // D (source)

pc = pc + 4;

rs1 = instr[19:15];
rd = instr[11:7];
rm = instr[14:12];

// Compute effective rounding mode (rm=111 means use fcsr[7:5])
eff_rm = (rm == 3'b111) ? fcsr[7:5] : rm;

f1 = frf[rs1];

cvt_result = fp_cvt_s_d(f1, eff_rm);

// NaN-box the single-precision result in the 64-bit register
nan_boxed = {32'hffffffff, cvt_result};

frf[rd] = nan_boxed;
