// SPDX-License-Identifier: BSD-3-Clause
// RV64M REMUW - Unsigned word remainder, sign-extend to 64 bits

isa_state pc[63:0];
var instr[31:0];
isa_state rf[63:0][4:0];
mem umem[12:0];

var rs1[4:0];
var rs2[4:0];
var rd[4:0];
var r1[63:0];
var r2[63:0];
var r1_word[31:0];
var r2_word[31:0];
var quot_word[31:0];
var rem_word[31:0];
var res_word[31:0];
var res[63:0];

instr = umem[pc];
assume instr[6:0] == 0b0111011;
assume instr[14:12] == 0b111;
assume instr[31:25] == 0b0000001;
pc = pc + 4;
rs1 = instr[19:15];
rs2 = instr[24:20];
rd = instr[11:7];

r1 = rf[rs1];
r2 = rf[rs2];

// REMUW: unsigned 32-bit remainder, sign-extended to 64 bits
r1_word = r1[31:0];
r2_word = r2[31:0];

// Compute quotient and remainder
quot_word = r1_word / r2_word;
rem_word = r1_word - (quot_word * r2_word);
res_word = rem_word;

// Sign-extend 32-bit result to 64 bits
res = {{32{res_word[31]}}, res_word};

rf[rd] when (rd != 0) = res;
