// RV64M REMU - Unsigned remainder

isa_state pc[63:0];
var instr[31:0];
isa_state rf[63:0][4:0];
mem umem[12:0];

var rs1[4:0];
var rs2[4:0];
var rd[4:0];
var r1[63:0];
var r2[63:0];
var quot[63:0];
var rem[63:0];
var res[63:0];

instr = umem[pc];
assume instr[6:0] == 0b0110011;
assume instr[14:12] == 0b111;
assume instr[31:25] == 0b0000001;
pc = pc + 4;
rs1 = instr[19:15];
rs2 = instr[24:20];
rd = instr[11:7];

r1 = rf[rs1];
r2 = rf[rs2];

// REMU: unsigned remainder
// Compute quotient
quot = r1 / r2;

// Compute remainder as: remainder = dividend - (quotient * divisor)
rem = r1 - (quot * r2);

// Result is the remainder
res = rem;

rf[rd] when (rd != 0) = res;
