// SPDX-License-Identifier: BSD-3-Clause
isa_state pc[63:0];
var instr[31:0];
isa_state rf[63:0][4:0];
mem umem[12:0];

var rs1[4:0];
var rs2[4:0];
var rd[4:0];
var r1[63:0];
var r2[63:0];
var res[63:0];

instr = umem[pc];
assume instr[6:0] == 0b0110011;
assume instr[14:12] == 0x1;
assume instr[31:25] == 0x00;
pc = pc + 4;
rs1 = instr[19:15];
rs2 = instr[24:20];
rd = instr[11:7];

r1 = rf[rs1];
r2 = rf[rs2];

// RISC-V spec: only use lower 6 bits of shift amount for RV64
res = r1 << r2[5:0];

rf[rd] when (rd != 0) = res;
