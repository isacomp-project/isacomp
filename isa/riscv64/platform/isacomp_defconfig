# Minimal kernel config for ISAComp RV64 MMU platform
# Single-core, no networking, no PCI, no block devices
# Goal: fast boot to initramfs userspace

# Basic system
CONFIG_SYSVIPC=y
CONFIG_NO_HZ_IDLE=y
CONFIG_HIGH_RES_TIMERS=y
CONFIG_BLK_DEV_INITRD=y
# Set INITRAMFS_SOURCE to point to isa/riscv64/platform/initramfs/initramfs_list in your checkout
# CONFIG_INITRAMFS_SOURCE must be set as an absolute path when building the kernel
CONFIG_INITRAMFS_COMPRESSION_NONE=y
CONFIG_CC_OPTIMIZE_FOR_SIZE=y

# Disable SMP - single core
# CONFIG_SMP is not set

# Disable modules
# CONFIG_MODULES is not set

# Platform support - minimal
CONFIG_ARCH_VIRT=y
CONFIG_NONPORTABLE=y

# Console / serial
CONFIG_SERIAL_8250=y
CONFIG_SERIAL_8250_CONSOLE=y
CONFIG_SERIAL_OF_PLATFORM=y
CONFIG_SERIAL_EARLYCON_RISCV_SBI=y

# Filesystem support (minimal for initramfs)
CONFIG_DEVTMPFS=y
CONFIG_DEVTMPFS_MOUNT=y
CONFIG_PROC_FS=y
CONFIG_SYSFS=y
CONFIG_TMPFS=y

# Disable heavy subsystems
# CONFIG_NET is not set
# CONFIG_PCI is not set
# CONFIG_MTD is not set
# CONFIG_DRM is not set
# CONFIG_SOUND is not set
