// SPDX-License-Identifier: BSD-3-Clause
// RISC-V RV64F - FEQ.S (Floating-point equals)
// Encoding: funct7=1010000, rs2, rs1, funct3=010, rd, opcode=1010011
// Result written to integer register rd (zero-extended to 64 bits)

isa_state pc[63:0];
var instr[31:0];
isa_state rf[63:0][4:0];
isa_state frf[31:0][4:0];
isa_state fcsr[31:0];
mem umem[12:0];

var rs1[4:0];
var rs2[4:0];
var rd[4:0];
var f1[31:0];
var f2[31:0];
var eq_cmp_result[0:0];
var result[63:0];

instr = umem[pc];
assume instr[6:0] == 0b1010011;
assume instr[31:27] == 0b10100;   // FP compare funct5
assume instr[26:25] == 0b00;
assume instr[14:12] == 0b010;     // FEQ.S funct3

pc = pc + 4;

rs1 = instr[19:15];
rs2 = instr[24:20];
rd = instr[11:7];

f1 = frf[rs1];
f2 = frf[rs2];

eq_cmp_result = fp_eq(f1, f2);

// Zero-extend boolean result to 64 bits
result = {{63{1'b0}}, eq_cmp_result};

rf[rd] when (rd != 0) = result;
