// SPDX-License-Identifier: BSD-3-Clause
// RISC-V RV64F - FSW (Store single-precision float)
// Encoding: imm[11:5], rs2, rs1, funct3=010, imm[4:0], opcode=0100111

isa_state pc[63:0];
var instr[31:0];
isa_state rf[63:0][4:0];
isa_state frf[31:0][4:0];
mem umem[12:0];

var rs1[4:0];
var rs2[4:0];
var imm[11:0];
var base[63:0];
var offset[63:0];
var addr[63:0];
var data[31:0];

instr = umem[pc];
assume instr[6:0] == 0b0100111;   // STORE-FP opcode
assume instr[14:12] == 0b010;     // FSW funct3

pc = pc + 4;

rs1 = instr[19:15];
rs2 = instr[24:20];
imm = {instr[31:25], instr[11:7]};  // Reconstruct immediate

base = rf[rs1];
offset = {{52{imm[11]}}, imm};  // Sign-extend to 64 bits
addr = base + offset;

// Read FP register
data = frf[rs2];

// Store word to memory
umem[addr] = data;
