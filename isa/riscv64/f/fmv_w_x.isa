// SPDX-License-Identifier: BSD-3-Clause
// RISC-V RV64F - FMV.W.X (Move integer to FP register)
// Encoding: funct7=1111000, rs2=00000, rs1, funct3=000, rd, opcode=1010011
// Copies lower 32 bits from integer register to FP register without conversion

isa_state pc[63:0];
var instr[31:0];
isa_state rf[63:0][4:0];
isa_state frf[31:0][4:0];
mem umem[12:0];

var rs1[4:0];
var rd[4:0];
var r1[63:0];
var result[31:0];

instr = umem[pc];
assume instr[6:0] == 0b1010011;
assume instr[31:27] == 0b11110;   // FMV.W.X funct5
assume instr[26:25] == 0b00;
assume instr[24:20] == 0b00000;
assume instr[14:12] == 0b000;

pc = pc + 4;

rs1 = instr[19:15];
rd = instr[11:7];

r1 = rf[rs1];

// Take lower 32 bits
result = r1[31:0];

frf[rd] = result;
