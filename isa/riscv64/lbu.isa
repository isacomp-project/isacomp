// SPDX-License-Identifier: BSD-3-Clause
// RISC-V LBU (Load Byte Unsigned) instruction for RV64I
// Uses mem primitive with 8-bit direct access

isa_state pc[63:0];
var instr[31:0];
isa_state rf[63:0][4:0];
mem umem[12:0];

var rs1[4:0];
var rd[4:0];
var r1[63:0];
var imm[11:0];
var sign_ext_imm[63:0];
var addr[63:0];
var byte_data[7:0];

instr = umem[pc];
assume instr[6:0] == 0b0000011;
assume instr[14:12] == 0x4;

rs1 = instr[19:15];
rd = instr[11:7];

r1 = rf[rs1];

imm = instr[31:20];
sign_ext_imm = {{52{imm[11]}}, imm};

addr = r1 + sign_ext_imm;

// Direct 8-bit load from memory
byte_data = umem[addr];

// Zero-extend byte to 64 bits
rf[rd] when (rd != 0) = {56'b0, byte_data};
pc = pc + 4;
