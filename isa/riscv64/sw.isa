// RISC-V SW (Store Word) instruction for RV64I

isa_state pc[63:0];
var instr[31:0];
isa_state rf[63:0][4:0];
mem umem[12:0];

var rs1[4:0];
var rs2[4:0];
var r1[63:0];
var r2[63:0];
var imm[11:0];
var sign_ext_imm[63:0];
var addr[63:0];

instr = umem[pc];
assume instr[6:0] == 0b0100011;
assume instr[14:12] == 0x2;

rs1 = instr[19:15];
rs2 = instr[24:20];

r1 = rf[rs1];
r2 = rf[rs2];

imm = {instr[31:25], instr[11:7]};
sign_ext_imm = {{52{imm[11]}}, imm};

addr = r1 + sign_ext_imm;

umem[addr] = r2[31:0];
pc = pc + 4;
