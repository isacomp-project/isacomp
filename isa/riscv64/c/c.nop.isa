// RV64C C.NOP - No operation

isa_state pc[63:0];
var c_instr[15:0];
isa_state rf[63:0][4:0];
mem umem[12:0];

// Read compressed instruction (16-bit)
c_instr = umem[pc];

// C.NOP format: CI-type (special case of C.ADDI with rd=x0 and imm=0)
// Encoding: 000 0 00000 00000 01
assume c_instr[1:0] == 0b01;
assume c_instr[15:13] == 0b000;
assume c_instr[11:7] == 0;
assume c_instr[12] == 0;
assume c_instr[6:2] == 0;

pc = pc + 2;

// NOP does nothing
