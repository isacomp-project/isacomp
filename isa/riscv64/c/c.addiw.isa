// SPDX-License-Identifier: BSD-3-Clause
// RV64C C.ADDIW - Add word immediate (RV64 only, replaces C.JAL in RV32)

isa_state pc[63:0];
var c_instr[15:0];
isa_state rf[63:0][4:0];
mem umem[12:0];

var rs1[4:0];
var rd[4:0];
var imm[5:0];
var sign_ext_imm[31:0];
var r1[63:0];
var r1_word[31:0];
var res_word[31:0];
var res[63:0];

// Read compressed instruction (16-bit)
c_instr = umem[pc];

// C.ADDIW format: CI-type (RV64 only, uses C.JAL encoding from RV32)
// Encoding: 001 imm[5] rd/rs1 imm[4:0] 01
assume c_instr[1:0] == 0b01;
assume c_instr[15:13] == 0b001;
assume c_instr[11:7] != 0;

pc = pc + 2;

rd = c_instr[11:7];
rs1 = c_instr[11:7];  // same as rd

// Immediate is imm[5:0] = {c_instr[12], c_instr[6:2]}
imm = {c_instr[12], c_instr[6:2]};
sign_ext_imm = {{26{imm[5]}}, imm};

r1 = rf[rs1];
r1_word = r1[31:0];

// 32-bit addition
res_word = r1_word + sign_ext_imm;

// Sign-extend 32-bit result to 64 bits
res = {{32{res_word[31]}}, res_word};

rf[rd] when (rd != 0) = res;
