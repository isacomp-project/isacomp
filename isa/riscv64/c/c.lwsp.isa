// SPDX-License-Identifier: BSD-3-Clause
// RV64C C.LWSP - Load word from stack (sign-extended to 64-bit)

isa_state pc[63:0];
var c_instr[15:0];
isa_state rf[63:0][4:0];
mem umem[12:0];

var rd[4:0];
var sp[63:0];
var uimm[7:0];
var zero_ext_imm[63:0];
var c_lwsp_addr[63:0];
var c_data[31:0];
var res[63:0];

// Read compressed instruction (16-bit)
c_instr = umem[pc];

// C.LWSP format: CI-type
// Encoding: 010 imm[5] rd imm[4:2|7:6] 10
assume c_instr[1:0] == 0b10;
assume c_instr[15:13] == 0b010;
assume c_instr[11:7] != 0;

pc = pc + 2;

rd = c_instr[11:7];

// Unsigned immediate: uimm[7:2] = {c_instr[3:2], c_instr[12], c_instr[6:4]}
uimm = {c_instr[3:2], c_instr[12], c_instr[6:4], 2'b00};
zero_ext_imm = {56'b0, uimm};

// SP is x2
sp = rf[5'b00010];

c_lwsp_addr = sp + zero_ext_imm;
c_data = umem[c_lwsp_addr];

// Sign-extend 32-bit result to 64 bits
res = {{32{c_data[31]}}, c_data};

rf[rd] when (rd != 0) = res;
