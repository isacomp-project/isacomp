// SPDX-License-Identifier: BSD-3-Clause
// RV64C C.SDSP - Store doubleword to stack (RV64 only)

isa_state pc[63:0];
var c_instr[15:0];
isa_state rf[63:0][4:0];
mem umem[12:0];

var rs2[4:0];
var sp[63:0];
var r2[63:0];
var uimm[8:0];
var zero_ext_imm[63:0];
var addr[63:0];

// Read compressed instruction (16-bit)
c_instr = umem[pc];

// C.SDSP format: CSS-type (RV64 only)
// Encoding: 111 imm[5:3|8:6] rs2 10
assume c_instr[1:0] == 0b10;
assume c_instr[15:13] == 0b111;

pc = pc + 2;

rs2 = c_instr[6:2];

// Unsigned immediate: uimm[8:3] = {c_instr[9:7], c_instr[12:10]}
uimm = {c_instr[9:7], c_instr[12:10], 3'b000};
zero_ext_imm = {55'b0, uimm};

// SP is x2
sp = rf[5'b00010];
r2 = rf[rs2];

addr = sp + zero_ext_imm;
umem[addr] = r2;
