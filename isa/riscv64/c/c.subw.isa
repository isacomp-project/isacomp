// SPDX-License-Identifier: BSD-3-Clause
// RV64C C.SUBW - Subtract word (RV64 only, sign-extended)

isa_state pc[63:0];
var c_instr[15:0];
isa_state rf[63:0][4:0];
mem umem[12:0];

var rs1[4:0];
var rs2_prime[2:0];
var rs2[4:0];
var rd_prime[2:0];
var rd[4:0];
var r1[63:0];
var r2[63:0];
var r1_word[31:0];
var r2_word[31:0];
var res_word[31:0];
var res[63:0];

// Read compressed instruction (16-bit)
c_instr = umem[pc];

// C.SUBW format: CA-type (RV64 only)
// Encoding: 100111 rd'/rs1' 00 rs2' 01
assume c_instr[1:0] == 0b01;
assume c_instr[15:10] == 0b100111;
assume c_instr[6:5] == 0b00;

pc = pc + 2;

// Compressed register encoding: x8-x15
rd_prime = c_instr[9:7];
rs2_prime = c_instr[4:2];
rd = {2'b01, rd_prime};
rs1 = {2'b01, rd_prime};  // same as rd
rs2 = {2'b01, rs2_prime};

r1 = rf[rs1];
r2 = rf[rs2];

r1_word = r1[31:0];
r2_word = r2[31:0];

res_word = r1_word - r2_word;

// Sign-extend 32-bit result to 64 bits
res = {{32{res_word[31]}}, res_word};

// No guard needed - rd is always 8-15, never 0
rf[rd] = res;
