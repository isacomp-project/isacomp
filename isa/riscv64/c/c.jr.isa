// SPDX-License-Identifier: BSD-3-Clause
// RV64C C.JR - Jump register

isa_state pc[63:0];
var c_instr[15:0];
isa_state rf[63:0][4:0];
mem umem[12:0];

var rs1[4:0];
var r1[63:0];
var jump_dest[63:0];

// Read compressed instruction (16-bit)
c_instr = umem[pc];

// C.JR format: CR-type
// Encoding: 1000 rs1 00000 10
assume c_instr[1:0] == 0b10;
assume c_instr[15:12] == 0b1000;
assume c_instr[11:7] != 0;
assume c_instr[6:2] == 0;

rs1 = c_instr[11:7];

r1 = rf[rs1];

jump_dest = r1;

pc = jump_dest;
