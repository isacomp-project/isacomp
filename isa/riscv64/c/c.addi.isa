// SPDX-License-Identifier: BSD-3-Clause
// RV64C C.ADDI - Add immediate (64-bit)

isa_state pc[63:0];
var c_instr[15:0];
isa_state rf[63:0][4:0];
mem umem[12:0];

var rs1[4:0];
var rd[4:0];
var imm[5:0];
var sign_ext_imm[63:0];
var r1[63:0];
var res[63:0];

// Read compressed instruction (16-bit)
c_instr = umem[pc];

// C.ADDI format: CI-type
// Encoding: 000 imm[5] rd/rs1 imm[4:0] 01
assume c_instr[1:0] == 0b01;
assume c_instr[15:13] == 0b000;
assume c_instr[11:7] != 0;

pc = pc + 2;

rd = c_instr[11:7];
rs1 = c_instr[11:7];  // same as rd

// Immediate is imm[5:0] = {c_instr[12], c_instr[6:2]}
imm = {c_instr[12], c_instr[6:2]};
sign_ext_imm = {{58{imm[5]}}, imm};

r1 = rf[rs1];

res = r1 + sign_ext_imm;

rf[rd] when (rd != 0) = res;
