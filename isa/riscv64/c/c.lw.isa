// SPDX-License-Identifier: BSD-3-Clause
// RV64C C.LW - Load word (compressed regs), sign-extended to 64-bit

isa_state pc[63:0];
var c_instr[15:0];
isa_state rf[63:0][4:0];
mem umem[12:0];

var rs1_prime[2:0];
var rs1[4:0];
var rd_prime[2:0];
var rd[4:0];
var r1[63:0];
var uimm[6:0];
var zero_ext_imm[63:0];
var c_lw_addr[63:0];
var c_data[31:0];
var res[63:0];

// Read compressed instruction (16-bit)
c_instr = umem[pc];

// C.LW format: CL-type
// Encoding: 010 imm[5:3] rs1' imm[2|6] rd' 00
assume c_instr[1:0] == 0b00;
assume c_instr[15:13] == 0b010;

pc = pc + 2;

// Compressed register encoding: x8-x15
rs1_prime = c_instr[9:7];
rd_prime = c_instr[4:2];
rs1 = {2'b01, rs1_prime};
rd = {2'b01, rd_prime};

// Unsigned immediate: uimm[6:2] = {c_instr[5], c_instr[12:10], c_instr[6]}
uimm = {c_instr[5], c_instr[12:10], c_instr[6], 2'b00};
zero_ext_imm = {57'b0, uimm};

r1 = rf[rs1];

c_lw_addr = r1 + zero_ext_imm;
c_data = umem[c_lw_addr];

// Sign-extend 32-bit result to 64 bits
res = {{32{c_data[31]}}, c_data};

// No guard needed - rd is always 8-15, never 0
rf[rd] = res;
