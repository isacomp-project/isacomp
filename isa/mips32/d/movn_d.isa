// SPDX-License-Identifier: BSD-3-Clause
// MIPS32 MOVN.D - Move Double if GPR Not Zero
// Encoding: COP1 (010001), fmt=D (10001), rt, fs, fd, MOVN (010011)

isa_state pc[31:0];
var instr[31:0];
isa_state rf[31:0][4:0];
isa_state frf[63:0][4:0];
mem umem[12:0];

#ifdef DELAY_SLOT
// Branch delay slot state
isa_state delay_slot[0:0];
isa_state branch_target[31:0];

// Include delay slot aspect - handles PC override if we're in a delay slot
aspect ../delay_slot.isa gates pc, delay_slot;
#endif

var fs[4:0];
var fd[4:0];
var rt[4:0];
var f1[63:0];
var fd_val[63:0];
var rt_val[31:0];
var condition[0:0];
var result[63:0];

instr = umem[pc];
assume instr[31:26] == 0b010001;
assume instr[25:21] == 0b10001;    // fmt = D
assume instr[5:0] == 0b010011;     // MOVN

pc = pc + 4;

fd = instr[10:6];
fs = instr[15:11];
rt = instr[20:16];

f1 = frf[fs];
fd_val = frf[fd];
rt_val = rf[rt];

condition = (rt_val != 32'h00000000);

result = condition ? f1 : fd_val;

frf[fd] = result;
