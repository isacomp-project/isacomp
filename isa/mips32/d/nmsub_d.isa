// SPDX-License-Identifier: BSD-3-Clause
// MIPS32 NMSUB.D - Negated Fused Multiply-Subtract Double
// NMSUB.D fd, fr, fs, ft: fd = -((fs * ft) - fr)
// Encoding: COP1X (010011), fr, ft, fs, fd, NMSUB.D (111001)

isa_state pc[31:0];
var instr[31:0];
isa_state rf[31:0][4:0];
isa_state frf[63:0][4:0];
isa_state fcsr[31:0];
mem umem[12:0];

#ifdef DELAY_SLOT
// Branch delay slot state
isa_state delay_slot[0:0];
isa_state branch_target[31:0];

// Include delay slot aspect - handles PC override if we're in a delay slot
aspect ../delay_slot.isa gates pc, delay_slot;
#endif

var fr[4:0];
var fs[4:0];
var ft[4:0];
var fd[4:0];
var f1[63:0];
var f2[63:0];
var f3[63:0];
var neg_f3[63:0];
var fma_result[63:0];
var result[63:0];
var rm[2:0];

instr = umem[pc];
assume instr[31:26] == 0b010011;   // COP1X opcode
assume instr[5:0] == 0b111001;     // NMSUB.D

pc = pc + 4;

fr = instr[25:21];
ft = instr[20:16];
fs = instr[15:11];
fd = instr[10:6];

f1 = frf[fs];
f2 = frf[ft];
f3 = frf[fr];

// Negate fr for subtraction
neg_f3 = {~f3[63], f3[62:0]};

rm = {1'b0, fcsr[1], fcsr[1] ^ fcsr[0]};

fma_result = fp_fma_d(f1, f2, neg_f3, rm);

// Negate result
result = {~fma_result[63], fma_result[62:0]};

frf[fd] = result;
