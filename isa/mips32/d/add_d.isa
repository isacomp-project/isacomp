// SPDX-License-Identifier: BSD-3-Clause
// MIPS32 ADD.D - Double-precision floating-point add
// Encoding: COP1 (010001), fmt=D (10001), ft, fs, fd, func=ADD (000000)
// ADD.D fd, fs, ft: fd = fs + ft

isa_state pc[31:0];
var instr[31:0];
isa_state rf[31:0][4:0];       // Integer register file
isa_state frf[63:0][4:0];      // FP register file (64-bit for double precision)
isa_state fcsr[31:0];          // FP control/status register
mem umem[12:0];

#ifdef DELAY_SLOT
// Branch delay slot state
isa_state delay_slot[0:0];
isa_state branch_target[31:0];

// Include delay slot aspect - handles PC override if we're in a delay slot
aspect ../delay_slot.isa gates pc, delay_slot;
#endif

var fs[4:0];
var ft[4:0];
var fd[4:0];
var f1[63:0];
var f2[63:0];
var add_result[63:0];
var rm[2:0];

instr = umem[pc];
assume instr[31:26] == 0b010001;   // COP1 opcode
assume instr[25:21] == 0b10001;    // fmt = D (double-precision)
assume instr[5:0] == 0b000000;     // func = ADD

pc = pc + 4;

fd = instr[10:6];
fs = instr[15:11];
ft = instr[20:16];

f1 = frf[fs];
f2 = frf[ft];

// Map MIPS FCSR[1:0] to canonical IEEE 754 rounding mode
rm = {1'b0, fcsr[1], fcsr[1] ^ fcsr[0]};

add_result = fp_add_d(f1, f2, rm);

frf[fd] = add_result;
