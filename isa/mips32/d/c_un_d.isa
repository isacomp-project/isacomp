// SPDX-License-Identifier: BSD-3-Clause
// MIPS32 C.UN.D - Compare Unordered Double
// Sets FP condition code if either operand is NaN
// Encoding: COP1 (010001), fmt=D (10001), ft, fs, cc, 0, FC, cond=UN (0001)

isa_state pc[31:0];
var instr[31:0];
isa_state rf[31:0][4:0];
isa_state frf[63:0][4:0];
isa_state fcsr[31:0];
mem umem[12:0];

#ifdef DELAY_SLOT
// Branch delay slot state
isa_state delay_slot[0:0];
isa_state branch_target[31:0];

// Include delay slot aspect - handles PC override if we're in a delay slot
aspect ../delay_slot.isa gates pc, delay_slot;
#endif

var fs[4:0];
var ft[4:0];
var cc[2:0];
var f1[63:0];
var f2[63:0];
var result[0:0];
var new_fcsr[31:0];

instr = umem[pc];
assume instr[31:26] == 0b010001;   // COP1 opcode
assume instr[25:21] == 0b10001;    // fmt = D
assume instr[5:4] == 0b11;         // FC
assume instr[3:0] == 0b0001;       // cond = UN

pc = pc + 4;

fs = instr[15:11];
ft = instr[20:16];
cc = instr[10:8];

f1 = frf[fs];
f2 = frf[ft];

result = fp_is_unordered_d(f1, f2);

var fcc_mask[31:0];
var fcc_bit[31:0];
fcc_mask = (cc == 3'b000) ? 32'h00800000 : (32'h02000000 << cc[1:0]);
fcc_bit = result ? fcc_mask : 32'h0;
new_fcsr = (fcsr & ~fcc_mask) | fcc_bit;

fcsr = new_fcsr;
