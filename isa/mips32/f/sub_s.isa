// SPDX-License-Identifier: BSD-3-Clause
// MIPS32 SUB.S - Single-precision floating-point subtract
// Encoding: COP1 (010001), fmt=S (10000), ft, fs, fd, func=SUB (000001)
// SUB.S fd, fs, ft: fd = fs - ft

isa_state pc[31:0];
var instr[31:0];
isa_state rf[31:0][4:0];
isa_state frf[31:0][4:0];
isa_state fcsr[31:0];
mem umem[12:0];

#ifdef DELAY_SLOT
// Branch delay slot state
isa_state delay_slot[0:0];
isa_state branch_target[31:0];

// Include delay slot aspect - handles PC override if we're in a delay slot
aspect ../delay_slot.isa gates pc, delay_slot;
#endif

var fs[4:0];
var ft[4:0];
var fd[4:0];
var f1[31:0];
var f2[31:0];
var sub_result[31:0];
var rm[2:0];  // Rounding mode in canonical IEEE 754 encoding

instr = umem[pc];
assume instr[31:26] == 0b010001;   // COP1 opcode
assume instr[25:21] == 0b10000;    // fmt = S
assume instr[5:0] == 0b000001;     // func = SUB

pc = pc + 4;

fd = instr[10:6];
fs = instr[15:11];
ft = instr[20:16];

f1 = frf[fs];
f2 = frf[ft];

// Map MIPS FCSR[1:0] to canonical IEEE 754 rounding mode
rm = {1'b0, fcsr[1], fcsr[1] ^ fcsr[0]};

sub_result = fp_sub(f1, f2, rm);

frf[fd] = sub_result;
