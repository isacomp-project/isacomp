// SPDX-License-Identifier: BSD-3-Clause
// MIPS32 MSUB.S - Single-precision fused multiply-subtract
// Encoding: COP1X (010011), fr, ft, fs, fd, func=MSUB.S (101000)
// MSUB.S fd, fr, fs, ft: fd = (fs * ft) - fr

isa_state pc[31:0];
var instr[31:0];
isa_state rf[31:0][4:0];
isa_state frf[31:0][4:0];
isa_state fcsr[31:0];
mem umem[12:0];

#ifdef DELAY_SLOT
// Branch delay slot state
isa_state delay_slot[0:0];
isa_state branch_target[31:0];

// Include delay slot aspect - handles PC override if we're in a delay slot
aspect ../delay_slot.isa gates pc, delay_slot;
#endif

var fr[4:0];
var fs[4:0];
var ft[4:0];
var fd[4:0];
var f1[31:0];
var f2[31:0];
var f3[31:0];
var fms_result[31:0];
var rm[2:0];  // Rounding mode in canonical IEEE 754 encoding

instr = umem[pc];
assume instr[31:26] == 0b010011;   // COP1X opcode
assume instr[5:3] == 0b101;        // MSUB prefix
assume instr[2:0] == 0b000;        // S format

pc = pc + 4;

fd = instr[10:6];
fs = instr[15:11];
ft = instr[20:16];
fr = instr[25:21];

f1 = frf[fs];
f2 = frf[ft];
f3 = frf[fr];

// Map MIPS FCSR[1:0] to canonical IEEE 754 rounding mode
rm = {1'b0, fcsr[1], fcsr[1] ^ fcsr[0]};

// Fused multiply-subtract: (fs * ft) - fr
fms_result = fp_fmsub(f1, f2, f3, rm);

frf[fd] = fms_result;
