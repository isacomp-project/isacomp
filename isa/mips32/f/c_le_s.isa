// SPDX-License-Identifier: BSD-3-Clause
// MIPS32 C.LE.S - Single-precision compare less than or equal
// Encoding: COP1 (010001), fmt=S (10000), ft, fs, cc, 0, cond (111110)
// C.LE.S fs, ft: if fs <= ft then set condition code

isa_state pc[31:0];
var instr[31:0];
isa_state rf[31:0][4:0];
isa_state frf[31:0][4:0];
isa_state fcsr[31:0];
mem umem[12:0];

#ifdef DELAY_SLOT
// Branch delay slot state
isa_state delay_slot[0:0];
isa_state branch_target[31:0];

// Include delay slot aspect - handles PC override if we're in a delay slot
aspect ../delay_slot.isa gates pc, delay_slot;
#endif

var fs[4:0];
var ft[4:0];
var cc[2:0];
var f1[31:0];
var f2[31:0];
var cmp_result[0:0];
var new_fcsr[31:0];

instr = umem[pc];
assume instr[31:26] == 0b010001;   // COP1 opcode
assume instr[25:21] == 0b10000;    // fmt = S
assume instr[5:4] == 0b11;         // Compare instruction
assume instr[3:0] == 0b1110;       // cond = LE (less than or equal)

pc = pc + 4;

fs = instr[15:11];
ft = instr[20:16];
cc = instr[10:8];

f1 = frf[fs];
f2 = frf[ft];

// FP comparison - returns 1 if less than or equal
cmp_result = fp_le(f1, f2);

new_fcsr = fcsr;
new_fcsr[23] = cmp_result[0];

fcsr = new_fcsr;
