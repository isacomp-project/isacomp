// SPDX-License-Identifier: BSD-3-Clause
// MIPS32 CTC1 - Move Control Word to FP Coprocessor 1
// Copies GPR to FP control register
// Encoding: COP1 (010001), CT (00110), rt, fs, 00000000000
// CTC1 rt, fs: FP_control[fs] = rt
// Common registers: fs=31 (FCSR)

isa_state pc[31:0];
var instr[31:0];
isa_state rf[31:0][4:0];
isa_state frf[31:0][4:0];
isa_state fcsr[31:0];           // FP control/status register (reg 31)
mem umem[12:0];

#ifdef DELAY_SLOT
// Branch delay slot state
isa_state delay_slot[0:0];
isa_state branch_target[31:0];

// Include delay slot aspect - handles PC override if we're in a delay slot
aspect ../delay_slot.isa gates pc, delay_slot;
#endif

var rt[4:0];
var fs[4:0];
var gpr_val[31:0];

instr = umem[pc];
assume instr[31:26] == 0b010001;   // COP1 opcode
assume instr[25:21] == 0b00110;    // CT (control to)
assume instr[10:0] == 0b00000000000;

pc = pc + 4;

rt = instr[20:16];
fs = instr[15:11];

gpr_val = rf[rt];

// Only FCSR (reg 31) is writable
var is_fcsr[0:0];
is_fcsr = (fs == 5'd31);

fcsr when (is_fcsr) = gpr_val;
