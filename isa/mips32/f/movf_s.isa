// SPDX-License-Identifier: BSD-3-Clause
// MIPS32 MOVF.S - Move Single if FP Condition False
// Conditionally moves FP register if FCC is false
// Encoding: COP1 (010001), fmt=S (10000), cc, 0, tf=0, fs, fd, MOVCF (010001)
// MOVF.S fd, fs, cc: if !FCC[cc] then fd = fs

isa_state pc[31:0];
var instr[31:0];
isa_state rf[31:0][4:0];
isa_state frf[31:0][4:0];
isa_state fcsr[31:0];
mem umem[12:0];

#ifdef DELAY_SLOT
// Branch delay slot state
isa_state delay_slot[0:0];
isa_state branch_target[31:0];

// Include delay slot aspect - handles PC override if we're in a delay slot
aspect ../delay_slot.isa gates pc, delay_slot;
#endif

var fs[4:0];
var fd[4:0];
var cc[2:0];
var f1[31:0];
var fd_val[31:0];
var condition[0:0];
var result[31:0];

instr = umem[pc];
assume instr[31:26] == 0b010001;   // COP1 opcode
assume instr[25:21] == 0b10000;    // fmt = S
assume instr[5:0] == 0b010001;     // func = MOVCF
assume instr[16] == 0b0;           // tf = 0 (false)

pc = pc + 4;

fd = instr[10:6];
fs = instr[15:11];
cc = instr[20:18];

f1 = frf[fs];
fd_val = frf[fd];

// Check FP condition code 0 (move if false)
// Note: Only supporting cc=0 for now
var fcc0[0:0];
fcc0 = fcsr[23];
condition = ~fcc0;

result = condition ? f1 : fd_val;

frf[fd] = result;
