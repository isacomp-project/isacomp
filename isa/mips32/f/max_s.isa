// SPDX-License-Identifier: BSD-3-Clause
// MIPS32R6 MAX.S - Maximum single-precision
// Encoding: COP1 (010001), fmt=S (10000), ft, fs, fd, MAX (011110)
// MAX.S fd, fs, ft: fd = max(fs, ft)

isa_state pc[31:0];
var instr[31:0];
isa_state rf[31:0][4:0];
isa_state frf[31:0][4:0];
isa_state fcsr[31:0];
mem umem[12:0];

#ifdef DELAY_SLOT
// Branch delay slot state
isa_state delay_slot[0:0];
isa_state branch_target[31:0];

// Include delay slot aspect - handles PC override if we're in a delay slot
aspect ../delay_slot.isa gates pc, delay_slot;
#endif

var fs[4:0];
var ft[4:0];
var fd[4:0];
var f1[31:0];
var f2[31:0];
var max_result[31:0];

instr = umem[pc];
assume instr[31:26] == 0b010001;   // COP1 opcode
assume instr[25:21] == 0b10000;    // fmt = S
assume instr[5:0] == 0b011110;     // func = MAX

pc = pc + 4;

fd = instr[10:6];
fs = instr[15:11];
ft = instr[20:16];

f1 = frf[fs];
f2 = frf[ft];

max_result = fp_max(f1, f2);

frf[fd] = max_result;
