// SPDX-License-Identifier: BSD-3-Clause
// MIPS32 TRUNC.W.S - Truncate Single to Word (round toward zero)
// Converts single-precision float to 32-bit integer, truncating
// Encoding: COP1 (010001), fmt=S (10000), 00000, fs, fd, TRUNC.W (001101)
// TRUNC.W.S fd, fs: fd = (int32)fs (truncate toward zero)

isa_state pc[31:0];
var instr[31:0];
isa_state rf[31:0][4:0];
isa_state frf[31:0][4:0];
isa_state fcsr[31:0];
mem umem[12:0];

#ifdef DELAY_SLOT
// Branch delay slot state
isa_state delay_slot[0:0];
isa_state branch_target[31:0];

// Include delay slot aspect - handles PC override if we're in a delay slot
aspect ../delay_slot.isa gates pc, delay_slot;
#endif

var fs[4:0];
var fd[4:0];
var f1[31:0];
var result[31:0];
var rm[2:0];

instr = umem[pc];
assume instr[31:26] == 0b010001;   // COP1 opcode
assume instr[25:21] == 0b10000;    // fmt = S (single-precision)
assume instr[20:16] == 0b00000;    // ft = 0
assume instr[5:0] == 0b001101;     // func = TRUNC.W

pc = pc + 4;

fd = instr[10:6];
fs = instr[15:11];

f1 = frf[fs];

// Round toward zero (truncate) - IEEE 754 rounding mode 1
rm = 3'b001;

// Convert float to integer with truncation
result = fp_cvt_w_s(f1, rm);

frf[fd] = result;
