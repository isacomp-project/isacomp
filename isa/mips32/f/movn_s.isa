// SPDX-License-Identifier: BSD-3-Clause
// MIPS32 MOVN.S - Move Single if GPR Not Zero
// Conditionally moves FP register if GPR is not zero
// Encoding: COP1 (010001), fmt=S (10000), rt, fs, fd, MOVN (010011)
// MOVN.S fd, fs, rt: if rt != 0 then fd = fs

isa_state pc[31:0];
var instr[31:0];
isa_state rf[31:0][4:0];
isa_state frf[31:0][4:0];
mem umem[12:0];

#ifdef DELAY_SLOT
// Branch delay slot state
isa_state delay_slot[0:0];
isa_state branch_target[31:0];

// Include delay slot aspect - handles PC override if we're in a delay slot
aspect ../delay_slot.isa gates pc, delay_slot;
#endif

var fs[4:0];
var fd[4:0];
var rt[4:0];
var f1[31:0];
var fd_val[31:0];
var rt_val[31:0];
var condition[0:0];
var result[31:0];

instr = umem[pc];
assume instr[31:26] == 0b010001;   // COP1 opcode
assume instr[25:21] == 0b10000;    // fmt = S
assume instr[5:0] == 0b010011;     // func = MOVN

pc = pc + 4;

fd = instr[10:6];
fs = instr[15:11];
rt = instr[20:16];

f1 = frf[fs];
fd_val = frf[fd];
rt_val = rf[rt];

// Move if rt is not zero
condition = (rt_val != 32'h00000000);

result = condition ? f1 : fd_val;

frf[fd] = result;
