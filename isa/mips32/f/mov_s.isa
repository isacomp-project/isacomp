// SPDX-License-Identifier: BSD-3-Clause
// MIPS32 MOV.S - Move single-precision
// Encoding: COP1 (010001), fmt=S (10000), 00000, fs, fd, func=MOV (000110)
// MOV.S fd, fs: fd = fs

isa_state pc[31:0];
var instr[31:0];
isa_state rf[31:0][4:0];
isa_state frf[31:0][4:0];
mem umem[12:0];

#ifdef DELAY_SLOT
// Branch delay slot state
isa_state delay_slot[0:0];
isa_state branch_target[31:0];

// Include delay slot aspect - handles PC override if we're in a delay slot
aspect ../delay_slot.isa gates pc, delay_slot;
#endif

var fs[4:0];
var fd[4:0];
var f1[31:0];

instr = umem[pc];
assume instr[31:26] == 0b010001;   // COP1 opcode
assume instr[25:21] == 0b10000;    // fmt = S
assume instr[20:16] == 0b00000;    // ft = 0 (unused)
assume instr[5:0] == 0b000110;     // func = MOV

pc = pc + 4;

fd = instr[10:6];
fs = instr[15:11];

f1 = frf[fs];

frf[fd] = f1;
