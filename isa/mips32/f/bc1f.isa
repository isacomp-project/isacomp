// SPDX-License-Identifier: BSD-3-Clause
// MIPS32 BC1F - Branch on FP Condition False
// Branches if the FP condition code is false
// Encoding: COP1 (010001), BC (01000), cc, nd, tf=0, offset
// BC1F offset: if !FCC[cc] then branch

isa_state pc[31:0];
var instr[31:0];
isa_state rf[31:0][4:0];
isa_state frf[31:0][4:0];
isa_state fcsr[31:0];           // FP control/status register
mem umem[12:0];

#ifdef DELAY_SLOT
// Branch delay slot state
isa_state delay_slot[0:0];
isa_state branch_target[31:0];

// Include delay slot aspect - handles PC override if we're in a delay slot
aspect ../delay_slot.isa gates pc, delay_slot;
#endif

var cc[2:0];
var offset[15:0];
var sign_ext_offset[31:0];
var branch_offset[31:0];
var branch_dest[31:0];
var condition[0:0];

instr = umem[pc];
assume instr[31:26] == 0b010001;   // COP1 opcode
assume instr[25:21] == 0b01000;    // BC subopcode
assume instr[16] == 0b0;           // tf = 0 (false)

// cc field is in bits [20:18], nd in bit [17]
cc = instr[20:18];
offset = instr[15:0];

// Sign-extend and shift left by 2
sign_ext_offset = {{16{offset[15]}}, offset};
branch_offset = {sign_ext_offset[29:0], 2'b00};

// Branch destination (relative to delay slot)
branch_dest = pc + 4 + branch_offset;

// Check FP condition code 0 (bit 23 of fcsr)
// Note: Only supporting cc=0 for now
var fcc0[0:0];
fcc0 = fcsr[23];

// BC1F branches if condition is false
condition = ~fcc0;

// Update PC
#ifdef DELAY_SLOT
// Set up delay slot if branch taken (and not already in a delay slot)
delay_slot when (condition && !in_delay_slot) = 1;
branch_target when (condition && !in_delay_slot) = branch_dest;
// Always advance to delay slot instruction
pc = pc + 4;
#else
pc = condition ? branch_dest : (pc + 4);
#endif
