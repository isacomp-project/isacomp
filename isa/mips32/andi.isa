// SPDX-License-Identifier: BSD-3-Clause
isa_state pc[31:0];
var instr[31:0];
isa_state rf[31:0][4:0];
mem umem[12:0];

#ifdef DELAY_SLOT
// Branch delay slot state
isa_state delay_slot[0:0];
isa_state branch_target[31:0];

// Include delay slot aspect - handles PC override if we're in a delay slot
aspect delay_slot.isa gates pc, delay_slot;
#endif

var rs[4:0];
var rt[4:0];
var rd[4:0];
var zero_ext_imm[31:0];

var r1[31:0];
var r2[31:0];
var res[31:0];
instr = umem[pc];
assume instr[31:26] == 0xc;
pc = pc + 4;
rs = instr[25:21];
rt = instr[20:16];

r1 = rf[rs];

zero_ext_imm = {{16{1'b0}}, instr[15:0]};
res = r1 & zero_ext_imm;

rf[rt] when (rt != 0) = res;
