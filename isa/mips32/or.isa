// SPDX-License-Identifier: BSD-3-Clause
isa_state pc[31:0];
var instr[31:0];
isa_state rf[31:0][4:0];
mem umem[12:0];

#ifdef DELAY_SLOT
// Branch delay slot state
isa_state delay_slot[0:0];
isa_state branch_target[31:0];

// Include delay slot aspect - handles PC override if we're in a delay slot
aspect delay_slot.isa gates pc, delay_slot;
#endif

var rs[4:0];
var rt[4:0];
var rd[4:0];

var r1[31:0];
var r2[31:0];
var res[31:0];
instr = umem[pc];
assume instr[31:26] == 0;
assume instr[5:0] == 0x25;
pc = pc + 4;
rs = instr[25:21];
rt = instr[20:16];
rd = instr[15:11];

r1 = rf[rs];
r2 = rf[rt];

res = r1 | r2;

rf[rd] when (rd != 0) = res;
