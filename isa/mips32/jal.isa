// SPDX-License-Identifier: BSD-3-Clause
isa_state pc[31:0];
var instr[31:0];
isa_state rf[31:0][4:0];
mem umem[12:0];

#ifdef DELAY_SLOT
// Branch delay slot state
isa_state delay_slot[0:0];
isa_state branch_target[31:0];

// Include delay slot aspect - handles PC override if we're in a delay slot
aspect delay_slot.isa gates pc, delay_slot;
#endif

var addr[25:0];
var jump_addr[31:0];
var pc_plus_8[31:0];

instr = umem[pc];
assume instr[31:26] == 0x3;
addr = instr[25:0];

pc_plus_8 = pc + 8;
jump_addr = {pc_plus_8[31:28], addr, 2'b0};

rf[31] = pc_plus_8;
#ifdef DELAY_SLOT
// Set up delay slot for next instruction
delay_slot when (!in_delay_slot) = 1;
branch_target when (!in_delay_slot) = jump_addr;
// Advance to delay slot instruction
pc = pc + 4;
#else
pc = jump_addr;
#endif
