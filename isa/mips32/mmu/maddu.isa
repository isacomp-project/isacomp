// SPDX-License-Identifier: BSD-3-Clause
// MIPS32 MADDU - Multiply and Add Unsigned Word to HI/LO
// {HI, LO} = {HI, LO} + (rs * rt) (unsigned)
// Encoding: 011100 rs rt 00000 00000 000001
//           SPECIAL2                MADDU

isa_state pc[31:0];
var instr[31:0];
isa_state rf[31:0][4:0];
isa_state hi[31:0];
isa_state lo[31:0];
mem umem[17:0];

var rs[4:0];
var rt[4:0];
var rs_val[31:0];
var rt_val[31:0];
var product[63:0];
var hilo[63:0];
var result[63:0];

#ifdef DELAY_SLOT
// Branch delay slot state
isa_state delay_slot[0:0];
isa_state branch_target[31:0];

// Include delay slot aspect - handles PC override if we're in a delay slot
aspect delay_slot.isa gates pc, delay_slot;
#endif

// Include TLB aspect for PC translation
// Include TLB aspect for PC translation and CP0 state
#ifdef MMU
aspect tlb.isa gates pc, cp0_status, cp0_cause, cp0_epc, cp0_badvaddr, cp0_entryhi, cp0_context;
instr = umem[pc_pa];
#else
instr = umem[pc];
#endif

// MADDU encoding
assume instr[31:26] == 6'b011100;  // SPECIAL2 opcode
assume instr[5:0] == 6'b000001;    // MADDU function
assume instr[15:6] == 10'b0000000000;

rs = instr[25:21];
rt = instr[20:16];

rs_val = rf[rs];
rt_val = rf[rt];

// Unsigned multiplication
product = {1'b0, rs_val} * {1'b0, rt_val};

// Add to HI:LO
hilo = {hi, lo};
result = hilo + product;

// Update HI and LO
hi = result[63:32];
lo = result[31:0];

pc = pc + 4;
