// SPDX-License-Identifier: BSD-3-Clause
// MIPS32 LL - Load Linked
// Loads a word and sets up for an atomic read-modify-write sequence
// Sets LLbit and stores the address for SC to check
// Encoding: 110000 base rt offset
//           LL     rs   rt imm[15:0]

isa_state pc[31:0];
var instr[31:0];
isa_state rf[31:0][4:0];
isa_state llbit[0:0];
isa_state lladdr[31:0];
mem umem[17:0];

var rs[4:0];
var rt[4:0];
var imm[15:0];
var sign_ext_imm[31:0];
var addr[31:0];
var base[31:0];
var data[31:0];

#ifdef DELAY_SLOT
// Branch delay slot state
isa_state delay_slot[0:0];
isa_state branch_target[31:0];

// Include delay slot aspect - handles PC override if we're in a delay slot
aspect delay_slot.isa gates pc, delay_slot;
#endif

// Include TLB aspect for PC translation
// Include TLB aspect for PC translation and CP0 state
#ifdef MMU
aspect tlb.isa gates pc, cp0_status, cp0_cause, cp0_epc, cp0_badvaddr, cp0_entryhi, cp0_context;
instr = umem[pc_pa];
#else
instr = umem[pc];
#endif

// LL encoding
assume instr[31:26] == 6'b110000;

rs = instr[25:21];
rt = instr[20:16];
imm = instr[15:0];

base = rf[rs];
sign_ext_imm = {{16{imm[15]}}, imm};
addr = base + sign_ext_imm;

// TLB lookup for data address
data = umem[addr];

// Set LLbit and save linked address
llbit = 1'b1;
lladdr = addr;

// Write to destination register
rf[rt] when (rt != 0) = data;

// Update PC
pc = pc + 4;
