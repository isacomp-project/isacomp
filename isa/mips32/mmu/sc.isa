// SPDX-License-Identifier: BSD-3-Clause
// MIPS32 SC - Store Conditional
// Completes an atomic read-modify-write sequence started by LL
// If LLbit is set and address matches, stores the word and sets rt = 1
// If LLbit is clear or address mismatch, does not store and sets rt = 0
// Encoding: 111000 base rt offset
//           SC     rs   rt imm[15:0]

isa_state pc[31:0];
var instr[31:0];
isa_state rf[31:0][4:0];
isa_state llbit[0:0];
isa_state lladdr[31:0];
mem umem[17:0];

var rs[4:0];
var rt[4:0];
var imm[15:0];
var sign_ext_imm[31:0];
var addr[31:0];
var base[31:0];
var data[31:0];
var sc_success[0:0];
var result[31:0];

#ifdef DELAY_SLOT
// Branch delay slot state
isa_state delay_slot[0:0];
isa_state branch_target[31:0];

// Include delay slot aspect - handles PC override if we're in a delay slot
aspect delay_slot.isa gates pc, delay_slot;
#endif

// Include TLB aspect for PC translation
// Include TLB aspect for PC translation and CP0 state
#ifdef MMU
aspect tlb.isa gates pc, cp0_status, cp0_cause, cp0_epc, cp0_badvaddr, cp0_entryhi, cp0_context;
instr = umem[pc_pa];
#else
instr = umem[pc];
#endif

// SC encoding
assume instr[31:26] == 6'b111000;

rs = instr[25:21];
rt = instr[20:16];
imm = instr[15:0];

base = rf[rs];
sign_ext_imm = {{16{imm[15]}}, imm};
addr = base + sign_ext_imm;

// Get data to store
data = rf[rt];

// TLB lookup for data address
var addr_pa[31:0];
addr_pa = addr;

// Check if SC should succeed
// Success requires: LLbit = 1 AND address matches lladdr
// In a real multiprocessor, would also check for intervening stores
sc_success = llbit & (addr == lladdr);

// Conditionally perform the store
umem[addr_pa] when (sc_success) = data;

// Clear LLbit (always, regardless of success)
llbit = 1'b0;

// Write success/failure to rt (1 = success, 0 = failure)
// Zero-extend sc_success to 32 bits (no ternary needed)
result = {31'b0, sc_success};
rf[rt] when (rt != 0) = result;

// Update PC
pc = pc + 4;
