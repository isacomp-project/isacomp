// SPDX-License-Identifier: BSD-3-Clause
// MIPS32 MULTU - Multiply Unsigned
// Multiplies rs by rt (unsigned), stores 64-bit result in HI:LO
// Encoding: 000000 rs rt 00000 00000 011001
//           SPECIAL rs rt 0     0     MULTU

isa_state pc[31:0];
var instr[31:0];
isa_state rf[31:0][4:0];
isa_state hi[31:0];
isa_state lo[31:0];
mem umem[17:0];

var rs[4:0];
var rt[4:0];
var r1[31:0];
var r2[31:0];

#ifdef DELAY_SLOT
// Branch delay slot state
isa_state delay_slot[0:0];
isa_state branch_target[31:0];

// Include delay slot aspect - handles PC override if we're in a delay slot
aspect delay_slot.isa gates pc, delay_slot;
#endif

// Include TLB aspect for PC translation and HI/LO state
// Include TLB aspect for PC translation and CP0 state
#ifdef MMU
aspect tlb.isa gates pc, cp0_status, cp0_cause, cp0_epc, cp0_badvaddr, cp0_entryhi, cp0_context;
instr = umem[pc_pa];
#else
instr = umem[pc];
#endif

// MULTU encoding
assume instr[31:26] == 6'b000000;
assume instr[5:0] == 6'b011001;
assume instr[15:6] == 10'b0000000000;

rs = instr[25:21];
rt = instr[20:16];

r1 = rf[rs];
r2 = rf[rt];

// 32x32 unsigned multiply to get 64-bit result
// Split into 16-bit halves, zero-extend to 32 bits for proper multiplication
var a0[31:0]; var a1[31:0];
var b0[31:0]; var b1[31:0];
var p00[31:0]; var p01[31:0]; var p10[31:0]; var p11[31:0];

a0 = {16'b0, r1[15:0]};
a1 = {16'b0, r1[31:16]};
b0 = {16'b0, r2[15:0]};
b1 = {16'b0, r2[31:16]};

// Partial products
p00 = a0 * b0;
p01 = a0 * b1;
p10 = a1 * b0;
p11 = a1 * b1;

// Sum partial products
var sum_mid[32:0];
var result_lo[31:0];
var result_hi[31:0];
var carry_to_hi[0:0];

sum_mid = p01 + p10;

var lo_sum[32:0];
lo_sum = p00 + {sum_mid[15:0], 16'b0};
result_lo = lo_sum[31:0];
carry_to_hi = lo_sum[32];

result_hi = p11 + {1'b0, sum_mid[32:16]} + {1'b0, carry_to_hi};

// Write to HI and LO
hi = result_hi;
lo = result_lo;

// Update PC
pc = pc + 4;
