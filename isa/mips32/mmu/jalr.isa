// SPDX-License-Identifier: BSD-3-Clause
// MIPS32 JALR - Jump and Link Register (with MMU support)
isa_state pc[31:0];
var instr[31:0];
isa_state rf[31:0][4:0];
mem umem[17:0];

var rs[4:0]; var rd[4:0];
var jump_addr[31:0];
var return_addr[31:0];

#ifdef DELAY_SLOT
// Branch delay slot state
isa_state delay_slot[0:0];
isa_state branch_target[31:0];

// Include delay slot aspect - handles PC override if we're in a delay slot
aspect delay_slot.isa gates pc, delay_slot;
#endif

// Include TLB aspect for PC translation and CP0 state
#ifdef MMU
aspect tlb.isa gates pc, cp0_status, cp0_cause, cp0_epc, cp0_badvaddr, cp0_entryhi, cp0_context;
instr = umem[pc_pa];
#else
instr = umem[pc];
#endif

assume instr[31:26] == 0x00;
assume instr[5:0] == 0x09;

rs = instr[25:21];
rd = instr[15:11];
jump_addr = rf[rs];
return_addr = pc + 8;

rf[rd] when (rd != 0) = return_addr;
#ifdef DELAY_SLOT
// Set up delay slot for next instruction
delay_slot when (!in_delay_slot) = 1;
branch_target when (!in_delay_slot) = jump_addr;
// Advance to delay slot instruction
pc = pc + 4;
#else
pc = jump_addr;
#endif
