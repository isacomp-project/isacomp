// SPDX-License-Identifier: BSD-3-Clause
// MIPS32 BEQ - Branch if Equal (with MMU support)
isa_state pc[31:0];
var instr[31:0];
isa_state rf[31:0][4:0];
mem umem[17:0];

var rs[4:0]; var rt[4:0]; var imm[15:0];
var r1[31:0]; var r2[31:0];
var sign_ext_imm[31:0]; var branch_offset[31:0];
var branch_dest[31:0]; var take_branch[0:0];

#ifdef DELAY_SLOT
// Branch delay slot state
isa_state delay_slot[0:0];
isa_state branch_target[31:0];

// Include delay slot aspect - handles PC override if we're in a delay slot
aspect delay_slot.isa gates pc, delay_slot;
#endif

// Include TLB aspect for PC translation and CP0 state
#ifdef MMU
aspect tlb.isa gates pc, cp0_status, cp0_cause, cp0_epc, cp0_badvaddr, cp0_entryhi, cp0_context;
instr = umem[pc_pa];
#else
instr = umem[pc];
#endif

assume instr[31:26] == 0x04;

rs = instr[25:21]; rt = instr[20:16]; imm = instr[15:0];
r1 = rf[rs]; r2 = rf[rt];
sign_ext_imm = {{16{imm[15]}}, imm};
branch_offset = {sign_ext_imm[29:0], 2'b00};
take_branch = (r1 == r2);
branch_dest = pc + 4 + branch_offset;
#ifdef DELAY_SLOT
// Set up delay slot if branch taken (and not already in a delay slot)
delay_slot when (take_branch && !in_delay_slot) = 1;
branch_target when (take_branch && !in_delay_slot) = branch_dest;
// Always advance to delay slot instruction
pc = pc + 4;
#else
pc = take_branch ? branch_dest : (pc + 4);
#endif
