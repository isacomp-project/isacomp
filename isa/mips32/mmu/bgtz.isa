// SPDX-License-Identifier: BSD-3-Clause
// MIPS32 BGTZ - Branch if Greater Than Zero
// Branches if rs > 0 (signed comparison)
// Encoding: 000111 rs 00000 offset
//           BGTZ   rs 0     imm[15:0]

isa_state pc[31:0];
var instr[31:0];
isa_state rf[31:0][4:0];
mem umem[17:0];

var rs[4:0];
var imm[15:0];
var r1[31:0];
var sign_ext_imm[31:0];
var branch_offset[31:0];
var branch_dest[31:0];
var take_branch[0:0];

#ifdef DELAY_SLOT
// Branch delay slot state
isa_state delay_slot[0:0];
isa_state branch_target[31:0];

// Include delay slot aspect - handles PC override if we're in a delay slot
aspect delay_slot.isa gates pc, delay_slot;
#endif

// Include TLB aspect for PC translation
// Include TLB aspect for PC translation and CP0 state
#ifdef MMU
aspect tlb.isa gates pc, cp0_status, cp0_cause, cp0_epc, cp0_badvaddr, cp0_entryhi, cp0_context;
instr = umem[pc_pa];
#else
instr = umem[pc];
#endif

// BGTZ encoding
assume instr[31:26] == 6'b000111;  // BGTZ opcode
assume instr[20:16] == 5'b00000;   // Must be zero

rs = instr[25:21];
imm = instr[15:0];

r1 = rf[rs];

// Sign-extend immediate and shift left by 2
sign_ext_imm = {{16{imm[15]}}, imm};
branch_offset = {sign_ext_imm[29:0], 2'b00};

// Branch if rs > 0 (signed): not negative AND not zero
var is_positive[0:0];
var is_zero[0:0];
is_zero = (r1 == 0x0);
is_positive = (r1[31] == 0) & (~is_zero);
take_branch = is_positive;

// Calculate branch destination (relative to PC+4)
branch_dest = pc + 4 + branch_offset;

// Update PC
#ifdef DELAY_SLOT
// Set up delay slot if branch taken (and not already in a delay slot)
delay_slot when (take_branch && !in_delay_slot) = 1;
branch_target when (take_branch && !in_delay_slot) = branch_dest;
// Always advance to delay slot instruction
pc = pc + 4;
#else
pc = take_branch ? branch_dest : (pc + 4);
#endif
