// SPDX-License-Identifier: BSD-3-Clause
// MIPS32 MFLO - Move From LO
// Copies the LO register to rd
// Encoding: 000000 00000 00000 rd 00000 010010
//           SPECIAL 0     0     rd 0     MFLO

isa_state pc[31:0];
var instr[31:0];
isa_state rf[31:0][4:0];
isa_state hi[31:0];
isa_state lo[31:0];
mem umem[17:0];

var rd[4:0];

#ifdef DELAY_SLOT
// Branch delay slot state
isa_state delay_slot[0:0];
isa_state branch_target[31:0];

// Include delay slot aspect - handles PC override if we're in a delay slot
aspect delay_slot.isa gates pc, delay_slot;
#endif

// Include TLB aspect for PC translation and HI/LO state
// Include TLB aspect for PC translation and CP0 state
#ifdef MMU
aspect tlb.isa gates pc, cp0_status, cp0_cause, cp0_epc, cp0_badvaddr, cp0_entryhi, cp0_context;
instr = umem[pc_pa];
#else
instr = umem[pc];
#endif

// MFLO encoding
assume instr[31:26] == 6'b000000;
assume instr[25:16] == 10'b0000000000;
assume instr[10:6] == 5'b00000;
assume instr[5:0] == 6'b010010;

rd = instr[15:11];

// Write LO to destination register
rf[rd] when (rd != 0) = lo;

// Update PC
pc = pc + 4;
