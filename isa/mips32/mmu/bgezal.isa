// SPDX-License-Identifier: BSD-3-Clause
// MIPS32 BGEZAL - Branch if Greater or Equal Zero And Link
// Branches if rs >= 0 (signed) and saves return address to $ra
// Encoding: 000001 rs 10001 offset
//           REGIMM rs BGEZAL imm[15:0]

isa_state pc[31:0];
var instr[31:0];
isa_state rf[31:0][4:0];
mem umem[17:0];

var rs[4:0];
var imm[15:0];
var r1[31:0];
var sign_ext_imm[31:0];
var branch_offset[31:0];
var branch_dest[31:0];
var take_branch[0:0];
var return_addr[31:0];

#ifdef DELAY_SLOT
// Branch delay slot state
isa_state delay_slot[0:0];
isa_state branch_target[31:0];

// Include delay slot aspect - handles PC override if we're in a delay slot
aspect delay_slot.isa gates pc, delay_slot;
#endif

// Include TLB aspect for PC translation
// Include TLB aspect for PC translation and CP0 state
#ifdef MMU
aspect tlb.isa gates pc, cp0_status, cp0_cause, cp0_epc, cp0_badvaddr, cp0_entryhi, cp0_context;
instr = umem[pc_pa];
#else
instr = umem[pc];
#endif

// BGEZAL encoding
assume instr[31:26] == 6'b000001;  // REGIMM opcode
assume instr[20:16] == 5'b10001;   // BGEZAL function (17)

rs = instr[25:21];
imm = instr[15:0];

r1 = rf[rs];

// Sign-extend immediate and shift left by 2
sign_ext_imm = {{16{imm[15]}}, imm};
branch_offset = {sign_ext_imm[29:0], 2'b00};

// Branch if rs >= 0 (signed)
take_branch = (r1[31] == 0);

// Calculate branch destination (relative to PC+4)
branch_dest = pc + 4 + branch_offset;

// Return address is PC+8 (after delay slot)
return_addr = pc + 8;

// Always save return address to $ra ($31), regardless of branch taken
rf[31] = return_addr;

// Update PC
#ifdef DELAY_SLOT
// Set up delay slot if branch taken (and not already in a delay slot)
delay_slot when (take_branch && !in_delay_slot) = 1;
branch_target when (take_branch && !in_delay_slot) = branch_dest;
// Always advance to delay slot instruction
pc = pc + 4;
#else
pc = take_branch ? branch_dest : (pc + 4);
#endif
