// SPDX-License-Identifier: BSD-3-Clause
// MIPS32 RDHWR - Read Hardware Register
// Reads hardware register into GPR
// Encoding: 011111 00000 rt rd 00000 111011
//           SPECIAL3              RDHWR

isa_state pc[31:0];
var instr[31:0];
isa_state rf[31:0][4:0];
mem umem[17:0];

var rt[4:0];
var rd[4:0];
var result[31:0];

#ifdef DELAY_SLOT
// Branch delay slot state
isa_state delay_slot[0:0];
isa_state branch_target[31:0];

// Include delay slot aspect - handles PC override if we're in a delay slot
aspect ../delay_slot.isa gates pc, delay_slot;
#endif

// Include TLB aspect for PC translation and CP0 state
#ifdef MMU
aspect ../tlb.isa gates pc, cp0_status, cp0_cause, cp0_epc, cp0_badvaddr, cp0_entryhi, cp0_context;
instr = umem[pc_pa];
#else
instr = umem[pc];
#endif

// RDHWR encoding
assume instr[31:26] == 6'b011111;  // SPECIAL3 opcode
assume instr[25:21] == 5'b00000;   // rs = 0
assume instr[5:0] == 6'b111011;    // RDHWR function
assume instr[10:6] == 5'b00000;    // sa = 0

rt = instr[20:16];
rd = instr[15:11];

// Hardware registers:
// $0 (CPUNum): CPU number - always 0 for single core
// $1 (SYNCI_Step): Cache line size for SYNCI - 0 (no cache)
// $2 (CC): Cycle counter - return Count register
// $3 (CCRes): CC resolution - 1 (every cycle)
// $29 (ULR): User Local Register - TLS pointer from cp0_userlocal

// Select hardware register value
var is_cpunum[0:0];
var is_synci[0:0];
var is_cc[0:0];
var is_ccres[0:0];
var is_ulr[0:0];

is_cpunum = (rd == 0);
is_synci = (rd == 1);
is_cc = (rd == 2);
is_ccres = (rd == 3);
is_ulr = (rd == 29);

// For ULR, we use EntryHi's ASID field as a simple TLS base
// In a full implementation, there would be a dedicated UserLocal register
// For now, return 0 for ULR (Linux will set up TLS differently)

// Build mux chain for hardware register values
var mux_ulr[31:0];
var mux_ccres[31:0];
var mux_cc[31:0];
var mux_synci[31:0];

mux_ulr = is_ulr ? 32'h00000000 : 32'h00000000;
mux_ccres = is_ccres ? 32'h00000001 : mux_ulr;
mux_cc = is_cc ? cp0_count : mux_ccres;
mux_synci = is_synci ? 32'h00000000 : mux_cc;
result = is_cpunum ? 32'h00000000 : mux_synci;

rf[rt] when (rt != 0) = result;

pc = pc + 4;
