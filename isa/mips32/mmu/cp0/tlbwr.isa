tlb_v0[18] when (wr_18) = wr_v0; tlb_v0[19] when (wr_19) = wr_v0;
tlb_v0[20] when (wr_20) = wr_v0; tlb_v0[21] when (wr_21) = wr_v0;
tlb_v0[22] when (wr_22) = wr_v0; tlb_v0[23] when (wr_23) = wr_v0;
tlb_v0[24] when (wr_24) = wr_v0; tlb_v0[25] when (wr_25) = wr_v0;
tlb_v0[26] when (wr_26) = wr_v0; tlb_v0[27] when (wr_27) = wr_v0;
tlb_v0[28] when (wr_28) = wr_v0; tlb_v0[29] when (wr_29) = wr_v0;
tlb_v0[30] when (wr_30) = wr_v0; tlb_v0[31] when (wr_31) = wr_v0;

// Write V1
tlb_v1[0] when (wr_0) = wr_v1; tlb_v1[1] when (wr_1) = wr_v1;
tlb_v1[2] when (wr_2) = wr_v1; tlb_v1[3] when (wr_3) = wr_v1;
tlb_v1[4] when (wr_4) = wr_v1; tlb_v1[5] when (wr_5) = wr_v1;
tlb_v1[6] when (wr_6) = wr_v1; tlb_v1[7] when (wr_7) = wr_v1;
