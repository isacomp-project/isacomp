tlb_d1[26] when (wr_26) = wr_d1; tlb_d1[27] when (wr_27) = wr_d1;
tlb_d1[28] when (wr_28) = wr_d1; tlb_d1[29] when (wr_29) = wr_d1;
tlb_d1[30] when (wr_30) = wr_d1; tlb_d1[31] when (wr_31) = wr_d1;

// Decrement Random register (wraps from Wired to 31)
// Random cycles: Wired <= Random <= 31
var wired_val[4:0];
var next_random[4:0];
var at_wired[0:0];

wired_val = cp0_wired[4:0];
at_wired = (cp0_random[4:0] == wired_val);
next_random = at_wired ? 31 : (cp0_random[4:0] - 1);
cp0_random = {27'b0, next_random};

// Update PC
pc = pc + 4;
