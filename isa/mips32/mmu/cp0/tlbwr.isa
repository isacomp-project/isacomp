tlb_v1[14] when (wr_14) = wr_v1; tlb_v1[15] when (wr_15) = wr_v1;
tlb_v1[16] when (wr_16) = wr_v1; tlb_v1[17] when (wr_17) = wr_v1;
tlb_v1[18] when (wr_18) = wr_v1; tlb_v1[19] when (wr_19) = wr_v1;
tlb_v1[20] when (wr_20) = wr_v1; tlb_v1[21] when (wr_21) = wr_v1;
