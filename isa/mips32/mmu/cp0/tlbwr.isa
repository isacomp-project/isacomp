tlb_d1[12] when (wr_12) = wr_d1; tlb_d1[13] when (wr_13) = wr_d1;
tlb_d1[14] when (wr_14) = wr_d1; tlb_d1[15] when (wr_15) = wr_d1;
tlb_d1[16] when (wr_16) = wr_d1; tlb_d1[17] when (wr_17) = wr_d1;
tlb_d1[18] when (wr_18) = wr_d1; tlb_d1[19] when (wr_19) = wr_d1;
