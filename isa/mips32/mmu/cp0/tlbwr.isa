tlb_v1[28] when (wr_28) = wr_v1; tlb_v1[29] when (wr_29) = wr_v1;
tlb_v1[30] when (wr_30) = wr_v1; tlb_v1[31] when (wr_31) = wr_v1;

// Write D0
tlb_d0[0] when (wr_0) = wr_d0; tlb_d0[1] when (wr_1) = wr_d0;
tlb_d0[2] when (wr_2) = wr_d0; tlb_d0[3] when (wr_3) = wr_d0;
tlb_d0[4] when (wr_4) = wr_d0; tlb_d0[5] when (wr_5) = wr_d0;
tlb_d0[6] when (wr_6) = wr_d0; tlb_d0[7] when (wr_7) = wr_d0;
tlb_d0[8] when (wr_8) = wr_d0; tlb_d0[9] when (wr_9) = wr_d0;
tlb_d0[10] when (wr_10) = wr_d0; tlb_d0[11] when (wr_11) = wr_d0;
tlb_d0[12] when (wr_12) = wr_d0; tlb_d0[13] when (wr_13) = wr_d0;
tlb_d0[14] when (wr_14) = wr_d0; tlb_d0[15] when (wr_15) = wr_d0;
tlb_d0[16] when (wr_16) = wr_d0; tlb_d0[17] when (wr_17) = wr_d0;
tlb_d0[18] when (wr_18) = wr_d0; tlb_d0[19] when (wr_19) = wr_d0;
tlb_d0[20] when (wr_20) = wr_d0; tlb_d0[21] when (wr_21) = wr_d0;
tlb_d0[22] when (wr_22) = wr_d0; tlb_d0[23] when (wr_23) = wr_d0;
tlb_d0[24] when (wr_24) = wr_d0; tlb_d0[25] when (wr_25) = wr_d0;
tlb_d0[26] when (wr_26) = wr_d0; tlb_d0[27] when (wr_27) = wr_d0;
tlb_d0[28] when (wr_28) = wr_d0; tlb_d0[29] when (wr_29) = wr_d0;
tlb_d0[30] when (wr_30) = wr_d0; tlb_d0[31] when (wr_31) = wr_d0;

// Write D1
tlb_d1[0] when (wr_0) = wr_d1; tlb_d1[1] when (wr_1) = wr_d1;
tlb_d1[2] when (wr_2) = wr_d1; tlb_d1[3] when (wr_3) = wr_d1;
tlb_d1[4] when (wr_4) = wr_d1; tlb_d1[5] when (wr_5) = wr_d1;
tlb_d1[6] when (wr_6) = wr_d1; tlb_d1[7] when (wr_7) = wr_d1;
tlb_d1[8] when (wr_8) = wr_d1; tlb_d1[9] when (wr_9) = wr_d1;
