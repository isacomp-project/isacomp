// SPDX-License-Identifier: BSD-3-Clause
// MIPS32 CACHE - Cache Operation (NOP stub)
// Since this processor has no caches, CACHE is a NOP
// Encoding: 101111 base[4:0] op[4:0] offset[15:0]
//           CACHE  rs        rt      imm16

isa_state pc[31:0];
var instr[31:0];
isa_state rf[31:0][4:0];
mem umem[17:0];

#ifdef DELAY_SLOT
// Branch delay slot state
isa_state delay_slot[0:0];
isa_state branch_target[31:0];

// Include delay slot aspect - handles PC override if we're in a delay slot
aspect ../delay_slot.isa gates pc, delay_slot;
#endif

// Include TLB aspect for PC translation and CP0 state
#ifdef MMU
aspect ../tlb.isa gates pc, cp0_status, cp0_cause, cp0_epc, cp0_badvaddr, cp0_entryhi, cp0_context;
instr = umem[pc_pa];
#else
instr = umem[pc];
#endif

// CACHE encoding
assume instr[31:26] == 6'b101111;  // CACHE opcode

// This is a NOP - just advance PC
// No cache operations needed since we have no caches
pc = pc + 4;
