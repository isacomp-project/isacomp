// SPDX-License-Identifier: BSD-3-Clause
// MIPS32R2 DI - Disable Interrupts
// Clears Status.IE bit and returns old Status value to rt
// Encoding: 010000 01011 rt 01100 00000 000000
//           COP0   MFMC0 rt  $12   0     SC=0

isa_state pc[31:0];
var instr[31:0];
isa_state rf[31:0][4:0];
mem umem[17:0];

var rt[4:0];
var old_status[31:0];
var new_status[31:0];

#ifdef DELAY_SLOT
// Branch delay slot state
isa_state delay_slot[0:0];
isa_state branch_target[31:0];

// Include delay slot aspect - handles PC override if we're in a delay slot
aspect ../delay_slot.isa gates pc, delay_slot;
#endif

// Include TLB aspect for PC translation and CP0 state
#ifdef MMU
aspect ../tlb.isa gates pc, cp0_status, cp0_cause, cp0_epc, cp0_badvaddr, cp0_entryhi, cp0_context;
instr = umem[pc_pa];
#else
instr = umem[pc];
#endif

// DI encoding: COP0, MFMC0 (01011), rt, rd=12, 0, SC=0 (bit 5 = 0)
assume instr[31:26] == 6'b010000;  // COP0 opcode
assume instr[25:21] == 5'b01011;   // MFMC0 function
assume instr[15:11] == 5'b01100;   // rd = 12 (Status)
assume instr[5] == 1'b0;           // SC = 0 (disable)

rt = instr[20:16];

// Read old Status value
old_status = cp0_status;

// Clear IE bit (bit 0)
new_status = cp0_status & 32'hFFFFFFFE;
cp0_status = new_status;

// Write old Status value to rt
rf[rt] when (rt != 0) = old_status;

pc = pc + 4;
