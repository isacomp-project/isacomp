// SPDX-License-Identifier: BSD-3-Clause
// MIPS32 SYNC - Synchronize Shared Memory (NOP stub)
// Memory barrier instruction - NOP for single-core with no caches
// Encoding: 000000 00000 00000 00000 stype[4:0] 001111
//           SPECIAL                            SYNC

isa_state pc[31:0];
var instr[31:0];
isa_state rf[31:0][4:0];
mem umem[17:0];

#ifdef DELAY_SLOT
// Branch delay slot state
isa_state delay_slot[0:0];
isa_state branch_target[31:0];

// Include delay slot aspect - handles PC override if we're in a delay slot
aspect ../delay_slot.isa gates pc, delay_slot;
#endif

// Include TLB aspect for PC translation and CP0 state
#ifdef MMU
aspect ../tlb.isa gates pc, cp0_status, cp0_cause, cp0_epc, cp0_badvaddr, cp0_entryhi, cp0_context;
instr = umem[pc_pa];
#else
instr = umem[pc];
#endif

// SYNC encoding
assume instr[31:26] == 6'b000000;  // SPECIAL opcode
assume instr[25:21] == 5'b00000;   // rs = 0
assume instr[20:16] == 5'b00000;   // rt = 0
assume instr[15:11] == 5'b00000;   // rd = 0
assume instr[5:0] == 6'b001111;    // SYNC function

// This is a NOP - just advance PC
// No memory synchronization needed for single-core
pc = pc + 4;
