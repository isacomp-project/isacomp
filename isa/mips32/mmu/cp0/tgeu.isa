// SPDX-License-Identifier: BSD-3-Clause
// MIPS32 TGEU - Trap if Greater or Equal Unsigned
// Generates a Trap exception (ExcCode = 13) if rs >= rt (unsigned)
// Encoding: 000000 rs[4:0] rt[4:0] code[9:0] 110001
//           SPECIAL                          TGEU

isa_state pc[31:0];
var instr[31:0];
isa_state rf[31:0][4:0];
mem umem[17:0];

#ifdef DELAY_SLOT
// Branch delay slot state
isa_state delay_slot[0:0];
isa_state branch_target[31:0];

// Include delay slot aspect - handles PC override if we're in a delay slot
aspect ../delay_slot.isa gates pc, delay_slot;
#endif

// Include TLB aspect for PC translation and CP0 state
#ifdef MMU
aspect ../tlb.isa gates pc, cp0_status, cp0_cause, cp0_epc, cp0_badvaddr, cp0_entryhi, cp0_context;
instr = umem[pc_pa];
#else
instr = umem[pc];
#endif

// TGEU encoding
assume instr[31:26] == 6'b000000;  // SPECIAL opcode
assume instr[5:0] == 6'b110001;    // TGEU function

// Extract operands
var rs[4:0];
var rt[4:0];
var rs_val[31:0];
var rt_val[31:0];

rs = instr[25:21];
rt = instr[20:16];
rs_val = rf[rs];
rt_val = rf[rt];

// Unsigned comparison: rs >= rt
// Using subtraction and checking for borrow
var diff[32:0];
var no_borrow[0:0];
var trap_cond[0:0];

diff = {1'b0, rs_val} - {1'b0, rt_val};
no_borrow = ~diff[32];  // No borrow means rs >= rt
trap_cond = no_borrow;

// Exception handling
var exc_code[4:0];
exc_code = 13;  // Trap exception

var status_exl[0:0];
var not_status_exl[0:0];
var status_bev[0:0];
var exc_vector[31:0];

status_exl = cp0_status[1];
not_status_exl = ~status_exl;
status_bev = cp0_status[22];
exc_vector = status_bev ? 32'hBFC00380 : 32'h80000180;

// Save PC to EPC (only if not already in exception)
cp0_epc when (trap_cond & not_status_exl) = pc;

// Set Cause.ExcCode
var new_cause[31:0];
new_cause = {cp0_cause[31:7], exc_code, cp0_cause[1:0]};
cp0_cause when (trap_cond) = new_cause;

// Set Status.EXL
var new_status[31:0];
new_status = cp0_status | 32'h2;
cp0_status when (trap_cond) = new_status;

// Update PC
var next_pc[31:0];
next_pc = trap_cond ? exc_vector : (pc + 4);
pc = next_pc;
