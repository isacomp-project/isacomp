// SPDX-License-Identifier: BSD-3-Clause
// MIPS32 ERET - Exception Return
// Returns from exception/interrupt by:
// - If ERL=1: PC = ErrorEPC, ERL = 0
// - If ERL=0: PC = EPC, EXL = 0
// Also clears LLbit (invalidates LL/SC sequence)
// Encoding: 010000 1 0000000000000000000 011000
//           COP0   CO                    ERET

isa_state pc[31:0];
var instr[31:0];
isa_state rf[31:0][4:0];
mem umem[17:0];

#ifdef DELAY_SLOT
// Branch delay slot state
isa_state delay_slot[0:0];
isa_state branch_target[31:0];

// Include delay slot aspect - handles PC override if we're in a delay slot
aspect ../delay_slot.isa gates pc, delay_slot;
#endif

// Include TLB aspect for PC translation and CP0 state
#ifdef MMU
aspect ../tlb.isa gates pc, cp0_status, cp0_cause, cp0_epc, cp0_badvaddr, cp0_entryhi, cp0_context;
instr = umem[pc_pa];
#else
instr = umem[pc];
#endif

// ERET encoding
assume instr[31:26] == 6'b010000;  // COP0 opcode
assume instr[25] == 1'b1;          // CO bit
assume instr[5:0] == 6'b011000;    // ERET function

// Get current Status register values
var status_exl[0:0];
var status_erl[0:0];

status_exl = cp0_status[1];
status_erl = cp0_status[2];

// Determine return address and status update
var return_pc[31:0];
var new_status[31:0];

// If ERL=1: return to ErrorEPC, clear ERL
// If ERL=0: return to EPC, clear EXL
return_pc = status_erl ? cp0_errorepc : cp0_epc;

// Build new status:
// If ERL=1: clear bit 2 (ERL)
// If ERL=0: clear bit 1 (EXL)
var clear_erl[31:0];
var clear_exl[31:0];
clear_erl = cp0_status & 32'hFFFFFFFB;  // Clear bit 2
clear_exl = cp0_status & 32'hFFFFFFFD;  // Clear bit 1

new_status = status_erl ? clear_erl : clear_exl;

// Update Status register
cp0_status = new_status;

// Clear LLbit (invalidates any pending LL/SC)
llbit = 1'b0;

// Jump to return address
pc = return_pc;
