// SPDX-License-Identifier: BSD-3-Clause
// MIPS32 WAIT - Wait for Interrupt (NOP stub)
// Enters low power mode until interrupt - treated as NOP for simulation
// Encoding: 010000 1 0000000000000000000 100000
//           COP0   CO                    WAIT

isa_state pc[31:0];
var instr[31:0];
isa_state rf[31:0][4:0];
mem umem[17:0];

#ifdef DELAY_SLOT
// Branch delay slot state
isa_state delay_slot[0:0];
isa_state branch_target[31:0];

// Include delay slot aspect - handles PC override if we're in a delay slot
aspect ../delay_slot.isa gates pc, delay_slot;
#endif

// Include TLB aspect for PC translation and CP0 state
#ifdef MMU
aspect ../tlb.isa gates pc, cp0_status, cp0_cause, cp0_epc, cp0_badvaddr, cp0_entryhi, cp0_context;
instr = umem[pc_pa];
#else
instr = umem[pc];
#endif

// WAIT encoding
assume instr[31:26] == 6'b010000;  // COP0 opcode
assume instr[25] == 1'b1;          // CO bit
assume instr[5:0] == 6'b100000;    // WAIT function

// This is a NOP for simulation - just advance PC
// In real hardware, this would halt until an interrupt
pc = pc + 4;
