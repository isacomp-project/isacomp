// SPDX-License-Identifier: BSD-3-Clause
// MIPS32 MUL - Multiply Word to GPR
// rd = rs * rt (low 32 bits of product)
// Encoding: 011100 rs rt rd 00000 000010
//           SPECIAL2          MUL

isa_state pc[31:0];
var instr[31:0];
isa_state rf[31:0][4:0];
mem umem[17:0];

var rs[4:0];
var rt[4:0];
var rd[4:0];
var r1[31:0];
var r2[31:0];

#ifdef DELAY_SLOT
// Branch delay slot state
isa_state delay_slot[0:0];
isa_state branch_target[31:0];

// Include delay slot aspect - handles PC override if we're in a delay slot
aspect delay_slot.isa gates pc, delay_slot;
#endif

// Include TLB aspect for PC translation and CP0 state
#ifdef MMU
aspect tlb.isa gates pc, cp0_status, cp0_cause, cp0_epc, cp0_badvaddr, cp0_entryhi, cp0_context;
instr = umem[pc_pa];
#else
instr = umem[pc];
#endif

// MUL encoding
assume instr[31:26] == 6'b011100;  // SPECIAL2 opcode
assume instr[5:0] == 6'b000010;    // MUL function
assume instr[10:6] == 5'b00000;    // sa = 0

rs = instr[25:21];
rt = instr[20:16];
rd = instr[15:11];

r1 = rf[rs];
r2 = rf[rt];

// Signed multiplication - only need low 32 bits
// Sign doesn't matter for low 32 bits, so use unsigned multiply
// Split into 16-bit halves and zero-extend to 32 bits for multiplication
var a0[31:0]; var a1[31:0];
var b0[31:0]; var b1[31:0];
var p00[31:0]; var p01[31:0]; var p10[31:0];

a0 = {16'b0, r1[15:0]};
a1 = {16'b0, r1[31:16]};
b0 = {16'b0, r2[15:0]};
b1 = {16'b0, r2[31:16]};

// Partial products (only ones that contribute to low 32 bits)
p00 = a0 * b0;           // bits [31:0]
p01 = a0 * b1;           // bits [47:16], contributes [31:16]
p10 = a1 * b0;           // bits [47:16], contributes [31:16]

// Compute low 32 bits: p00 + (p01[15:0] << 16) + (p10[15:0] << 16)
var mid_sum[16:0];
var result[31:0];

mid_sum = {1'b0, p01[15:0]} + {1'b0, p10[15:0]};
result = p00 + {mid_sum[15:0], 16'b0};

// Write result to rd
rf[rd] when (rd != 0) = result;

pc = pc + 4;
