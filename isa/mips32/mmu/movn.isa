// SPDX-License-Identifier: BSD-3-Clause
// MIPS32 MOVN - Move Conditional on Not Zero
// if rt != 0 then rd = rs
// Encoding: 000000 rs rt rd 00000 001011
//           SPECIAL              MOVN

isa_state pc[31:0];
var instr[31:0];
isa_state rf[31:0][4:0];
mem umem[17:0];

var rs[4:0];
var rt[4:0];
var rd[4:0];
var rs_val[31:0];
var rt_val[31:0];
var rd_val[31:0];
var condition[0:0];
var result[31:0];

#ifdef DELAY_SLOT
// Branch delay slot state
isa_state delay_slot[0:0];
isa_state branch_target[31:0];

// Include delay slot aspect - handles PC override if we're in a delay slot
aspect delay_slot.isa gates pc, delay_slot;
#endif

// Include TLB aspect for PC translation
// Include TLB aspect for PC translation and CP0 state
#ifdef MMU
aspect tlb.isa gates pc, cp0_status, cp0_cause, cp0_epc, cp0_badvaddr, cp0_entryhi, cp0_context;
instr = umem[pc_pa];
#else
instr = umem[pc];
#endif

// MOVN encoding
assume instr[31:26] == 6'b000000;  // SPECIAL opcode
assume instr[5:0] == 6'b001011;    // MOVN function
assume instr[10:6] == 5'b00000;    // sa = 0

rs = instr[25:21];
rt = instr[20:16];
rd = instr[15:11];

rs_val = rf[rs];
rt_val = rf[rt];
rd_val = rf[rd];

// Condition: rt != 0
condition = (rt_val != 0x00000000);

// Result: rs if condition true, else keep rd
result = condition ? rs_val : rd_val;

rf[rd] = result;

pc = pc + 4;
