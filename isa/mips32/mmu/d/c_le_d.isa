// SPDX-License-Identifier: BSD-3-Clause
// MIPS32 C.LE.D - Compare double-precision less than or equal (with MMU support)
// Encoding: COP1 (010001), fmt=D (10001), ft, fs, cc, 0, 11, FC=LE (1110)
// C.LE.D fs, ft: FCSR[cc] = (fs <= ft)

isa_state pc[31:0];
var instr[31:0];
isa_state rf[31:0][4:0];
isa_state frf[63:0][4:0];
isa_state fcsr[31:0];
mem umem[17:0];

var fs[4:0];
var ft[4:0];
var cc[2:0];
var f1[63:0];
var f2[63:0];
var cmp_result[0:0];

#ifdef DELAY_SLOT
// Branch delay slot state
isa_state delay_slot[0:0];
isa_state branch_target[31:0];

// Include delay slot aspect - handles PC override if we're in a delay slot
aspect ../delay_slot.isa gates pc, delay_slot;
#endif

#ifdef MMU
aspect ../tlb.isa gates pc, cp0_status, cp0_cause, cp0_epc, cp0_badvaddr, cp0_entryhi, cp0_context;
instr = umem[pc_pa];
#else
instr = umem[pc];
#endif

assume instr[31:26] == 6'b010001;
assume instr[25:21] == 5'b10001;
assume instr[5:4] == 2'b11;
assume instr[3:0] == 4'b1110;

pc = pc + 4;

fs = instr[15:11];
ft = instr[20:16];
cc = instr[10:8];

f1 = frf[fs];
f2 = frf[ft];

cmp_result = fp_le_d(f1, f2);

fcsr[23] when (cc == 0) = cmp_result;
