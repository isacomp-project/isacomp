// SPDX-License-Identifier: BSD-3-Clause
// MIPS32 FLOOR.W.D - Floor double-precision to word (with MMU support)
// Encoding: COP1 (010001), fmt=D (10001), 00000, fs, fd, FLOOR.W (001111)
// FLOOR.W.D fd, fs: fd = floor(fs)

isa_state pc[31:0];
var instr[31:0];
isa_state rf[31:0][4:0];
isa_state frf[63:0][4:0];
mem umem[17:0];

var fs[4:0];
var fd[4:0];
var f1[63:0];
var result[31:0];
var rm[2:0];

#ifdef DELAY_SLOT
// Branch delay slot state
isa_state delay_slot[0:0];
isa_state branch_target[31:0];

// Include delay slot aspect - handles PC override if we're in a delay slot
aspect ../delay_slot.isa gates pc, delay_slot;
#endif

#ifdef MMU
aspect ../tlb.isa gates pc, cp0_status, cp0_cause, cp0_epc, cp0_badvaddr, cp0_entryhi, cp0_context;
instr = umem[pc_pa];
#else
instr = umem[pc];
#endif

assume instr[31:26] == 6'b010001;
assume instr[25:21] == 5'b10001;
assume instr[5:0] == 6'b001111;

pc = pc + 4;

fd = instr[10:6];
fs = instr[15:11];

f1 = frf[fs];

rm = 3'b011;

result = fp_cvt_w_d(f1, rm);

frf[fd] = {0, result};
