// SPDX-License-Identifier: BSD-3-Clause
// MIPS32 LDC1 - Load Doubleword to FP Coprocessor 1 (with MMU support)
// Encoding: LDC1 (110101), base, ft, offset
// LDC1 ft, offset(base): ft = mem[base + offset] (64-bit load)

isa_state pc[31:0];
var instr[31:0];
isa_state rf[31:0][4:0];
isa_state frf[63:0][4:0];
mem umem[17:0];

var base_reg[4:0];
var ft[4:0];
var offset[15:0];
var base_val[31:0];
var sign_ext_offset[31:0];
var addr[31:0];
var addr_hi[31:0];
var data_lo[31:0];
var data_hi[31:0];
var data[63:0];

#ifdef DELAY_SLOT
// Branch delay slot state
isa_state delay_slot[0:0];
isa_state branch_target[31:0];

// Include delay slot aspect - handles PC override if we're in a delay slot
aspect ../delay_slot.isa gates pc, delay_slot;
#endif

#ifdef MMU
aspect ../tlb.isa gates pc, cp0_status, cp0_cause, cp0_epc, cp0_badvaddr, cp0_entryhi, cp0_context;
instr = umem[pc_pa];
#else
instr = umem[pc];
#endif

assume instr[31:26] == 6'b110101;

pc = pc + 4;

base_reg = instr[25:21];
ft = instr[20:16];
offset = instr[15:0];

base_val = rf[base_reg];
sign_ext_offset = {{16{offset[15]}}, offset};
addr = base_val + sign_ext_offset;
addr_hi = addr + 4;

#ifdef MMU
aspect ../tlb_load.isa gates pc, cp0_status, cp0_cause, cp0_epc, cp0_badvaddr, cp0_entryhi, cp0_context;
data_lo = umem[addr_pa];
data_hi = umem[addr_pa + 4];
#else
data_lo = umem[addr];
data_hi = umem[addr + 4];
#endif

data = {data_hi, data_lo};

frf[ft] = data;
