// SPDX-License-Identifier: BSD-3-Clause
// MIPS32r2 ROTRV - Rotate Word Right Variable
// rd = rt rotated right by rs[4:0] bits
// Encoding: 000000 rs rt rd 00001 000110
//           SPECIAL           R=1  SRLV (with R=1 becomes ROTRV)

isa_state pc[31:0];
var instr[31:0];
isa_state rf[31:0][4:0];
mem umem[17:0];

var rs[4:0];
var rt[4:0];
var rd[4:0];
var rs_val[31:0];
var rt_val[31:0];
var sa[4:0];
var result[31:0];
var right_part[31:0];
var left_part[31:0];

#ifdef DELAY_SLOT
// Branch delay slot state
isa_state delay_slot[0:0];
isa_state branch_target[31:0];

// Include delay slot aspect - handles PC override if we're in a delay slot
aspect delay_slot.isa gates pc, delay_slot;
#endif

// Include TLB aspect for PC translation
// Include TLB aspect for PC translation and CP0 state
#ifdef MMU
aspect tlb.isa gates pc, cp0_status, cp0_cause, cp0_epc, cp0_badvaddr, cp0_entryhi, cp0_context;
instr = umem[pc_pa];
#else
instr = umem[pc];
#endif

// ROTRV encoding (SRLV with R=1)
assume instr[31:26] == 6'b000000;  // SPECIAL opcode
assume instr[10:6] == 5'b00001;    // R = 1 (distinguishes from SRLV)
assume instr[5:0] == 6'b000110;    // SRLV/ROTRV function

rs = instr[25:21];
rt = instr[20:16];
rd = instr[15:11];

rs_val = rf[rs];
rt_val = rf[rt];
sa = rs_val[4:0];

// Rotate right: (rt >> sa) | (rt << (32 - sa))
right_part = rt_val >> sa;
left_part = rt_val << (32 - {1'b0, sa});

// Handle sa = 0 case (no rotation)
result = (sa == 5'b00000) ? rt_val : (right_part | left_part);

rf[rd] = result;

pc = pc + 4;
