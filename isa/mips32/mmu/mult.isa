// SPDX-License-Identifier: BSD-3-Clause
// MIPS32 MULT - Multiply (signed)
// Multiplies rs by rt (signed), stores 64-bit result in HI:LO
// Encoding: 000000 rs rt 00000 00000 011000
//           SPECIAL rs rt 0     0     MULT

isa_state pc[31:0];
var instr[31:0];
isa_state rf[31:0][4:0];
isa_state hi[31:0];
isa_state lo[31:0];
mem umem[17:0];

var rs[4:0];
var rt[4:0];
var r1[31:0];
var r2[31:0];

#ifdef DELAY_SLOT
// Branch delay slot state
isa_state delay_slot[0:0];
isa_state branch_target[31:0];

// Include delay slot aspect - handles PC override if we're in a delay slot
aspect delay_slot.isa gates pc, delay_slot;
#endif

// Include TLB aspect for PC translation and HI/LO state
// Include TLB aspect for PC translation and CP0 state
#ifdef MMU
aspect tlb.isa gates pc, cp0_status, cp0_cause, cp0_epc, cp0_badvaddr, cp0_entryhi, cp0_context;
instr = umem[pc_pa];
#else
instr = umem[pc];
#endif

// MULT encoding
assume instr[31:26] == 6'b000000;
assume instr[5:0] == 6'b011000;
assume instr[15:6] == 10'b0000000000;

rs = instr[25:21];
rt = instr[20:16];

r1 = rf[rs];
r2 = rf[rt];

// Signed multiplication
// Sign-extend to 64 bits and multiply
var r1_sign[0:0];
var r2_sign[0:0];
var r1_abs[31:0];
var r2_abs[31:0];
var result_sign[0:0];

r1_sign = r1[31];
r2_sign = r2[31];
r1_abs = r1_sign ? (~r1 + 1) : r1;
r2_abs = r2_sign ? (~r2 + 1) : r2;
result_sign = r1_sign ^ r2_sign;

// 32x32 unsigned multiply to get 64-bit result
// Split into 16-bit halves, zero-extend to 32 bits for proper multiplication
var a0[31:0]; var a1[31:0];  // r1_abs = a1:a0
var b0[31:0]; var b1[31:0];  // r2_abs = b1:b0
var p00[31:0]; var p01[31:0]; var p10[31:0]; var p11[31:0];

a0 = {16'b0, r1_abs[15:0]};
a1 = {16'b0, r1_abs[31:16]};
b0 = {16'b0, r2_abs[15:0]};
b1 = {16'b0, r2_abs[31:16]};

// Partial products
p00 = a0 * b0;           // bits [31:0] of result
p01 = a0 * b1;           // bits [47:16]
p10 = a1 * b0;           // bits [47:16]
p11 = a1 * b1;           // bits [63:32]

// Sum partial products
var sum_mid[32:0];       // p01 + p10 (with carry)
var result_lo[31:0];
var result_hi[31:0];
var carry_to_hi[0:0];

sum_mid = p01 + p10;

// Low 32 bits: p00[31:0] + (sum_mid[15:0] << 16)
var lo_sum[32:0];
lo_sum = p00 + {sum_mid[15:0], 16'b0};
result_lo = lo_sum[31:0];
carry_to_hi = lo_sum[32];

// High 32 bits: p11 + sum_mid[32:16] + carry
result_hi = p11 + {1'b0, sum_mid[32:16]} + {1'b0, carry_to_hi};

// Apply sign to result (negate if result_sign is 1)
var final_lo[31:0];
var final_hi[31:0];
var neg_lo[31:0];
var neg_hi[31:0];
var borrow[0:0];

neg_lo = ~result_lo + 1;
borrow = (result_lo != 0) ? 1'b0 : 1'b1;  // Borrow if lo was 0
neg_hi = ~result_hi + {1'b0, borrow};

final_lo = result_sign ? neg_lo : result_lo;
final_hi = result_sign ? neg_hi : result_hi;

// Write to HI and LO
hi = final_hi;
lo = final_lo;

// Update PC
pc = pc + 4;
