// SPDX-License-Identifier: BSD-3-Clause
// MIPS32 CFC1 - Move control word from FP coprocessor 1 (with MMU support)
// Encoding: COP1 (010001), CF (00010), rt, fs, 00000000000
// CFC1 rt, fs: rt = FCR[fs] (move FP control register to GPR)

isa_state pc[31:0];
var instr[31:0];
isa_state rf[31:0][4:0];
isa_state fcsr[31:0];
mem umem[17:0];

var rt[4:0];
var fs[4:0];
var data[31:0];

#ifdef DELAY_SLOT
// Branch delay slot state
isa_state delay_slot[0:0];
isa_state branch_target[31:0];

// Include delay slot aspect - handles PC override if we're in a delay slot
aspect ../delay_slot.isa gates pc, delay_slot;
#endif

#ifdef MMU
aspect ../tlb.isa gates pc, cp0_status, cp0_cause, cp0_epc, cp0_badvaddr, cp0_entryhi, cp0_context;
instr = umem[pc_pa];
#else
instr = umem[pc];
#endif

assume instr[31:26] == 6'b010001;
assume instr[25:21] == 5'b00010;
assume instr[10:0] == 0;

pc = pc + 4;

rt = instr[20:16];
fs = instr[15:11];

// Only FCSR (register 31) is typically readable
data = (fs == 31) ? fcsr : 0;

rf[rt] when (rt != 0) = data;
