// SPDX-License-Identifier: BSD-3-Clause
// MIPS32 MOV.S - Single-precision floating-point move (with MMU support)
// Encoding: COP1 (010001), fmt=S (10000), 00000, fs, fd, func=MOV (000110)
// MOV.S fd, fs: fd = fs

isa_state pc[31:0];
var instr[31:0];
isa_state rf[31:0][4:0];
isa_state frf[31:0][4:0];
mem umem[17:0];

var fs[4:0];
var fd[4:0];
var f1[31:0];

#ifdef DELAY_SLOT
// Branch delay slot state
isa_state delay_slot[0:0];
isa_state branch_target[31:0];

// Include delay slot aspect - handles PC override if we're in a delay slot
aspect ../delay_slot.isa gates pc, delay_slot;
#endif

#ifdef MMU
aspect ../tlb.isa gates pc, cp0_status, cp0_cause, cp0_epc, cp0_badvaddr, cp0_entryhi, cp0_context;
instr = umem[pc_pa];
#else
instr = umem[pc];
#endif

assume instr[31:26] == 6'b010001;
assume instr[25:21] == 5'b10000;
assume instr[5:0] == 6'b000110;

pc = pc + 4;

fd = instr[10:6];
fs = instr[15:11];

f1 = frf[fs];

frf[fd] = f1;
