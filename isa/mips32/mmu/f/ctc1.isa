// SPDX-License-Identifier: BSD-3-Clause
// MIPS32 CTC1 - Move control word to FP coprocessor 1 (with MMU support)
// Encoding: COP1 (010001), CT (00110), rt, fs, 00000000000
// CTC1 rt, fs: FCR[fs] = rt (move GPR to FP control register)

isa_state pc[31:0];
var instr[31:0];
isa_state rf[31:0][4:0];
isa_state fcsr[31:0];
mem umem[17:0];

var rt[4:0];
var fs[4:0];
var data[31:0];

#ifdef DELAY_SLOT
// Branch delay slot state
isa_state delay_slot[0:0];
isa_state branch_target[31:0];

// Include delay slot aspect - handles PC override if we're in a delay slot
aspect ../delay_slot.isa gates pc, delay_slot;
#endif

// Include TLB aspect for PC translation and CP0 state
#ifdef MMU
aspect ../tlb.isa gates pc, cp0_status, cp0_cause, cp0_epc, cp0_badvaddr, cp0_entryhi, cp0_context;
instr = umem[pc_pa];
#else
instr = umem[pc];
#endif

assume instr[31:26] == 6'b010001;
assume instr[25:21] == 5'b00110;
assume instr[10:0] == 0;

pc = pc + 4;

rt = instr[20:16];
fs = instr[15:11];

data = rf[rt];

// Only FCSR (register 31) is typically writable
fcsr when (fs == 31) = data;
