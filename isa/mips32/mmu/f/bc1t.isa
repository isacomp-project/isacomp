// SPDX-License-Identifier: BSD-3-Clause
// MIPS32 BC1T - Branch on FP condition true (with MMU support)
// Encoding: COP1 (010001), BC (01000), cc, nd, tf=1, offset
// BC1T offset: if FCSR[cc] then PC = PC + 4 + offset*4

isa_state pc[31:0];
var instr[31:0];
isa_state rf[31:0][4:0];
isa_state fcsr[31:0];
mem umem[17:0];

var cc[2:0];
var offset[15:0];
var sign_ext_offset[31:0];
var branch_dest[31:0];
var condition[0:0];

#ifdef DELAY_SLOT
// Branch delay slot state
isa_state delay_slot[0:0];
isa_state branch_target[31:0];

// Include delay slot aspect - handles PC override if we're in a delay slot
aspect ../delay_slot.isa gates pc, delay_slot;
#endif

#ifdef MMU
aspect ../tlb.isa gates pc, cp0_status, cp0_cause, cp0_epc, cp0_badvaddr, cp0_entryhi, cp0_context;
instr = umem[pc_pa];
#else
instr = umem[pc];
#endif

assume instr[31:26] == 6'b010001;
assume instr[25:21] == 5'b01000;
assume instr[16] == 1'b1;

cc = instr[20:18];
offset = instr[15:0];

sign_ext_offset = {{14{offset[15]}}, offset, 2'b00};
branch_dest = pc + 4 + sign_ext_offset;

// Get condition code (cc=0 uses bit 23)
condition = (cc == 0) ? fcsr[23] : 1'b0;

#ifdef DELAY_SLOT
// Set up delay slot if branch taken (and not already in a delay slot)
delay_slot when (condition && !in_delay_slot) = 1;
branch_target when (condition && !in_delay_slot) = branch_dest;
// Always advance to delay slot instruction
pc = pc + 4;
#else
pc = condition ? branch_dest : (pc + 4);
#endif
