// SPDX-License-Identifier: BSD-3-Clause
// MIPS32 C.UN.S - Compare single-precision unordered (with MMU support)
// Encoding: COP1 (010001), fmt=S (10000), ft, fs, cc, 0, 11, FC=UN (0001)
// C.UN.S fs, ft: FCSR[cc] = isnan(fs) || isnan(ft)

isa_state pc[31:0];
var instr[31:0];
isa_state rf[31:0][4:0];
isa_state frf[31:0][4:0];
isa_state fcsr[31:0];
mem umem[17:0];

var fs[4:0];
var ft[4:0];
var cc[2:0];
var f1[31:0];
var f2[31:0];
var exp1[7:0];
var exp2[7:0];
var frac1[22:0];
var frac2[22:0];
var is_nan1[0:0];
var is_nan2[0:0];
var cmp_result[0:0];

#ifdef DELAY_SLOT
// Branch delay slot state
isa_state delay_slot[0:0];
isa_state branch_target[31:0];

// Include delay slot aspect - handles PC override if we're in a delay slot
aspect ../delay_slot.isa gates pc, delay_slot;
#endif

#ifdef MMU
aspect ../tlb.isa gates pc, cp0_status, cp0_cause, cp0_epc, cp0_badvaddr, cp0_entryhi, cp0_context;
instr = umem[pc_pa];
#else
instr = umem[pc];
#endif

assume instr[31:26] == 6'b010001;
assume instr[25:21] == 5'b10000;
assume instr[5:4] == 2'b11;
assume instr[3:0] == 4'b0001;

pc = pc + 4;

fs = instr[15:11];
ft = instr[20:16];
cc = instr[10:8];

f1 = frf[fs];
f2 = frf[ft];

exp1 = f1[30:23];
frac1 = f1[22:0];
exp2 = f2[30:23];
frac2 = f2[22:0];

is_nan1 = (exp1 == 8'hFF) && (frac1 != 0);
is_nan2 = (exp2 == 8'hFF) && (frac2 != 0);

cmp_result = is_nan1 || is_nan2;

fcsr[23] when (cc == 0) = cmp_result;
