// SPDX-License-Identifier: BSD-3-Clause
// MIPS32 MOVZ.S - Move Single if GPR Zero (with MMU support)
// Encoding: COP1 (010001), fmt=S (10000), rt, fs, fd, MOVZ (010010)

isa_state pc[31:0];
var instr[31:0];
isa_state rf[31:0][4:0];
isa_state frf[31:0][4:0];
mem umem[17:0];

var fs[4:0];
var fd[4:0];
var rt[4:0];
var f1[31:0];
var fd_val[31:0];
var rt_val[31:0];
var condition[0:0];
var result[31:0];

#ifdef DELAY_SLOT
// Branch delay slot state
isa_state delay_slot[0:0];
isa_state branch_target[31:0];

// Include delay slot aspect - handles PC override if we're in a delay slot
aspect ../delay_slot.isa gates pc, delay_slot;
#endif

#ifdef MMU
aspect ../tlb.isa gates pc, cp0_status, cp0_cause, cp0_epc, cp0_badvaddr, cp0_entryhi, cp0_context;
instr = umem[pc_pa];
#else
instr = umem[pc];
#endif

assume instr[31:26] == 6'b010001;
assume instr[25:21] == 5'b10000;
assume instr[5:0] == 6'b010010;

pc = pc + 4;

fd = instr[10:6];
fs = instr[15:11];
rt = instr[20:16];

f1 = frf[fs];
fd_val = frf[fd];
rt_val = rf[rt];

condition = (rt_val == 00000000);

result = condition ? f1 : fd_val;

frf[fd] = result;
