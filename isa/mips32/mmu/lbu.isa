// SPDX-License-Identifier: BSD-3-Clause
// MIPS32 LBU - Load Byte Unsigned (with MMU support)
// Uses 8-bit direct access, memory transform handles byte selection

isa_state pc[31:0];
var instr[31:0];
isa_state rf[31:0][4:0];
mem umem[17:0];

var rs[4:0];
var rt[4:0];
var imm[15:0];
var sign_ext_imm[31:0];
var addr[31:0];
var base[31:0];
var byte_data[7:0];

#ifdef DELAY_SLOT
// Branch delay slot state
isa_state delay_slot[0:0];
isa_state branch_target[31:0];

// Include delay slot aspect - handles PC override if we're in a delay slot
aspect delay_slot.isa gates pc, delay_slot;
#endif

// Include TLB aspect for PC translation and CP0 state
#ifdef MMU
aspect tlb.isa gates pc, cp0_status, cp0_cause, cp0_epc, cp0_badvaddr, cp0_entryhi, cp0_context;
instr = umem[pc_pa];
#else
instr = umem[pc];
#endif

assume instr[31:26] == 6'b100100;

rs = instr[25:21];
rt = instr[20:16];
imm = instr[15:0];

base = rf[rs];
sign_ext_imm = {{16{imm[15]}}, imm};
addr = base + sign_ext_imm;

byte_data = umem[addr];

// Zero-extend byte to 32 bits
rf[rt] when (rt != 0) = {1'b0, byte_data};
pc = pc + 4;
