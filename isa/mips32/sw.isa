// SPDX-License-Identifier: BSD-3-Clause
isa_state pc[31:0];
var instr[31:0];
isa_state rf[31:0][4:0];
mem umem[12:0];

#ifdef DELAY_SLOT
// Branch delay slot state
isa_state delay_slot[0:0];
isa_state branch_target[31:0];

// Include delay slot aspect - handles PC override if we're in a delay slot
aspect delay_slot.isa gates pc, delay_slot;
#endif

var rs[4:0];
var rt[4:0];
var imm[15:0];
var sw_sign_ext_imm[31:0];
var sw_addr[31:0];
var sw_base[31:0];
var sw_data[31:0];

instr = umem[pc];
assume instr[31:26] == 0x2b;
pc = pc + 4;
rs = instr[25:21];
rt = instr[20:16];
imm = instr[15:0];

sw_base = rf[rs];
sw_sign_ext_imm = {{16{imm[15]}}, imm};
sw_addr = sw_base + sw_sign_ext_imm;

sw_data = rf[rt];
umem[sw_addr] = sw_data;
