// SPDX-License-Identifier: BSD-3-Clause
isa_state pc[31:0];
var instr[31:0];
isa_state rf[31:0][4:0];
mem umem[12:0];

#ifdef DELAY_SLOT
// Branch delay slot state
isa_state delay_slot[0:0];
isa_state branch_target[31:0];

// Include delay slot aspect - handles PC override if we're in a delay slot
aspect delay_slot.isa gates pc, delay_slot;
#endif

var rs[4:0];
var rd[4:0];
var r1[31:0];
var pc_plus_8[31:0];
var jump_dest[31:0];

instr = umem[pc];
assume instr[31:26] == 0;
assume instr[5:0] == 0x09;
rs = instr[25:21];
rd = instr[15:11];

r1 = rf[rs];

// Return address is PC+8 (accounting for branch delay slot)
pc_plus_8 = pc + 8;
jump_dest = r1;

rf[rd] when (rd != 0) = pc_plus_8;
#ifdef DELAY_SLOT
// Set up delay slot for next instruction
delay_slot when (!in_delay_slot) = 1;
branch_target when (!in_delay_slot) = jump_dest;
// Advance to delay slot instruction
pc = pc + 4;
#else
pc = jump_dest;
#endif
