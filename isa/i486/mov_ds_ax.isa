// SPDX-License-Identifier: BSD-3-Clause
// i486 MOV DS, AX (0x8E /r)
// Move AX to DS segment register

isa_state eip[31:0];
var instr[7:0];
isa_state imem[7:0][31:0];
isa_state dmem[7:0][31:0];
isa_state DS[15:0];            // Data segment register
isa_state xregs[31:0][2:0];    // General purpose registers (xregs[0] is AX)

var modrm[7:0];
var mod_bits[1:0];
var reg_bits[2:0];
var rm_bits[2:0];

instr = imem[eip];
assume instr == 0x8E;
eip = eip + 1;

// Fetch ModR/M byte
modrm = imem[eip];
eip = eip + 1;

// Decode ModR/M
mod_bits = modrm[7:6];
reg_bits = modrm[5:3];
rm_bits = modrm[2:0];

// Assume register mode (mod=11), DS (reg=011), AX (rm=000)
assume mod_bits == 0b11;
assume reg_bits == 0b011;  // DS
assume rm_bits == 0b000;   // AX

// Copy AX to DS
DS = xregs[0][15:0];
