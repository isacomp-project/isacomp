// SPDX-License-Identifier: BSD-3-Clause
// i486 SUB EAX, imm32 with 66 prefix (0x66 0x2D)

isa_state eip[31:0];
var prefix[7:0];
var instr[7:0];
isa_state xregs[31:0][2:0];
isa_state imem[7:0][31:0];
isa_state flag_CF[0:0];
isa_state flag_OF[0:0];
isa_state flag_SF[0:0];
isa_state flag_ZF[0:0];
isa_state flag_AF[0:0];
isa_state flag_PF[0:0];

var imm_b0[7:0];
var imm_b1[7:0];
var imm_b2[7:0];
var imm_b3[7:0];
var imm_val[31:0];
var src_val[31:0];
var result[32:0];

prefix = imem[eip];
assume prefix == 0x66;

instr = imem[eip + 1];
assume instr == 0x2D;

imm_b0 = imem[eip + 2];
imm_b1 = imem[eip + 3];
imm_b2 = imem[eip + 4];
imm_b3 = imem[eip + 5];

eip = eip + 6;

imm_val = {imm_b3, imm_b2, imm_b1, imm_b0};
src_val = xregs[0];

result = {1'b0, src_val} - {1'b0, imm_val};

xregs[0] = result[31:0];

flag_CF = result[32];
flag_OF = (src_val[31] != imm_val[31]) & (src_val[31] != result[31]);
flag_SF = result[31];
flag_ZF = result[31:0] == 32'h00000000;
flag_AF = src_val[3:0] < imm_val[3:0];
flag_PF = ~(result[0] ^ result[1] ^ result[2] ^ result[3] ^ result[4] ^ result[5] ^ result[6] ^ result[7]);
