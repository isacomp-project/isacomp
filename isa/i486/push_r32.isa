// i486 PUSH r32 (0x50-0x57) - Parameterized
// Opcodes: 0x50 (EAX), 0x51 (ECX), 0x52 (EDX), 0x53 (EBX),
//          0x54 (ESP), 0x55 (EBP), 0x56 (ESI), 0x57 (EDI)
// Push register onto stack

isa_state eip[31:0];
var instr[7:0];

// 32-bit register file: EAX(0), ECX(1), EDX(2), EBX(3), ESP(4), EBP(5), ESI(6), EDI(7)
isa_state xregs[31:0][2:0];

// Stack pointer alias
isa_state ESP[31:0] of xregs[4];

isa_state imem[7:0][31:0];
isa_state dmem[7:0][31:0];

var reg_idx[2:0];
var reg_val[31:0];
var new_esp[31:0];

// Fetch instruction
instr = imem[eip];

// Check this is a PUSH r32 instruction (0x50-0x57)
assume instr[7:3] == 0b01010;  // Upper 5 bits must be 01010

eip = eip + 1;

// Extract register index from lower 3 bits of opcode
reg_idx = instr[2:0];

// Read register value
reg_val = xregs[reg_idx];

// Decrement ESP by 4 (32-bit push)
new_esp = ESP - 4;
ESP = new_esp;

// Store value on stack (little-endian)
dmem[new_esp] = reg_val[7:0];
dmem[new_esp + 1] = reg_val[15:8];
dmem[new_esp + 2] = reg_val[23:16];
dmem[new_esp + 3] = reg_val[31:24];

// PUSH does not affect flags
