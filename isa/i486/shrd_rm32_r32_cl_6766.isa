// SPDX-License-Identifier: BSD-3-Clause
// i486 SHRD r/m32, r32, CL with 6766 prefix (0x67 0x66 0x0F 0xAD)
// 32-bit operands with 32-bit addressing mode

isa_state eip[31:0];
var prefix67[7:0];
var prefix[7:0];
var instr[7:0];
var instr2[7:0];
isa_state modrm[7:0];

isa_state xregs[31:0][2:0];

isa_state imem[7:0][31:0];
isa_state dmem[7:0][31:0];
isa_state flag_CF[0:0];
isa_state flag_SF[0:0];
isa_state flag_ZF[0:0];
isa_state flag_PF[0:0];

var mod_bits[1:0];
var reg_idx[2:0];
var rm_bits[2:0];
var dest_val[31:0];
var src_val[31:0];
var count[4:0];
var result[31:0];
var cf_bit[0:0];

prefix67 = imem[eip];
assume prefix67 == 0x67;

prefix = imem[eip + 1];
assume prefix == 0x66;

instr = imem[eip + 2];
assume instr == 0x0F;

instr2 = imem[eip + 3];
assume instr2 == 0xAD;

modrm = imem[eip + 4];

mod_bits = modrm[7:6];
reg_idx = modrm[5:3];
rm_bits = modrm[2:0];

assume mod_bits == 0b11;

eip = eip + 5;

dest_val = xregs[rm_bits];
src_val = xregs[reg_idx];

count = xregs[1][4:0];

// SHRD: result = (dest >> count) | (src << (32-count))
// Enumerate all 32 cases to avoid dynamic indexing issues
case (count) {
  5'd0: result = dest_val;
  5'd1: result = {src_val[0:0], dest_val[31:1]};
  5'd2: result = {src_val[1:0], dest_val[31:2]};
  5'd3: result = {src_val[2:0], dest_val[31:3]};
  5'd4: result = {src_val[3:0], dest_val[31:4]};
  5'd5: result = {src_val[4:0], dest_val[31:5]};
  5'd6: result = {src_val[5:0], dest_val[31:6]};
  5'd7: result = {src_val[6:0], dest_val[31:7]};
  5'd8: result = {src_val[7:0], dest_val[31:8]};
  5'd9: result = {src_val[8:0], dest_val[31:9]};
  5'd10: result = {src_val[9:0], dest_val[31:10]};
  5'd11: result = {src_val[10:0], dest_val[31:11]};
  5'd12: result = {src_val[11:0], dest_val[31:12]};
  5'd13: result = {src_val[12:0], dest_val[31:13]};
  5'd14: result = {src_val[13:0], dest_val[31:14]};
  5'd15: result = {src_val[14:0], dest_val[31:15]};
  5'd16: result = {src_val[15:0], dest_val[31:16]};
  5'd17: result = {src_val[16:0], dest_val[31:17]};
  5'd18: result = {src_val[17:0], dest_val[31:18]};
  5'd19: result = {src_val[18:0], dest_val[31:19]};
  5'd20: result = {src_val[19:0], dest_val[31:20]};
  5'd21: result = {src_val[20:0], dest_val[31:21]};
  5'd22: result = {src_val[21:0], dest_val[31:22]};
  5'd23: result = {src_val[22:0], dest_val[31:23]};
  5'd24: result = {src_val[23:0], dest_val[31:24]};
  5'd25: result = {src_val[24:0], dest_val[31:25]};
  5'd26: result = {src_val[25:0], dest_val[31:26]};
  5'd27: result = {src_val[26:0], dest_val[31:27]};
  5'd28: result = {src_val[27:0], dest_val[31:28]};
  5'd29: result = {src_val[28:0], dest_val[31:29]};
  5'd30: result = {src_val[29:0], dest_val[31:30]};
  5'd31: result = {src_val[30:0], dest_val[31:31]};
}

// CF = last bit shifted out = dest_val[count-1] for count > 0
case (count) {
  5'd0: cf_bit = flag_CF;
  5'd1: cf_bit = dest_val[0];
  5'd2: cf_bit = dest_val[1];
  5'd3: cf_bit = dest_val[2];
  5'd4: cf_bit = dest_val[3];
  5'd5: cf_bit = dest_val[4];
  5'd6: cf_bit = dest_val[5];
  5'd7: cf_bit = dest_val[6];
  5'd8: cf_bit = dest_val[7];
  5'd9: cf_bit = dest_val[8];
  5'd10: cf_bit = dest_val[9];
  5'd11: cf_bit = dest_val[10];
  5'd12: cf_bit = dest_val[11];
  5'd13: cf_bit = dest_val[12];
  5'd14: cf_bit = dest_val[13];
  5'd15: cf_bit = dest_val[14];
  5'd16: cf_bit = dest_val[15];
  5'd17: cf_bit = dest_val[16];
  5'd18: cf_bit = dest_val[17];
  5'd19: cf_bit = dest_val[18];
  5'd20: cf_bit = dest_val[19];
  5'd21: cf_bit = dest_val[20];
  5'd22: cf_bit = dest_val[21];
  5'd23: cf_bit = dest_val[22];
  5'd24: cf_bit = dest_val[23];
  5'd25: cf_bit = dest_val[24];
  5'd26: cf_bit = dest_val[25];
  5'd27: cf_bit = dest_val[26];
  5'd28: cf_bit = dest_val[27];
  5'd29: cf_bit = dest_val[28];
  5'd30: cf_bit = dest_val[29];
  5'd31: cf_bit = dest_val[30];
}

xregs[rm_bits] = result;

flag_CF = cf_bit;
flag_SF = result[31];
flag_ZF = result == 32'h00000000;
flag_PF = ~(result[0] ^ result[1] ^ result[2] ^ result[3] ^ result[4] ^ result[5] ^ result[6] ^ result[7]);
