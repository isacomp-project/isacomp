// i486 INVD (0x0F 0x08)
// Invalidate Cache (no write-back)
//
// On a system with cache:
//   - Invalidates (flushes) all internal cache entries
//   - Does NOT write back modified cache lines to memory
//   - Data in modified cache lines is lost
//   - Should also signal external caches to invalidate
//
// On a single-core design without cache: No-op
// This instruction is privileged (CPL must be 0)

isa_state eip[31:0];
var instr[7:0];
var instr2[7:0];
isa_state imem[7:0][31:0];

// Fetch first byte of opcode
instr = imem[eip];
assume instr == 0x0F;
eip = eip + 1;

// Fetch second byte of opcode
instr2 = imem[eip];
assume instr2 == 0x08;
eip = eip + 1;

// No-op: No cache to invalidate in this implementation
