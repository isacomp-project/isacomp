// SPDX-License-Identifier: BSD-3-Clause
// i486 OUT DX, AX (0xEF)
// Output word to port in DX

isa_state eip[31:0];
var instr[7:0];
isa_state imem[7:0][31:0];
isa_state xregs[31:0][2:0];
isa_state AX[15:0] of xregs[0][15:0];
isa_state DX[15:0] of xregs[2][15:0];
isa_state io_ports[7:0][7:0];

var port_num[7:0];

instr = imem[eip];
assume instr == 0xEF;
eip = eip + 1;

// Use DX as port number (only lower 8 bits for simplified model)
port_num = DX[7:0];

// Write word to I/O port (little-endian)
io_ports[port_num] = AX[7:0];
io_ports[port_num + 1] = AX[15:8];
