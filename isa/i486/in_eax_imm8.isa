// SPDX-License-Identifier: BSD-3-Clause
// i486 IN EAX, imm8 (0x66 0xE5)
// Input dword from port (with operand size override)
isa_state eip[31:0];
var prefix[7:0];
var instr[7:0];
isa_state imem[7:0][31:0];
isa_state xregs[31:0][2:0];
isa_state io_ports[7:0][31:0];

var imm8[7:0];

// Read operand size override prefix
prefix = imem[eip];
assume prefix == 0x66;

instr = imem[eip + 1];
assume instr == 0xE5;

// Read port number
imm8 = imem[eip + 2];

eip = eip + 3;

// Read dword from I/O port
xregs[0] = io_ports[imm8];
