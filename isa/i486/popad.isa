// SPDX-License-Identifier: BSD-3-Clause
// i486 POPAD (0x61)
// Pop all general-purpose registers from stack
// Order: EDI, ESI, EBP, skip ESP, EBX, EDX, ECX, EAX

isa_state eip[31:0];
var instr[7:0];

// 32-bit register file: EAX(0), ECX(1), EDX(2), EBX(3), ESP(4), EBP(5), ESI(6), EDI(7)
isa_state xregs[31:0][2:0];

// Stack pointer alias
isa_state ESP[31:0] of xregs[4];

isa_state imem[7:0][31:0];
isa_state dmem[7:0][31:0];

var addr[31:0];
var val_b0[7:0];
var val_b1[7:0];
var val_b2[7:0];
var val_b3[7:0];

// Fetch instruction
instr = imem[eip];
assume instr == 0x61;
eip = eip + 1;

// Current ESP points to bottom of saved registers
addr = ESP;

// Pop EDI (reg 7) from [ESP]
val_b0 = dmem[addr];
val_b1 = dmem[addr + 1];
val_b2 = dmem[addr + 2];
val_b3 = dmem[addr + 3];
xregs[7] = {val_b3, val_b2, val_b1, val_b0};

// Pop ESI (reg 6) from [ESP+4]
val_b0 = dmem[addr + 4];
val_b1 = dmem[addr + 5];
val_b2 = dmem[addr + 6];
val_b3 = dmem[addr + 7];
xregs[6] = {val_b3, val_b2, val_b1, val_b0};

// Pop EBP (reg 5) from [ESP+8]
val_b0 = dmem[addr + 8];
val_b1 = dmem[addr + 9];
val_b2 = dmem[addr + 10];
val_b3 = dmem[addr + 11];
xregs[5] = {val_b3, val_b2, val_b1, val_b0};

// Skip [ESP+12] - do not restore ESP from stack

// Pop EBX (reg 3) from [ESP+16]
val_b0 = dmem[addr + 16];
val_b1 = dmem[addr + 17];
val_b2 = dmem[addr + 18];
val_b3 = dmem[addr + 19];
xregs[3] = {val_b3, val_b2, val_b1, val_b0};

// Pop EDX (reg 2) from [ESP+20]
val_b0 = dmem[addr + 20];
val_b1 = dmem[addr + 21];
val_b2 = dmem[addr + 22];
val_b3 = dmem[addr + 23];
xregs[2] = {val_b3, val_b2, val_b1, val_b0};

// Pop ECX (reg 1) from [ESP+24]
val_b0 = dmem[addr + 24];
val_b1 = dmem[addr + 25];
val_b2 = dmem[addr + 26];
val_b3 = dmem[addr + 27];
xregs[1] = {val_b3, val_b2, val_b1, val_b0};

// Pop EAX (reg 0) from [ESP+28]
val_b0 = dmem[addr + 28];
val_b1 = dmem[addr + 29];
val_b2 = dmem[addr + 30];
val_b3 = dmem[addr + 31];
xregs[0] = {val_b3, val_b2, val_b1, val_b0};

// Adjust ESP (add 32 bytes)
ESP = addr + 32;

// POPAD does not affect flags
