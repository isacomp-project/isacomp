// SPDX-License-Identifier: BSD-3-Clause
// i486 JMP rel16 (0xE9) - Real mode (16-bit default)
// Near unconditional jump with 16-bit signed displacement

isa_state eip[31:0];
var instr[7:0];
isa_state imem[7:0][31:0];

var off_b0[7:0];
var off_b1[7:0];
var offset[15:0];
var signed_offset[31:0];
var next_ip[15:0];
var target_ip[15:0];

// Fetch instruction
instr = imem[eip];
assume instr == 0xE9;

// Read 16-bit displacement (little-endian) for real mode
off_b0 = imem[eip + 1];
off_b1 = imem[eip + 2];
offset = {off_b1, off_b0};

// Sign-extend 16-bit offset to 32 bits for calculation
signed_offset = {{16{offset[15]}}, offset};

// IP after fetching instruction (1-byte opcode + 2-byte displacement)
next_ip = eip[15:0] + 16'h0003;

// Calculate target address (next_ip + offset), with 16-bit wraparound
target_ip = next_ip + offset;

// Unconditional jump (only update lower 16 bits of EIP)
eip = {eip[31:16], target_ip};
