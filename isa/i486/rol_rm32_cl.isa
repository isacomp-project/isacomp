// SPDX-License-Identifier: BSD-3-Clause
// i486 ROL r/m32, CL (0xD3 /0 with mod=11)
// Rotate Left by CL bits

isa_state eip[31:0];
var instr[7:0];
isa_state modrm[7:0];

// 32-bit register file
isa_state xregs[31:0][2:0];
isa_state ECX[31:0] of xregs[1];
isa_state CL[7:0] of xregs[1][7:0];

isa_state imem[7:0][31:0];
isa_state dmem[7:0][31:0];
isa_state flag_CF[0:0];
isa_state flag_OF[0:0];

var mod_bits[1:0];
var reg_bits[2:0];
var rm_bits[2:0];
var dst_val[31:0];
var count[4:0];
var result[31:0];

// Fetch instruction and ModR/M using offset-based addressing
instr = imem[eip];
assume instr == 0xD3;
modrm = imem[eip + 1];

// Decode ModR/M
mod_bits = modrm[7:6];
reg_bits = modrm[5:3];
rm_bits = modrm[2:0];

// Verify this is ROL (reg_bits = 000)
assume reg_bits == 0b000;

// Register-direct mode
assume mod_bits == 0b11;

// Read destination value
dst_val = xregs[rm_bits];

// Get count from CL, masked to 5 bits for 32-bit operands
count = CL[4:0];

// Perform rotate left
// ROL: bits shifted out on left (MSB) wrap to right (LSB)
result = (dst_val << count) | (dst_val >> (32 - count));

// Write result
xregs[rm_bits] = result;

// Update flags if count != 0
// CF = LSB of result (the bit that was rotated from MSB)
flag_CF = count == 0 ? flag_CF : result[0];

// OF is defined only for count=1: XOR of CF and MSB
flag_OF = count == 1 ? (flag_CF ^ result[31]) : flag_OF;

// Update EIP after all processing
eip = eip + 2;
