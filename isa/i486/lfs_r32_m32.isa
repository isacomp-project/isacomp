// SPDX-License-Identifier: BSD-3-Clause
// i486 LFS r32, m32:16 (0x66 0x0F 0xB4)
// Load FS = [mem+4], reg = [mem]
isa_state eip[31:0];
var prefix[7:0];
var instr1[7:0];
var instr2[7:0];
isa_state modrm[7:0];
isa_state xregs[31:0][2:0];
isa_state imem[7:0][31:0];
isa_state dmem[7:0][31:0];
isa_state DS[15:0];
isa_state FS[15:0];

var mod_bits[1:0];
var reg_idx[2:0];
var rm_bits[2:0];
var addr_reg_idx[2:0];
var base_offset[15:0];
var phys_addr[19:0];
var offset_b0[7:0];
var offset_b1[7:0];
var offset_b2[7:0];
var offset_b3[7:0];
var seg_lo[7:0];
var seg_hi[7:0];

prefix = imem[eip];
assume prefix == 0x66;

instr1 = imem[eip + 1];
assume instr1 == 0x0F;

instr2 = imem[eip + 2];
assume instr2 == 0xB4;

modrm = imem[eip + 3];

mod_bits = modrm[7:6];
reg_idx = modrm[5:3];
rm_bits = modrm[2:0];

// Memory addressing only (mod != 11)
assume mod_bits == 0b00;

// Get address register
case (rm_bits) {
  0b100: addr_reg_idx = 3'b110;  // SI
  0b101: addr_reg_idx = 3'b111;  // DI
  0b111: addr_reg_idx = 3'b011;  // BX
}

base_offset = xregs[addr_reg_idx][15:0];
phys_addr = (DS << 4) + base_offset;

// Read offset (4 bytes)
offset_b0 = dmem[phys_addr];
offset_b1 = dmem[phys_addr + 1];
offset_b2 = dmem[phys_addr + 2];
offset_b3 = dmem[phys_addr + 3];

// Read segment (2 bytes)
seg_lo = dmem[phys_addr + 4];
seg_hi = dmem[phys_addr + 5];

// Store results
xregs[reg_idx] = {offset_b3, offset_b2, offset_b1, offset_b0};
FS = {seg_hi, seg_lo};

// Update EIP
eip = eip + 4;
