// SPDX-License-Identifier: BSD-3-Clause
// i486 JO rel8 (0x70) - Jump if Overflow
isa_state eip[31:0];
var instr[7:0];
isa_state imem[7:0][31:0];
isa_state flag_OF[0:0];

var rel8[7:0];
var offset[31:0];
var next_pc[31:0];
var jump_target[31:0];

instr = imem[eip];
assume instr == 0x70;

// Fetch rel8 and compute addresses (without modifying eip yet)
rel8 = imem[eip + 1];
next_pc = eip + 2;

// Sign-extend rel8 to 32 bits
offset = {{24{rel8[7]}}, rel8};

// Calculate jump target (relative to address after instruction)
jump_target = next_pc + offset;

// Conditional jump: OF=1 means take jump
case (flag_OF) {
  1'b1: eip = jump_target;
  1'b0: eip = next_pc;
}
