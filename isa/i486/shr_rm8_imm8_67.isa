// SPDX-License-Identifier: BSD-3-Clause
// i486 SHR r/m8, imm8 with 67 prefix (0x67 0xC0 /5) - 32-bit addressing mode
// Shift Right by immediate count with address-size prefix

isa_state lregs[7:0][1:0] of xregs[0b0**][7:0];
isa_state hregs[7:0][1:0] of xregs[0b0**][15:8];
isa_state xregs[31:0][2:0];
isa_state eip[31:0];
var prefix[7:0];
var instr[7:0];
isa_state modrm[7:0];
var mod_bits[1:0];
var reg_bits[2:0];
var rm_bits[2:0];
isa_state imem[7:0][31:0];
isa_state dmem[7:0][31:0];
isa_state DS[15:0];
isa_state flag_CF[0:0];
isa_state flag_OF[0:0];
isa_state flag_SF[0:0];
isa_state flag_ZF[0:0];
isa_state flag_PF[0:0];

var dst_reg_idx[2:0];
var base_val[31:0];
var disp8[7:0];
var disp32_b0[7:0];
var disp32_b1[7:0];
var disp32_b2[7:0];
var disp32_b3[7:0];
var disp32[31:0];
var signed_disp8[31:0];
var offset[31:0];
var physical_addr[31:0];
var dst_mem_val[7:0];
var dst_reg_val_low[7:0];
var dst_reg_val_high[7:0];
var dst_reg_val[7:0];
var dst_val[7:0];
var count[7:0];
var effective_count[4:0];
var result[7:0];
var is_mem_dst[0:0];

prefix = imem[eip];
assume prefix == 0x67;

instr = imem[eip + 1];
assume instr == 0xC0;

modrm = imem[eip + 2];

mod_bits = modrm[7:6];
reg_bits = modrm[5:3];
rm_bits = modrm[2:0];

assume reg_bits == 0b101;  // SHR

dst_reg_idx = rm_bits[1:0];

// For 32-bit addressing, rm selects base register
base_val = xregs[rm_bits];

disp8 = imem[eip + 3];
disp32_b0 = imem[eip + 3];
disp32_b1 = imem[eip + 4];
disp32_b2 = imem[eip + 5];
disp32_b3 = imem[eip + 6];
disp32 = {disp32_b3, disp32_b2, disp32_b1, disp32_b0};
signed_disp8 = {{24{disp8[7]}}, disp8};

case (mod_bits) {
  2'b00: offset = base_val;
  2'b01: offset = base_val + signed_disp8;
  2'b10: offset = base_val + disp32;
  2'b11: offset = 32'h00000000;
}

case (mod_bits) {
  2'b00: is_mem_dst = 1'b1;
  2'b01: is_mem_dst = 1'b1;
  2'b10: is_mem_dst = 1'b1;
  2'b11: is_mem_dst = 1'b0;
}

physical_addr = ({16'h0000, DS} << 4) + offset;

dst_mem_val = dmem[physical_addr];
dst_reg_val_low = lregs[dst_reg_idx];
dst_reg_val_high = hregs[dst_reg_idx];

case (rm_bits[2]) {
  1'b1: dst_reg_val = dst_reg_val_high;
  1'b0: dst_reg_val = dst_reg_val_low;
}

case (is_mem_dst) {
  1'b1: dst_val = dst_mem_val;
  1'b0: dst_val = dst_reg_val;
}

// Read immediate count based on mod_bits
case (mod_bits) {
  2'b00: count = imem[eip + 3];
  2'b01: count = imem[eip + 4];
  2'b10: count = imem[eip + 7];
  2'b11: count = imem[eip + 3];
}

case (mod_bits) {
  2'b00: eip = eip + 4;
  2'b01: eip = eip + 5;
  2'b10: eip = eip + 8;
  2'b11: eip = eip + 4;
}

// Effective count is count mod 32
effective_count = count[4:0];

// SHR: Shift right by effective_count
case (effective_count) {
  5'd0: result = dst_val;
  5'd1: result = {1'b0, dst_val[7:1]};
  5'd2: result = {2'b00, dst_val[7:2]};
  5'd3: result = {3'b000, dst_val[7:3]};
  5'd4: result = {4'b0000, dst_val[7:4]};
  5'd5: result = {5'b00000, dst_val[7:5]};
  5'd6: result = {6'b000000, dst_val[7:6]};
  5'd7: result = {7'b0000000, dst_val[7]};
  default: result = 8'h00;
}

// CF = last bit shifted out
case (effective_count) {
  5'd0: flag_CF = flag_CF;
  5'd1: flag_CF = dst_val[0];
  5'd2: flag_CF = dst_val[1];
  5'd3: flag_CF = dst_val[2];
  5'd4: flag_CF = dst_val[3];
  5'd5: flag_CF = dst_val[4];
  5'd6: flag_CF = dst_val[5];
  5'd7: flag_CF = dst_val[6];
  5'd8: flag_CF = dst_val[7];
  default: flag_CF = 1'b0;
}

// SF, ZF, PF updated when count != 0
case (effective_count) {
  5'd0: flag_SF = flag_SF;
  default: flag_SF = result[7];
}

case (effective_count) {
  5'd0: flag_ZF = flag_ZF;
  default: flag_ZF = (result == 8'h00);
}

case (effective_count) {
  5'd0: flag_PF = flag_PF;
  default: flag_PF = ~(result[0] ^ result[1] ^ result[2] ^ result[3] ^ result[4] ^ result[5] ^ result[6] ^ result[7]);
}

// OF only defined for count=1: OF = MSB of original operand
case (count) {
  8'h01: flag_OF = dst_val[7];
}

// Write result
case (is_mem_dst) {
  1'b1: dmem[physical_addr] = result;
  1'b0: dmem[physical_addr] = dmem[physical_addr];
}

var write_high[0:0];
write_high = (~is_mem_dst) & rm_bits[2];
case (write_high) {
  1'b1: hregs[dst_reg_idx] = result;
  1'b0: hregs[dst_reg_idx] = hregs[dst_reg_idx];
}

var write_low[0:0];
write_low = (~is_mem_dst) & (~rm_bits[2]);
case (write_low) {
  1'b1: lregs[dst_reg_idx] = result;
  1'b0: lregs[dst_reg_idx] = lregs[dst_reg_idx];
}
