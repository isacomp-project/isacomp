// SPDX-License-Identifier: BSD-3-Clause
// i486 TEST r32, r32 (0x85 with mod=11)
// Performs AND but only sets flags, doesn't write result

isa_state eip[31:0];
var instr[7:0];
isa_state modrm[7:0];

// 32-bit register file: EAX(0), ECX(1), EDX(2), EBX(3), ESP(4), EBP(5), ESI(6), EDI(7)
isa_state xregs[31:0][2:0];

isa_state imem[7:0][31:0];
isa_state dmem[7:0][31:0];
isa_state flag_CF[0:0];
isa_state flag_OF[0:0];
isa_state flag_SF[0:0];
isa_state flag_ZF[0:0];
isa_state flag_AF[0:0];
isa_state flag_PF[0:0];

var mod_bits[1:0];
var reg_idx[2:0];
var rm_bits[2:0];
var src_val[31:0];
var dst_val[31:0];
var result[31:0];

// Fetch instruction
instr = imem[eip];
assume instr == 0x85;
eip = eip + 1;

// Fetch ModR/M byte
modrm = imem[eip];
eip = eip + 1;

// Decode ModR/M
mod_bits = modrm[7:6];
reg_idx = modrm[5:3];
rm_bits = modrm[2:0];

// Register-direct mode
assume mod_bits == 0b11;

// Read register values
src_val = xregs[reg_idx];
dst_val = xregs[rm_bits];

// Perform AND operation
result = dst_val & src_val;

// Set flags (TEST clears OF and CF)
flag_CF = 1'b0;
flag_OF = 1'b0;
flag_SF = result[31];
flag_ZF = result == 32'h00000000;
flag_AF = 1'b0;  // Undefined, typically cleared
flag_PF = ~(result[0] ^ result[1] ^ result[2] ^ result[3] ^ result[4] ^ result[5] ^ result[6] ^ result[7]);

// TEST does not write result
