// SPDX-License-Identifier: BSD-3-Clause
// i486 MOV r/m16, Sreg (0x8C)
// Move segment register to r/m16 (register or memory)
// Supports all addressing modes via ModR/M byte:
//   mod=00: [SI], [DI], [BX] - indirect
//   mod=01: [SI+disp8], [DI+disp8], [BX+disp8] - indirect + 8-bit displacement
//   mod=10: [SI+disp16], [DI+disp16], [BX+disp16] - indirect + 16-bit displacement
//   mod=11: AX, CX, DX, BX, SP, BP, SI, DI - register direct
//
// Segment register encoding (reg field):
//   000 = ES, 001 = CS, 010 = SS, 011 = DS, 100 = FS, 101 = GS

isa_state xregs[31:0][2:0];    // 16-bit registers array
isa_state eip[31:0];
var instr[7:0];
isa_state modrm[7:0];
var mod_bits[1:0];
var reg_bits[2:0];
var rm_bits[2:0];
isa_state imem[7:0][31:0];
isa_state dmem[7:0][31:0];     // 4GB memory (32-bit addressing)

// Segment registers
isa_state ES[15:0];
isa_state CS[15:0];
isa_state SS[15:0];
isa_state DS[15:0];
isa_state FS[15:0];
isa_state GS[15:0];

var dst_reg_idx[2:0];
var addr_reg_idx[2:0];
var base_offset[15:0];
var disp8[7:0];
var disp16_lo[7:0];
var disp16_hi[7:0];
var disp16[15:0];
var signed_disp8[15:0];
var offset[15:0];
var offset_hi[15:0];
var physical_addr_lo[19:0];
var physical_addr_hi[19:0];
var src_val[15:0];
var is_mem_dest[0:0];

// Fetch instruction
instr = imem[eip];
assume instr == 0x8C;

// Fetch ModR/M byte
modrm = imem[eip + 1];

// Decode ModR/M
mod_bits = modrm[7:6];
reg_bits = modrm[5:3];  // Source segment register
rm_bits = modrm[2:0];   // Destination r/m

dst_reg_idx = rm_bits;

// Read source segment register based on reg_bits encoding
case (reg_bits) {
  0b000: src_val = ES;
  0b001: src_val = CS;
  0b010: src_val = SS;
  0b011: src_val = DS;
  0b100: src_val = FS;
  0b101: src_val = GS;
}

// Pre-calculate address register index for memory modes
case (rm_bits) {
  0b100: addr_reg_idx = 3'b110;  // SI
  0b101: addr_reg_idx = 3'b111;  // DI
  0b111: addr_reg_idx = 3'b011;  // BX
}

// Read base offset from address register
base_offset = xregs[addr_reg_idx];

// Read potential displacement bytes
disp8 = imem[eip + 2];
disp16_lo = imem[eip + 2];
disp16_hi = imem[eip + 3];
disp16 = {disp16_hi, disp16_lo};
signed_disp8 = {{8{disp8[7]}}, disp8};

// Calculate offset based on addressing mode
case (mod_bits) {
  0b00: offset = base_offset;
  0b01: offset = base_offset + signed_disp8;
  0b10: offset = base_offset + disp16;
  0b11: offset = 16'h0000;
}

// Set destination type flag
case (mod_bits) {
  0b00: is_mem_dest = 1'b1;
  0b01: is_mem_dest = 1'b1;
  0b10: is_mem_dest = 1'b1;
  0b11: is_mem_dest = 1'b0;
}

// Calculate physical addresses for 16-bit memory access (little-endian)
offset_hi = offset + 16'h0001;  // Wraps at 16-bit boundary
physical_addr_lo = (DS << 4) + offset;
physical_addr_hi = (DS << 4) + offset_hi;

// Write result to destination (register or memory)
case (is_mem_dest) {
  1'b1: dmem[physical_addr_lo] = src_val[7:0];
  1'b0: xregs[dst_reg_idx] = src_val;
}

case (is_mem_dest) {
  1'b1: dmem[physical_addr_hi] = src_val[15:8];
  1'b0: xregs[dst_reg_idx] = src_val;
}

// Update EIP based on instruction length
case (mod_bits) {
  0b00: eip = eip + 2;  // opcode + ModR/M
  0b01: eip = eip + 3;  // opcode + ModR/M + disp8
  0b10: eip = eip + 4;  // opcode + ModR/M + disp16
  0b11: eip = eip + 2;  // opcode + ModR/M
}
