// SPDX-License-Identifier: BSD-3-Clause
// i486 XCHG r8, r/m8 (0x86) - Exchange register byte with r/m byte
// Exchanges 8-bit register with 8-bit r/m operand
// Supports all addressing modes via ModR/M byte:
//   mod=00: [SI], [DI], [BX] - indirect
//   mod=01: [SI+disp8], [DI+disp8], [BX+disp8] - indirect + 8-bit displacement
//   mod=10: [SI+disp16], [DI+disp16], [BX+disp16] - indirect + 16-bit displacement
//   mod=11: AL, CL, DL, BL, AH, CH, DH, BH - register direct

isa_state lregs[7:0][1:0] of xregs[0b0**][7:0];   // AL,CL,DL,BL
isa_state hregs[7:0][1:0] of xregs[0b0**][15:8];  // AH,CH,DH,BH
isa_state xregs[31:0][2:0];    // 16-bit registers array
isa_state eip[31:0];
var instr[7:0];
isa_state modrm[7:0];
var mod_bits[1:0];
var reg_idx[2:0];
var rm_bits[2:0];
isa_state imem[7:0][31:0];
isa_state dmem[7:0][31:0];     // 4GB memory (32-bit addressing)
isa_state DS[15:0];            // Data segment register

var reg_reg_idx[1:0];          // Register field (destination) index
var rm_reg_idx[1:0];           // R/M field (source) index
var addr_reg_idx[2:0];
var base_offset[15:0];
var disp8[7:0];
var disp16_lo[7:0];
var disp16_hi[7:0];
var disp16[15:0];
var signed_disp8[15:0];
var offset[15:0];
var physical_addr[19:0];
var eip_disp_offset[31:0];

// Register field operand (always register)
var reg_val_low[7:0];
var reg_val_high[7:0];
var reg_val[7:0];

// R/M field operand (register or memory)
var rm_mem_val[7:0];
var rm_reg_val_low[7:0];
var rm_reg_val_high[7:0];
var rm_reg_val[7:0];
var rm_val[7:0];

var is_mem_rm[0:0];
var write_to_mem[0:0];
var write_reg_to_hreg[0:0];
var write_reg_to_lreg[0:0];
var write_rm_to_hreg[0:0];
var write_rm_to_lreg[0:0];

// Fetch instruction
instr = imem[eip];
assume instr == 0x86;

// Fetch ModR/M byte
modrm = imem[eip + 1];

// Decode ModR/M
mod_bits = modrm[7:6];
reg_idx = modrm[5:3];
rm_bits = modrm[2:0];

reg_reg_idx = reg_idx[1:0];
rm_reg_idx = rm_bits[1:0];

// Pre-calculate address register index for memory modes
case (rm_bits) {
  0b100: addr_reg_idx = 3'b110;
  0b101: addr_reg_idx = 3'b111;
  0b111: addr_reg_idx = 3'b011;
}

// Read base offset from address register
base_offset = xregs[addr_reg_idx];

// Read potential displacement bytes (after opcode and ModR/M)
disp8 = imem[eip + 2];
disp16_lo = imem[eip + 2];
disp16_hi = imem[eip + 3];
disp16 = {disp16_hi, disp16_lo};
signed_disp8 = {{8{disp8[7]}}, disp8};

// Calculate offset based on addressing mode
case (mod_bits) {
  0b00: offset = base_offset;
  0b01: offset = base_offset + signed_disp8;
  0b10: offset = base_offset + disp16;
  0b11: offset = 16'h0000;
}

// Set r/m operand type flag
case (mod_bits) {
  0b00: is_mem_rm = 1'b1;
  0b01: is_mem_rm = 1'b1;
  0b10: is_mem_rm = 1'b1;
  0b11: is_mem_rm = 1'b0;
}

// Calculate EIP displacement offset based on addressing mode
case (mod_bits) {
  0b00: eip_disp_offset = 0;
  0b01: eip_disp_offset = 1;
  0b10: eip_disp_offset = 2;
  0b11: eip_disp_offset = 0;
}

// Advance EIP: opcode (1) + modrm (1) + displacement (0/1/2)
eip = eip + 2 + eip_disp_offset;

// Calculate physical address for memory modes
physical_addr = (DS << 4) + offset;

// Read register field operand (high or low byte)
reg_val_low = lregs[reg_reg_idx];
reg_val_high = hregs[reg_reg_idx];

case (reg_idx[2]) {
  1'b1: reg_val = reg_val_high;
  1'b0: reg_val = reg_val_low;
}

// Read r/m field operand values
rm_mem_val = dmem[physical_addr];
rm_reg_val_low = lregs[rm_reg_idx];
rm_reg_val_high = hregs[rm_reg_idx];

// Select r/m register value (high vs low byte)
case (rm_bits[2]) {
  1'b1: rm_reg_val = rm_reg_val_high;
  1'b0: rm_reg_val = rm_reg_val_low;
}

// Select actual r/m value (memory or register)
case (is_mem_rm) {
  1'b1: rm_val = rm_mem_val;
  1'b0: rm_val = rm_reg_val;
}

// XCHG operation: Exchange reg_val with rm_val
// Write rm_val to register field, write reg_val to r/m field

// Determine where to write the register field (gets rm_val)
case (reg_idx[2]) {
  1'b1: write_reg_to_hreg = 1'b1;
  1'b0: write_reg_to_hreg = 1'b0;
}

case (reg_idx[2]) {
  1'b1: write_reg_to_lreg = 1'b0;
  1'b0: write_reg_to_lreg = 1'b1;
}

// Determine where to write the r/m field (gets reg_val)
case (is_mem_rm) {
  1'b1: write_to_mem = 1'b1;
  1'b0: write_to_mem = 1'b0;
}

case (is_mem_rm) {
  1'b1: write_rm_to_hreg = 1'b0;
  1'b0: write_rm_to_hreg = rm_bits[2];
}

case (is_mem_rm) {
  1'b1: write_rm_to_lreg = 1'b0;
  1'b0: write_rm_to_lreg = ~rm_bits[2];
}

// Write rm_val to register field
case (write_reg_to_hreg) {
  1'b1: hregs[reg_reg_idx] = rm_val;
  1'b0: hregs[reg_reg_idx] = hregs[reg_reg_idx];
}

case (write_reg_to_lreg) {
  1'b1: lregs[reg_reg_idx] = rm_val;
  1'b0: lregs[reg_reg_idx] = lregs[reg_reg_idx];
}

// Write reg_val to r/m field
case (write_to_mem) {
  1'b1: dmem[physical_addr] = reg_val;
  1'b0: dmem[physical_addr] = dmem[physical_addr];
}

case (write_rm_to_hreg) {
  1'b1: hregs[rm_reg_idx] = reg_val;
  1'b0: hregs[rm_reg_idx] = hregs[rm_reg_idx];
}

case (write_rm_to_lreg) {
  1'b1: lregs[rm_reg_idx] = reg_val;
  1'b0: lregs[rm_reg_idx] = lregs[rm_reg_idx];
}
