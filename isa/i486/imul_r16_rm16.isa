// SPDX-License-Identifier: BSD-3-Clause
// i486 IMUL r16, r/m16 (0x0F AF with 16-bit operands)
// Two-operand signed multiply: r16 = r16 * r/m16
// Sets CF/OF on overflow (result doesn't fit in 16 bits)
// SF, ZF, AF, PF are undefined

isa_state eip[31:0];
var instr[7:0];
var instr2[7:0];
isa_state modrm[7:0];

// 32-bit register file: EAX(0), ECX(1), EDX(2), EBX(3), ESP(4), EBP(5), ESI(6), EDI(7)
isa_state xregs[31:0][2:0];

isa_state imem[7:0][31:0];
isa_state dmem[7:0][31:0];
isa_state flag_CF[0:0];
isa_state flag_OF[0:0];

var mod_bits[1:0];
var reg_bits[2:0];
var rm_bits[2:0];
var dst_val[15:0];
var src_val[15:0];
var result[31:0];
var sign_extend[31:0];

// Fetch first byte of instruction
instr = imem[eip];
assume instr == 0x0F;
eip = eip + 1;

// Fetch second byte
instr2 = imem[eip];
assume instr2 == 0xAF;
eip = eip + 1;

// Fetch ModR/M byte
modrm = imem[eip];
eip = eip + 1;

// Decode ModR/M
mod_bits = modrm[7:6];
reg_bits = modrm[5:3];
rm_bits = modrm[2:0];

// Register-direct mode
assume mod_bits == 0b11;

// Read operands (low 16 bits of registers)
dst_val = xregs[reg_bits][15:0];
src_val = xregs[rm_bits][15:0];

// Perform signed multiply: result = dst * src
result = dst_val * src_val;

// Store low 16 bits in destination
xregs[reg_bits][15:0] = result[15:0];

// Set flags: CF and OF set if sign extension of result doesn't fit in 16 bits
// Sign extend the low 16 bits to 32 bits
sign_extend = result[15] ? {16'hFFFF, result[15:0]} : {16'h0000, result[15:0]};

flag_CF = (result != sign_extend);
flag_OF = (result != sign_extend);
