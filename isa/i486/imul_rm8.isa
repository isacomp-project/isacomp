// SPDX-License-Identifier: BSD-3-Clause
// i486 IMUL r/m8 (0xF6 /5) - CONSOLIDATED ALL ADDRESSING MODES
// Signed multiply: AL * rm8 -> AX

isa_state lregs[7:0][1:0] of xregs[0b0**][7:0];
isa_state hregs[7:0][1:0] of xregs[0b0**][15:8];
isa_state xregs[31:0][2:0];
isa_state eip[31:0];
var instr[7:0];
isa_state modrm[7:0];
var mod_bits[1:0];
var reg_bits[2:0];
var rm_bits[2:0];
isa_state imem[7:0][31:0];
isa_state dmem[7:0][31:0];
isa_state DS[15:0];
isa_state flag_CF[0:0];
isa_state flag_OF[0:0];

var src_reg_idx[1:0];
var addr_reg_idx[2:0];
var base_offset[15:0];
var disp8[7:0];
var disp16_lo[7:0];
var disp16_hi[7:0];
var disp16[15:0];
var signed_disp8[15:0];
var offset[15:0];
var physical_addr[31:0];
var src_mem_val[7:0];
var src_reg_val_low[7:0];
var src_reg_val_high[7:0];
var src_reg_val[7:0];
var src_val[7:0];
var al_val[7:0];
var result[15:0];
var sign_extended_low[15:0];
var is_mem_src[0:0];

instr = imem[eip];
assume instr == 0xF6;

modrm = imem[eip + 1];

mod_bits = modrm[7:6];
reg_bits = modrm[5:3];
rm_bits = modrm[2:0];

assume reg_bits == 0b101;  // IMUL

src_reg_idx = rm_bits[1:0];

case (rm_bits) {
  0b100: addr_reg_idx = 3'b110;
  0b101: addr_reg_idx = 3'b111;
  0b111: addr_reg_idx = 3'b011;
}

base_offset = xregs[addr_reg_idx];

disp8 = imem[eip + 2];
disp16_lo = imem[eip + 2];
disp16_hi = imem[eip + 3];
disp16 = {disp16_hi, disp16_lo};
signed_disp8 = {{8{disp8[7]}}, disp8};

case (mod_bits) {
  0b00: offset = base_offset;
  0b01: offset = base_offset + signed_disp8;
  0b10: offset = base_offset + disp16;
  0b11: offset = 16'h0000;
}

case (mod_bits) {
  0b00: is_mem_src = 1'b1;
  0b01: is_mem_src = 1'b1;
  0b10: is_mem_src = 1'b1;
  0b11: is_mem_src = 1'b0;
}

case (mod_bits) {
  0b00: eip = eip + 2;
  0b01: eip = eip + 3;
  0b10: eip = eip + 4;
  0b11: eip = eip + 2;
}

physical_addr = (DS << 4) + offset;

src_mem_val = dmem[physical_addr];
src_reg_val_low = lregs[src_reg_idx];
src_reg_val_high = hregs[src_reg_idx];

case (rm_bits[2]) {
  1'b1: src_reg_val = src_reg_val_high;
  1'b0: src_reg_val = src_reg_val_low;
}

case (is_mem_src) {
  1'b1: src_val = src_mem_val;
  1'b0: src_val = src_reg_val;
}

al_val = lregs[0];
// Signed multiply - treat as signed values
result = al_val * src_val;

// For signed multiply, CF=OF=0 if sign extension of AL equals AX
sign_extended_low = {{8{result[7]}}, result[7:0]};
flag_CF = (sign_extended_low != result);
flag_OF = (sign_extended_low != result);

// Write result to AX - preserve upper 16 bits of EAX
xregs[0] = {xregs[0][31:16], result};
