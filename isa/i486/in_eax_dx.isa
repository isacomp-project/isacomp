// SPDX-License-Identifier: BSD-3-Clause
// i486 IN EAX, DX (0xED)
// Input dword from I/O port DX to EAX

isa_state eip[31:0];
var instr[7:0];

// 32-bit register file
isa_state xregs[31:0][2:0];

// Register aliases
isa_state EAX[31:0] of xregs[0];
isa_state DX[15:0] of xregs[2][15:0];

isa_state imem[7:0][31:0];
isa_state io_ports[7:0][15:0];

var val_b0[7:0];
var val_b1[7:0];
var val_b2[7:0];
var val_b3[7:0];
var val[31:0];

// Fetch instruction
instr = imem[eip];
assume instr == 0xED;
eip = eip + 1;

// Read 32-bit value from I/O port DX (little-endian)
val_b0 = io_ports[DX];
val_b1 = io_ports[DX + 1];
val_b2 = io_ports[DX + 2];
val_b3 = io_ports[DX + 3];

val = {val_b3, val_b2, val_b1, val_b0};

// Store in EAX
EAX = val;

// IN does not affect flags
