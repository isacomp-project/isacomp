// SPDX-License-Identifier: BSD-3-Clause
// i486 POP r/m32 with 66 prefix (0x66 0x8F /0)
// Pop from stack to r/m32

isa_state eip[31:0];
var prefix[7:0];
var instr[7:0];
isa_state modrm[7:0];

isa_state xregs[31:0][2:0];
isa_state imem[7:0][31:0];
isa_state dmem[7:0][31:0];

var mod_bits[1:0];
var reg_bits[2:0];
var rm_bits[2:0];
var esp_val[31:0];
var pop_b0[7:0];
var pop_b1[7:0];
var pop_b2[7:0];
var pop_b3[7:0];
var pop_val[31:0];

prefix = imem[eip];
assume prefix == 0x66;

instr = imem[eip + 1];
assume instr == 0x8F;

modrm = imem[eip + 2];

mod_bits = modrm[7:6];
reg_bits = modrm[5:3];
rm_bits = modrm[2:0];

assume reg_bits == 0b000;
assume mod_bits == 0b11;

eip = eip + 3;

// Read ESP
esp_val = xregs[4];

// Pop value from stack
pop_b0 = dmem[esp_val];
pop_b1 = dmem[esp_val + 1];
pop_b2 = dmem[esp_val + 2];
pop_b3 = dmem[esp_val + 3];
pop_val = {pop_b3, pop_b2, pop_b1, pop_b0};

// Store in destination register
xregs[rm_bits] = pop_val;

// Update ESP
xregs[4] = esp_val + 4;
