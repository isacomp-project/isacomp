// SPDX-License-Identifier: BSD-3-Clause
// i486 BSR r16, r/m16 with 67 prefix (0x67 0x0F 0xBD) - 32-bit addressing
// Bit Scan Reverse - find first set bit from MSB

isa_state xregs[31:0][2:0];
isa_state eip[31:0];
var prefix[7:0];
var instr[7:0];
var instr2[7:0];
isa_state modrm[7:0];
var mod_bits[1:0];
var reg_idx[2:0];
var rm_bits[2:0];
isa_state imem[7:0][31:0];
isa_state dmem[7:0][31:0];
isa_state DS[15:0];
isa_state flag_ZF[0:0];

var dst_idx[2:0];
var base_val[31:0];
var disp8[7:0];
var disp32_b0[7:0];
var disp32_b1[7:0];
var disp32_b2[7:0];
var disp32_b3[7:0];
var disp32[31:0];
var signed_disp8[31:0];
var offset[31:0];
var physical_addr[31:0];
var physical_addr_1[31:0];
var src_mem_lo[7:0];
var src_mem_hi[7:0];
var src_val[15:0];
var result[15:0];
var is_mem_src[0:0];

prefix = imem[eip];
assume prefix == 0x67;

instr = imem[eip + 1];
assume instr == 0x0F;

instr2 = imem[eip + 2];
assume instr2 == 0xBD;

modrm = imem[eip + 3];

mod_bits = modrm[7:6];
reg_idx = modrm[5:3];
rm_bits = modrm[2:0];

dst_idx = reg_idx;
base_val = xregs[rm_bits];

disp8 = imem[eip + 4];
disp32_b0 = imem[eip + 4];
disp32_b1 = imem[eip + 5];
disp32_b2 = imem[eip + 6];
disp32_b3 = imem[eip + 7];
disp32 = {disp32_b3, disp32_b2, disp32_b1, disp32_b0};
signed_disp8 = {{24{disp8[7]}}, disp8};

case (mod_bits) {
  2'b00: offset = base_val;
  2'b01: offset = base_val + signed_disp8;
  2'b10: offset = base_val + disp32;
  2'b11: offset = 32'h00000000;
}

case (mod_bits) {
  2'b00: is_mem_src = 1'b1;
  2'b01: is_mem_src = 1'b1;
  2'b10: is_mem_src = 1'b1;
  2'b11: is_mem_src = 1'b0;
}

case (mod_bits) {
  2'b00: eip = eip + 4;
  2'b01: eip = eip + 5;
  2'b10: eip = eip + 8;
  2'b11: eip = eip + 4;
}

physical_addr = ({16'h0000, DS} << 4) + offset;
physical_addr_1 = physical_addr + 32'h00000001;

src_mem_lo = dmem[physical_addr];
src_mem_hi = dmem[physical_addr_1];

case (is_mem_src) {
  1'b1: src_val = {src_mem_hi, src_mem_lo};
  1'b0: src_val = xregs[rm_bits][15:0];
}

flag_ZF = (src_val == 16'h0000);

// BSR: find first 1 bit from MSB
case (1'b1) {
  src_val[15]: result = 16'd15;
  src_val[14]: result = 16'd14;
  src_val[13]: result = 16'd13;
  src_val[12]: result = 16'd12;
  src_val[11]: result = 16'd11;
  src_val[10]: result = 16'd10;
  src_val[9]: result = 16'd9;
  src_val[8]: result = 16'd8;
  src_val[7]: result = 16'd7;
  src_val[6]: result = 16'd6;
  src_val[5]: result = 16'd5;
  src_val[4]: result = 16'd4;
  src_val[3]: result = 16'd3;
  src_val[2]: result = 16'd2;
  src_val[1]: result = 16'd1;
  src_val[0]: result = 16'd0;
}

case (flag_ZF) {
  1'b0: xregs[dst_idx] = {xregs[dst_idx][31:16], result};
  1'b1: xregs[dst_idx] = xregs[dst_idx];
}
