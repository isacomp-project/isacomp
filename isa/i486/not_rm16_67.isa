// SPDX-License-Identifier: BSD-3-Clause
// i486 NOT r/m16 with 67 prefix (0x67 0xF7 /2) - 32-bit addressing mode
// In real mode, 67 prefix switches to 32-bit addressing
// Uses 32-bit registers for address calculation

isa_state xregs[31:0][2:0];
isa_state eip[31:0];
var prefix[7:0];
var instr[7:0];
isa_state modrm[7:0];
var mod_bits[1:0];
var reg_bits[2:0];
var rm_bits[2:0];
isa_state imem[7:0][31:0];
isa_state dmem[7:0][31:0];
isa_state DS[15:0];

var dst_reg_idx[2:0];
var base_val[31:0];
var disp8[7:0];
var disp32_b0[7:0];
var disp32_b1[7:0];
var disp32_b2[7:0];
var disp32_b3[7:0];
var disp32[31:0];
var signed_disp8[31:0];
var offset[31:0];
var physical_addr_lo[31:0];
var physical_addr_hi[31:0];
var dst_mem_val_lo[7:0];
var dst_mem_val_hi[7:0];
var dst_mem_val[15:0];
var dst_reg_val[15:0];
var dst_val[15:0];
var result[15:0];
var is_mem_dst[0:0];
var write_to_mem[0:0];
var write_to_reg[0:0];

// Read and verify 67 prefix
prefix = imem[eip];
assume prefix == 0x67;

instr = imem[eip + 1];
assume instr == 0xF7;

modrm = imem[eip + 2];

mod_bits = modrm[7:6];
reg_bits = modrm[5:3];
rm_bits = modrm[2:0];

assume reg_bits == 0b010;  // NOT

dst_reg_idx = rm_bits;

// For 32-bit addressing, rm directly selects the base register
// (simplified - not handling SIB byte for rm=100)
base_val = xregs[rm_bits];

// Read potential displacement bytes
disp8 = imem[eip + 3];
disp32_b0 = imem[eip + 3];
disp32_b1 = imem[eip + 4];
disp32_b2 = imem[eip + 5];
disp32_b3 = imem[eip + 6];
disp32 = {disp32_b3, disp32_b2, disp32_b1, disp32_b0};
signed_disp8 = {{24{disp8[7]}}, disp8};

// Calculate offset based on addressing mode
case (mod_bits) {
  2'b00: offset = base_val;
  2'b01: offset = base_val + signed_disp8;
  2'b10: offset = base_val + disp32;
  2'b11: offset = 32'h00000000;
}

// Set destination type flag
case (mod_bits) {
  2'b00: is_mem_dst = 1'b1;
  2'b01: is_mem_dst = 1'b1;
  2'b10: is_mem_dst = 1'b1;
  2'b11: is_mem_dst = 1'b0;
}

// Advance EIP based on displacement bytes consumed
case (mod_bits) {
  2'b00: eip = eip + 3;
  2'b01: eip = eip + 4;
  2'b10: eip = eip + 7;
  2'b11: eip = eip + 3;
}

// Calculate physical address (DS:offset in real mode)
physical_addr_lo = ({16'h0000, DS} << 4) + offset;
physical_addr_hi = physical_addr_lo + 32'h00000001;

// Read destination values
dst_mem_val_lo = dmem[physical_addr_lo];
dst_mem_val_hi = dmem[physical_addr_hi];
dst_mem_val = {dst_mem_val_hi, dst_mem_val_lo};
dst_reg_val = xregs[dst_reg_idx];

// Select actual destination value based on mode
case (is_mem_dst) {
  1'b1: dst_val = dst_mem_val;
  1'b0: dst_val = dst_reg_val;
}

result = ~dst_val;
// No flags affected by NOT

case (is_mem_dst) {
  1'b1: write_to_mem = 1'b1;
  1'b0: write_to_mem = 1'b0;
}

case (is_mem_dst) {
  1'b1: write_to_reg = 1'b0;
  1'b0: write_to_reg = 1'b1;
}

case (write_to_mem) {
  1'b1: dmem[physical_addr_lo] = result[7:0];
  1'b0: dmem[physical_addr_lo] = dmem[physical_addr_lo];
}

case (write_to_mem) {
  1'b1: dmem[physical_addr_hi] = result[15:8];
  1'b0: dmem[physical_addr_hi] = dmem[physical_addr_hi];
}

case (write_to_reg) {
  1'b1: xregs[dst_reg_idx] = result[15:0];
  1'b0: xregs[dst_reg_idx] = xregs[dst_reg_idx];
}
