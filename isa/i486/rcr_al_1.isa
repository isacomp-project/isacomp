// SPDX-License-Identifier: BSD-3-Clause
// i486 RCR AL, 1 (0xD0 with modrm 0xD8)
// Rotate through carry right by 1

isa_state eip[31:0];
var instr[7:0];
isa_state modrm[7:0];

// 32-bit register file: EAX(0), ECX(1), EDX(2), EBX(3), ESP(4), EBP(5), ESI(6), EDI(7)
isa_state xregs[31:0][2:0];

// Register aliases using 'of' for subsetting
isa_state EAX[31:0] of xregs[0];
isa_state AX[15:0] of xregs[0][15:0];
isa_state AL[7:0] of xregs[0][7:0];
isa_state AH[7:0] of xregs[0][15:8];
isa_state imem[7:0][31:0];
isa_state dmem[7:0][31:0];     // 4GB memory (32-bit addressing)
isa_state DS[15:0];            // Data segment register
isa_state flag_CF[0:0];
isa_state flag_OF[0:0];

var old_cf[0:0];
var result[8:0];

instr = imem[eip];
assume instr == 0xD0;
eip = eip + 1;

modrm = imem[eip];
assume modrm == 0xD8;
eip = eip + 1;

// Save old CF
old_cf = flag_CF;

// Rotate right through carry: [CF][AL7...AL0] becomes [AL0][CF][AL7...AL1]
result = {old_cf, AL[7:1]};

// New CF is the old bit 0
flag_CF = AL[0];

AL = result[7:0];

// OF is XOR of two high bits (for 1-bit rotate)
flag_OF = AL[7] ^ AL[6];
