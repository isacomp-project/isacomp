// SPDX-License-Identifier: BSD-3-Clause
// i486 JECXZ rel8 with 66 prefix (0x66 0xE3)
// Jump short if ECX is zero
// Uses signed byte displacement relative to EIP
// Note: With 66 prefix, tests 32-bit ECX instead of 16-bit CX
// Note: Does NOT decrement ECX, only tests if it's zero

isa_state eip[31:0];
var prefix[7:0];
var instr[7:0];

// 32-bit register file
isa_state xregs[31:0][2:0];

isa_state imem[7:0][31:0];

var offset[7:0];
var signed_offset[31:0];
var target_addr[31:0];
var ecx[31:0];

// Fetch 66 prefix
prefix = imem[eip];
assume prefix == 0x66;

// Fetch instruction
instr = imem[eip + 1];
assume instr == 0xE3;

// Read signed byte displacement
offset = imem[eip + 2];

// Sign-extend 8-bit offset to 32 bits
signed_offset = {{24{offset[7]}}, offset};

// Next PC after 3-byte instruction
var next_eip[31:0];
next_eip = eip + 3;

// Calculate target address (next_eip + signed offset)
target_addr = next_eip + signed_offset;

// Read ECX (full 32 bits)
ecx = xregs[1];

// Jump if ECX == 0 (no decrement)
eip = ecx == 32'h00000000 ? target_addr : next_eip;
