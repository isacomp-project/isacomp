// SPDX-License-Identifier: BSD-3-Clause
// i486 PUSH imm32 with 66 prefix (0x66 0x68)
// Push 32-bit immediate value onto stack

isa_state eip[31:0];
var prefix[7:0];
var instr[7:0];

// 32-bit register file: EAX(0), ECX(1), EDX(2), EBX(3), ESP(4), EBP(5), ESI(6), EDI(7)
isa_state xregs[31:0][2:0];

// Stack pointer alias
isa_state ESP[31:0] of xregs[4];

isa_state imem[7:0][31:0];
isa_state dmem[7:0][31:0];

var imm_b0[7:0];
var imm_b1[7:0];
var imm_b2[7:0];
var imm_b3[7:0];
var imm_val[31:0];
var new_esp[31:0];

// Fetch 0x66 prefix
prefix = imem[eip];
assume prefix == 0x66;

// Fetch instruction
instr = imem[eip + 1];
assume instr == 0x68;

// Read immediate value (little-endian: low byte first)
imm_b0 = imem[eip + 2];
imm_b1 = imem[eip + 3];
imm_b2 = imem[eip + 4];
imm_b3 = imem[eip + 5];

// Advance EIP past instruction (prefix + opcode + 4-byte immediate)
eip = eip + 6;

// Combine bytes into 32-bit immediate
imm_val = {imm_b3, imm_b2, imm_b1, imm_b0};

// Decrement ESP by 4 (32-bit push)
new_esp = ESP - 4;
ESP = new_esp;

// Store immediate on stack (little-endian)
dmem[new_esp] = imm_val[7:0];
dmem[new_esp + 1] = imm_val[15:8];
dmem[new_esp + 2] = imm_val[23:16];
dmem[new_esp + 3] = imm_val[31:24];

// PUSH does not affect flags
