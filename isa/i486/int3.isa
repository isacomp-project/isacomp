// SPDX-License-Identifier: BSD-3-Clause
// i486 INT 3 (0xCC)
// Opcode: 0xCC
// Breakpoint interrupt - same as INT 3 but single-byte opcode

isa_state eip[31:0];
var instr[7:0];

// 32-bit register file
isa_state xregs[31:0][2:0];
isa_state ESP[31:0] of xregs[4];

// Segment registers
isa_state CS[15:0];
isa_state SS[15:0];

isa_state imem[7:0][31:0];
isa_state dmem[7:0][31:0];

// Flags
isa_state flag_CF[0:0];
isa_state flag_PF[0:0];
isa_state flag_AF[0:0];
isa_state flag_ZF[0:0];
isa_state flag_SF[0:0];
isa_state flag_DF[0:0];
isa_state flag_OF[0:0];
isa_state flag_IF[0:0];
isa_state flag_TF[0:0];

var eflags[31:0];
var return_eip[31:0];
var new_esp[31:0];
var vector_addr[31:0];
var new_eip[31:0];
var new_cs[15:0];

// Fetch instruction
instr = imem[eip];

// Check this is INT 3 instruction
assume instr == 0xCC;

// Save return address (instruction after INT 3)
return_eip = eip + 1;

// Build EFLAGS register from individual flags
// EFLAGS format: bit 11:OF, 10:DF, 9:IF, 8:TF, 7:SF, 6:ZF, 4:AF, 2:PF, 1:1, 0:CF
eflags = {20'b0, flag_OF, flag_DF, flag_IF, flag_TF, flag_SF, flag_ZF, 1'b0, flag_AF, 1'b0, flag_PF, 1'b1, flag_CF};

// Push EFLAGS (4 bytes, little-endian)
new_esp = ESP - 4;
dmem[new_esp] = eflags[7:0];
dmem[new_esp + 1] = eflags[15:8];
dmem[new_esp + 2] = eflags[23:16];
dmem[new_esp + 3] = eflags[31:24];
ESP = new_esp;

// Push CS (2 bytes zero-extended to 4 bytes, little-endian)
new_esp = ESP - 4;
dmem[new_esp] = CS[7:0];
dmem[new_esp + 1] = CS[15:8];
dmem[new_esp + 2] = 8'b0;
dmem[new_esp + 3] = 8'b0;
ESP = new_esp;

// Push return EIP (4 bytes, little-endian)
new_esp = ESP - 4;
dmem[new_esp] = return_eip[7:0];
dmem[new_esp + 1] = return_eip[15:8];
dmem[new_esp + 2] = return_eip[23:16];
dmem[new_esp + 3] = return_eip[31:24];
ESP = new_esp;

// Read interrupt vector 3 from IDT (simplified real mode)
// In real mode: vector_addr = 3 * 4 = 12
vector_addr = 12;

// Read new EIP (offset) from vector table (4 bytes, little-endian)
new_eip = {dmem[vector_addr + 3], dmem[vector_addr + 2], dmem[vector_addr + 1], dmem[vector_addr]};

// Read new CS (segment) from vector table (2 bytes, little-endian)
new_cs = {dmem[vector_addr + 5], dmem[vector_addr + 4]};

// Jump to interrupt handler
eip = new_eip;
CS = new_cs;

// Clear IF and TF flags (disable interrupts and trap)
flag_IF = 0;
flag_TF = 0;
