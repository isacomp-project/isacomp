// SPDX-License-Identifier: BSD-3-Clause
// i486 SLDT r/m16 (0x0F 0x00 /0)
// Store Local Descriptor Table Register
// Stores LDTR to 16-bit r/m operand

isa_state eip[31:0];
var instr[7:0];
var instr2[7:0];
isa_state modrm[7:0];

isa_state xregs[31:0][2:0];
isa_state imem[7:0][31:0];
isa_state dmem[7:0][31:0];

isa_state LDTR[15:0];

var mod_bits[1:0];
var reg_bits[2:0];
var rm_bits[2:0];

// Fetch instruction bytes
instr = imem[eip];
assume instr == 0x0F;
eip = eip + 1;

instr2 = imem[eip];
assume instr2 == 0x00;
eip = eip + 1;

// Fetch ModR/M byte
modrm = imem[eip];
eip = eip + 1;

// Decode ModR/M
mod_bits = modrm[7:6];
reg_bits = modrm[5:3];
rm_bits = modrm[2:0];

// Must be /0 (reg field = 0)
assume reg_bits == 3'b000;

// Register-direct mode
assume mod_bits == 0b11;

// Store LDTR to register (low 16 bits, zero-extend to 32)
xregs[rm_bits][15:0] = LDTR;
xregs[rm_bits][31:16] = 16'h0000;
