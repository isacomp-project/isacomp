// SPDX-License-Identifier: BSD-3-Clause
// i486 TEST r/m16, imm16 with 67 prefix (0x67 0xF7 /0) - 32-bit addressing mode
// In real mode, 67 prefix switches to 32-bit addressing
// Uses 32-bit registers for address calculation

isa_state xregs[31:0][2:0];
isa_state eip[31:0];
var prefix[7:0];
var instr[7:0];
isa_state modrm[7:0];
var mod_bits[1:0];
var reg_bits[2:0];
var rm_bits[2:0];
isa_state imem[7:0][31:0];
isa_state dmem[7:0][31:0];
isa_state DS[15:0];
isa_state flag_CF[0:0];
isa_state flag_OF[0:0];
isa_state flag_SF[0:0];
isa_state flag_ZF[0:0];
isa_state flag_AF[0:0];
isa_state flag_PF[0:0];

var dst_reg_idx[2:0];
var base_val[31:0];
var disp8[7:0];
var disp32_b0[7:0];
var disp32_b1[7:0];
var disp32_b2[7:0];
var disp32_b3[7:0];
var disp32[31:0];
var signed_disp8[31:0];
var offset[31:0];
var physical_addr_lo[31:0];
var physical_addr_hi[31:0];
var dst_mem_val_lo[7:0];
var dst_mem_val_hi[7:0];
var dst_mem_val[15:0];
var dst_reg_val[15:0];
var dst_val[15:0];
var imm_lo[7:0];
var imm_hi[7:0];
var imm_val[15:0];
var result[16:0];
var is_mem_dst[0:0];

// Read and verify 67 prefix
prefix = imem[eip];
assume prefix == 0x67;

instr = imem[eip + 1];
assume instr == 0xF7;

modrm = imem[eip + 2];

mod_bits = modrm[7:6];
reg_bits = modrm[5:3];
rm_bits = modrm[2:0];

assume reg_bits == 0b000;  // TEST

dst_reg_idx = rm_bits;

// For 32-bit addressing, rm directly selects the base register
// (simplified - not handling SIB byte for rm=100)
base_val = xregs[rm_bits];

// Read potential displacement bytes
disp8 = imem[eip + 3];
disp32_b0 = imem[eip + 3];
disp32_b1 = imem[eip + 4];
disp32_b2 = imem[eip + 5];
disp32_b3 = imem[eip + 6];
disp32 = {disp32_b3, disp32_b2, disp32_b1, disp32_b0};
signed_disp8 = {{24{disp8[7]}}, disp8};

// Calculate offset based on addressing mode
case (mod_bits) {
  2'b00: offset = base_val;
  2'b01: offset = base_val + signed_disp8;
  2'b10: offset = base_val + disp32;
  2'b11: offset = 32'h00000000;
}

// Set destination type flag
case (mod_bits) {
  2'b00: is_mem_dst = 1'b1;
  2'b01: is_mem_dst = 1'b1;
  2'b10: is_mem_dst = 1'b1;
  2'b11: is_mem_dst = 1'b0;
}

// Calculate physical address (DS:offset in real mode)
physical_addr_lo = ({16'h0000, DS} << 4) + offset;
physical_addr_hi = physical_addr_lo + 32'h00000001;

// Read destination values
dst_mem_val_lo = dmem[physical_addr_lo];
dst_mem_val_hi = dmem[physical_addr_hi];
dst_mem_val = {dst_mem_val_hi, dst_mem_val_lo};
dst_reg_val = xregs[dst_reg_idx];

// Select actual destination value based on mode
case (is_mem_dst) {
  1'b1: dst_val = dst_mem_val;
  1'b0: dst_val = dst_reg_val;
}

// Read immediate value based on displacement bytes consumed
case (mod_bits) {
  2'b00: imm_lo = imem[eip + 3];
  2'b01: imm_lo = imem[eip + 4];
  2'b10: imm_lo = imem[eip + 7];
  2'b11: imm_lo = imem[eip + 3];
}

case (mod_bits) {
  2'b00: imm_hi = imem[eip + 4];
  2'b01: imm_hi = imem[eip + 5];
  2'b10: imm_hi = imem[eip + 8];
  2'b11: imm_hi = imem[eip + 4];
}

imm_val = {imm_hi, imm_lo};

result = dst_val & imm_val;

flag_CF = 1'b0;
flag_OF = 1'b0;
flag_SF = result[15];
flag_ZF = result[15:0] == 16'h0000;
flag_AF = 1'b0;
flag_PF = ~(result[0] ^ result[1] ^ result[2] ^ result[3] ^ result[4] ^ result[5] ^ result[6] ^ result[7]);

// Advance EIP based on displacement bytes consumed (prefix + opcode + modrm + disp + imm16)
case (mod_bits) {
  2'b00: eip = eip + 5;
  2'b01: eip = eip + 6;
  2'b10: eip = eip + 9;
  2'b11: eip = eip + 5;
}

// TEST does not write result
