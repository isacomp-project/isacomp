// SPDX-License-Identifier: BSD-3-Clause
// i486 IN AX, imm8 (0xE5)
// Input word from port

isa_state eip[31:0];
var instr[7:0];
isa_state imem[7:0][31:0];
isa_state xregs[31:0][2:0];
isa_state AX[15:0] of xregs[0][15:0];
isa_state io_ports[7:0][7:0];

var port_num[7:0];
var low_byte[7:0];
var high_byte[7:0];

instr = imem[eip];
assume instr == 0xE5;
eip = eip + 1;

// Read port number
port_num = imem[eip];
eip = eip + 1;

// Read word from I/O port (little-endian)
low_byte = io_ports[port_num];
high_byte = io_ports[port_num + 1];
AX = {high_byte, low_byte};
