// SPDX-License-Identifier: BSD-3-Clause
// i486 SAR r/m32, imm8 (0xC1 /7 with mod=11)
// Shift Arithmetic Right by immediate byte (preserves sign)

isa_state eip[31:0];
var instr[7:0];
isa_state modrm[7:0];
var imm8[7:0];

// 32-bit register file
isa_state xregs[31:0][2:0];

isa_state imem[7:0][31:0];
isa_state dmem[7:0][31:0];
isa_state flag_CF[0:0];
isa_state flag_OF[0:0];
isa_state flag_SF[0:0];
isa_state flag_ZF[0:0];
isa_state flag_PF[0:0];

var mod_bits[1:0];
var reg_bits[2:0];
var rm_bits[2:0];
var dst_val[31:0];
var count[4:0];
var result[31:0];
var sign_bit[0:0];

// Fetch instruction, ModR/M, and immediate using offset-based addressing
instr = imem[eip];
assume instr == 0xC1;
modrm = imem[eip + 1];

// Decode ModR/M
mod_bits = modrm[7:6];
reg_bits = modrm[5:3];
rm_bits = modrm[2:0];

// Verify this is SAR (reg_bits = 111)
assume reg_bits == 0b111;

// Register-direct mode
assume mod_bits == 0b11;

// Fetch immediate byte
imm8 = imem[eip + 2];

// Read destination value
dst_val = xregs[rm_bits];

// Get count from immediate, masked to 5 bits for 32-bit operands
count = imm8[4:0];

// Save sign bit
sign_bit = dst_val[31];

// Perform arithmetic right shift (sign-extended)
// The >>> operator preserves sign bit during shift
result = dst_val >>> count;

// Write result
xregs[rm_bits] = result;

// Update flags if count != 0
// CF = last bit shifted out
flag_CF = count == 0 ? flag_CF : ((dst_val >> (count - 1)) & 1);

// ZF, SF, PF based on result
flag_ZF = count == 0 ? flag_ZF : (result == 0 ? 1'b1 : 1'b0);
flag_SF = count == 0 ? flag_SF : result[31];
flag_PF = count == 0 ? flag_PF : ~(result[0] ^ result[1] ^ result[2] ^ result[3] ^ result[4] ^ result[5] ^ result[6] ^ result[7]);

// OF is cleared for count=1, undefined otherwise
flag_OF = count == 1 ? 1'b0 : flag_OF;

// Update EIP after all processing
eip = eip + 3;
