// SPDX-License-Identifier: BSD-3-Clause
// i486 BSF r32, r/m32 (0x0F BC) - Bit Scan Forward
// Find lowest set bit (LSB to MSB) in source
// If source is 0: ZF=1, dest undefined
// If source is non-zero: ZF=0, dest=bit position of lowest set bit

isa_state eip[31:0];
var instr[7:0];
var instr2[7:0];
isa_state modrm[7:0];

// 32-bit register file
isa_state xregs[31:0][2:0];

isa_state imem[7:0][31:0];
isa_state dmem[7:0][31:0];
isa_state flag_ZF[0:0];

var mod_bits[1:0];
var reg_idx[2:0];
var rm_bits[2:0];
var src_val[31:0];
var result[31:0];
var is_zero[0:0];

// Priority encoding flags for bytes
var byte0_zero[0:0];
var byte1_zero[0:0];
var byte2_zero[0:0];

// Priority encoding flags for each bit position
var found0[0:0]; var found1[0:0]; var found2[0:0]; var found3[0:0];
var found4[0:0]; var found5[0:0]; var found6[0:0]; var found7[0:0];
var found8[0:0]; var found9[0:0]; var found10[0:0]; var found11[0:0];
var found12[0:0]; var found13[0:0]; var found14[0:0]; var found15[0:0];
var found16[0:0]; var found17[0:0]; var found18[0:0]; var found19[0:0];
var found20[0:0]; var found21[0:0]; var found22[0:0]; var found23[0:0];
var found24[0:0]; var found25[0:0]; var found26[0:0]; var found27[0:0];
var found28[0:0]; var found29[0:0]; var found30[0:0]; var found31[0:0];

// Fetch first opcode byte
instr = imem[eip];
assume instr == 0x0F;
eip = eip + 1;

// Fetch second opcode byte
instr2 = imem[eip];
assume instr2 == 0xBC;
eip = eip + 1;

// Fetch ModR/M byte
modrm = imem[eip];
eip = eip + 1;

// Decode ModR/M
mod_bits = modrm[7:6];
reg_idx = modrm[5:3];
rm_bits = modrm[2:0];

// Register-direct mode only
assume mod_bits == 0b11;

// Read source value
src_val = xregs[rm_bits];

// Check if source is zero
is_zero = (src_val == 32'h00000000) ? 1'b1 : 1'b0;

// Set ZF based on whether source is zero
case (is_zero) {
    1'b1: flag_ZF = 1'b1;
    1'b0: flag_ZF = 1'b0;
}

// Byte zero flags
byte0_zero = (src_val[7:0] == 8'h00) ? 1'b1 : 1'b0;
byte1_zero = (src_val[15:0] == 16'h0000) ? 1'b1 : 1'b0;
byte2_zero = (src_val[23:0] == 24'h000000) ? 1'b1 : 1'b0;

// Priority encoding for bits 0-7
found0 = src_val[0];
found1 = src_val[1] & ~src_val[0];
found2 = src_val[2] & ~src_val[1] & ~src_val[0];
found3 = src_val[3] & ~src_val[2] & ~src_val[1] & ~src_val[0];
found4 = src_val[4] & ~src_val[3] & ~src_val[2] & ~src_val[1] & ~src_val[0];
found5 = src_val[5] & ~src_val[4] & ~src_val[3] & ~src_val[2] & ~src_val[1] & ~src_val[0];
found6 = src_val[6] & ~src_val[5] & ~src_val[4] & ~src_val[3] & ~src_val[2] & ~src_val[1] & ~src_val[0];
found7 = src_val[7] & ~src_val[6] & ~src_val[5] & ~src_val[4] & ~src_val[3] & ~src_val[2] & ~src_val[1] & ~src_val[0];

case (found0) { 1'b1: result = 32'd0; }
case (found1) { 1'b1: result = 32'd1; }
case (found2) { 1'b1: result = 32'd2; }
case (found3) { 1'b1: result = 32'd3; }
case (found4) { 1'b1: result = 32'd4; }
case (found5) { 1'b1: result = 32'd5; }
case (found6) { 1'b1: result = 32'd6; }
case (found7) { 1'b1: result = 32'd7; }

// Priority encoding for bits 8-15 (only if byte 0 is zero)
found8 = byte0_zero & src_val[8];
found9 = byte0_zero & src_val[9] & ~src_val[8];
found10 = byte0_zero & src_val[10] & ~src_val[9] & ~src_val[8];
found11 = byte0_zero & src_val[11] & ~src_val[10] & ~src_val[9] & ~src_val[8];
found12 = byte0_zero & src_val[12] & ~src_val[11] & ~src_val[10] & ~src_val[9] & ~src_val[8];
found13 = byte0_zero & src_val[13] & ~src_val[12] & ~src_val[11] & ~src_val[10] & ~src_val[9] & ~src_val[8];
found14 = byte0_zero & src_val[14] & ~src_val[13] & ~src_val[12] & ~src_val[11] & ~src_val[10] & ~src_val[9] & ~src_val[8];
found15 = byte0_zero & src_val[15] & ~src_val[14] & ~src_val[13] & ~src_val[12] & ~src_val[11] & ~src_val[10] & ~src_val[9] & ~src_val[8];

case (found8) { 1'b1: result = 32'd8; }
case (found9) { 1'b1: result = 32'd9; }
case (found10) { 1'b1: result = 32'd10; }
case (found11) { 1'b1: result = 32'd11; }
case (found12) { 1'b1: result = 32'd12; }
case (found13) { 1'b1: result = 32'd13; }
case (found14) { 1'b1: result = 32'd14; }
case (found15) { 1'b1: result = 32'd15; }

// Priority encoding for bits 16-23 (only if bytes 0-1 are zero)
found16 = byte1_zero & src_val[16];
found17 = byte1_zero & src_val[17] & ~src_val[16];
found18 = byte1_zero & src_val[18] & ~src_val[17] & ~src_val[16];
found19 = byte1_zero & src_val[19] & ~src_val[18] & ~src_val[17] & ~src_val[16];
found20 = byte1_zero & src_val[20] & ~src_val[19] & ~src_val[18] & ~src_val[17] & ~src_val[16];
found21 = byte1_zero & src_val[21] & ~src_val[20] & ~src_val[19] & ~src_val[18] & ~src_val[17] & ~src_val[16];
found22 = byte1_zero & src_val[22] & ~src_val[21] & ~src_val[20] & ~src_val[19] & ~src_val[18] & ~src_val[17] & ~src_val[16];
found23 = byte1_zero & src_val[23] & ~src_val[22] & ~src_val[21] & ~src_val[20] & ~src_val[19] & ~src_val[18] & ~src_val[17] & ~src_val[16];

case (found16) { 1'b1: result = 32'd16; }
case (found17) { 1'b1: result = 32'd17; }
case (found18) { 1'b1: result = 32'd18; }
case (found19) { 1'b1: result = 32'd19; }
case (found20) { 1'b1: result = 32'd20; }
case (found21) { 1'b1: result = 32'd21; }
case (found22) { 1'b1: result = 32'd22; }
case (found23) { 1'b1: result = 32'd23; }

// Priority encoding for bits 24-31 (only if bytes 0-2 are zero)
found24 = byte2_zero & src_val[24];
found25 = byte2_zero & src_val[25] & ~src_val[24];
found26 = byte2_zero & src_val[26] & ~src_val[25] & ~src_val[24];
found27 = byte2_zero & src_val[27] & ~src_val[26] & ~src_val[25] & ~src_val[24];
found28 = byte2_zero & src_val[28] & ~src_val[27] & ~src_val[26] & ~src_val[25] & ~src_val[24];
found29 = byte2_zero & src_val[29] & ~src_val[28] & ~src_val[27] & ~src_val[26] & ~src_val[25] & ~src_val[24];
found30 = byte2_zero & src_val[30] & ~src_val[29] & ~src_val[28] & ~src_val[27] & ~src_val[26] & ~src_val[25] & ~src_val[24];
found31 = byte2_zero & src_val[31] & ~src_val[30] & ~src_val[29] & ~src_val[28] & ~src_val[27] & ~src_val[26] & ~src_val[25] & ~src_val[24];

case (found24) { 1'b1: result = 32'd24; }
case (found25) { 1'b1: result = 32'd25; }
case (found26) { 1'b1: result = 32'd26; }
case (found27) { 1'b1: result = 32'd27; }
case (found28) { 1'b1: result = 32'd28; }
case (found29) { 1'b1: result = 32'd29; }
case (found30) { 1'b1: result = 32'd30; }
case (found31) { 1'b1: result = 32'd31; }

// Write result to destination register (only when source is non-zero)
case (is_zero) {
    1'b0: xregs[reg_idx] = result;
}

// CF, OF, SF, AF, PF are undefined
