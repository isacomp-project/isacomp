// i486 MOV r32, imm32 (0xB8-0xBF) - Parameterized
// Opcodes: 0xB8 (EAX), 0xB9 (ECX), 0xBA (EDX), 0xBB (EBX),
//          0xBC (ESP), 0xBD (EBP), 0xBE (ESI), 0xBF (EDI)
// Move immediate 32-bit value to register

isa_state eip[31:0];
var instr[7:0];

// 32-bit register file: EAX(0), ECX(1), EDX(2), EBX(3), ESP(4), EBP(5), ESI(6), EDI(7)
isa_state xregs[31:0][2:0];

isa_state imem[7:0][31:0];
isa_state dmem[7:0][31:0];

var reg_idx[2:0];
var imm_b0[7:0];
var imm_b1[7:0];
var imm_b2[7:0];
var imm_b3[7:0];
var imm_val[31:0];

// Fetch instruction
instr = imem[eip];

// Check this is a MOV r32, imm32 instruction (0xB8-0xBF)
assume instr[7:3] == 0b10111;  // Upper 5 bits must be 10111

eip = eip + 1;

// Extract register index from lower 3 bits of opcode
reg_idx = instr[2:0];

// Read immediate value (little-endian: low byte first)
imm_b0 = imem[eip];
eip = eip + 1;
imm_b1 = imem[eip];
eip = eip + 1;
imm_b2 = imem[eip];
eip = eip + 1;
imm_b3 = imem[eip];
eip = eip + 1;

// Combine bytes into 32-bit immediate
imm_val = {imm_b3, imm_b2, imm_b1, imm_b0};

// Move immediate to register
xregs[reg_idx] = imm_val;

// MOV does not affect flags
