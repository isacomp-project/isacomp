// SPDX-License-Identifier: BSD-3-Clause
// i486 JMP m16:16 (0x66 0xFF /5)
// Far jump to address in memory (segment:offset pair)

isa_state eip[31:0];
var prefix[7:0];
var instr[7:0];
isa_state modrm[7:0];

isa_state xregs[31:0][2:0];
isa_state imem[7:0][31:0];
isa_state dmem[7:0][31:0];
isa_state DS[15:0];
isa_state CS[15:0];

var mod_bits[1:0];
var reg_bits[2:0];
var rm_bits[2:0];
var addr_reg_idx[2:0];
var base_offset[15:0];
var disp8[7:0];
var disp16_lo[7:0];
var disp16_hi[7:0];
var disp16[15:0];
var signed_disp8[15:0];
var offset[15:0];
var phys0[19:0];
var phys1[19:0];
var phys2[19:0];
var phys3[19:0];
var target_offset[15:0];
var target_segment[15:0];

// Fetch prefix
prefix = imem[eip];
assume prefix == 0x66;

// Fetch instruction
instr = imem[eip + 1];
assume instr == 0xFF;

// Fetch ModR/M byte
modrm = imem[eip + 2];

// Decode ModR/M
mod_bits = modrm[7:6];
reg_bits = modrm[5:3];
rm_bits = modrm[2:0];

// Check that reg field is 5 (JMP far)
assume reg_bits == 0b101;

// Must be memory operand
assume mod_bits != 0b11;

case (rm_bits) {
  0b100: addr_reg_idx = 3'b110;
  0b101: addr_reg_idx = 3'b111;
  0b111: addr_reg_idx = 3'b011;
}

base_offset = xregs[addr_reg_idx][15:0];

disp8 = imem[eip + 3];
disp16_lo = imem[eip + 3];
disp16_hi = imem[eip + 4];
disp16 = {disp16_hi, disp16_lo};
signed_disp8 = {{8{disp8[7]}}, disp8};

case (mod_bits) {
  0b00: offset = base_offset;
  0b01: offset = base_offset + signed_disp8;
  0b10: offset = base_offset + disp16;
}

// Read far pointer from memory (4 bytes: offset[0:1], segment[2:3])
phys0 = (DS << 4) + offset;
phys1 = (DS << 4) + offset + 16'h0001;
phys2 = (DS << 4) + offset + 16'h0002;
phys3 = (DS << 4) + offset + 16'h0003;

var target_offset_lo[7:0];
var target_offset_hi[7:0];
var target_segment_lo[7:0];
var target_segment_hi[7:0];
target_offset_lo = dmem[phys0];
target_offset_hi = dmem[phys1];
target_segment_lo = dmem[phys2];
target_segment_hi = dmem[phys3];
target_offset = {target_offset_hi, target_offset_lo};
target_segment = {target_segment_hi, target_segment_lo};

// Jump to target
CS = target_segment;
eip = {16'h0000, target_offset};
