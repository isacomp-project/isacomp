// SPDX-License-Identifier: BSD-3-Clause
// i486 BT r/m16, imm8 (0x0F BA /4) - Bit Test with immediate
// Test bit in r/m16, bit index is immediate byte
// CF = bit value, OF/SF/ZF/AF/PF undefined

isa_state eip[31:0];
var instr[7:0];
var instr2[7:0];
isa_state modrm[7:0];

// 32-bit register file (lower 16 bits used for 16-bit operations)
isa_state xregs[31:0][2:0];

isa_state imem[7:0][31:0];
isa_state dmem[7:0][31:0];
isa_state flag_CF[0:0];

var mod_bits[1:0];
var reg_bits[2:0];
var rm_bits[2:0];
var base_val[15:0];
var imm8[7:0];
var bit_pos[3:0];
var bit_val[0:0];

// Fetch first opcode byte
instr = imem[eip];
assume instr == 0x0F;
eip = eip + 1;

// Fetch second opcode byte
instr2 = imem[eip];
assume instr2 == 0xBA;
eip = eip + 1;

// Fetch ModR/M byte
modrm = imem[eip];
eip = eip + 1;

// Decode ModR/M
mod_bits = modrm[7:6];
reg_bits = modrm[5:3];
rm_bits = modrm[2:0];

// Verify this is BT (reg_bits = 100)
assume reg_bits == 0b100;

// Register-direct mode only
assume mod_bits == 0b11;

// Read immediate byte
imm8 = imem[eip];
eip = eip + 1;

// Read value (lower 16 bits)
base_val = xregs[rm_bits][15:0];

// Compute bit position (modulo 16)
bit_pos = imm8[3:0];

// Extract bit value
bit_val = base_val[bit_pos];

// Set CF to bit value
flag_CF = bit_val;

// OF, SF, ZF, AF, PF are undefined (not modified in this implementation)
