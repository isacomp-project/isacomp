// SPDX-License-Identifier: BSD-3-Clause
// i486 ROR RM32, 1 (0x66 0xD1) - CONSOLIDATED

isa_state xregs[31:0][2:0];
isa_state eip[31:0];
var prefix[7:0];
var instr[7:0];
isa_state modrm[7:0];
var mod_bits[1:0];
var reg_bits[2:0];
var rm_bits[2:0];
isa_state imem[7:0][31:0];
isa_state dmem[7:0][31:0];
isa_state DS[15:0];
isa_state flag_CF[0:0];
isa_state flag_OF[0:0];
isa_state flag_SF[0:0];
isa_state flag_ZF[0:0];
isa_state flag_PF[0:0];

var dst_reg_idx[2:0];
var addr_reg_idx[2:0];
var base_offset[15:0];
var disp8[7:0];
var disp16_lo[7:0];
var disp16_hi[7:0];
var disp16[15:0];
var signed_disp8[15:0];
var offset[15:0];
var physical_addr_lo[19:0];
var phys1[19:0];
var phys2[19:0];
var physical_addr_hi[19:0];
var dst_mem_val[31:0];
var dst_reg_val[31:0];
var dst_val[31:0];
var count[7:0];
var result[32:0];
var is_mem_dst[0:0];
var write_to_mem[0:0];
var write_to_reg[0:0];

prefix = imem[eip];
assume prefix == 0x66;

instr = imem[eip + 1];
assume instr == 0xD1;

modrm = imem[eip + 2];

mod_bits = modrm[7:6];
reg_bits = modrm[5:3];
rm_bits = modrm[2:0];

dst_reg_idx = rm_bits;

case (rm_bits) {
  0b100: addr_reg_idx = 3'b110;
  0b101: addr_reg_idx = 3'b111;
  0b111: addr_reg_idx = 3'b011;
}

base_offset = xregs[addr_reg_idx];

disp8 = imem[eip + 3];
disp16_lo = imem[eip + 3];
disp16_hi = imem[eip + 4];
disp16 = {disp16_hi, disp16_lo};
signed_disp8 = {{8{disp8[7]}}, disp8};

case (mod_bits) {
  0b00: offset = base_offset;
  0b01: offset = base_offset + signed_disp8;
  0b10: offset = base_offset + disp16;
  0b11: offset = 16'h0000;
}

case (mod_bits) {
  0b00: is_mem_dst = 1'b1;
  0b01: is_mem_dst = 1'b1;
  0b10: is_mem_dst = 1'b1;
  0b11: is_mem_dst = 1'b0;
}

case (mod_bits) {
  0b00: eip = eip + 3;
  0b01: eip = eip + 4;
  0b10: eip = eip + 5;
  0b11: eip = eip + 3;
}

physical_addr_lo = (DS << 4) + offset;
phys1 = (DS << 4) + offset + 16'h0001;
phys2 = (DS << 4) + offset + 16'h0002;
physical_addr_hi = (DS << 4) + offset + 16'h0003;

var dst_mem_val_b0[7:0];
var dst_mem_val_b1[7:0];
var dst_mem_val_b2[7:0];
var dst_mem_val_b3[7:0];
dst_mem_val_b0 = dmem[physical_addr_lo];
dst_mem_val_b1 = dmem[phys1];
dst_mem_val_b2 = dmem[phys2];
dst_mem_val_b3 = dmem[physical_addr_hi];
dst_mem_val = {dst_mem_val_b3, dst_mem_val_b2, dst_mem_val_b1, dst_mem_val_b0};
dst_reg_val = xregs[dst_reg_idx];

case (is_mem_dst) {
  1'b1: dst_val = dst_mem_val;
  1'b0: dst_val = dst_reg_val;
}

assume reg_bits == 0b001;  // ROR

count = 8'h01;

// ROR: Rotate right
var temp_bit[0:0];
temp_bit = dst_val[0];
result = {temp_bit, dst_val[31:1]};
flag_CF = temp_bit;
flag_OF = (count == 8'h01) ? (result[31] ^ result[30]) : flag_OF;
flag_SF = result[31];
flag_ZF = result[31:0] == 32'h00000000;
flag_PF = ~(result[0] ^ result[1] ^ result[2] ^ result[3] ^ result[4] ^ result[5] ^ result[6] ^ result[7]);

case (is_mem_dst) {
  1'b1: write_to_mem = 1'b1;
  1'b0: write_to_mem = 1'b0;
}

case (is_mem_dst) {
  1'b1: write_to_reg = 1'b0;
  1'b0: write_to_reg = 1'b1;
}

case (write_to_mem) {
  1'b1: dmem[physical_addr_lo] = result[7:0];
  1'b0: dmem[physical_addr_lo] = dmem[physical_addr_lo];
}

case (write_to_mem) {
  1'b1: dmem[phys1] = result[15:8];
  1'b0: dmem[phys1] = dmem[phys1];
}

case (write_to_mem) {
  1'b1: dmem[phys2] = result[23:16];
  1'b0: dmem[phys2] = dmem[phys2];
}

case (write_to_mem) {
  1'b1: dmem[physical_addr_hi] = result[31:24];
  1'b0: dmem[physical_addr_hi] = dmem[physical_addr_hi];
}

case (write_to_reg) {
  1'b1: xregs[dst_reg_idx] = result[31:0];
  1'b0: xregs[dst_reg_idx] = xregs[dst_reg_idx];
}
