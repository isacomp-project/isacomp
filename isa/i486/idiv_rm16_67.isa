// SPDX-License-Identifier: BSD-3-Clause
// i486 IDIV r/m16 with 67 prefix (0x67 0xF7 /7) - 32-bit addressing mode
// Signed divide: DX:AX / rm16 -> AX (quotient), DX (remainder)
// In real mode, 67 prefix switches to 32-bit addressing
// Uses 32-bit registers for address calculation

isa_state xregs[31:0][2:0];
isa_state eip[31:0];
var prefix[7:0];
var instr[7:0];
isa_state modrm[7:0];
var mod_bits[1:0];
var reg_bits[2:0];
var rm_bits[2:0];
isa_state imem[7:0][31:0];
isa_state dmem[7:0][31:0];
isa_state DS[15:0];

var src_reg_idx[2:0];
var base_val[31:0];
var disp8[7:0];
var disp32_b0[7:0];
var disp32_b1[7:0];
var disp32_b2[7:0];
var disp32_b3[7:0];
var disp32[31:0];
var signed_disp8[31:0];
var offset[31:0];
var physical_addr_lo[31:0];
var physical_addr_hi[31:0];
var src_mem_val_lo[7:0];
var src_mem_val_hi[7:0];
var src_mem_val[15:0];
var src_reg_val[15:0];
var src_val[15:0];
var dividend[31:0];
var quotient[31:0];
var remainder[31:0];
var is_mem_src[0:0];

// Read and verify 67 prefix
prefix = imem[eip];
assume prefix == 0x67;

instr = imem[eip + 1];
assume instr == 0xF7;

modrm = imem[eip + 2];

mod_bits = modrm[7:6];
reg_bits = modrm[5:3];
rm_bits = modrm[2:0];

assume reg_bits == 0b111;  // IDIV

src_reg_idx = rm_bits;

// For 32-bit addressing, rm directly selects the base register
// (simplified - not handling SIB byte for rm=100)
base_val = xregs[rm_bits];

// Read potential displacement bytes
disp8 = imem[eip + 3];
disp32_b0 = imem[eip + 3];
disp32_b1 = imem[eip + 4];
disp32_b2 = imem[eip + 5];
disp32_b3 = imem[eip + 6];
disp32 = {disp32_b3, disp32_b2, disp32_b1, disp32_b0};
signed_disp8 = {{24{disp8[7]}}, disp8};

// Calculate offset based on addressing mode
case (mod_bits) {
  2'b00: offset = base_val;
  2'b01: offset = base_val + signed_disp8;
  2'b10: offset = base_val + disp32;
  2'b11: offset = 32'h00000000;
}

// Set source type flag
case (mod_bits) {
  2'b00: is_mem_src = 1'b1;
  2'b01: is_mem_src = 1'b1;
  2'b10: is_mem_src = 1'b1;
  2'b11: is_mem_src = 1'b0;
}

// Advance EIP based on displacement bytes consumed
case (mod_bits) {
  2'b00: eip = eip + 3;
  2'b01: eip = eip + 4;
  2'b10: eip = eip + 7;
  2'b11: eip = eip + 3;
}

// Calculate physical address (DS:offset in real mode)
physical_addr_lo = ({16'h0000, DS} << 4) + offset;
physical_addr_hi = physical_addr_lo + 32'h00000001;

// Read source values
src_mem_val_lo = dmem[physical_addr_lo];
src_mem_val_hi = dmem[physical_addr_hi];
src_mem_val = {src_mem_val_hi, src_mem_val_lo};
src_reg_val = xregs[src_reg_idx][15:0];

// Select actual source value based on mode
case (is_mem_src) {
  1'b1: src_val = src_mem_val;
  1'b0: src_val = src_reg_val;
}

// DX:AX is the 32-bit dividend
dividend = {xregs[2][15:0], xregs[0][15:0]};

// Signed division: need to handle signs manually
var div_sign[0:0];
var src_sign[0:0];
var result_sign[0:0];
var abs_div[31:0];
var abs_src[31:0];
var src_ext[31:0];
var neg_div[31:0];
var neg_src[31:0];
var unsigned_quot[31:0];
var unsigned_rem[31:0];
var neg_quot[31:0];
var neg_rem[31:0];

// Sign extend src_val to 32 bits
src_ext = {{16{src_val[15]}}, src_val};

// Get signs
div_sign = dividend[31];
src_sign = src_val[15];
result_sign = div_sign ^ src_sign;

// Compute absolute values
neg_div = ~dividend + 32'h00000001;
neg_src = ~src_ext + 32'h00000001;

case (div_sign) {
  1'b0: abs_div = dividend;
  1'b1: abs_div = neg_div;
}

case (src_sign) {
  1'b0: abs_src = src_ext;
  1'b1: abs_src = neg_src;
}

// Unsigned division
unsigned_quot = abs_div / abs_src;
unsigned_rem = abs_div - (unsigned_quot * abs_src);

// Apply signs to results
neg_quot = ~unsigned_quot + 32'h00000001;
neg_rem = ~unsigned_rem + 32'h00000001;

case (result_sign) {
  1'b0: quotient = unsigned_quot;
  1'b1: quotient = neg_quot;
}

// Remainder has same sign as dividend
case (div_sign) {
  1'b0: remainder = unsigned_rem;
  1'b1: remainder = neg_rem;
}

// Check for signed overflow - quotient must fit in signed 16 bits
// For signed 16-bit: upper 17 bits must all be same (sign extension)
var overflow[0:0];
var sign_ext_check[15:0];
sign_ext_check = {16{quotient[15]}};  // Sign extend bit 15 to upper 16 bits
overflow = (quotient[31:16] != sign_ext_check) ? 1'b1 : 1'b0;

// Only write results if no overflow (otherwise #DE exception, no change)
case (overflow) {
  1'b0: xregs[0] = {xregs[0][31:16], quotient[15:0]};   // AX = quotient
  1'b1: xregs[0] = xregs[0];  // unchanged
}
case (overflow) {
  1'b0: xregs[2] = {xregs[2][31:16], remainder[15:0]};  // DX = remainder
  1'b1: xregs[2] = xregs[2];  // unchanged
}
// Flags are undefined after IDIV
