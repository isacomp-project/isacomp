// SPDX-License-Identifier: BSD-3-Clause
// i486 RCL r32, 1 (0xD1 /2 with mod=11)
// Rotate through Carry Left by 1 bit

isa_state eip[31:0];
var instr[7:0];
isa_state modrm[7:0];

// 32-bit register file
isa_state xregs[31:0][2:0];

isa_state imem[7:0][31:0];
isa_state dmem[7:0][31:0];
isa_state flag_CF[0:0];
isa_state flag_OF[0:0];

var mod_bits[1:0];
var reg_bits[2:0];
var rm_bits[2:0];
var dst_val[31:0];
var old_cf[0:0];
var result[31:0];

// Fetch instruction
instr = imem[eip];
assume instr == 0xD1;
eip = eip + 1;

// Fetch ModR/M byte
modrm = imem[eip];
eip = eip + 1;

// Decode ModR/M
mod_bits = modrm[7:6];
reg_bits = modrm[5:3];
rm_bits = modrm[2:0];

// Verify this is RCL (reg_bits = 010)
assume reg_bits == 0b010;

// Register-direct mode
assume mod_bits == 0b11;

// Read destination value
dst_val = xregs[rm_bits];

// Save old carry flag
old_cf = flag_CF;

// Rotate through carry left by 1
// CF becomes MSB of original value
// Result = (dst_val << 1) | old_cf
result = {dst_val[30:0], old_cf};

// Write result
xregs[rm_bits] = result;

// New CF is the MSB that was shifted out
flag_CF = dst_val[31];

// OF is XOR of CF and MSB of result (for count=1)
flag_OF = flag_CF ^ result[31];
