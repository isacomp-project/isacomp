// SPDX-License-Identifier: BSD-3-Clause
// i486 IDIV r/m8 with 67 prefix (0x67 0xF6 /7) - 32-bit addressing mode
// Signed divide: AX / rm8 -> AL (quotient), AH (remainder)
// In real mode, 67 prefix switches to 32-bit addressing

isa_state lregs[7:0][1:0] of xregs[0b0**][7:0];
isa_state hregs[7:0][1:0] of xregs[0b0**][15:8];
isa_state xregs[31:0][2:0];
isa_state eip[31:0];
var prefix[7:0];
var instr[7:0];
isa_state modrm[7:0];
var mod_bits[1:0];
var reg_bits[2:0];
var rm_bits[2:0];
isa_state imem[7:0][31:0];
isa_state dmem[7:0][31:0];
isa_state DS[15:0];

var src_reg_idx[2:0];
var src_reg_idx_low[1:0];
var base_val[31:0];
var disp8[7:0];
var disp32_b0[7:0];
var disp32_b1[7:0];
var disp32_b2[7:0];
var disp32_b3[7:0];
var disp32[31:0];
var signed_disp8[31:0];
var offset[31:0];
var physical_addr[31:0];
var src_mem_val[7:0];
var src_reg_val_low[7:0];
var src_reg_val_high[7:0];
var src_reg_val[7:0];
var src_val[7:0];
var ax_val[15:0];
var quotient[15:0];
var remainder[15:0];
var is_mem_src[0:0];

prefix = imem[eip];
assume prefix == 0x67;

instr = imem[eip + 1];
assume instr == 0xF6;

modrm = imem[eip + 2];

mod_bits = modrm[7:6];
reg_bits = modrm[5:3];
rm_bits = modrm[2:0];

assume reg_bits == 0b111;  // IDIV

src_reg_idx = rm_bits;
src_reg_idx_low = src_reg_idx[1:0];

// For 32-bit addressing, rm selects base register
base_val = xregs[rm_bits];

disp8 = imem[eip + 3];
disp32_b0 = imem[eip + 3];
disp32_b1 = imem[eip + 4];
disp32_b2 = imem[eip + 5];
disp32_b3 = imem[eip + 6];
disp32 = {disp32_b3, disp32_b2, disp32_b1, disp32_b0};
signed_disp8 = {{24{disp8[7]}}, disp8};

case (mod_bits) {
  2'b00: offset = base_val;
  2'b01: offset = base_val + signed_disp8;
  2'b10: offset = base_val + disp32;
  2'b11: offset = 32'h00000000;
}

case (mod_bits) {
  2'b00: is_mem_src = 1'b1;
  2'b01: is_mem_src = 1'b1;
  2'b10: is_mem_src = 1'b1;
  2'b11: is_mem_src = 1'b0;
}

case (mod_bits) {
  2'b00: eip = eip + 3;
  2'b01: eip = eip + 4;
  2'b10: eip = eip + 7;
  2'b11: eip = eip + 3;
}

physical_addr = ({16'h0000, DS} << 4) + offset;

src_mem_val = dmem[physical_addr];
src_reg_val_low = lregs[src_reg_idx_low];
src_reg_val_high = hregs[src_reg_idx_low];

case (src_reg_idx[2]) {
  1'b1: src_reg_val = src_reg_val_high;
  1'b0: src_reg_val = src_reg_val_low;
}

case (is_mem_src) {
  1'b1: src_val = src_mem_val;
  1'b0: src_val = src_reg_val;
}

ax_val = xregs[0][15:0];

// Signed division: need to handle signs manually
var ax_sign[0:0];
var src_sign[0:0];
var result_sign[0:0];
var abs_ax[15:0];
var abs_src[15:0];
var src_ext[15:0];
var neg_ax[15:0];
var neg_src[15:0];
var unsigned_quot[15:0];
var unsigned_rem[15:0];
var neg_quot[15:0];
var neg_rem[15:0];

// Sign extend src_val to 16 bits
src_ext = {{8{src_val[7]}}, src_val};

// Get signs
ax_sign = ax_val[15];
src_sign = src_val[7];
result_sign = ax_sign ^ src_sign;

// Compute absolute values
neg_ax = ~ax_val + 16'h0001;
neg_src = ~src_ext + 16'h0001;

case (ax_sign) {
  1'b0: abs_ax = ax_val;
  1'b1: abs_ax = neg_ax;
}

case (src_sign) {
  1'b0: abs_src = src_ext;
  1'b1: abs_src = neg_src;
}

// Unsigned division
unsigned_quot = abs_ax / abs_src;
unsigned_rem = abs_ax - (unsigned_quot * abs_src);

// Apply signs to results
neg_quot = ~unsigned_quot + 16'h0001;
neg_rem = ~unsigned_rem + 16'h0001;

case (result_sign) {
  1'b0: quotient = unsigned_quot;
  1'b1: quotient = neg_quot;
}

// Remainder has same sign as dividend
case (ax_sign) {
  1'b0: remainder = unsigned_rem;
  1'b1: remainder = neg_rem;
}

// Check for signed overflow - quotient must fit in signed 8 bits
// For signed 8-bit: upper 9 bits must all be same (sign extension)
var overflow[0:0];
var sign_ext_check[7:0];
sign_ext_check = {8{quotient[7]}};  // Sign extend bit 7 to upper 8 bits
overflow = (quotient[15:8] != sign_ext_check) ? 1'b1 : 1'b0;

// Only write results if no overflow (otherwise #DE exception, no change)
case (overflow) {
  1'b0: lregs[0] = quotient[7:0];   // AL = quotient
  1'b1: lregs[0] = lregs[0];  // unchanged
}
case (overflow) {
  1'b0: hregs[0] = remainder[7:0];  // AH = remainder
  1'b1: hregs[0] = hregs[0];  // unchanged
}
// Flags are undefined after IDIV
