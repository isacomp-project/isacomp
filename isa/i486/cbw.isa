// SPDX-License-Identifier: BSD-3-Clause
// i486 CBW (0x98)
// Convert Byte to Word: Sign-extend AL into AX
// No flags affected

isa_state eip[31:0];
var instr[7:0];

// 32-bit register file: EAX(0), ECX(1), EDX(2), EBX(3), ESP(4), EBP(5), ESI(6), EDI(7)
isa_state xregs[31:0][2:0];

// Register aliases using 'of' for subsetting
isa_state AL[7:0] of xregs[0][7:0];
isa_state AX[15:0] of xregs[0][15:0];

isa_state imem[7:0][31:0];
isa_state dmem[7:0][31:0];

var sign_bit[0:0];

// Fetch instruction
instr = imem[eip];
assume instr == 0x98;
eip = eip + 1;

// Get sign bit of AL
sign_bit = AL[7];

// Sign-extend AL into AX
AX = sign_bit ? {8'hFF, AL} : {8'h00, AL};

// CBW does not affect any flags
