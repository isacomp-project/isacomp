// i486 LMSW r/m16 (0x0F 0x01 /6)
// Load Machine Status Word
// Loads low 16 bits into CR0[15:0], preserving CR0[31:16]

isa_state eip[31:0];
var instr[7:0];
var instr2[7:0];
isa_state modrm[7:0];

isa_state xregs[31:0][2:0];
isa_state imem[7:0][31:0];
isa_state dmem[7:0][31:0];

isa_state CR0[31:0];

var mod_bits[1:0];
var reg_bits[2:0];
var rm_bits[2:0];
var msw[15:0];

// Fetch instruction bytes
instr = imem[eip];
assume instr == 0x0F;
eip = eip + 1;

instr2 = imem[eip];
assume instr2 == 0x01;
eip = eip + 1;

// Fetch ModR/M byte
modrm = imem[eip];
eip = eip + 1;

// Decode ModR/M
mod_bits = modrm[7:6];
reg_bits = modrm[5:3];
rm_bits = modrm[2:0];

// Must be /6 (reg field = 6)
assume reg_bits == 3'b110;

// Register-direct mode
assume mod_bits == 0b11;

// Read MSW from register (low 16 bits)
msw = xregs[rm_bits][15:0];

// Load into CR0[15:0], preserve CR0[31:16]
CR0[15:0] = msw;
