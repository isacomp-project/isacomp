// SPDX-License-Identifier: BSD-3-Clause
// i486 MOV r32, DR3 (0x0F 21 /3)
// Move debug register 3 (breakpoint 3 linear address) to general register
// Privileged instruction (CPL must be 0)

isa_state eip[31:0];
var instr[7:0];
var instr2[7:0];
isa_state modrm[7:0];

// 32-bit register file
isa_state xregs[31:0][2:0];

// Debug registers
isa_state DR3[31:0];  // Breakpoint 3 linear address

isa_state imem[7:0][31:0];

var mod_bits[1:0];
var reg_bits[2:0];
var rm_bits[2:0];

// Fetch first byte
instr = imem[eip];
assume instr == 0x0F;
eip = eip + 1;

// Fetch second byte
instr2 = imem[eip];
assume instr2 == 0x21;
eip = eip + 1;

// Fetch ModR/M byte
modrm = imem[eip];
eip = eip + 1;

// Decode ModR/M
mod_bits = modrm[7:6];
reg_bits = modrm[5:3];
rm_bits = modrm[2:0];

assume mod_bits == 0b11;
assume reg_bits == 0b011;

xregs[rm_bits] = DR3;
