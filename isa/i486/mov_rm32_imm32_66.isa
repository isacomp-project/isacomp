// SPDX-License-Identifier: BSD-3-Clause
// i486 MOV r/m32, imm32 with 66 prefix (0x66 0xC7 /0)
// Move immediate to r/m32

isa_state eip[31:0];
var prefix[7:0];
var instr[7:0];
isa_state modrm[7:0];

isa_state xregs[31:0][2:0];
isa_state imem[7:0][31:0];

var mod_bits[1:0];
var reg_bits[2:0];
var rm_bits[2:0];
var imm_b0[7:0];
var imm_b1[7:0];
var imm_b2[7:0];
var imm_b3[7:0];
var imm_val[31:0];

prefix = imem[eip];
assume prefix == 0x66;

instr = imem[eip + 1];
assume instr == 0xC7;

modrm = imem[eip + 2];

mod_bits = modrm[7:6];
reg_bits = modrm[5:3];
rm_bits = modrm[2:0];

// MOV uses reg_bits = 000
assume reg_bits == 0b000;
assume mod_bits == 0b11;

// Fetch immediate
imm_b0 = imem[eip + 3];
imm_b1 = imem[eip + 4];
imm_b2 = imem[eip + 5];
imm_b3 = imem[eip + 6];

eip = eip + 7;

imm_val = {imm_b3, imm_b2, imm_b1, imm_b0};

// Write immediate to register
xregs[rm_bits] = imm_val;
