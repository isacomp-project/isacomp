// SPDX-License-Identifier: BSD-3-Clause
// i486 67-prefix MOV r/m16, r16 (0x67 0x89)
// Move 16-bit register to r/m16 (register or memory destination)
// With 67 prefix: 32-bit addressing mode

isa_state xregs[31:0][2:0];
isa_state eip[31:0];
var prefix[7:0];
var instr[7:0];
isa_state modrm[7:0];
var mod_bits[1:0];
var reg_idx[2:0];
var rm_bits[2:0];
isa_state imem[7:0][31:0];
isa_state dmem[7:0][31:0];
isa_state DS[15:0];

var src_idx[2:0];
var dst_reg_idx[2:0];
var base_val[31:0];
var disp8[7:0];
var disp32_b0[7:0];
var disp32_b1[7:0];
var disp32_b2[7:0];
var disp32_b3[7:0];
var disp32[31:0];
var signed_disp8[31:0];
var offset[31:0];
var physical_addr_lo[31:0];
var physical_addr_hi[31:0];
var src_val[15:0];
var is_mem_dest[0:0];

// Fetch instruction
prefix = imem[eip];
assume prefix == 0x67;

instr = imem[eip + 1];
assume instr == 0x89;

// Fetch ModR/M byte
modrm = imem[eip + 2];

// Decode ModR/M
mod_bits = modrm[7:6];
reg_idx = modrm[5:3];
rm_bits = modrm[2:0];

src_idx = reg_idx;
dst_reg_idx = rm_bits;

// Read source value (always from 16-bit register)
src_val = xregs[src_idx][15:0];

// 32-bit addressing: rm_bits directly indexes xregs
base_val = xregs[rm_bits];

// Read potential displacement bytes
disp8 = imem[eip + 3];
disp32_b0 = imem[eip + 3];
disp32_b1 = imem[eip + 4];
disp32_b2 = imem[eip + 5];
disp32_b3 = imem[eip + 6];
disp32 = {disp32_b3, disp32_b2, disp32_b1, disp32_b0};
signed_disp8 = {{24{disp8[7]}}, disp8};

// Calculate offset based on addressing mode
case (mod_bits) {
  2'b00: offset = base_val;
  2'b01: offset = base_val + signed_disp8;
  2'b10: offset = base_val + disp32;
  2'b11: offset = 32'h00000000;
}

// Set destination type flag
case (mod_bits) {
  2'b00: is_mem_dest = 1'b1;
  2'b01: is_mem_dest = 1'b1;
  2'b10: is_mem_dest = 1'b1;
  2'b11: is_mem_dest = 1'b0;
}

// Advance IP based on displacement bytes consumed
case (mod_bits) {
  2'b00: eip = eip + 3;
  2'b01: eip = eip + 4;
  2'b10: eip = eip + 7;
  2'b11: eip = eip + 3;
}

// Calculate physical addresses for 16-bit memory access
physical_addr_lo = ({16'h0000, DS} << 4) + offset;
physical_addr_hi = ({16'h0000, DS} << 4) + offset + 32'h00000001;

// Write source to destination (memory write needs two operations)
case (is_mem_dest) {
  1'b1: dmem[physical_addr_lo] = src_val[7:0];
  1'b0: xregs[dst_reg_idx][15:0] = src_val;
}

case (is_mem_dest) {
  1'b1: dmem[physical_addr_hi] = src_val[15:8];
  1'b0: xregs[dst_reg_idx][15:0] = src_val;
}

// MOV doesn't affect flags
