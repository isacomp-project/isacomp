// SPDX-License-Identifier: BSD-3-Clause
// i486 LES r16, m16:16 (0xC4)
// Load ES = [mem+2], reg = [mem]
isa_state eip[31:0];
var instr[7:0];
isa_state modrm[7:0];
isa_state xregs[31:0][2:0];
isa_state imem[7:0][31:0];
isa_state dmem[7:0][31:0];
isa_state DS[15:0];
isa_state ES[15:0];

var mod_bits[1:0];
var reg_idx[2:0];
var rm_bits[2:0];
var addr_reg_idx[2:0];
var base_offset[15:0];
var phys_addr[19:0];
var offset_lo[7:0];
var offset_hi[7:0];
var seg_lo[7:0];
var seg_hi[7:0];

instr = imem[eip];
assume instr == 0xC4;

modrm = imem[eip + 1];

mod_bits = modrm[7:6];
reg_idx = modrm[5:3];
rm_bits = modrm[2:0];

// Memory addressing only (mod != 11)
assume mod_bits == 0b00;

// Get address register
case (rm_bits) {
  0b100: addr_reg_idx = 3'b110;  // SI
  0b101: addr_reg_idx = 3'b111;  // DI
  0b111: addr_reg_idx = 3'b011;  // BX
}

base_offset = xregs[addr_reg_idx][15:0];
phys_addr = (DS << 4) + base_offset;

// Read offset (2 bytes)
offset_lo = dmem[phys_addr];
offset_hi = dmem[phys_addr + 1];

// Read segment (2 bytes)
seg_lo = dmem[phys_addr + 2];
seg_hi = dmem[phys_addr + 3];

// Store results
xregs[reg_idx][15:0] = {offset_hi, offset_lo};
ES = {seg_hi, seg_lo};

// Update EIP
eip = eip + 2;
