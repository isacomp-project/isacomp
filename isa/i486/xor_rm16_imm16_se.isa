// SPDX-License-Identifier: BSD-3-Clause
// i486 XOR r/m16, imm16 (0x83 /0b110) - CONSOLIDATED ALL ADDRESSING MODES
// Uses multiple case statements for parser compatibility
// logical XOR with sign-extended 8-bit immediate value
// Grp1 opcode 0x83 with reg field = 0b110
// Supports all addressing modes via ModR/M byte:
//   mod=00: [SI], [DI], [BX] - indirect
//   mod=01: [SI+disp8], [DI+disp8], [BX+disp8] - indirect + 8-bit displacement
//   mod=10: [SI+disp16], [DI+disp16], [BX+disp16] - indirect + 16-bit displacement
//   mod=11: AX, CX, DX, BX, SP, BP, SI, DI - register direct

isa_state xregs[31:0][2:0];    // 32-bit registers array
isa_state eip[31:0];
var instr[7:0];
isa_state modrm[7:0];
var mod_bits[1:0];
var reg_bits[2:0];
var rm_bits[2:0];
isa_state imem[7:0][31:0];
isa_state dmem[7:0][31:0];     // 4GB memory (32-bit addressing)
isa_state DS[15:0];            // Data segment register
isa_state flag_CF[0:0];
isa_state flag_OF[0:0];
isa_state flag_SF[0:0];
isa_state flag_ZF[0:0];
isa_state flag_AF[0:0];
isa_state flag_PF[0:0];

var dst_reg_idx[2:0];
var addr_reg_idx[2:0];
var base_offset[15:0];
var disp8[7:0];
var disp16_lo[7:0];
var disp16_hi[7:0];
var disp16[15:0];
var signed_disp8[15:0];
var offset[15:0];
var physical_addr_lo[19:0];
var physical_addr_hi[19:0];
var dst_mem_val_lo[7:0];
var dst_mem_val_hi[7:0];
var dst_mem_val[15:0];
var dst_reg_val[15:0];
var dst_val[15:0];
var imm_val[15:0];
var result[16:0];
var is_mem_dst[0:0];
var write_to_mem[0:0];
var write_to_hreg[0:0];
var write_to_lreg[0:0];
// Fetch instruction
instr = imem[eip];
assume instr == 0x83;
eip = eip + 1;

// Fetch ModR/M byte
modrm = imem[eip];
eip = eip + 1;

// Decode ModR/M
mod_bits = modrm[7:6];
reg_bits = modrm[5:3];
rm_bits = modrm[2:0];

// For Grp1, reg field selects the operation
assume reg_bits == 0b110;

dst_reg_idx = rm_bits;

// Pre-calculate address register index for memory modes
case (rm_bits) {
  0b100: addr_reg_idx = 3'b110;
  0b101: addr_reg_idx = 3'b111;
  0b111: addr_reg_idx = 3'b011;
}

// Read base offset from address register
base_offset = xregs[addr_reg_idx];

// Read potential displacement bytes
disp8 = imem[eip];
disp16_lo = imem[eip];
disp16_hi = imem[eip + 1];
disp16 = {disp16_hi, disp16_lo};
signed_disp8 = {{8{disp8[7]}}, disp8};

// Calculate offset based on addressing mode
case (mod_bits) {
  0b00: offset = base_offset;
  0b01: offset = base_offset + signed_disp8;
  0b10: offset = base_offset + disp16;
  0b11: offset = 16'h0000;
}

// Set destination type flag
case (mod_bits) {
  0b00: is_mem_dst = 1'b1;
  0b01: is_mem_dst = 1'b1;
  0b10: is_mem_dst = 1'b1;
  0b11: is_mem_dst = 1'b0;
}

// Advance IP based on displacement bytes consumed
case (mod_bits) {
  0b00: eip = eip;
  0b01: eip = eip + 1;
  0b10: eip = eip + 2;
  0b11: eip = eip;
}

// Calculate physical addresses for 16-bit memory access (little-endian)
physical_addr_lo = (DS << 4) + offset;
physical_addr_hi = (DS << 4) + offset + 16'h0001;

// Read destination values (both memory and register)
dst_mem_val_lo = dmem[physical_addr_lo];
dst_mem_val_hi = dmem[physical_addr_hi];
dst_mem_val = {dst_mem_val_hi, dst_mem_val_lo};
dst_reg_val = xregs[dst_reg_idx];

// Select actual destination value based on mode
case (is_mem_dst) {
  1'b1: dst_val = dst_mem_val;
  1'b0: dst_val = dst_reg_val;
}

// Fetch immediate value (8-bit sign-extended to 16-bit)
var imm8[7:0];
imm8 = imem[eip];
eip = eip + 1;
imm_val = {{8{imm8[7]}}, imm8};

// Perform XOR operation
result = dst_val ^ imm_val;

// Set flags for logical operation
flag_CF = 1'b0;
flag_OF = 1'b0;
flag_SF = result[15];
flag_ZF = result[15:0] == 16'h0000;
flag_AF = 1'b0;  // Undefined, set to 0
flag_PF = ~(result[0] ^ result[1] ^ result[2] ^ result[3] ^ result[4] ^ result[5] ^ result[6] ^ result[7]);

// Determine write target
case (is_mem_dst) {
  1'b1: write_to_mem = 1'b1;
  1'b0: write_to_mem = 1'b0;
}

case (is_mem_dst) {
  1'b1: write_to_reg = 1'b0;
  1'b0: write_to_reg = 1'b1;
}

// Write result to destination (16-bit little-endian for memory)
case (write_to_mem) {
  1'b1: dmem[physical_addr_lo] = result[7:0];
  1'b0: dmem[physical_addr_lo] = dmem[physical_addr_lo];  // No-op
}

case (write_to_mem) {
  1'b1: dmem[physical_addr_hi] = result[15:8];
  1'b0: dmem[physical_addr_hi] = dmem[physical_addr_hi];  // No-op
}

case (write_to_reg) {
  1'b1: xregs[dst_reg_idx] = result[15:0];
  1'b0: xregs[dst_reg_idx] = xregs[dst_reg_idx];  // No-op
}
