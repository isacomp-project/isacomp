// i486 DEC r16 - Parameterized with wildcard ** syntax
// Opcodes: 0x48-0x4F (DEC AX/CX/DX/BX/SP/BP/SI/DI)
// Replaces multiple files: dec_ax, dec_bx, etc.
// Opcode encoding: 0x48 + register_index (bits [2:0] of opcode = register index)
// Affects: OF, SF, ZF, AF, PF (NOT CF)

isa_state eip[31:0];
var instr[7:0];

// 32-bit register file: EAX(0), ECX(1), EDX(2), EBX(3), ESP(4), EBP(5), ESI(6), EDI(7)
isa_state xregs[31:0][2:0];

isa_state imem[7:0][31:0];
isa_state dmem[7:0][31:0];     // 4GB memory (32-bit addressing)
isa_state DS[15:0];            // Data segment register
isa_state flag_PF[0:0];
isa_state flag_AF[0:0];
isa_state flag_ZF[0:0];
isa_state flag_SF[0:0];
isa_state flag_OF[0:0];

var reg_idx[2:0];
var old_val[15:0];
var result[16:0];

// Fetch instruction
instr = imem[eip];

// Check this is a DEC r16 instruction (0x48-0x4F)
assume instr[7:3] == 0b01001;  // Upper 5 bits must be 01001

eip = eip + 1;

// Extract register index from lower 3 bits of opcode
reg_idx = instr[2:0];

// Read old value
old_val = xregs[reg_idx];

// Decrement by 1
result = old_val - 1;

// Write back using indexed access
xregs[reg_idx][15:0] = result[15:0];

// Update flags (CF is NOT affected by DEC)
flag_ZF = result[15:0] == 0 ? 1'b1 : 1'b0;
flag_SF = result[15];
flag_OF = (old_val[15] == 1'b1) & (result[15] == 1'b0);  // Overflow if 0x8000 - 1 = 0x7FFF
flag_PF = result[0];
flag_AF = ~old_val[3];  // AF set if low nibble underflowed
