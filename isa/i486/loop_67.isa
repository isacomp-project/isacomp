// SPDX-License-Identifier: BSD-3-Clause
// i486 67-prefix LOOP rel8 (0x67 0xE2)
// Decrement CX, jump if CX != 0
// Uses signed byte displacement relative to EIP
// Note: Uses 16-bit CX register, not 32-bit ECX

isa_state eip[31:0];
var prefix[7:0];
var instr[7:0];

// 32-bit register file
isa_state xregs[31:0][2:0];

isa_state imem[7:0][31:0];

var offset[7:0];
var signed_offset[31:0];
var target_addr[31:0];
var new_cx[15:0];
var cx[15:0];

// Fetch instruction
prefix = imem[eip];
assume prefix == 0x67;

instr = imem[eip + 1];
assume instr == 0xE2;

// Read signed byte displacement (after prefix + opcode)
offset = imem[eip + 2];

// Sign-extend 8-bit offset to 32 bits
signed_offset = {{24{offset[7]}}, offset};

// Calculate target address (eip after instruction + signed offset)
target_addr = eip + 2 + signed_offset;

// Read CX (lower 16 bits of ECX)
cx = xregs[1][15:0];

// Decrement CX
new_cx = cx - 1;

// Write back CX (preserves upper 16 bits)
xregs[1] = {xregs[1][31:16], new_cx};

// Jump if CX != 0, otherwise continue to next instruction
case (new_cx != 16'h0000) {
  1'b1: eip = target_addr;
  1'b0: eip = eip + 3;
}
