// SPDX-License-Identifier: BSD-3-Clause
// i486 PUSH r/m32 (0xFF /6)
// Push 32-bit register or memory operand onto stack
// Uses SS segment for stack access

isa_state eip[31:0];
var instr[7:0];
isa_state modrm[7:0];

isa_state xregs[31:0][2:0];
isa_state imem[7:0][31:0];
isa_state dmem[7:0][31:0];
isa_state SS[15:0];
isa_state DS[15:0];

var mod_bits[1:0];
var reg_bits[2:0];
var rm_bits[2:0];
var src_val[31:0];
var src_reg_idx[2:0];
var addr_reg_idx[2:0];
var base_offset[15:0];
var disp8[7:0];
var disp16_lo[7:0];
var disp16_hi[7:0];
var disp16[15:0];
var signed_disp8[15:0];
var offset[15:0];
var is_mem_src[0:0];
var phys0[19:0];
var phys1[19:0];
var phys2[19:0];
var phys3[19:0];
var src_mem_val[31:0];
var src_reg_val[31:0];
var stkoff0[31:0];
var stkoff1[31:0];
var stkoff2[31:0];
var stkoff3[31:0];
var stkaddr0[31:0];
var stkaddr1[31:0];
var stkaddr2[31:0];
var stkaddr3[31:0];

// Fetch instruction
instr = imem[eip];
assume instr == 0xFF;
eip = eip + 1;

// Fetch ModR/M byte
modrm = imem[eip];
eip = eip + 1;

// Decode ModR/M
mod_bits = modrm[7:6];
reg_bits = modrm[5:3];
rm_bits = modrm[2:0];

// Check that reg field is 6 (PUSH)
assume reg_bits == 0b110;

src_reg_idx = rm_bits;

case (rm_bits) {
  0b100: addr_reg_idx = 3'b110;
  0b101: addr_reg_idx = 3'b111;
  0b111: addr_reg_idx = 3'b011;
}

base_offset = xregs[addr_reg_idx][15:0];

disp8 = imem[eip];
disp16_lo = imem[eip];
disp16_hi = imem[eip + 1];
disp16 = {disp16_hi, disp16_lo};
signed_disp8 = {{8{disp8[7]}}, disp8};

case (mod_bits) {
  0b00: offset = base_offset;
  0b01: offset = base_offset + signed_disp8;
  0b10: offset = base_offset + disp16;
  0b11: offset = 16'h0000;
}

case (mod_bits) {
  0b00: is_mem_src = 1'b1;
  0b01: is_mem_src = 1'b1;
  0b10: is_mem_src = 1'b1;
  0b11: is_mem_src = 1'b0;
}

case (mod_bits) {
  0b00: eip = eip;
  0b01: eip = eip + 1;
  0b10: eip = eip + 2;
  0b11: eip = eip;
}

phys0 = (DS << 4) + offset;
phys1 = (DS << 4) + offset + 16'h0001;
phys2 = (DS << 4) + offset + 16'h0002;
phys3 = (DS << 4) + offset + 16'h0003;

var src_mem_val_b0[7:0];
var src_mem_val_b1[7:0];
var src_mem_val_b2[7:0];
var src_mem_val_b3[7:0];
src_mem_val_b0 = dmem[phys0];
src_mem_val_b1 = dmem[phys1];
src_mem_val_b2 = dmem[phys2];
src_mem_val_b3 = dmem[phys3];
src_mem_val = {src_mem_val_b3, src_mem_val_b2, src_mem_val_b1, src_mem_val_b0};
src_reg_val = xregs[src_reg_idx];

case (is_mem_src) {
  1'b1: src_val = src_mem_val;
  1'b0: src_val = src_reg_val;
}

// Decrement ESP by 4 (dword size)
xregs[4] = xregs[4] - 32'h00000004;

// Calculate stack offsets
stkoff0 = xregs[4];
stkoff1 = xregs[4] + 32'h00000001;
stkoff2 = xregs[4] + 32'h00000002;
stkoff3 = xregs[4] + 32'h00000003;

// Calculate physical addresses using SS segment
stkaddr0 = (SS << 4) + stkoff0;
stkaddr1 = (SS << 4) + stkoff1;
stkaddr2 = (SS << 4) + stkoff2;
stkaddr3 = (SS << 4) + stkoff3;

// Write value to stack (little-endian)
dmem[stkaddr0] = src_val[7:0];
dmem[stkaddr1] = src_val[15:8];
dmem[stkaddr2] = src_val[23:16];
dmem[stkaddr3] = src_val[31:24];
