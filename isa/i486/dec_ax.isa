// SPDX-License-Identifier: BSD-3-Clause
// i486 DEC AX (0x48)
// Decrement AX register by 1
// Affects: OF, SF, ZF, AF, PF (NOT CF)

isa_state eip[31:0];
var instr[7:0];
isa_state AX[15:0];
isa_state imem[7:0][31:0];
isa_state dmem[7:0][31:0];     // 4GB memory (32-bit addressing)
isa_state DS[15:0];            // Data segment register
isa_state flag_PF[0:0];
isa_state flag_AF[0:0];
isa_state flag_ZF[0:0];
isa_state flag_SF[0:0];
isa_state flag_OF[0:0];

var old_val[15:0];
var result[16:0];

// Fetch instruction
instr = imem[eip];
assume instr == 0x48;
eip = eip + 1;

// Read old value
old_val = AX;

// Decrement by 1
result = old_val - 1;

// Write back
AX = result[15:0];

// Update flags (CF is NOT affected by DEC)
flag_ZF = result[15:0] == 0 ? 1'b1 : 1'b0;
flag_SF = result[15];
flag_OF = (old_val[15] == 1'b1) & (result[15] == 1'b0);  // Overflow if 0x8000 - 1 = 0x7FFF
flag_PF = result[0];
flag_AF = old_val[3] ^ 1'b1;  // AF set if borrow from bit 4
