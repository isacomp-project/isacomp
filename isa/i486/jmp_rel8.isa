// SPDX-License-Identifier: BSD-3-Clause
// i486 JMP rel8 (0xEB) - Real mode (16-bit default)
// Unconditional Short Jump
isa_state eip[31:0];
var instr[7:0];
isa_state imem[7:0][31:0];

var rel8[7:0];
var signed_offset[15:0];
var next_ip[15:0];
var target_ip[15:0];

instr = imem[eip];
assume instr == 0xEB;

// Fetch rel8 and compute addresses
rel8 = imem[eip + 1];
next_ip = eip[15:0] + 16'h0002;

// Sign-extend rel8 to 16 bits
signed_offset = {{8{rel8[7]}}, rel8};

// Calculate target (16-bit wraparound)
target_ip = next_ip + signed_offset;

// Unconditional jump to target (only update lower 16 bits)
eip = {eip[31:16], target_ip};
