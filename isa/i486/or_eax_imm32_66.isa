// SPDX-License-Identifier: BSD-3-Clause
// i486 OR EAX, imm32 with 66 prefix (0x66 0x0D)

isa_state eip[31:0];
var prefix[7:0];
var instr[7:0];
isa_state xregs[31:0][2:0];
isa_state imem[7:0][31:0];
isa_state flag_CF[0:0];
isa_state flag_OF[0:0];
isa_state flag_SF[0:0];
isa_state flag_ZF[0:0];
isa_state flag_AF[0:0];
isa_state flag_PF[0:0];

var imm_b0[7:0];
var imm_b1[7:0];
var imm_b2[7:0];
var imm_b3[7:0];
var imm_val[31:0];
var result[31:0];

prefix = imem[eip];
assume prefix == 0x66;

instr = imem[eip + 1];
assume instr == 0x0D;

imm_b0 = imem[eip + 2];
imm_b1 = imem[eip + 3];
imm_b2 = imem[eip + 4];
imm_b3 = imem[eip + 5];

eip = eip + 6;

imm_val = {imm_b3, imm_b2, imm_b1, imm_b0};

result = xregs[0] | imm_val;

xregs[0] = result;

flag_CF = 1'b0;
flag_OF = 1'b0;
flag_SF = result[31];
flag_ZF = result == 32'h00000000;
flag_AF = 1'b0;
flag_PF = ~(result[0] ^ result[1] ^ result[2] ^ result[3] ^ result[4] ^ result[5] ^ result[6] ^ result[7]);
