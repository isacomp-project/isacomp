// SPDX-License-Identifier: BSD-3-Clause
// i486 BTR r/m16, r16 (0x0F B3) - Bit Test and Reset
// Test bit in r/m16 (rm), bit index in r16 (reg)
// CF = original bit value, then reset the bit to 0
// OF/SF/ZF/AF/PF undefined

isa_state eip[31:0];
var instr[7:0];
var instr2[7:0];
isa_state modrm[7:0];

// 32-bit register file (lower 16 bits used for 16-bit operations)
isa_state xregs[31:0][2:0];

isa_state imem[7:0][31:0];
isa_state dmem[7:0][31:0];
isa_state flag_CF[0:0];

var mod_bits[1:0];
var reg_idx[2:0];
var rm_bits[2:0];
var base_val[15:0];
var bit_idx[15:0];
var bit_pos[3:0];
var bit_val[0:0];
var result[15:0];

// Fetch first opcode byte
instr = imem[eip];
assume instr == 0x0F;
eip = eip + 1;

// Fetch second opcode byte
instr2 = imem[eip];
assume instr2 == 0xB3;
eip = eip + 1;

// Fetch ModR/M byte
modrm = imem[eip];
eip = eip + 1;

// Decode ModR/M
mod_bits = modrm[7:6];
reg_idx = modrm[5:3];
rm_bits = modrm[2:0];

// Register-direct mode only
assume mod_bits == 0b11;

// Read values (lower 16 bits)
base_val = xregs[rm_bits][15:0];
bit_idx = xregs[reg_idx][15:0];

// Compute bit position (modulo 16)
bit_pos = bit_idx[3:0];

// Extract original bit value
bit_val = base_val[bit_pos];

// Set CF to original bit value
flag_CF = bit_val;

// Reset the bit to 0
result = base_val & ~(16'h0001 << bit_pos);

// Write result (preserve upper 16 bits)
xregs[rm_bits][15:0] = result;

// OF, SF, ZF, AF, PF are undefined (not modified in this implementation)
