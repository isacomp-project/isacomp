// SPDX-License-Identifier: BSD-3-Clause
// i486 JNZ rel8 (0x75) - Jump if Not Zero
isa_state eip[31:0];
var instr[7:0];
isa_state imem[7:0][31:0];
isa_state flag_ZF[0:0];

var rel8[7:0];
var offset[31:0];
var next_pc[31:0];
var jump_target[31:0];

instr = imem[eip];
assume instr == 0x75;

// Fetch rel8 and compute addresses
rel8 = imem[eip + 1];
next_pc = eip + 2;

// Sign-extend rel8 to 32 bits
offset = {{24{rel8[7]}}, rel8};

// Calculate jump target
jump_target = next_pc + offset;

// Condition: ZF=0 means jump
case (flag_ZF) {
  1'b0: eip = jump_target;
  1'b1: eip = next_pc;
}
