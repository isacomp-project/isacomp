// SPDX-License-Identifier: BSD-3-Clause
// i486 LGDT m48 (0x0F 0x01 /2)
// Load Global Descriptor Table Register from memory
// Loads 6 bytes: 2-byte limit, 4-byte base address

isa_state eip[31:0];
var instr[7:0];
var instr2[7:0];
isa_state modrm[7:0];

isa_state xregs[31:0][2:0];
isa_state imem[7:0][31:0];
isa_state dmem[7:0][31:0];

isa_state GDTR_base[31:0];
isa_state GDTR_limit[15:0];

var mod_bits[1:0];
var reg_bits[2:0];
var rm_bits[2:0];
var mem_addr[31:0];
var limit[15:0];
var base[31:0];

// Fetch instruction bytes
instr = imem[eip];
assume instr == 0x0F;
eip = eip + 1;

instr2 = imem[eip];
assume instr2 == 0x01;
eip = eip + 1;

// Fetch ModR/M byte
modrm = imem[eip];
eip = eip + 1;

// Decode ModR/M
mod_bits = modrm[7:6];
reg_bits = modrm[5:3];
rm_bits = modrm[2:0];

// Must be /2 (reg field = 2)
assume reg_bits == 3'b010;

// Memory mode (not register-direct)
assume mod_bits != 0b11;

// Direct addressing mode (mod=00, rm=110)
assume mod_bits == 0b00;
assume rm_bits == 0b110;

// Read displacement (direct address)
mem_addr[7:0] = imem[eip];
eip = eip + 1;
mem_addr[15:8] = imem[eip];
eip = eip + 1;
mem_addr[23:16] = imem[eip];
eip = eip + 1;
mem_addr[31:24] = imem[eip];
eip = eip + 1;

// Load 6 bytes from memory: limit (2 bytes) + base (4 bytes)
limit[7:0] = dmem[mem_addr];
limit[15:8] = dmem[mem_addr + 1];
base[7:0] = dmem[mem_addr + 2];
base[15:8] = dmem[mem_addr + 3];
base[23:16] = dmem[mem_addr + 4];
base[31:24] = dmem[mem_addr + 5];

// Load into GDTR
GDTR_limit = limit;
GDTR_base = base;
