// SPDX-License-Identifier: BSD-3-Clause
// i486 SAHF (0x9E)
// Store AH to flags (SF, ZF, AF, PF, CF)
// SF=AH[7], ZF=AH[6], AF=AH[4], PF=AH[2], CF=AH[0]

isa_state eip[31:0];
var instr[7:0];

// 32-bit register file: EAX(0), ECX(1), EDX(2), EBX(3), ESP(4), EBP(5), ESI(6), EDI(7)
isa_state xregs[31:0][2:0];

// AH register alias (high byte of low word of EAX)
isa_state AH[7:0] of xregs[0][15:8];

isa_state imem[7:0][31:0];
isa_state dmem[7:0][31:0];

// Individual flags
isa_state flag_CF[0:0];  // Bit 0
isa_state flag_PF[0:0];  // Bit 2
isa_state flag_AF[0:0];  // Bit 4
isa_state flag_ZF[0:0];  // Bit 6
isa_state flag_SF[0:0];  // Bit 7

// Fetch instruction
instr = imem[eip];
assume instr == 0x9E;
eip = eip + 1;

// Store AH to flags
flag_SF = AH[7];
flag_ZF = AH[6];
flag_AF = AH[4];
flag_PF = AH[2];
flag_CF = AH[0];
// Note: AH[5], AH[3], and AH[1] are ignored
