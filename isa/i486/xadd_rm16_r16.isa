// SPDX-License-Identifier: BSD-3-Clause
// i486 XADD r/m16, r16 (0x0F C1 with 66h prefix in 32-bit mode, or without in 16-bit mode)
// Exchange and add: temp=dest, dest=dest+src, src=temp
// Sets all arithmetic flags (CF, PF, AF, ZF, SF, OF)
// i486-specific instruction

isa_state eip[31:0];
var instr[7:0];
var instr2[7:0];
isa_state modrm[7:0];

// 32-bit register file: EAX(0), ECX(1), EDX(2), EBX(3), ESP(4), EBP(5), ESI(6), EDI(7)
isa_state xregs[31:0][2:0];

// 16-bit register views
isa_state AX[15:0] of xregs[0][15:0];
isa_state CX[15:0] of xregs[1][15:0];
isa_state DX[15:0] of xregs[2][15:0];
isa_state BX[15:0] of xregs[3][15:0];
isa_state SP[15:0] of xregs[4][15:0];
isa_state BP[15:0] of xregs[5][15:0];
isa_state SI[15:0] of xregs[6][15:0];
isa_state DI[15:0] of xregs[7][15:0];

isa_state imem[7:0][31:0];
isa_state dmem[7:0][31:0];
isa_state flag_CF[0:0];
isa_state flag_PF[0:0];
isa_state flag_AF[0:0];
isa_state flag_ZF[0:0];
isa_state flag_SF[0:0];
isa_state flag_OF[0:0];

var mod_bits[1:0];
var reg_bits[2:0];
var rm_bits[2:0];
var dest_val[15:0];
var src_val[15:0];
var temp[15:0];
var result[16:0];

// Fetch first byte of instruction
instr = imem[eip];
assume instr == 0x0F;
eip = eip + 1;

// Fetch second byte
instr2 = imem[eip];
assume instr2 == 0xC1;
eip = eip + 1;

// Fetch ModR/M byte
modrm = imem[eip];
eip = eip + 1;

// Decode ModR/M
mod_bits = modrm[7:6];
reg_bits = modrm[5:3];
rm_bits = modrm[2:0];

// Register-direct mode
assume mod_bits == 0b11;

// Read operands (16-bit registers)
dest_val = xregs[rm_bits][15:0];
src_val = xregs[reg_bits][15:0];

// Save destination in temp
temp = dest_val;

// Compute sum
result = dest_val + src_val;

// dest = dest + src (preserve upper 16 bits)
xregs[rm_bits][15:0] = result[15:0];

// src = old dest (preserve upper 16 bits)
xregs[reg_bits][15:0] = temp;

// Set arithmetic flags
flag_CF = result[16];
flag_ZF = result[15:0] == 0 ? 1'b1 : 1'b0;
flag_SF = result[15];
flag_OF = (dest_val[15] == src_val[15]) & (dest_val[15] != result[15]);
flag_PF = ~(result[0] ^ result[1] ^ result[2] ^ result[3] ^ result[4] ^ result[5] ^ result[6] ^ result[7]);
flag_AF = (dest_val[3:0] + src_val[3:0]) > 4'hF;
