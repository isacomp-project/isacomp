// i486 STI (0xFB)
// Set interrupt flag

isa_state eip[31:0];
var instr[7:0];
isa_state imem[7:0][31:0];
isa_state dmem[7:0][31:0];
isa_state DS[15:0];            // Data segment register
isa_state flag_IF[0:0];

instr = imem[eip];
assume instr == 0xFB;
eip = eip + 1;

// Set interrupt flag (enable interrupts)
flag_IF = 1'b1;
