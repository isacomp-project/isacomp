// SPDX-License-Identifier: BSD-3-Clause
// i486 IMUL r32, r/m32, imm32 with 66 prefix (0x66 0x69)
// Three-operand signed multiply: r32 = r/m32 * imm32
// Sets CF/OF on overflow (result doesn't fit in 32 bits)
// SF, ZF, AF, PF are undefined

isa_state eip[31:0];
var prefix[7:0];
var instr[7:0];
isa_state modrm[7:0];

// 32-bit register file: EAX(0), ECX(1), EDX(2), EBX(3), ESP(4), EBP(5), ESI(6), EDI(7)
isa_state xregs[31:0][2:0];

isa_state imem[7:0][31:0];
isa_state dmem[7:0][31:0];
isa_state flag_CF[0:0];
isa_state flag_OF[0:0];

var mod_bits[1:0];
var reg_bits[2:0];
var rm_bits[2:0];
var src_val[31:0];
var imm_b0[7:0];
var imm_b1[7:0];
var imm_b2[7:0];
var imm_b3[7:0];
var imm_val[31:0];
var result[63:0];
var sign_extend[63:0];

// Fetch 0x66 prefix
prefix = imem[eip];
assume prefix == 0x66;

// Fetch instruction
instr = imem[eip + 1];
assume instr == 0x69;

// Fetch ModR/M byte
modrm = imem[eip + 2];

// Decode ModR/M
mod_bits = modrm[7:6];
reg_bits = modrm[5:3];
rm_bits = modrm[2:0];

// Register-direct mode
assume mod_bits == 0b11;

// Read source register
src_val = xregs[rm_bits];

// Read immediate value (little-endian: low byte first)
imm_b0 = imem[eip + 3];
imm_b1 = imem[eip + 4];
imm_b2 = imem[eip + 5];
imm_b3 = imem[eip + 6];

// Advance EIP (prefix + opcode + modrm + 4-byte immediate)
eip = eip + 7;

// Combine bytes into 32-bit immediate
imm_val = {imm_b3, imm_b2, imm_b1, imm_b0};

// Perform signed multiply: result = src * imm
result = src_val * imm_val;

// Store low 32 bits in destination register
xregs[reg_bits] = result[31:0];

// Set flags: CF and OF set if sign extension of result doesn't fit in 32 bits
// Sign extend the low 32 bits to 64 bits
sign_extend = result[31] ? {32'hFFFFFFFF, result[31:0]} : {32'h00000000, result[31:0]};

flag_CF = (result != sign_extend);
flag_OF = (result != sign_extend);
