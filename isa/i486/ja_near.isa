// SPDX-License-Identifier: BSD-3-Clause
// i486 JA rel16 (0x0F 0x87) - Real mode
// Jump if Above (CF=0 AND ZF=0) - near jump with 16-bit displacement in real mode

isa_state eip[31:0];
var prefix[7:0];
var instr[7:0];
isa_state imem[7:0][31:0];
isa_state flag_CF[0:0];
isa_state flag_ZF[0:0];

var offset_b0[7:0];
var offset_b1[7:0];
var signed_offset[31:0];
var target_addr[31:0];
var next_eip[31:0];

// Fetch 0x0F prefix
prefix = imem[eip];
assume prefix == 0x0F;

// Fetch instruction
instr = imem[eip + 1];
assume instr == 0x87;

// Read 16-bit signed displacement (little-endian) for real mode
offset_b0 = imem[eip + 2];
offset_b1 = imem[eip + 3];

// Sign-extend 16-bit offset to 32 bits
signed_offset = {{16{offset_b1[7]}}, offset_b1, offset_b0};

// EIP after fetching the instruction (2-byte opcode + 2-byte displacement)
next_eip = eip + 4;

// Calculate target address (next_eip + signed offset)
target_addr = next_eip + signed_offset;

// Jump if condition is true, else advance past instruction
eip = (flag_CF == 1'b0) && (flag_ZF == 1'b0) ? target_addr : next_eip;
