// SPDX-License-Identifier: BSD-3-Clause
// i486 REPNE SCASB (0xF2 0xAE)
// Repeat while not equal: scan bytes, decrement ECX (simplified - execute once)

isa_state eip[31:0];
var prefix[7:0];
var instr[7:0];

// 32-bit register file
isa_state xregs[31:0][2:0];

// Register aliases
isa_state AL[7:0] of xregs[0][7:0];
isa_state EDI[31:0] of xregs[7];
isa_state ECX[31:0] of xregs[1];

isa_state imem[7:0][31:0];
isa_state dmem[7:0][31:0];
isa_state flag_DF[0:0];
isa_state flag_CF[0:0];
isa_state flag_PF[0:0];
isa_state flag_AF[0:0];
isa_state flag_ZF[0:0];
isa_state flag_SF[0:0];
isa_state flag_OF[0:0];

var mem_byte[7:0];
var result[8:0];
var new_edi[31:0];

// Fetch REPNE prefix
prefix = imem[eip];
assume prefix == 0xF2;
eip = eip + 1;

// Fetch instruction
instr = imem[eip];
assume instr == 0xAE;
eip = eip + 1;

// Simplified: assume ECX > 0, execute once
assume xregs[1] != 32'h00000000;

// Load byte from [EDI]
mem_byte = dmem[EDI];

// Compare: AL - mem_byte
result = AL - mem_byte;

// Set flags
flag_CF = result[8];
flag_ZF = result[7:0] == 8'h00;
flag_SF = result[7];
flag_OF = (AL[7] != mem_byte[7]) & (AL[7] != result[7]);
flag_PF = ~(result[0] ^ result[1] ^ result[2] ^ result[3] ^ result[4] ^ result[5] ^ result[6] ^ result[7]);
flag_AF = AL[3:0] < mem_byte[3:0];

// Adjust EDI based on direction flag
new_edi = flag_DF == 1'b0 ? EDI + 1 : EDI - 1;
EDI = new_edi;

// Decrement ECX
ECX = ECX - 1;
