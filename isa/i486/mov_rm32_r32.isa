// SPDX-License-Identifier: BSD-3-Clause
// i486 MOV r/m32, r32 (0x89) - ALL ADDRESSING MODES
// In real mode, uses 16-bit addressing with 32-bit operands
// Move r32 to r/m32

isa_state xregs[31:0][2:0];
isa_state eip[31:0];
var instr[7:0];
isa_state modrm[7:0];
var mod_bits[1:0];
var reg_idx[2:0];
var rm_bits[2:0];
isa_state imem[7:0][31:0];
isa_state dmem[7:0][31:0];
isa_state DS[15:0];

var src_idx[2:0];
var dst_reg_idx[2:0];
var addr_reg_idx[2:0];
var base_offset[15:0];
var disp8[7:0];
var disp16_lo[7:0];
var disp16_hi[7:0];
var disp16[15:0];
var signed_disp8[15:0];
var offset[15:0];
var physical_addr[19:0];
var physical_addr_1[19:0];
var physical_addr_2[19:0];
var physical_addr_3[19:0];
var src_val[31:0];
var is_mem_dest[0:0];

instr = imem[eip];
assume instr == 0x89;

modrm = imem[eip + 1];

mod_bits = modrm[7:6];
reg_idx = modrm[5:3];
rm_bits = modrm[2:0];

src_idx = reg_idx;
dst_reg_idx = rm_bits;

src_val = xregs[src_idx];

case (rm_bits) {
  3'b100: addr_reg_idx = 3'b110;
  3'b101: addr_reg_idx = 3'b111;
  3'b111: addr_reg_idx = 3'b011;
}

base_offset = xregs[addr_reg_idx][15:0];

disp8 = imem[eip + 2];
disp16_lo = imem[eip + 2];
disp16_hi = imem[eip + 3];
disp16 = {disp16_hi, disp16_lo};
signed_disp8 = {{8{disp8[7]}}, disp8};

case (mod_bits) {
  2'b00: offset = base_offset;
  2'b01: offset = base_offset + signed_disp8;
  2'b10: offset = base_offset + disp16;
  2'b11: offset = 16'h0000;
}

case (mod_bits) {
  2'b00: is_mem_dest = 1'b1;
  2'b01: is_mem_dest = 1'b1;
  2'b10: is_mem_dest = 1'b1;
  2'b11: is_mem_dest = 1'b0;
}

case (mod_bits) {
  2'b00: eip = eip + 2;
  2'b01: eip = eip + 3;
  2'b10: eip = eip + 4;
  2'b11: eip = eip + 2;
}

physical_addr = ({4'b0000, DS} << 4) + {4'b0000, offset};
physical_addr_1 = physical_addr + 20'h00001;
physical_addr_2 = physical_addr + 20'h00002;
physical_addr_3 = physical_addr + 20'h00003;

// Write source to destination
case (is_mem_dest) {
  1'b1: dmem[physical_addr] = src_val[7:0];
  1'b0: xregs[dst_reg_idx] = src_val;
}

case (is_mem_dest) {
  1'b1: dmem[physical_addr_1] = src_val[15:8];
  1'b0: xregs[dst_reg_idx] = src_val;
}

case (is_mem_dest) {
  1'b1: dmem[physical_addr_2] = src_val[23:16];
  1'b0: xregs[dst_reg_idx] = src_val;
}

case (is_mem_dest) {
  1'b1: dmem[physical_addr_3] = src_val[31:24];
  1'b0: xregs[dst_reg_idx] = src_val;
}

// MOV does not affect flags
