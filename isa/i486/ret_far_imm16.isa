// SPDX-License-Identifier: BSD-3-Clause
// i486 RETF imm16 (0xCA)
// Far return and pop imm16 bytes from stack
isa_state eip[31:0];
var instr[7:0];
isa_state imem[7:0][31:0];
isa_state dmem[7:0][31:0];
isa_state xregs[31:0][2:0];
isa_state SS[15:0];
isa_state CS[15:0];

var imm_lo[7:0];
var imm_hi[7:0];
var imm16[15:0];
var old_sp[15:0];
var new_sp[15:0];
var esp_upper[15:0];
var ret_addr_lo[7:0];
var ret_addr_hi[7:0];
var ret_addr[15:0];
var ret_cs_lo[7:0];
var ret_cs_hi[7:0];
var ret_cs[15:0];
var phys_addr[19:0];

instr = imem[eip];
assume instr == 0xCA;

// Read immediate operand
imm_lo = imem[eip + 1];
imm_hi = imem[eip + 2];
imm16 = {imm_hi, imm_lo};

// Get current stack pointer and preserve upper bits
old_sp = xregs[4][15:0];
esp_upper = xregs[4][31:16];

// Pop return address from stack
phys_addr = (SS << 4) + old_sp;
ret_addr_lo = dmem[phys_addr];
ret_addr_hi = dmem[phys_addr + 1];
ret_addr = {ret_addr_hi, ret_addr_lo};

// Pop return CS from stack
ret_cs_lo = dmem[phys_addr + 2];
ret_cs_hi = dmem[phys_addr + 3];
ret_cs = {ret_cs_hi, ret_cs_lo};

// Update stack pointer (pop return address + CS + imm16 bytes)
new_sp = old_sp + 16'h0004 + imm16;
xregs[4] = {esp_upper, new_sp};

// Update CS and jump to return address
CS = ret_cs;
eip = {16'h0000, ret_addr};
