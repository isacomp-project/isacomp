// SPDX-License-Identifier: BSD-3-Clause
// i486 MOV r32, CR2 (0x0F 0x20 /2)
// Move Control Register 2 to r32 (Page Fault Linear Address)
// Stores CR2 value into general-purpose register

isa_state eip[31:0];
var instr[7:0];
var instr2[7:0];
isa_state modrm[7:0];

isa_state xregs[31:0][2:0];
isa_state imem[7:0][31:0];
isa_state dmem[7:0][31:0];

isa_state CR2[31:0];

var mod_bits[1:0];
var reg_bits[2:0];
var rm_bits[2:0];

// Fetch instruction bytes
instr = imem[eip];
assume instr == 0x0F;
eip = eip + 1;

instr2 = imem[eip];
assume instr2 == 0x20;
eip = eip + 1;

// Fetch ModR/M byte
modrm = imem[eip];
eip = eip + 1;

// Decode ModR/M
mod_bits = modrm[7:6];
reg_bits = modrm[5:3];
rm_bits = modrm[2:0];

// Must be /2 (reg field = 2 for CR2)
assume reg_bits == 3'b010;

// Must be register mode
assume mod_bits == 0b11;

// Store CR2 into general-purpose register
xregs[rm_bits] = CR2;
