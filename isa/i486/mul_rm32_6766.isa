// SPDX-License-Identifier: BSD-3-Clause
// i486 MUL r/m32 with 6766 prefix (0x67 0x66 0xF7 /4)
// 32-bit addressing mode + 32-bit operand size
// Unsigned multiply EAX by r/m32, result in EDX:EAX

isa_state eip[31:0];
var prefix67[7:0];
var prefix[7:0];
var instr[7:0];
isa_state modrm[7:0];

isa_state xregs[31:0][2:0];
isa_state imem[7:0][31:0];
isa_state dmem[7:0][31:0];
isa_state DS[15:0];
isa_state flag_CF[0:0];
isa_state flag_OF[0:0];

var mod_bits[1:0];
var reg_bits[2:0];
var rm_bits[2:0];
var base_val[31:0];
var disp8[7:0];
var disp32[31:0];
var signed_disp8[31:0];
var offset[31:0];
var physical_addr[31:0];
var physical_addr_1[31:0];
var physical_addr_2[31:0];
var physical_addr_3[31:0];
var src_mem_val_b0[7:0];
var src_mem_val_b1[7:0];
var src_mem_val_b2[7:0];
var src_mem_val_b3[7:0];
var src_mem_val[31:0];
var src_reg_val[31:0];
var src_val[31:0];
var eax_val[31:0];
var result[63:0];
var is_mem_src[0:0];

prefix67 = imem[eip];
assume prefix67 == 0x67;

prefix = imem[eip + 1];
assume prefix == 0x66;

instr = imem[eip + 2];
assume instr == 0xF7;

modrm = imem[eip + 3];

mod_bits = modrm[7:6];
reg_bits = modrm[5:3];
rm_bits = modrm[2:0];

assume reg_bits == 0b100;

base_val = xregs[rm_bits];

// Read displacement bytes
disp8 = imem[eip + 4];
disp32 = {imem[eip + 7], imem[eip + 6], imem[eip + 5], imem[eip + 4]};
signed_disp8 = {{24{disp8[7]}}, disp8};

// Calculate offset based on addressing mode
case (mod_bits) {
  2'b00: offset = base_val;
  2'b01: offset = base_val + signed_disp8;
  2'b10: offset = base_val + disp32;
  2'b11: offset = 32'h00000000;
}

// Set source type flag
case (mod_bits) {
  2'b00: is_mem_src = 1'b1;
  2'b01: is_mem_src = 1'b1;
  2'b10: is_mem_src = 1'b1;
  2'b11: is_mem_src = 1'b0;
}

// Update EIP: prefix67(1) + prefix(1) + opcode(1) + modrm(1) + disp
case (mod_bits) {
  2'b00: eip = eip + 4;   // 67+66+op+modrm
  2'b01: eip = eip + 5;   // 67+66+op+modrm+disp8
  2'b10: eip = eip + 8;   // 67+66+op+modrm+disp32
  2'b11: eip = eip + 4;   // 67+66+op+modrm
}

// Calculate physical address for memory modes
physical_addr = ({16'h0000, DS} << 4) + offset;
physical_addr_1 = physical_addr + 32'h00000001;
physical_addr_2 = physical_addr + 32'h00000002;
physical_addr_3 = physical_addr + 32'h00000003;

// Read source values
src_mem_val_b0 = dmem[physical_addr];
src_mem_val_b1 = dmem[physical_addr_1];
src_mem_val_b2 = dmem[physical_addr_2];
src_mem_val_b3 = dmem[physical_addr_3];
src_mem_val = {src_mem_val_b3, src_mem_val_b2, src_mem_val_b1, src_mem_val_b0};
src_reg_val = xregs[rm_bits];

case (is_mem_src) {
  1'b1: src_val = src_mem_val;
  1'b0: src_val = src_reg_val;
}

eax_val = xregs[0];

// Unsigned 32x32->64 multiplication
result = eax_val * src_val;

// Store result: low 32 in EAX, high 32 in EDX
xregs[0] = result[31:0];
xregs[2] = result[63:32];

// CF and OF set if upper half is non-zero
flag_CF = result[63:32] != 32'h0;
flag_OF = result[63:32] != 32'h0;
