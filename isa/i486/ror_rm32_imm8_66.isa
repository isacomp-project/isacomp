// SPDX-License-Identifier: BSD-3-Clause
// i486 ROR r/m32, imm8 with 66 prefix (0x66 0xC1 /1)
// Rotate Right by immediate byte

isa_state eip[31:0];
var prefix[7:0];
var instr[7:0];
isa_state modrm[7:0];
var imm8[7:0];

// 32-bit register file
isa_state xregs[31:0][2:0];

isa_state imem[7:0][31:0];
isa_state dmem[7:0][31:0];
isa_state flag_CF[0:0];
isa_state flag_OF[0:0];

var mod_bits[1:0];
var reg_bits[2:0];
var rm_bits[2:0];
var dst_val[31:0];
var count[4:0];
var result[31:0];

// Fetch 0x66 prefix
prefix = imem[eip];
assume prefix == 0x66;

// Fetch instruction
instr = imem[eip + 1];
assume instr == 0xC1;

// Fetch ModR/M byte
modrm = imem[eip + 2];

// Decode ModR/M
mod_bits = modrm[7:6];
reg_bits = modrm[5:3];
rm_bits = modrm[2:0];

// Verify this is ROR (reg_bits = 001)
assume reg_bits == 0b001;

// Register-direct mode
assume mod_bits == 0b11;

// Fetch immediate byte
imm8 = imem[eip + 3];

// Advance EIP (prefix + opcode + modrm + imm8)
eip = eip + 4;

// Read destination value
dst_val = xregs[rm_bits];

// Get count from immediate, masked to 5 bits for 32-bit operands
count = imm8[4:0];

// Perform rotate right
result = (dst_val >> count) | (dst_val << (32 - count));

// Write result
xregs[rm_bits] = result;

// Update flags if count != 0
flag_CF = count == 0 ? flag_CF : result[31];
flag_OF = count == 1 ? (result[31] ^ result[30]) : flag_OF;
