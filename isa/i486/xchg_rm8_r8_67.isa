// SPDX-License-Identifier: BSD-3-Clause
// i486 67-prefix XCHG r/m8, r8 (0x86) - CONSOLIDATED ALL ADDRESSING MODES

isa_state lregs[7:0][1:0] of xregs[0b0**][7:0];
isa_state hregs[7:0][1:0] of xregs[0b0**][15:8];
isa_state xregs[31:0][2:0];
isa_state eip[31:0];
var prefix[7:0];
var instr[7:0];
isa_state modrm[7:0];
var mod_bits[1:0];
var reg_bits[2:0];
var rm_bits[2:0];
isa_state imem[7:0][31:0];
isa_state dmem[7:0][31:0];
isa_state DS[15:0];

var src_reg_idx[1:0];
var dst_reg_idx[2:0];
var addr_reg_idx[2:0];
var base_val[31:0];
var disp8[7:0];
var disp16_lo[7:0];
var disp16_hi[7:0];
var disp16[15:0];
var disp32_b0[7:0];
var disp32_b1[7:0];
var disp32_b2[7:0];
var disp32_b3[7:0];
var disp32[31:0];
var signed_disp8[31:0];
var offset[31:0];
var physical_addr[31:0];
var dst_mem_val[7:0];
var dst_reg_val_low[7:0];
var dst_reg_val_high[7:0];
var dst_reg_val[7:0];
var dst_val[7:0];
var src_reg_val_low[7:0];
var src_reg_val_high[7:0];
var src_reg_val[7:0];
var src_val[7:0];
var temp[15:0];
var is_mem_dst[0:0];
var write_to_mem[0:0];
var write_to_dst_hreg[0:0];
var write_to_dst_lreg[0:0];
var write_to_src_hreg[0:0];
var write_to_src_lreg[0:0];

prefix = imem[eip];
assume prefix == 0x67;

instr = imem[eip + 1];
assume instr == 0x86;

modrm = imem[eip + 2];

mod_bits = modrm[7:6];
reg_bits = modrm[5:3];
rm_bits = modrm[2:0];

src_reg_idx = reg_bits[1:0];  // Source register from reg field
dst_reg_idx = rm_bits[1:0];   // Dest register from r/m field

case (rm_bits) {
  0b100: addr_reg_idx = 3'b110;
  0b101: addr_reg_idx = 3'b111;
  0b111: addr_reg_idx = 3'b011;
}

base_val = xregs[rm_bits];

disp8 = imem[eip + 3];
disp32_b0 = imem[eip + 3];
disp32_b1 = imem[eip + 4];
disp32_b2 = imem[eip + 5];
disp32_b3 = imem[eip + 6];
disp32 = {disp32_b3, disp32_b2, disp32_b1, disp32_b0};
signed_disp8 = {{24{disp8[7]}}, disp8};

case (mod_bits) {
  0b00: offset = base_val;
  0b01: offset = base_val + signed_disp8;
  0b10: offset = base_val + disp32;
  0b11: offset = 16'h0000;
}

case (mod_bits) {
  0b00: is_mem_dst = 1'b1;
  0b01: is_mem_dst = 1'b1;
  0b10: is_mem_dst = 1'b1;
  0b11: is_mem_dst = 1'b0;
}

case (mod_bits) {
  2'b00: eip = eip + 3;
  2'b01: eip = eip + 4;
  2'b10: eip = eip + 7;
  2'b11: eip = eip + 3;
}

physical_addr = ({16'h0000, DS} << 4) + offset;

// Read destination value
dst_mem_val = dmem[physical_addr];
dst_reg_val_low = lregs[dst_reg_idx];
dst_reg_val_high = hregs[dst_reg_idx];

case (rm_bits[2]) {
  1'b1: dst_reg_val = dst_reg_val_high;
  1'b0: dst_reg_val = dst_reg_val_low;
}

case (is_mem_dst) {
  1'b1: dst_val = dst_mem_val;
  1'b0: dst_val = dst_reg_val;
}

// Read source value (always a register)
src_reg_val_low = lregs[src_reg_idx];
src_reg_val_high = hregs[src_reg_idx];

case (reg_bits[2]) {
  1'b1: src_reg_val = src_reg_val_high;
  1'b0: src_reg_val = src_reg_val_low;
}

src_val = src_reg_val;

// Swap: temp = dst, dst = src, src = temp
temp = dst_val;

// Determine write targets
case (is_mem_dst) {
  1'b1: write_to_mem = 1'b1;
  1'b0: write_to_mem = 1'b0;
}

case (is_mem_dst) {
  1'b1: write_to_dst_hreg = 1'b0;
  1'b0: write_to_dst_hreg = rm_bits[2];
}

case (is_mem_dst) {
  1'b1: write_to_dst_lreg = 1'b0;
  1'b0: write_to_dst_lreg = ~rm_bits[2];
}

// Source is always a register
write_to_src_hreg = reg_bits[2];
write_to_src_lreg = ~reg_bits[2];

// Write src_val to destination
case (write_to_mem) {
  1'b1: dmem[physical_addr] = src_val[7:0];
  1'b0: dmem[physical_addr] = dmem[physical_addr];
}

case (write_to_dst_hreg) {
  1'b1: hregs[dst_reg_idx] = src_val[7:0];
  1'b0: hregs[dst_reg_idx] = hregs[dst_reg_idx];
}

case (write_to_dst_lreg) {
  1'b1: lregs[dst_reg_idx] = src_val[7:0];
  1'b0: lregs[dst_reg_idx] = lregs[dst_reg_idx];
}

// Write temp (original dst) to source register
case (write_to_src_hreg) {
  1'b1: hregs[src_reg_idx] = temp[7:0];
  1'b0: hregs[src_reg_idx] = hregs[src_reg_idx];
}

case (write_to_src_lreg) {
  1'b1: lregs[src_reg_idx] = temp[7:0];
  1'b0: lregs[src_reg_idx] = lregs[src_reg_idx];
}
// No flags affected by XCHG
