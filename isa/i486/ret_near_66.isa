// SPDX-License-Identifier: BSD-3-Clause
// i486 RET near with 66 prefix (0x66 0xC3)
// Return from procedure

isa_state eip[31:0];
var prefix[7:0];
var instr[7:0];

isa_state xregs[31:0][2:0];
isa_state imem[7:0][31:0];
isa_state dmem[7:0][31:0];

var esp_val[31:0];
var ret_addr_b0[7:0];
var ret_addr_b1[7:0];
var ret_addr_b2[7:0];
var ret_addr_b3[7:0];
var ret_addr[31:0];

prefix = imem[eip];
assume prefix == 0x66;

instr = imem[eip + 1];
assume instr == 0xC3;

// Read ESP
esp_val = xregs[4];

// Pop 32-bit return address from stack
ret_addr_b0 = dmem[esp_val];
ret_addr_b1 = dmem[esp_val + 1];
ret_addr_b2 = dmem[esp_val + 2];
ret_addr_b3 = dmem[esp_val + 3];
ret_addr = {ret_addr_b3, ret_addr_b2, ret_addr_b1, ret_addr_b0};

// Update ESP (pop 4 bytes)
xregs[4] = esp_val + 4;

// Jump to return address
eip = ret_addr;
