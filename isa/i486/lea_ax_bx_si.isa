// SPDX-License-Identifier: BSD-3-Clause
// i486 LEA AX, [BX+SI] (0x8D with modrm 0x00) - WITH PROPER SEGMENTATION
// Load Effective Address - computes offset [BX+SI] and stores in AX
// Does NOT access memory, just calculates the offset portion of the address
// Note: LEA never applies segment registers - it only calculates offsets

isa_state eip[31:0];
var instr[7:0];
isa_state modrm[7:0];
isa_state xregs[31:0][2:0];
isa_state imem[7:0][31:0];
isa_state dmem[7:0][31:0];

var bx_val[15:0];
var si_val[15:0];
var effective_addr[15:0];

instr = imem[eip];
assume instr == 0x8D;
eip = eip + 1;

modrm = imem[eip];
assume modrm == 0x00;  // mod=00, reg=000 (AX), rm=000 (BX+SI)
eip = eip + 1;

// Read BX (xregs[3]) and SI (xregs[6]) - use 16-bit views
bx_val = xregs[3][15:0];
si_val = xregs[6][15:0];

// Calculate effective address (just the 16-bit offset, not accessing memory)
effective_addr = bx_val + si_val;

// Store offset in AX (xregs[0]) - only update lower 16 bits
xregs[0][15:0] = effective_addr;
