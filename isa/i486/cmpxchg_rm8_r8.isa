// SPDX-License-Identifier: BSD-3-Clause
// i486 CMPXCHG r/m8, r8 (0x0F B0)
// Compare AL with r/m8; if equal, load src into dest and set ZF
// Otherwise, load dest into AL and clear ZF
// Sets all arithmetic flags (CF, PF, AF, ZF, SF, OF) based on comparison
// i486-specific instruction

isa_state eip[31:0];
var instr[7:0];
var instr2[7:0];
isa_state modrm[7:0];

// 32-bit register file: EAX(0), ECX(1), EDX(2), EBX(3), ESP(4), EBP(5), ESI(6), EDI(7)
isa_state xregs[31:0][2:0];

// Register alias for AL
isa_state AL[7:0] of xregs[0][7:0];

// 8-bit register arrays using wildcard syntax
isa_state lregs[7:0][1:0] of xregs[0b0**][7:0];   // AL,CL,DL,BL (low bytes)
isa_state hregs[7:0][1:0] of xregs[0b0**][15:8];  // AH,CH,DH,BH (high bytes)

isa_state imem[7:0][31:0];
isa_state dmem[7:0][31:0];
isa_state flag_CF[0:0];
isa_state flag_PF[0:0];
isa_state flag_AF[0:0];
isa_state flag_ZF[0:0];
isa_state flag_SF[0:0];
isa_state flag_OF[0:0];

var mod_bits[1:0];
var reg_bits[2:0];
var rm_bits[2:0];
var dest_idx[1:0];
var src_idx[1:0];
var dest_val_low[7:0];
var dest_val_high[7:0];
var src_val_low[7:0];
var src_val_high[7:0];
var dest_val[7:0];
var src_val[7:0];
var cmp_result[8:0];
var is_equal[0:0];

// Fetch first byte of instruction
instr = imem[eip];
assume instr == 0x0F;
eip = eip + 1;

// Fetch second byte
instr2 = imem[eip];
assume instr2 == 0xB0;
eip = eip + 1;

// Fetch ModR/M byte
modrm = imem[eip];
eip = eip + 1;

// Decode ModR/M
mod_bits = modrm[7:6];
reg_bits = modrm[5:3];
rm_bits = modrm[2:0];

// Register-direct mode
assume mod_bits == 0b11;

// Get register indices
dest_idx = rm_bits[1:0];
src_idx = reg_bits[1:0];

// Read both low and high byte values
dest_val_low = lregs[dest_idx];
dest_val_high = hregs[dest_idx];
src_val_low = lregs[src_idx];
src_val_high = hregs[src_idx];

// Select based on high/low bit (bit[2] of register encoding)
case (rm_bits[2]) {
    1'b0: dest_val = dest_val_low;
    1'b1: dest_val = dest_val_high;
}
case (reg_bits[2]) {
    1'b0: src_val = src_val_low;
    1'b1: src_val = src_val_high;
}

// Compare AL with destination
cmp_result = AL - dest_val;
is_equal = AL == dest_val ? 1'b1 : 1'b0;

// Set flags based on comparison (same as SUB)
flag_CF = (AL < dest_val);
flag_ZF = (cmp_result[7:0] == 0);
flag_SF = cmp_result[7];
flag_OF = (AL[7] != dest_val[7]) & (AL[7] != cmp_result[7]);
flag_PF = ~(cmp_result[0] ^ cmp_result[1] ^ cmp_result[2] ^ cmp_result[3] ^ cmp_result[4] ^ cmp_result[5] ^ cmp_result[6] ^ cmp_result[7]);
flag_AF = (AL[3:0] < dest_val[3:0]);

// If equal (ZF=1), load src into dest
// If not equal (ZF=0), load dest into AL
// For dest (write src_val when equal)
case (rm_bits[2]) {
    1'b0: lregs[dest_idx] = is_equal ? src_val : dest_val_low;
    1'b1: hregs[dest_idx] = is_equal ? src_val : dest_val_high;
}

// For AL (write dest_val when not equal)
AL = is_equal ? AL : dest_val;
