// SPDX-License-Identifier: BSD-3-Clause
// i486 LODSW with 67 prefix (0x67 0xAD) - 32-bit addressing mode
// Load [ESI] to AX with 32-bit addressing

isa_state eip[31:0];
var prefix[7:0];
var instr[7:0];

isa_state xregs[31:0][2:0];
isa_state DS[15:0];

isa_state imem[7:0][31:0];
isa_state dmem[7:0][31:0];
isa_state flag_DF[0:0];

var src_addr[31:0];
var b0[7:0];
var b1[7:0];

prefix = imem[eip];
assume prefix == 0x67;

instr = imem[eip + 1];
assume instr == 0xAD;

src_addr = (DS << 4) + xregs[6];

b0 = dmem[src_addr];
b1 = dmem[src_addr + 1];
xregs[0] = {xregs[0][31:16], b1, b0};

case (flag_DF) {
  1'b0: xregs[6] = xregs[6] + 32'h00000002;
  1'b1: xregs[6] = xregs[6] - 32'h00000002;
}

eip = eip + 2;
