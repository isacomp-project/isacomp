// SPDX-License-Identifier: BSD-3-Clause
// i486 MOV r32, r32 (0x89/0x8B with ModR/M mod=11)
// Move register to register (register-direct mode)

isa_state eip[31:0];
var instr[7:0];
isa_state modrm[7:0];

// 32-bit register file: EAX(0), ECX(1), EDX(2), EBX(3), ESP(4), EBP(5), ESI(6), EDI(7)
isa_state xregs[31:0][2:0];

isa_state imem[7:0][31:0];
isa_state dmem[7:0][31:0];

var mod_bits[1:0];
var reg_idx[2:0];
var rm_bits[2:0];
var src_val[31:0];

// Fetch instruction (0x89 = MOV r/m32, r32)
instr = imem[eip];
assume instr == 0x89;
eip = eip + 1;

// Fetch ModR/M byte
modrm = imem[eip];
eip = eip + 1;

// Decode ModR/M
mod_bits = modrm[7:6];
reg_idx = modrm[5:3];   // Source register
rm_bits = modrm[2:0];   // Destination register

// Register-direct mode
assume mod_bits == 0b11;

// Read source register value
src_val = xregs[reg_idx];

// Move to destination register
xregs[rm_bits] = src_val;

// MOV does not affect flags
