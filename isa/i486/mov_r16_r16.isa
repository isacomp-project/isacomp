// SPDX-License-Identifier: BSD-3-Clause
// i486 MOV r16, r16 - Parameterized with wildcard ** syntax
// Opcode: 0x89 + ModR/M byte

isa_state eip[31:0];
var instr[7:0];
isa_state modrm[7:0];

isa_state xregs[31:0][2:0];

isa_state imem[7:0][31:0];
isa_state dmem[7:0][31:0];     // 4GB memory (32-bit addressing)
isa_state DS[15:0];            // Data segment register

var reg_idx[2:0];
var rm_idx[2:0];
var mod_bits[1:0];

var src_val[15:0];

instr = imem[eip];
assume instr == 0x89;  // MOV r/m16, r16 opcode
eip = eip + 1;

modrm = imem[eip];
eip = eip + 1;

mod_bits = modrm[7:6];
reg_idx = modrm[5:3];
rm_idx = modrm[2:0];

assume mod_bits == 0b11;

src_val = xregs[reg_idx];

xregs[rm_idx] = src_val;
