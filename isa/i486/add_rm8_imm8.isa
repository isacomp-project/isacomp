// SPDX-License-Identifier: BSD-3-Clause
// i486 ADD r/m8, imm8 (0x80 /0b000) - CONSOLIDATED ALL ADDRESSING MODES
// Uses multiple case statements for parser compatibility
// addition with 8-bit immediate value
// Grp1 opcode 0x80 with reg field = 0b000
// Supports all addressing modes via ModR/M byte:
//   mod=00: [ESI], [EDI], [EBX] - indirect
//   mod=01: [ESI+disp8], [EDI+disp8], [EBX+disp8] - indirect + 8-bit displacement
//   mod=10: [ESI+disp32], [EDI+disp32], [EBX+disp32] - indirect + 32-bit displacement
//   mod=11: AL, CL, DL, BL, AH, CH, DH, BH - register direct

isa_state lregs[7:0][1:0] of xregs[0b0**][7:0];   // AL,CL,DL,BL
isa_state hregs[7:0][1:0] of xregs[0b0**][15:8];  // AH,CH,DH,BH
isa_state xregs[31:0][2:0];    // 32-bit registers array
isa_state eip[31:0];
var instr[7:0];
isa_state modrm[7:0];
var mod_bits[1:0];
var reg_bits[2:0];
var rm_bits[2:0];
isa_state imem[7:0][31:0];
isa_state dmem[7:0][31:0];
isa_state DS[15:0];            // Data segment register
isa_state flag_CF[0:0];
isa_state flag_OF[0:0];
isa_state flag_SF[0:0];
isa_state flag_ZF[0:0];
isa_state flag_AF[0:0];
isa_state flag_PF[0:0];

var dst_reg_idx[1:0];
var addr_reg_idx[2:0];
var base_offset[31:0];
var disp8[7:0];
var disp16_lo[7:0];
var disp16_hi[7:0];
var disp16[15:0];
var signed_disp8[31:0];
var offset[31:0];
var physical_addr[19:0];
var dst_mem_val[7:0];
var dst_reg_val_low[7:0];
var dst_reg_val_high[7:0];
var dst_reg_val[7:0];
var dst_val[7:0];
var imm_val[7:0];
var result[8:0];
var is_mem_dst[0:0];
var write_to_mem[0:0];
var write_to_hreg[0:0];
var write_to_lreg[0:0];

// Fetch instruction
instr = imem[eip];
assume instr == 0x80;
eip = eip + 1;

// Fetch ModR/M byte
modrm = imem[eip];
eip = eip + 1;

// Decode ModR/M
mod_bits = modrm[7:6];
reg_bits = modrm[5:3];
rm_bits = modrm[2:0];

// For Grp1, reg field selects the operation
assume reg_bits == 0b000;

dst_reg_idx = rm_bits[1:0];

// Pre-calculate address register index for memory modes
case (rm_bits) {
  0b100: addr_reg_idx = 3'b110;
  0b101: addr_reg_idx = 3'b111;
  0b111: addr_reg_idx = 3'b011;
}

// Read base offset from address register
base_offset = xregs[addr_reg_idx];

// Read potential displacement bytes
disp8 = imem[eip];
disp16_lo = imem[eip];
disp16_hi = imem[eip + 1];
disp16 = {disp16_hi, disp16_lo};
signed_disp8 = {{24{disp8[7]}}, disp8};

// Calculate offset based on addressing mode
case (mod_bits) {
  0b00: offset = base_offset;
  0b01: offset = base_offset + signed_disp8;
  0b10: offset = base_offset + disp16;
  0b11: offset = 32'h00000000;
}

// Set destination type flag
case (mod_bits) {
  0b00: is_mem_dst = 1'b1;
  0b01: is_mem_dst = 1'b1;
  0b10: is_mem_dst = 1'b1;
  0b11: is_mem_dst = 1'b0;
}

// Advance EIP based on displacement bytes consumed
case (mod_bits) {
  0b00: eip = eip;
  0b01: eip = eip + 1;
  0b10: eip = eip + 2;
  0b11: eip = eip;
}

// Calculate physical address for memory modes
physical_addr = (DS << 4) + offset;

// Read destination values (both memory and register)
dst_mem_val = dmem[physical_addr];
dst_reg_val_low = lregs[dst_reg_idx];
dst_reg_val_high = hregs[dst_reg_idx];

// Select register value based on rm_bits[2] (high vs low byte)
case (rm_bits[2]) {
  1'b1: dst_reg_val = dst_reg_val_high;
  1'b0: dst_reg_val = dst_reg_val_low;
}

// Select actual destination value based on mode
case (is_mem_dst) {
  1'b1: dst_val = dst_mem_val;
  1'b0: dst_val = dst_reg_val;
}

// Fetch immediate value
imm_val = imem[eip];
eip = eip + 1;

// Perform ADD operation
result = dst_val + imm_val;

// Set flags
flag_CF = result[8];
flag_OF = (dst_val[7] == imm_val[7]) & (dst_val[7] != result[7]);
flag_SF = result[7];
flag_ZF = result[7:0] == 8'h00;
flag_AF = (dst_val[3:0] + imm_val[3:0]) > 4'hF;
flag_PF = ~(result[0] ^ result[1] ^ result[2] ^ result[3] ^ result[4] ^ result[5] ^ result[6] ^ result[7]);

// Determine write target
case (is_mem_dst) {
  1'b1: write_to_mem = 1'b1;
  1'b0: write_to_mem = 1'b0;
}

case (is_mem_dst) {
  1'b1: write_to_hreg = 1'b0;
  1'b0: write_to_hreg = rm_bits[2];
}

case (is_mem_dst) {
  1'b1: write_to_lreg = 1'b0;
  1'b0: write_to_lreg = ~rm_bits[2];
}

// Write result to destination
case (write_to_mem) {
  1'b1: dmem[physical_addr] = result[7:0];
  1'b0: dmem[physical_addr] = dmem[physical_addr];  // No-op
}

case (write_to_hreg) {
  1'b1: hregs[dst_reg_idx] = result[7:0];
  1'b0: hregs[dst_reg_idx] = hregs[dst_reg_idx];  // No-op
}

case (write_to_lreg) {
  1'b1: lregs[dst_reg_idx] = result[7:0];
  1'b0: lregs[dst_reg_idx] = lregs[dst_reg_idx];  // No-op
}
