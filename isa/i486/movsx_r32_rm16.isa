// SPDX-License-Identifier: BSD-3-Clause
// i486 MOVSX r32, r/m16 (0x0F BF)
// Move word to dword with sign extension
// No flags affected

isa_state eip[31:0];
var instr[7:0];
var instr2[7:0];
isa_state modrm[7:0];

// 32-bit register file: EAX(0), ECX(1), EDX(2), EBX(3), ESP(4), EBP(5), ESI(6), EDI(7)
isa_state xregs[31:0][2:0];

isa_state imem[7:0][31:0];
isa_state dmem[7:0][31:0];

var mod_bits[1:0];
var reg_bits[2:0];
var rm_bits[2:0];
var src_val[15:0];
var sign_bit[0:0];

// Fetch first byte of instruction
instr = imem[eip];
assume instr == 0x0F;
eip = eip + 1;

// Fetch second byte
instr2 = imem[eip];
assume instr2 == 0xBF;
eip = eip + 1;

// Fetch ModR/M byte
modrm = imem[eip];
eip = eip + 1;

// Decode ModR/M
mod_bits = modrm[7:6];
reg_bits = modrm[5:3];
rm_bits = modrm[2:0];

// Register-direct mode (reading 16-bit register)
assume mod_bits == 0b11;

// Read low word of source register
src_val = xregs[rm_bits][15:0];

// Get sign bit
sign_bit = src_val[15];

// Sign-extend to 32 bits and write to destination
xregs[reg_bits] = sign_bit ? {16'hFFFF, src_val} : {16'h0000, src_val};

// MOVSX does not affect any flags
