// i486 VERR r/m16 (0x0F 0x00 /4)
// Verify segment for reading
// If segment selector is readable, sets ZF=1, otherwise clears ZF

isa_state eip[31:0];
var instr[7:0];
var instr2[7:0];
isa_state modrm[7:0];

isa_state xregs[31:0][2:0];
isa_state imem[7:0][31:0];
isa_state dmem[7:0][31:0];

isa_state flag_ZF[0:0];

var mod_bits[1:0];
var reg_bits[2:0];
var rm_bits[2:0];
var selector[15:0];
var is_readable[0:0];

// Fetch instruction bytes
instr = imem[eip];
assume instr == 0x0F;
eip = eip + 1;

instr2 = imem[eip];
assume instr2 == 0x00;
eip = eip + 1;

// Fetch ModR/M byte
modrm = imem[eip];
eip = eip + 1;

// Decode ModR/M
mod_bits = modrm[7:6];
reg_bits = modrm[5:3];
rm_bits = modrm[2:0];

// Must be /4 (reg field = 4)
assume reg_bits == 3'b100;

// Register-direct mode
assume mod_bits == 0b11;

// Read selector from register (low 16 bits)
selector = xregs[rm_bits][15:0];

// Simplified: assume segment is readable
// In real implementation, would check descriptor table access rights
is_readable = 1'b1;

// Set ZF based on readability
flag_ZF = is_readable;
