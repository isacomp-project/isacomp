// SPDX-License-Identifier: BSD-3-Clause
// i486 JNC/JAE/JNB rel8 (0x73)
// Jump if No Carry (CF=0)
// Uses signed byte displacement relative to EIP

isa_state eip[31:0];
var instr[7:0];
isa_state imem[7:0][31:0];
isa_state flag_CF[0:0];

var offset[7:0];
var signed_offset[31:0];
var target_addr[31:0];

// Fetch instruction
instr = imem[eip];
assume instr == 0x73;
eip = eip + 1;

// Read signed byte displacement
offset = imem[eip];
eip = eip + 1;

// Sign-extend 8-bit offset to 32 bits
signed_offset = {{24{offset[7]}}, offset};

// Calculate target address (eip + signed offset)
target_addr = eip + signed_offset;

// Jump if condition is true
eip = flag_CF == 1'b0 ? target_addr : eip;
