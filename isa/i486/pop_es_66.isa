// SPDX-License-Identifier: BSD-3-Clause
// i486 POP ES with 66 prefix (0x66 0x07)
// Pop 32-bit value from stack, load low 16 bits into ES

isa_state eip[31:0];
var prefix[7:0];
var instr[7:0];

isa_state xregs[31:0][2:0];

isa_state imem[7:0][31:0];
isa_state dmem[7:0][31:0];
isa_state SS[15:0];
isa_state ES[15:0];

var offset[31:0];
var physical_addr[31:0];
var physical_addr_1[31:0];
var val_lo[7:0];
var val_hi[7:0];

prefix = imem[eip];
assume prefix == 0x66;

instr = imem[eip + 1];
assume instr == 0x07;

eip = eip + 2;

offset = xregs[4];

physical_addr = (SS << 4) + offset;
physical_addr_1 = physical_addr + 1;

val_lo = dmem[physical_addr];
val_hi = dmem[physical_addr_1];

ES = {val_hi, val_lo};

// Increment ESP by 4 (32-bit operand size)
xregs[4] = xregs[4] + 32'h00000004;
