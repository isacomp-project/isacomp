// SPDX-License-Identifier: BSD-3-Clause
// i486 JNP rel32 (0x66 0x0F 0x8B) - 66-prefixed near jump
// Jump if Not Parity (flag_PF=0) - near jump with 32-bit displacement

isa_state eip[31:0];
var prefix[7:0];
var opcode1[7:0];
var opcode2[7:0];
isa_state imem[7:0][31:0];
isa_state flag_PF[0:0];

var offset_b0[7:0];
var offset_b1[7:0];
var offset_b2[7:0];
var offset_b3[7:0];
var signed_offset[31:0];
var target_addr[31:0];
var next_eip[31:0];

// Fetch 0x66 prefix
prefix = imem[eip];
assume prefix == 0x66;

// Fetch 0x0F prefix
opcode1 = imem[eip + 1];
assume opcode1 == 0x0F;

// Fetch instruction opcode
opcode2 = imem[eip + 2];
assume opcode2 == 0x8B;

// Read 32-bit signed displacement (little-endian)
offset_b0 = imem[eip + 3];
offset_b1 = imem[eip + 4];
offset_b2 = imem[eip + 5];
offset_b3 = imem[eip + 6];

// Combine into 32-bit signed offset
signed_offset = {offset_b3, offset_b2, offset_b1, offset_b0};

// EIP after fetching the instruction (1 prefix + 2-byte opcode + 4-byte displacement = 7)
next_eip = eip + 7;

// Calculate target address (next_eip + signed offset)
target_addr = next_eip + signed_offset;

// Jump if condition is true, else advance past instruction
case (flag_PF) {
  1'b0: eip = target_addr;
  1'b1: eip = next_eip;
}
