// SPDX-License-Identifier: BSD-3-Clause
// i486 XCHG r8_low, r8_low - Exchange two low byte registers
// Opcode: 0x86 + ModR/M byte

isa_state eip[31:0];
var instr[7:0];
isa_state modrm[7:0];

isa_state xregs[31:0][2:0];

isa_state lregs[7:0][1:0] of xregs[0b0**][7:0];

isa_state imem[7:0][31:0];
isa_state dmem[7:0][31:0];     // 4GB memory (32-bit addressing)
isa_state DS[15:0];            // Data segment register

var reg_idx[2:0];
var rm_idx[2:0];
var mod_bits[1:0];

// Fetch instruction
instr = imem[eip];
assume instr == 0x86;
eip = eip + 1;

// Fetch ModR/M byte
modrm = imem[eip];
eip = eip + 1;

// Decode ModR/M
mod_bits = modrm[7:6];
reg_idx = modrm[5:3];
rm_idx = modrm[2:0];

// Register-to-register mode only
assume mod_bits == 0b11;
assume reg_idx[2] == 1'b0;
assume rm_idx[2] == 1'b0;

var reg1_idx[1:0];
var reg2_idx[1:0];
var temp[7:0];

reg1_idx = reg_idx[1:0];
reg2_idx = rm_idx[1:0];

temp = lregs[reg1_idx];
lregs[reg1_idx] = lregs[reg2_idx];
lregs[reg2_idx] = temp;
