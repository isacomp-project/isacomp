// SPDX-License-Identifier: BSD-3-Clause
// i486 INSB (0x6C)
// Input byte from port DX to [EDI], adjust EDI by 1 based on DF

isa_state eip[31:0];
var instr[7:0];

// 32-bit register file
isa_state xregs[31:0][2:0];

// Register aliases
isa_state EDI[31:0] of xregs[7];
isa_state DX[15:0] of xregs[2][15:0];

isa_state imem[7:0][31:0];
isa_state dmem[7:0][31:0];
isa_state io_ports[7:0][15:0];
isa_state flag_DF[0:0];

var new_edi[31:0];
var val[7:0];

// Fetch instruction
instr = imem[eip];
assume instr == 0x6C;

// Read byte from I/O port DX
val = io_ports[DX];

// Store byte to [EDI]
dmem[EDI] = val;

// Adjust EDI based on direction flag
new_edi = flag_DF == 1'b0 ? EDI + 1 : EDI - 1;
EDI = new_edi;

// INSB does not affect flags

// Update EIP after all imem reads are complete
eip = eip + 1;
