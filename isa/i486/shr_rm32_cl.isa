// SPDX-License-Identifier: BSD-3-Clause
// i486 SHR r/m32, CL (0xD3 /5 with mod=11)
// Shift Right Logical by CL bits

isa_state eip[31:0];
var instr[7:0];
isa_state modrm[7:0];

// 32-bit register file
isa_state xregs[31:0][2:0];
isa_state ECX[31:0] of xregs[1];
isa_state CL[7:0] of xregs[1][7:0];

isa_state imem[7:0][31:0];
isa_state dmem[7:0][31:0];
isa_state flag_CF[0:0];
isa_state flag_OF[0:0];
isa_state flag_SF[0:0];
isa_state flag_ZF[0:0];
isa_state flag_PF[0:0];

var mod_bits[1:0];
var reg_bits[2:0];
var rm_bits[2:0];
var dst_val[31:0];
var count[4:0];
var result[31:0];

// Fetch instruction and ModR/M using offset-based addressing
instr = imem[eip];
assume instr == 0xD3;
modrm = imem[eip + 1];

// Decode ModR/M
mod_bits = modrm[7:6];
reg_bits = modrm[5:3];
rm_bits = modrm[2:0];

// Verify this is SHR (reg_bits = 101)
assume reg_bits == 0b101;

// Register-direct mode
assume mod_bits == 0b11;

// Read destination value
dst_val = xregs[rm_bits];

// Get count from CL, masked to 5 bits for 32-bit operands
count = CL[4:0];

// Perform logical right shift
result = dst_val >> count;

// Write result
xregs[rm_bits] = result;

// Update flags if count != 0
// CF = last bit shifted out
// For SHR, this is bit at position (count - 1) of original value
flag_CF = count == 0 ? flag_CF : ((dst_val >> (count - 1)) & 1);

// ZF, SF, PF based on result
flag_ZF = count == 0 ? flag_ZF : (result == 0 ? 1'b1 : 1'b0);
flag_SF = count == 0 ? flag_SF : result[31];
flag_PF = count == 0 ? flag_PF : ~(result[0] ^ result[1] ^ result[2] ^ result[3] ^ result[4] ^ result[5] ^ result[6] ^ result[7]);

// OF is MSB of original operand for count=1, undefined otherwise
flag_OF = count == 1 ? dst_val[31] : flag_OF;

// Update EIP after all processing
eip = eip + 2;
