// SPDX-License-Identifier: BSD-3-Clause
// i486 MOV r/m8, imm8 (0xC6/0)
// Move immediate byte to register or memory

isa_state lregs[7:0][1:0] of xregs[0b0**][7:0];
isa_state hregs[7:0][1:0] of xregs[0b0**][15:8];
isa_state xregs[31:0][2:0];
isa_state eip[31:0];
var instr[7:0];
isa_state modrm[7:0];
isa_state imem[7:0][31:0];
isa_state dmem[7:0][31:0];
isa_state DS[15:0];

var mod_bits[1:0];
var reg_bits[2:0];
var rm_bits[2:0];
var imm8[7:0];
var dst_reg_idx[1:0];
var addr_reg_idx[2:0];
var base_offset[15:0];
var disp8[7:0];
var disp16_lo[7:0];
var disp16_hi[7:0];
var disp16[15:0];
var signed_disp8[15:0];
var offset[15:0];
var physical_addr[19:0];
var is_mem_dst[0:0];

instr = imem[eip];
assume instr == 0xC6;
eip = eip + 1;

modrm = imem[eip];
eip = eip + 1;

mod_bits = modrm[7:6];
reg_bits = modrm[5:3];
rm_bits = modrm[2:0];

assume reg_bits == 3'b000;  // MOV opcode extension

dst_reg_idx = rm_bits[1:0];

case (rm_bits) {
  0b100: addr_reg_idx = 3'b110;
  0b101: addr_reg_idx = 3'b111;
  0b111: addr_reg_idx = 3'b011;
}

base_offset = xregs[addr_reg_idx][15:0];

disp8 = imem[eip];
disp16_lo = imem[eip];
disp16_hi = imem[eip + 1];
disp16 = {disp16_hi, disp16_lo};
signed_disp8 = {{8{disp8[7]}}, disp8};

case (mod_bits) {
  0b00: offset = base_offset;
  0b01: offset = base_offset + signed_disp8;
  0b10: offset = base_offset + disp16;
  0b11: offset = 16'h0000;
}

case (mod_bits) {
  0b00: is_mem_dst = 1'b1;
  0b01: is_mem_dst = 1'b1;
  0b10: is_mem_dst = 1'b1;
  0b11: is_mem_dst = 1'b0;
}

case (mod_bits) {
  0b00: eip = eip;
  0b01: eip = eip + 1;
  0b10: eip = eip + 2;
  0b11: eip = eip;
}

// Read immediate after displacement
imm8 = imem[eip];
eip = eip + 1;

physical_addr = (DS << 4) + offset;

// Write to destination
case (is_mem_dst) {
  1'b1: dmem[physical_addr] = imm8;
  1'b0: dmem[physical_addr] = dmem[physical_addr];
}

var write_high[0:0];
write_high = (~is_mem_dst) & rm_bits[2];
case (write_high) {
  1'b1: hregs[dst_reg_idx] = imm8;
  1'b0: hregs[dst_reg_idx] = hregs[dst_reg_idx];
}

var write_low[0:0];
write_low = (~is_mem_dst) & (~rm_bits[2]);
case (write_low) {
  1'b1: lregs[dst_reg_idx] = imm8;
  1'b0: lregs[dst_reg_idx] = lregs[dst_reg_idx];
}
