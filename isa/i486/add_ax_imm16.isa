// SPDX-License-Identifier: BSD-3-Clause
// i486 ADD AX, imm16 (0x05)
isa_state xregs[31:0][2:0];
isa_state eip[31:0];
var instr[7:0];
isa_state imem[7:0][31:0];
isa_state flag_CF[0:0];
isa_state flag_OF[0:0];
isa_state flag_SF[0:0];
isa_state flag_ZF[0:0];
isa_state flag_AF[0:0];
isa_state flag_PF[0:0];

var imm_lo[7:0];
var imm_hi[7:0];
var imm16[15:0];
var ax_val[15:0];
var result[16:0];

instr = imem[eip];
assume instr == 0x05;
eip = eip + 1;

imm_lo = imem[eip];
eip = eip + 1;
imm_hi = imem[eip];
eip = eip + 1;
imm16 = {imm_hi, imm_lo};

ax_val = xregs[0][15:0];
result = ax_val + imm16;

xregs[0][15:0] = result[15:0];

flag_CF = result[16];
flag_OF = (ax_val[15] == imm16[15]) & (ax_val[15] != result[15]);
flag_SF = result[15];
flag_ZF = result[15:0] == 16'h0000;
flag_AF = (ax_val[3:0] + imm16[3:0]) > 4'hF;
flag_PF = ~(result[0] ^ result[1] ^ result[2] ^ result[3] ^ result[4] ^ result[5] ^ result[6] ^ result[7]);
