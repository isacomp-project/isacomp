// SPDX-License-Identifier: BSD-3-Clause
// i486 ADD EAX, EBX (0x01 with ModR/M 0xD8)
// 32-bit register addition with proper register file hierarchy

isa_state eip[31:0];
var instr[7:0];
isa_state modrm[7:0];

// 32-bit register file: EAX(0), ECX(1), EDX(2), EBX(3), ESP(4), EBP(5), ESI(6), EDI(7)
isa_state xregs[31:0][2:0];

// Register aliases using 'of' for subsetting
isa_state EAX[31:0] of xregs[0];
isa_state EBX[31:0] of xregs[3];

// 16-bit views
isa_state AX[15:0] of xregs[0][15:0];
isa_state BX[15:0] of xregs[3][15:0];

// 8-bit views (low bytes)
isa_state AL[7:0] of xregs[0][7:0];
isa_state BL[7:0] of xregs[3][7:0];

// 8-bit views (high bytes of low word)
isa_state AH[7:0] of xregs[0][15:8];
isa_state BH[7:0] of xregs[3][15:8];

isa_state imem[7:0][31:0];
isa_state dmem[7:0][31:0];
isa_state flag_CF[0:0];
isa_state flag_PF[0:0];
isa_state flag_AF[0:0];
isa_state flag_ZF[0:0];
isa_state flag_SF[0:0];
isa_state flag_OF[0:0];

var old_eax[31:0];
var result[32:0];

instr = imem[eip];
assume instr == 0x01;
eip = eip + 1;
modrm = imem[eip];
assume modrm == 0xD8;
eip = eip + 1;

old_eax = EAX;
result = EAX + EBX;

EAX = result[31:0];

flag_CF = result[32];
flag_ZF = result[31:0] == 0 ? 1'b1 : 1'b0;
flag_SF = result[31];
flag_OF = (old_eax[31] == EBX[31]) & (old_eax[31] != result[31]);
flag_PF = ~(result[0] ^ result[1] ^ result[2] ^ result[3] ^ result[4] ^ result[5] ^ result[6] ^ result[7]);
flag_AF = (old_eax[3:0] + EBX[3:0]) > 4'hF;
