// SPDX-License-Identifier: BSD-3-Clause
// i486 JMP rel32 with 66 prefix (0x66 0xE9)
// Near unconditional jump with 32-bit signed displacement (66 prefix in real mode)

isa_state eip[31:0];
var prefix[7:0];
var instr[7:0];
isa_state imem[7:0][31:0];

var off_b0[7:0];
var off_b1[7:0];
var off_b2[7:0];
var off_b3[7:0];
var signed_offset[31:0];
var next_eip[31:0];
var target_addr[31:0];

// Fetch 66 prefix
prefix = imem[eip];
assume prefix == 0x66;

// Fetch instruction
instr = imem[eip + 1];
assume instr == 0xE9;

// Read 32-bit displacement (little-endian)
off_b0 = imem[eip + 2];
off_b1 = imem[eip + 3];
off_b2 = imem[eip + 4];
off_b3 = imem[eip + 5];

signed_offset = {off_b3, off_b2, off_b1, off_b0};

// EIP after fetching instruction (1-byte prefix + 1-byte opcode + 4-byte displacement)
next_eip = eip + 6;

// Calculate target address (next_eip + signed offset)
target_addr = next_eip + signed_offset;

// Unconditional jump
eip = target_addr;
