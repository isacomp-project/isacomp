// SPDX-License-Identifier: BSD-3-Clause
// i486 SBB r/m32, imm8 with 66 prefix (0x66 0x83 /3)
// Subtract with borrow sign-extended imm8 from r/m32: r/m32 = r/m32 - sign_extend(imm8) - CF
// Uses ModR/M with reg field = 011 as opcode extension

isa_state eip[31:0];
var prefix[7:0];
var instr[7:0];
isa_state modrm[7:0];

// 32-bit register file: EAX(0), ECX(1), EDX(2), EBX(3), ESP(4), EBP(5), ESI(6), EDI(7)
isa_state xregs[31:0][2:0];

isa_state imem[7:0][31:0];
isa_state dmem[7:0][31:0];
isa_state flag_CF[0:0];
isa_state flag_OF[0:0];
isa_state flag_SF[0:0];
isa_state flag_ZF[0:0];
isa_state flag_AF[0:0];
isa_state flag_PF[0:0];

var mod_bits[1:0];
var reg_bits[2:0];
var rm_bits[2:0];
var dst_val[31:0];
var imm8[7:0];
var imm_val[31:0];
var borrow_in[0:0];
var result[32:0];

// Save borrow flag before any operations
borrow_in = flag_CF;

// Fetch 0x66 prefix
prefix = imem[eip];
assume prefix == 0x66;

// Fetch instruction
instr = imem[eip + 1];
assume instr == 0x83;

// Fetch ModR/M byte
modrm = imem[eip + 2];

// Decode ModR/M
mod_bits = modrm[7:6];
reg_bits = modrm[5:3];
rm_bits = modrm[2:0];

// Verify this is SBB (reg_bits = 011)
assume reg_bits == 0b011;

// Register-direct mode
assume mod_bits == 0b11;

// Fetch immediate byte
imm8 = imem[eip + 3];

// Advance EIP (prefix + opcode + modrm + 1-byte immediate)
eip = eip + 4;

// Sign-extend imm8 to 32 bits
imm_val = {{24{imm8[7]}}, imm8};

// Read operand
dst_val = xregs[rm_bits];

// Perform SBB operation (subtract with borrow)
result = dst_val - imm_val - {31'b0, borrow_in};

// Write result to destination
xregs[rm_bits] = result[31:0];

// Set flags
flag_CF = result[32];
flag_OF = (dst_val[31] != imm_val[31]) & (dst_val[31] != result[31]);
flag_SF = result[31];
flag_ZF = result[31:0] == 32'h00000000;
flag_AF = (dst_val[3:0] < imm_val[3:0] + {3'b0, borrow_in});
flag_PF = ~(result[0] ^ result[1] ^ result[2] ^ result[3] ^ result[4] ^ result[5] ^ result[6] ^ result[7]);
