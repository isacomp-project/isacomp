// SPDX-License-Identifier: BSD-3-Clause
// i486 CDQ (0x66 0x99 in 16-bit real mode)
// Convert Double to Quad: Sign-extend EAX into EDX:EAX
// Same opcode as CWD but with 32-bit operand size (0x66 prefix in real mode)
// No flags affected

isa_state eip[31:0];
var instr[7:0];
var instr2[7:0];

// 32-bit register file: EAX(0), ECX(1), EDX(2), EBX(3), ESP(4), EBP(5), ESI(6), EDI(7)
isa_state xregs[31:0][2:0];

// Register aliases using 'of' for subsetting
isa_state EAX[31:0] of xregs[0];
isa_state EDX[31:0] of xregs[2];

isa_state imem[7:0][31:0];
isa_state dmem[7:0][31:0];

var sign_bit[0:0];

// Fetch operand-size prefix (0x66 for 32-bit in real mode)
instr = imem[eip];
assume instr == 0x66;
eip = eip + 1;

// Fetch instruction opcode
instr2 = imem[eip];
assume instr2 == 0x99;
eip = eip + 1;

// Get sign bit of EAX
sign_bit = EAX[31];

// Sign-extend EAX into EDX:EAX
EDX = sign_bit ? 32'hFFFFFFFF : 32'h00000000;

// CDQ does not affect any flags
