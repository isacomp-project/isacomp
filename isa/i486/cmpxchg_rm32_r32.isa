// SPDX-License-Identifier: BSD-3-Clause
// i486 CMPXCHG r/m32, r32 (0x0F B1)
// Compare EAX with r/m32; if equal, load src into dest and set ZF
// Otherwise, load dest into EAX and clear ZF
// Sets all arithmetic flags (CF, PF, AF, ZF, SF, OF) based on comparison
// i486-specific instruction

isa_state eip[31:0];
var instr[7:0];
var instr2[7:0];
isa_state modrm[7:0];

// 32-bit register file: EAX(0), ECX(1), EDX(2), EBX(3), ESP(4), EBP(5), ESI(6), EDI(7)
isa_state xregs[31:0][2:0];

// Register aliases using 'of' for subsetting
isa_state EAX[31:0] of xregs[0];

isa_state imem[7:0][31:0];
isa_state dmem[7:0][31:0];
isa_state flag_CF[0:0];
isa_state flag_PF[0:0];
isa_state flag_AF[0:0];
isa_state flag_ZF[0:0];
isa_state flag_SF[0:0];
isa_state flag_OF[0:0];

var mod_bits[1:0];
var reg_bits[2:0];
var rm_bits[2:0];
var dest_val[31:0];
var src_val[31:0];
var cmp_result[32:0];

// Fetch first byte of instruction
instr = imem[eip];
assume instr == 0x0F;
eip = eip + 1;

// Fetch second byte
instr2 = imem[eip];
assume instr2 == 0xB1;
eip = eip + 1;

// Fetch ModR/M byte
modrm = imem[eip];
eip = eip + 1;

// Decode ModR/M
mod_bits = modrm[7:6];
reg_bits = modrm[5:3];
rm_bits = modrm[2:0];

// Register-direct mode
assume mod_bits == 0b11;

// Read operands
dest_val = xregs[rm_bits];
src_val = xregs[reg_bits];

// Compare EAX with destination
cmp_result = EAX - dest_val;

// Set flags based on comparison (same as SUB)
flag_CF = (EAX < dest_val);
flag_ZF = (cmp_result[31:0] == 0);
flag_SF = cmp_result[31];
flag_OF = (EAX[31] != dest_val[31]) & (EAX[31] != cmp_result[31]);
flag_PF = ~(cmp_result[0] ^ cmp_result[1] ^ cmp_result[2] ^ cmp_result[3] ^ cmp_result[4] ^ cmp_result[5] ^ cmp_result[6] ^ cmp_result[7]);
flag_AF = (EAX[3:0] < dest_val[3:0]);

// If equal (ZF=1), load src into dest
// If not equal (ZF=0), load dest into EAX
if (EAX == dest_val) {
    xregs[rm_bits] = src_val;
} else {
    EAX = dest_val;
}
