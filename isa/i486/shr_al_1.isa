// SPDX-License-Identifier: BSD-3-Clause
// i486 SHR AL,1 (0xD0 with modrm 0xE8)
// Shift Logical Right by 1 bit
// Shifts out LSB into CF, shifts in 0 to MSB

isa_state eip[31:0];
var instr[7:0];
isa_state modrm[7:0];

// 32-bit register file: EAX(0), ECX(1), EDX(2), EBX(3), ESP(4), EBP(5), ESI(6), EDI(7)
isa_state xregs[31:0][2:0];

// Register aliases using 'of' for subsetting
isa_state EAX[31:0] of xregs[0];
isa_state AX[15:0] of xregs[0][15:0];
isa_state AL[7:0] of xregs[0][7:0];
isa_state AH[7:0] of xregs[0][15:8];
isa_state imem[7:0][31:0];
isa_state dmem[7:0][31:0];     // 4GB memory (32-bit addressing)
isa_state DS[15:0];            // Data segment register
isa_state flag_CF[0:0];
isa_state flag_PF[0:0];
isa_state flag_ZF[0:0];
isa_state flag_SF[0:0];
isa_state flag_OF[0:0];

var result[8:0];

instr = imem[eip];
assume instr == 0xD0;
eip = eip + 1;

modrm = imem[eip];
assume modrm == 0xE8;
eip = eip + 1;

// CF gets the bit that will be shifted out (LSB of AL)
flag_CF = AL[0];

// Shift right by 1
result = AL >> 1;

// Update AL
AL = result[7:0];

// Update flags
flag_ZF = AL == 0 ? 1'b1 : 1'b0;
flag_SF = AL[7];  // Always 0 after logical right shift by 1
flag_PF = AL[0];
// OF is set to MSB of original value (for 1-bit shift)
flag_OF = AL[7];
