// SPDX-License-Identifier: BSD-3-Clause
// i486 MOVZX r32, r/m16 with 6766 prefix (0x67 0x66 0x0F 0xB7)
// 32-bit addressing mode, zero-extend word to dword

isa_state eip[31:0];
var prefix67[7:0];
var prefix[7:0];
var instr[7:0];
var instr2[7:0];
isa_state modrm[7:0];

isa_state xregs[31:0][2:0];

isa_state imem[7:0][31:0];
isa_state dmem[7:0][31:0];

var mod_bits[1:0];
var reg_bits[2:0];
var rm_bits[2:0];
var src_val[15:0];

prefix67 = imem[eip];
assume prefix67 == 0x67;

prefix = imem[eip + 1];
assume prefix == 0x66;

instr = imem[eip + 2];
assume instr == 0x0F;

instr2 = imem[eip + 3];
assume instr2 == 0xB7;

modrm = imem[eip + 4];

eip = eip + 5;

mod_bits = modrm[7:6];
reg_bits = modrm[5:3];
rm_bits = modrm[2:0];

assume mod_bits == 0b11;

src_val = xregs[rm_bits][15:0];

xregs[reg_bits] = {16'h0000, src_val};
