// SPDX-License-Identifier: BSD-3-Clause
// i486 XOR r/m32, imm8 (0x83 /6)
// Logical XOR sign-extended imm8 with r/m32: r/m32 = r/m32 ^ sign-extend(imm8)
// Uses ModR/M with reg field = 110 as opcode extension

isa_state eip[31:0];
var instr[7:0];
isa_state modrm[7:0];

// 32-bit register file: EAX(0), ECX(1), EDX(2), EBX(3), ESP(4), EBP(5), ESI(6), EDI(7)
isa_state xregs[31:0][2:0];

isa_state imem[7:0][31:0];
isa_state dmem[7:0][31:0];
isa_state flag_CF[0:0];
isa_state flag_OF[0:0];
isa_state flag_SF[0:0];
isa_state flag_ZF[0:0];
isa_state flag_AF[0:0];
isa_state flag_PF[0:0];

var mod_bits[1:0];
var reg_bits[2:0];
var rm_bits[2:0];
var dst_val[31:0];
var imm8[7:0];
var imm_val[31:0];
var result[31:0];

// Fetch instruction
instr = imem[eip];
assume instr == 0x83;
eip = eip + 1;

// Fetch ModR/M byte
modrm = imem[eip];
eip = eip + 1;

// Decode ModR/M
mod_bits = modrm[7:6];
reg_bits = modrm[5:3];
rm_bits = modrm[2:0];

// Verify this is XOR (reg_bits = 110)
assume reg_bits == 0b110;

// Register-direct mode
assume mod_bits == 0b11;

// Fetch immediate byte and sign-extend
imm8 = imem[eip];
eip = eip + 1;

// Sign extend to 32 bits
imm_val = {{24{imm8[7]}}, imm8};

// Read operand
dst_val = xregs[rm_bits];

// Perform XOR operation
result = dst_val ^ imm_val;

// Write result to destination
xregs[rm_bits] = result;

// Set flags (XOR clears CF and OF, AF is undefined)
flag_CF = 1'b0;
flag_OF = 1'b0;
flag_SF = result[31];
flag_ZF = result == 32'h00000000;
flag_PF = ~(result[0] ^ result[1] ^ result[2] ^ result[3] ^ result[4] ^ result[5] ^ result[6] ^ result[7]);
