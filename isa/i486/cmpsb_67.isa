// SPDX-License-Identifier: BSD-3-Clause
// i486 CMPSB with 67 prefix (0x67 0xA6) - 32-bit addressing mode
// Compare bytes at [ESI] and [EDI] with 32-bit addressing

isa_state eip[31:0];
var prefix[7:0];
var instr[7:0];

isa_state xregs[31:0][2:0];
isa_state DS[15:0];
isa_state ES[15:0];

isa_state imem[7:0][31:0];
isa_state dmem[7:0][31:0];
isa_state flag_DF[0:0];
isa_state flag_CF[0:0];
isa_state flag_OF[0:0];
isa_state flag_SF[0:0];
isa_state flag_ZF[0:0];
isa_state flag_AF[0:0];
isa_state flag_PF[0:0];

var src_val[7:0];
var dst_val[7:0];
var result[8:0];
var src_addr[31:0];
var dst_addr[31:0];

prefix = imem[eip];
assume prefix == 0x67;

instr = imem[eip + 1];
assume instr == 0xA6;

src_addr = (DS << 4) + xregs[6];
dst_addr = (ES << 4) + xregs[7];

src_val = dmem[src_addr];
dst_val = dmem[dst_addr];

result = {1'b0, src_val} - {1'b0, dst_val};

flag_CF = result[8];
flag_OF = (src_val[7] != dst_val[7]) & (src_val[7] != result[7]);
flag_SF = result[7];
flag_ZF = result[7:0] == 8'h00;
flag_AF = (src_val[3:0] < dst_val[3:0]);
flag_PF = ~(result[0] ^ result[1] ^ result[2] ^ result[3] ^ result[4] ^ result[5] ^ result[6] ^ result[7]);

case (flag_DF) {
  1'b0: xregs[6] = xregs[6] + 32'h00000001;
  1'b1: xregs[6] = xregs[6] - 32'h00000001;
}

case (flag_DF) {
  1'b0: xregs[7] = xregs[7] + 32'h00000001;
  1'b1: xregs[7] = xregs[7] - 32'h00000001;
}

eip = eip + 2;
