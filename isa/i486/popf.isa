// SPDX-License-Identifier: BSD-3-Clause
// i486 POPF (0x9D) - WITH PROPER SEGMENTATION
// Pop flags register from stack
// Uses SS segment for stack access

isa_state eip[31:0];
var instr[7:0];
isa_state imem[7:0][31:0];
isa_state dmem[7:0][31:0];
isa_state SS[15:0];            // Stack segment register
isa_state xregs[31:0][2:0];    // ESP is xregs[4]
isa_state flag_CF[0:0];
isa_state flag_PF[0:0];
isa_state flag_AF[0:0];
isa_state flag_ZF[0:0];
isa_state flag_SF[0:0];
isa_state flag_TF[0:0];
isa_state flag_IF[0:0];
isa_state flag_DF[0:0];
isa_state flag_OF[0:0];

var flags_lo[7:0];
var flags_hi[7:0];
var flags[15:0];
var offset_lo[31:0];              // 32-bit stack offset (before increment)
var offset_hi[31:0];              // 32-bit stack offset + 1
var physical_addr_lo[31:0];       // 32-bit physical address
var physical_addr_hi[31:0];       // 32-bit physical address

instr = imem[eip];
assume instr == 0x9D;
eip = eip + 1;

// Calculate stack offsets (before incrementing ESP)
offset_lo = xregs[4];
offset_hi = xregs[4] + 32'h00000001;

// Calculate physical addresses: SS:offset
physical_addr_lo = (SS << 4) + offset_lo;
physical_addr_hi = (SS << 4) + offset_hi;

// Pop FLAGS from stack (little-endian)
flags_lo = dmem[physical_addr_lo];
flags_hi = dmem[physical_addr_hi];
flags = {flags_hi, flags_lo};

// Extract individual flags from FLAGS register
flag_CF = flags[0];
flag_PF = flags[2];
flag_AF = flags[4];
flag_ZF = flags[6];
flag_SF = flags[7];
flag_TF = flags[8];
flag_IF = flags[9];
flag_DF = flags[10];
flag_OF = flags[11];

// Increment ESP by 2
xregs[4] = xregs[4] + 32'h00000002;
