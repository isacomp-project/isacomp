// i486 MOV moffs8, AL (0xA2)
// Store AL to memory at direct address
isa_state eip[31:0];
var instr[7:0];
isa_state imem[7:0][31:0];
isa_state dmem[7:0][31:0];
isa_state xregs[31:0][2:0];
isa_state DS[15:0];

var offset_lo[7:0];
var offset_hi[7:0];
var offset[15:0];
var phys_addr[19:0];

instr = imem[eip];
assume instr == 0xA2;

offset_lo = imem[eip + 1];
offset_hi = imem[eip + 2];
offset = {offset_hi, offset_lo};

phys_addr = (DS << 4) + offset;
dmem[phys_addr] = xregs[0][7:0];

// Update EIP: opcode (1) + offset (2) = 3 bytes
eip = eip + 3;
