// SPDX-License-Identifier: BSD-3-Clause
// i486 BTC r32, imm8 (0x0F BA /7) - Bit Test and Complement with immediate
// Test bit in r/m32, bit index is immediate byte
// CF = original bit value, then toggle the bit
// OF/SF/ZF/AF/PF undefined

isa_state eip[31:0];
var instr[7:0];
var instr2[7:0];
isa_state modrm[7:0];

// 32-bit register file
isa_state xregs[31:0][2:0];

isa_state imem[7:0][31:0];
isa_state dmem[7:0][31:0];
isa_state flag_CF[0:0];

var mod_bits[1:0];
var reg_bits[2:0];
var rm_bits[2:0];
var base_val[31:0];
var imm8[7:0];
var bit_pos[4:0];
var bit_val[0:0];
var result[31:0];

// Fetch first opcode byte
instr = imem[eip];
assume instr == 0x0F;
eip = eip + 1;

// Fetch second opcode byte
instr2 = imem[eip];
assume instr2 == 0xBA;
eip = eip + 1;

// Fetch ModR/M byte
modrm = imem[eip];
eip = eip + 1;

// Decode ModR/M
mod_bits = modrm[7:6];
reg_bits = modrm[5:3];
rm_bits = modrm[2:0];

// Verify this is BTC (reg_bits = 111)
assume reg_bits == 0b111;

// Register-direct mode only
assume mod_bits == 0b11;

// Read immediate byte
imm8 = imem[eip];
eip = eip + 1;

// Read value
base_val = xregs[rm_bits];

// Compute bit position (modulo 32)
bit_pos = imm8[4:0];

// Extract original bit value
bit_val = base_val[bit_pos];

// Set CF to original bit value
flag_CF = bit_val;

// Complement (toggle) the bit
result = base_val ^ (32'h00000001 << bit_pos);

// Write result
xregs[rm_bits] = result;

// OF, SF, ZF, AF, PF are undefined (not modified in this implementation)
