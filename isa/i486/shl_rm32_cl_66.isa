// SPDX-License-Identifier: BSD-3-Clause
// i486 SHL r/m32, CL with 66 prefix (0x66 0xD3 /4)
// Shift Left by CL

isa_state eip[31:0];
var prefix[7:0];
var instr[7:0];
isa_state modrm[7:0];

isa_state xregs[31:0][2:0];
isa_state imem[7:0][31:0];
isa_state flag_CF[0:0];
isa_state flag_OF[0:0];
isa_state flag_SF[0:0];
isa_state flag_ZF[0:0];
isa_state flag_PF[0:0];

var mod_bits[1:0];
var reg_bits[2:0];
var rm_bits[2:0];
var dst_val[31:0];
var count[4:0];
var result[31:0];

prefix = imem[eip];
assume prefix == 0x66;

instr = imem[eip + 1];
assume instr == 0xD3;

modrm = imem[eip + 2];

mod_bits = modrm[7:6];
reg_bits = modrm[5:3];
rm_bits = modrm[2:0];

assume reg_bits == 0b100;
assume mod_bits == 0b11;

eip = eip + 3;

dst_val = xregs[rm_bits];
count = xregs[1][4:0];

result = dst_val << count;

xregs[rm_bits] = result;
flag_CF = count == 0 ? flag_CF : dst_val[32 - count];
flag_OF = count == 1 ? (result[31] ^ flag_CF) : flag_OF;
flag_SF = result[31];
flag_ZF = result == 32'h0;
flag_PF = ~(result[0] ^ result[1] ^ result[2] ^ result[3] ^ result[4] ^ result[5] ^ result[6] ^ result[7]);
