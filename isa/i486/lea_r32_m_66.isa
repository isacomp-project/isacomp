// SPDX-License-Identifier: BSD-3-Clause
// i486 LEA r32, m with 66 prefix (0x66 0x8D)
// Load Effective Address

isa_state eip[31:0];
var prefix[7:0];
var instr[7:0];
isa_state modrm[7:0];

isa_state xregs[31:0][2:0];
isa_state imem[7:0][31:0];

var mod_bits[1:0];
var reg_bits[2:0];
var rm_bits[2:0];
var disp_b0[7:0];
var disp_b1[7:0];
var disp_b2[7:0];
var disp_b3[7:0];
var disp32[31:0];
var eff_addr[31:0];

prefix = imem[eip];
assume prefix == 0x66;

instr = imem[eip + 1];
assume instr == 0x8D;

modrm = imem[eip + 2];

mod_bits = modrm[7:6];
reg_bits = modrm[5:3];
rm_bits = modrm[2:0];

// Handle mod=00, rm=101 (disp32 only)
assume mod_bits == 0b00;
assume rm_bits == 0b101;

disp_b0 = imem[eip + 3];
disp_b1 = imem[eip + 4];
disp_b2 = imem[eip + 5];
disp_b3 = imem[eip + 6];
disp32 = {disp_b3, disp_b2, disp_b1, disp_b0};

eip = eip + 7;

// Store effective address in destination register
xregs[reg_bits] = disp32;
