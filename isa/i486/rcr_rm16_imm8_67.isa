// SPDX-License-Identifier: BSD-3-Clause
// i486 RCR RM16, IMM8 with 67 prefix (0x67 0xC1 /3) - 32-bit addressing mode

isa_state xregs[31:0][2:0];
isa_state eip[31:0];
var prefix[7:0];
var instr[7:0];
isa_state modrm[7:0];
var mod_bits[1:0];
var reg_bits[2:0];
var rm_bits[2:0];
isa_state imem[7:0][31:0];
isa_state dmem[7:0][31:0];
isa_state DS[15:0];
isa_state flag_CF[0:0];
isa_state flag_OF[0:0];
isa_state flag_SF[0:0];
isa_state flag_ZF[0:0];
isa_state flag_PF[0:0];

var dst_reg_idx[2:0];
var base_val[31:0];
var disp8[7:0];
var disp32_b0[7:0];
var disp32_b1[7:0];
var disp32_b2[7:0];
var disp32_b3[7:0];
var disp32[31:0];
var signed_disp8[31:0];
var offset[31:0];
var physical_addr_lo[31:0];
var physical_addr_hi[31:0];
var dst_mem_val[15:0];
var dst_reg_val[15:0];
var dst_val[15:0];
var count[7:0];
var result[16:0];
var is_mem_dst[0:0];
var write_to_mem[0:0];
var write_to_reg[0:0];

prefix = imem[eip];
assume prefix == 0x67;

instr = imem[eip + 1];
assume instr == 0xC1;

modrm = imem[eip + 2];

mod_bits = modrm[7:6];
reg_bits = modrm[5:3];
rm_bits = modrm[2:0];

dst_reg_idx = rm_bits;

// For 32-bit addressing, rm selects base register
base_val = xregs[rm_bits];

disp8 = imem[eip + 3];
disp32_b0 = imem[eip + 3];
disp32_b1 = imem[eip + 4];
disp32_b2 = imem[eip + 5];
disp32_b3 = imem[eip + 6];
disp32 = {disp32_b3, disp32_b2, disp32_b1, disp32_b0};
signed_disp8 = {{24{disp8[7]}}, disp8};

case (mod_bits) {
  0b00: offset = base_val;
  0b01: offset = base_val + signed_disp8;
  0b10: offset = base_val + disp32;
  0b11: offset = 32'h00000000;
}

case (mod_bits) {
  0b00: is_mem_dst = 1'b1;
  0b01: is_mem_dst = 1'b1;
  0b10: is_mem_dst = 1'b1;
  0b11: is_mem_dst = 1'b0;
}

case (mod_bits) {
  0b00: eip = eip + 4;
  0b01: eip = eip + 5;
  0b10: eip = eip + 8;
  0b11: eip = eip + 4;
}

physical_addr_lo = ({16'h0000, DS} << 4) + offset;
physical_addr_hi = ({16'h0000, DS} << 4) + offset + 32'h00000001;

var dst_mem_val_lo[7:0];
var dst_mem_val_hi[7:0];
dst_mem_val_lo = dmem[physical_addr_lo];
dst_mem_val_hi = dmem[physical_addr_hi];
dst_mem_val = {dst_mem_val_hi, dst_mem_val_lo};
dst_reg_val = xregs[dst_reg_idx];

case (is_mem_dst) {
  1'b1: dst_val = dst_mem_val;
  1'b0: dst_val = dst_reg_val;
}

assume reg_bits == 0b011;  // RCR

// Read immediate count based on mod_bits
case (mod_bits) {
  0b00: count = imem[eip + 3];
  0b01: count = imem[eip + 4];
  0b10: count = imem[eip + 7];
  0b11: count = imem[eip + 3];
}

// RCR: Rotate through carry right
var temp_bit[0:0];
var old_cf[0:0];
old_cf = flag_CF;
temp_bit = dst_val[0];
result = {old_cf, dst_val[15:1]};
flag_CF = temp_bit;
flag_OF = (count == 16'h0001) ? (result[15] ^ result[14]) : flag_OF;
flag_SF = result[15];
flag_ZF = result[15:0] == 16'h0000;
flag_PF = ~(result[0] ^ result[1] ^ result[2] ^ result[3] ^ result[4] ^ result[5] ^ result[6] ^ result[7]);

case (is_mem_dst) {
  1'b1: write_to_mem = 1'b1;
  1'b0: write_to_mem = 1'b0;
}

case (is_mem_dst) {
  1'b1: write_to_reg = 1'b0;
  1'b0: write_to_reg = 1'b1;
}

case (write_to_mem) {
  1'b1: dmem[physical_addr_lo] = result[7:0];
  1'b0: dmem[physical_addr_lo] = dmem[physical_addr_lo];
}

case (write_to_mem) {
  1'b1: dmem[physical_addr_hi] = result[15:8];
  1'b0: dmem[physical_addr_hi] = dmem[physical_addr_hi];
}

case (write_to_reg) {
  1'b1: xregs[dst_reg_idx] = result[15:0];
  1'b0: xregs[dst_reg_idx] = xregs[dst_reg_idx];
}
