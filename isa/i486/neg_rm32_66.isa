// SPDX-License-Identifier: BSD-3-Clause
// i486 NEG r/m32 with 66 prefix (0x66 0xF7 /3)
// Two's complement negation

isa_state eip[31:0];
var prefix[7:0];
var instr[7:0];
isa_state modrm[7:0];

isa_state xregs[31:0][2:0];
isa_state imem[7:0][31:0];
isa_state flag_CF[0:0];
isa_state flag_OF[0:0];
isa_state flag_SF[0:0];
isa_state flag_ZF[0:0];
isa_state flag_AF[0:0];
isa_state flag_PF[0:0];

var mod_bits[1:0];
var reg_bits[2:0];
var rm_bits[2:0];
var dst_val[31:0];
var result[31:0];

prefix = imem[eip];
assume prefix == 0x66;

instr = imem[eip + 1];
assume instr == 0xF7;

modrm = imem[eip + 2];

mod_bits = modrm[7:6];
reg_bits = modrm[5:3];
rm_bits = modrm[2:0];

assume reg_bits == 0b011;
assume mod_bits == 0b11;

eip = eip + 3;

dst_val = xregs[rm_bits];
result = 32'h0 - dst_val;

xregs[rm_bits] = result;

// CF is cleared if operand is 0, set otherwise
flag_CF = dst_val != 32'h0;
flag_OF = dst_val == 32'h80000000;
flag_SF = result[31];
flag_ZF = result == 32'h0;
flag_AF = dst_val[3:0] != 4'h0;
flag_PF = ~(result[0] ^ result[1] ^ result[2] ^ result[3] ^ result[4] ^ result[5] ^ result[6] ^ result[7]);
