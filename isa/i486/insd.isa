// SPDX-License-Identifier: BSD-3-Clause
// i486 INSD (0x6D)
// Input dword from port DX to [EDI], adjust EDI by 4 based on DF

isa_state eip[31:0];
var instr[7:0];

// 32-bit register file
isa_state xregs[31:0][2:0];

// Register aliases
isa_state EDI[31:0] of xregs[7];
isa_state DX[15:0] of xregs[2][15:0];

isa_state imem[7:0][31:0];
isa_state dmem[7:0][31:0];
isa_state io_ports[7:0][15:0];
isa_state flag_DF[0:0];

var new_edi[31:0];
var val_b0[7:0];
var val_b1[7:0];
var val_b2[7:0];
var val_b3[7:0];

// Fetch instruction
instr = imem[eip];
assume instr == 0x6D;

// Read dword from I/O port DX (little-endian)
val_b0 = io_ports[DX];
val_b1 = io_ports[DX + 1];
val_b2 = io_ports[DX + 2];
val_b3 = io_ports[DX + 3];

// Store dword to [EDI] (little-endian)
dmem[EDI] = val_b0;
dmem[EDI + 1] = val_b1;
dmem[EDI + 2] = val_b2;
dmem[EDI + 3] = val_b3;

// Adjust EDI based on direction flag
new_edi = flag_DF == 1'b0 ? EDI + 4 : EDI - 4;
EDI = new_edi;

// INSD does not affect flags

// Update EIP after all imem reads are complete
eip = eip + 1;
