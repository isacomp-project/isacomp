// SPDX-License-Identifier: BSD-3-Clause
// i486 SETB r/m8 with 67 prefix (0x67 0x0F 0x92) - 32-bit addressing mode
// Set destination byte to 1 if condition true, else 0

isa_state xregs[31:0][2:0];
isa_state eip[31:0];
var prefix[7:0];
var instr[7:0];
var instr2[7:0];
isa_state modrm[7:0];
var mod_bits[1:0];
var rm_bits[2:0];
isa_state imem[7:0][31:0];
isa_state dmem[7:0][31:0];
isa_state DS[15:0];

isa_state flag_CF[0:0];

var base_val[31:0];
var disp8[7:0];
var disp32_b0[7:0];
var disp32_b1[7:0];
var disp32_b2[7:0];
var disp32_b3[7:0];
var disp32[31:0];
var signed_disp8[31:0];
var offset[31:0];
var physical_addr[31:0];
var result[7:0];
var is_mem_dest[0:0];

prefix = imem[eip];
assume prefix == 0x67;

instr = imem[eip + 1];
assume instr == 0x0F;

instr2 = imem[eip + 2];
assume instr2 == 0x92;

modrm = imem[eip + 3];

mod_bits = modrm[7:6];
rm_bits = modrm[2:0];

base_val = xregs[rm_bits];

disp8 = imem[eip + 4];
disp32_b0 = imem[eip + 4];
disp32_b1 = imem[eip + 5];
disp32_b2 = imem[eip + 6];
disp32_b3 = imem[eip + 7];
disp32 = {disp32_b3, disp32_b2, disp32_b1, disp32_b0};
signed_disp8 = {{24{disp8[7]}}, disp8};

case (mod_bits) {
  2'b00: offset = base_val;
  2'b01: offset = base_val + signed_disp8;
  2'b10: offset = base_val + disp32;
  2'b11: offset = 32'h00000000;
}

case (mod_bits) {
  2'b00: is_mem_dest = 1'b1;
  2'b01: is_mem_dest = 1'b1;
  2'b10: is_mem_dest = 1'b1;
  2'b11: is_mem_dest = 1'b0;
}

case (mod_bits) {
  2'b00: eip = eip + 4;
  2'b01: eip = eip + 5;
  2'b10: eip = eip + 8;
  2'b11: eip = eip + 4;
}

physical_addr = ({16'h0000, DS} << 4) + offset;

result = (flag_CF == 1'b1) ? 8'd1 : 8'd0;

var write_sel[1:0];
var reg_idx[1:0];
write_sel = {is_mem_dest, rm_bits[2]};
reg_idx = rm_bits[1:0];
case (write_sel) {
  2'b00: xregs[reg_idx][7:0] = result;
  2'b01: xregs[reg_idx][15:8] = result;
  2'b10: dmem[physical_addr] = result;
  2'b11: dmem[physical_addr] = result;
}
