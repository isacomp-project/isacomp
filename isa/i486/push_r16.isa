// i486 PUSH r16 - WITH PROPER SEGMENTATION
// Opcodes: 0x50-0x57 (PUSH AX/CX/DX/BX/SP/BP/SI/DI)
// Uses SS segment for stack access

isa_state eip[31:0];
var instr[7:0];

// Word register file: EAX, ECX, EDX, EBX, ESP, EBP, ESI, EDI
isa_state xregs[31:0][2:0];

isa_state imem[7:0][31:0];
isa_state dmem[7:0][31:0];
isa_state SS[15:0];            // Stack segment register

var reg_idx[2:0];
var reg_val[15:0];
var offset_lo[31:0];             // 32-bit stack offset
var offset_hi[31:0];             // 32-bit stack offset + 1
var physical_addr_lo[31:0];      // 32-bit physical address
var physical_addr_hi[31:0];      // 32-bit physical address

// Fetch instruction
instr = imem[eip];

// Check this is a PUSH r16 instruction (0x50-0x57)
assume instr[7:3] == 0b01010;  // Upper 5 bits must be 01010

eip = eip + 1;

// Extract register index from lower 3 bits of opcode
reg_idx = instr[2:0];

// Read the register value using indexed access - get 16-bit view
reg_val = xregs[reg_idx][15:0];

// Decrement ESP by 2 (word size) - stack grows downward
// ESP is xregs[4], so read and write to it directly
xregs[4] = xregs[4] - 32'h00000002;

// Calculate stack offsets (ESP and ESP+1)
offset_lo = xregs[4];
offset_hi = xregs[4] + 32'h00000001;

// Calculate physical addresses using SS segment
physical_addr_lo = (SS << 4) + offset_lo;
physical_addr_hi = (SS << 4) + offset_hi;

// Write register to stack (little-endian: low byte at lower address)
dmem[physical_addr_lo] = reg_val[7:0];
dmem[physical_addr_hi] = reg_val[15:8];
