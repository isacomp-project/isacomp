// i486 POP r32 (0x58-0x5F) - Parameterized
// Opcodes: 0x58 (EAX), 0x59 (ECX), 0x5A (EDX), 0x5B (EBX),
//          0x5C (ESP), 0x5D (EBP), 0x5E (ESI), 0x5F (EDI)
// Pop value from stack into register

isa_state eip[31:0];
var instr[7:0];

// 32-bit register file: EAX(0), ECX(1), EDX(2), EBX(3), ESP(4), EBP(5), ESI(6), EDI(7)
isa_state xregs[31:0][2:0];

// Stack pointer alias
isa_state ESP[31:0] of xregs[4];

isa_state imem[7:0][31:0];
isa_state dmem[7:0][31:0];

var reg_idx[2:0];
var val_b0[7:0];
var val_b1[7:0];
var val_b2[7:0];
var val_b3[7:0];
var val[31:0];

// Fetch instruction
instr = imem[eip];

// Check this is a POP r32 instruction (0x58-0x5F)
assume instr[7:3] == 0b01011;  // Upper 5 bits must be 01011

eip = eip + 1;

// Extract register index from lower 3 bits of opcode
reg_idx = instr[2:0];

// Read value from stack (little-endian)
val_b0 = dmem[ESP];
val_b1 = dmem[ESP + 1];
val_b2 = dmem[ESP + 2];
val_b3 = dmem[ESP + 3];
val = {val_b3, val_b2, val_b1, val_b0};

// Increment ESP by 4 (32-bit pop)
ESP = ESP + 4;

// Store value in register
xregs[reg_idx] = val;

// POP does not affect flags
