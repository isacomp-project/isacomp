// SPDX-License-Identifier: BSD-3-Clause
// i486 LOOPNE/LOOPNZ rel8 (0xE0)
// Decrement CX, jump if CX != 0 AND ZF = 0
// Uses signed byte displacement relative to EIP
// Note: Uses 16-bit CX register, not 32-bit ECX

isa_state eip[31:0];
var instr[7:0];

// 32-bit register file
isa_state xregs[31:0][2:0];

isa_state imem[7:0][31:0];
isa_state flag_ZF[0:0];

var offset[7:0];
var signed_offset[31:0];
var target_addr[31:0];
var new_cx[15:0];
var cx[15:0];
var condition[0:0];

// Fetch instruction
instr = imem[eip];
assume instr == 0xE0;

// Read signed byte displacement
offset = imem[eip + 1];

// Sign-extend 8-bit offset to 32 bits
signed_offset = {{24{offset[7]}}, offset};

// Calculate target address (eip after instruction + signed offset)
target_addr = eip + 2 + signed_offset;

// Read CX (lower 16 bits of ECX)
cx = xregs[1][15:0];

// Decrement CX
new_cx = cx - 1;

// Write back CX (preserves upper 16 bits)
xregs[1] = {xregs[1][31:16], new_cx};

// Condition: CX != 0 AND ZF = 0
condition = (new_cx != 16'h0000) & (flag_ZF == 1'b0);

// Jump if condition is true
case (condition) {
  1'b1: eip = target_addr;
  1'b0: eip = eip + 2;
}
