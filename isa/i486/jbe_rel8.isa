// SPDX-License-Identifier: BSD-3-Clause
// i486 JBE rel8 (0x76) - Jump if Below or Equal (unsigned <=)
isa_state eip[31:0];
var instr[7:0];
isa_state imem[7:0][31:0];
isa_state flag_CF[0:0];
isa_state flag_ZF[0:0];

var rel8[7:0];
var offset[31:0];
var next_pc[31:0];
var jump_target[31:0];
var cf_or_zf[0:0];

instr = imem[eip];
assume instr == 0x76;

// Fetch rel8 and compute addresses
rel8 = imem[eip + 1];
next_pc = eip + 2;

// Sign-extend rel8 to 32 bits
offset = {{24{rel8[7]}}, rel8};

// Calculate jump target
jump_target = next_pc + offset;

// Condition: CF=1 OR ZF=1
cf_or_zf = flag_CF | flag_ZF;

case (cf_or_zf) {
  1'b1: eip = jump_target;
  1'b0: eip = next_pc;
}
