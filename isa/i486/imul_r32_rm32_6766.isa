// SPDX-License-Identifier: BSD-3-Clause
// i486 IMUL r32, r/m32 with 6766 prefix (0x67 0x66 0x0F 0xAF)
// 32-bit addressing mode

isa_state eip[31:0];
var prefix67[7:0];
var prefix[7:0];
var instr[7:0];
var instr2[7:0];
isa_state modrm[7:0];

isa_state xregs[31:0][2:0];

isa_state imem[7:0][31:0];
isa_state dmem[7:0][31:0];
isa_state flag_CF[0:0];
isa_state flag_OF[0:0];

var mod_bits[1:0];
var reg_bits[2:0];
var rm_bits[2:0];
var dst_val[31:0];
var src_val[31:0];
var result[63:0];
var sign_extend[63:0];

prefix67 = imem[eip];
assume prefix67 == 0x67;

prefix = imem[eip + 1];
assume prefix == 0x66;

instr = imem[eip + 2];
assume instr == 0x0F;

instr2 = imem[eip + 3];
assume instr2 == 0xAF;

modrm = imem[eip + 4];

mod_bits = modrm[7:6];
reg_bits = modrm[5:3];
rm_bits = modrm[2:0];

assume mod_bits == 0b11;

dst_val = xregs[reg_bits];
src_val = xregs[rm_bits];

result = dst_val * src_val;

xregs[reg_bits] = result[31:0];

sign_extend = result[31] ? {32'hFFFFFFFF, result[31:0]} : {32'h00000000, result[31:0]};

flag_CF = (result != sign_extend);
flag_OF = (result != sign_extend);

eip = eip + 5;
