// SPDX-License-Identifier: BSD-3-Clause
// i486 JMP rel8 with 66 prefix (0x66 0xEB)
// Unconditional Short Jump (66 prefix doesn't change displacement size)

isa_state eip[31:0];
var prefix[7:0];
var instr[7:0];
isa_state imem[7:0][31:0];

var rel8[7:0];
var offset[31:0];
var next_pc[31:0];

// Fetch 66 prefix
prefix = imem[eip];
assume prefix == 0x66;

// Fetch instruction
instr = imem[eip + 1];
assume instr == 0xEB;

// Fetch rel8 and compute addresses
rel8 = imem[eip + 2];
next_pc = eip + 3;

// Sign-extend rel8 to 32 bits
offset = {{24{rel8[7]}}, rel8};

// Unconditional jump to target
eip = next_pc + offset;
