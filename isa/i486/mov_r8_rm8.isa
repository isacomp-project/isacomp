// SPDX-License-Identifier: BSD-3-Clause
// i486 MOV r8, r/m8 (0x8A) - CONSOLIDATED ALL ADDRESSING MODES
// Move 8-bit r/m8 to register (register destination)
// Supports all addressing modes via ModR/M byte:
//   mod=00: [SI], [DI], [BX] - indirect
//   mod=01: [SI+disp8], [DI+disp8], [BX+disp8] - indirect + 8-bit displacement
//   mod=10: [SI+disp16], [DI+disp16], [BX+disp16] - indirect + 16-bit displacement
//   mod=11: AL, CL, DL, BL, AH, CH, DH, BH - register direct
// Register encoding: 0-3 = low byte (AL,CL,DL,BL), 4-7 = high byte (AH,CH,DH,BH)

isa_state xregs[31:0][2:0];    // 32-bit registers array
isa_state eip[31:0];
var instr[7:0];
isa_state modrm[7:0];
var mod_bits[1:0];
var reg_idx[2:0];
var rm_bits[2:0];
isa_state imem[7:0][31:0];
isa_state dmem[7:0][31:0];     // 4GB memory (32-bit addressing)
isa_state DS[15:0];            // Data segment register

var dst_idx[2:0];
var src_reg_idx[2:0];
var addr_reg_idx[2:0];
var base_offset[15:0];
var disp8[7:0];
var disp16_lo[7:0];
var disp16_hi[7:0];
var disp16[15:0];
var signed_disp8[15:0];
var offset[15:0];
var physical_addr[19:0];
var src_mem_val[7:0];
var src_reg_val[7:0];
var src_val[7:0];
var src_is_high[0:0];
var dst_is_high[0:0];
var result[7:0];
var is_mem_src[0:0];
var dst_reg_val[31:0];
var phys_dst_idx[2:0];

// Fetch instruction
instr = imem[eip];
assume instr == 0x8A;

// Fetch ModR/M byte
modrm = imem[eip + 1];

// Decode ModR/M
mod_bits = modrm[7:6];
reg_idx = modrm[5:3];
rm_bits = modrm[2:0];

dst_idx = reg_idx;
src_reg_idx = rm_bits;

// Pre-calculate address register index for memory modes
case (rm_bits) {
  0b100: addr_reg_idx = 3'b110;  // SI
  0b101: addr_reg_idx = 3'b111;  // DI
  0b111: addr_reg_idx = 3'b011;  // BX
}

// Read base offset from address register
base_offset = xregs[addr_reg_idx];

// Read potential displacement bytes
disp8 = imem[eip + 2];
disp16_lo = imem[eip + 2];
disp16_hi = imem[eip + 3];
disp16 = {disp16_hi, disp16_lo};
signed_disp8 = {{8{disp8[7]}}, disp8};

// Calculate offset based on addressing mode
case (mod_bits) {
  0b00: offset = base_offset;
  0b01: offset = base_offset + signed_disp8;
  0b10: offset = base_offset + disp16;
  0b11: offset = 16'h0000;
}

// Set source type flag
case (mod_bits) {
  0b00: is_mem_src = 1'b1;
  0b01: is_mem_src = 1'b1;
  0b10: is_mem_src = 1'b1;
  0b11: is_mem_src = 1'b0;
}

// Advance IP based on displacement bytes consumed
case (mod_bits) {
  0b00: eip = eip + 2;
  0b01: eip = eip + 3;
  0b10: eip = eip + 4;
  0b11: eip = eip + 2;
}

// Calculate physical address for 8-bit memory access
physical_addr = (DS << 4) + offset;

// Read source from memory
src_mem_val = dmem[physical_addr];

// Determine if source register is high byte
case (src_reg_idx) {
  0b100: src_is_high = 1'b1;
  0b101: src_is_high = 1'b1;
  0b110: src_is_high = 1'b1;
  0b111: src_is_high = 1'b1;
}

// Read source value from register (handle high/low byte)
case (src_is_high) {
  1'b1: src_reg_val = xregs[src_reg_idx - 3'b100][15:8];  // High byte (AH,CH,DH,BH)
  1'b0: src_reg_val = xregs[src_reg_idx][7:0];             // Low byte (AL,CL,DL,BL)
}

// Select actual source value based on mode
case (is_mem_src) {
  1'b1: src_val = src_mem_val;
  1'b0: src_val = src_reg_val;
}

// Perform MOV operation (just copy source to result)
result = src_val;

// Determine if destination register is high byte
case (dst_idx) {
  0b100: dst_is_high = 1'b1;
  0b101: dst_is_high = 1'b1;
  0b110: dst_is_high = 1'b1;
  0b111: dst_is_high = 1'b1;
}

// Calculate physical register index for high byte access
case (dst_is_high) {
  1'b1: phys_dst_idx = dst_idx - 3'b100;
  1'b0: phys_dst_idx = dst_idx;
}

// Read current destination register value
dst_reg_val = xregs[phys_dst_idx];

// Write result to destination register, preserving upper bits
case (dst_is_high) {
  1'b1: xregs[phys_dst_idx] = {dst_reg_val[31:16], result, dst_reg_val[7:0]};  // High byte
  1'b0: xregs[phys_dst_idx] = {dst_reg_val[31:8], result};  // Low byte
}
