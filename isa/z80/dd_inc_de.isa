// Z80 DD 13 - DD prefix passthrough
// DD prefix consumed, base opcode 13 executes unchanged


isa_state pc[15:0];
var dd_instr[15:0];
var pc_plus_1[15:0];
isa_state D[7:0];
isa_state E[7:0];
mem mainmem[15:0];

var de[15:0];
var de_plus_1[15:0];

pc_plus_1 = pc + 1;
dd_instr = {mainmem[pc_plus_1], mainmem[pc]};
assume dd_instr == 16'h13DD;
pc = pc + 2;

de = {D, E};
de_plus_1 = de + 1;

D = de_plus_1[15:8];
E = de_plus_1[7:0];