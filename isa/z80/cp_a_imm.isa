// SPDX-License-Identifier: BSD-3-Clause
// Z80 CP n (0xFE) - Compare immediate with A
// A - n (result discarded, only flags set)
// Affects: S, Z, H, P/V, N=1, C

isa_state pc[15:0];
var instr[7:0];
isa_state A[7:0];
mem mainmem[15:0];
isa_state flag_S[0:0];
isa_state flag_Z[0:0];
isa_state flag_H[0:0];
isa_state flag_PV[0:0];
isa_state flag_N[0:0];
isa_state flag_C[0:0];

var imm[7:0];
var result[8:0];

instr = mainmem[pc];
assume instr == 0xFE;
pc = pc + 1;
imm = mainmem[pc];
pc = pc + 1;

result = A - imm;

// Flags (same as SUB but A not modified)
flag_S = result[7];
flag_Z = result[7:0] == 0 ? 1'b1 : 1'b0;
flag_H = (A[3:0] < imm[3:0]) ? 1'b1 : 1'b0;
flag_PV = (A[7] != imm[7]) & (A[7] != result[7]) ? 1'b1 : 1'b0;
flag_N = 1'b1;
flag_C = A < imm ? 1'b1 : 1'b0;
// A is NOT modified
