// SPDX-License-Identifier: BSD-3-Clause
// Z80 ED AB - OUTD (Output and Decrement)
// port[C] = (HL), HL--, B--
// Affects Z=(B==0 after), N=1, other flags undefined

isa_state pc[15:0];
var ed_instr[15:0];
var pc_plus_1[15:0];
isa_state H[7:0];
isa_state L[7:0];
isa_state B[7:0];
isa_state C[7:0];
isa_state flag_Z;
isa_state flag_N;
isa_state io[7:0][7:0];
mem mainmem[15:0];

pc_plus_1 = pc + 1;
ed_instr = {mainmem[pc_plus_1], mainmem[pc]};
assume ed_instr == 0xABED;
pc = pc_plus_1 + 1;

var outd_hl_addr[15:0];
outd_hl_addr = {H, L};

var outd_value[7:0];
outd_value = mainmem[outd_hl_addr];
io[C] = outd_value;

var outd_hl_new[15:0];
outd_hl_new = outd_hl_addr - 1;
var outd_b_new[7:0];
outd_b_new = B - 1;

H = outd_hl_new[15:8];
L = outd_hl_new[7:0];
B = outd_b_new;

flag_Z = (outd_b_new == 8'h00) ? 1'b1 : 1'b0;
flag_N = 1'b1;
