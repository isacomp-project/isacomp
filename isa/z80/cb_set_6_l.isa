// SPDX-License-Identifier: BSD-3-Clause
// Z80 CB F5 - SET 6,L (Set bit 6)
// Does not affect flags

isa_state pc[15:0];
var cb_instr[15:0];
var pc_plus_1[15:0];
isa_state L[7:0];
mem mainmem[15:0];

pc_plus_1 = pc + 1;
cb_instr = {mainmem[pc_plus_1], mainmem[pc]};
assume cb_instr == 0xF5CB;
pc = pc_plus_1 + 1;

// Set bit 6
L = L | 8'h40;
