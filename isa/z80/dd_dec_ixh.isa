// SPDX-License-Identifier: BSD-3-Clause
// Z80 DD 25 - DEC IXH (undocumented)
// IXH = IXH - 1
// Affects: S, Z, H, P/V, N=1 (C not affected)

isa_state pc[15:0];
var dd_instr[15:0];
var pc_plus_1[15:0];
isa_state IXH[7:0];
mem mainmem[15:0];
isa_state flag_S[0:0];
isa_state flag_Z[0:0];
isa_state flag_H[0:0];
isa_state flag_PV[0:0];
isa_state flag_N[0:0];

var result[7:0];

pc_plus_1 = pc + 1;
dd_instr = {mainmem[pc_plus_1], mainmem[pc]};
assume dd_instr == 16'h25DD;
pc = pc_plus_1 + 1;

result = IXH - 1;

flag_S = result[7];
flag_Z = result == 0 ? 1'b1 : 1'b0;
flag_H = (IXH[3:0] == 4'h0) ? 1'b1 : 1'b0;
flag_PV = (IXH == 8'h80) ? 1'b1 : 1'b0;
flag_N = 1'b1;

IXH = result;
