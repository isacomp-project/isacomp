// Z80 DD 74 d - LD (IX+d),H
// Does not affect flags

isa_state pc[15:0];
var dd_instr[15:0];
var pc_plus_1[15:0];
var pc_plus_2[15:0];
isa_state IXH[7:0];
isa_state IXL[7:0];
isa_state H[7:0];
mem mainmem[15:0];
var d[7:0];
var d_sext[15:0];
var dd_ld_ix_d_h_addr[15:0];

pc_plus_1 = pc + 1;
pc_plus_2 = pc_plus_1 + 1;
dd_instr = {mainmem[pc_plus_1], mainmem[pc]};
assume dd_instr == 16'h74DD;

d = mainmem[pc_plus_2];
d_sext = {{8{d[7]}}, d};
dd_ld_ix_d_h_addr = {IXH, IXL} + d_sext;
mainmem[dd_ld_ix_d_h_addr] = H;

pc = pc_plus_2 + 1;
