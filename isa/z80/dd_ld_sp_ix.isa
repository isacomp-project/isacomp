// SPDX-License-Identifier: BSD-3-Clause
// Z80 DD F9 - LD SP,IX (Load SP from IX)
// Does not affect flags

isa_state pc[15:0];
var dd_instr[15:0];
var pc_plus_1[15:0];
isa_state IXH[7:0];
isa_state IXL[7:0];
isa_state sp[15:0];
mem mainmem[15:0];

pc_plus_1 = pc + 1;
dd_instr = {mainmem[pc_plus_1], mainmem[pc]};
assume dd_instr == 16'hF9DD;

sp = {IXH, IXL};
pc = pc_plus_1 + 1;
