// SPDX-License-Identifier: BSD-3-Clause
// Z80 DI (0xF3) - Disable Interrupts
// IFF1 = 0, IFF2 = 0
// Does not affect flags

isa_state pc[15:0];
var instr[7:0];
isa_state int_ff1[0:0];
isa_state int_ff2[0:0];
mem mainmem[15:0];

instr = mainmem[pc];
assume instr == 0xF3;
pc = pc + 1;

int_ff1 = 0;
int_ff2 = 0;
