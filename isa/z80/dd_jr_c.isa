// SPDX-License-Identifier: BSD-3-Clause
// Z80 DD 38 - DD prefix passthrough JR C
// DD prefix consumed, JR C executes unchanged

isa_state pc[15:0];
var dd_instr[15:0];
var pc_plus_1[15:0];
isa_state flag_C;
mem mainmem[15:0];

var offset[7:0];
var offset_ext[15:0];
var target[15:0];

pc_plus_1 = pc + 1;
dd_instr = {mainmem[pc_plus_1], mainmem[pc]};
assume dd_instr == 16'h38DD;
pc = pc + 2;

offset = mainmem[pc];
pc = pc + 1;

offset_ext = {{8{offset[7]}}, offset};
target = pc + offset_ext;
pc = (flag_C == 1) ? target : pc;
