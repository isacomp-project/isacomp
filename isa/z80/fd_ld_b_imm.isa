// Z80 FD 06 - FD prefix passthrough
// FD prefix consumed, base opcode 06 executes unchanged


isa_state pc[15:0];
var fd_instr[15:0];
var pc_plus_1[15:0];
isa_state B[7:0];
mem mainmem[15:0];

var imm[7:0];

pc_plus_1 = pc + 1;
fd_instr = {mainmem[pc_plus_1], mainmem[pc]};
assume fd_instr == 16'h06FD;
pc = pc + 2;
imm = mainmem[pc];
pc = pc + 1;

B = imm;