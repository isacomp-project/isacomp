// SPDX-License-Identifier: BSD-3-Clause
// Z80 SCF (0x37) - Set Carry Flag
// C = 1
// Affects: H=0, N=0, C=1

isa_state pc[15:0];
var instr[7:0];
mem mainmem[15:0];
isa_state flag_H[0:0];
isa_state flag_N[0:0];
isa_state flag_C[0:0];

instr = mainmem[pc];
assume instr == 0x37;
pc = pc + 1;

flag_C = 1'b1;
flag_H = 1'b0;
flag_N = 1'b0;
