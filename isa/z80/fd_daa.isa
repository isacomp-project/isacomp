// SPDX-License-Identifier: BSD-3-Clause
// Z80 FD 27 - FD prefix passthrough DAA
// FD prefix consumed, DAA executes unchanged

isa_state pc[15:0];
var fd_instr[15:0];
var pc_plus_1[15:0];
isa_state A[7:0];
isa_state flag_S;
isa_state flag_Z;
isa_state flag_H;
isa_state flag_PV;
isa_state flag_N;
isa_state flag_C;
mem mainmem[15:0];

var fd_daa_corr[7:0];
var fd_daa_new_c[0:0];
var fd_daa_result[7:0];
var fd_daa_lo_gt9[0:0];
var fd_daa_a_gt99[0:0];
var fd_daa_add_lo[0:0];
var fd_daa_add_hi[0:0];

pc_plus_1 = pc + 1;
fd_instr = {mainmem[pc_plus_1], mainmem[pc]};
assume fd_instr == 16'h27FD;
pc = pc + 2;

// Check conditions
fd_daa_lo_gt9 = (A[3:0] > 4'h9);
fd_daa_a_gt99 = (A > 8'h99);

// Low nibble correction needed?
fd_daa_add_lo = flag_H | fd_daa_lo_gt9;

// High nibble correction needed?
fd_daa_add_hi = flag_C | fd_daa_a_gt99;

// Calculate correction value (0x00, 0x06, 0x60, or 0x66)
fd_daa_corr = {fd_daa_add_hi ? 4'h6 : 4'h0, fd_daa_add_lo ? 4'h6 : 4'h0};

// New carry is set if high correction was applied or carry was already set
fd_daa_new_c = flag_C | fd_daa_a_gt99;

// Apply correction based on N flag (add or subtract)
fd_daa_result = flag_N ? (A - fd_daa_corr) : (A + fd_daa_corr);

A = fd_daa_result;
flag_S = fd_daa_result[7];
flag_Z = (fd_daa_result == 8'b0);
flag_H = flag_N ? ((A[4] ^ fd_daa_result[4]) & flag_H) : (A[3:0] > 4'h9);
flag_PV = (fd_daa_result[7] ^ fd_daa_result[6] ^ fd_daa_result[5] ^ fd_daa_result[4] ^ fd_daa_result[3] ^ fd_daa_result[2] ^ fd_daa_result[1] ^ fd_daa_result[0]) == 0;
flag_C = fd_daa_new_c;
