// SPDX-License-Identifier: BSD-3-Clause
// Z80 LD D,n (0x16) - Load immediate value into D
// D = n
// Does not affect flags

isa_state pc[15:0];
var instr[7:0];
isa_state D[7:0];
mem mainmem[15:0];

var imm[7:0];

instr = mainmem[pc];
assume instr == 0x16;
pc = pc + 1;
imm = mainmem[pc];
pc = pc + 1;

D = imm;
