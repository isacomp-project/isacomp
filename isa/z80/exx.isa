// SPDX-License-Identifier: BSD-3-Clause
// Z80 EXX (0xD9) - Exchange BC,DE,HL with BC',DE',HL'
// Swaps register pairs with shadow registers
// Does not affect flags

isa_state pc[15:0];
var instr[7:0];
isa_state B[7:0];
isa_state C[7:0];
isa_state D[7:0];
isa_state E[7:0];
isa_state H[7:0];
isa_state L[7:0];
isa_state B_prime[7:0];
isa_state C_prime[7:0];
isa_state D_prime[7:0];
isa_state E_prime[7:0];
isa_state H_prime[7:0];
isa_state L_prime[7:0];
mem mainmem[15:0];
var exx_temp_b[7:0];
var exx_temp_c[7:0];
var exx_temp_d[7:0];
var exx_temp_e[7:0];
var exx_temp_h[7:0];
var exx_temp_l[7:0];

instr = mainmem[pc];
assume instr == 0xD9;
pc = pc + 1;

exx_temp_b = B;
exx_temp_c = C;
exx_temp_d = D;
exx_temp_e = E;
exx_temp_h = H;
exx_temp_l = L;

B = B_prime;
C = C_prime;
D = D_prime;
E = E_prime;
H = H_prime;
L = L_prime;

B_prime = exx_temp_b;
C_prime = exx_temp_c;
D_prime = exx_temp_d;
E_prime = exx_temp_e;
H_prime = exx_temp_h;
L_prime = exx_temp_l;
