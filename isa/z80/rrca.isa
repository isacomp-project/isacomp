// SPDX-License-Identifier: BSD-3-Clause
// Z80 RRCA (0x0F) - Rotate Right Circular Accumulator
// Bit 0 goes to Carry and also wraps to bit 7
// Affects: H=0, N=0, C

isa_state pc[15:0];
var instr[7:0];
isa_state A[7:0];
mem mainmem[15:0];
isa_state flag_H[0:0];
isa_state flag_N[0:0];
isa_state flag_C[0:0];

var result[7:0];
var bit0[0:0];

instr = mainmem[pc];
assume instr == 0x0F;
pc = pc + 1;

bit0 = A[0];
result = {bit0, A[7:1]};

flag_C = bit0;
flag_H = 1'b0;
flag_N = 1'b0;

A = result;
