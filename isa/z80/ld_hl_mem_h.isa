// SPDX-License-Identifier: BSD-3-Clause
// Z80 LD (HL),H (0x74) - Store H to memory at HL
// (HL) = H
// Does not affect flags

isa_state pc[15:0];
var instr[7:0];
isa_state H[7:0];
isa_state H[7:0];
isa_state L[7:0];
mem mainmem[15:0];
var addr[15:0];

instr = mainmem[pc];
assume instr == 0x74;
pc = pc + 1;

addr = {H, L};
mainmem[addr] = H;
