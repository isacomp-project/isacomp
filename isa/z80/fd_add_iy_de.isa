// SPDX-License-Identifier: BSD-3-Clause
// Z80 FD 19 - ADD IY,DE (Add DE to IY)
// Affects H, N=0, C

isa_state pc[15:0];
var fd_instr[15:0];
var pc_plus_1[15:0];
isa_state IYH[7:0];
isa_state IYL[7:0];
isa_state D[7:0];
isa_state E[7:0];
isa_state flag_H;
isa_state flag_N;
isa_state flag_C;
mem mainmem[15:0];

pc_plus_1 = pc + 1;
fd_instr = {mainmem[pc_plus_1], mainmem[pc]};
assume fd_instr == 16'h19FD;

var iy_val[15:0];
iy_val = {IYH, IYL};
var de_val[15:0];
de_val = {D, E};

var iy_new[16:0];
iy_new = {1'b0, iy_val} + {1'b0, de_val};

IYH = iy_new[15:8];
IYL = iy_new[7:0];

flag_H = ((iy_val[11:0] + de_val[11:0]) > 12'hFFF) ? 1'b1 : 1'b0;
flag_N = 1'b0;
flag_C = iy_new[16];

pc = pc_plus_1 + 1;
