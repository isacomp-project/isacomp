// SPDX-License-Identifier: BSD-3-Clause
// Z80 ED BA - INDR (Input, Decrement, Repeat)
// Repeat: (HL) = port[C], HL--, B-- until B == 0
// PC stays same while B != 0, advances when B == 0
// Affects Z=1 (always when done), N=1

isa_state pc[15:0];
var ed_instr[15:0];
var pc_plus_1[15:0];
var indr_pc_next[15:0];
isa_state H[7:0];
isa_state L[7:0];
isa_state B[7:0];
isa_state C[7:0];
isa_state flag_Z;
isa_state flag_N;
isa_state io[7:0][7:0];
mem mainmem[15:0];

pc_plus_1 = pc + 1;
indr_pc_next = pc_plus_1 + 1;
ed_instr = {mainmem[pc_plus_1], mainmem[pc]};
assume ed_instr == 0xBAED;

var indr_hl_addr[15:0];
indr_hl_addr = {H, L};

var indr_value[7:0];
indr_value = io[C];
mainmem[indr_hl_addr] = indr_value;

var indr_hl_new[15:0];
indr_hl_new = indr_hl_addr - 1;
var indr_b_new[7:0];
indr_b_new = B - 1;

H = indr_hl_new[15:8];
L = indr_hl_new[7:0];
B = indr_b_new;

flag_N = 1'b1;

// B != 0: stay at same PC (repeat), Z = 0
// B == 0: advance PC (done), Z = 1
var indr_b_zero[0:0];
indr_b_zero = (indr_b_new == 8'h00);
var indr_next_pc[15:0];
indr_next_pc = indr_b_zero ? indr_pc_next : pc;
pc = indr_next_pc;
flag_Z = (indr_b_new == 8'h00) ? 1'b1 : 1'b0;
