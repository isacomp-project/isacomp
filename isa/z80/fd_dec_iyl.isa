// SPDX-License-Identifier: BSD-3-Clause
// Z80 FD 2D - DEC IYL (undocumented)
// IYL = IYL - 1
// Affects: S, Z, H, P/V, N=1 (C not affected)

isa_state pc[15:0];
var fd_instr[15:0];
var pc_plus_1[15:0];
isa_state IYL[7:0];
mem mainmem[15:0];
isa_state flag_S[0:0];
isa_state flag_Z[0:0];
isa_state flag_H[0:0];
isa_state flag_PV[0:0];
isa_state flag_N[0:0];

var result[7:0];

pc_plus_1 = pc + 1;
fd_instr = {mainmem[pc_plus_1], mainmem[pc]};
assume fd_instr == 16'h2DFD;
pc = pc_plus_1 + 1;

result = IYL - 1;

flag_S = result[7];
flag_Z = result == 0 ? 1'b1 : 1'b0;
flag_H = (IYL[3:0] == 4'h0) ? 1'b1 : 1'b0;
flag_PV = (IYL == 8'h80) ? 1'b1 : 1'b0;
flag_N = 1'b1;

IYL = result;
