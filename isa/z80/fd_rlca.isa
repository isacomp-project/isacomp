// Z80 FD 07 - FD prefix passthrough
// FD prefix consumed, base opcode 07 executes unchanged


isa_state pc[15:0];
var fd_instr[15:0];
var pc_plus_1[15:0];
isa_state A[7:0];
mem mainmem[15:0];
isa_state flag_H[0:0];
isa_state flag_N[0:0];
isa_state flag_C[0:0];

var result[7:0];
var bit7[0:0];

pc_plus_1 = pc + 1;
fd_instr = {mainmem[pc_plus_1], mainmem[pc]};
assume fd_instr == 16'h07FD;
pc = pc + 2;

bit7 = A[7];
result = {A[6:0], bit7};

flag_C = bit7;
flag_H = 1'b0;
flag_N = 1'b0;

A = result;