// SPDX-License-Identifier: BSD-3-Clause
// Z80 DEC (HL) (0x35) - DECrement memory at HL
// (HL) = (HL) - 1
// Affects S, Z, H, P/V, N flags (not C)

isa_state pc[15:0];
var instr[7:0];
isa_state H[7:0];
isa_state L[7:0];
isa_state flag_S;
isa_state flag_Z;
isa_state flag_H;
isa_state flag_PV;
isa_state flag_N;
mem mainmem[15:0];
var addr[15:0];
var value[7:0];
var result[7:0];

instr = mainmem[pc];
assume instr == 0x35;
pc = pc + 1;

addr = {H, L};
value = mainmem[addr];
result = value - 1;

mainmem[addr] = result;
flag_S = result[7];
flag_Z = (result == 8'b0);
flag_H = (value[3:0] == 4'b0000);
flag_PV = (value == 8'h80);
flag_N = 1;
