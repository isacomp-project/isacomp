// Z80 FD 9F - FD prefix passthrough
// FD prefix consumed, base opcode 9F executes unchanged


isa_state pc[15:0];
var fd_instr[15:0];
var pc_plus_1[15:0];
isa_state A[7:0];
isa_state flag_S;
isa_state flag_Z;
isa_state flag_H;
isa_state flag_PV;
isa_state flag_N;
isa_state flag_C;
mem mainmem[15:0];

pc_plus_1 = pc + 1;
fd_instr = {mainmem[pc_plus_1], mainmem[pc]};
assume fd_instr == 16'h9FFD;
pc = pc + 2;

var borrow_in[7:0];
borrow_in = {7'b0, flag_C};
var result[8:0];
result = {1'b0, A} - {1'b0, A} - {1'b0, borrow_in};
var half[4:0];
half = {1'b0, A[3:0]} - {1'b0, A[3:0]} - {1'b0, borrow_in[0]};

A = result[7:0];
flag_S = result[7];
flag_Z = (result[7:0] == 8'b0);
flag_H = half[4];
flag_PV = ((A[7] ^ A[7]) & (A[7] ^ result[7]));
flag_N = 1;
flag_C = result[8];