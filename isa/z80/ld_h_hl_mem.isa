// SPDX-License-Identifier: BSD-3-Clause
// Z80 LD H,(HL) (0x66) - Load H from memory at HL
// H = (HL)
// Does not affect flags

isa_state pc[15:0];
var instr[7:0];
isa_state H[7:0];
isa_state H[7:0];
isa_state L[7:0];
mem mainmem[15:0];
var addr[15:0];

instr = mainmem[pc];
assume instr == 0x66;
pc = pc + 1;

addr = {H, L};
H = mainmem[addr];
