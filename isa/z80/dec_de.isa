// SPDX-License-Identifier: BSD-3-Clause
// Z80 DEC DE (0x1B) - Decrement DE register pair
// DE = DE - 1
// Does not affect flags

isa_state pc[15:0];
var instr[7:0];
isa_state D[7:0];
isa_state E[7:0];
mem mainmem[15:0];

var de[15:0];
var de_minus_1[15:0];

instr = mainmem[pc];
assume instr == 0x1B;
pc = pc + 1;

de = {D, E};
de_minus_1 = de - 1;

D = de_minus_1[15:8];
E = de_minus_1[7:0];
