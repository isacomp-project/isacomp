// SPDX-License-Identifier: BSD-3-Clause
// Z80 DD 27 - DD prefix passthrough DAA
// DD prefix consumed, DAA executes unchanged

isa_state pc[15:0];
var dd_instr[15:0];
var pc_plus_1[15:0];
isa_state A[7:0];
isa_state flag_S;
isa_state flag_Z;
isa_state flag_H;
isa_state flag_PV;
isa_state flag_N;
isa_state flag_C;
mem mainmem[15:0];

var dd_daa_corr[7:0];
var dd_daa_new_c[0:0];
var dd_daa_result[7:0];
var dd_daa_lo_gt9[0:0];
var dd_daa_a_gt99[0:0];
var dd_daa_add_lo[0:0];
var dd_daa_add_hi[0:0];

pc_plus_1 = pc + 1;
dd_instr = {mainmem[pc_plus_1], mainmem[pc]};
assume dd_instr == 16'h27DD;
pc = pc + 2;

// Check conditions
dd_daa_lo_gt9 = (A[3:0] > 4'h9);
dd_daa_a_gt99 = (A > 8'h99);

// Low nibble correction needed?
dd_daa_add_lo = flag_H | dd_daa_lo_gt9;

// High nibble correction needed?
dd_daa_add_hi = flag_C | dd_daa_a_gt99;

// Calculate correction value (0x00, 0x06, 0x60, or 0x66)
dd_daa_corr = {dd_daa_add_hi ? 4'h6 : 4'h0, dd_daa_add_lo ? 4'h6 : 4'h0};

// New carry is set if high correction was applied or carry was already set
dd_daa_new_c = flag_C | dd_daa_a_gt99;

// Apply correction based on N flag (add or subtract)
dd_daa_result = flag_N ? (A - dd_daa_corr) : (A + dd_daa_corr);

A = dd_daa_result;
flag_S = dd_daa_result[7];
flag_Z = (dd_daa_result == 8'b0);
flag_H = flag_N ? ((A[4] ^ dd_daa_result[4]) & flag_H) : (A[3:0] > 4'h9);
flag_PV = (dd_daa_result[7] ^ dd_daa_result[6] ^ dd_daa_result[5] ^ dd_daa_result[4] ^ dd_daa_result[3] ^ dd_daa_result[2] ^ dd_daa_result[1] ^ dd_daa_result[0]) == 0;
flag_C = dd_daa_new_c;
