// Z80 FD D1 - FD prefix passthrough
// FD prefix consumed, base opcode D1 executes unchanged


isa_state pc[15:0];
var fd_instr[15:0];
var pc_plus_1[15:0];
isa_state sp[15:0];
isa_state D[7:0];
isa_state E[7:0];
mem mainmem[15:0];

var sp_plus_1[15:0];
var sp_plus_2[15:0];

pc_plus_1 = pc + 1;
fd_instr = {mainmem[pc_plus_1], mainmem[pc]};
assume fd_instr == 16'hD1FD;
pc = pc + 2;

E = mainmem[sp];
sp_plus_1 = sp + 1;
D = mainmem[sp_plus_1];
sp_plus_2 = sp_plus_1 + 1;

sp = sp_plus_2;