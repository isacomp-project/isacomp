// SPDX-License-Identifier: BSD-3-Clause
// Z80 DD D5 - DD prefix passthrough
// DD prefix consumed, base opcode D5 executes unchanged


isa_state pc[15:0];
var dd_instr[15:0];
var pc_plus_1[15:0];
isa_state sp[15:0];
isa_state D[7:0];
isa_state E[7:0];
mem mainmem[15:0];

var sp_minus_1[15:0];
var sp_minus_2[15:0];

pc_plus_1 = pc + 1;
dd_instr = {mainmem[pc_plus_1], mainmem[pc]};
assume dd_instr == 16'hD5DD;
pc = pc + 2;

sp_minus_1 = sp - 1;
mainmem[sp_minus_1] = D;

sp_minus_2 = sp_minus_1 - 1;
mainmem[sp_minus_2] = E;

sp = sp_minus_2;