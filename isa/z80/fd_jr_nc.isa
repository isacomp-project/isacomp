// SPDX-License-Identifier: BSD-3-Clause
// Z80 FD 30 - FD prefix passthrough JR NC
// FD prefix consumed, JR NC executes unchanged

isa_state pc[15:0];
var fd_instr[15:0];
var pc_plus_1[15:0];
isa_state flag_C;
mem mainmem[15:0];

var offset[7:0];
var offset_ext[15:0];

pc_plus_1 = pc + 1;
fd_instr = {mainmem[pc_plus_1], mainmem[pc]};
assume fd_instr == 16'h30FD;
pc = pc + 2;

offset = mainmem[pc];
pc = pc + 1;

offset_ext = {{8{offset[7]}}, offset};
pc = (flag_C == 0) ? (pc + offset_ext) : pc;
