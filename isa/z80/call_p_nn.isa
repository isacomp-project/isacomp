// SPDX-License-Identifier: BSD-3-Clause
// Z80 CALL P,nn (0xF4) - Call if P
// If condition met: Push PC+3, PC = nn
// Does not affect flags

isa_state pc[15:0];
var instr[7:0];
isa_state sp[15:0];
isa_state flag_S;
mem mainmem[15:0];
var pc_plus_1[15:0];
var pc_plus_2[15:0];
var pc_plus_3[15:0];
var sp_minus_1[15:0];
var sp_minus_2[15:0];
var target[15:0];
var do_call[0:0];

instr = mainmem[pc];
assume instr == 0xF4;
pc_plus_1 = pc + 1;
pc_plus_2 = pc_plus_1 + 1;
pc_plus_3 = pc_plus_2 + 1;

target = {mainmem[pc_plus_2], mainmem[pc_plus_1]};
sp_minus_1 = sp - 1;
sp_minus_2 = sp_minus_1 - 1;
do_call = (flag_S == 0);

mainmem[sp_minus_1] when (do_call) = pc_plus_3[15:8];
mainmem[sp_minus_2] when (do_call) = pc_plus_3[7:0];
sp = do_call ? sp_minus_2 : sp;
pc = do_call ? target : pc_plus_3;
