// SPDX-License-Identifier: BSD-3-Clause
// Z80 ED B9 - CPDR (Compare, Decrement, Repeat)
// Repeat: A - (HL), HL--, BC-- until BC == 0 OR A == (HL)
// PC stays same while BC != 0 AND A != (HL)
// Affects S, Z, H, P/V=(BC!=0), N=1

isa_state pc[15:0];
var ed_instr[15:0];
var pc_plus_1[15:0];
var cpdr_pc_next[15:0];
isa_state H[7:0];
isa_state L[7:0];
isa_state B[7:0];
isa_state C[7:0];
isa_state A[7:0];
isa_state flag_S;
isa_state flag_Z;
isa_state flag_H;
isa_state flag_PV;
isa_state flag_N;
mem mainmem[15:0];

pc_plus_1 = pc + 1;
cpdr_pc_next = pc_plus_1 + 1;
ed_instr = {mainmem[pc_plus_1], mainmem[pc]};
assume ed_instr == 0xB9ED;

var cpdr_hl_addr[15:0];
cpdr_hl_addr = {H, L};
var cpdr_bc_val[15:0];
cpdr_bc_val = {B, C};

var cpdr_value[7:0];
cpdr_value = mainmem[cpdr_hl_addr];
var cpdr_result[7:0];
cpdr_result = A - cpdr_value;

var cpdr_hl_new[15:0];
cpdr_hl_new = cpdr_hl_addr - 1;
var cpdr_bc_new[15:0];
cpdr_bc_new = cpdr_bc_val - 1;

H = cpdr_hl_new[15:8];
L = cpdr_hl_new[7:0];
B = cpdr_bc_new[15:8];
C = cpdr_bc_new[7:0];

flag_S = cpdr_result[7];
flag_Z = (cpdr_result == 8'h00) ? 1'b1 : 1'b0;
flag_H = (A[3:0] < cpdr_value[3:0]) ? 1'b1 : 1'b0;
flag_PV = (cpdr_bc_new != 16'h0000) ? 1'b1 : 1'b0;
flag_N = 1'b1;

// Continue if BC != 0 AND no match (Z == 0)
// Stop if BC == 0 OR match found (Z == 1)
var cpdr_bc_zero[0:0];
cpdr_bc_zero = (cpdr_bc_new == 16'h0000);
var cpdr_match[0:0];
cpdr_match = (cpdr_result == 8'h00);
var cpdr_done[0:0];
cpdr_done = cpdr_bc_zero | cpdr_match;
var cpdr_next_pc[15:0];
cpdr_next_pc = cpdr_done ? cpdr_pc_next : pc;
pc = cpdr_next_pc;
