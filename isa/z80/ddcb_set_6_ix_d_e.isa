// SPDX-License-Identifier: BSD-3-Clause
// Z80 DDCB d F3 - SET 6,(IX+d),E
// Does not affect flags

isa_state pc[15:0];
var ddcb_prefix[15:0];
var pc_plus_1[15:0];
var pc_plus_2[15:0];
var pc_plus_3[15:0];
isa_state IXH[7:0];
isa_state IXL[7:0];
isa_state E[7:0];
mem mainmem[15:0];
var d[7:0];
var d_sext[15:0];
var addr[15:0];
var value[7:0];
var result[7:0];
var op_byte[7:0];

pc_plus_1 = pc + 1;
pc_plus_2 = pc + 2;
pc_plus_3 = pc + 3;

// Read DD CB prefix
ddcb_prefix = {mainmem[pc_plus_1], mainmem[pc]};
assume ddcb_prefix == 16'hCBDD;

// Read displacement and opcode
d = mainmem[pc_plus_2];
op_byte = mainmem[pc_plus_3];
assume op_byte == 8'hF3;
pc = pc_plus_3 + 1;

// Calculate address IX + d (signed)
d_sext = {{8{d[7]}}, d};
addr = {IXH, IXL} + d_sext;
value = mainmem[addr];

result = value | 8'h40;

mainmem[addr] = result;
E = result;
