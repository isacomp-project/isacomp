// SPDX-License-Identifier: BSD-3-Clause
// Z80 FD 0B - FD prefix passthrough
// FD prefix consumed, base opcode 0B executes unchanged


isa_state pc[15:0];
var fd_instr[15:0];
var pc_plus_1[15:0];
isa_state B[7:0];
isa_state C[7:0];
mem mainmem[15:0];

var bc[15:0];
var bc_minus_1[15:0];

pc_plus_1 = pc + 1;
fd_instr = {mainmem[pc_plus_1], mainmem[pc]};
assume fd_instr == 16'h0BFD;
pc = pc + 2;

bc = {B, C};
bc_minus_1 = bc - 1;

B = bc_minus_1[15:8];
C = bc_minus_1[7:0];