// SPDX-License-Identifier: BSD-3-Clause
// Z80 DD C1 - DD prefix passthrough
// DD prefix consumed, base opcode C1 executes unchanged


isa_state pc[15:0];
var dd_instr[15:0];
var pc_plus_1[15:0];
isa_state sp[15:0];
isa_state B[7:0];
isa_state C[7:0];
mem mainmem[15:0];

var sp_plus_1[15:0];
var sp_plus_2[15:0];

pc_plus_1 = pc + 1;
dd_instr = {mainmem[pc_plus_1], mainmem[pc]};
assume dd_instr == 16'hC1DD;
pc = pc + 2;

C = mainmem[sp];
sp_plus_1 = sp + 1;
B = mainmem[sp_plus_1];
sp_plus_2 = sp_plus_1 + 1;

sp = sp_plus_2;