// SPDX-License-Identifier: BSD-3-Clause
// Z80 ED 4B - LD BC,(nn)
// Load BC from memory address nn
// Does not affect flags

isa_state pc[15:0];
var ed_instr[15:0];
var pc_plus_1[15:0];
var pc_plus_2[15:0];
var pc_plus_3[15:0];
isa_state B[7:0];
isa_state C[7:0];
mem mainmem[15:0];
var addr[15:0];
var addr_plus_1[15:0];

pc_plus_1 = pc + 1;
ed_instr = {mainmem[pc_plus_1], mainmem[pc]};
assume ed_instr == 0x4BED;

pc_plus_2 = pc_plus_1 + 1;
pc_plus_3 = pc_plus_2 + 1;

addr = {mainmem[pc_plus_3], mainmem[pc_plus_2]};
addr_plus_1 = addr + 1;

pc = pc_plus_3 + 1;

C = mainmem[addr];
B = mainmem[addr_plus_1];
