// SPDX-License-Identifier: BSD-3-Clause
// Z80 DD 0E - DD prefix passthrough
// DD prefix consumed, base opcode 0E executes unchanged


isa_state pc[15:0];
var dd_instr[15:0];
var pc_plus_1[15:0];
isa_state C[7:0];
mem mainmem[15:0];

var imm[7:0];

pc_plus_1 = pc + 1;
dd_instr = {mainmem[pc_plus_1], mainmem[pc]};
assume dd_instr == 16'h0EDD;
pc = pc + 2;
imm = mainmem[pc];
pc = pc + 1;

C = imm;