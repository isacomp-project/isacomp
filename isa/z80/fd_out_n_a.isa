// SPDX-License-Identifier: BSD-3-Clause
// Z80 FD D3 - FD prefix passthrough OUT (n),A
// FD prefix consumed, OUT (n),A executes unchanged

isa_state pc[15:0];
var fd_instr[15:0];
var pc_plus_1[15:0];
isa_state A[7:0];
isa_state io[7:0][7:0];
mem mainmem[15:0];

var fd_out_port[7:0];

pc_plus_1 = pc + 1;
fd_instr = {mainmem[pc_plus_1], mainmem[pc]};
assume fd_instr == 16'hD3FD;
pc = pc + 2;

fd_out_port = mainmem[pc];
io[fd_out_port] = A;
pc = pc + 1;
