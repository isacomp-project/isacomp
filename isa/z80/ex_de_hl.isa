// SPDX-License-Identifier: BSD-3-Clause
// Z80 EX DE,HL (0xEB) - Exchange DE and HL
// DE <-> HL
// Does not affect flags

isa_state pc[15:0];
var instr[7:0];
isa_state D[7:0];
isa_state E[7:0];
isa_state H[7:0];
isa_state L[7:0];
mem mainmem[15:0];

var old_d[7:0];
var old_e[7:0];

instr = mainmem[pc];
assume instr == 0xEB;
pc = pc + 1;

old_d = D;
old_e = E;

D = H;
E = L;
H = old_d;
L = old_e;
