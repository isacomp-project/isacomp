// SPDX-License-Identifier: BSD-3-Clause
// Z80 FD B7 - FD prefix passthrough
// FD prefix consumed, base opcode B7 executes unchanged


isa_state pc[15:0];
var fd_instr[15:0];
var pc_plus_1[15:0];
isa_state A[7:0];
isa_state flag_S;
isa_state flag_Z;
isa_state flag_H;
isa_state flag_PV;
isa_state flag_N;
isa_state flag_C;
mem mainmem[15:0];

pc_plus_1 = pc + 1;
fd_instr = {mainmem[pc_plus_1], mainmem[pc]};
assume fd_instr == 16'hB7FD;
pc = pc + 2;

A = A | A;
flag_S = A[7];
flag_Z = (A == 8'b0);
flag_H = 0;
flag_PV = (A[7] ^ A[6] ^ A[5] ^ A[4] ^ A[3] ^ A[2] ^ A[1] ^ A[0]) == 0;
flag_N = 0;
flag_C = 0;