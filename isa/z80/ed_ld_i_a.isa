// SPDX-License-Identifier: BSD-3-Clause
// Z80 ED 47 - LD I,A (Load A into Interrupt Vector register)
// Does not affect flags

isa_state pc[15:0];
var ed_instr[15:0];
var pc_plus_1[15:0];
isa_state A[7:0];
isa_state I[7:0];
mem mainmem[15:0];

pc_plus_1 = pc + 1;
ed_instr = {mainmem[pc_plus_1], mainmem[pc]};
assume ed_instr == 0x47ED;
pc = pc_plus_1 + 1;

I = A;
