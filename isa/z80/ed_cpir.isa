// SPDX-License-Identifier: BSD-3-Clause
// Z80 ED B1 - CPIR (Compare, Increment, Repeat)
// Repeat: A - (HL), HL++, BC-- until BC == 0 OR A == (HL)
// PC stays same while BC != 0 AND A != (HL)
// Affects S, Z, H, P/V=(BC!=0), N=1

isa_state pc[15:0];
var ed_instr[15:0];
var pc_plus_1[15:0];
var cpir_pc_next[15:0];
isa_state H[7:0];
isa_state L[7:0];
isa_state B[7:0];
isa_state C[7:0];
isa_state A[7:0];
isa_state flag_S;
isa_state flag_Z;
isa_state flag_H;
isa_state flag_PV;
isa_state flag_N;
mem mainmem[15:0];

pc_plus_1 = pc + 1;
cpir_pc_next = pc_plus_1 + 1;
ed_instr = {mainmem[pc_plus_1], mainmem[pc]};
assume ed_instr == 0xB1ED;

var cpir_hl_addr[15:0];
cpir_hl_addr = {H, L};
var cpir_bc_val[15:0];
cpir_bc_val = {B, C};

var cpir_value[7:0];
cpir_value = mainmem[cpir_hl_addr];
var cpir_result[7:0];
cpir_result = A - cpir_value;

var cpir_hl_new[15:0];
cpir_hl_new = cpir_hl_addr + 1;
var cpir_bc_new[15:0];
cpir_bc_new = cpir_bc_val - 1;

H = cpir_hl_new[15:8];
L = cpir_hl_new[7:0];
B = cpir_bc_new[15:8];
C = cpir_bc_new[7:0];

flag_S = cpir_result[7];
flag_Z = (cpir_result == 8'h00) ? 1'b1 : 1'b0;
flag_H = (A[3:0] < cpir_value[3:0]) ? 1'b1 : 1'b0;
flag_PV = (cpir_bc_new != 16'h0000) ? 1'b1 : 1'b0;
flag_N = 1'b1;

// Continue if BC != 0 AND no match (Z == 0)
// Stop if BC == 0 OR match found (Z == 1)
var cpir_bc_zero[0:0];
cpir_bc_zero = (cpir_bc_new == 16'h0000);
var cpir_match[0:0];
cpir_match = (cpir_result == 8'h00);
var cpir_done[0:0];
cpir_done = cpir_bc_zero | cpir_match;
var cpir_next_pc[15:0];
cpir_next_pc = cpir_done ? cpir_pc_next : pc;
pc = cpir_next_pc;
