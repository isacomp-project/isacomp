// SPDX-License-Identifier: BSD-3-Clause
// Z80 FD 5D - LD E,IYL (undocumented)
// Does not affect flags

isa_state pc[15:0];
var fd_instr[15:0];
var pc_plus_1[15:0];
isa_state IYL[7:0];
isa_state E[7:0];
mem mainmem[15:0];

pc_plus_1 = pc + 1;
fd_instr = {mainmem[pc_plus_1], mainmem[pc]};
assume fd_instr == 16'h5DFD;
pc = pc_plus_1 + 1;

E = IYL;
