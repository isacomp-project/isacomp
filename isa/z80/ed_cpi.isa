// SPDX-License-Identifier: BSD-3-Clause
// Z80 ED A1 - CPI (Compare and Increment)
// A - (HL), HL++, BC--
// Affects S, Z, H, P/V=(BC!=0), N=1

isa_state pc[15:0];
var ed_instr[15:0];
var pc_plus_1[15:0];
isa_state H[7:0];
isa_state L[7:0];
isa_state B[7:0];
isa_state C[7:0];
isa_state A[7:0];
isa_state flag_S;
isa_state flag_Z;
isa_state flag_H;
isa_state flag_PV;
isa_state flag_N;
mem mainmem[15:0];

pc_plus_1 = pc + 1;
ed_instr = {mainmem[pc_plus_1], mainmem[pc]};
assume ed_instr == 0xA1ED;
pc = pc_plus_1 + 1;

var cpi_hl_addr[15:0];
cpi_hl_addr = {H, L};
var cpi_bc_val[15:0];
cpi_bc_val = {B, C};

var cpi_value[7:0];
cpi_value = mainmem[cpi_hl_addr];
var cpi_result[7:0];
cpi_result = A - cpi_value;

var cpi_hl_new[15:0];
cpi_hl_new = cpi_hl_addr + 1;
var cpi_bc_new[15:0];
cpi_bc_new = cpi_bc_val - 1;

H = cpi_hl_new[15:8];
L = cpi_hl_new[7:0];
B = cpi_bc_new[15:8];
C = cpi_bc_new[7:0];

flag_S = cpi_result[7];
flag_Z = (cpi_result == 8'h00) ? 1'b1 : 1'b0;
flag_H = (A[3:0] < cpi_value[3:0]) ? 1'b1 : 1'b0;
flag_PV = (cpi_bc_new != 16'h0000) ? 1'b1 : 1'b0;
flag_N = 1'b1;
