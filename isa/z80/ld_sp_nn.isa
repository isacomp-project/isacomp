// SPDX-License-Identifier: BSD-3-Clause
// Z80 LD SP,nn (0x31) - Load 16-bit immediate into SP
// SP = nn
// Does not affect flags

isa_state pc[15:0];
var instr[7:0];
isa_state sp[15:0];
mem mainmem[15:0];

var imm_lo[7:0];
var imm_hi[7:0];

instr = mainmem[pc];
assume instr == 0x31;
pc = pc + 1;

imm_lo = mainmem[pc];
pc = pc + 1;
imm_hi = mainmem[pc];
pc = pc + 1;

sp = {imm_hi, imm_lo};
