// SPDX-License-Identifier: BSD-3-Clause
// Z80 ED 45 - RETN
// Return from non-maskable interrupt
// Pops PC from stack, copies IFF2 to IFF1

isa_state pc[15:0];
var ed_instr[15:0];
var pc_plus_1[15:0];
isa_state sp[15:0];
isa_state int_ff1[0:0];
isa_state int_ff2[0:0];
mem mainmem[15:0];
var sp_plus_1[15:0];
var ret_addr[15:0];

pc_plus_1 = pc + 1;
ed_instr = {mainmem[pc_plus_1], mainmem[pc]};
assume ed_instr == 16'h45ED;

// Pop return address from stack
ret_addr = {mainmem[sp + 1], mainmem[sp]};
sp_plus_1 = sp + 1;
sp = sp_plus_1 + 1;

// Copy IFF2 to IFF1
int_ff1 = int_ff2;

pc = ret_addr;
