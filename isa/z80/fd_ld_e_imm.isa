// Z80 FD 1E - FD prefix passthrough
// FD prefix consumed, base opcode 1E executes unchanged


isa_state pc[15:0];
var fd_instr[15:0];
var pc_plus_1[15:0];
isa_state E[7:0];
mem mainmem[15:0];

var imm[7:0];

pc_plus_1 = pc + 1;
fd_instr = {mainmem[pc_plus_1], mainmem[pc]};
assume fd_instr == 16'h1EFD;
pc = pc + 2;
imm = mainmem[pc];
pc = pc + 1;

E = imm;