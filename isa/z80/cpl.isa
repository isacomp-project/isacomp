// SPDX-License-Identifier: BSD-3-Clause
// Z80 CPL (0x2F) - Complement Accumulator
// A = ~A (one's complement)
// Affects: H=1, N=1

isa_state pc[15:0];
var instr[7:0];
isa_state A[7:0];
mem mainmem[15:0];
isa_state flag_H[0:0];
isa_state flag_N[0:0];

instr = mainmem[pc];
assume instr == 0x2F;
pc = pc + 1;

A = A ^ 8'hFF;  // Invert all bits

flag_H = 1'b1;
flag_N = 1'b1;
