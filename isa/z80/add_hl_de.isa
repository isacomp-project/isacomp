// SPDX-License-Identifier: BSD-3-Clause
// Z80 ADD HL,DE (0x19) - Add DE to HL (16-bit)
// HL = HL + DE
// Affects: H, N=0, C (S, Z, P/V not affected)

isa_state pc[15:0];
var instr[7:0];
isa_state H[7:0];
isa_state L[7:0];
isa_state D[7:0];
isa_state E[7:0];
mem mainmem[15:0];
isa_state flag_H[0:0];
isa_state flag_N[0:0];
isa_state flag_C[0:0];

var hl[15:0];
var de[15:0];
var result[16:0];

instr = mainmem[pc];
assume instr == 0x19;
pc = pc + 1;

hl = {H, L};
de = {D, E};
result = hl + de;

flag_H = (hl[11:0] + de[11:0]) > 0x0FFF ? 1'b1 : 1'b0;
flag_N = 1'b0;
flag_C = result[16];

H = result[15:8];
L = result[7:0];
