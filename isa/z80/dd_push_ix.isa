// SPDX-License-Identifier: BSD-3-Clause
// Z80 DD E5 - PUSH IX (Push IX onto stack)
// Does not affect flags

isa_state pc[15:0];
var dd_instr[15:0];
var pc_plus_1[15:0];
isa_state IXH[7:0];
isa_state IXL[7:0];
isa_state sp[15:0];
mem mainmem[15:0];

pc_plus_1 = pc + 1;
dd_instr = {mainmem[pc_plus_1], mainmem[pc]};
assume dd_instr == 16'hE5DD;

var sp_minus_1[15:0];
sp_minus_1 = sp - 1;
var sp_minus_2[15:0];
sp_minus_2 = sp_minus_1 - 1;

mainmem[sp_minus_1] = IXH;
mainmem[sp_minus_2] = IXL;

sp = sp_minus_2;
pc = pc_plus_1 + 1;
