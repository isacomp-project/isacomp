// SPDX-License-Identifier: BSD-3-Clause
// Z80 DD DB - DD prefix passthrough IN A,(n)
// DD prefix consumed, IN A,(n) executes unchanged

isa_state pc[15:0];
var dd_instr[15:0];
var pc_plus_1[15:0];
isa_state A[7:0];
isa_state io[7:0][7:0];
mem mainmem[15:0];

var dd_in_port[7:0];

pc_plus_1 = pc + 1;
dd_instr = {mainmem[pc_plus_1], mainmem[pc]};
assume dd_instr == 16'hDBDD;
pc = pc + 2;

dd_in_port = mainmem[pc];
A = io[dd_in_port];
pc = pc + 1;
