// SPDX-License-Identifier: BSD-3-Clause
// Z80 DD D3 - DD prefix passthrough OUT (n),A
// DD prefix consumed, OUT (n),A executes unchanged

isa_state pc[15:0];
var dd_instr[15:0];
var pc_plus_1[15:0];
isa_state A[7:0];
isa_state io[7:0][7:0];
mem mainmem[15:0];

var dd_out_port[7:0];

pc_plus_1 = pc + 1;
dd_instr = {mainmem[pc_plus_1], mainmem[pc]};
assume dd_instr == 16'hD3DD;
pc = pc + 2;

dd_out_port = mainmem[pc];
io[dd_out_port] = A;
pc = pc + 1;
