// SPDX-License-Identifier: BSD-3-Clause
// Z80 LD (BC),A (0x02) - Store A to memory at BC
// (BC) = A
// Does not affect flags

isa_state pc[15:0];
var instr[7:0];
isa_state A[7:0];
isa_state B[7:0];
isa_state C[7:0];
mem mainmem[15:0];
var addr[15:0];

instr = mainmem[pc];
assume instr == 0x02;
pc = pc + 1;

addr = {B, C};
mainmem[addr] = A;
