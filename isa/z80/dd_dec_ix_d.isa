// SPDX-License-Identifier: BSD-3-Clause
// Z80 DD 35 d - DEC (IX+d)
// Affects: S, Z, H, P/V, N=1 (C not affected)

isa_state pc[15:0];
var dd_instr[15:0];
var pc_plus_1[15:0];
var pc_plus_2[15:0];
isa_state IXH[7:0];
isa_state IXL[7:0];
mem mainmem[15:0];
isa_state flag_S[0:0];
isa_state flag_Z[0:0];
isa_state flag_H[0:0];
isa_state flag_PV[0:0];
isa_state flag_N[0:0];
var d[7:0];
var d_sext[15:0];
var dd_dec_ix_d_addr[15:0];
var value[7:0];
var result[7:0];

pc_plus_1 = pc + 1;
pc_plus_2 = pc_plus_1 + 1;
dd_instr = {mainmem[pc_plus_1], mainmem[pc]};
assume dd_instr == 16'h35DD;

d = mainmem[pc_plus_2];
d_sext = {{8{d[7]}}, d};
dd_dec_ix_d_addr = {IXH, IXL} + d_sext;
value = mainmem[dd_dec_ix_d_addr];
result = value - 1;

flag_S = result[7];
flag_Z = result == 0 ? 1'b1 : 1'b0;
flag_H = (value[3:0] == 4'h0) ? 1'b1 : 1'b0;
flag_PV = (value == 8'h80) ? 1'b1 : 1'b0;
flag_N = 1'b1;

mainmem[dd_dec_ix_d_addr] = result;
pc = pc_plus_2 + 1;
