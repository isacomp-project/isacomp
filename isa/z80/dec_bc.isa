// SPDX-License-Identifier: BSD-3-Clause
// Z80 DEC BC (0x0B) - Decrement BC register pair
// BC = BC - 1
// Does not affect flags

isa_state pc[15:0];
var instr[7:0];
isa_state B[7:0];
isa_state C[7:0];
mem mainmem[15:0];

var bc[15:0];
var bc_minus_1[15:0];

instr = mainmem[pc];
assume instr == 0x0B;
pc = pc + 1;

bc = {B, C};
bc_minus_1 = bc - 1;

B = bc_minus_1[15:8];
C = bc_minus_1[7:0];
