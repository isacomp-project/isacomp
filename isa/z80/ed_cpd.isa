// SPDX-License-Identifier: BSD-3-Clause
// Z80 ED A9 - CPD (Compare and Decrement)
// A - (HL), HL--, BC--
// Affects S, Z, H, P/V=(BC!=0), N=1

isa_state pc[15:0];
var ed_instr[15:0];
var pc_plus_1[15:0];
isa_state H[7:0];
isa_state L[7:0];
isa_state B[7:0];
isa_state C[7:0];
isa_state A[7:0];
isa_state flag_S;
isa_state flag_Z;
isa_state flag_H;
isa_state flag_PV;
isa_state flag_N;
mem mainmem[15:0];

pc_plus_1 = pc + 1;
ed_instr = {mainmem[pc_plus_1], mainmem[pc]};
assume ed_instr == 0xA9ED;
pc = pc_plus_1 + 1;

var cpd_hl_addr[15:0];
cpd_hl_addr = {H, L};
var cpd_bc_val[15:0];
cpd_bc_val = {B, C};

var cpd_value[7:0];
cpd_value = mainmem[cpd_hl_addr];
var cpd_result[7:0];
cpd_result = A - cpd_value;

var cpd_hl_new[15:0];
cpd_hl_new = cpd_hl_addr - 1;
var cpd_bc_new[15:0];
cpd_bc_new = cpd_bc_val - 1;

H = cpd_hl_new[15:8];
L = cpd_hl_new[7:0];
B = cpd_bc_new[15:8];
C = cpd_bc_new[7:0];

flag_S = cpd_result[7];
flag_Z = (cpd_result == 8'h00) ? 1'b1 : 1'b0;
flag_H = (A[3:0] < cpd_value[3:0]) ? 1'b1 : 1'b0;
flag_PV = (cpd_bc_new != 16'h0000) ? 1'b1 : 1'b0;
flag_N = 1'b1;
