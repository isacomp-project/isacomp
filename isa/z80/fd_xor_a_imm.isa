// SPDX-License-Identifier: BSD-3-Clause
// Z80 FD EE - FD prefix passthrough
// FD prefix consumed, base opcode EE executes unchanged


isa_state pc[15:0];
var fd_instr[15:0];
var pc_plus_1[15:0];
isa_state A[7:0];
mem mainmem[15:0];
isa_state flag_S[0:0];
isa_state flag_Z[0:0];
isa_state flag_H[0:0];
isa_state flag_PV[0:0];
isa_state flag_N[0:0];
isa_state flag_C[0:0];

var imm[7:0];
var result[7:0];
var parity[0:0];

pc_plus_1 = pc + 1;
fd_instr = {mainmem[pc_plus_1], mainmem[pc]};
assume fd_instr == 16'hEEFD;
pc = pc + 2;
imm = mainmem[pc];
pc = pc + 1;

result = A ^ imm;

parity = result[7] ^ result[6] ^ result[5] ^ result[4] ^ result[3] ^ result[2] ^ result[1] ^ result[0];

flag_S = result[7];
flag_Z = result == 0 ? 1'b1 : 1'b0;
flag_H = 1'b0;
flag_PV = parity ^ 1'b1;
flag_N = 1'b0;
flag_C = 1'b0;

A = result;