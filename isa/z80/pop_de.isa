// SPDX-License-Identifier: BSD-3-Clause
// Z80 POP DE (0xD1) - Pop DE register pair from stack
// E = (SP), D = (SP+1), SP = SP + 2
// Does not affect flags

isa_state pc[15:0];
var instr[7:0];
isa_state sp[15:0];
isa_state D[7:0];
isa_state E[7:0];
mem mainmem[15:0];

var sp_plus_1[15:0];
var sp_plus_2[15:0];

instr = mainmem[pc];
assume instr == 0xD1;
pc = pc + 1;

E = mainmem[sp];
sp_plus_1 = sp + 1;
D = mainmem[sp_plus_1];
sp_plus_2 = sp_plus_1 + 1;

sp = sp_plus_2;
