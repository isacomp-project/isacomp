// SPDX-License-Identifier: BSD-3-Clause
// Z80 FD B6 d - OR (IY+d)
// Affects: S, Z, H=0, P/V, N=0, C=0

isa_state pc[15:0];
var fd_instr[15:0];
var pc_plus_1[15:0];
var pc_plus_2[15:0];
isa_state IYH[7:0];
isa_state IYL[7:0];
isa_state A[7:0];
mem mainmem[15:0];
isa_state flag_S[0:0];
isa_state flag_Z[0:0];
isa_state flag_H[0:0];
isa_state flag_PV[0:0];
isa_state flag_N[0:0];
isa_state flag_C[0:0];
var d[7:0];
var d_sext[15:0];
var fd_or_a_iy_d_addr[15:0];
var value[7:0];
var result[7:0];
var parity[0:0];

pc_plus_1 = pc + 1;
pc_plus_2 = pc_plus_1 + 1;
fd_instr = {mainmem[pc_plus_1], mainmem[pc]};
assume fd_instr == 16'hB6FD;

d = mainmem[pc_plus_2];
d_sext = {{8{d[7]}}, d};
fd_or_a_iy_d_addr = {IYH, IYL} + d_sext;
value = mainmem[fd_or_a_iy_d_addr];

result = A | value;
parity = result[7] ^ result[6] ^ result[5] ^ result[4] ^ result[3] ^ result[2] ^ result[1] ^ result[0];

A = result;
flag_S = result[7];
flag_Z = (result == 8'h00) ? 1'b1 : 1'b0;
flag_H = 1'b0;
flag_PV = parity ^ 1'b1;
flag_N = 1'b0;
flag_C = 1'b0;

pc = pc_plus_2 + 1;
