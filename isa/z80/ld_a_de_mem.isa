// SPDX-License-Identifier: BSD-3-Clause
// Z80 LD A,(DE) (0x1A) - Load A from memory at DE
// A = (DE)
// Does not affect flags

isa_state pc[15:0];
var instr[7:0];
isa_state A[7:0];
isa_state D[7:0];
isa_state E[7:0];
mem mainmem[15:0];
var addr[15:0];

instr = mainmem[pc];
assume instr == 0x1A;
pc = pc + 1;

addr = {D, E};
A = mainmem[addr];
