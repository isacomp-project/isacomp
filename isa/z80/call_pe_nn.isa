// SPDX-License-Identifier: BSD-3-Clause
// Z80 CALL PE,nn (0xEC) - Call if PE
// If condition met: Push PC+3, PC = nn
// Does not affect flags

isa_state pc[15:0];
var instr[7:0];
isa_state sp[15:0];
isa_state flag_PV;
mem mainmem[15:0];
var pc_plus_1[15:0];
var pc_plus_2[15:0];
var pc_plus_3[15:0];
var sp_minus_1[15:0];
var sp_minus_2[15:0];
var target[15:0];


instr = mainmem[pc];
assume instr == 0xEC;
pc_plus_1 = pc + 1;
pc_plus_2 = pc_plus_1 + 1;
pc_plus_3 = pc_plus_2 + 1;

target = {mainmem[pc_plus_2], mainmem[pc_plus_1]};
sp_minus_1 = sp - 1;
sp_minus_2 = sp_minus_1 - 1;


mainmem[sp_minus_1] when (flag_PV) = pc_plus_3[15:8];
mainmem[sp_minus_2] when (flag_PV) = pc_plus_3[7:0];
sp = flag_PV ? sp_minus_2 : sp;
pc = flag_PV ? target : pc_plus_3;
