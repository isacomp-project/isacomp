// SPDX-License-Identifier: BSD-3-Clause
// Z80 OUT (n),A (0xD3) - Output A to port
// port[n] = A
// Does not affect flags

isa_state pc[15:0];
var instr[7:0];
isa_state A[7:0];
isa_state io[7:0][7:0];
mem mainmem[15:0];
var pc_plus_1[15:0];
var port[7:0];

instr = mainmem[pc];
assume instr == 0xD3;
pc_plus_1 = pc + 1;

port = mainmem[pc_plus_1];
io[port] = A;
pc = pc_plus_1 + 1;
