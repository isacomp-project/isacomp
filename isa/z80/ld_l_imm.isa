// SPDX-License-Identifier: BSD-3-Clause
// Z80 LD L,n (0x2E) - Load immediate value into L
// L = n
// Does not affect flags

isa_state pc[15:0];
var instr[7:0];
isa_state L[7:0];
mem mainmem[15:0];

var imm[7:0];

instr = mainmem[pc];
assume instr == 0x2E;
pc = pc + 1;
imm = mainmem[pc];
pc = pc + 1;

L = imm;
