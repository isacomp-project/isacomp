// SPDX-License-Identifier: BSD-3-Clause
// Z80 AND n (0xE6) - Logical AND immediate with A
// A = A & n
// Affects: S, Z, H=1, P/V=parity, N=0, C=0

isa_state pc[15:0];
var instr[7:0];
isa_state A[7:0];
mem mainmem[15:0];
isa_state flag_S[0:0];
isa_state flag_Z[0:0];
isa_state flag_H[0:0];
isa_state flag_PV[0:0];
isa_state flag_N[0:0];
isa_state flag_C[0:0];

var imm[7:0];
var result[7:0];
var parity[0:0];

instr = mainmem[pc];
assume instr == 0xE6;
pc = pc + 1;
imm = mainmem[pc];
pc = pc + 1;

result = A & imm;

// Parity: XOR all bits together - even number of 1s = 1
parity = result[7] ^ result[6] ^ result[5] ^ result[4] ^ result[3] ^ result[2] ^ result[1] ^ result[0];

// Flags
flag_S = result[7];
flag_Z = result == 0 ? 1'b1 : 1'b0;
flag_H = 1'b1;  // AND always sets H
flag_PV = parity ^ 1'b1;  // Even parity = 1
flag_N = 1'b0;
flag_C = 1'b0;  // AND clears carry

A = result;
