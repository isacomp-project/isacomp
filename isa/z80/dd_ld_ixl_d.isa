// SPDX-License-Identifier: BSD-3-Clause
// Z80 DD 6A - LD IXL,D (undocumented)
// Does not affect flags

isa_state pc[15:0];
var dd_instr[15:0];
var pc_plus_1[15:0];
isa_state IXL[7:0];
isa_state D[7:0];
mem mainmem[15:0];

pc_plus_1 = pc + 1;
dd_instr = {mainmem[pc_plus_1], mainmem[pc]};
assume dd_instr == 16'h6ADD;
pc = pc_plus_1 + 1;

IXL = D;
