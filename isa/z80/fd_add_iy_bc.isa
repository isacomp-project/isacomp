// SPDX-License-Identifier: BSD-3-Clause
// Z80 FD 09 - ADD IY,BC (Add BC to IY)
// Affects H, N=0, C

isa_state pc[15:0];
var fd_instr[15:0];
var pc_plus_1[15:0];
isa_state IYH[7:0];
isa_state IYL[7:0];
isa_state B[7:0];
isa_state C[7:0];
isa_state flag_H;
isa_state flag_N;
isa_state flag_C;
mem mainmem[15:0];

pc_plus_1 = pc + 1;
fd_instr = {mainmem[pc_plus_1], mainmem[pc]};
assume fd_instr == 16'h09FD;

var iy_val[15:0];
iy_val = {IYH, IYL};
var bc_val[15:0];
bc_val = {B, C};

var iy_new[16:0];
iy_new = {1'b0, iy_val} + {1'b0, bc_val};

IYH = iy_new[15:8];
IYL = iy_new[7:0];

flag_H = ((iy_val[11:0] + bc_val[11:0]) > 12'hFFF) ? 1'b1 : 1'b0;
flag_N = 1'b0;
flag_C = iy_new[16];

pc = pc_plus_1 + 1;
