// SPDX-License-Identifier: BSD-3-Clause
// Z80 DEC D (0x15) - DECrement D
// D = D - 1
// Affects S, Z, H, P/V, N flags (not C)

isa_state pc[15:0];
var instr[7:0];
isa_state D[7:0];
isa_state flag_S;
isa_state flag_Z;
isa_state flag_H;
isa_state flag_PV;
isa_state flag_N;
mem mainmem[15:0];
var result[7:0];

instr = mainmem[pc];
assume instr == 0x15;
pc = pc + 1;

result = D - 1;
flag_H = (D[3:0] == 4'b0000);
flag_PV = (D == 8'h80);
D = result;
flag_S = result[7];
flag_Z = (result == 8'b0);
flag_N = 1;
