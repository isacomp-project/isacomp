// SPDX-License-Identifier: BSD-3-Clause
// Z80 DD 21 - LD IX,nn (Load immediate 16-bit value into IX)
// Does not affect flags

isa_state pc[15:0];
var dd_instr[15:0];
var pc_plus_1[15:0];
var pc_plus_2[15:0];
var pc_plus_3[15:0];
isa_state IXH[7:0];
isa_state IXL[7:0];
mem mainmem[15:0];

pc_plus_1 = pc + 1;
dd_instr = {mainmem[pc_plus_1], mainmem[pc]};
assume dd_instr == 16'h21DD;

pc_plus_2 = pc_plus_1 + 1;
pc_plus_3 = pc_plus_2 + 1;

IXL = mainmem[pc_plus_2];
IXH = mainmem[pc_plus_3];

pc = pc_plus_3 + 1;
