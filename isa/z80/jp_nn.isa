// SPDX-License-Identifier: BSD-3-Clause
// Z80 JP nn (0xC3) - Jump to absolute address
// PC = nn
// Does not affect flags

isa_state pc[15:0];
var instr[7:0];
mem mainmem[15:0];

var pc_plus_1[15:0];
var pc_plus_2[15:0];
var addr_lo[7:0];
var addr_hi[7:0];
var target[15:0];

instr = mainmem[pc];
assume instr == 0xC3;

// Use intermediate variables for address calculation
pc_plus_1 = pc + 1;
pc_plus_2 = pc_plus_1 + 1;

addr_lo = mainmem[pc_plus_1];
addr_hi = mainmem[pc_plus_2];

target = {addr_hi, addr_lo};

// Single write to PC
pc = target;
