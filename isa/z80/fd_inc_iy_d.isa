// SPDX-License-Identifier: BSD-3-Clause
// Z80 FD 34 d - INC (IY+d)
// Affects: S, Z, H, P/V, N=0 (C not affected)

isa_state pc[15:0];
var fd_instr[15:0];
var pc_plus_1[15:0];
var pc_plus_2[15:0];
isa_state IYH[7:0];
isa_state IYL[7:0];
mem mainmem[15:0];
isa_state flag_S[0:0];
isa_state flag_Z[0:0];
isa_state flag_H[0:0];
isa_state flag_PV[0:0];
isa_state flag_N[0:0];
var d[7:0];
var d_sext[15:0];
var fd_inc_iy_d_addr[15:0];
var value[7:0];
var result[7:0];

pc_plus_1 = pc + 1;
pc_plus_2 = pc_plus_1 + 1;
fd_instr = {mainmem[pc_plus_1], mainmem[pc]};
assume fd_instr == 16'h34FD;

d = mainmem[pc_plus_2];
d_sext = {{8{d[7]}}, d};
fd_inc_iy_d_addr = {IYH, IYL} + d_sext;
value = mainmem[fd_inc_iy_d_addr];
result = value + 1;

flag_S = result[7];
flag_Z = result == 0 ? 1'b1 : 1'b0;
flag_H = (value[3:0] == 4'hF) ? 1'b1 : 1'b0;
flag_PV = (value == 8'h7F) ? 1'b1 : 1'b0;
flag_N = 1'b0;

mainmem[fd_inc_iy_d_addr] = result;
pc = pc_plus_2 + 1;
