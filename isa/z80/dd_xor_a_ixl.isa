// SPDX-License-Identifier: BSD-3-Clause
// Z80 DD AD - XOR A,IXL (undocumented)
// Affects S, Z, H, P/V, N, C

isa_state pc[15:0];
var dd_instr[15:0];
var pc_plus_1[15:0];
isa_state IXL[7:0];
isa_state A[7:0];
isa_state flag_S;
isa_state flag_Z;
isa_state flag_H;
isa_state flag_PV;
isa_state flag_N;
isa_state flag_C;
mem mainmem[15:0];
var result[8:0];
var half_carry[4:0];


pc_plus_1 = pc + 1;
dd_instr = {mainmem[pc_plus_1], mainmem[pc]};
assume dd_instr == 16'hADDD;
pc = pc_plus_1 + 1;

var parity[0:0];
result = {1'b0, A ^ IXL};
parity = result[7] ^ result[6] ^ result[5] ^ result[4] ^ result[3] ^ result[2] ^ result[1] ^ result[0];

A = result[7:0];
flag_S = result[7];
flag_Z = (result[7:0] == 8'h00) ? 1'b1 : 1'b0;
flag_H = 1'b0;
flag_PV = parity ^ 1'b1;
flag_N = 1'b0;
flag_C = 1'b0;

