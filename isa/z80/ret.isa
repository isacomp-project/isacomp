// SPDX-License-Identifier: BSD-3-Clause
// Z80 RET (0xC9) - Return from subroutine
// Pop PC from stack
// Does not affect flags

isa_state pc[15:0];
var instr[7:0];
isa_state sp[15:0];
mem mainmem[15:0];

var addr_lo[7:0];
var addr_hi[7:0];
var sp_plus_1[15:0];
var sp_plus_2[15:0];

instr = mainmem[pc];
assume instr == 0xC9;

// Pop return address from stack (low byte first)
addr_lo = mainmem[sp];
sp_plus_1 = sp + 1;
addr_hi = mainmem[sp_plus_1];
sp_plus_2 = sp_plus_1 + 1;

sp = sp_plus_2;
pc = {addr_hi, addr_lo};
