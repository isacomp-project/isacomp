// SPDX-License-Identifier: BSD-3-Clause
// Z80 CP A,D (0xBA) - CP D with A
// Compare A with D
// Affects S, Z, H, P/V, N, C flags

isa_state pc[15:0];
var instr[7:0];
isa_state A[7:0];
isa_state D[7:0];
isa_state flag_S;
isa_state flag_Z;
isa_state flag_H;
isa_state flag_PV;
isa_state flag_N;
isa_state flag_C;
mem mainmem[15:0];

instr = mainmem[pc];
assume instr == 0xBA;
pc = pc + 1;

var result[8:0];
result = {1'b0, A} - {1'b0, D};
var half[4:0];
half = {1'b0, A[3:0]} - {1'b0, D[3:0]};

// CP does not modify A, only flags
flag_S = result[7];
flag_Z = (result[7:0] == 8'b0);
flag_H = half[4];
flag_PV = ((A[7] ^ D[7]) & (A[7] ^ result[7]));
flag_N = 1;
flag_C = result[8];

