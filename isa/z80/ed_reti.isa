// SPDX-License-Identifier: BSD-3-Clause
// Z80 ED 4D - RETI
// Return from interrupt (signals I/O devices)
// Pops PC from stack

isa_state pc[15:0];
var ed_instr[15:0];
var pc_plus_1[15:0];
isa_state sp[15:0];
mem mainmem[15:0];
var sp_plus_1[15:0];
var ret_addr[15:0];

pc_plus_1 = pc + 1;
ed_instr = {mainmem[pc_plus_1], mainmem[pc]};
assume ed_instr == 16'h4DED;

// Pop return address from stack
ret_addr = {mainmem[sp + 1], mainmem[sp]};
sp_plus_1 = sp + 1;
sp = sp_plus_1 + 1;

pc = ret_addr;
