// Z80 ED 77 - Undocumented NOP (does nothing, advances PC)
// Does not affect flags

isa_state pc[15:0];
var ed_instr[15:0];
var pc_plus_1[15:0];
mem mainmem[15:0];

pc_plus_1 = pc + 1;
ed_instr = {mainmem[pc_plus_1], mainmem[pc]};
assume ed_instr == 16'h77ED;
pc = pc_plus_1 + 1;
