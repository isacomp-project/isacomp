// Z80 FD 6A - LD IYL,D (undocumented)
// Does not affect flags

isa_state pc[15:0];
var fd_instr[15:0];
var pc_plus_1[15:0];
isa_state IYL[7:0];
isa_state D[7:0];
mem mainmem[15:0];

pc_plus_1 = pc + 1;
fd_instr = {mainmem[pc_plus_1], mainmem[pc]};
assume fd_instr == 16'h6AFD;
pc = pc_plus_1 + 1;

IYL = D;
