// SPDX-License-Identifier: BSD-3-Clause
// Z80 EI (0xFB) - Enable Interrupts
// IFF1 = 1, IFF2 = 1
// Does not affect flags

isa_state pc[15:0];
var instr[7:0];
isa_state int_ff1[0:0];
isa_state int_ff2[0:0];
mem mainmem[15:0];

instr = mainmem[pc];
assume instr == 0xFB;
pc = pc + 1;

int_ff1 = 1;
int_ff2 = 1;
