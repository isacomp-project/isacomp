// SPDX-License-Identifier: BSD-3-Clause
// Z80 FD EB - FD prefix passthrough EX DE,HL
// FD prefix consumed, EX DE,HL executes unchanged

isa_state pc[15:0];
var fd_instr[15:0];
var pc_plus_1[15:0];
isa_state D[7:0];
isa_state E[7:0];
isa_state H[7:0];
isa_state L[7:0];
mem mainmem[15:0];

var fd_ex_old_d[7:0];
var fd_ex_old_e[7:0];

pc_plus_1 = pc + 1;
fd_instr = {mainmem[pc_plus_1], mainmem[pc]};
assume fd_instr == 16'hEBFD;
pc = pc + 2;

fd_ex_old_d = D;
fd_ex_old_e = E;

D = H;
E = L;
H = fd_ex_old_d;
L = fd_ex_old_e;
