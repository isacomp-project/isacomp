// SPDX-License-Identifier: BSD-3-Clause
// Z80 CB 65 - BIT 4,L (Test bit 4)
// Affects Z (set if bit is 0), H=1, N=0, S/P undefined

isa_state pc[15:0];
var cb_instr[15:0];
var pc_plus_1[15:0];
isa_state L[7:0];
isa_state flag_S;
isa_state flag_Z;
isa_state flag_H;
isa_state flag_PV;
isa_state flag_N;
mem mainmem[15:0];
var bit_val[0:0];

pc_plus_1 = pc + 1;
cb_instr = {mainmem[pc_plus_1], mainmem[pc]};
assume cb_instr == 0x65CB;
pc = pc_plus_1 + 1;

bit_val = L[4];

// Z is set if the tested bit is 0
flag_Z = (bit_val == 1'b0) ? 1'b1 : 1'b0;
flag_H = 1'b1;
flag_N = 1'b0;
// S is set if bit 7 and testing bit 7
flag_S = (4 == 7) ? bit_val : 1'b0;
// P/V is same as Z for BIT instruction
flag_PV = flag_Z;
