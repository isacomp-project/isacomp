// SPDX-License-Identifier: BSD-3-Clause
// Z80 LD C,(HL) (0x4E) - Load C from memory at HL
// C = (HL)
// Does not affect flags

isa_state pc[15:0];
var instr[7:0];
isa_state C[7:0];
isa_state H[7:0];
isa_state L[7:0];
mem mainmem[15:0];
var addr[15:0];

instr = mainmem[pc];
assume instr == 0x4E;
pc = pc + 1;

addr = {H, L};
C = mainmem[addr];
