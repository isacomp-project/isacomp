// SPDX-License-Identifier: BSD-3-Clause
// Z80 LD (nn),A (0x32) - Store A to absolute memory address
// (nn) = A
// Does not affect flags

isa_state pc[15:0];
var instr[7:0];
isa_state A[7:0];
mem mainmem[15:0];

var addr_lo[7:0];
var addr_hi[7:0];
var addr[15:0];

instr = mainmem[pc];
assume instr == 0x32;
pc = pc + 1;

addr_lo = mainmem[pc];
pc = pc + 1;
addr_hi = mainmem[pc];
pc = pc + 1;

addr = {addr_hi, addr_lo};
mainmem[addr] = A;
