// SPDX-License-Identifier: BSD-3-Clause
// Z80 ED A8 - LDD (Load and Decrement)
// (DE) = (HL), DE--, HL--, BC--
// Affects H=0, P/V=(BC!=0), N=0

isa_state pc[15:0];
var ed_instr[15:0];
var pc_plus_1[15:0];
isa_state H[7:0];
isa_state L[7:0];
isa_state D[7:0];
isa_state E[7:0];
isa_state B[7:0];
isa_state C[7:0];
isa_state flag_H;
isa_state flag_PV;
isa_state flag_N;
mem mainmem[15:0];

pc_plus_1 = pc + 1;
ed_instr = {mainmem[pc_plus_1], mainmem[pc]};
assume ed_instr == 0xA8ED;
pc = pc_plus_1 + 1;

var ldd_hl_addr[15:0];
ldd_hl_addr = {H, L};
var ldd_de_addr[15:0];
ldd_de_addr = {D, E};
var ldd_bc_val[15:0];
ldd_bc_val = {B, C};

var ldd_value[7:0];
ldd_value = mainmem[ldd_hl_addr];
mainmem[ldd_de_addr] = ldd_value;

var ldd_hl_new[15:0];
ldd_hl_new = ldd_hl_addr - 1;
var ldd_de_new[15:0];
ldd_de_new = ldd_de_addr - 1;
var ldd_bc_new[15:0];
ldd_bc_new = ldd_bc_val - 1;

H = ldd_hl_new[15:8];
L = ldd_hl_new[7:0];
D = ldd_de_new[15:8];
E = ldd_de_new[7:0];
B = ldd_bc_new[15:8];
C = ldd_bc_new[7:0];

flag_H = 1'b0;
flag_PV = (ldd_bc_new != 16'h0000) ? 1'b1 : 1'b0;
flag_N = 1'b0;
