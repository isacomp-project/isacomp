// SPDX-License-Identifier: BSD-3-Clause
// Z80 LD B,n (0x06) - Load immediate value into B
// B = n
// Does not affect flags

isa_state pc[15:0];
var instr[7:0];
isa_state B[7:0];
mem mainmem[15:0];

var imm[7:0];

instr = mainmem[pc];
assume instr == 0x06;
pc = pc + 1;
imm = mainmem[pc];
pc = pc + 1;

B = imm;
