// SPDX-License-Identifier: BSD-3-Clause
// Z80 ADD A,(HL) (0x86) - Add memory at HL to A
// A = A + (HL)
// Affects: S, Z, H, P/V, N, C

isa_state pc[15:0];
var instr[7:0];
isa_state A[7:0];
isa_state H[7:0];
isa_state L[7:0];
mem mainmem[15:0];
isa_state flag_S[0:0];
isa_state flag_Z[0:0];
isa_state flag_H[0:0];
isa_state flag_PV[0:0];
isa_state flag_N[0:0];
isa_state flag_C[0:0];

var hl_addr[15:0];
var operand[7:0];
var result[8:0];

instr = mainmem[pc];
assume instr == 0x86;
pc = pc + 1;

hl_addr = {H, L};
operand = mainmem[hl_addr];
result = A + operand;

// Flags
flag_S = result[7];
flag_Z = result[7:0] == 0 ? 1'b1 : 1'b0;
flag_H = (A[3:0] + operand[3:0]) > 0x0F ? 1'b1 : 1'b0;
flag_PV = (A[7] == operand[7]) & (A[7] != result[7]) ? 1'b1 : 1'b0;
flag_N = 1'b0;
flag_C = result[8];

A = result[7:0];
