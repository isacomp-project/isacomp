// Z80 FD 78 - FD prefix passthrough
// FD prefix consumed, base opcode 78 executes unchanged


isa_state pc[15:0];
var fd_instr[15:0];
var pc_plus_1[15:0];
isa_state A[7:0];
isa_state B[7:0];
mem mainmem[15:0];

pc_plus_1 = pc + 1;
fd_instr = {mainmem[pc_plus_1], mainmem[pc]};
assume fd_instr == 16'h78FD;
pc = pc + 2;

A = B;