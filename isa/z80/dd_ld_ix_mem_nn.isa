// SPDX-License-Identifier: BSD-3-Clause
// Z80 DD 2A - LD IX,(nn) (Load IX from memory address nn)
// Does not affect flags

isa_state pc[15:0];
var dd_instr[15:0];
var pc_plus_1[15:0];
var pc_plus_2[15:0];
var pc_plus_3[15:0];
isa_state IXH[7:0];
isa_state IXL[7:0];
mem mainmem[15:0];
var ld_ix_addr[15:0];
var ld_ix_addr_plus_1[15:0];

pc_plus_1 = pc + 1;
dd_instr = {mainmem[pc_plus_1], mainmem[pc]};
assume dd_instr == 16'h2ADD;

pc_plus_2 = pc_plus_1 + 1;
pc_plus_3 = pc_plus_2 + 1;

ld_ix_addr = {mainmem[pc_plus_3], mainmem[pc_plus_2]};
ld_ix_addr_plus_1 = ld_ix_addr + 1;

IXL = mainmem[ld_ix_addr];
IXH = mainmem[ld_ix_addr_plus_1];

pc = pc_plus_3 + 1;
