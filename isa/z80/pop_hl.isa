// Z80 POP HL (0xE1) - Pop HL register pair from stack
// L = (SP), H = (SP+1), SP = SP + 2
// Does not affect flags

isa_state pc[15:0];
var instr[7:0];
isa_state sp[15:0];
isa_state H[7:0];
isa_state L[7:0];
mem mainmem[15:0];

var sp_plus_1[15:0];
var sp_plus_2[15:0];

instr = mainmem[pc];
assume instr == 0xE1;
pc = pc + 1;

L = mainmem[sp];
sp_plus_1 = sp + 1;
H = mainmem[sp_plus_1];
sp_plus_2 = sp_plus_1 + 1;

sp = sp_plus_2;
