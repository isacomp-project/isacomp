// SPDX-License-Identifier: BSD-3-Clause
// Z80 FD 2B - DEC IY (Decrement IY register pair)
// Does not affect flags

isa_state pc[15:0];
var fd_instr[15:0];
var pc_plus_1[15:0];
isa_state IYH[7:0];
isa_state IYL[7:0];
mem mainmem[15:0];

pc_plus_1 = pc + 1;
fd_instr = {mainmem[pc_plus_1], mainmem[pc]};
assume fd_instr == 16'h2BFD;

var iy_val[15:0];
iy_val = {IYH, IYL};
var iy_new[15:0];
iy_new = iy_val - 1;

IYH = iy_new[15:8];
IYL = iy_new[7:0];

pc = pc_plus_1 + 1;
