// SPDX-License-Identifier: BSD-3-Clause
// Z80 DD 80 - DD prefix passthrough
// DD prefix consumed, base opcode 80 executes unchanged


isa_state pc[15:0];
var dd_instr[15:0];
var pc_plus_1[15:0];
isa_state A[7:0];
isa_state B[7:0];
isa_state flag_S;
isa_state flag_Z;
isa_state flag_H;
isa_state flag_PV;
isa_state flag_N;
isa_state flag_C;
mem mainmem[15:0];

pc_plus_1 = pc + 1;
dd_instr = {mainmem[pc_plus_1], mainmem[pc]};
assume dd_instr == 16'h80DD;
pc = pc + 2;

var result[8:0];
result = {1'b0, A} + {1'b0, B};
var half[4:0];
half = {1'b0, A[3:0]} + {1'b0, B[3:0]};

A = result[7:0];
flag_S = result[7];
flag_Z = (result[7:0] == 8'b0);
flag_H = half[4];
flag_PV = (A[7] ^ B[7] ^ result[7] ^ result[8]);
flag_N = 0;
flag_C = result[8];