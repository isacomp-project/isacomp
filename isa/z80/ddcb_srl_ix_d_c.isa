// SPDX-License-Identifier: BSD-3-Clause
// Z80 DDCB d 39 - SRL (IX+d),C
// Affects S, Z, H=0, P/V=parity, N=0, C

isa_state pc[15:0];
var ddcb_prefix[15:0];
var pc_plus_1[15:0];
var pc_plus_2[15:0];
var pc_plus_3[15:0];
isa_state IXH[7:0];
isa_state IXL[7:0];
isa_state C[7:0];
isa_state flag_S;
isa_state flag_Z;
isa_state flag_H;
isa_state flag_PV;
isa_state flag_N;
isa_state flag_C;
mem mainmem[15:0];
var d[7:0];
var d_sext[15:0];
var addr[15:0];
var value[7:0];
var result[7:0];
var new_carry[0:0];
var parity[0:0];
var op_byte[7:0];

pc_plus_1 = pc + 1;
pc_plus_2 = pc + 2;
pc_plus_3 = pc + 3;

// Read DD CB prefix
ddcb_prefix = {mainmem[pc_plus_1], mainmem[pc]};
assume ddcb_prefix == 16'hCBDD;

// Read displacement and opcode
d = mainmem[pc_plus_2];
op_byte = mainmem[pc_plus_3];
assume op_byte == 8'h39;
pc = pc_plus_3 + 1;

// Calculate address IX + d (signed)
d_sext = {{8{d[7]}}, d};
addr = {IXH, IXL} + d_sext;
value = mainmem[addr];

new_carry = value[0];
result = {1'b0, value[7:1]};

mainmem[addr] = result;
C = result;

// Parity: XOR all bits (0 = even parity)
parity = result[7] ^ result[6] ^ result[5] ^ result[4] ^ result[3] ^ result[2] ^ result[1] ^ result[0];

flag_C = new_carry;
flag_S = result[7];
flag_Z = (result == 8'h00) ? 1'b1 : 1'b0;
flag_H = 1'b0;
flag_N = 1'b0;
flag_PV = (parity == 1'b0) ? 1'b1 : 1'b0;
