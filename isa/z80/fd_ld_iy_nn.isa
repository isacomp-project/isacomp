// SPDX-License-Identifier: BSD-3-Clause
// Z80 FD 21 - LD IY,nn (Load immediate 16-bit value into IY)
// Does not affect flags

isa_state pc[15:0];
var fd_instr[15:0];
var pc_plus_1[15:0];
var pc_plus_2[15:0];
var pc_plus_3[15:0];
isa_state IYH[7:0];
isa_state IYL[7:0];
mem mainmem[15:0];

pc_plus_1 = pc + 1;
fd_instr = {mainmem[pc_plus_1], mainmem[pc]};
assume fd_instr == 16'h21FD;

pc_plus_2 = pc_plus_1 + 1;
pc_plus_3 = pc_plus_2 + 1;

IYL = mainmem[pc_plus_2];
IYH = mainmem[pc_plus_3];

pc = pc_plus_3 + 1;
