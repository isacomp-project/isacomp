// Z80 DD 03 - DD prefix passthrough
// DD prefix consumed, base opcode 03 executes unchanged


isa_state pc[15:0];
var dd_instr[15:0];
var pc_plus_1[15:0];
isa_state B[7:0];
isa_state C[7:0];
mem mainmem[15:0];

var bc[15:0];
var bc_plus_1[15:0];

pc_plus_1 = pc + 1;
dd_instr = {mainmem[pc_plus_1], mainmem[pc]};
assume dd_instr == 16'h03DD;
pc = pc + 2;

bc = {B, C};
bc_plus_1 = bc + 1;

B = bc_plus_1[15:8];
C = bc_plus_1[7:0];