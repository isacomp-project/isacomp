// SPDX-License-Identifier: BSD-3-Clause
// Z80 FD E5 - PUSH IY (Push IY onto stack)
// Does not affect flags

isa_state pc[15:0];
var fd_instr[15:0];
var pc_plus_1[15:0];
isa_state IYH[7:0];
isa_state IYL[7:0];
isa_state sp[15:0];
mem mainmem[15:0];

pc_plus_1 = pc + 1;
fd_instr = {mainmem[pc_plus_1], mainmem[pc]};
assume fd_instr == 16'hE5FD;

var sp_minus_1[15:0];
sp_minus_1 = sp - 1;
var sp_minus_2[15:0];
sp_minus_2 = sp_minus_1 - 1;

mainmem[sp_minus_1] = IYH;
mainmem[sp_minus_2] = IYL;

sp = sp_minus_2;
pc = pc_plus_1 + 1;
