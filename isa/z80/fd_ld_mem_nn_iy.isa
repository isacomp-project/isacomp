// SPDX-License-Identifier: BSD-3-Clause
// Z80 FD 22 - LD (nn),IY (Store IY to memory address nn)
// Does not affect flags

isa_state pc[15:0];
var fd_instr[15:0];
var pc_plus_1[15:0];
var pc_plus_2[15:0];
var pc_plus_3[15:0];
isa_state IYH[7:0];
isa_state IYL[7:0];
mem mainmem[15:0];
var st_iy_addr[15:0];
var st_iy_addr_plus_1[15:0];

pc_plus_1 = pc + 1;
fd_instr = {mainmem[pc_plus_1], mainmem[pc]};
assume fd_instr == 16'h22FD;

pc_plus_2 = pc_plus_1 + 1;
pc_plus_3 = pc_plus_2 + 1;

st_iy_addr = {mainmem[pc_plus_3], mainmem[pc_plus_2]};
st_iy_addr_plus_1 = st_iy_addr + 1;

mainmem[st_iy_addr] = IYL;
mainmem[st_iy_addr_plus_1] = IYH;

pc = pc_plus_3 + 1;
