// SPDX-License-Identifier: BSD-3-Clause
// Z80 RLCA (0x07) - Rotate Left Circular Accumulator
// Bit 7 goes to Carry and also wraps to bit 0
// Affects: H=0, N=0, C

isa_state pc[15:0];
var instr[7:0];
isa_state A[7:0];
mem mainmem[15:0];
isa_state flag_H[0:0];
isa_state flag_N[0:0];
isa_state flag_C[0:0];

var result[7:0];
var bit7[0:0];

instr = mainmem[pc];
assume instr == 0x07;
pc = pc + 1;

bit7 = A[7];
result = {A[6:0], bit7};

flag_C = bit7;
flag_H = 1'b0;
flag_N = 1'b0;

A = result;
