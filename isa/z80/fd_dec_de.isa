// SPDX-License-Identifier: BSD-3-Clause
// Z80 FD 1B - FD prefix passthrough
// FD prefix consumed, base opcode 1B executes unchanged


isa_state pc[15:0];
var fd_instr[15:0];
var pc_plus_1[15:0];
isa_state D[7:0];
isa_state E[7:0];
mem mainmem[15:0];

var de[15:0];
var de_minus_1[15:0];

pc_plus_1 = pc + 1;
fd_instr = {mainmem[pc_plus_1], mainmem[pc]};
assume fd_instr == 16'h1BFD;
pc = pc + 2;

de = {D, E};
de_minus_1 = de - 1;

D = de_minus_1[15:8];
E = de_minus_1[7:0];