// Z80 FD 75 d - LD (IY+d),L
// Does not affect flags

isa_state pc[15:0];
var fd_instr[15:0];
var pc_plus_1[15:0];
var pc_plus_2[15:0];
isa_state IYH[7:0];
isa_state IYL[7:0];
isa_state L[7:0];
mem mainmem[15:0];
var d[7:0];
var d_sext[15:0];
var fd_ld_iy_d_l_addr[15:0];

pc_plus_1 = pc + 1;
pc_plus_2 = pc_plus_1 + 1;
fd_instr = {mainmem[pc_plus_1], mainmem[pc]};
assume fd_instr == 16'h75FD;

d = mainmem[pc_plus_2];
d_sext = {{8{d[7]}}, d};
fd_ld_iy_d_l_addr = {IYH, IYL} + d_sext;
mainmem[fd_ld_iy_d_l_addr] = L;

pc = pc_plus_2 + 1;
