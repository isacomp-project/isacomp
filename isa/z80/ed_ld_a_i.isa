// SPDX-License-Identifier: BSD-3-Clause
// Z80 ED 57 - LD A,I (Load Interrupt Vector register into A)
// Affects S, Z, H=0, P/V=IFF2, N=0

isa_state pc[15:0];
var ed_instr[15:0];
var pc_plus_1[15:0];
isa_state A[7:0];
isa_state I[7:0];
isa_state flag_S;
isa_state flag_Z;
isa_state flag_H;
isa_state flag_PV;
isa_state flag_N;
isa_state IFF2[0:0];
mem mainmem[15:0];

pc_plus_1 = pc + 1;
ed_instr = {mainmem[pc_plus_1], mainmem[pc]};
assume ed_instr == 0x57ED;
pc = pc_plus_1 + 1;

A = I;
flag_S = I[7];
flag_Z = (I == 8'h00) ? 1'b1 : 1'b0;
flag_H = 1'b0;
flag_PV = IFF2;
flag_N = 1'b0;
