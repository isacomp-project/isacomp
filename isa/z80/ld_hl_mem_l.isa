// Z80 LD (HL),L (0x75) - Store L to memory at HL
// (HL) = L
// Does not affect flags

isa_state pc[15:0];
var instr[7:0];
isa_state L[7:0];
isa_state H[7:0];
isa_state L[7:0];
mem mainmem[15:0];
var addr[15:0];

instr = mainmem[pc];
assume instr == 0x75;
pc = pc + 1;

addr = {H, L};
mainmem[addr] = L;
