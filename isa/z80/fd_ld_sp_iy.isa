// SPDX-License-Identifier: BSD-3-Clause
// Z80 FD F9 - LD SP,IY (Load SP from IY)
// Does not affect flags

isa_state pc[15:0];
var fd_instr[15:0];
var pc_plus_1[15:0];
isa_state IYH[7:0];
isa_state IYL[7:0];
isa_state sp[15:0];
mem mainmem[15:0];

pc_plus_1 = pc + 1;
fd_instr = {mainmem[pc_plus_1], mainmem[pc]};
assume fd_instr == 16'hF9FD;

sp = {IYH, IYL};
pc = pc_plus_1 + 1;
