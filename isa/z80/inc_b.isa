// SPDX-License-Identifier: BSD-3-Clause
// Z80 INC B (0x04) - Increment B
// B = B + 1
// Affects: S, Z, H, P/V, N=0 (C not affected)

isa_state pc[15:0];
var instr[7:0];
isa_state B[7:0];
mem mainmem[15:0];
isa_state flag_S[0:0];
isa_state flag_Z[0:0];
isa_state flag_H[0:0];
isa_state flag_PV[0:0];
isa_state flag_N[0:0];

var result[7:0];

instr = mainmem[pc];
assume instr == 0x04;
pc = pc + 1;

result = B + 1;

flag_S = result[7];
flag_Z = result == 0 ? 1'b1 : 1'b0;
flag_H = (B[3:0] == 0x0F) ? 1'b1 : 1'b0;
flag_PV = (B == 0x7F) ? 1'b1 : 1'b0;
flag_N = 1'b0;

B = result;
