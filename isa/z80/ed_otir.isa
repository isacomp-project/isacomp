// SPDX-License-Identifier: BSD-3-Clause
// Z80 ED B3 - OTIR (Output, Increment, Repeat)
// Repeat: port[C] = (HL), HL++, B-- until B == 0
// PC stays same while B != 0, advances when B == 0
// Affects Z=1 (always when done), N=1

isa_state pc[15:0];
var ed_instr[15:0];
var pc_plus_1[15:0];
var otir_pc_next[15:0];
isa_state H[7:0];
isa_state L[7:0];
isa_state B[7:0];
isa_state C[7:0];
isa_state flag_Z;
isa_state flag_N;
isa_state io[7:0][7:0];
mem mainmem[15:0];

pc_plus_1 = pc + 1;
otir_pc_next = pc_plus_1 + 1;
ed_instr = {mainmem[pc_plus_1], mainmem[pc]};
assume ed_instr == 0xB3ED;

var otir_hl_addr[15:0];
otir_hl_addr = {H, L};

var otir_value[7:0];
otir_value = mainmem[otir_hl_addr];
io[C] = otir_value;

var otir_hl_new[15:0];
otir_hl_new = otir_hl_addr + 1;
var otir_b_new[7:0];
otir_b_new = B - 1;

H = otir_hl_new[15:8];
L = otir_hl_new[7:0];
B = otir_b_new;

flag_N = 1'b1;

// B != 0: stay at same PC (repeat), Z = 0
// B == 0: advance PC (done), Z = 1
var otir_b_zero[0:0];
otir_b_zero = (otir_b_new == 8'h00);
var otir_next_pc[15:0];
otir_next_pc = otir_b_zero ? otir_pc_next : pc;
pc = otir_next_pc;
flag_Z = (otir_b_new == 8'h00) ? 1'b1 : 1'b0;
