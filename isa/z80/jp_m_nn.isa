// SPDX-License-Identifier: BSD-3-Clause
// Z80 JP M,nn (0xFA) - Jump if M
// If condition met: PC = nn
// Does not affect flags

isa_state pc[15:0];
var instr[7:0];
isa_state flag_S;
mem mainmem[15:0];
var pc_plus_1[15:0];
var pc_plus_2[15:0];
var pc_plus_3[15:0];
var target[15:0];

instr = mainmem[pc];
assume instr == 0xFA;
pc_plus_1 = pc + 1;
pc_plus_2 = pc_plus_1 + 1;
pc_plus_3 = pc_plus_2 + 1;

target = {mainmem[pc_plus_2], mainmem[pc_plus_1]};

pc = flag_S ? target : pc_plus_3;
