// SPDX-License-Identifier: BSD-3-Clause
// Z80 RET Z (0xC8) - Return from subroutine if Zero flag set
// if Z=1: Pop PC from stack; else PC = PC + 1
// Does not affect flags

isa_state pc[15:0];
var instr[7:0];
isa_state sp[15:0];
mem mainmem[15:0];
isa_state flag_Z[0:0];

var addr_lo[7:0];
var addr_hi[7:0];
var sp_plus_1[15:0];
var sp_plus_2[15:0];
var return_addr[15:0];
var pc_plus_1[15:0];

instr = mainmem[pc];
assume instr == 0xC8;
pc_plus_1 = pc + 1;

// Pop return address from stack
addr_lo = mainmem[sp];
sp_plus_1 = sp + 1;
addr_hi = mainmem[sp_plus_1];
sp_plus_2 = sp_plus_1 + 1;

return_addr = {addr_hi, addr_lo};

sp = flag_Z ? sp_plus_2 : sp;
pc = flag_Z ? return_addr : pc_plus_1;
