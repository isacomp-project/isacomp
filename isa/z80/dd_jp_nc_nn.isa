// SPDX-License-Identifier: BSD-3-Clause
// Z80 DD D2 - DD prefix passthrough JP NC,nn
// DD prefix consumed, JP NC,nn executes unchanged

isa_state pc[15:0];
var dd_instr[15:0];
var pc_plus_1[15:0];
isa_state flag_C;
mem mainmem[15:0];

var addr_lo[7:0];
var addr_hi[7:0];
var target[15:0];

pc_plus_1 = pc + 1;
dd_instr = {mainmem[pc_plus_1], mainmem[pc]};
assume dd_instr == 16'hD2DD;
pc = pc + 2;

addr_lo = mainmem[pc];
pc = pc + 1;
addr_hi = mainmem[pc];
pc = pc + 1;

target = {addr_hi, addr_lo};
pc = (flag_C == 0) ? target : pc;
