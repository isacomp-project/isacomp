// SPDX-License-Identifier: BSD-3-Clause
// Z80 CB A4 - RES 4,H (Reset bit 4)
// Does not affect flags

isa_state pc[15:0];
var cb_instr[15:0];
var pc_plus_1[15:0];
isa_state H[7:0];
mem mainmem[15:0];

pc_plus_1 = pc + 1;
cb_instr = {mainmem[pc_plus_1], mainmem[pc]};
assume cb_instr == 0xA4CB;
pc = pc_plus_1 + 1;

// Reset bit 4
H = H & 8'hEF;
