// SPDX-License-Identifier: BSD-3-Clause
// Z80 LD HL,(nn) (0x2A) - Load HL from memory at nn
// L = (nn), H = (nn+1)
// Does not affect flags

isa_state pc[15:0];
var instr[7:0];
isa_state H[7:0];
isa_state L[7:0];
mem mainmem[15:0];
var pc_plus_1[15:0];
var pc_plus_2[15:0];
var addr[15:0];
var addr_plus_1[15:0];

instr = mainmem[pc];
assume instr == 0x2A;
pc_plus_1 = pc + 1;
pc_plus_2 = pc_plus_1 + 1;

addr = {mainmem[pc_plus_2], mainmem[pc_plus_1]};
addr_plus_1 = addr + 1;
L = mainmem[addr];
H = mainmem[addr_plus_1];
pc = pc_plus_2 + 1;
