// SPDX-License-Identifier: BSD-3-Clause
// Z80 FD 15 - FD prefix passthrough
// FD prefix consumed, base opcode 15 executes unchanged


isa_state pc[15:0];
var fd_instr[15:0];
var pc_plus_1[15:0];
isa_state D[7:0];
isa_state flag_S;
isa_state flag_Z;
isa_state flag_H;
isa_state flag_PV;
isa_state flag_N;
mem mainmem[15:0];
var result[7:0];

pc_plus_1 = pc + 1;
fd_instr = {mainmem[pc_plus_1], mainmem[pc]};
assume fd_instr == 16'h15FD;
pc = pc + 2;

result = D - 1;
flag_H = (D[3:0] == 4'b0000);
flag_PV = (D == 8'h80);
D = result;
flag_S = result[7];
flag_Z = (result == 8'b0);
flag_N = 1;