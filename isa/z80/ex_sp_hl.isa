// SPDX-License-Identifier: BSD-3-Clause
// Z80 EX (SP),HL (0xE3) - Exchange HL with top of stack
// Swaps H,L with (SP+1),(SP)
// Does not affect flags

isa_state pc[15:0];
var instr[7:0];
isa_state H[7:0];
isa_state L[7:0];
isa_state sp[15:0];
mem mainmem[15:0];
var sp_plus_1[15:0];
var temp_l[7:0];
var temp_h[7:0];

instr = mainmem[pc];
assume instr == 0xE3;
pc = pc + 1;

sp_plus_1 = sp + 1;
temp_l = mainmem[sp];
temp_h = mainmem[sp_plus_1];

mainmem[sp] = L;
mainmem[sp_plus_1] = H;

L = temp_l;
H = temp_h;
