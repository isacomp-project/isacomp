// Z80 INC DE (0x13) - Increment DE register pair
// DE = DE + 1
// Does not affect flags

isa_state pc[15:0];
var instr[7:0];
isa_state D[7:0];
isa_state E[7:0];
mem mainmem[15:0];

var de[15:0];
var de_plus_1[15:0];

instr = mainmem[pc];
assume instr == 0x13;
pc = pc + 1;

de = {D, E};
de_plus_1 = de + 1;

D = de_plus_1[15:8];
E = de_plus_1[7:0];
