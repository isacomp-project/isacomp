// SPDX-License-Identifier: BSD-3-Clause
// Z80 INC HL (0x23) - Increment HL register pair
// HL = HL + 1
// Does not affect flags

isa_state pc[15:0];
var instr[7:0];
isa_state H[7:0];
isa_state L[7:0];
mem mainmem[15:0];

var hl[15:0];
var hl_plus_1[15:0];

instr = mainmem[pc];
assume instr == 0x23;
pc = pc + 1;

hl = {H, L};
hl_plus_1 = hl + 1;

H = hl_plus_1[15:8];
L = hl_plus_1[7:0];
