// SPDX-License-Identifier: BSD-3-Clause
// Z80 CB B5 - RES 6,L (Reset bit 6)
// Does not affect flags

isa_state pc[15:0];
var cb_instr[15:0];
var pc_plus_1[15:0];
isa_state L[7:0];
mem mainmem[15:0];

pc_plus_1 = pc + 1;
cb_instr = {mainmem[pc_plus_1], mainmem[pc]};
assume cb_instr == 0xB5CB;
pc = pc_plus_1 + 1;

// Reset bit 6
L = L & 8'hBF;
