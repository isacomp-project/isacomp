// SPDX-License-Identifier: BSD-3-Clause
// Z80 LD (HL),A (0x77) - Store A to memory at HL
// (HL) = A
// Does not affect flags

isa_state pc[15:0];
var instr[7:0];
isa_state A[7:0];
isa_state H[7:0];
isa_state L[7:0];
mem mainmem[15:0];

var hl_addr[15:0];

instr = mainmem[pc];
assume instr == 0x77;
pc = pc + 1;

hl_addr = {H, L};
mainmem[hl_addr] = A;
