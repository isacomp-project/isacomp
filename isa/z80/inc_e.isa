// SPDX-License-Identifier: BSD-3-Clause
// Z80 INC E (0x1C) - INCrement E
// E = E + 1
// Affects S, Z, H, P/V, N flags (not C)

isa_state pc[15:0];
var instr[7:0];
isa_state E[7:0];
isa_state flag_S;
isa_state flag_Z;
isa_state flag_H;
isa_state flag_PV;
isa_state flag_N;
mem mainmem[15:0];
var result[7:0];

instr = mainmem[pc];
assume instr == 0x1C;
pc = pc + 1;

result = E + 1;
flag_H = (E[3:0] == 4'b1111);
flag_PV = (E == 8'h7F);
E = result;
flag_S = result[7];
flag_Z = (result == 8'b0);
flag_N = 0;
