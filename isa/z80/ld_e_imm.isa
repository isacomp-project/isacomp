// SPDX-License-Identifier: BSD-3-Clause
// Z80 LD E,n (0x1E) - Load immediate value into E
// E = n
// Does not affect flags

isa_state pc[15:0];
var instr[7:0];
isa_state E[7:0];
mem mainmem[15:0];

var imm[7:0];

instr = mainmem[pc];
assume instr == 0x1E;
pc = pc + 1;
imm = mainmem[pc];
pc = pc + 1;

E = imm;
