// SPDX-License-Identifier: BSD-3-Clause
// Z80 DD 19 - ADD IX,DE (Add DE to IX)
// Affects H, N=0, C

isa_state pc[15:0];
var dd_instr[15:0];
var pc_plus_1[15:0];
isa_state IXH[7:0];
isa_state IXL[7:0];
isa_state D[7:0];
isa_state E[7:0];
isa_state flag_H;
isa_state flag_N;
isa_state flag_C;
mem mainmem[15:0];

pc_plus_1 = pc + 1;
dd_instr = {mainmem[pc_plus_1], mainmem[pc]};
assume dd_instr == 16'h19DD;

var ix_val[15:0];
ix_val = {IXH, IXL};
var de_val[15:0];
de_val = {D, E};

var ix_new[16:0];
ix_new = {1'b0, ix_val} + {1'b0, de_val};

IXH = ix_new[15:8];
IXL = ix_new[7:0];

// Half carry from bit 11
flag_H = ((ix_val[11:0] + de_val[11:0]) > 12'hFFF) ? 1'b1 : 1'b0;
flag_N = 1'b0;
flag_C = ix_new[16];

pc = pc_plus_1 + 1;
