// SPDX-License-Identifier: BSD-3-Clause
// Z80 DD F3 - DD prefix passthrough
// DD prefix consumed, base opcode F3 executes unchanged


isa_state pc[15:0];
var dd_instr[15:0];
var pc_plus_1[15:0];
isa_state int_ff1[0:0];
isa_state int_ff2[0:0];
mem mainmem[15:0];

pc_plus_1 = pc + 1;
dd_instr = {mainmem[pc_plus_1], mainmem[pc]};
assume dd_instr == 16'hF3DD;
pc = pc + 2;

int_ff1 = 0;
int_ff2 = 0;