// SPDX-License-Identifier: BSD-3-Clause
// Z80 ED 64 - Undocumented NEG variant (behaves like NEG)
// Affects S, Z, H, P/V, N=1, C

isa_state pc[15:0];
var ed_instr[15:0];
var pc_plus_1[15:0];
isa_state A[7:0];
isa_state flag_S;
isa_state flag_Z;
isa_state flag_H;
isa_state flag_PV;
isa_state flag_N;
isa_state flag_C;
mem mainmem[15:0];
var ed_neg_64_result[8:0];
var ed_neg_64_half[4:0];

pc_plus_1 = pc + 1;
ed_instr = {mainmem[pc_plus_1], mainmem[pc]};
assume ed_instr == 16'h64ED;
pc = pc_plus_1 + 1;

ed_neg_64_result = 9'b0 - {1'b0, A};
ed_neg_64_half = 5'b0 - {1'b0, A[3:0]};

flag_S = ed_neg_64_result[7];
flag_Z = (ed_neg_64_result[7:0] == 8'h00) ? 1'b1 : 1'b0;
flag_H = ed_neg_64_half[4];
flag_PV = (A == 8'h80) ? 1'b1 : 1'b0;
flag_N = 1'b1;
flag_C = (A != 8'h00) ? 1'b1 : 1'b0;

A = ed_neg_64_result[7:0];
