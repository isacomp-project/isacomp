// Z80 DD 5B - DD prefix passthrough
// DD prefix consumed, base opcode 5B executes unchanged


isa_state pc[15:0];
var dd_instr[15:0];
var pc_plus_1[15:0];
isa_state E[7:0];
mem mainmem[15:0];

pc_plus_1 = pc + 1;
dd_instr = {mainmem[pc_plus_1], mainmem[pc]};
assume dd_instr == 16'h5BDD;
pc = pc + 2;

E = E;