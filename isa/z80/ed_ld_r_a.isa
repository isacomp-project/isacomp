// SPDX-License-Identifier: BSD-3-Clause
// Z80 ED 4F - LD R,A (Load A into Memory Refresh register)
// Does not affect flags

isa_state pc[15:0];
var ed_instr[15:0];
var pc_plus_1[15:0];
isa_state A[7:0];
isa_state R[7:0];
mem mainmem[15:0];

pc_plus_1 = pc + 1;
ed_instr = {mainmem[pc_plus_1], mainmem[pc]};
assume ed_instr == 0x4FED;
pc = pc_plus_1 + 1;

R = A;
