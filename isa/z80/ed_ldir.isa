// SPDX-License-Identifier: BSD-3-Clause
// Z80 ED B0 - LDIR (Load, Increment, Repeat)
// Repeat: (DE) = (HL), DE++, HL++, BC-- until BC == 0
// PC stays same while BC != 0, advances when BC == 0
// Affects H=0, P/V=0 (always 0 when done), N=0

isa_state pc[15:0];
var ed_instr[15:0];
var pc_plus_1[15:0];
var ldir_pc_next[15:0];
isa_state H[7:0];
isa_state L[7:0];
isa_state D[7:0];
isa_state E[7:0];
isa_state B[7:0];
isa_state C[7:0];
isa_state flag_H;
isa_state flag_PV;
isa_state flag_N;
mem mainmem[15:0];

pc_plus_1 = pc + 1;
ldir_pc_next = pc_plus_1 + 1;
ed_instr = {mainmem[pc_plus_1], mainmem[pc]};
assume ed_instr == 0xB0ED;

var ldir_hl_addr[15:0];
ldir_hl_addr = {H, L};
var ldir_de_addr[15:0];
ldir_de_addr = {D, E};
var ldir_bc_val[15:0];
ldir_bc_val = {B, C};

var ldir_value[7:0];
ldir_value = mainmem[ldir_hl_addr];
mainmem[ldir_de_addr] = ldir_value;

var ldir_hl_new[15:0];
ldir_hl_new = ldir_hl_addr + 1;
var ldir_de_new[15:0];
ldir_de_new = ldir_de_addr + 1;
var ldir_bc_new[15:0];
ldir_bc_new = ldir_bc_val - 1;

H = ldir_hl_new[15:8];
L = ldir_hl_new[7:0];
D = ldir_de_new[15:8];
E = ldir_de_new[7:0];
B = ldir_bc_new[15:8];
C = ldir_bc_new[7:0];

flag_H = 1'b0;
flag_N = 1'b0;

// BC != 0: stay at same PC (repeat), P/V = 1
// BC == 0: advance PC (done), P/V = 0
var ldir_bc_zero[0:0];
ldir_bc_zero = (ldir_bc_new == 16'h0000);
var ldir_next_pc[15:0];
ldir_next_pc = ldir_bc_zero ? ldir_pc_next : pc;
pc = ldir_next_pc;
flag_PV = (ldir_bc_new != 16'h0000) ? 1'b1 : 1'b0;
