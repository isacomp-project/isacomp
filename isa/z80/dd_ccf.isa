// SPDX-License-Identifier: BSD-3-Clause
// Z80 DD 3F - DD prefix passthrough
// DD prefix consumed, base opcode 3F executes unchanged


isa_state pc[15:0];
var dd_instr[15:0];
var pc_plus_1[15:0];
mem mainmem[15:0];
isa_state flag_H[0:0];
isa_state flag_N[0:0];
isa_state flag_C[0:0];

var old_c[0:0];

pc_plus_1 = pc + 1;
dd_instr = {mainmem[pc_plus_1], mainmem[pc]};
assume dd_instr == 16'h3FDD;
pc = pc + 2;

old_c = flag_C;
flag_C = flag_C ^ 1'b1;
flag_H = old_c;
flag_N = 1'b0;