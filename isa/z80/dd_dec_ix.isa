// SPDX-License-Identifier: BSD-3-Clause
// Z80 DD 2B - DEC IX (Decrement IX register pair)
// Does not affect flags

isa_state pc[15:0];
var dd_instr[15:0];
var pc_plus_1[15:0];
isa_state IXH[7:0];
isa_state IXL[7:0];
mem mainmem[15:0];

pc_plus_1 = pc + 1;
dd_instr = {mainmem[pc_plus_1], mainmem[pc]};
assume dd_instr == 16'h2BDD;

var ix_val[15:0];
ix_val = {IXH, IXL};
var ix_new[15:0];
ix_new = ix_val - 1;

IXH = ix_new[15:8];
IXL = ix_new[7:0];

pc = pc_plus_1 + 1;
