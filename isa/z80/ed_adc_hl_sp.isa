// SPDX-License-Identifier: BSD-3-Clause
// Z80 ED 7A - ADC HL,SP
// HL = HL + SP + Carry
// Affects S, Z, H, P/V, N=0, C

isa_state pc[15:0];
var ed_instr[15:0];
var pc_plus_1[15:0];
isa_state H[7:0];
isa_state L[7:0];
isa_state sp[15:0];
isa_state flag_S;
isa_state flag_Z;
isa_state flag_H;
isa_state flag_PV;
isa_state flag_N;
isa_state flag_C;
mem mainmem[15:0];
var hl_val[15:0];
var result[16:0];
var result16[15:0];

pc_plus_1 = pc + 1;
ed_instr = {mainmem[pc_plus_1], mainmem[pc]};
assume ed_instr == 0x7AED;
pc = pc_plus_1 + 1;

hl_val = {H, L};
result = hl_val + sp + flag_C;
result16 = hl_val + sp + flag_C;

H = result16[15:8];
L = result16[7:0];

flag_S = result16[15];
flag_Z = (result16 == 16'h0000) ? 1'b1 : 1'b0;
flag_H = (((hl_val[11:0] + sp[11:0] + flag_C) >> 12) != 0) ? 1'b1 : 1'b0;
flag_PV = (hl_val[15] == sp[15]) & (hl_val[15] != result16[15]) ? 1'b1 : 1'b0;
flag_N = 1'b0;
flag_C = result[16];
