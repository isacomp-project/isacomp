// SPDX-License-Identifier: BSD-3-Clause
// Z80 FD 32 - FD prefix passthrough LD (nn),A
// FD prefix consumed, LD (nn),A executes unchanged

isa_state pc[15:0];
var fd_instr[15:0];
var pc_plus_1[15:0];
isa_state A[7:0];
mem mainmem[15:0];

var fd_ld_addr_lo[7:0];
var fd_ld_addr_hi[7:0];
var fd_ld_addr[15:0];

pc_plus_1 = pc + 1;
fd_instr = {mainmem[pc_plus_1], mainmem[pc]};
assume fd_instr == 16'h32FD;
pc = pc + 2;

fd_ld_addr_lo = mainmem[pc];
pc = pc + 1;
fd_ld_addr_hi = mainmem[pc];
pc = pc + 1;

fd_ld_addr = {fd_ld_addr_hi, fd_ld_addr_lo};
mainmem[fd_ld_addr] = A;
