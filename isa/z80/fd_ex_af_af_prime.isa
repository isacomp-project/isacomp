// Z80 FD 08 - FD prefix passthrough
// FD prefix consumed, base opcode 08 executes unchanged


isa_state pc[15:0];
var fd_instr[15:0];
var pc_plus_1[15:0];
isa_state A[7:0];
isa_state A_prime[7:0];
isa_state flag_S[0:0];
isa_state flag_Z[0:0];
isa_state flag_H[0:0];
isa_state flag_PV[0:0];
isa_state flag_N[0:0];
isa_state flag_C[0:0];
isa_state flag_S_prime[0:0];
isa_state flag_Z_prime[0:0];
isa_state flag_H_prime[0:0];
isa_state flag_PV_prime[0:0];
isa_state flag_N_prime[0:0];
isa_state flag_C_prime[0:0];
mem mainmem[15:0];
var temp_a[7:0];
var temp_s[0:0];
var temp_z[0:0];
var temp_h[0:0];
var temp_pv[0:0];
var temp_n[0:0];
var temp_c[0:0];

pc_plus_1 = pc + 1;
fd_instr = {mainmem[pc_plus_1], mainmem[pc]};
assume fd_instr == 16'h08FD;
pc = pc + 2;

temp_a = A;
temp_s = flag_S;
temp_z = flag_Z;
temp_h = flag_H;
temp_pv = flag_PV;
temp_n = flag_N;
temp_c = flag_C;

A = A_prime;
flag_S = flag_S_prime;
flag_Z = flag_Z_prime;
flag_H = flag_H_prime;
flag_PV = flag_PV_prime;
flag_N = flag_N_prime;
flag_C = flag_C_prime;

A_prime = temp_a;
flag_S_prime = temp_s;
flag_Z_prime = temp_z;
flag_H_prime = temp_h;
flag_PV_prime = temp_pv;
flag_N_prime = temp_n;
flag_C_prime = temp_c;