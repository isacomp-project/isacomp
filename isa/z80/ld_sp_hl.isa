// SPDX-License-Identifier: BSD-3-Clause
// Z80 LD SP,HL (0xF9) - Load SP from HL
// SP = HL
// Does not affect flags

isa_state pc[15:0];
var instr[7:0];
isa_state H[7:0];
isa_state L[7:0];
isa_state sp[15:0];
mem mainmem[15:0];

instr = mainmem[pc];
assume instr == 0xF9;
pc = pc + 1;

sp = {H, L};
