// SPDX-License-Identifier: BSD-3-Clause
// Z80 DD 37 - DD prefix passthrough
// DD prefix consumed, base opcode 37 executes unchanged


isa_state pc[15:0];
var dd_instr[15:0];
var pc_plus_1[15:0];
mem mainmem[15:0];
isa_state flag_H[0:0];
isa_state flag_N[0:0];
isa_state flag_C[0:0];

pc_plus_1 = pc + 1;
dd_instr = {mainmem[pc_plus_1], mainmem[pc]};
assume dd_instr == 16'h37DD;
pc = pc + 2;

flag_C = 1'b1;
flag_H = 1'b0;
flag_N = 1'b0;