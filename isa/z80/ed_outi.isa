// SPDX-License-Identifier: BSD-3-Clause
// Z80 ED A3 - OUTI (Output and Increment)
// port[C] = (HL), HL++, B--
// Affects Z=(B==0 after), N=1, other flags undefined

isa_state pc[15:0];
var ed_instr[15:0];
var pc_plus_1[15:0];
isa_state H[7:0];
isa_state L[7:0];
isa_state B[7:0];
isa_state C[7:0];
isa_state flag_Z;
isa_state flag_N;
isa_state io[7:0][7:0];
mem mainmem[15:0];

pc_plus_1 = pc + 1;
ed_instr = {mainmem[pc_plus_1], mainmem[pc]};
assume ed_instr == 0xA3ED;
pc = pc_plus_1 + 1;

var outi_hl_addr[15:0];
outi_hl_addr = {H, L};

var outi_value[7:0];
outi_value = mainmem[outi_hl_addr];
io[C] = outi_value;

var outi_hl_new[15:0];
outi_hl_new = outi_hl_addr + 1;
var outi_b_new[7:0];
outi_b_new = B - 1;

H = outi_hl_new[15:8];
L = outi_hl_new[7:0];
B = outi_b_new;

flag_Z = (outi_b_new == 8'h00) ? 1'b1 : 1'b0;
flag_N = 1'b1;
