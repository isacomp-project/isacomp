// SPDX-License-Identifier: BSD-3-Clause
// Z80 LD A,(nn) (0x3A) - Load A from absolute memory address
// A = (nn)
// Does not affect flags

isa_state pc[15:0];
var instr[7:0];
isa_state A[7:0];
mem mainmem[15:0];

var addr_lo[7:0];
var addr_hi[7:0];
var addr[15:0];

instr = mainmem[pc];
assume instr == 0x3A;
pc = pc + 1;

addr_lo = mainmem[pc];
pc = pc + 1;
addr_hi = mainmem[pc];
pc = pc + 1;

addr = {addr_hi, addr_lo};
A = mainmem[addr];
