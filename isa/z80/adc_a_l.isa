// SPDX-License-Identifier: BSD-3-Clause
// Z80 ADC A,L (0x8D) - ADC L with A
// A = A + C + L
// Affects S, Z, H, P/V, N, C flags

isa_state pc[15:0];
var instr[7:0];
isa_state A[7:0];
isa_state L[7:0];
isa_state flag_S;
isa_state flag_Z;
isa_state flag_H;
isa_state flag_PV;
isa_state flag_N;
isa_state flag_C;
mem mainmem[15:0];

instr = mainmem[pc];
assume instr == 0x8D;
pc = pc + 1;

var carry_in[7:0];
carry_in = {7'b0, flag_C};
var result[8:0];
result = {1'b0, A} + {1'b0, L} + {1'b0, carry_in};
var half[4:0];
half = {1'b0, A[3:0]} + {1'b0, L[3:0]} + {1'b0, carry_in[0]};

A = result[7:0];
flag_S = result[7];
flag_Z = (result[7:0] == 8'b0);
flag_H = half[4];
flag_PV = (A[7] ^ L[7] ^ result[7] ^ result[8]);
flag_N = 0;
flag_C = result[8];

