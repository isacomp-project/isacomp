// SPDX-License-Identifier: BSD-3-Clause
// Z80 FD 10 - FD prefix passthrough DJNZ
// FD prefix consumed, DJNZ executes unchanged

isa_state pc[15:0];
var fd_instr[15:0];
var pc_plus_1[15:0];
isa_state B[7:0];
mem mainmem[15:0];

var fd_djnz_offset[7:0];
var fd_djnz_offset_ext[15:0];
var fd_djnz_new_b[7:0];
var fd_djnz_target[15:0];

pc_plus_1 = pc + 1;
fd_instr = {mainmem[pc_plus_1], mainmem[pc]};
assume fd_instr == 16'h10FD;
pc = pc + 2;

fd_djnz_offset = mainmem[pc];
pc = pc + 1;

fd_djnz_new_b = B - 1;
B = fd_djnz_new_b;

fd_djnz_offset_ext = {{8{fd_djnz_offset[7]}}, fd_djnz_offset};
fd_djnz_target = pc + fd_djnz_offset_ext;
pc = (fd_djnz_new_b != 0) ? fd_djnz_target : pc;
