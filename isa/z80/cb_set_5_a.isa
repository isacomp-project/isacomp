// SPDX-License-Identifier: BSD-3-Clause
// Z80 CB EF - SET 5,A (Set bit 5)
// Does not affect flags

isa_state pc[15:0];
var cb_instr[15:0];
var pc_plus_1[15:0];
isa_state A[7:0];
mem mainmem[15:0];

pc_plus_1 = pc + 1;
cb_instr = {mainmem[pc_plus_1], mainmem[pc]};
assume cb_instr == 0xEFCB;
pc = pc_plus_1 + 1;

// Set bit 5
A = A | 8'h20;
