// SPDX-License-Identifier: BSD-3-Clause
// Z80 LD (HL),C (0x71) - Store C to memory at HL
// (HL) = C
// Does not affect flags

isa_state pc[15:0];
var instr[7:0];
isa_state C[7:0];
isa_state H[7:0];
isa_state L[7:0];
mem mainmem[15:0];
var addr[15:0];

instr = mainmem[pc];
assume instr == 0x71;
pc = pc + 1;

addr = {H, L};
mainmem[addr] = C;
