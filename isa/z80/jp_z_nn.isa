// SPDX-License-Identifier: BSD-3-Clause
// Z80 JP Z,nn (0xCA) - Jump to absolute address if Zero flag set
// if Z=1: PC = nn, else PC = PC + 3
// Does not affect flags

isa_state pc[15:0];
var instr[7:0];
mem mainmem[15:0];
isa_state flag_Z[0:0];

var pc_plus_1[15:0];
var pc_plus_2[15:0];
var pc_plus_3[15:0];
var addr_lo[7:0];
var addr_hi[7:0];
var target[15:0];

instr = mainmem[pc];
assume instr == 0xCA;

// Use intermediate variables for address calculation
pc_plus_1 = pc + 1;
pc_plus_2 = pc_plus_1 + 1;
pc_plus_3 = pc_plus_2 + 1;

addr_lo = mainmem[pc_plus_1];
addr_hi = mainmem[pc_plus_2];

target = {addr_hi, addr_lo};

// Single write to PC with conditional target
pc = flag_Z ? target : pc_plus_3;
