// SPDX-License-Identifier: BSD-3-Clause
// Z80 CB 90 - RES 2,B (Reset bit 2)
// Does not affect flags

isa_state pc[15:0];
var cb_instr[15:0];
var pc_plus_1[15:0];
isa_state B[7:0];
mem mainmem[15:0];

pc_plus_1 = pc + 1;
cb_instr = {mainmem[pc_plus_1], mainmem[pc]};
assume cb_instr == 0x90CB;
pc = pc_plus_1 + 1;

// Reset bit 2
B = B & 8'hFB;
