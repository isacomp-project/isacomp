// SPDX-License-Identifier: BSD-3-Clause
// Z80 LD A,(HL) (0x7E) - Load memory at HL into A
// A = (HL)
// Does not affect flags

isa_state pc[15:0];
var instr[7:0];
isa_state A[7:0];
isa_state H[7:0];
isa_state L[7:0];
mem mainmem[15:0];

var hl_addr[15:0];

instr = mainmem[pc];
assume instr == 0x7E;
pc = pc + 1;

hl_addr = {H, L};
A = mainmem[hl_addr];
