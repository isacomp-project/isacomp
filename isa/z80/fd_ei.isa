// SPDX-License-Identifier: BSD-3-Clause
// Z80 FD FB - FD prefix passthrough
// FD prefix consumed, base opcode FB executes unchanged


isa_state pc[15:0];
var fd_instr[15:0];
var pc_plus_1[15:0];
isa_state int_ff1[0:0];
isa_state int_ff2[0:0];
mem mainmem[15:0];

pc_plus_1 = pc + 1;
fd_instr = {mainmem[pc_plus_1], mainmem[pc]};
assume fd_instr == 16'hFBFD;
pc = pc + 2;

int_ff1 = 1;
int_ff2 = 1;