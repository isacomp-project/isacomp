// SPDX-License-Identifier: BSD-3-Clause
// Z80 LD HL,nn (0x21) - Load 16-bit immediate into HL
// HL = nn
// Does not affect flags

isa_state pc[15:0];
var instr[7:0];
isa_state H[7:0];
isa_state L[7:0];
mem mainmem[15:0];

var imm_lo[7:0];
var imm_hi[7:0];

instr = mainmem[pc];
assume instr == 0x21;
pc = pc + 1;

imm_lo = mainmem[pc];
pc = pc + 1;
imm_hi = mainmem[pc];
pc = pc + 1;

L = imm_lo;
H = imm_hi;
