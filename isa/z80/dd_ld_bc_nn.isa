// Z80 DD 01 - DD prefix passthrough
// DD prefix consumed, base opcode 01 executes unchanged


isa_state pc[15:0];
var dd_instr[15:0];
var pc_plus_1[15:0];
isa_state B[7:0];
isa_state C[7:0];
mem mainmem[15:0];

var imm_lo[7:0];
var imm_hi[7:0];

pc_plus_1 = pc + 1;
dd_instr = {mainmem[pc_plus_1], mainmem[pc]};
assume dd_instr == 16'h01DD;
pc = pc + 2;

imm_lo = mainmem[pc];
pc = pc + 1;
imm_hi = mainmem[pc];
pc = pc + 1;

C = imm_lo;
B = imm_hi;