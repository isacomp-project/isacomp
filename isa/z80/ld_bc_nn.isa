// SPDX-License-Identifier: BSD-3-Clause
// Z80 LD BC,nn (0x01) - Load 16-bit immediate into BC
// BC = nn
// Does not affect flags

isa_state pc[15:0];
var instr[7:0];
isa_state B[7:0];
isa_state C[7:0];
mem mainmem[15:0];

var imm_lo[7:0];
var imm_hi[7:0];

instr = mainmem[pc];
assume instr == 0x01;
pc = pc + 1;

imm_lo = mainmem[pc];
pc = pc + 1;
imm_hi = mainmem[pc];
pc = pc + 1;

C = imm_lo;
B = imm_hi;
