// Z80 FD 18 - FD prefix passthrough JR
// FD prefix consumed, JR executes unchanged

isa_state pc[15:0];
var fd_instr[15:0];
var pc_plus_1[15:0];
mem mainmem[15:0];

var offset[7:0];
var offset_ext[15:0];

pc_plus_1 = pc + 1;
fd_instr = {mainmem[pc_plus_1], mainmem[pc]};
assume fd_instr == 16'h18FD;
pc = pc + 2;

offset = mainmem[pc];
pc = pc + 1;

offset_ext = {{8{offset[7]}}, offset};
pc = pc + offset_ext;
