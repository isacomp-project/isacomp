// SPDX-License-Identifier: BSD-3-Clause
// Z80 INC C (0x0C) - Increment C
// C = C + 1
// Affects: S, Z, H, P/V, N=0 (C flag not affected)

isa_state pc[15:0];
var instr[7:0];
isa_state C[7:0];
mem mainmem[15:0];
isa_state flag_S[0:0];
isa_state flag_Z[0:0];
isa_state flag_H[0:0];
isa_state flag_PV[0:0];
isa_state flag_N[0:0];

var result[7:0];

instr = mainmem[pc];
assume instr == 0x0C;
pc = pc + 1;

result = C + 1;

flag_S = result[7];
flag_Z = result == 0 ? 1'b1 : 1'b0;
flag_H = (C[3:0] == 0x0F) ? 1'b1 : 1'b0;
flag_PV = (C == 0x7F) ? 1'b1 : 1'b0;
flag_N = 1'b0;

C = result;
